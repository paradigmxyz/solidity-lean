theorem embedConcreteEnv_declare?
    (env : ConcreteYul.Env) (name : FullYul.Name) (value : Word) :
    (ConcreteYul.declare? env name value).map embedConcreteEnv =
      FullYul.declare? (embedConcreteEnv env) name (embedWordValue value) := by
  cases hLookup : ConcreteYul.lookup? env name with
  | none =>
      simp [ConcreteYul.declare?, FullYul.declare?, embedConcreteEnv_lookup?,
        hLookup, embedConcreteEnv, embedWordValue, norm_norm]
  | some current =>
      simp [ConcreteYul.declare?, FullYul.declare?, embedConcreteEnv_lookup?,
        hLookup]

theorem embedConcreteEnv_assign?
    (env : ConcreteYul.Env) (name : FullYul.Name) (value : Word) :
    (ConcreteYul.assign? env name value).map embedConcreteEnv =
      FullYul.assign? (embedConcreteEnv env) name (embedWordValue value) := by
  induction env with
  | nil =>
      rfl
  | cons binding rest ih =>
      cases binding with
      | mk candidate current =>
          by_cases hName : candidate = name
          · subst candidate
            simp [ConcreteYul.assign?, FullYul.assign?, embedConcreteEnv,
              embedWordValue, norm_norm]
          · cases hAssign : ConcreteYul.assign? rest name value with
            | none =>
                have hFull :
                    FullYul.assign? (embedConcreteEnv rest) name
                        (embedWordValue value) = none := by
                  simpa [hAssign] using ih.symm
                simp [ConcreteYul.assign?, FullYul.assign?, embedConcreteEnv,
                  hName, hAssign, hFull]
            | some rest' =>
                have hFull :
                    FullYul.assign? (embedConcreteEnv rest) name
                        (embedWordValue value) =
                      some (embedConcreteEnv rest') := by
                  simpa [hAssign] using ih.symm
                simp [ConcreteYul.assign?, FullYul.assign?, embedConcreteEnv,
                  hName, hAssign, hFull]

theorem embedConcreteEnv_declareMany?
    (env : ConcreteYul.Env) (names : List FullYul.Name)
    (values : List Word) :
    (ConcreteYul.declareMany? env names values).map embedConcreteEnv =
      FullYul.declareMany? (embedConcreteEnv env) names
        (values.map embedWordValue) := by
  induction names generalizing env values with
  | nil =>
      cases values <;> rfl
  | cons name rest ih =>
      cases values with
      | nil => rfl
      | cons value values =>
          cases hDecl : ConcreteYul.declare? env name value with
          | none =>
              have hFull :
                  FullYul.declare? (embedConcreteEnv env) name
                      (embedWordValue value) = none := by
                simpa [hDecl] using
                  (embedConcreteEnv_declare? env name value).symm
              simp [ConcreteYul.declareMany?, FullYul.declareMany?, hDecl,
                hFull]
          | some env' =>
              have hFull :
                  FullYul.declare? (embedConcreteEnv env) name
                      (embedWordValue value) =
                    some (embedConcreteEnv env') := by
                simpa [hDecl] using
                  (embedConcreteEnv_declare? env name value).symm
              simp [ConcreteYul.declareMany?, FullYul.declareMany?, hDecl,
                hFull, ih env' values]

theorem embedConcreteEnv_assignMany?
    (env : ConcreteYul.Env) (names : List FullYul.Name)
    (values : List Word) :
    (ConcreteYul.assignMany? env names values).map embedConcreteEnv =
      FullYul.assignMany? (embedConcreteEnv env) names
        (values.map embedWordValue) := by
  induction names generalizing env values with
  | nil =>
      cases values <;> rfl
  | cons name rest ih =>
      cases values with
      | nil => rfl
      | cons value values =>
          cases hAssign : ConcreteYul.assign? env name value with
          | none =>
              have hFull :
                  FullYul.assign? (embedConcreteEnv env) name
                      (embedWordValue value) = none := by
                simpa [hAssign] using
                  (embedConcreteEnv_assign? env name value).symm
              simp [ConcreteYul.assignMany?, FullYul.assignMany?, hAssign,
                hFull]
          | some env' =>
              have hFull :
                  FullYul.assign? (embedConcreteEnv env) name
                      (embedWordValue value) =
                    some (embedConcreteEnv env') := by
                simpa [hAssign] using
                  (embedConcreteEnv_assign? env name value).symm
              simp [ConcreteYul.assignMany?, FullYul.assignMany?, hAssign,
                hFull, ih env' values]

theorem embedConcreteEnv_restoreOuter
    (outer inner : ConcreteYul.Env) :
    (ConcreteYul.restoreOuter outer inner).map embedConcreteEnv =
      FullYul.restoreOuter (embedConcreteEnv outer) (embedConcreteEnv inner) := by
  induction outer with
  | nil =>
      rfl
  | cons binding rest ih =>
      cases binding with
      | mk name value =>
          cases hLookup : ConcreteYul.lookup? inner name with
          | none =>
              have hFullLookup :
                  FullYul.lookup? (embedConcreteEnv inner) name = none := by
                simpa [hLookup] using embedConcreteEnv_lookup? inner name
              simp [ConcreteYul.restoreOuter, FullYul.restoreOuter,
                embedConcreteEnv, hLookup, hFullLookup]
          | some innerValue =>
              have hFullLookup :
                  FullYul.lookup? (embedConcreteEnv inner) name =
                    some (embedWordValue innerValue) := by
                simpa [hLookup] using embedConcreteEnv_lookup? inner name
              cases hRest : ConcreteYul.restoreOuter rest inner with
              | none =>
                  have hFullRest :
                      FullYul.restoreOuter (embedConcreteEnv rest)
                          (embedConcreteEnv inner) = none := by
                    simpa [hRest] using ih.symm
                  simp [ConcreteYul.restoreOuter, FullYul.restoreOuter,
                    embedConcreteEnv, hLookup, hFullLookup, hRest, hFullRest]
              | some restoredRest =>
                  have hFullRest :
                      FullYul.restoreOuter (embedConcreteEnv rest)
                          (embedConcreteEnv inner) =
                        some (embedConcreteEnv restoredRest) := by
                    simpa [hRest] using ih.symm
                  simp [ConcreteYul.restoreOuter, FullYul.restoreOuter,
                    hLookup, hFullLookup, hRest, hFullRest, embedConcreteEnv]

theorem embedConcreteEnv_valuesForNames?
    (env : ConcreteYul.Env) (names : List FullYul.Name) :
    FullYul.valuesForNames? (embedConcreteEnv env) names =
      (ConcreteYul.valuesForNames? env names).map
        (List.map embedWordValue) := by
  induction names with
  | nil =>
      rfl
  | cons name rest ih =>
      cases hLookup : ConcreteYul.lookup? env name with
      | none =>
          have hFullLookup :
              FullYul.lookup? (embedConcreteEnv env) name = none := by
            simpa [hLookup] using embedConcreteEnv_lookup? env name
          simp [ConcreteYul.valuesForNames?, FullYul.valuesForNames?, hLookup,
            hFullLookup]
      | some value =>
          have hFullLookup :
              FullYul.lookup? (embedConcreteEnv env) name =
                some (embedWordValue value) := by
            simpa [hLookup] using embedConcreteEnv_lookup? env name
          cases hRest : ConcreteYul.valuesForNames? env rest with
          | none =>
              have hFullRest :
                  FullYul.valuesForNames? (embedConcreteEnv env) rest =
                    none := by
                simpa [hRest] using ih
              simp [ConcreteYul.valuesForNames?, FullYul.valuesForNames?,
                hLookup, hFullLookup, hRest, hFullRest]
          | some values =>
              have hFullRest :
                  FullYul.valuesForNames? (embedConcreteEnv env) rest =
                    some (values.map embedWordValue) := by
                simpa [hRest] using ih
              simp [ConcreteYul.valuesForNames?, FullYul.valuesForNames?,
                hLookup, hFullLookup, hRest, hFullRest]

theorem embedConcreteEnv_initFunctionEnv
    (params : List FullYul.Name) (args : List Word)
    (returns : List FullYul.Name) :
    (ConcreteYul.initFunctionEnv params args returns).map embedConcreteEnv =
      FullYul.initFunctionEnv params (args.map embedWordValue) returns := by
  unfold ConcreteYul.initFunctionEnv FullYul.initFunctionEnv
  cases hParams : ConcreteYul.declareMany? [] params args with
  | none =>
      have hFullParams :
          FullYul.declareMany? [] params (args.map embedWordValue) =
            none := by
        simpa [hParams, embedConcreteEnv] using
          (embedConcreteEnv_declareMany? [] params args).symm
      simp [hFullParams]
  | some paramEnv =>
      have hFullParams :
          FullYul.declareMany? [] params (args.map embedWordValue) =
            some (embedConcreteEnv paramEnv) := by
        simpa [hParams, embedConcreteEnv] using
          (embedConcreteEnv_declareMany? [] params args).symm
      cases hReturns :
          ConcreteYul.declareMany? paramEnv returns
            (returns.map (fun _ => 0)) with
      | none =>
          have hFullReturns :
              FullYul.declareMany? (embedConcreteEnv paramEnv) returns
                  (returns.map (fun _ => FullYul.Value.word 0)) = none := by
            have hRaw :
                FullYul.declareMany? (embedConcreteEnv paramEnv) returns
                    ((returns.map (fun _ => 0)).map embedWordValue) =
                  none := by
              simpa [hReturns] using
                (embedConcreteEnv_declareMany? paramEnv returns
                  (returns.map (fun _ => 0))).symm
            simpa [embedWordValue] using hRaw
          simp [hFullParams, hReturns, hFullReturns]
      | some callEnv =>
          have hFullReturns :
              FullYul.declareMany? (embedConcreteEnv paramEnv) returns
                  (returns.map (fun _ => FullYul.Value.word 0)) =
                some (embedConcreteEnv callEnv) := by
            have hRaw :
                FullYul.declareMany? (embedConcreteEnv paramEnv) returns
                    ((returns.map (fun _ => 0)).map embedWordValue) =
                  some (embedConcreteEnv callEnv) := by
              simpa [hReturns] using
                (embedConcreteEnv_declareMany? paramEnv returns
                  (returns.map (fun _ => 0))).symm
            simpa [embedWordValue] using hRaw
          simp [hFullParams, hReturns, hFullReturns]

theorem embedConcreteFunctionEnv_declareFunction_of_fresh
    {funcs : ConcreteYul.FunctionEnv} {name : FullYul.Name}
    {fn : ConcreteYul.FunctionDef}
    (hFresh : ConcreteYul.lookupFunction? funcs name = none) :
    embedConcreteFunctionEnv (ConcreteYul.declareFunction funcs name fn) =
      (name, embedConcreteNamedFunctionDef name fn) ::
        embedConcreteFunctionEnv funcs := by
  simp [ConcreteYul.declareFunction, hFresh, embedConcreteFunctionEnv]

theorem embedConcreteFunctionEnv_lookupFunction?
    (funcs : ConcreteYul.FunctionEnv) (name : FullYul.Name) :
    FullYul.lookupFunction? (embedConcreteFunctionEnv funcs) name =
      (ConcreteYul.lookupFunction? funcs name).map
        (embedConcreteNamedFunctionDef name) := by
  induction funcs with
  | nil =>
      rfl
  | cons binding rest ih =>
      cases binding with
      | mk candidate fn =>
          by_cases hName : candidate = name
          · subst candidate
            simp [embedConcreteFunctionEnv, ConcreteYul.lookupFunction?,
              FullYul.lookupFunction?]
          · simp [embedConcreteFunctionEnv, ConcreteYul.lookupFunction?,
              FullYul.lookupFunction?, hName, ih]

theorem embedConcreteFunctionEnv_declareFunction
    (funcs : ConcreteYul.FunctionEnv) (name : FullYul.Name)
    (fn : ConcreteYul.FunctionDef) :
    embedConcreteFunctionEnv (ConcreteYul.declareFunction funcs name fn) =
      SymYul.declareFunction (embedConcreteFunctionEnv funcs) name
        (embedConcreteNamedFunctionDef name fn) := by
  cases hLookup : ConcreteYul.lookupFunction? funcs name with
  | none =>
      have hFull :
          FullYul.lookupFunction? (embedConcreteFunctionEnv funcs) name =
            none := by
        simpa [hLookup] using
          embedConcreteFunctionEnv_lookupFunction? funcs name
      simp [ConcreteYul.declareFunction, SymYul.declareFunction, hLookup,
        hFull, embedConcreteFunctionEnv]
  | some existing =>
      have hFull :
          FullYul.lookupFunction? (embedConcreteFunctionEnv funcs) name =
            some (embedConcreteNamedFunctionDef name existing) := by
        simpa [hLookup] using
          embedConcreteFunctionEnv_lookupFunction? funcs name
      simp [ConcreteYul.declareFunction, SymYul.declareFunction, hLookup,
        hFull]

theorem guidedCollect_embedConcreteStmtFuel_funDef_stable_of_present
    (fuel : Nat) {funcs : ConcreteYul.FunctionEnv}
    {name : FullYul.Name} {params returns : List FullYul.Name}
    {body : ConcreteYul.Stmt} {existing : ConcreteYul.FunctionDef}
    (hPresent : ConcreteYul.lookupFunction? funcs name = some existing) :
    SymYul.collectStmtFunctionDefs
        (embedConcreteStmtFuel fuel.succ
          (ConcreteYul.Stmt.funDef name params returns body))
        (embedConcreteFunctionEnv funcs) =
      embedConcreteFunctionEnv funcs := by
  have hFullPresent :
      FullYul.lookupFunction? (embedConcreteFunctionEnv funcs) name =
        some (embedConcreteNamedFunctionDef name existing) := by
    simpa [hPresent] using embedConcreteFunctionEnv_lookupFunction? funcs name
  simp [embedConcreteStmtFuel, SymYul.collectStmtFunctionDefs,
    SymYul.declareFunction, hFullPresent]

theorem guidedCollect_seq_stable_of_parts
    {funcs : FullYul.FunctionEnv} {first second : FullYul.Stmt}
    (hFirst : SymYul.collectStmtFunctionDefs first funcs = funcs)
    (hSecond : SymYul.collectStmtFunctionDefs second funcs = funcs) :
    SymYul.collectStmtFunctionDefs (FullYul.Stmt.seq first second) funcs =
      funcs := by
  simp [SymYul.collectStmtFunctionDefs, hFirst, hSecond]

theorem evalRuntimeExpr_word_refines_guided
    (hash : ConcreteYul.HashOracle)
    (config : ConcreteYul.RuntimeConfig) (value : Word) :
    ConcreteYul.evalRuntimeExpr hash (ConcreteYul.Expr.word value) config =
      some (norm value, config) ∧
    SymYul.guidedEvalExpr (embedRuntimeConfig config)
        (embedConcreteExpr (ConcreteYul.Expr.word value)) =
      some (embedWordValue value, embedRuntimeConfig config) := by
  constructor <;> rfl

theorem evalRuntimeExpr_var_refines_guided
    (hash : ConcreteYul.HashOracle)
    {config : ConcreteYul.RuntimeConfig} {name : FullYul.Name}
    {value : Word}
    (hLookup : ConcreteYul.lookup? config.env name = some value) :
    ConcreteYul.evalRuntimeExpr hash (ConcreteYul.Expr.var name) config =
      some (value, config) ∧
    SymYul.guidedEvalExpr (embedRuntimeConfig config)
        (embedConcreteExpr (ConcreteYul.Expr.var name)) =
      some (embedWordValue value, embedRuntimeConfig config) := by
  have hFull :
      FullYul.lookup? (embedConcreteEnv config.env) name =
        some (embedWordValue value) := by
    simpa [hLookup] using embedConcreteEnv_lookup? config.env name
  constructor
  · simp [ConcreteYul.evalRuntimeExpr, ConcreteYul.evalExpr,
      ConcreteYul.RuntimeConfig.toConfig, ConcreteYul.RuntimeConfig.withConfig,
      hLookup]
  · simp [SymYul.guidedEvalExpr, embedConcreteExpr, embedRuntimeConfig, hFull]

theorem evalRuntimeExpr_dataSize_refines_guided
    (hash : ConcreteYul.HashOracle)
    {config : ConcreteYul.RuntimeConfig} {label : FullYul.DataLabel}
