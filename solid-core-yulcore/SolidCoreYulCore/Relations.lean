      ConcreteYul.valuesForNames? concreteConfig.env returns = some values) :
    ∃ symbolicValues symbolicConfig,
      SymYul.guidedReturnValues? returns symbolicResult =
        some (symbolicValues, symbolicConfig) ∧
      WordListRel model values symbolicValues ∧
      RuntimeConfigRel model concreteConfig symbolicConfig := by
  rcases symbolicResult with ⟨symbolicFlow, symbolicConfig⟩
  have hFlow : symbolicFlow = FullYul.Flow.normal := by
    simpa [embedCompleteFlow] using hRel.flowRel
  subst symbolicFlow
  rcases envRel_valuesForNames? hRel.configRel.envRel hValues with
    ⟨symbolicValues, hSymbolicValues, hValuesRel⟩
  exact
    ⟨ symbolicValues
    , symbolicConfig
    , by simp [SymYul.guidedReturnValues?, hSymbolicValues]
