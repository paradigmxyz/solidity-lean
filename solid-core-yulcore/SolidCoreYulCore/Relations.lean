theorem collectStmtFunctionDefs_embedRuntimeFunctionBodyCovered_rel_ge
    {spec : RuntimeCoverageSpec}
    {minEmbedFuel embedFuel : Nat} {stmt : ConcreteYul.Stmt}
    {concreteFuncs : ConcreteYul.FunctionEnv}
    {symbolicFuncs : FullYul.FunctionEnv}
    (hCovered : RuntimeFunctionBodyCoveredSpec spec minEmbedFuel stmt)
    (hEmbedFuel : minEmbedFuel ≤ embedFuel)
    (hFuncs : symbolicFuncs = embedConcreteFunctionEnv concreteFuncs) :
    SymYul.collectStmtFunctionDefs
        (embedConcreteStmtFuel embedFuel stmt) symbolicFuncs =
      embedConcreteFunctionEnv
        (ConcreteYul.collectStmtFunctionDefs stmt concreteFuncs) := by
  induction hCovered generalizing embedFuel concreteFuncs symbolicFuncs with
  | stmt hStmt =>
      have hConcreteStable :
          ConcreteYul.collectStmtFunctionDefs _ concreteFuncs =
            concreteFuncs :=
        collectStmtFunctionDefs_runtimeCoveredStmt_stable hStmt
      have hSymbolicStable :
          SymYul.collectStmtFunctionDefs
              (embedConcreteStmtFuel embedFuel _) symbolicFuncs =
            symbolicFuncs :=
        collectStmtFunctionDefs_embedRuntimeCoveredStmt_stable_ge hStmt
          hEmbedFuel
      calc
        SymYul.collectStmtFunctionDefs
            (embedConcreteStmtFuel embedFuel _) symbolicFuncs =
            symbolicFuncs := hSymbolicStable
        _ = embedConcreteFunctionEnv concreteFuncs := hFuncs
        _ = embedConcreteFunctionEnv
              (ConcreteYul.collectStmtFunctionDefs _ concreteFuncs) := by
            rw [hConcreteStable]
  | block hBlock =>
      cases embedFuel <;>
        simp [embedConcreteStmtFuel, ConcreteYul.collectStmtFunctionDefs,
          SymYul.collectStmtFunctionDefs, hFuncs]
  | funDef hBody hBodyEmbed ihBody =>
      cases embedFuel with
      | zero =>
          cases hEmbedFuel
      | succ bodyEmbedFuel =>
          rename_i fnName params returns body bodyMinEmbedFuel
          let fn : ConcreteYul.FunctionDef :=
            { params := params, returns := returns, body := body }
          have hCanonicalLe :
              sizeOf (ConcreteYul.Stmt.funDef fnName params returns body) ≤
                bodyEmbedFuel :=
            Nat.succ_le_succ_iff.mp
              (by
                simpa [Nat.succ_eq_add_one] using hEmbedFuel)
          have hBodyLtCanonical :
              sizeOf body <
                sizeOf (ConcreteYul.Stmt.funDef fnName params returns body) := by
            simp
            omega
          have hBodyStable :
              embedConcreteStmtFuel bodyEmbedFuel body =
                (embedConcreteNamedFunctionDef fnName fn).body := by
            dsimp [embedConcreteNamedFunctionDef, fn]
            exact
              embedConcreteStmtFuel_eq_of_size_lt body
                (Nat.lt_of_lt_of_le hBodyLtCanonical hCanonicalLe)
                hBodyLtCanonical
          calc
            SymYul.collectStmtFunctionDefs
                (embedConcreteStmtFuel bodyEmbedFuel.succ
                  (ConcreteYul.Stmt.funDef fnName params returns body))
                symbolicFuncs =
                SymYul.declareFunction symbolicFuncs fnName
                  { params := params
                    returns := returns
                    body := embedConcreteStmtFuel bodyEmbedFuel body } := by
                simp [embedConcreteStmtFuel,
                  SymYul.collectStmtFunctionDefs]
            _ = SymYul.declareFunction
                  (embedConcreteFunctionEnv concreteFuncs)
                  fnName
                  { params := params
                    returns := returns
                    body := embedConcreteStmtFuel bodyEmbedFuel body } := by
                rw [hFuncs]
            _ = SymYul.declareFunction
                  (embedConcreteFunctionEnv concreteFuncs)
                  fnName (embedConcreteNamedFunctionDef fnName fn) := by
                simp [embedConcreteNamedFunctionDef, fn, hBodyStable]
            _ = embedConcreteFunctionEnv
                  (ConcreteYul.declareFunction concreteFuncs fnName fn) := by
                exact
                  (embedConcreteFunctionEnv_declareFunction concreteFuncs
                    fnName fn).symm
            _ = embedConcreteFunctionEnv
                  (ConcreteYul.collectStmtFunctionDefs
                    (ConcreteYul.Stmt.funDef fnName params returns body)
                    concreteFuncs) := by
                simp [ConcreteYul.collectStmtFunctionDefs, fn]
  | seq hFirst hSecond ihFirst ihSecond =>
      cases embedFuel with
      | zero =>
          cases hEmbedFuel
      | succ embedFuel =>
          have hInnerEmbed :=
            Nat.succ_le_succ_iff.mp
              (by
                simpa [Nat.succ_eq_add_one] using hEmbedFuel)
          have hFirstEmbed :=
            Nat.le_trans (Nat.le_max_left _ _) hInnerEmbed
          have hSecondEmbed :=
            Nat.le_trans (Nat.le_max_right _ _) hInnerEmbed
          have hFirstRel :
              SymYul.collectStmtFunctionDefs
                  (embedConcreteStmtFuel embedFuel _) symbolicFuncs =
                embedConcreteFunctionEnv
                  (ConcreteYul.collectStmtFunctionDefs _ concreteFuncs) :=
            ihFirst hFirstEmbed hFuncs
          have hSecondRel :=
            ihSecond
              (concreteFuncs :=
                ConcreteYul.collectStmtFunctionDefs _ concreteFuncs)
              (symbolicFuncs :=
                SymYul.collectStmtFunctionDefs
                  (embedConcreteStmtFuel embedFuel _) symbolicFuncs)
              hSecondEmbed hFirstRel
          simp [embedConcreteStmtFuel, ConcreteYul.collectStmtFunctionDefs,
            SymYul.collectStmtFunctionDefs]
          exact hSecondRel
  | ifThen hCond hBody =>
      cases embedFuel <;>
        simp [embedConcreteStmtFuel, ConcreteYul.collectStmtFunctionDefs,
          SymYul.collectStmtFunctionDefs, hFuncs]
  | switch hSwitch =>
      cases embedFuel <;>
        simp [embedConcreteStmtFuel, ConcreteYul.collectStmtFunctionDefs,
          SymYul.collectStmtFunctionDefs, hFuncs]
  | forLoop hPre hCond hPost hBody =>
      cases embedFuel <;>
        simp [embedConcreteStmtFuel, ConcreteYul.collectStmtFunctionDefs,
          SymYul.collectStmtFunctionDefs, hFuncs]

