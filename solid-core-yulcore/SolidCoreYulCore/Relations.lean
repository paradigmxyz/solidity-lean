        · have hMemorySizeAfter :=
            memorySizeAfter_congr_current
              (lhs := symbolic.msize) (rhs := concrete.memorySize)
              (offset := offset) (size := size) hMemorySize
          simp [ConcreteYul.haltWith, ConcreteYul.expandMemory,
            FullYul.haltWith, FullYul.expandMemory, hMemorySizeAfter]
