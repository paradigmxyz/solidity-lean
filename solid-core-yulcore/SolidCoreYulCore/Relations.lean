theorem runtimeFunctionBodySwitchCasesCoveredSpec_target_guided
    (model : SymYul.ConcreteModel)
    {spec : RuntimeCoverageSpec} {baseFuel defaultEmbedFuel : Nat}
    {value : Word} {cases : List (Word × ConcreteYul.Stmt)}
    {defaultBranch : Option ConcreteYul.Stmt}
    {target : ConcreteYul.Stmt}
    (hCases :
      RuntimeFunctionBodySwitchCasesCoveredSpec spec baseFuel cases)
    (hDefault :
      match defaultBranch with
      | none => True
      | some stmt =>
          ∃ minEmbedFuel,
            RuntimeFunctionBodyCoveredSpec spec minEmbedFuel stmt ∧
              minEmbedFuel ≤ defaultEmbedFuel)
    (hTarget :
      ConcreteYul.switchTarget? value cases defaultBranch = some target) :
    ∃ targetEmbedFuel, ∃ minEmbedFuel,
      RuntimeFunctionBodyCoveredSpec spec minEmbedFuel target ∧
      minEmbedFuel ≤ targetEmbedFuel ∧
      ∀ symbolicValue,
        ValueRel model value symbolicValue ->
        SymYul.guidedSwitchTarget? model symbolicValue
            (embedConcreteSwitchCasesFuel
              (cases.length + baseFuel + 2) cases)
            (defaultBranch.map (embedConcreteStmtFuel defaultEmbedFuel)) =
          some (embedConcreteStmtFuel targetEmbedFuel target) := by
  induction hCases generalizing target defaultBranch with
  | nil =>
      cases defaultBranch with
      | none =>
          simp [ConcreteYul.switchTarget?] at hTarget
      | some branch =>
          rcases hDefault with ⟨minEmbedFuel, hBody, hEmbedFuel⟩
          have hEq : branch = target := by
            simpa [ConcreteYul.switchTarget?] using hTarget
          subst target
          exact
            ⟨ defaultEmbedFuel
            , minEmbedFuel
            , hBody
            , hEmbedFuel
            , by
                intro symbolicValue _hValueRel
                simp [embedConcreteSwitchCasesFuel,
                  SymYul.guidedSwitchTarget?] ⟩
  | cons hBranch hBranchEmbed hRest ih =>
      rename_i label branch rest branchEmbedFuel
      by_cases hMatch : norm label = norm value
      · have hEq : branch = target := by
          simpa [ConcreteYul.switchTarget?, hMatch] using hTarget
        subst target
        exact
          ⟨ rest.length + baseFuel + 2
          , branchEmbedFuel
          , hBranch
          , hBranchEmbed
          , by
              intro symbolicValue hValueRel
              have hGuidedMatch :
                  norm (SymYul.interpValue model symbolicValue) =
                    norm (SymYul.interpValue model (embedWordValue label)) := by
                have hLeft :
                    norm (SymYul.interpValue model symbolicValue) =
                      norm value := by
                  rw [interpValue_norm model symbolicValue, ← hValueRel]
                have hRight :
                    norm (SymYul.interpValue model (embedWordValue label)) =
                      norm label := by
                  simp [SymYul.interpValue, embedWordValue, norm_norm]
                calc
                  norm (SymYul.interpValue model symbolicValue) =
                      norm value :=
                    hLeft
                  _ = norm label := hMatch.symm
                  _ = norm (SymYul.interpValue model (embedWordValue label)) :=
                    hRight.symm
              simp [embedConcreteSwitchCasesFuel, SymYul.guidedSwitchTarget?,
                hGuidedMatch, Nat.add_assoc, Nat.add_left_comm,
                Nat.add_comm] ⟩
      · have hRestTarget :
            ConcreteYul.switchTarget? value rest defaultBranch =
              some target := by
          simpa [ConcreteYul.switchTarget?, hMatch] using hTarget
        rcases ih hDefault hRestTarget with
