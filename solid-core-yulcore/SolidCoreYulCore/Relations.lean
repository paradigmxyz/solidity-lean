    (singleNonBuiltinRel :
      ∀ {concreteConfig : C} {symbolicConfig : S}
        {expr : ConcreteYul.Expr},
        (∀ builtin args, expr ≠ ConcreteYul.Expr.builtin builtin args) ->
        (∀ {concreteConfig' : C} {symbolicConfig' : S},
          ExprRel concreteConfig' symbolicConfig' expr) ->
        ValuesRel concreteConfig symbolicConfig [expr])
    (singleBuiltinOneRel :
      ∀ {concreteConfig : C} {symbolicConfig : S}
        {builtin : Evm.Builtin} {args : List ConcreteYul.Expr}
        {sig : Evm.BuiltinSignature},
        BuiltinExprOK builtin args ->
        builtin.signature? = some sig ->
        sig.resultCount = 1 ->
        ExprsRel concreteConfig symbolicConfig args ->
        ValuesRel concreteConfig symbolicConfig
          [ConcreteYul.Expr.builtin builtin args]) :
    RuntimeExprsAsYulValuesCoveredAlg BuiltinExprOK BuiltinValuesOK
      ExprRel ExprsRel ValuesRel where
  nil := nilRel
  consCons := consConsRel
  singleNonBuiltin := singleNonBuiltinRel
  singleBuiltinOne := singleBuiltinOneRel
  singleBuiltinValues hOK hArgs := primitive.builtinValues hOK hArgs

theorem RuntimeExprsAsYulValuesCovered.foldRel
    {C : Type u} {S : Type v}
    {DataOffsetOK : FullYul.DataLabel -> Prop}
    {BuiltinExprOK BuiltinValuesOK :
      Evm.Builtin -> List ConcreteYul.Expr -> Prop}
    {ExprRel : C -> S -> ConcreteYul.Expr -> Prop}
    {ExprsRel : C -> S -> List ConcreteYul.Expr -> Prop}
    {ValuesRel : C -> S -> List ConcreteYul.Expr -> Prop}
    (exprAlg :
      RuntimeExprCoveredAlg DataOffsetOK BuiltinExprOK BuiltinValuesOK
        ExprRel ExprsRel)
    (valuesAlg :
      RuntimeExprsAsYulValuesCoveredAlg BuiltinExprOK BuiltinValuesOK
        ExprRel ExprsRel ValuesRel) :
    ∀ {exprs : List ConcreteYul.Expr},
      RuntimeExprsAsYulValuesCovered DataOffsetOK BuiltinExprOK
        BuiltinValuesOK exprs ->
      ∀ {concreteConfig : C} {symbolicConfig : S},
        ValuesRel concreteConfig symbolicConfig exprs
  | _, RuntimeExprsAsYulValuesCovered.nil => valuesAlg.nil
  | _, RuntimeExprsAsYulValuesCovered.consCons hExpr₁ hExpr₂ hRest =>
      valuesAlg.consCons
        (RuntimeExprCovered.foldRel exprAlg hExpr₁)
        (RuntimeExprCovered.foldRel exprAlg hExpr₂)
        (RuntimeExprsCovered.foldRel exprAlg hRest)
  | _, RuntimeExprsAsYulValuesCovered.singleNonBuiltin hNotBuiltin hExpr =>
      valuesAlg.singleNonBuiltin hNotBuiltin
        (RuntimeExprCovered.foldRel exprAlg hExpr)
  | _,
      RuntimeExprsAsYulValuesCovered.singleBuiltinOne hArgs hOK hSig hOne =>
      valuesAlg.singleBuiltinOne hOK hSig hOne
        (RuntimeExprsCovered.foldRel exprAlg hArgs)
  | _, RuntimeExprsAsYulValuesCovered.singleBuiltinValues hArgs hOK =>
      valuesAlg.singleBuiltinValues hOK
        (RuntimeExprsCovered.foldRel exprAlg hArgs)

inductive RuntimeStraightStmtCovered
    (DataOffsetOK : FullYul.DataLabel -> Prop)
    (BuiltinExprOK BuiltinValuesOK :
      Evm.Builtin -> List ConcreteYul.Expr -> Prop) :
    ConcreteYul.Stmt -> Prop where
  | skip :
      RuntimeStraightStmtCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK
        ConcreteYul.Stmt.skip
  | expr {expr : ConcreteYul.Expr} :
      RuntimeExprCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK expr ->
      RuntimeStraightStmtCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK
        (ConcreteYul.Stmt.expr expr)
  | let1None {name : FullYul.Name} :
      RuntimeStraightStmtCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK
        (ConcreteYul.Stmt.let1 name none)
  | let1Some {name : FullYul.Name} {expr : ConcreteYul.Expr} :
      RuntimeExprCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK expr ->
      RuntimeStraightStmtCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK
        (ConcreteYul.Stmt.let1 name (some expr))
  | letManyNone {names : List FullYul.Name} :
      RuntimeStraightStmtCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK
        (ConcreteYul.Stmt.letMany names none)
  | letManySome {names : List FullYul.Name}
      {exprs : List ConcreteYul.Expr} :
      RuntimeExprsAsYulValuesCovered DataOffsetOK BuiltinExprOK
        BuiltinValuesOK exprs ->
      RuntimeStraightStmtCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK
        (ConcreteYul.Stmt.letMany names (some exprs))
  | assign {name : FullYul.Name} {expr : ConcreteYul.Expr} :
      RuntimeExprCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK expr ->
      RuntimeStraightStmtCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK
        (ConcreteYul.Stmt.assign name expr)
  | assignMany {names : List FullYul.Name}
      {exprs : List ConcreteYul.Expr} :
      RuntimeExprsAsYulValuesCovered DataOffsetOK BuiltinExprOK
        BuiltinValuesOK exprs ->
      RuntimeStraightStmtCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK
        (ConcreteYul.Stmt.assignMany names exprs)
  | break :
      RuntimeStraightStmtCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK
        ConcreteYul.Stmt.break
  | continue :
      RuntimeStraightStmtCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK
        ConcreteYul.Stmt.continue
  | leave :
      RuntimeStraightStmtCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK
        ConcreteYul.Stmt.leave

structure RuntimeStraightStmtCoveredAlg
    {C : Type u} {S : Type v}
    (ExprRel : C -> S -> ConcreteYul.Expr -> Prop)
    (ValuesRel : C -> S -> List ConcreteYul.Expr -> Prop)
    (StmtRel : Nat -> Nat -> C -> S -> ConcreteYul.Stmt -> Prop) :
    Prop where
  skip :
    ∀ {fuel embedFuel : Nat} {concreteConfig : C} {symbolicConfig : S},
      StmtRel fuel.succ embedFuel.succ concreteConfig symbolicConfig
        ConcreteYul.Stmt.skip
  expr :
    ∀ {fuel embedFuel : Nat} {concreteConfig : C} {symbolicConfig : S}
      {expr : ConcreteYul.Expr},
      ExprRel concreteConfig symbolicConfig expr ->
      StmtRel fuel.succ embedFuel.succ concreteConfig symbolicConfig
        (ConcreteYul.Stmt.expr expr)
  let1None :
    ∀ {fuel embedFuel : Nat} {concreteConfig : C} {symbolicConfig : S}
      {name : FullYul.Name},
      StmtRel fuel.succ embedFuel.succ concreteConfig symbolicConfig
        (ConcreteYul.Stmt.let1 name none)
  let1Some :
    ∀ {fuel embedFuel : Nat} {concreteConfig : C} {symbolicConfig : S}
      {name : FullYul.Name} {expr : ConcreteYul.Expr},
      ExprRel concreteConfig symbolicConfig expr ->
      StmtRel fuel.succ embedFuel.succ concreteConfig symbolicConfig
        (ConcreteYul.Stmt.let1 name (some expr))
  letManyNone :
    ∀ {fuel embedFuel : Nat} {concreteConfig : C} {symbolicConfig : S}
      {names : List FullYul.Name},
      StmtRel fuel.succ embedFuel.succ concreteConfig symbolicConfig
        (ConcreteYul.Stmt.letMany names none)
  letManySome :
    ∀ {fuel embedFuel : Nat} {concreteConfig : C} {symbolicConfig : S}
      {names : List FullYul.Name} {exprs : List ConcreteYul.Expr},
      ValuesRel concreteConfig symbolicConfig exprs ->
      StmtRel fuel.succ embedFuel.succ concreteConfig symbolicConfig
        (ConcreteYul.Stmt.letMany names (some exprs))
  assign :
    ∀ {fuel embedFuel : Nat} {concreteConfig : C} {symbolicConfig : S}
      {name : FullYul.Name} {expr : ConcreteYul.Expr},
      ExprRel concreteConfig symbolicConfig expr ->
      StmtRel fuel.succ embedFuel.succ concreteConfig symbolicConfig
        (ConcreteYul.Stmt.assign name expr)
  assignMany :
    ∀ {fuel embedFuel : Nat} {concreteConfig : C} {symbolicConfig : S}
      {names : List FullYul.Name} {exprs : List ConcreteYul.Expr},
      ValuesRel concreteConfig symbolicConfig exprs ->
      StmtRel fuel.succ embedFuel.succ concreteConfig symbolicConfig
        (ConcreteYul.Stmt.assignMany names exprs)
  breakFlow :
    ∀ {fuel embedFuel : Nat} {concreteConfig : C} {symbolicConfig : S},
      StmtRel fuel.succ embedFuel.succ concreteConfig symbolicConfig
        ConcreteYul.Stmt.break
  continueFlow :
    ∀ {fuel embedFuel : Nat} {concreteConfig : C} {symbolicConfig : S},
      StmtRel fuel.succ embedFuel.succ concreteConfig symbolicConfig
        ConcreteYul.Stmt.continue
  leaveFlow :
    ∀ {fuel embedFuel : Nat} {concreteConfig : C} {symbolicConfig : S},
      StmtRel fuel.succ embedFuel.succ concreteConfig symbolicConfig
        ConcreteYul.Stmt.leave

theorem RuntimeStraightStmtCovered.foldRel
    {C : Type u} {S : Type v}
    {DataOffsetOK : FullYul.DataLabel -> Prop}
    {BuiltinExprOK BuiltinValuesOK :
      Evm.Builtin -> List ConcreteYul.Expr -> Prop}
    {ExprRel : C -> S -> ConcreteYul.Expr -> Prop}
    {ExprsRel : C -> S -> List ConcreteYul.Expr -> Prop}
    {ValuesRel : C -> S -> List ConcreteYul.Expr -> Prop}
    {StmtRel : Nat -> Nat -> C -> S -> ConcreteYul.Stmt -> Prop}
    (exprAlg :
      RuntimeExprCoveredAlg DataOffsetOK BuiltinExprOK BuiltinValuesOK
        ExprRel ExprsRel)
    (valuesAlg :
      RuntimeExprsAsYulValuesCoveredAlg BuiltinExprOK BuiltinValuesOK
        ExprRel ExprsRel ValuesRel)
    (stmtAlg :
      RuntimeStraightStmtCoveredAlg ExprRel ValuesRel StmtRel) :
    ∀ {stmt : ConcreteYul.Stmt},
      RuntimeStraightStmtCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK
        stmt ->
      ∀ {fuel embedFuel : Nat} {concreteConfig : C} {symbolicConfig : S},
        StmtRel fuel.succ embedFuel.succ concreteConfig symbolicConfig stmt
  | _, RuntimeStraightStmtCovered.skip => stmtAlg.skip
  | _, RuntimeStraightStmtCovered.expr hExpr =>
      stmtAlg.expr (RuntimeExprCovered.foldRel exprAlg hExpr)
  | _, RuntimeStraightStmtCovered.let1None => stmtAlg.let1None
  | _, RuntimeStraightStmtCovered.let1Some hExpr =>
      stmtAlg.let1Some (RuntimeExprCovered.foldRel exprAlg hExpr)
  | _, RuntimeStraightStmtCovered.letManyNone => stmtAlg.letManyNone
  | _, RuntimeStraightStmtCovered.letManySome hExprs =>
      stmtAlg.letManySome
        (RuntimeExprsAsYulValuesCovered.foldRel exprAlg valuesAlg hExprs)
  | _, RuntimeStraightStmtCovered.assign hExpr =>
      stmtAlg.assign (RuntimeExprCovered.foldRel exprAlg hExpr)
  | _, RuntimeStraightStmtCovered.assignMany hExprs =>
      stmtAlg.assignMany
        (RuntimeExprsAsYulValuesCovered.foldRel exprAlg valuesAlg hExprs)
  | _, RuntimeStraightStmtCovered.break => stmtAlg.breakFlow
  | _, RuntimeStraightStmtCovered.continue => stmtAlg.continueFlow
  | _, RuntimeStraightStmtCovered.leave => stmtAlg.leaveFlow

def RuntimeFuelBudgetedRel
    {C : Type u} {S : Type v} {α : Type}
    (maxFuel : Nat)
    (Rel : Nat -> Nat -> C -> S -> α -> Prop) :
    Nat -> Nat -> C -> S -> α -> Prop :=
  fun fuel embedFuel concreteConfig symbolicConfig item =>
    fuel.pred ≤ maxFuel ->
      Rel fuel embedFuel concreteConfig symbolicConfig item

def RuntimeStraightStmtCoveredAlg.withFuelBudget
    {C : Type u} {S : Type v}
    {ExprRel : C -> S -> ConcreteYul.Expr -> Prop}
    {ValuesRel : C -> S -> List ConcreteYul.Expr -> Prop}
    {StmtRel : Nat -> Nat -> C -> S -> ConcreteYul.Stmt -> Prop}
    (alg : RuntimeStraightStmtCoveredAlg ExprRel ValuesRel StmtRel)
    (maxFuel : Nat) :
    RuntimeStraightStmtCoveredAlg ExprRel ValuesRel
      (RuntimeFuelBudgetedRel maxFuel StmtRel) where
  skip := fun {_fuel} {_embedFuel} {_concreteConfig} {_symbolicConfig}
      _hFuel =>
    alg.skip
  expr := fun {_fuel} {_embedFuel} {_concreteConfig} {_symbolicConfig}
      {_expr} hExpr _hFuel =>
    alg.expr hExpr
  let1None := fun {_fuel} {_embedFuel} {_concreteConfig} {_symbolicConfig}
      {_name} _hFuel =>
    alg.let1None
  let1Some := fun {_fuel} {_embedFuel} {_concreteConfig} {_symbolicConfig}
      {_name} {_expr} hExpr _hFuel =>
    alg.let1Some hExpr
  letManyNone := fun {_fuel} {_embedFuel} {_concreteConfig}
      {_symbolicConfig} {_names} _hFuel =>
    alg.letManyNone
  letManySome := fun {_fuel} {_embedFuel} {_concreteConfig}
      {_symbolicConfig} {_names} {_exprs} hExprs _hFuel =>
    alg.letManySome hExprs
  assign := fun {_fuel} {_embedFuel} {_concreteConfig} {_symbolicConfig}
      {_name} {_expr} hExpr _hFuel =>
    alg.assign hExpr
  assignMany := fun {_fuel} {_embedFuel} {_concreteConfig}
      {_symbolicConfig} {_names} {_exprs} hExprs _hFuel =>
    alg.assignMany hExprs
  breakFlow := fun {_fuel} {_embedFuel} {_concreteConfig} {_symbolicConfig}
      _hFuel =>
    alg.breakFlow
  continueFlow := fun {_fuel} {_embedFuel} {_concreteConfig}
      {_symbolicConfig} _hFuel =>
    alg.continueFlow
  leaveFlow := fun {_fuel} {_embedFuel} {_concreteConfig} {_symbolicConfig}
      _hFuel =>
    alg.leaveFlow

inductive RuntimeStraightBlockCovered
    (DataOffsetOK : FullYul.DataLabel -> Prop)
    (BuiltinExprOK BuiltinValuesOK :
      Evm.Builtin -> List ConcreteYul.Expr -> Prop) :
    Nat -> List ConcreteYul.Stmt -> Prop where
  | nil :
      RuntimeStraightBlockCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK
        0 []
  | cons {stmt : ConcreteYul.Stmt} {rest : List ConcreteYul.Stmt}
      {length : Nat} :
      RuntimeStraightStmtCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK
        stmt ->
      RuntimeStraightBlockCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK
        length rest ->
      RuntimeStraightBlockCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK
        length.succ (stmt :: rest)

structure RuntimeStraightBlockCoveredAlg
    {C : Type u} {S : Type v}
    (ConfigRel : C -> S -> Prop)
    (StmtRel : Nat -> Nat -> C -> S -> ConcreteYul.Stmt -> Prop)
    (BlockRel : Nat -> Nat -> C -> S -> List ConcreteYul.Stmt -> Prop) :
    Prop where
  nil :
    ∀ {fuel embedFuel : Nat} {concreteConfig : C} {symbolicConfig : S},
      BlockRel fuel.succ embedFuel concreteConfig symbolicConfig []
  cons :
    ∀ {fuel embedFuel : Nat} {concreteConfig : C} {symbolicConfig : S}
      {stmt : ConcreteYul.Stmt} {rest : List ConcreteYul.Stmt},
      StmtRel fuel embedFuel concreteConfig symbolicConfig stmt ->
      (∀ {concreteConfig' : C} {symbolicConfig' : S},
        ConfigRel concreteConfig' symbolicConfig' ->
        BlockRel fuel embedFuel concreteConfig' symbolicConfig' rest) ->
      BlockRel fuel.succ embedFuel.succ concreteConfig symbolicConfig
        (stmt :: rest)

theorem RuntimeStraightBlockCovered.foldRel
    {C : Type u} {S : Type v}
    {DataOffsetOK : FullYul.DataLabel -> Prop}
    {BuiltinExprOK BuiltinValuesOK :
      Evm.Builtin -> List ConcreteYul.Expr -> Prop}
    {ExprRel : C -> S -> ConcreteYul.Expr -> Prop}
    {ExprsRel : C -> S -> List ConcreteYul.Expr -> Prop}
    {ValuesRel : C -> S -> List ConcreteYul.Expr -> Prop}
    {ConfigRel : C -> S -> Prop}
    {StmtRel : Nat -> Nat -> C -> S -> ConcreteYul.Stmt -> Prop}
    {BlockRel : Nat -> Nat -> C -> S -> List ConcreteYul.Stmt -> Prop}
    (exprAlg :
      RuntimeExprCoveredAlg DataOffsetOK BuiltinExprOK BuiltinValuesOK
        ExprRel ExprsRel)
    (valuesAlg :
      RuntimeExprsAsYulValuesCoveredAlg BuiltinExprOK BuiltinValuesOK
        ExprRel ExprsRel ValuesRel)
    (stmtAlg :
      RuntimeStraightStmtCoveredAlg ExprRel ValuesRel StmtRel)
    (blockAlg :
      RuntimeStraightBlockCoveredAlg ConfigRel StmtRel BlockRel) :
    ∀ {length : Nat} {stmts : List ConcreteYul.Stmt},
      RuntimeStraightBlockCovered DataOffsetOK BuiltinExprOK
        BuiltinValuesOK length stmts ->
      ∀ {fuel embedFuel : Nat} {concreteConfig : C} {symbolicConfig : S},
        BlockRel (fuel + length + 1) (embedFuel + length + 1)
          concreteConfig symbolicConfig stmts
  | 0, [], RuntimeStraightBlockCovered.nil => by
      simpa [Nat.add_assoc] using
        blockAlg.nil
  | Nat.succ length, stmt :: rest,
      RuntimeStraightBlockCovered.cons hStmt hRest => by
      simpa [Nat.succ_eq_add_one, Nat.add_assoc] using
        blockAlg.cons
          (by
            simpa [Nat.succ_eq_add_one, Nat.add_assoc] using
              (RuntimeStraightStmtCovered.foldRel exprAlg valuesAlg stmtAlg
                hStmt))
          (fun {_concreteConfig'} {_symbolicConfig'} _hConfigRel =>
            RuntimeStraightBlockCovered.foldRel exprAlg valuesAlg stmtAlg
              blockAlg hRest)

inductive RuntimeCoveredStmt
    (DataOffsetOK : FullYul.DataLabel -> Prop)
    (BuiltinExprOK BuiltinValuesOK :
      Evm.Builtin -> List ConcreteYul.Expr -> Prop)
    (FunctionOK : FullYul.Name -> List ConcreteYul.Expr -> Prop) :
    ConcreteYul.Stmt -> Prop where
  | straight {stmt : ConcreteYul.Stmt} :
      RuntimeStraightStmtCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK
        stmt ->
      RuntimeCoveredStmt DataOffsetOK BuiltinExprOK BuiltinValuesOK
        FunctionOK stmt
  | letCall {names : List FullYul.Name} {fnName : FullYul.Name}
      {args : List ConcreteYul.Expr} :
      RuntimeExprsCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK args ->
      FunctionOK fnName args ->
      RuntimeCoveredStmt DataOffsetOK BuiltinExprOK BuiltinValuesOK
        FunctionOK (ConcreteYul.Stmt.letCall names fnName args)
  | assignCall {names : List FullYul.Name} {fnName : FullYul.Name}
      {args : List ConcreteYul.Expr} :
      RuntimeExprsCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK args ->
      FunctionOK fnName args ->
      RuntimeCoveredStmt DataOffsetOK BuiltinExprOK BuiltinValuesOK
        FunctionOK (ConcreteYul.Stmt.assignCall names fnName args)
  | ifStraight {cond : ConcreteYul.Expr} {body : ConcreteYul.Stmt} :
      RuntimeExprCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK cond ->
      RuntimeStraightStmtCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK
        body ->
      RuntimeCoveredStmt DataOffsetOK BuiltinExprOK BuiltinValuesOK
        FunctionOK (ConcreteYul.Stmt.ifThen cond body)

structure RuntimeCoveredStmtAlg
    {C : Type u} {S : Type v}
    (ConfigRel : C -> S -> Prop)
    (ExprRel : C -> S -> ConcreteYul.Expr -> Prop)
    (ExprsRel : C -> S -> List ConcreteYul.Expr -> Prop)
    (StmtRel : Nat -> Nat -> C -> S -> ConcreteYul.Stmt -> Prop)
    (FunctionOK : FullYul.Name -> List ConcreteYul.Expr -> Prop) :
    Prop where
  letCall :
    ∀ {fuel embedFuel : Nat} {concreteConfig : C} {symbolicConfig : S}
      {names : List FullYul.Name} {fnName : FullYul.Name}
      {args : List ConcreteYul.Expr},
      ExprsRel concreteConfig symbolicConfig args ->
      FunctionOK fnName args ->
      StmtRel fuel.succ.succ embedFuel.succ.succ concreteConfig
        symbolicConfig (ConcreteYul.Stmt.letCall names fnName args)
  assignCall :
    ∀ {fuel embedFuel : Nat} {concreteConfig : C} {symbolicConfig : S}
      {names : List FullYul.Name} {fnName : FullYul.Name}
      {args : List ConcreteYul.Expr},
      ExprsRel concreteConfig symbolicConfig args ->
      FunctionOK fnName args ->
      StmtRel fuel.succ.succ embedFuel.succ.succ concreteConfig
        symbolicConfig (ConcreteYul.Stmt.assignCall names fnName args)
  ifStraight :
    ∀ {fuel embedFuel : Nat} {concreteConfig : C} {symbolicConfig : S}
      {cond : ConcreteYul.Expr} {body : ConcreteYul.Stmt},
      ExprRel concreteConfig symbolicConfig cond ->
      (∀ {concreteBodyConfig : C} {symbolicBodyConfig : S},
        ConfigRel concreteBodyConfig symbolicBodyConfig ->
        StmtRel fuel.succ embedFuel.succ concreteBodyConfig
          symbolicBodyConfig body) ->
      StmtRel fuel.succ.succ embedFuel.succ.succ concreteConfig
        symbolicConfig (ConcreteYul.Stmt.ifThen cond body)

theorem RuntimeCoveredStmt.foldRel
    {C : Type u} {S : Type v}
    {DataOffsetOK : FullYul.DataLabel -> Prop}
    {BuiltinExprOK BuiltinValuesOK :
      Evm.Builtin -> List ConcreteYul.Expr -> Prop}
    {FunctionOK : FullYul.Name -> List ConcreteYul.Expr -> Prop}
    {ExprRel : C -> S -> ConcreteYul.Expr -> Prop}
    {ExprsRel : C -> S -> List ConcreteYul.Expr -> Prop}
    {ValuesRel : C -> S -> List ConcreteYul.Expr -> Prop}
    {ConfigRel : C -> S -> Prop}
    {StmtRel : Nat -> Nat -> C -> S -> ConcreteYul.Stmt -> Prop}
    (exprAlg :
      RuntimeExprCoveredAlg DataOffsetOK BuiltinExprOK BuiltinValuesOK
        ExprRel ExprsRel)
    (valuesAlg :
      RuntimeExprsAsYulValuesCoveredAlg BuiltinExprOK BuiltinValuesOK
        ExprRel ExprsRel ValuesRel)
    (straightAlg :
      RuntimeStraightStmtCoveredAlg ExprRel ValuesRel StmtRel)
    (coveredAlg :
      RuntimeCoveredStmtAlg ConfigRel ExprRel ExprsRel StmtRel FunctionOK) :
    ∀ {stmt : ConcreteYul.Stmt},
      RuntimeCoveredStmt DataOffsetOK BuiltinExprOK BuiltinValuesOK
        FunctionOK stmt ->
      ∀ {fuel embedFuel : Nat} {concreteConfig : C} {symbolicConfig : S},
        StmtRel fuel.succ.succ embedFuel.succ.succ concreteConfig
          symbolicConfig stmt
  | _, RuntimeCoveredStmt.straight hStmt => by
      simpa using
        (RuntimeStraightStmtCovered.foldRel exprAlg valuesAlg straightAlg
          hStmt)
  | _, RuntimeCoveredStmt.letCall hArgs hOK =>
      coveredAlg.letCall (RuntimeExprsCovered.foldRel exprAlg hArgs) hOK
  | _, RuntimeCoveredStmt.assignCall hArgs hOK =>
      coveredAlg.assignCall (RuntimeExprsCovered.foldRel exprAlg hArgs) hOK
  | _, RuntimeCoveredStmt.ifStraight hCond hBody =>
      coveredAlg.ifStraight
        (RuntimeExprCovered.foldRel exprAlg hCond)
        (fun {_concreteBodyConfig} {_symbolicBodyConfig} _hConfigRel =>
          RuntimeStraightStmtCovered.foldRel exprAlg valuesAlg straightAlg
            hBody)

inductive RuntimeCoveredBlock
    (DataOffsetOK : FullYul.DataLabel -> Prop)
    (BuiltinExprOK BuiltinValuesOK :
      Evm.Builtin -> List ConcreteYul.Expr -> Prop)
    (FunctionOK : FullYul.Name -> List ConcreteYul.Expr -> Prop) :
    Nat -> List ConcreteYul.Stmt -> Prop where
  | nil :
      RuntimeCoveredBlock DataOffsetOK BuiltinExprOK BuiltinValuesOK
        FunctionOK 0 []
  | cons {stmt : ConcreteYul.Stmt} {rest : List ConcreteYul.Stmt}
      {length : Nat} :
      RuntimeCoveredStmt DataOffsetOK BuiltinExprOK BuiltinValuesOK
        FunctionOK stmt ->
      RuntimeCoveredBlock DataOffsetOK BuiltinExprOK BuiltinValuesOK
        FunctionOK length rest ->
      RuntimeCoveredBlock DataOffsetOK BuiltinExprOK BuiltinValuesOK
        FunctionOK length.succ (stmt :: rest)

structure RuntimeCoveredBlockAlg
    {C : Type u} {S : Type v}
    (ConfigRel : C -> S -> Prop)
    (StmtRel : Nat -> Nat -> C -> S -> ConcreteYul.Stmt -> Prop)
    (BlockRel : Nat -> Nat -> C -> S -> List ConcreteYul.Stmt -> Prop) :
    Prop where
  nil :
    ∀ {fuel embedFuel : Nat} {concreteConfig : C} {symbolicConfig : S},
      BlockRel fuel.succ.succ embedFuel.succ.succ concreteConfig
        symbolicConfig []
  cons :
    ∀ {fuel embedFuel : Nat} {concreteConfig : C} {symbolicConfig : S}
      {stmt : ConcreteYul.Stmt} {rest : List ConcreteYul.Stmt},
      StmtRel fuel embedFuel concreteConfig symbolicConfig stmt ->
      (∀ {concreteConfig' : C} {symbolicConfig' : S},
        ConfigRel concreteConfig' symbolicConfig' ->
        BlockRel fuel embedFuel concreteConfig' symbolicConfig' rest) ->
      BlockRel fuel.succ embedFuel.succ concreteConfig symbolicConfig
        (stmt :: rest)

theorem RuntimeCoveredBlock.foldRel
    {C : Type u} {S : Type v}
    {DataOffsetOK : FullYul.DataLabel -> Prop}
    {BuiltinExprOK BuiltinValuesOK :
      Evm.Builtin -> List ConcreteYul.Expr -> Prop}
    {FunctionOK : FullYul.Name -> List ConcreteYul.Expr -> Prop}
    {ExprRel : C -> S -> ConcreteYul.Expr -> Prop}
    {ExprsRel : C -> S -> List ConcreteYul.Expr -> Prop}
    {ValuesRel : C -> S -> List ConcreteYul.Expr -> Prop}
    {ConfigRel : C -> S -> Prop}
    {StmtRel : Nat -> Nat -> C -> S -> ConcreteYul.Stmt -> Prop}
    {BlockRel : Nat -> Nat -> C -> S -> List ConcreteYul.Stmt -> Prop}
    (exprAlg :
      RuntimeExprCoveredAlg DataOffsetOK BuiltinExprOK BuiltinValuesOK
        ExprRel ExprsRel)
    (valuesAlg :
      RuntimeExprsAsYulValuesCoveredAlg BuiltinExprOK BuiltinValuesOK
        ExprRel ExprsRel ValuesRel)
    (straightAlg :
      RuntimeStraightStmtCoveredAlg ExprRel ValuesRel StmtRel)
    (coveredStmtAlg :
      RuntimeCoveredStmtAlg ConfigRel ExprRel ExprsRel StmtRel FunctionOK)
    (coveredBlockAlg :
      RuntimeCoveredBlockAlg ConfigRel StmtRel BlockRel) :
    ∀ {length : Nat} {stmts : List ConcreteYul.Stmt},
      RuntimeCoveredBlock DataOffsetOK BuiltinExprOK BuiltinValuesOK
        FunctionOK length stmts ->
      ∀ {fuel embedFuel : Nat} {concreteConfig : C} {symbolicConfig : S},
        BlockRel (fuel + length + 2) (embedFuel + length + 2)
          concreteConfig symbolicConfig stmts
  | 0, [], RuntimeCoveredBlock.nil => by
      simpa [Nat.add_assoc] using coveredBlockAlg.nil
  | Nat.succ length, stmt :: rest, RuntimeCoveredBlock.cons hStmt hRest => by
      simpa [Nat.succ_eq_add_one, Nat.add_assoc] using
        coveredBlockAlg.cons
          (by
            simpa [Nat.succ_eq_add_one, Nat.add_assoc] using
              (RuntimeCoveredStmt.foldRel exprAlg valuesAlg straightAlg
                coveredStmtAlg hStmt))
          (fun {_concreteConfig'} {_symbolicConfig'} _hConfigRel =>
            RuntimeCoveredBlock.foldRel exprAlg valuesAlg straightAlg
              coveredStmtAlg coveredBlockAlg hRest)

structure RuntimeCoveredBlockLeafAlg
    {C : Type u} {S : Type v}
    (ConfigRel : C -> S -> Prop)
    (StmtRel : Nat -> C -> S -> ConcreteYul.Stmt -> Prop)
    (BlockRel : Nat -> C -> S -> List ConcreteYul.Stmt -> Prop) :
    Prop where
  nil :
    ∀ {fuel : Nat} {concreteConfig : C} {symbolicConfig : S},
      BlockRel fuel concreteConfig symbolicConfig []
  cons :
    ∀ {fuel : Nat} {concreteConfig : C} {symbolicConfig : S}
      {stmt : ConcreteYul.Stmt} {rest : List ConcreteYul.Stmt},
      StmtRel fuel concreteConfig symbolicConfig stmt ->
      (∀ {concreteConfig' : C} {symbolicConfig' : S},
        ConfigRel concreteConfig' symbolicConfig' ->
        BlockRel fuel concreteConfig' symbolicConfig' rest) ->
      BlockRel fuel.succ concreteConfig symbolicConfig (stmt :: rest)

theorem RuntimeCoveredBlock.foldLeafRel
    {C : Type u} {S : Type v}
    {DataOffsetOK : FullYul.DataLabel -> Prop}
    {BuiltinExprOK BuiltinValuesOK :
      Evm.Builtin -> List ConcreteYul.Expr -> Prop}
    {FunctionOK : FullYul.Name -> List ConcreteYul.Expr -> Prop}
    {ConfigRel : C -> S -> Prop}
    {StmtRel : Nat -> C -> S -> ConcreteYul.Stmt -> Prop}
    {BlockRel : Nat -> C -> S -> List ConcreteYul.Stmt -> Prop}
    (stmtRel :
      ∀ {stmt : ConcreteYul.Stmt},
        RuntimeCoveredStmt DataOffsetOK BuiltinExprOK BuiltinValuesOK
          FunctionOK stmt ->
        ∀ {fuel : Nat} {concreteConfig : C} {symbolicConfig : S},
          StmtRel fuel concreteConfig symbolicConfig stmt)
    (blockAlg :
      RuntimeCoveredBlockLeafAlg ConfigRel StmtRel BlockRel) :
    ∀ {length : Nat} {stmts : List ConcreteYul.Stmt},
      RuntimeCoveredBlock DataOffsetOK BuiltinExprOK BuiltinValuesOK
        FunctionOK length stmts ->
      ∀ {fuel : Nat} {concreteConfig : C} {symbolicConfig : S},
        BlockRel (fuel + length + 2) concreteConfig symbolicConfig stmts
  | 0, [], RuntimeCoveredBlock.nil => by
      simpa [Nat.add_assoc] using blockAlg.nil
  | Nat.succ length, stmt :: rest, RuntimeCoveredBlock.cons hStmt hRest => by
      simpa [Nat.succ_eq_add_one, Nat.add_assoc] using
        blockAlg.cons
          (by
            simpa [Nat.succ_eq_add_one, Nat.add_assoc] using
              stmtRel hStmt)
          (fun {_concreteConfig'} {_symbolicConfig'} _hConfigRel =>
            RuntimeCoveredBlock.foldLeafRel stmtRel blockAlg hRest)

abbrev RuntimeExprCoveredSpec (spec : RuntimeCoverageSpec) :
    ConcreteYul.Expr -> Prop :=
  RuntimeExprCovered spec.DataOffsetOK spec.BuiltinExprOK
    spec.BuiltinValuesOK

abbrev RuntimeExprsCoveredSpec (spec : RuntimeCoverageSpec) :
    List ConcreteYul.Expr -> Prop :=
  RuntimeExprsCovered spec.DataOffsetOK spec.BuiltinExprOK
    spec.BuiltinValuesOK

abbrev RuntimeExprsAsYulValuesCoveredSpec
    (spec : RuntimeCoverageSpec) : List ConcreteYul.Expr -> Prop :=
  RuntimeExprsAsYulValuesCovered spec.DataOffsetOK spec.BuiltinExprOK
    spec.BuiltinValuesOK

abbrev RuntimeStraightStmtCoveredSpec (spec : RuntimeCoverageSpec) :
    ConcreteYul.Stmt -> Prop :=
  RuntimeStraightStmtCovered spec.DataOffsetOK spec.BuiltinExprOK
    spec.BuiltinValuesOK

abbrev RuntimeCoveredStmtSpec (spec : RuntimeCoverageSpec) :
    ConcreteYul.Stmt -> Prop :=
  RuntimeCoveredStmt spec.DataOffsetOK spec.BuiltinExprOK
    spec.BuiltinValuesOK spec.FunctionOK

abbrev RuntimeCoveredBlockSpec (spec : RuntimeCoverageSpec) :
    Nat -> List ConcreteYul.Stmt -> Prop :=
