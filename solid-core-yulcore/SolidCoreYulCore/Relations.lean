def CompilerAcceptedProgramAt
    (profile : FullYul.CompilerProfile)
    (entryCtx : FullYul.StaticContext)
    (program : ConcreteYul.Program) : Prop :=
  ∃ fuel ctx',
    FullYul.CompilerAcceptedStmt profile fuel entryCtx false false
      (embedConcreteStmt program.body) ctx'

theorem CompilerAcceptedProgramAt.not_break
    (profile : FullYul.CompilerProfile)
    (entryCtx : FullYul.StaticContext) :
    ¬ CompilerAcceptedProgramAt profile entryCtx
      { body := ConcreteYul.Stmt.break } := by
  rintro ⟨fuel, _ctx', hAccepted⟩
  have hCheck := hAccepted.checked
  cases fuel <;>
    simp [embedConcreteStmt, embedConcreteStmtFuel, FullYul.checkStmtFuel]
      at hCheck

