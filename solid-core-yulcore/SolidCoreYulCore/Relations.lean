structure RuntimeStructuralBodyStepInnerFuel
    (fuel dispatcherMax providerMax : Nat) : Prop where
  dispatch : fuel.pred ≤ dispatcherMax
  provider : fuel.pred ≤ providerMax
  nested : fuel.pred.pred ≤ providerMax

theorem runtimeStructuralBodyStepInnerFuel_of_succ
    {fuel dispatcherMax providerMax : Nat}
    (hDispatch : fuel.succ.pred ≤ dispatcherMax)
    (hProvider : fuel.succ.pred.pred ≤ providerMax) :
    RuntimeStructuralBodyStepInnerFuel fuel dispatcherMax providerMax := by
  have hDispatch' : fuel ≤ dispatcherMax := by
    simpa using hDispatch
  have hProvider' : fuel.pred ≤ providerMax := by
    simpa using hProvider
  exact
    { dispatch := Nat.le_trans (Nat.pred_le fuel) hDispatch'
      provider := hProvider'
      nested := Nat.le_trans (Nat.pred_le fuel.pred) hProvider' }

theorem runtimeFunctionBodyStepInnerFuel_of_succ
    {fuel maxFunctionFuel : Nat}
    (hFunctionFuel : fuel.succ.pred ≤ maxFunctionFuel) :
    fuel.pred ≤ maxFunctionFuel := by
  have hFuel : fuel ≤ maxFunctionFuel := by
    simpa using hFunctionFuel
  exact Nat.le_trans (Nat.pred_le fuel) hFuel

theorem runtimeStructuralBodyStepSeqEmbedFuel_of_succ
    {firstEmbedFuel secondEmbedFuel innerEmbedFuel : Nat}
    (hEmbedFuel :
      Nat.max firstEmbedFuel secondEmbedFuel + 1 ≤ innerEmbedFuel.succ) :
    firstEmbedFuel ≤ innerEmbedFuel ∧ secondEmbedFuel ≤ innerEmbedFuel := by
  have hInner :
      Nat.max firstEmbedFuel secondEmbedFuel ≤ innerEmbedFuel :=
    Nat.succ_le_succ_iff.mp
      (by
        simpa [Nat.succ_eq_add_one] using hEmbedFuel)
  exact
    ⟨ Nat.le_trans (Nat.le_max_left _ _) hInner
    , Nat.le_trans (Nat.le_max_right _ _) hInner ⟩

theorem runtimeStructuralBodyStepIfEmbedFuel_of_succ
    {minBodyEmbedFuel bodyEmbedFuel : Nat}
    (hEmbedFuel : minBodyEmbedFuel + 1 ≤ bodyEmbedFuel.succ) :
    minBodyEmbedFuel ≤ bodyEmbedFuel :=
  Nat.succ_le_succ_iff.mp
    (by
      simpa [Nat.succ_eq_add_one] using hEmbedFuel)

theorem runtimeStructuralBodyStepForEmbedFuel_of_succ
    {preEmbedFuel postEmbedFuel bodyEmbedFuel innerEmbedFuel : Nat}
    (hEmbedFuel :
      Nat.max preEmbedFuel (Nat.max postEmbedFuel bodyEmbedFuel) + 1 ≤
        innerEmbedFuel.succ) :
    preEmbedFuel ≤ innerEmbedFuel ∧
      postEmbedFuel ≤ innerEmbedFuel ∧
      bodyEmbedFuel ≤ innerEmbedFuel := by
  have hInner :
      Nat.max preEmbedFuel (Nat.max postEmbedFuel bodyEmbedFuel) ≤
        innerEmbedFuel :=
    Nat.succ_le_succ_iff.mp
      (by
        simpa [Nat.succ_eq_add_one] using hEmbedFuel)
  exact
    ⟨ Nat.le_trans (Nat.le_max_left _ _) hInner
    , ⟨ Nat.le_trans
          (Nat.le_trans (Nat.le_max_left _ _) (Nat.le_max_right _ _))
          hInner
      , Nat.le_trans
          (Nat.le_trans (Nat.le_max_right _ _) (Nat.le_max_right _ _))
          hInner ⟩ ⟩

