theorem runtimeExprsExactSim_cons_of_rest_expr
    {hash : ConcreteYul.HashOracle} {config : ConcreteYul.RuntimeConfig}
    {expr : ConcreteYul.Expr} {rest : List ConcreteYul.Expr}
    (hRest : RuntimeExprsExactSim hash config rest)
    (hExpr :
      ∀ {restConfig : ConcreteYul.RuntimeConfig},
        RuntimeExprExactSim hash restConfig expr) :
    RuntimeExprsExactSim hash config (expr :: rest) := by
  intro concreteValues concreteConfig hConcrete
  cases hRestEval : ConcreteYul.evalRuntimeExprs hash rest config with
  | none =>
      simp [ConcreteYul.evalRuntimeExprs, hRestEval] at hConcrete
  | some restResult =>
      cases restResult with
      | mk restValues restConfig =>
          cases hExprEval :
              ConcreteYul.evalRuntimeExpr hash expr restConfig with
          | none =>
              simp [ConcreteYul.evalRuntimeExprs, hRestEval, hExprEval]
                at hConcrete
          | some exprResult =>
              cases exprResult with
              | mk value exprConfig =>
                  simp [ConcreteYul.evalRuntimeExprs, hRestEval, hExprEval]
                    at hConcrete
                  rcases hConcrete with ⟨hValues, hConfig⟩
                  subst concreteValues
                  subst concreteConfig
                  have hGuidedRest :=
                    hRest restValues restConfig hRestEval
                  have hGuidedExpr :=
                    (hExpr (restConfig := restConfig)) value exprConfig
                      hExprEval
                  simp [SymYul.guidedEvalExprs, embedConcreteExprs,
                    hGuidedRest, hGuidedExpr]

