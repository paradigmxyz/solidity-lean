theorem runtimeExprExactRelSim_builtin_word_args_no_state
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    (concreteConfig : ConcreteYul.RuntimeConfig)
    (symbolicConfig : SymYul.GuidedConfig)
    (builtin : Evm.Builtin) (args : List Word)
    (concreteValue : Word) (symbolicValue : FullYul.Value)
    (hConcreteExpr :
      ConcreteYul.evalRuntimeExpr hash
          (ConcreteYul.Expr.builtin builtin
            (args.map ConcreteYul.Expr.word)) concreteConfig =
        some (concreteValue, concreteConfig))
    (hGuidedBuiltin :
      FullYul.evalEvmBuiltin builtin (args.map embedWordValue)
          symbolicConfig.evm =
        some (symbolicValue, symbolicConfig.evm))
    (hValue : ValueRel model concreteValue symbolicValue) :
    RuntimeExprExactRelSim model hash concreteConfig symbolicConfig
      (ConcreteYul.Expr.builtin builtin
        (args.map ConcreteYul.Expr.word)) := by
  intro hExact concreteValue' concreteConfig' hConcrete
  rw [hConcreteExpr] at hConcrete
  cases hConcrete
  have hGuidedArgs :
      SymYul.guidedEvalExprs symbolicConfig
          (embedConcreteExprs (args.map ConcreteYul.Expr.word)) =
        some (args.map embedWordValue, symbolicConfig) := by
    rw [embedConcreteExprs_word_args]
    exact guidedEvalExprs_word_args symbolicConfig args
  exact
    ⟨ symbolicValue
    , symbolicConfig
    , by
        simp [SymYul.guidedEvalExpr, embedConcreteExpr, hGuidedArgs,
          hGuidedBuiltin]
    , hValue
    , hExact ⟩

theorem runtimeExprExactRelSim_builtin_of_runtimeExprsExactRel
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    {concreteConfig : ConcreteYul.RuntimeConfig}
    {symbolicConfig : SymYul.GuidedConfig}
    {builtin : Evm.Builtin} {args : List ConcreteYul.Expr}
    {concreteArgs : List Word}
    {concreteArgConfig concreteAfterConfig : ConcreteYul.RuntimeConfig}
    {concreteValue : Word}
    (hArgs :
      RuntimeExprsExactRelSim model hash concreteConfig symbolicConfig args)
    (hConcreteArgs :
      ConcreteYul.evalRuntimeExprs hash args concreteConfig =
        some (concreteArgs, concreteArgConfig))
    (hConcreteExpected :
      ConcreteYul.evalRuntimeExpr hash
          (ConcreteYul.Expr.builtin builtin args) concreteConfig =
        some (concreteValue, concreteAfterConfig))
    (hBuiltin :
      ∀ symbolicArgs symbolicArgConfig,
        SymYul.guidedEvalExprs symbolicConfig (embedConcreteExprs args) =
          some (symbolicArgs, symbolicArgConfig) ->
        WordListRel model concreteArgs symbolicArgs ->
        RuntimeConfigExactRel model concreteArgConfig symbolicArgConfig ->
        ∃ symbolicValue symbolicEvm',
          FullYul.evalEvmBuiltin builtin symbolicArgs
              symbolicArgConfig.evm =
            some (symbolicValue, symbolicEvm') ∧
          ValueRel model concreteValue symbolicValue ∧
          RuntimeConfigExactRel model
            concreteAfterConfig
            { symbolicArgConfig with evm := symbolicEvm' }) :
    RuntimeExprExactRelSim model hash concreteConfig symbolicConfig
      (ConcreteYul.Expr.builtin builtin args) := by
  intro hInputExact concreteValue' concreteConfig' hConcrete
  rw [hConcreteExpected] at hConcrete
  cases hConcrete
  rcases hArgs hInputExact concreteArgs concreteArgConfig hConcreteArgs with
    ⟨symbolicArgs, symbolicArgConfig, hGuidedArgs, hArgsRel,
      hArgConfigExact⟩
  rcases hBuiltin symbolicArgs symbolicArgConfig hGuidedArgs hArgsRel
      hArgConfigExact with
    ⟨symbolicValue, symbolicEvm', hGuidedBuiltin, hValueRel,
      hConfigExact⟩
  exact
    ⟨ symbolicValue
    , { symbolicArgConfig with evm := symbolicEvm' }
    , by
        simp [SymYul.guidedEvalExpr, embedConcreteExpr, hGuidedArgs,
          hGuidedBuiltin]
    , hValueRel
    , hConfigExact ⟩

theorem runtimeExprExactRelSim_builtin_of_runtimeExprsExactRel_of_concreteArgs
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    {concreteConfig : ConcreteYul.RuntimeConfig}
    {symbolicConfig : SymYul.GuidedConfig}
    {builtin : Evm.Builtin} {args : List ConcreteYul.Expr}
    (hArgs :
      RuntimeExprsExactRelSim model hash concreteConfig symbolicConfig args)
    (hConcreteArgsOfExpected :
      ∀ {concreteValue : Word}
        {concreteAfterConfig : ConcreteYul.RuntimeConfig},
        ConcreteYul.evalRuntimeExpr hash
            (ConcreteYul.Expr.builtin builtin args) concreteConfig =
          some (concreteValue, concreteAfterConfig) ->
        ∃ concreteArgs concreteArgConfig,
          ConcreteYul.evalRuntimeExprs hash args concreteConfig =
            some (concreteArgs, concreteArgConfig) ∧
          (∀ symbolicArgs symbolicArgConfig,
            SymYul.guidedEvalExprs symbolicConfig
                (embedConcreteExprs args) =
              some (symbolicArgs, symbolicArgConfig) ->
            WordListRel model concreteArgs symbolicArgs ->
            RuntimeConfigExactRel model concreteArgConfig symbolicArgConfig ->
            ∃ symbolicValue symbolicEvm',
              FullYul.evalEvmBuiltin builtin symbolicArgs
                  symbolicArgConfig.evm =
                some (symbolicValue, symbolicEvm') ∧
              ValueRel model concreteValue symbolicValue ∧
              RuntimeConfigExactRel model concreteAfterConfig
                { symbolicArgConfig with evm := symbolicEvm' })) :
    RuntimeExprExactRelSim model hash concreteConfig symbolicConfig
      (ConcreteYul.Expr.builtin builtin args) := by
  intro hInputExact concreteValue concreteAfterConfig hConcreteExpected
  rcases hConcreteArgsOfExpected hConcreteExpected with
    ⟨concreteArgs, concreteArgConfig, hConcreteArgs, hBuiltin⟩
  exact
    (runtimeExprExactRelSim_builtin_of_runtimeExprsExactRel model hash
      (concreteConfig := concreteConfig)
      (symbolicConfig := symbolicConfig)
      (builtin := builtin)
      (args := args)
      (concreteArgs := concreteArgs)
      (concreteArgConfig := concreteArgConfig)
      (concreteAfterConfig := concreteAfterConfig)
      (concreteValue := concreteValue)
      hArgs hConcreteArgs hConcreteExpected hBuiltin)
      hInputExact concreteValue concreteAfterConfig hConcreteExpected

