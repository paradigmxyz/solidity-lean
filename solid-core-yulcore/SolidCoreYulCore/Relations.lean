inductive RuntimeMemoryWriteBuiltinValueArgKinds :
    Evm.Builtin -> List ConcreteYul.Expr -> List RuntimeArgKind -> Prop where
  | mstore {offset value : ConcreteYul.Expr} :
      RuntimeMemoryWriteBuiltinValueArgKinds Evm.Builtin.mstore
        [offset, value] [RuntimeArgKind.word, RuntimeArgKind.value]
  | mstore8 {offset value : ConcreteYul.Expr} :
      RuntimeMemoryWriteBuiltinValueArgKinds Evm.Builtin.mstore8
        [offset, value] [RuntimeArgKind.word, RuntimeArgKind.value]

inductive RuntimeMemoryBuiltinValueArgKinds :
    Evm.Builtin -> List ConcreteYul.Expr -> List RuntimeArgKind -> Prop where
  | mload {offset : ConcreteYul.Expr} :
      RuntimeMemoryBuiltinValueArgKinds Evm.Builtin.mload
        [offset] [RuntimeArgKind.word]
  | write {builtin : Evm.Builtin} {args : List ConcreteYul.Expr}
      {kinds : List RuntimeArgKind} :
      RuntimeMemoryWriteBuiltinValueArgKinds builtin args kinds ->
        RuntimeMemoryBuiltinValueArgKinds builtin args kinds

theorem RuntimeMemoryBuiltinValueArgKinds.of_profileMemory
    {builtin : Evm.Builtin} {args : List ConcreteYul.Expr}
    (hBuiltin : FullYul.CompilerProfile.MemoryBuiltin builtin)
    (hSig : ∃ sig, builtin.signature? = some sig ∧
      sig.paramCount = args.length) :
    ∃ kinds,
      RuntimeMemoryBuiltinValueArgKinds builtin args kinds := by
  cases hBuiltin with
  | mload =>
      rcases hSig with ⟨sig, hSig, hLen⟩
      simp [Evm.Builtin.signature?] at hSig
      cases hSig
      cases args with
      | nil =>
          simp at hLen
      | cons offset rest =>
          cases rest with
          | nil =>
              exact
                ⟨ [RuntimeArgKind.word]
                , RuntimeMemoryBuiltinValueArgKinds.mload ⟩
          | cons _ _ =>
              simp at hLen
  | mstore =>
      rcases hSig with ⟨sig, hSig, hLen⟩
      simp [Evm.Builtin.signature?] at hSig
      cases hSig
      cases args with
      | nil =>
          simp at hLen
      | cons offset rest =>
          cases rest with
          | nil =>
              simp at hLen
          | cons value restTail =>
              cases restTail with
              | nil =>
                  exact
                    ⟨ [RuntimeArgKind.word, RuntimeArgKind.value]
                    , RuntimeMemoryBuiltinValueArgKinds.write
                        RuntimeMemoryWriteBuiltinValueArgKinds.mstore ⟩
              | cons _ _ =>
                  simp at hLen
  | mstore8 =>
      rcases hSig with ⟨sig, hSig, hLen⟩
      simp [Evm.Builtin.signature?] at hSig
      cases hSig
      cases args with
      | nil =>
          simp at hLen
      | cons offset rest =>
          cases rest with
          | nil =>
              simp at hLen
          | cons value restTail =>
              cases restTail with
              | nil =>
                  exact
                    ⟨ [RuntimeArgKind.word, RuntimeArgKind.value]
                    , RuntimeMemoryBuiltinValueArgKinds.write
                        RuntimeMemoryWriteBuiltinValueArgKinds.mstore8 ⟩
              | cons _ _ =>
                  simp at hLen

