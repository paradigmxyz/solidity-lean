            dsimp [embedConcreteNamedFunctionDef, fn]
            exact
              embedConcreteStmtFuel_eq_of_size_lt body
                (Nat.lt_of_lt_of_le hBodyLtCanonical hCanonicalLe)
                hBodyLtCanonical
