                    hRaw.2)
                  (hSyntax.builtinValues hSig hRaw.1.1)
  | expr₁ :: expr₂ :: rest, _resultCount, hCheck =>
      by
        have hTop :
            FullYul.checkExprs ctx
              (embedConcreteExprs (expr₁ :: expr₂ :: rest)) = true ∧
