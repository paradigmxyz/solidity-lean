inductive RuntimeNamedStructuralFunctionBodyCoveredSpec
    (spec : RuntimeCoverageSpec)
    (fnName : FullYul.Name)
    (fn : ConcreteYul.FunctionDef) : Prop where
  | intro (minEmbedFuel : Nat) :
      RuntimeStructuralBodyCoveredSpec spec minEmbedFuel fn.body ->
      minEmbedFuel ≤
        sizeOf
          (ConcreteYul.Stmt.funDef fnName fn.params fn.returns fn.body) ->
      RuntimeNamedStructuralFunctionBodyCoveredSpec spec fnName fn

