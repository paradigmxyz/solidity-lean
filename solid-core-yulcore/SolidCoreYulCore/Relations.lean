                simp [hRest] at hAssign
            | some rest' =>
                simp [hRest] at hAssign
                cases hAssign
                by_cases hOther : candidate = other
                · subst candidate
                  simp [FullYul.lookup?]
                · simp [FullYul.lookup?, hOther, ih hRest]

theorem envRel_declare?
    {model : SymYul.ConcreteModel}
    {concrete concrete' : ConcreteYul.Env}
    {symbolic symbolic' : FullYul.Env}
    {name : FullYul.Name} {concreteValue : Word}
    {symbolicValue : FullYul.Value}
    (hRel : EnvRel model concrete symbolic)
    (hConcrete :
      ConcreteYul.declare? concrete name concreteValue = some concrete')
    (hSymbolic :
      FullYul.declare? symbolic name symbolicValue = some symbolic')
    (hValue : ValueRel model concreteValue symbolicValue) :
    EnvRel model concrete' symbolic' := by
  cases hConcreteLookup : ConcreteYul.lookup? concrete name with
  | some current =>
      simp [ConcreteYul.declare?, hConcreteLookup] at hConcrete
  | none =>
      cases hSymbolicLookup : FullYul.lookup? symbolic name with
      | some symbolicCurrent =>
          simp [FullYul.declare?, hSymbolicLookup] at hSymbolic
      | none =>
          simp [ConcreteYul.declare?, hConcreteLookup] at hConcrete
          simp [FullYul.declare?, hSymbolicLookup] at hSymbolic
          cases hConcrete
          cases hSymbolic
          intro query value hLookup
          by_cases hName : query = name
          · subst query
            simp [ConcreteYul.lookup?] at hLookup
            cases hLookup
            refine ⟨symbolicValue, ?_, ?_⟩
            · simp [FullYul.lookup?]
            · exact valueRel_norm_left hValue
          · have hName' : name ≠ query := by
              intro hEq
              exact hName hEq.symm
            simp [ConcreteYul.lookup?, hName'] at hLookup
            rcases hRel query value hLookup with ⟨value', hLookup', hValue'⟩
            refine ⟨value', ?_, hValue'⟩
            simp [FullYul.lookup?, hName', hLookup']

theorem envRel_assign?
    {model : SymYul.ConcreteModel}
    {concrete concrete' : ConcreteYul.Env}
    {symbolic symbolic' : FullYul.Env}
    {name : FullYul.Name} {concreteValue : Word}
    {symbolicValue : FullYul.Value}
    (hRel : EnvRel model concrete symbolic)
    (hConcrete :
      ConcreteYul.assign? concrete name concreteValue = some concrete')
    (hSymbolic :
      FullYul.assign? symbolic name symbolicValue = some symbolic')
    (hValue : ValueRel model concreteValue symbolicValue) :
    EnvRel model concrete' symbolic' := by
  intro query value hLookup
  by_cases hName : query = name
  · subst query
    have hConcreteLookup :=
      concrete_lookup?_assign_same hConcrete
    rw [hConcreteLookup] at hLookup
    cases hLookup
    refine ⟨symbolicValue, ?_, ?_⟩
    · exact full_lookup?_assign_same hSymbolic
    · exact valueRel_norm_left hValue
  · have hConcreteOther :=
      concrete_lookup?_assign_other hName hConcrete
    rw [hConcreteOther] at hLookup
    rcases hRel query value hLookup with ⟨value', hLookup', hValue'⟩
    refine ⟨value', ?_, hValue'⟩
    rw [full_lookup?_assign_other hName hSymbolic]
    exact hLookup'

theorem envExactRel_declare?
    {model : SymYul.ConcreteModel}
    {concrete concrete' : ConcreteYul.Env}
    {symbolic symbolic' : FullYul.Env}
    {name : FullYul.Name} {concreteValue : Word}
    {symbolicValue : FullYul.Value}
    (hExact : EnvExactRel model concrete symbolic)
    (hConcrete :
      ConcreteYul.declare? concrete name concreteValue = some concrete')
    (hSymbolic :
      FullYul.declare? symbolic name symbolicValue = some symbolic')
    (hValue : ValueRel model concreteValue symbolicValue) :
    EnvExactRel model concrete' symbolic' := by
  cases hConcreteLookup : ConcreteYul.lookup? concrete name with
  | some current =>
      simp [ConcreteYul.declare?, hConcreteLookup] at hConcrete
  | none =>
      cases hSymbolicLookup : FullYul.lookup? symbolic name with
      | some symbolicCurrent =>
          simp [FullYul.declare?, hSymbolicLookup] at hSymbolic
      | none =>
          simp [ConcreteYul.declare?, hConcreteLookup] at hConcrete
          simp [FullYul.declare?, hSymbolicLookup] at hSymbolic
          cases hConcrete
          cases hSymbolic
          constructor
          · constructor
            · rfl
            · exact valueRel_norm_left hValue
          · exact hExact

theorem envExactRel_assign?
    {model : SymYul.ConcreteModel}
    {concrete concrete' : ConcreteYul.Env}
    {symbolic symbolic' : FullYul.Env}
    {name : FullYul.Name} {concreteValue : Word}
    {symbolicValue : FullYul.Value}
    (hExact : EnvExactRel model concrete symbolic)
    (hConcrete :
      ConcreteYul.assign? concrete name concreteValue = some concrete')
    (hSymbolic :
      FullYul.assign? symbolic name symbolicValue = some symbolic')
    (hValue : ValueRel model concreteValue symbolicValue) :
    EnvExactRel model concrete' symbolic' := by
  induction concrete generalizing symbolic concrete' symbolic' with
  | nil =>
      simp [ConcreteYul.assign?] at hConcrete
  | cons concreteEntry concreteRest ih =>
      cases symbolic with
      | nil =>
          simp [EnvExactRel] at hExact
      | cons symbolicEntry symbolicRest =>
          rcases hExact with ⟨hHead, hTail⟩
          cases concreteEntry with
          | mk concreteName concreteCurrent =>
              cases symbolicEntry with
              | mk symbolicName symbolicCurrent =>
                  rcases hHead with ⟨hName, hCurrentRel⟩
                  simp at hName hCurrentRel
                  by_cases hConcreteName : concreteName = name
                  · have hSymbolicName : symbolicName = name := by
                      rw [← hName, hConcreteName]
                    simp [ConcreteYul.assign?, hConcreteName] at hConcrete
                    simp [FullYul.assign?, hSymbolicName] at hSymbolic
                    cases hConcrete
                    cases hSymbolic
                    constructor
                    · constructor
                      · rfl
                      · exact valueRel_norm_left hValue
                    · exact hTail
                  · have hSymbolicName : symbolicName ≠ name := by
                      intro hEq
                      apply hConcreteName
                      rw [hName, hEq]
                    simp [ConcreteYul.assign?, hConcreteName] at hConcrete
                    cases hConcreteRest :
                        ConcreteYul.assign? concreteRest name
                          concreteValue with
                    | none =>
                        simp [hConcreteRest] at hConcrete
                    | some concreteRest' =>
                        simp [hConcreteRest] at hConcrete
                        simp [FullYul.assign?, hSymbolicName] at hSymbolic
                        cases hSymbolicRest :
                            FullYul.assign? symbolicRest name
                              symbolicValue with
                        | none =>
                            simp [hSymbolicRest] at hSymbolic
                        | some symbolicRest' =>
                            simp [hSymbolicRest] at hSymbolic
                            cases hConcrete
                            cases hSymbolic
                            constructor
                            · constructor
                              · exact hName
                              · exact hCurrentRel
                            · exact ih hTail hConcreteRest hSymbolicRest

theorem envExactRel_declare?_of_concrete
    {model : SymYul.ConcreteModel}
    {concrete concrete' : ConcreteYul.Env}
    {symbolic : FullYul.Env}
    {name : FullYul.Name} {concreteValue : Word}
    {symbolicValue : FullYul.Value}
    (hExact : EnvExactRel model concrete symbolic)
    (hConcrete :
      ConcreteYul.declare? concrete name concreteValue = some concrete')
    (hValue : ValueRel model concreteValue symbolicValue) :
    ∃ symbolic',
      FullYul.declare? symbolic name symbolicValue = some symbolic' ∧
        EnvExactRel model concrete' symbolic' := by
  cases hConcreteLookup : ConcreteYul.lookup? concrete name with
  | some current =>
      simp [ConcreteYul.declare?, hConcreteLookup] at hConcrete
  | none =>
      have hSymbolicLookup :
          FullYul.lookup? symbolic name = none :=
        envExactRel_lookup?_none hExact hConcreteLookup
      have hSymbolic :
          FullYul.declare? symbolic name symbolicValue =
            some ((name, symbolicValue) :: symbolic) := by
        simp [FullYul.declare?, hSymbolicLookup]
      simp [ConcreteYul.declare?, hConcreteLookup] at hConcrete
      cases hConcrete
      exact
        ⟨ (name, symbolicValue) :: symbolic
        , hSymbolic
        , envExactRel_declare? hExact
            (by simp [ConcreteYul.declare?, hConcreteLookup])
            hSymbolic hValue ⟩

theorem envExactRel_assign?_of_concrete
    {model : SymYul.ConcreteModel}
    {concrete concrete' : ConcreteYul.Env}
    {symbolic : FullYul.Env}
    {name : FullYul.Name} {concreteValue : Word}
    {symbolicValue : FullYul.Value}
    (hExact : EnvExactRel model concrete symbolic)
    (hConcrete :
      ConcreteYul.assign? concrete name concreteValue = some concrete')
    (hValue : ValueRel model concreteValue symbolicValue) :
    ∃ symbolic',
      FullYul.assign? symbolic name symbolicValue = some symbolic' ∧
        EnvExactRel model concrete' symbolic' := by
  induction concrete generalizing symbolic concrete' with
  | nil =>
      simp [ConcreteYul.assign?] at hConcrete
  | cons concreteEntry concreteRest ih =>
      cases symbolic with
      | nil =>
          simp [EnvExactRel] at hExact
      | cons symbolicEntry symbolicRest =>
          rcases hExact with ⟨hHead, hTail⟩
          cases concreteEntry with
          | mk concreteName concreteCurrent =>
              cases symbolicEntry with
              | mk symbolicName symbolicCurrent =>
                  rcases hHead with ⟨hName, hCurrentRel⟩
                  simp at hName hCurrentRel
                  by_cases hConcreteName : concreteName = name
                  · have hSymbolicName : symbolicName = name := by
                      rw [← hName, hConcreteName]
                    simp [ConcreteYul.assign?, hConcreteName] at hConcrete
                    cases hConcrete
                    let symbolic' : FullYul.Env :=
                      (symbolicName, symbolicValue) :: symbolicRest
                    have hSymbolic :
                        FullYul.assign?
                            ((symbolicName, symbolicCurrent) ::
                              symbolicRest)
                            name symbolicValue =
                          some symbolic' := by
                      simp [FullYul.assign?, hSymbolicName, symbolic']
                    exact
                      ⟨ symbolic'
                      , hSymbolic
                      , by
                          constructor
                          · constructor
                            · exact hSymbolicName.symm
                            · exact valueRel_norm_left hValue
                          · exact hTail ⟩
                  · have hSymbolicName : symbolicName ≠ name := by
                      intro hEq
                      apply hConcreteName
                      rw [hName, hEq]
                    simp [ConcreteYul.assign?, hConcreteName] at hConcrete
                    cases hConcreteRest :
                        ConcreteYul.assign? concreteRest name
                          concreteValue with
                    | none =>
                        simp [hConcreteRest] at hConcrete
                    | some concreteRest' =>
                        simp [hConcreteRest] at hConcrete
                        cases hConcrete
                        rcases ih hTail hConcreteRest with
                          ⟨symbolicRest', hSymbolicRest, hRestExact⟩
                        let symbolic' : FullYul.Env :=
                          (symbolicName, symbolicCurrent) :: symbolicRest'
                        have hSymbolic :
                            FullYul.assign?
                                ((symbolicName, symbolicCurrent) ::
                                  symbolicRest)
                                name symbolicValue =
                              some symbolic' := by
                          simp [FullYul.assign?, hSymbolicName,
                            hSymbolicRest, symbolic']
                        exact
                          ⟨ symbolic'
                          , hSymbolic
                          , by
                              constructor
                              · constructor
                                · exact hName
                                · exact hCurrentRel
                              · exact hRestExact ⟩

theorem envRel_declareMany?
    {model : SymYul.ConcreteModel}
    {concrete concrete' : ConcreteYul.Env}
    {symbolic symbolic' : FullYul.Env}
    {names : List FullYul.Name} {concreteValues : List Word}
    {symbolicValues : List FullYul.Value}
    (hRel : EnvRel model concrete symbolic)
    (hConcrete :
      ConcreteYul.declareMany? concrete names concreteValues = some concrete')
    (hSymbolic :
      FullYul.declareMany? symbolic names symbolicValues = some symbolic')
    (hValues : WordListRel model concreteValues symbolicValues) :
    EnvRel model concrete' symbolic' := by
  induction names generalizing concrete concrete' symbolic symbolic'
      concreteValues symbolicValues with
  | nil =>
      cases concreteValues <;> cases symbolicValues <;>
        simp [ConcreteYul.declareMany?, FullYul.declareMany?] at hConcrete hSymbolic hValues
      cases hConcrete
      cases hSymbolic
      exact hRel
  | cons name rest ih =>
      cases concreteValues with
      | nil =>
          simp [ConcreteYul.declareMany?] at hConcrete
      | cons concreteValue concreteRest =>
          cases symbolicValues with
          | nil =>
              cases hValues
          | cons symbolicValue symbolicRest =>
              rcases hValues with ⟨hValue, hRestValues⟩
              cases hConcreteDecl :
                  ConcreteYul.declare? concrete name concreteValue with
              | none =>
                  simp [ConcreteYul.declareMany?, hConcreteDecl] at hConcrete
              | some concreteNext =>
                  cases hSymbolicDecl :
                      FullYul.declare? symbolic name symbolicValue with
                  | none =>
                      simp [FullYul.declareMany?, hSymbolicDecl] at hSymbolic
                  | some symbolicNext =>
                      have hStep :
                          EnvRel model concreteNext symbolicNext :=
                        envRel_declare? hRel hConcreteDecl hSymbolicDecl
                          hValue
                      exact ih hStep
                        (by simpa [ConcreteYul.declareMany?, hConcreteDecl] using
                          hConcrete)
                        (by simpa [FullYul.declareMany?, hSymbolicDecl] using
                          hSymbolic)
                        hRestValues

