theorem evalRuntimeExpr_sload_present_refines_guided
    (hash : ConcreteYul.HashOracle)
    {config : ConcreteYul.RuntimeConfig} {key value : Word}
    (hLookup :
      ConcreteYul.lookupAccountWordMap? config.state.storage
        config.state.address key = some value) :
    ConcreteYul.evalRuntimeExpr hash
        (ConcreteYul.Expr.builtin Evm.Builtin.sload
          [ConcreteYul.Expr.word key]) config =
      some (norm value, config) ∧
    SymYul.guidedEvalExpr (embedRuntimeConfig config)
        (embedConcreteExpr
          (ConcreteYul.Expr.builtin Evm.Builtin.sload
            [ConcreteYul.Expr.word key])) =
      some (embedWordValue value, embedRuntimeConfig config) := by
  have hFull :
      FullYul.lookupAccountValueMap?
          (embedConcreteState config.state).storage
          (embedConcreteState config.state).address (embedWordValue key) =
        some (embedWordValue value) := by
    simpa [embedConcreteState, hLookup] using
      embedAccountWordMap_lookupAccountValueMap? config.state.storage
        config.state.address key
  have hLookupNorm :
      ConcreteYul.lookupAccountWordMap? config.state.storage
          config.state.address (norm key) =
        some value := by
    simpa [concrete_lookupAccountWordMap?_norm_key] using hLookup
  have hBuiltin :
      ConcreteYul.evalBuiltin hash Evm.Builtin.sload [norm key]
          config.state =
        ConcreteYul.returnWord value config.state :=
    ConcreteYul.evalBuiltin_sload_present hash config.state (norm key) value
      hLookupNorm
  constructor
  · simp [ConcreteYul.evalRuntimeExpr, ConcreteYul.evalExpr,
      ConcreteYul.evalExprs, hBuiltin,
      ConcreteYul.returnWord, ConcreteYul.RuntimeConfig.toConfig,
      ConcreteYul.RuntimeConfig.withConfig]
  · simp [SymYul.guidedEvalExpr, SymYul.guidedEvalExprs,
      FullYul.evalEvmBuiltin_sload_present, embedConcreteExpr,
      embedConcreteExprs, embedRuntimeConfig, hFull]

theorem evalRuntimeExpr_sload_missing_refines_guided_model
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    {config : ConcreteYul.RuntimeConfig} {key : Word}
    (hLookup :
      ConcreteYul.lookupAccountWordMap? config.state.storage
        config.state.address key = none)
    (hModel :
      norm (model.storageWord (norm config.state.address) (norm key)) = 0) :
    ConcreteYul.evalRuntimeExpr hash
        (ConcreteYul.Expr.builtin Evm.Builtin.sload
          [ConcreteYul.Expr.word key]) config =
      some (0, config) ∧
    SymYul.guidedEvalExpr (embedRuntimeConfig config)
        (embedConcreteExpr
          (ConcreteYul.Expr.builtin Evm.Builtin.sload
            [ConcreteYul.Expr.word key])) =
      some
        (FullYul.Value.storageWord (embedConcreteState config.state).address
          (embedWordValue key),
          embedRuntimeConfig config) ∧
    ValueRel model 0
      (FullYul.Value.storageWord (embedConcreteState config.state).address
        (embedWordValue key)) := by
  have hFull :
      FullYul.lookupAccountValueMap?
          (embedConcreteState config.state).storage
          (embedConcreteState config.state).address (embedWordValue key) =
        none := by
    simpa [embedConcreteState, hLookup] using
      embedAccountWordMap_lookupAccountValueMap? config.state.storage
        config.state.address key
  have hLookupNorm :
      ConcreteYul.lookupAccountWordMap? config.state.storage
          config.state.address (norm key) = none := by
    simpa [concrete_lookupAccountWordMap?_norm_key] using hLookup
  have hBuiltin :
      ConcreteYul.evalBuiltin hash Evm.Builtin.sload [norm key]
          config.state =
        ConcreteYul.returnWord 0 config.state :=
    ConcreteYul.evalBuiltin_sload_missing hash config.state (norm key)
      hLookupNorm
  have hGuidedBuiltin :
      FullYul.evalEvmBuiltin Evm.Builtin.sload
          [embedWordValue key] (embedConcreteState config.state) =
        some
          (FullYul.Value.storageWord (embedConcreteState config.state).address
            (embedWordValue key),
            embedConcreteState config.state) :=
    FullYul.evalEvmBuiltin_sload_missing (embedConcreteState config.state)
      (embedWordValue key) hFull
  constructor
  · simp [ConcreteYul.evalRuntimeExpr, ConcreteYul.evalExpr,
      ConcreteYul.evalExprs, hBuiltin, ConcreteYul.returnWord,
      ConcreteYul.RuntimeConfig.toConfig,
      ConcreteYul.RuntimeConfig.withConfig, norm_zero]
  · constructor
    · simp [SymYul.guidedEvalExpr, SymYul.guidedEvalExprs, hGuidedBuiltin,
        embedConcreteExpr, embedConcreteExprs, embedRuntimeConfig]
    · unfold ValueRel embedWordValue
      simpa [SymYul.interpValue, norm_zero, norm_norm, embedConcreteState]
        using hModel.symm

