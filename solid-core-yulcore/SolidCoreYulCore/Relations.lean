                    norm (SymYul.interpValue model (embedWordValue label)) := by
                intro hEq
                apply hMatch
                have hLeft :
                    norm (SymYul.interpValue model symbolicValue) =
                      norm value := by
                  rw [interpValue_norm model symbolicValue, ← hValueRel]
                have hRight :
                    norm (SymYul.interpValue model (embedWordValue label)) =
                      norm label := by
                  simp [SymYul.interpValue, embedWordValue, norm_norm]
                calc
                  norm label =
                      norm (SymYul.interpValue model (embedWordValue label)) :=
                    hRight.symm
                  _ = norm (SymYul.interpValue model symbolicValue) := hEq.symm
                  _ = norm value := hLeft
              have hGuidedRest' := hGuidedRest symbolicValue hValueRel
              simp only [embedConcreteSwitchCasesFuel,
                SymYul.guidedSwitchTarget?]
              rw [if_neg hGuidedNe]
              simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm]
                using hGuidedRest' ⟩

