    (consConsRel :
      ∀ {concreteConfig : C} {symbolicConfig : S}
        {expr₁ expr₂ : ConcreteYul.Expr} {rest : List ConcreteYul.Expr},
        (∀ {concreteConfig' : C} {symbolicConfig' : S},
