theorem evalEvmBuiltin_sload_readValueRel
    {model : SymYul.ConcreteModel}
    {concrete : ConcreteYul.State} {symbolic : FullYul.EvmState}
    (hRel : EvmStateReadValueRel model concrete symbolic)
    (hModelStorageZero :
      ∀ address key,
        norm (model.storageWord (norm address) (norm key)) = 0)
    (key : Word) :
    ∃ symbolicValue,
      FullYul.evalEvmBuiltin Evm.Builtin.sload
          [embedWordValue key] symbolic =
        some (symbolicValue, symbolic) ∧
      ValueRel model
        (readAccountWordMapD concrete.storage concrete.address key)
        symbolicValue := by
  cases hLookup :
      FullYul.lookupAccountValueMap? symbolic.storage symbolic.address
        (embedWordValue key) with
  | none =>
      have hLookupConcrete :
          FullYul.lookupAccountValueMap? symbolic.storage
              (norm concrete.address) (embedWordValue key) = none := by
        simpa [hLookup] using
          (lookupAccountValueMap?_eq_of_norm symbolic.storage
            (left := symbolic.address) (right := norm concrete.address)
            (by
              simpa [norm_norm] using hRel.valueRel.addressRel)
            (embedWordValue key)).symm
      have hReadZero :
          ValueRel model
            (readAccountWordMapD concrete.storage concrete.address key)
            (embedWordValue 0) := by
        simpa [readAccountValueMapD, hLookupConcrete] using
          hRel.storageReadRel concrete.address key
      refine
        ⟨ FullYul.Value.storageWord symbolic.address (embedWordValue key)
        , ?_
        , ?_ ⟩
      · exact
          FullYul.evalEvmBuiltin_sload_missing symbolic
            (embedWordValue key) hLookup
      · unfold ValueRel at hReadZero ⊢
        simpa [SymYul.interpValue, embedWordValue, norm_zero,
          norm_norm, hModelStorageZero symbolic.address key] using hReadZero
  | some symbolicValue =>
      have hLookupConcrete :
          FullYul.lookupAccountValueMap? symbolic.storage
              (norm concrete.address) (embedWordValue key) =
            some symbolicValue := by
        simpa [hLookup] using
          (lookupAccountValueMap?_eq_of_norm symbolic.storage
            (left := symbolic.address) (right := norm concrete.address)
            (by
              simpa [norm_norm] using hRel.valueRel.addressRel)
            (embedWordValue key)).symm
      have hRead :
          ValueRel model
            (readAccountWordMapD concrete.storage concrete.address key)
            symbolicValue := by
        simpa [readAccountValueMapD, hLookupConcrete] using
          hRel.storageReadRel concrete.address key
      refine ⟨symbolicValue, ?_, hRead⟩
      exact
        FullYul.evalEvmBuiltin_sload_present symbolic
          (embedWordValue key) symbolicValue hLookup

