      cases hConcrete
      unfold SymYul.restoreGuidedBlockConfig at hSymbolic
      cases hSymbolicEnv :
          FullYul.restoreOuter symbolicOuter.env symbolicInner.env with
      | none =>
          simp [hSymbolicEnv] at hSymbolic
      | some symbolicRestoredEnv =>
          simp [hSymbolicEnv] at hSymbolic
          cases hSymbolic
          constructor
          · exact envRel_restoreOuter hOuter.envRel hInner.envRel
              hConcreteEnv hSymbolicEnv
          · exact hInner.evmRel
          · exact hOuter.funcsRel
          · exact hInner.objectRel

