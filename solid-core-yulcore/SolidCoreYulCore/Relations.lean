theorem runtimeExprsExactSim_single_of_runtimeExprExactSim
    {hash : ConcreteYul.HashOracle} {config : ConcreteYul.RuntimeConfig}
    {expr : ConcreteYul.Expr}
    (hExpr : RuntimeExprExactSim hash config expr) :
    RuntimeExprsExactSim hash config [expr] := by
  intro concreteValues concreteConfig hConcrete
  cases hEval : ConcreteYul.evalRuntimeExpr hash expr config with
  | none =>
      simp [ConcreteYul.evalRuntimeExprs, hEval] at hConcrete
  | some exprResult =>
      cases exprResult with
      | mk value config' =>
          simp [ConcreteYul.evalRuntimeExprs, hEval] at hConcrete
          rcases hConcrete with ⟨hValues, hConfig⟩
          subst concreteValues
          subst concreteConfig
          have hGuided := hExpr value config' hEval
