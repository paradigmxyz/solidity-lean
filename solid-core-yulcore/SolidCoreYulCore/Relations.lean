theorem evmStateRel_memory_write
    {model : SymYul.ConcreteModel}
    {concrete : ConcreteYul.State} {symbolic : FullYul.EvmState}
    (hRel : EvmStateRel model concrete symbolic)
    (memory : ConcreteYul.Bytes) (offset size : Word) :
    EvmStateRel model
      (ConcreteYul.setMemoryAfterAccess concrete memory offset size)
      (FullYul.recordMemoryWrite symbolic offset size) := by
  cases hRel with
  | mk hStorage hTransient hImmutables hLinker hCalldata hReturndata
      hCode hMemorySize hLogs hExternal hHalt hAddress =>
      by_cases hZero : norm size = 0
      · constructor
        · simpa [ConcreteYul.setMemoryAfterAccess,
            FullYul.recordMemoryWrite, FullYul.bumpMemoryVersionIfAccessed,
            FullYul.expandMemory, hZero] using hStorage
        · simpa [ConcreteYul.setMemoryAfterAccess,
            FullYul.recordMemoryWrite, FullYul.bumpMemoryVersionIfAccessed,
            FullYul.expandMemory, hZero] using hTransient
        · simpa [ConcreteYul.setMemoryAfterAccess,
            FullYul.recordMemoryWrite, FullYul.bumpMemoryVersionIfAccessed,
            FullYul.expandMemory, hZero] using hImmutables
        · simpa [ConcreteYul.setMemoryAfterAccess,
            FullYul.recordMemoryWrite, FullYul.bumpMemoryVersionIfAccessed,
            FullYul.expandMemory, hZero] using hLinker
        · simpa [ConcreteYul.setMemoryAfterAccess,
            FullYul.recordMemoryWrite, FullYul.bumpMemoryVersionIfAccessed,
            FullYul.expandMemory, hZero] using hCalldata
        · simpa [ConcreteYul.setMemoryAfterAccess,
            FullYul.recordMemoryWrite, FullYul.bumpMemoryVersionIfAccessed,
            FullYul.expandMemory, hZero] using hReturndata
        · simpa [ConcreteYul.setMemoryAfterAccess,
            FullYul.recordMemoryWrite, FullYul.bumpMemoryVersionIfAccessed,
            FullYul.expandMemory, hZero] using hCode
        · have hSize :=
            memorySizeAfter_congr_current
              (lhs := symbolic.msize) (rhs := concrete.memorySize)
              (offset := offset) (size := size) hMemorySize
          simp [ConcreteYul.setMemoryAfterAccess,
            FullYul.recordMemoryWrite, FullYul.bumpMemoryVersionIfAccessed,
            FullYul.expandMemory, hZero, hSize]
        · simpa [ConcreteYul.setMemoryAfterAccess,
            FullYul.recordMemoryWrite, FullYul.bumpMemoryVersionIfAccessed,
            FullYul.expandMemory, hZero] using hLogs
        · simpa [ConcreteYul.setMemoryAfterAccess,
            FullYul.recordMemoryWrite, FullYul.bumpMemoryVersionIfAccessed,
            FullYul.expandMemory, hZero] using hExternal
        · simpa [ConcreteYul.setMemoryAfterAccess,
            FullYul.recordMemoryWrite, FullYul.bumpMemoryVersionIfAccessed,
            FullYul.expandMemory, hZero] using hHalt
        · simpa [ConcreteYul.setMemoryAfterAccess,
            FullYul.recordMemoryWrite, FullYul.bumpMemoryVersionIfAccessed,
            FullYul.expandMemory, hZero, EvmStateAddressRel] using
            hAddress
      · constructor
        · simpa [ConcreteYul.setMemoryAfterAccess,
            FullYul.recordMemoryWrite, FullYul.bumpMemoryVersionIfAccessed,
            FullYul.bumpMemoryVersion, FullYul.expandMemory, hZero] using
            hStorage
        · simpa [ConcreteYul.setMemoryAfterAccess,
            FullYul.recordMemoryWrite, FullYul.bumpMemoryVersionIfAccessed,
            FullYul.bumpMemoryVersion, FullYul.expandMemory, hZero] using
            hTransient
        · simpa [ConcreteYul.setMemoryAfterAccess,
            FullYul.recordMemoryWrite, FullYul.bumpMemoryVersionIfAccessed,
            FullYul.bumpMemoryVersion, FullYul.expandMemory, hZero] using
            hImmutables
        · simpa [ConcreteYul.setMemoryAfterAccess,
            FullYul.recordMemoryWrite, FullYul.bumpMemoryVersionIfAccessed,
            FullYul.bumpMemoryVersion, FullYul.expandMemory, hZero] using
            hLinker
