      · simpa [hSymbolicArgsEq, hDestNorm, hOffsetNorm, hSizeNorm,
          hSizeZero, hSizeEqZero, embedWordValue, FullYul.returnUnit,
          FullYul.returnWord, norm_zero] using
          FullYul.evalEvmBuiltin_calldatacopy_words
            symbolicArgConfig.evm dest offset size
      · simpa [hAfterConfig] using
          runtimeConfigReadValueExactWithCalldataRel_zero_memory_write
            hArgConfigExact
            (ConcreteYul.copyBytes concreteArgConfig.state.memory dest
              concreteArgConfig.state.calldata offset size)
            dest size hSizeZero
    · have hSizeNeZero : size ≠ 0 := by
        intro hEq
        apply hSizeZero
        rw [hEq]
        exact norm_zero
      refine
        ⟨ embedWordValue 0
        , FullYul.recordMemoryWrite
            { symbolicArgConfig.evm with
              memoryWords := []
              memoryBytes :=
                FullYul.ObjectMemory.write
                  symbolicArgConfig.evm.memoryBytes dest
                  (FullYul.SymbolicBytes.calldataSlice offset size) }
            dest size
        , ?_
        , valueRel_embedWordValue model 0
        , ?_ ⟩
      · simpa [hSymbolicArgsEq, hDestNorm, hOffsetNorm, hSizeNorm,
          hSizeZero, hSizeNeZero, embedWordValue, FullYul.returnUnit,
          FullYul.returnWord, norm_zero] using
          FullYul.evalEvmBuiltin_calldatacopy_words
            symbolicArgConfig.evm dest offset size
      · simpa [hAfterConfig] using
          runtimeConfigReadValueExactWithCalldataRel_symbolicMemorySummary_write
            hArgConfigExact
            (ConcreteYul.copyBytes concreteArgConfig.state.memory dest
              concreteArgConfig.state.calldata offset size)
            dest size (FullYul.SymbolicBytes.calldataSlice offset size)

inductive RuntimeBufferBuiltinValueArgKinds :
    Evm.Builtin -> List ConcreteYul.Expr -> List RuntimeArgKind -> Prop where
  | calldataloadOp {offset : ConcreteYul.Expr} :
      RuntimeBufferBuiltinValueArgKinds Evm.Builtin.calldataloadOp
        [offset] [RuntimeArgKind.word]
  | calldatasizeOp :
      RuntimeBufferBuiltinValueArgKinds Evm.Builtin.calldatasizeOp [] []
  | calldatacopyOp {dest offset size : ConcreteYul.Expr} :
      RuntimeBufferBuiltinValueArgKinds Evm.Builtin.calldatacopyOp
        [dest, offset, size]
        [RuntimeArgKind.word, RuntimeArgKind.word, RuntimeArgKind.word]

theorem RuntimeBufferBuiltinValueArgKinds.of_profileBuffer
    {builtin : Evm.Builtin} {args : List ConcreteYul.Expr}
    (hBuiltin : FullYul.CompilerProfile.BufferBuiltin builtin)
    (hSig : ∃ sig, builtin.signature? = some sig ∧
      sig.paramCount = args.length) :
    ∃ kinds,
      RuntimeBufferBuiltinValueArgKinds builtin args kinds := by
  cases hBuiltin with
  | calldataloadOp =>
      rcases hSig with ⟨sig, hSig, hLen⟩
      simp [Evm.Builtin.signature?] at hSig
      cases hSig
      cases args with
      | nil =>
          simp at hLen
      | cons offset rest =>
          cases rest with
          | nil =>
              exact
                ⟨ [RuntimeArgKind.word]
                , RuntimeBufferBuiltinValueArgKinds.calldataloadOp ⟩
          | cons _ _ =>
              simp at hLen
  | calldatasizeOp =>
      rcases hSig with ⟨sig, hSig, hLen⟩
      simp [Evm.Builtin.signature?] at hSig
      cases hSig
      cases args with
      | nil =>
          exact ⟨[], RuntimeBufferBuiltinValueArgKinds.calldatasizeOp⟩
      | cons _ _ =>
          simp at hLen
  | calldatacopyOp =>
      rcases hSig with ⟨sig, hSig, hLen⟩
      simp [Evm.Builtin.signature?] at hSig
      cases hSig
      cases args with
      | nil =>
          simp at hLen
      | cons dest rest =>
          cases rest with
          | nil =>
              simp at hLen
          | cons offset restTail =>
              cases restTail with
              | nil =>
                  simp at hLen
              | cons size restTailTail =>
                  cases restTailTail with
                  | nil =>
                      exact
                        ⟨ [ RuntimeArgKind.word
                          , RuntimeArgKind.word
                          , RuntimeArgKind.word ]
                        , RuntimeBufferBuiltinValueArgKinds.calldatacopyOp ⟩
                  | cons _ _ =>
                      simp at hLen

