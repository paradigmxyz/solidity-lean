  · cases fuel with
    | zero =>
        simp [SymYul.guidedEvalStmtFuel] at hGuidedBranch
    | succ fuel =>
        simp [SymYul.guidedEvalStmtFuel, SymYul.guidedSwitchTarget?,
          embedConcreteStmtFuel, embedConcreteSwitchCasesFuel, hGuidedDiscr,
          SymYul.interpValue, embedWordValue, norm_norm, hMatch',
