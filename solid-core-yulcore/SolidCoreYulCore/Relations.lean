theorem runtimeExprCoveredSpec_mono_spec
    {source target : RuntimeCoverageSpec}
    (hLe : RuntimeCoverageSpecLe source target) :
    ∀ {expr : ConcreteYul.Expr},
      RuntimeExprCoveredSpec source expr ->
        RuntimeExprCoveredSpec target expr
  | _, RuntimeExprCovered.word => RuntimeExprCovered.word
  | _, RuntimeExprCovered.var => RuntimeExprCovered.var
  | _, RuntimeExprCovered.dataSize => RuntimeExprCovered.dataSize
  | _, RuntimeExprCovered.dataOffset hOK =>
      RuntimeExprCovered.dataOffset (hLe.dataOffset hOK)
  | _, RuntimeExprCovered.builtin hArgs hOK =>
      RuntimeExprCovered.builtin
        (runtimeExprsCoveredSpec_mono_spec hLe hArgs)
        (hLe.builtinExpr hOK)

theorem runtimeExprsCoveredSpec_mono_spec
    {source target : RuntimeCoverageSpec}
    (hLe : RuntimeCoverageSpecLe source target) :
    ∀ {exprs : List ConcreteYul.Expr},
      RuntimeExprsCoveredSpec source exprs ->
        RuntimeExprsCoveredSpec target exprs
  | _, RuntimeExprsCovered.nil => RuntimeExprsCovered.nil
  | _, RuntimeExprsCovered.cons hExpr hRest =>
      RuntimeExprsCovered.cons
        (runtimeExprCoveredSpec_mono_spec hLe hExpr)
        (runtimeExprsCoveredSpec_mono_spec hLe hRest)
end

theorem runtimeExprsAsYulValuesCoveredSpec_mono_spec
    {source target : RuntimeCoverageSpec}
    (hLe : RuntimeCoverageSpecLe source target) :
    ∀ {exprs : List ConcreteYul.Expr},
      RuntimeExprsAsYulValuesCoveredSpec source exprs ->
        RuntimeExprsAsYulValuesCoveredSpec target exprs
  | _, RuntimeExprsAsYulValuesCovered.nil =>
      RuntimeExprsAsYulValuesCovered.nil
  | _, RuntimeExprsAsYulValuesCovered.consCons hFirst hSecond hRest =>
      RuntimeExprsAsYulValuesCovered.consCons
        (runtimeExprCoveredSpec_mono_spec hLe hFirst)
        (runtimeExprCoveredSpec_mono_spec hLe hSecond)
        (runtimeExprsCoveredSpec_mono_spec hLe hRest)
  | _, RuntimeExprsAsYulValuesCovered.singleNonBuiltin hNonBuiltin hExpr =>
      RuntimeExprsAsYulValuesCovered.singleNonBuiltin hNonBuiltin
        (runtimeExprCoveredSpec_mono_spec hLe hExpr)
  | _, RuntimeExprsAsYulValuesCovered.singleBuiltinOne hArgs hOK hSig hResult =>
      RuntimeExprsAsYulValuesCovered.singleBuiltinOne
        (runtimeExprsCoveredSpec_mono_spec hLe hArgs)
        (hLe.builtinExpr hOK) hSig hResult
  | _, RuntimeExprsAsYulValuesCovered.singleBuiltinValues hArgs hOK =>
      RuntimeExprsAsYulValuesCovered.singleBuiltinValues
        (runtimeExprsCoveredSpec_mono_spec hLe hArgs)
        (hLe.builtinValues hOK)

theorem runtimeStraightStmtCoveredSpec_mono_spec
    {source target : RuntimeCoverageSpec}
    (hLe : RuntimeCoverageSpecLe source target) :
    ∀ {stmt : ConcreteYul.Stmt},
      RuntimeStraightStmtCoveredSpec source stmt ->
        RuntimeStraightStmtCoveredSpec target stmt
  | _, RuntimeStraightStmtCovered.skip => RuntimeStraightStmtCovered.skip
  | _, RuntimeStraightStmtCovered.expr hExpr =>
      RuntimeStraightStmtCovered.expr
        (runtimeExprCoveredSpec_mono_spec hLe hExpr)
  | _, RuntimeStraightStmtCovered.let1None =>
      RuntimeStraightStmtCovered.let1None
  | _, RuntimeStraightStmtCovered.let1Some hExpr =>
      RuntimeStraightStmtCovered.let1Some
        (runtimeExprCoveredSpec_mono_spec hLe hExpr)
  | _, RuntimeStraightStmtCovered.letManyNone =>
      RuntimeStraightStmtCovered.letManyNone
  | _, RuntimeStraightStmtCovered.letManySome hExprs =>
      RuntimeStraightStmtCovered.letManySome
        (runtimeExprsAsYulValuesCoveredSpec_mono_spec hLe hExprs)
  | _, RuntimeStraightStmtCovered.assign hExpr =>
      RuntimeStraightStmtCovered.assign
        (runtimeExprCoveredSpec_mono_spec hLe hExpr)
  | _, RuntimeStraightStmtCovered.assignMany hExprs =>
      RuntimeStraightStmtCovered.assignMany
        (runtimeExprsAsYulValuesCoveredSpec_mono_spec hLe hExprs)
  | _, RuntimeStraightStmtCovered.break => RuntimeStraightStmtCovered.break
  | _, RuntimeStraightStmtCovered.continue =>
      RuntimeStraightStmtCovered.continue
  | _, RuntimeStraightStmtCovered.leave => RuntimeStraightStmtCovered.leave

theorem runtimeStraightBlockCoveredSpec_mono_spec
    {source target : RuntimeCoverageSpec}
    (hLe : RuntimeCoverageSpecLe source target) :
    ∀ {length : Nat} {stmts : List ConcreteYul.Stmt},
      RuntimeStraightBlockCovered source.DataOffsetOK source.BuiltinExprOK
          source.BuiltinValuesOK length stmts ->
        RuntimeStraightBlockCovered target.DataOffsetOK target.BuiltinExprOK
          target.BuiltinValuesOK length stmts
  | _, _, RuntimeStraightBlockCovered.nil => RuntimeStraightBlockCovered.nil
  | _, _, RuntimeStraightBlockCovered.cons hStmt hRest =>
      RuntimeStraightBlockCovered.cons
        (runtimeStraightStmtCoveredSpec_mono_spec hLe hStmt)
        (runtimeStraightBlockCoveredSpec_mono_spec hLe hRest)

theorem runtimeCoveredStmtSpec_mono_spec
    {source target : RuntimeCoverageSpec}
    (hLe : RuntimeCoverageSpecLe source target) :
    ∀ {stmt : ConcreteYul.Stmt},
      RuntimeCoveredStmtSpec source stmt -> RuntimeCoveredStmtSpec target stmt
  | _, RuntimeCoveredStmt.straight hStmt =>
      RuntimeCoveredStmt.straight
        (runtimeStraightStmtCoveredSpec_mono_spec hLe hStmt)
  | _, RuntimeCoveredStmt.letCall hArgs hOK =>
      RuntimeCoveredStmt.letCall
        (runtimeExprsCoveredSpec_mono_spec hLe hArgs)
        (hLe.function hOK)
  | _, RuntimeCoveredStmt.assignCall hArgs hOK =>
      RuntimeCoveredStmt.assignCall
        (runtimeExprsCoveredSpec_mono_spec hLe hArgs)
        (hLe.function hOK)
  | _, RuntimeCoveredStmt.ifStraight hCond hBody =>
      RuntimeCoveredStmt.ifStraight
        (runtimeExprCoveredSpec_mono_spec hLe hCond)
        (runtimeStraightStmtCoveredSpec_mono_spec hLe hBody)

theorem runtimeCoveredBlockSpec_mono_spec
    {source target : RuntimeCoverageSpec}
    (hLe : RuntimeCoverageSpecLe source target) :
    ∀ {length : Nat} {stmts : List ConcreteYul.Stmt},
      RuntimeCoveredBlockSpec source length stmts ->
        RuntimeCoveredBlockSpec target length stmts
  | _, _, RuntimeCoveredBlock.nil => RuntimeCoveredBlock.nil
  | _, _, RuntimeCoveredBlock.cons hStmt hRest =>
      RuntimeCoveredBlock.cons
        (runtimeCoveredStmtSpec_mono_spec hLe hStmt)
        (runtimeCoveredBlockSpec_mono_spec hLe hRest)

theorem runtimeSwitchCoveredSpec_mono_spec
    {source target : RuntimeCoverageSpec}
    (hLe : RuntimeCoverageSpecLe source target)
    {discr : ConcreteYul.Expr}
    {cases : List (Word × ConcreteYul.Stmt)}
    {defaultBranch : Option ConcreteYul.Stmt}
    (hSwitch : RuntimeSwitchCoveredSpec source discr cases defaultBranch) :
    RuntimeSwitchCoveredSpec target discr cases defaultBranch where
  discrCovered := runtimeExprCoveredSpec_mono_spec hLe hSwitch.discrCovered
  casesCovered :=
    fun switchCase hMem =>
      runtimeCoveredStmtSpec_mono_spec hLe
        (hSwitch.casesCovered switchCase hMem)
  defaultCovered := by
    cases defaultBranch with
    | none =>
        trivial
    | some stmt =>
        exact runtimeCoveredStmtSpec_mono_spec hLe hSwitch.defaultCovered

def runtimeFunctionBodyCoveredSpecMonoAlg
    {source target : RuntimeCoverageSpec}
    (hLe : RuntimeCoverageSpecLe source target) :
    RuntimeFunctionBodyCoveredAlg source
      (fun minEmbedFuel stmt =>
        RuntimeFunctionBodyCoveredSpec target minEmbedFuel stmt) where
  stmt := fun {_stmt} hStmt =>
    RuntimeFunctionBodyCoveredSpec.stmt
      (runtimeCoveredStmtSpec_mono_spec hLe hStmt)
  block := fun {_length} {_stmts} hBlock =>
    RuntimeFunctionBodyCoveredSpec.block
      (runtimeCoveredBlockSpec_mono_spec hLe hBlock)
  funDef := fun {_fnName} {_params} {_returns} {_body}
      {_bodyEmbedFuel} hBody hEmbed =>
    RuntimeFunctionBodyCoveredSpec.funDef hBody hEmbed
  seq := fun {_first} {_second} {_firstEmbedFuel}
      {_secondEmbedFuel} hFirst hSecond =>
    RuntimeFunctionBodyCoveredSpec.seq hFirst hSecond
  ifThen := fun {_cond} {_body} {_minBodyEmbedFuel} hCond hBody =>
    RuntimeFunctionBodyCoveredSpec.ifThen
      (runtimeExprCoveredSpec_mono_spec hLe hCond) hBody
  switch := fun {_discr} {_cases} {_defaultBranch} hSwitch =>
    RuntimeFunctionBodyCoveredSpec.switch
      (runtimeSwitchCoveredSpec_mono_spec hLe hSwitch)
  forLoop := fun {_pre} {_post} {_body} {_cond} {_preEmbedFuel}
      {_postEmbedFuel} {_bodyEmbedFuel} hPre hCond hPost hBody =>
    RuntimeFunctionBodyCoveredSpec.forLoop hPre
      (runtimeExprCoveredSpec_mono_spec hLe hCond) hPost hBody

theorem runtimeFunctionBodyCoveredSpec_mono_spec
    {source target : RuntimeCoverageSpec}
    (hLe : RuntimeCoverageSpecLe source target) :
    ∀ {minEmbedFuel : Nat} {stmt : ConcreteYul.Stmt},
      RuntimeFunctionBodyCoveredSpec source minEmbedFuel stmt ->
        RuntimeFunctionBodyCoveredSpec target minEmbedFuel stmt
    := by
  intro minEmbedFuel stmt hCovered
  exact
    RuntimeFunctionBodyCoveredSpec.foldRel
