theorem runtimeResultRel_guidedReturnValues_normal
    {model : SymYul.ConcreteModel}
    {concreteConfig : ConcreteYul.RuntimeConfig}
    {symbolicResult : SymYul.GuidedResult}
    {returns : List FullYul.Name} {values : List Word}
