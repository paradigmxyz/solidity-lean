theorem runtimeConfigReadValueExactRel_positionedImmutable_write
    {model : SymYul.ConcreteModel}
    {concrete : ConcreteYul.RuntimeConfig} {symbolic : SymYul.GuidedConfig}
    (hExact : RuntimeConfigReadValueExactRel model concrete symbolic)
    (offset : Word) (positions : List Word) (key value : Word)
    {symbolicValue : FullYul.Value}
    (hValue : ValueRel model value symbolicValue)
    (hMemorySize :
      norm symbolic.evm.msize =
        norm
          (ConcreteYul.writeImmutableMemory
            { concrete.state with
              immutables :=
                ConcreteYul.writeWordMap concrete.state.immutables key value }
            offset positions value).memorySize) :
    RuntimeConfigReadValueExactRel model
      { concrete with
        state :=
          ConcreteYul.writeImmutableMemory
            { concrete.state with
              immutables :=
                ConcreteYul.writeWordMap concrete.state.immutables key value }
            offset positions value }
      { symbolic with
        evm :=
          { symbolic.evm with
            immutables :=
              FullYul.writeValueMap symbolic.evm.immutables
                (embedWordValue key) symbolicValue } } := by
  constructor
  · exact hExact.envRel
  · constructor
    · cases hExact.evmRel.valueRel with
      | mk hStorage hTransient hImmutables hLinker hCalldata hReturndata
          hCode _hMemorySizeOld hLogs hExternal hHalt hAddress =>
          constructor
          · simpa [writeImmutableMemory_storage] using hStorage
          · simpa [writeImmutableMemory_transientStorage] using hTransient
          · simpa [writeImmutableMemory_immutables] using
              wordMapValueRel_writeWordMap hImmutables key value hValue
          · simpa [writeImmutableMemory_linkerSymbols] using hLinker
          · simpa [writeImmutableMemory_calldata] using hCalldata
          · simpa [writeImmutableMemory_returndata] using hReturndata
          · simpa [writeImmutableMemory_code] using hCode
          · exact hMemorySize
          · simpa [writeImmutableMemory_logs] using hLogs
          · simpa [writeImmutableMemory_externalActions] using hExternal
          · simpa [writeImmutableMemory_halt?] using hHalt
          · simpa [writeImmutableMemory_address, EvmStateAddressRel] using
              hAddress
    · simpa [writeImmutableMemory_storage] using
        hExact.evmRel.storageReadRel
    · simpa [writeImmutableMemory_transientStorage] using
        hExact.evmRel.transientStorageReadRel
    · simpa [writeImmutableMemory_immutables] using
        wordMapReadValueRel_writeWordMap hExact.evmRel.immutablesReadRel
          key value hValue
    · simpa [writeImmutableMemory_linkerSymbols] using
        hExact.evmRel.linkerSymbolsReadRel
  · exact hExact.funcsRel
  · exact hExact.objectRel
  · exact hExact.envExact

theorem embedConcreteState_storage_write
    (state : ConcreteYul.State) (key value : Word) :
    embedConcreteState
        { state with
          storage :=
            ConcreteYul.writeAccountWordMap state.storage state.address
              key value } =
      { embedConcreteState state with
        storage :=
          FullYul.writeAccountValueMap (embedConcreteState state).storage
            (embedConcreteState state).address
            (embedWordValue key) (embedWordValue value) } := by
  simp [embedConcreteState, embedAccountWordMap_writeAccountWordMap]

