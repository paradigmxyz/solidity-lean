abbrev RuntimeStructuralBodyCoveredConfigExactProviderUpTo
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    (maxFunctionFuel : Nat) (spec : RuntimeCoverageSpec) : Prop :=
  ∀ {fuel embedFuel minEmbedFuel : Nat}
