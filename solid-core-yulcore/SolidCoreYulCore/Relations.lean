theorem runtimeStmtFuelSim_ifThen_of_expr_body_success
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    (fuel embedFuel : Nat)
    {ConfigRel :
      ConcreteYul.RuntimeConfig -> SymYul.GuidedConfig -> Prop}
    {ResultRel :
      ConcreteYul.RuntimeResult -> SymYul.GuidedResult -> Prop}
    {concreteConfig : ConcreteYul.RuntimeConfig}
    {symbolicConfig : SymYul.GuidedConfig}
    {cond : ConcreteYul.Expr} {body : ConcreteYul.Stmt}
    (hNormalRel :
      ∀ {concreteConfig' symbolicConfig'},
        ConfigRel concreteConfig' symbolicConfig' ->
        ResultRel (ConcreteYul.runtimeNormalResult concreteConfig')
          (SymYul.guidedNormalResult symbolicConfig'))
    (hExpr :
      ConfigRel concreteConfig symbolicConfig ->
      ∀ concreteValue concreteConfig',
        ConcreteYul.evalRuntimeExpr hash cond concreteConfig =
          some (concreteValue, concreteConfig') ->
        ∃ symbolicValue symbolicConfig',
          SymYul.guidedEvalExpr symbolicConfig (embedConcreteExpr cond) =
            some (symbolicValue, symbolicConfig') ∧
          ValueRel model concreteValue symbolicValue ∧
          ConfigRel concreteConfig' symbolicConfig')
    (hBody :
      ∀ {concreteBodyConfig symbolicBodyConfig},
        ConfigRel concreteBodyConfig symbolicBodyConfig ->
        ∀ concreteResult,
          ConcreteYul.evalRuntimeStmtFuel hash fuel concreteBodyConfig body =
            some concreteResult ->
          ∃ symbolicResult,
            SymYul.guidedEvalStmtFuel model fuel symbolicBodyConfig
                (embedConcreteStmtFuel embedFuel body) =
              some symbolicResult ∧
            ResultRel concreteResult symbolicResult) :
    ConfigRel concreteConfig symbolicConfig ->
      ∀ concreteResult,
        ConcreteYul.evalRuntimeStmtFuel hash fuel.succ concreteConfig
            (ConcreteYul.Stmt.ifThen cond body) =
          some concreteResult ->
        ∃ symbolicResult,
          SymYul.guidedEvalStmtFuel model fuel.succ symbolicConfig
              (embedConcreteStmtFuel embedFuel.succ
                (ConcreteYul.Stmt.ifThen cond body)) =
            some symbolicResult ∧
          ResultRel concreteResult symbolicResult := by
  intro hInputRel concreteResult hConcreteResult
  cases hCond : ConcreteYul.evalRuntimeExpr hash cond concreteConfig with
  | none =>
      simp [ConcreteYul.evalRuntimeStmtFuel, hCond] at hConcreteResult
  | some condResult =>
      rcases condResult with ⟨value, concreteConfig'⟩
      rcases hExpr hInputRel value concreteConfig' hCond with
        ⟨symbolicValue, symbolicConfig', hGuidedCond, hValueRel,
          hConfigRel⟩
      by_cases hZero : norm value = 0
      · simp [ConcreteYul.evalRuntimeStmtFuel, hCond, hZero,
          ConcreteYul.runtimeNormalResult] at hConcreteResult
        cases hConcreteResult
        have hBool := guidedBool_false_of_valueRel_zero hValueRel hZero
        exact
          ⟨ SymYul.guidedNormalResult symbolicConfig'
          , by
              simp [SymYul.guidedEvalStmtFuel, embedConcreteStmtFuel,
                hGuidedCond, hBool, SymYul.guidedNormalResult]
          , hNormalRel hConfigRel ⟩
      · have hConcreteBody :
            ConcreteYul.evalRuntimeStmtFuel hash fuel concreteConfig' body =
              some concreteResult := by
          simpa [ConcreteYul.evalRuntimeStmtFuel, hCond, hZero] using
            hConcreteResult
        rcases hBody hConfigRel concreteResult hConcreteBody with
          ⟨symbolicResult, hGuidedBody, hResultRel⟩
        have hBool := guidedBool_true_of_valueRel_nonzero hValueRel hZero
        exact
          ⟨ symbolicResult
          , by
              cases fuel with
              | zero =>
