      FullYul.declare? symbolic.env name symbolicValue = some symbolicEnv ∧
        RuntimeConfigReadValueExactRel model
          { concrete with env := concreteEnv }
          { symbolic with env := symbolicEnv } := by
  rcases envExactRel_declare?_of_concrete hExact.envExact hConcrete
      hValue with
    ⟨symbolicEnv, hSymbolic, hEnvExact⟩
  exact
    ⟨ symbolicEnv
    , hSymbolic
    , by
        constructor
        · exact envRel_declare? hExact.envRel hConcrete hSymbolic hValue
        · exact hExact.evmRel
        · exact hExact.funcsRel
        · exact hExact.objectRel
        · exact hEnvExact ⟩

