theorem runtimeExprCoveredSpec_of_checkExpr_embed
    {spec : RuntimeCoverageSpec}
    (hSyntax : RuntimePrimitiveSyntaxCoverageSpec spec)
    (ctx : FullYul.StaticContext) :
    ∀ {expr : ConcreteYul.Expr},
      FullYul.checkExpr ctx (embedConcreteExpr expr) = true ->
        RuntimeExprCoveredSpec spec expr
  | ConcreteYul.Expr.word _value, _hCheck =>
      RuntimeExprCovered.word
  | ConcreteYul.Expr.var _name, _hCheck =>
      RuntimeExprCovered.var
  | ConcreteYul.Expr.dataSize _label, _hCheck =>
      RuntimeExprCovered.dataSize
  | ConcreteYul.Expr.dataOffset _label, _hCheck =>
      RuntimeExprCovered.dataOffset hSyntax.dataOffset
  | ConcreteYul.Expr.builtin builtin args, hCheck =>
      by
        cases hSig : builtin.signature? with
        | none =>
            simp [embedConcreteExpr, FullYul.checkExpr, hSig] at hCheck
        | some sig =>
            have hRaw :
                (sig.paramCount = args.length ∧ sig.resultCount = 1) ∧
                  FullYul.checkExprs ctx (embedConcreteExprs args) = true := by
              simpa [embedConcreteExpr, FullYul.checkExpr, hSig] using hCheck
            exact
              RuntimeExprCovered.builtin
                (runtimeExprsCoveredSpec_of_checkExprs_embed hSyntax ctx
                  hRaw.2)
                (hSyntax.builtinExpr hSig hRaw.1.1)

theorem runtimeExprsCoveredSpec_of_checkExprs_embed
    {spec : RuntimeCoverageSpec}
    (hSyntax : RuntimePrimitiveSyntaxCoverageSpec spec)
    (ctx : FullYul.StaticContext) :
    ∀ {exprs : List ConcreteYul.Expr},
      FullYul.checkExprs ctx (embedConcreteExprs exprs) = true ->
        RuntimeExprsCoveredSpec spec exprs
  | [], _hCheck =>
      RuntimeExprsCovered.nil
  | expr :: rest, hCheck =>
      by
        have hChecks :
            FullYul.checkExpr ctx (embedConcreteExpr expr) = true ∧
              FullYul.checkExprs ctx (embedConcreteExprs rest) = true := by
          simpa [embedConcreteExprs, FullYul.checkExprs] using hCheck
        exact
          RuntimeExprsCovered.cons
            (runtimeExprCoveredSpec_of_checkExpr_embed hSyntax ctx hChecks.1)
            (runtimeExprsCoveredSpec_of_checkExprs_embed hSyntax ctx
              hChecks.2)
end

