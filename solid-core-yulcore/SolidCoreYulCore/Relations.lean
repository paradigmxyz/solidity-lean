theorem evalRuntimeExprs_length_of_success
    {hash : ConcreteYul.HashOracle}
    {exprs : List ConcreteYul.Expr}
    {config config' : ConcreteYul.RuntimeConfig}
    {values : List Word}
    (hEval :
      ConcreteYul.evalRuntimeExprs hash exprs config =
        some (values, config')) :
    values.length = exprs.length := by
  induction exprs generalizing config config' values with
  | nil =>
      simp [ConcreteYul.evalRuntimeExprs] at hEval
      rcases hEval with ⟨hValues, _hConfig⟩
      subst values
      rfl
  | cons expr rest ih =>
      cases hRest :
          ConcreteYul.evalRuntimeExprs hash rest config with
      | none =>
          simp [ConcreteYul.evalRuntimeExprs, hRest] at hEval
      | some restResult =>
          cases restResult with
          | mk restValues restConfig =>
              cases hExpr :
                  ConcreteYul.evalRuntimeExpr hash expr restConfig with
              | none =>
                  simp [ConcreteYul.evalRuntimeExprs, hRest, hExpr]
                    at hEval
              | some exprResult =>
                  cases exprResult with
                  | mk value exprConfig =>
                      simp [ConcreteYul.evalRuntimeExprs, hRest, hExpr]
                        at hEval
                      rcases hEval with ⟨hValues, _hConfig⟩
                      subst values
                      simp [ih hRest]

theorem list_eq_singleton_of_length_eq_one_runtime {α : Type}
    {xs : List α} (hLen : xs.length = 1) :
    ∃ x, xs = [x] := by
  cases xs with
  | nil =>
      simp at hLen
  | cons x rest =>
      cases rest with
      | nil =>
          exact ⟨x, rfl⟩
      | cons _ _ =>
          simp at hLen

theorem list_eq_pair_of_length_eq_two_runtime {α : Type}
    {xs : List α} (hLen : xs.length = 2) :
    ∃ x y, xs = [x, y] := by
  cases xs with
  | nil =>
      simp at hLen
  | cons x rest =>
      cases rest with
      | nil =>
          simp at hLen
      | cons y rest' =>
          cases rest' with
          | nil =>
              exact ⟨x, y, rfl⟩
          | cons _ _ =>
              simp at hLen

theorem list_eq_triple_of_length_eq_three_runtime {α : Type}
    {xs : List α} (hLen : xs.length = 3) :
    ∃ x y z, xs = [x, y, z] := by
  cases xs with
  | nil =>
      simp at hLen
  | cons x rest =>
      cases rest with
      | nil =>
          simp at hLen
      | cons y rest' =>
          cases rest' with
          | nil =>
              simp at hLen
          | cons z rest'' =>
              cases rest'' with
              | nil =>
                  exact ⟨x, y, z, rfl⟩
              | cons _ _ =>
                  simp at hLen

theorem runtimeExprReadValueExactRelSim_builtin_of_runtimeExprsKindReadValueExactRel
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    {concreteConfig : ConcreteYul.RuntimeConfig}
    {symbolicConfig : SymYul.GuidedConfig}
    {builtin : Evm.Builtin} {args : List ConcreteYul.Expr}
    {kinds : List RuntimeArgKind}
    {concreteArgs : List Word}
    {concreteArgConfig concreteAfterConfig : ConcreteYul.RuntimeConfig}
    {concreteValue : Word}
    (hArgs :
      RuntimeExprsKindReadValueExactRelSim model hash concreteConfig
        symbolicConfig args kinds)
    (hConcreteArgs :
      ConcreteYul.evalRuntimeExprs hash args concreteConfig =
        some (concreteArgs, concreteArgConfig))
    (hConcreteExpected :
      ConcreteYul.evalRuntimeExpr hash
          (ConcreteYul.Expr.builtin builtin args) concreteConfig =
        some (concreteValue, concreteAfterConfig))
    (hBuiltin :
      ∀ symbolicArgs symbolicArgConfig,
        SymYul.guidedEvalExprs symbolicConfig (embedConcreteExprs args) =
          some (symbolicArgs, symbolicArgConfig) ->
        RuntimeArgListKindRel model kinds concreteArgs symbolicArgs ->
        RuntimeConfigReadValueExactRel model concreteArgConfig
          symbolicArgConfig ->
        ∃ symbolicValue symbolicEvm',
          FullYul.evalEvmBuiltin builtin symbolicArgs
              symbolicArgConfig.evm =
            some (symbolicValue, symbolicEvm') ∧
          ValueRel model concreteValue symbolicValue ∧
          RuntimeConfigReadValueExactRel model
            concreteAfterConfig
            { symbolicArgConfig with evm := symbolicEvm' }) :
    RuntimeExprReadValueExactRelSim model hash concreteConfig symbolicConfig
      (ConcreteYul.Expr.builtin builtin args) := by
  intro hInputExact concreteValue' concreteConfig' hConcrete
  rw [hConcreteExpected] at hConcrete
  cases hConcrete
  rcases hArgs hInputExact concreteArgs concreteArgConfig hConcreteArgs with
    ⟨symbolicArgs, symbolicArgConfig, hGuidedArgs, hArgsRel,
      hArgConfigExact⟩
  rcases hBuiltin symbolicArgs symbolicArgConfig hGuidedArgs hArgsRel
      hArgConfigExact with
    ⟨symbolicValue, symbolicEvm', hGuidedBuiltin, hValueRel,
      hConfigExact⟩
  exact
    ⟨ symbolicValue
    , { symbolicArgConfig with evm := symbolicEvm' }
    , by
        simp [SymYul.guidedEvalExpr, embedConcreteExpr, hGuidedArgs,
          hGuidedBuiltin]
    , hValueRel
    , hConfigExact ⟩

