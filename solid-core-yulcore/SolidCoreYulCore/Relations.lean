    {stmts : List ConcreteYul.Stmt}
    {concreteConfig : ConcreteYul.RuntimeConfig}
    {symbolicConfig : SymYul.GuidedConfig}
    (hFunctionFuel : fuel.pred ≤ maxFunctionFuel)
    (hCovered :
      RuntimeStructuralBlockCoveredSpec spec blockEmbedFuel stmts)
    (hEmbedFuel : blockEmbedFuel + 1 ≤ embedFuel) :
    RuntimeStmtFuelExactRelSim model hash fuel embedFuel concreteConfig
      symbolicConfig (ConcreteYul.Stmt.block stmts) := by
  cases fuel with
  | zero =>
      exact
        runtimeStmtFuelExactRelSim_of_concrete_none
          (by simp [ConcreteYul.evalRuntimeStmtFuel])
  | succ fuel =>
      cases embedFuel with
      | zero =>
          cases hEmbedFuel
      | succ embedFuel =>
          intro hInputExact concreteResult hConcreteResult
          have hBlockEmbedFuel : blockEmbedFuel ≤ embedFuel :=
            Nat.succ_le_succ_iff.mp
              (by
                simpa [Nat.succ_eq_add_one] using hEmbedFuel)
          have hCovered' :
              RuntimeStructuralBlockCoveredSpec spec embedFuel stmts :=
            runtimeStructuralBlockCoveredSpec_mono hCovered
              hBlockEmbedFuel
          have hCollectedRel :
              SymYul.collectBlockFunctionDefs
                  (embedConcreteStmtsFuel embedFuel stmts)
                  symbolicConfig.funcs =
                embedConcreteFunctionEnv
                  (ConcreteYul.collectBlockFunctionDefs stmts
                    concreteConfig.funcs) :=
            collectBlockFunctionDefs_embedRuntimeStructuralBlockCovered_rel
              hCovered' hInputExact.rel.funcsRel
          have hInnerFunctionFuel :
              fuel.pred ≤ maxFunctionFuel :=
            Nat.le_trans (Nat.pred_le fuel) hFunctionFuel
          exact
            (runtimeStmtFuelExactRelSim_block_of_block_success model hash
              fuel embedFuel hCollectedRel
              (runtimeBlockFuelExactRelSim_of_structural_block_covered_provider_fuel_upTo
                model hash hProvider hInnerFunctionFuel hCovered'))
              hInputExact concreteResult hConcreteResult

