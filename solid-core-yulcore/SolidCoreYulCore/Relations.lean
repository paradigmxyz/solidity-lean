theorem runtimeStmtFuelRelSim_funDef_of_declareFunction_rel
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    (fuel embedFuel : Nat)
    {concreteConfig : ConcreteYul.RuntimeConfig}
    {symbolicConfig : SymYul.GuidedConfig}
    (fnName : FullYul.Name) (params returns : List FullYul.Name)
    (body : ConcreteYul.Stmt)
    (hDeclareRel :
      SymYul.declareFunction symbolicConfig.funcs fnName
          { params := params
            returns := returns
            body := embedConcreteStmtFuel embedFuel body } =
        embedConcreteFunctionEnv
          (ConcreteYul.declareFunction concreteConfig.funcs fnName
            { params := params, returns := returns, body := body })) :
    RuntimeStmtFuelRelSim model hash fuel.succ embedFuel.succ concreteConfig
      symbolicConfig
      (ConcreteYul.Stmt.funDef fnName params returns body) := by
  intro hInputRel concreteResult hConcreteResult
  simp [ConcreteYul.evalRuntimeStmtFuel,
    ConcreteYul.runtimeNormalResult] at hConcreteResult
  cases hConcreteResult
  let symbolicConfig' : SymYul.GuidedConfig :=
    { symbolicConfig with
      funcs :=
        SymYul.declareFunction symbolicConfig.funcs fnName
          { params := params
            returns := returns
            body := embedConcreteStmtFuel embedFuel body } }
  have hConfigRel :
      RuntimeConfigRel model
        { concreteConfig with
          funcs :=
            ConcreteYul.declareFunction concreteConfig.funcs fnName
              { params := params, returns := returns, body := body } }
        symbolicConfig' := by
    constructor
    · exact hInputRel.envRel
    · exact hInputRel.evmRel
    · exact hDeclareRel
    · exact hInputRel.objectRel
  exact
    ⟨ SymYul.guidedNormalResult symbolicConfig'
    , by
        simp [SymYul.guidedEvalStmtFuel, embedConcreteStmtFuel,
          SymYul.guidedNormalResult, symbolicConfig']
    , by
        simpa [ConcreteYul.runtimeNormalResult, SymYul.guidedNormalResult,
          symbolicConfig'] using
            runtimeResultRel_of_runtimeConfigRel
              ConcreteYul.CompleteFlow.normal hConfigRel ⟩

