  (wordMapReadExactRel_embedWordMap model entries).toValueRel

theorem wordMapRel_writeWordMap
    {model : SymYul.ConcreteModel}
    {concrete : List (Word × Word)}
    {symbolic : List (FullYul.Value × FullYul.Value)}
    (hRel : WordMapRel model concrete symbolic)
    (key value : Word) :
    WordMapRel model
      (ConcreteYul.writeWordMap concrete key value)
      (FullYul.writeValueMap symbolic
        (embedWordValue key) (embedWordValue value)) := by
  intro query result hLookup
  by_cases hKey : norm key = norm query
  · have hResult : result = norm value := by
      simpa [ConcreteYul.writeWordMap, ConcreteYul.lookupWordMap?,
        norm_norm, hKey] using hLookup.symm
    have hEmbedKey : embedWordValue key = embedWordValue query := by
      simp [embedWordValue, hKey]
    change
      (if embedWordValue key = embedWordValue query then
        some (embedWordValue value)
      else
        FullYul.lookupValueMap? symbolic (embedWordValue query)) =
          some (embedWordValue result)
    rw [if_pos hEmbedKey]
    simp [hResult, embedWordValue, norm_norm]
  · have hLookupOld :
        ConcreteYul.lookupWordMap? concrete query = some result := by
      simpa [ConcreteYul.writeWordMap, ConcreteYul.lookupWordMap?,
        norm_norm, hKey] using hLookup
    have hEmbedNe : embedWordValue key ≠ embedWordValue query := by
      intro hEq
      apply hKey
      simpa [embedWordValue] using hEq
    change
      (if embedWordValue key = embedWordValue query then
        some (embedWordValue value)
      else
        FullYul.lookupValueMap? symbolic (embedWordValue query)) =
          some (embedWordValue result)
    rw [if_neg hEmbedNe]
    exact hRel query result hLookupOld

theorem wordMapReadExactRel_writeWordMap
    {model : SymYul.ConcreteModel}
    {concrete : List (Word × Word)}
    {symbolic : List (FullYul.Value × FullYul.Value)}
    (hRel : WordMapReadExactRel model concrete symbolic)
    (key value : Word) :
    WordMapReadExactRel model
      (ConcreteYul.writeWordMap concrete key value)
      (FullYul.writeValueMap symbolic
        (embedWordValue key) (embedWordValue value)) := by
  intro query
  by_cases hKey : norm key = norm query
  · simp [ConcreteYul.writeWordMap, FullYul.writeValueMap,
      ConcreteYul.lookupWordMap?, FullYul.lookupValueMap?, readValueMapD,
      readWordMapD, norm_norm, hKey, embedWordValue]
  · have hEmbedNe : embedWordValue key ≠ embedWordValue query := by
      intro hEq
      apply hKey
      simpa [embedWordValue] using hEq
    simpa [ConcreteYul.writeWordMap, FullYul.writeValueMap,
      ConcreteYul.lookupWordMap?, FullYul.lookupValueMap?, readValueMapD,
      readWordMapD, norm_norm, hKey, hEmbedNe] using hRel query

theorem wordMapValueRel_writeWordMap
    {model : SymYul.ConcreteModel}
    {concrete : List (Word × Word)}
    {symbolic : List (FullYul.Value × FullYul.Value)}
    (hRel : WordMapValueRel model concrete symbolic)
    (key value : Word) {symbolicValue : FullYul.Value}
    (hValue : ValueRel model value symbolicValue) :
    WordMapValueRel model
      (ConcreteYul.writeWordMap concrete key value)
      (FullYul.writeValueMap symbolic
        (embedWordValue key) symbolicValue) := by
  intro query result hLookup
  by_cases hKey : norm key = norm query
  · have hResult : result = norm value := by
      simpa [ConcreteYul.writeWordMap, ConcreteYul.lookupWordMap?,
        norm_norm, hKey] using hLookup.symm
    have hEmbedKey : embedWordValue key = embedWordValue query := by
      simp [embedWordValue, hKey]
    refine ⟨symbolicValue, ?_, ?_⟩
    · change
        (if embedWordValue key = embedWordValue query then
          some symbolicValue
        else
          FullYul.lookupValueMap? symbolic (embedWordValue query)) =
            some symbolicValue
      rw [if_pos hEmbedKey]
    · rw [hResult]
      exact valueRel_norm_left hValue
  · have hLookupOld :
        ConcreteYul.lookupWordMap? concrete query = some result := by
      simpa [ConcreteYul.writeWordMap, ConcreteYul.lookupWordMap?,
        norm_norm, hKey] using hLookup
    rcases hRel query result hLookupOld with
      ⟨oldSymbolicValue, hOldLookup, hOldValue⟩
    have hEmbedNe : embedWordValue key ≠ embedWordValue query := by
      intro hEq
      apply hKey
      simpa [embedWordValue] using hEq
    refine ⟨oldSymbolicValue, ?_, hOldValue⟩
    change
      (if embedWordValue key = embedWordValue query then
        some symbolicValue
      else
        FullYul.lookupValueMap? symbolic (embedWordValue query)) =
          some oldSymbolicValue
    rw [if_neg hEmbedNe]
    exact hOldLookup

