theorem runtimeFunctionEnvCoveredSpec_declareFunction
    {spec : RuntimeCoverageSpec}
    {funcs : ConcreteYul.FunctionEnv}
    {fnName : FullYul.Name}
    {fn : ConcreteYul.FunctionDef}
    (hFuncs : RuntimeFunctionEnvCoveredSpec spec funcs)
    (hFn :
      RuntimeNamedStructuralFunctionBodyCoveredSpec spec fnName fn) :
    RuntimeFunctionEnvCoveredSpec spec
      (ConcreteYul.declareFunction funcs fnName fn) := by
  intro query args found hOK hLookup
  cases hExisting : ConcreteYul.lookupFunction? funcs fnName with
  | some existing =>
      exact hFuncs hOK
        (by
          simpa [ConcreteYul.declareFunction, hExisting] using hLookup)
  | none =>
      by_cases hName : fnName = query
      · subst query
        have hFound : found = fn := by
          simpa [ConcreteYul.declareFunction, hExisting,
            ConcreteYul.lookupFunction?] using hLookup.symm
        subst found
        exact hFn
      · exact hFuncs hOK
          (by
            simpa [ConcreteYul.declareFunction, hExisting,
              ConcreteYul.lookupFunction?, hName] using hLookup)

def RuntimeFunctionBodyCollectFunctionEnvRel
    (spec : RuntimeCoverageSpec) : Nat -> ConcreteYul.Stmt -> Prop :=
  fun minEmbedFuel stmt =>
    RuntimeFunctionBodyCoveredSpec spec minEmbedFuel stmt ∧
      ∀ {funcs : ConcreteYul.FunctionEnv},
        RuntimeFunctionEnvCoveredSpec spec funcs ->
          RuntimeFunctionEnvCoveredSpec spec
            (ConcreteYul.collectStmtFunctionDefs stmt funcs)

def runtimeFunctionBodyCollectFunctionEnvAlg
    {spec : RuntimeCoverageSpec} :
    RuntimeFunctionBodyCoveredAlg spec
      (RuntimeFunctionBodyCollectFunctionEnvRel spec) where
  stmt := fun {_stmt} hStmt =>
    ⟨ RuntimeFunctionBodyCoveredSpec.stmt hStmt
    , fun hFuncs =>
        runtimeFunctionEnvCoveredSpec_of_eq
          (collectStmtFunctionDefs_runtimeCoveredStmt_stable hStmt)
          hFuncs ⟩
  block := fun {_length} {_stmts} hBlock =>
    ⟨ RuntimeFunctionBodyCoveredSpec.block hBlock
    , fun hFuncs =>
        runtimeFunctionEnvCoveredSpec_of_eq
          (by simp [ConcreteYul.collectStmtFunctionDefs]) hFuncs ⟩
  funDef := fun {fnName} {params} {returns} {body} {bodyEmbedFuel}
      hBody hBodyEmbed =>
    ⟨ RuntimeFunctionBodyCoveredSpec.funDef hBody.1 hBodyEmbed
    , fun {funcs} hFuncs => by
        let fn : ConcreteYul.FunctionDef :=
          { params := params, returns := returns, body := body }
        change
          RuntimeFunctionEnvCoveredSpec spec
            (ConcreteYul.declareFunction funcs fnName fn)
        exact
          runtimeFunctionEnvCoveredSpec_declareFunction hFuncs
            (RuntimeNamedStructuralFunctionBodyCoveredSpec.intro
              bodyEmbedFuel
              (RuntimeStructuralBodyCoveredSpec.legacy hBody.1)
              (by simpa [fn] using hBodyEmbed)) ⟩
  seq := fun {_first} {_second} {_firstEmbedFuel} {_secondEmbedFuel}
      hFirst hSecond =>
    ⟨ RuntimeFunctionBodyCoveredSpec.seq hFirst.1 hSecond.1
    , fun hFuncs => hSecond.2 (hFirst.2 hFuncs) ⟩
  ifThen := fun {_cond} {_body} {_minBodyEmbedFuel} _hCond _hBody
      =>
    ⟨ RuntimeFunctionBodyCoveredSpec.ifThen _hCond _hBody.1
    , fun hFuncs =>
        runtimeFunctionEnvCoveredSpec_of_eq
          (by simp [ConcreteYul.collectStmtFunctionDefs]) hFuncs ⟩
  switch := fun {_discr} {_cases} {_defaultBranch} _hSwitch
      =>
    ⟨ RuntimeFunctionBodyCoveredSpec.switch _hSwitch
    , fun hFuncs =>
        runtimeFunctionEnvCoveredSpec_of_eq
          (by simp [ConcreteYul.collectStmtFunctionDefs]) hFuncs ⟩
  forLoop := fun {_pre} {_post} {_body} {_cond} {_preEmbedFuel}
      {_postEmbedFuel} {_bodyEmbedFuel} _hPre _hCond _hPost _hBody
      =>
    ⟨ RuntimeFunctionBodyCoveredSpec.forLoop _hPre.1 _hCond _hPost.1
        _hBody.1
    , fun hFuncs =>
        runtimeFunctionEnvCoveredSpec_of_eq
          (by simp [ConcreteYul.collectStmtFunctionDefs]) hFuncs ⟩

