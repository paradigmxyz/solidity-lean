theorem list_eq_singleton_of_length_eq_one {α : Type}
    {xs : List α} (hLen : xs.length = 1) :
    ∃ x, xs = [x] := by
  cases xs with
  | nil =>
      simp at hLen
  | cons x rest =>
      cases rest with
      | nil =>
          exact ⟨x, rfl⟩
      | cons _ rest =>
          simp at hLen

theorem list_eq_pair_of_length_eq_two {α : Type}
    {xs : List α} (hLen : xs.length = 2) :
    ∃ x y, xs = [x, y] := by
  cases xs with
  | nil =>
      simp at hLen
  | cons x rest =>
      cases rest with
      | nil =>
          simp at hLen
      | cons y rest =>
          cases rest with
          | nil =>
              exact ⟨x, y, rfl⟩
          | cons _ rest =>
              simp at hLen

theorem list_eq_triple_of_length_eq_three {α : Type}
    {xs : List α} (hLen : xs.length = 3) :
    ∃ x y z, xs = [x, y, z] := by
  cases xs with
  | nil =>
      simp at hLen
  | cons x rest =>
      cases rest with
      | nil =>
          simp at hLen
      | cons y rest =>
          cases rest with
          | nil =>
              simp at hLen
          | cons z rest =>
              cases rest with
              | nil =>
                  exact ⟨x, y, z, rfl⟩
              | cons _ rest =>
                  simp at hLen

