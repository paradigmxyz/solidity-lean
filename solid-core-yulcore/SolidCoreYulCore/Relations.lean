        , ConcreteYul.Expr.word size ]) := by
  intro hExact concreteValue concreteConfig' hConcrete
  have hConcreteExpected :=
    (evalRuntimeExpr_extcodecopy_memory_summary
      hash concreteConfig address dest offset size).1
  rw [hConcreteExpected] at hConcrete
  cases hConcrete
  by_cases hSize : norm size = 0
  · exact
      ⟨ embedWordValue 0
