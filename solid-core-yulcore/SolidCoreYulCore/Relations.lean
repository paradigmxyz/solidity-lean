noncomputable def RuntimeExprSim
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    (config : ConcreteYul.RuntimeConfig) (expr : ConcreteYul.Expr) : Prop :=
  ∀ concreteValue concreteConfig,
    ConcreteYul.evalRuntimeExpr hash expr config =
      some (concreteValue, concreteConfig) ->
    ∃ symbolicValue symbolicConfig,
      SymYul.guidedEvalExpr (embedRuntimeConfig config)
          (embedConcreteExpr expr) =
        some (symbolicValue, symbolicConfig) ∧
      ValueRel model concreteValue symbolicValue ∧
      RuntimeConfigRel model concreteConfig symbolicConfig

noncomputable def RuntimeExprsSim
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    (config : ConcreteYul.RuntimeConfig)
    (exprs : List ConcreteYul.Expr) : Prop :=
  ∀ concreteValues concreteConfig,
