inductive RuntimeCurrentSolidCoreWithMemoryBuiltinValueArgKinds :
    Evm.Builtin -> List ConcreteYul.Expr -> List RuntimeArgKind -> Prop where
  | current {builtin : Evm.Builtin} {args : List ConcreteYul.Expr}
      {kinds : List RuntimeArgKind} :
      RuntimeCurrentSolidCoreBuiltinValueArgKinds builtin args kinds ->
        RuntimeCurrentSolidCoreWithMemoryBuiltinValueArgKinds
          builtin args kinds
  | memory {builtin : Evm.Builtin} {args : List ConcreteYul.Expr}
      {kinds : List RuntimeArgKind} :
      RuntimeMemoryBuiltinValueArgKinds builtin args kinds ->
        RuntimeCurrentSolidCoreWithMemoryBuiltinValueArgKinds
