                    symbolicConfig.evm.memoryBytes (norm dest)
                    (FullYul.SymbolicBytes.extcodeSlice
                      (norm address) (norm offset) (norm size)) }
              (norm dest) (norm size) }
      , by
          simp [SymYul.guidedEvalExpr, SymYul.guidedEvalExprs,
