def pureBinarySymbolicResult
    (builtin : Evm.Builtin) (lhs rhs : FullYul.Value) : FullYul.Value :=
  match lhs, rhs with
  | FullYul.Value.word lhsWord, FullYul.Value.word rhsWord =>
      embedWordValue (evalPureBinaryWordBuiltin builtin lhsWord rhsWord)
  | _, _ => FullYul.Value.binaryBuiltin builtin lhs rhs

def pureEqSymbolicResult
    (lhs rhs : FullYul.Value) : FullYul.Value :=
  if lhs = rhs then
    FullYul.Value.word 1
  else
    match lhs, rhs with
    | FullYul.Value.word lhsWord, FullYul.Value.word rhsWord =>
        FullYul.Value.word (eqWord lhsWord rhsWord)
    | _, _ => FullYul.Value.binaryBuiltin Evm.Builtin.eqOp lhs rhs

def pureUnarySymbolicResult
    (builtin : Evm.Builtin) (value : FullYul.Value) : FullYul.Value :=
  match value with
  | FullYul.Value.word word =>
      embedWordValue (evalPureUnaryWordBuiltin builtin word)
  | _ => FullYul.Value.unaryBuiltin builtin value

def pureTernarySymbolicResult
    (builtin : Evm.Builtin) (first second third : FullYul.Value) :
    FullYul.Value :=
  match first, second, third with
  | FullYul.Value.word firstWord, FullYul.Value.word secondWord,
      FullYul.Value.word thirdWord =>
      embedWordValue
        (evalPureTernaryWordBuiltin builtin firstWord secondWord thirdWord)
  | _, _, _ => FullYul.Value.ternaryBuiltin builtin first second third

theorem full_evalEvmBuiltin_unary_pureWord_valueRel
    {model : SymYul.ConcreteModel}
    (hModel : RuntimePureWordModelSpec model)
    (builtin : Evm.Builtin)
    (hFullEval :
      ∀ state symbolicValue,
        FullYul.evalEvmBuiltin builtin [symbolicValue] state =
          match symbolicValue with
          | FullYul.Value.word word =>
              some
                ( FullYul.Value.word
                    (evalPureUnaryWordBuiltin builtin word)
                , state )
          | _ =>
              some (FullYul.Value.unaryBuiltin builtin symbolicValue, state))
    (state : FullYul.EvmState)
    {value : Word} {symbolicValue : FullYul.Value}
    (hValue : ValueRel model value symbolicValue) :
    ∃ result,
      FullYul.evalEvmBuiltin builtin [symbolicValue] state =
        some (result, state) ∧
      ValueRel model (evalPureUnaryWordBuiltin builtin value) result := by
  refine
    ⟨ pureUnarySymbolicResult builtin symbolicValue
    , ?_
    , ?_ ⟩
  · rw [hFullEval]
    cases symbolicValue <;>
      simp [pureUnarySymbolicResult, embedWordValue,
        norm_evalPureUnaryWordBuiltin]
  · cases symbolicValue
    · exact valueRel_evalPureUnaryWordBuiltin_word builtin hValue
    all_goals
      exact valueRel_unaryBuiltin_of_pureWordModel hModel builtin hValue

theorem full_evalEvmBuiltin_binary_pureWord_valueRel
    {model : SymYul.ConcreteModel}
    (hModel : RuntimePureWordModelSpec model)
    (builtin : Evm.Builtin)
    (hFullEval :
      ∀ state lhs rhs,
        FullYul.evalEvmBuiltin builtin [lhs, rhs] state =
          match lhs, rhs with
          | FullYul.Value.word lhsWord, FullYul.Value.word rhsWord =>
              some
                ( FullYul.Value.word
                    (evalPureBinaryWordBuiltin builtin lhsWord rhsWord)
                , state )
          | _, _ =>
              some (FullYul.Value.binaryBuiltin builtin lhs rhs, state))
    (state : FullYul.EvmState)
    {lhsValue rhsValue : Word}
    {symbolicLhs symbolicRhs : FullYul.Value}
    (hLhs : ValueRel model lhsValue symbolicLhs)
    (hRhs : ValueRel model rhsValue symbolicRhs) :
    ∃ result,
      FullYul.evalEvmBuiltin builtin [symbolicLhs, symbolicRhs] state =
        some (result, state) ∧
      ValueRel model
        (evalPureBinaryWordBuiltin builtin lhsValue rhsValue)
        result := by
  refine
    ⟨ pureBinarySymbolicResult builtin symbolicLhs symbolicRhs
    , ?_
    , ?_ ⟩
  · rw [hFullEval]
    cases symbolicLhs <;> cases symbolicRhs <;>
      simp [pureBinarySymbolicResult, embedWordValue,
        norm_evalPureBinaryWordBuiltin]
  · cases symbolicLhs <;> cases symbolicRhs
    · exact valueRel_evalPureBinaryWordBuiltin_word builtin hLhs hRhs
    all_goals
      exact
        valueRel_binaryBuiltin_of_pureWordModel hModel builtin hLhs hRhs

theorem valueRel_eqWord_same_symbolic
    {model : SymYul.ConcreteModel}
    {lhsValue rhsValue : Word}
    {symbolicLhs symbolicRhs : FullYul.Value}
    (hLhs : ValueRel model lhsValue symbolicLhs)
    (hRhs : ValueRel model rhsValue symbolicRhs)
    (hEq : symbolicLhs = symbolicRhs) :
    ValueRel model
      (evalPureBinaryWordBuiltin Evm.Builtin.eqOp lhsValue rhsValue)
      (FullYul.Value.word 1) := by
  have hNorms : norm lhsValue = norm rhsValue := by
    unfold ValueRel at hLhs hRhs
    calc
      norm lhsValue = SymYul.interpValue model symbolicLhs := hLhs
      _ = SymYul.interpValue model symbolicRhs := by rw [hEq]
      _ = norm rhsValue := hRhs.symm
  unfold ValueRel SymYul.interpValue
  change norm (eqWord lhsValue rhsValue) = norm 1
  unfold eqWord
  rw [if_pos hNorms]

theorem full_evalEvmBuiltin_eq_valueRel
    {model : SymYul.ConcreteModel}
    (hModel : RuntimePureWordModelSpec model)
    (state : FullYul.EvmState)
    {lhsValue rhsValue : Word}
    {symbolicLhs symbolicRhs : FullYul.Value}
    (hLhs : ValueRel model lhsValue symbolicLhs)
    (hRhs : ValueRel model rhsValue symbolicRhs) :
    ∃ result,
      FullYul.evalEvmBuiltin Evm.Builtin.eqOp
          [symbolicLhs, symbolicRhs] state =
        some (result, state) ∧
      ValueRel model
        (evalPureBinaryWordBuiltin Evm.Builtin.eqOp lhsValue rhsValue)
        result := by
  refine ⟨pureEqSymbolicResult symbolicLhs symbolicRhs, ?_, ?_⟩
  · rw [FullYul.evalEvmBuiltin_eq_values]
    unfold pureEqSymbolicResult
    by_cases hEq : symbolicLhs = symbolicRhs
    · subst symbolicRhs
      cases symbolicLhs <;>
        simp [eqWord]
    · cases symbolicLhs <;> cases symbolicRhs <;>
        simp [hEq, eqWord]
  · unfold pureEqSymbolicResult
    by_cases hEq : symbolicLhs = symbolicRhs
    · subst symbolicRhs
      simpa [norm, wordModulus] using
        valueRel_eqWord_same_symbolic hLhs hRhs rfl
    · cases symbolicLhs <;> cases symbolicRhs
      · simpa [hEq, embedWordValue, evalPureBinaryWordBuiltin,
          norm_eqWord] using
          valueRel_evalPureBinaryWordBuiltin_word Evm.Builtin.eqOp hLhs hRhs
      · simpa [hEq] using
          valueRel_binaryBuiltin_of_pureWordModel hModel Evm.Builtin.eqOp
            hLhs hRhs
      all_goals
        simpa [hEq] using
          valueRel_binaryBuiltin_of_pureWordModel hModel Evm.Builtin.eqOp
            hLhs hRhs

theorem full_evalEvmBuiltin_ternary_pureWord_valueRel
    {model : SymYul.ConcreteModel}
    (hModel : RuntimePureWordModelSpec model)
    (builtin : Evm.Builtin)
    (hFullEval :
      ∀ state symbolicFirst symbolicSecond symbolicThird,
        FullYul.evalEvmBuiltin builtin
            [symbolicFirst, symbolicSecond, symbolicThird] state =
          match symbolicFirst, symbolicSecond, symbolicThird with
