theorem runtimeStmtFuelExactRelSim_block_of_structural_block_covered_provider_fuel_upTo
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    {fuel embedFuel blockEmbedFuel maxFunctionFuel : Nat}
    {spec : RuntimeCoverageSpec}
