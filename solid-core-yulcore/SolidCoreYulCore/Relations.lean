theorem evalRuntimeExprsAsYulValues_single_nonbuiltin_eq_evalRuntimeExprs
    (hash : ConcreteYul.HashOracle) (config : ConcreteYul.RuntimeConfig)
    {expr : ConcreteYul.Expr}
    (hNotBuiltin :
      ∀ builtin args, expr ≠ ConcreteYul.Expr.builtin builtin args) :
    ConcreteYul.evalRuntimeExprsAsYulValues hash [expr] config =
