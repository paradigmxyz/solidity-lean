theorem runtimeExprsSim_nil
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    (config : ConcreteYul.RuntimeConfig) :
    RuntimeExprsSim model hash config [] := by
  rcases evalRuntimeExprs_nil_refines_guided hash config with
    ⟨hConcrete, hGuided⟩
  exact runtimeExprsSim_of_embedRuntimeExprs hConcrete hGuided

theorem runtimeExprsRelSim_nil
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    (concreteConfig : ConcreteYul.RuntimeConfig)
    (symbolicConfig : SymYul.GuidedConfig) :
    RuntimeExprsRelSim model hash concreteConfig symbolicConfig [] := by
  intro hRel concreteValues concreteConfig' hConcrete
  simp [ConcreteYul.evalRuntimeExprs] at hConcrete
  rcases hConcrete with ⟨hValues, hConfig⟩
  cases hValues
  cases hConfig
  exact
    ⟨ []
    , symbolicConfig
    , by simp [SymYul.guidedEvalExprs, embedConcreteExprs]
    , trivial
    , hRel ⟩

theorem runtimeExprsSim_single_of_expr
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    {config : ConcreteYul.RuntimeConfig} {expr : ConcreteYul.Expr}
    (hExpr : RuntimeExprSim model hash config expr) :
    RuntimeExprsSim model hash config [expr] := by
  intro concreteValues concreteConfig hConcrete
  cases hEval : ConcreteYul.evalRuntimeExpr hash expr config with
  | none =>
      simp [ConcreteYul.evalRuntimeExprs, hEval] at hConcrete
  | some exprResult =>
      cases exprResult with
      | mk value config' =>
          simp [ConcreteYul.evalRuntimeExprs, hEval] at hConcrete
          rcases hConcrete with ⟨hValues, hConfig⟩
          subst concreteValues
          subst concreteConfig
          rcases hExpr value config' hEval with
            ⟨symbolicValue, symbolicConfig, hGuidedExpr, hValueRel,
              hConfigRel⟩
          exact
            ⟨ [symbolicValue]
            , symbolicConfig
            , by
                simp [SymYul.guidedEvalExprs, embedConcreteExprs,
                  hGuidedExpr]
            , by simp [WordListRel, hValueRel]
            , hConfigRel ⟩

theorem runtimeExprsRelSim_single_of_expr
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
