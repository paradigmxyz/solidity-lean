noncomputable def RuntimeExprReadValueExactRelSim
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    (concreteConfig : ConcreteYul.RuntimeConfig)
    (symbolicConfig : SymYul.GuidedConfig)
    (expr : ConcreteYul.Expr) : Prop :=
  RuntimeConfigReadValueExactRel model concreteConfig symbolicConfig ->
    ∀ concreteValue concreteConfig',
      ConcreteYul.evalRuntimeExpr hash expr concreteConfig =
        some (concreteValue, concreteConfig') ->
      ∃ symbolicValue symbolicConfig',
        SymYul.guidedEvalExpr symbolicConfig
            (embedConcreteExpr expr) =
          some (symbolicValue, symbolicConfig') ∧
        ValueRel model concreteValue symbolicValue ∧
        RuntimeConfigReadValueExactRel model concreteConfig' symbolicConfig'

