    embedWordValue, norm_norm]

theorem lookupAccountWordEntries?_norm_address
    (accounts : ConcreteYul.AccountWordMap) (address : Word) :
    ConcreteYul.lookupAccountWordEntries? accounts (norm address) =
      ConcreteYul.lookupAccountWordEntries? accounts address := by
  induction accounts with
  | nil =>
      rfl
  | cons entry rest ih =>
      cases entry with
      | mk candidate entries =>
          change
            (if norm candidate = norm (norm address) then
                some entries
              else
                ConcreteYul.lookupAccountWordEntries? rest (norm address)) =
            (if norm candidate = norm address then
                some entries
              else
                ConcreteYul.lookupAccountWordEntries? rest address)
          rw [norm_norm address]
          by_cases h : norm candidate = norm address
          · simp [h]
          · simp [h, ih]

theorem lookupAccountWordEntries?_eq_of_norm
    (accounts : ConcreteYul.AccountWordMap) {left right : Word}
    (hAddress : norm left = norm right) :
    ConcreteYul.lookupAccountWordEntries? accounts left =
      ConcreteYul.lookupAccountWordEntries? accounts right := by
  induction accounts with
  | nil =>
      rfl
  | cons entry rest ih =>
      cases entry with
      | mk candidate entries =>
          change
            (if norm candidate = norm left then
                some entries
              else
                ConcreteYul.lookupAccountWordEntries? rest left) =
            (if norm candidate = norm right then
                some entries
              else
                ConcreteYul.lookupAccountWordEntries? rest right)
          by_cases h : norm candidate = norm left
          · simp [h, hAddress]
          · have h' : norm candidate ≠ norm right := by
              intro hRight
              apply h
              rw [hAddress]
              exact hRight
            simp [h, h', ih]

theorem lookupAccountValueEntries?_eq_of_norm
    (accounts : FullYul.AccountValueMap) {left right : Word}
    (hAddress : norm left = norm right) :
    FullYul.lookupAccountValueEntries? accounts left =
      FullYul.lookupAccountValueEntries? accounts right := by
  induction accounts with
  | nil =>
      rfl
  | cons entry rest ih =>
      cases entry with
      | mk candidate entries =>
