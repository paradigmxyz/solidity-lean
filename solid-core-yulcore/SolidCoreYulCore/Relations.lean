theorem runtimeSwitchCoveredSpec_target_guided_at
    (model : SymYul.ConcreteModel)
    {spec : RuntimeCoverageSpec} {switchEmbedFuel : Nat}
    {discr : ConcreteYul.Expr} {value : Word}
    {cases : List (Word × ConcreteYul.Stmt)}
    {defaultBranch : Option ConcreteYul.Stmt}
    {target : ConcreteYul.Stmt}
    (hSwitch : RuntimeSwitchCoveredSpec spec discr cases defaultBranch)
    (hSwitchEmbedFuel : cases.length + 2 ≤ switchEmbedFuel)
    (hTarget :
      ConcreteYul.switchTarget? value cases defaultBranch = some target) :
    ∃ targetEmbedFuel,
      2 ≤ targetEmbedFuel ∧
      RuntimeCoveredStmtSpec spec target ∧
      ∀ symbolicValue,
        ValueRel model value symbolicValue ->
        SymYul.guidedSwitchTarget? model symbolicValue
            (embedConcreteSwitchCasesFuel switchEmbedFuel cases)
            (defaultBranch.map (embedConcreteStmtFuel switchEmbedFuel)) =
          some (embedConcreteStmtFuel targetEmbedFuel target) := by
  have hDefaultFuel : 2 ≤ switchEmbedFuel :=
    Nat.le_trans (Nat.le_add_left 2 cases.length) hSwitchEmbedFuel
  have hSwitchEmbedFuelEq :
      switchEmbedFuel =
        cases.length + (switchEmbedFuel - (cases.length + 2)) + 2 := by
    calc
      switchEmbedFuel =
          (switchEmbedFuel - (cases.length + 2)) +
            (cases.length + 2) :=
        (Nat.sub_add_cancel hSwitchEmbedFuel).symm
      _ =
          cases.length + (switchEmbedFuel - (cases.length + 2)) + 2 := by
        simp [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm]
  rcases
      guidedSwitchTarget_rel_of_concrete_some_positional
        model (switchEmbedFuel - (cases.length + 2)) switchEmbedFuel
        hDefaultFuel hTarget with
    ⟨targetEmbedFuel, hTargetEmbedFuel, hGuidedTarget⟩
  exact
    ⟨ targetEmbedFuel
    , hTargetEmbedFuel
    , runtimeSwitchCoveredSpec_target hSwitch hTarget
    , by
        intro symbolicValue hValueRel
        have hGuided := hGuidedTarget symbolicValue hValueRel
        rw [← hSwitchEmbedFuelEq] at hGuided
        exact hGuided ⟩

theorem runtimeStmtFuelSim_switch_of_expr_target_success
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
