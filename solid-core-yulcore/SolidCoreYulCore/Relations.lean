    simp only [norm_norm, hZero]
    rfl
  constructor
  · simp [ConcreteYul.evalRuntimeStmtFuel, hConcreteCond, hZero]
  · cases fuel <;>
      simp [SymYul.guidedEvalStmtFuel, embedConcreteStmt,
        embedConcreteStmtFuel, hGuidedCond, hBool, embedRuntimeResult,
        ConcreteYul.runtimeNormalResult, SymYul.guidedNormalResult,
        embedCompleteFlow]

private theorem evalRuntimeStmt_ifThen_true_refines_guided_of_cond_body
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    (fuel : Nat) {config config' : ConcreteYul.RuntimeConfig}
    {cond : ConcreteYul.Expr} {body : ConcreteYul.Stmt} {value : Word}
    {result : ConcreteYul.RuntimeResult}
    (hConcreteCond :
      ConcreteYul.evalRuntimeExpr hash cond config = some (value, config'))
    (hGuidedCond :
      SymYul.guidedEvalExpr (embedRuntimeConfig config)
          (embedConcreteExpr cond) =
        some (embedWordValue value, embedRuntimeConfig config'))
    (hNonzero : norm value ≠ 0)
    (hConcreteBody :
      ConcreteYul.evalRuntimeStmtFuel hash fuel config' body = some result)
    (hGuidedBody :
      SymYul.guidedEvalStmtFuel model fuel (embedRuntimeConfig config')
          (embedConcreteStmtFuel
            (sizeOf (ConcreteYul.Stmt.ifThen cond body)) body) =
        some (embedRuntimeResult result)) :
    ConcreteYul.evalRuntimeStmtFuel hash fuel.succ config
        (ConcreteYul.Stmt.ifThen cond body) =
      some result ∧
    SymYul.guidedEvalStmtFuel model fuel.succ (embedRuntimeConfig config)
        (embedConcreteStmt (ConcreteYul.Stmt.ifThen cond body)) =
