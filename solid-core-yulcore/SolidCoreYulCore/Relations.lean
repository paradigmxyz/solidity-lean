    {model : SymYul.ConcreteModel} {hash : ConcreteYul.HashOracle}
    {DataOffsetOK : FullYul.DataLabel -> Prop}
    {BuiltinExprOK BuiltinValuesOK :
      Evm.Builtin -> List ConcreteYul.Expr -> Prop}
    (dispatcher :
      RuntimePrimitiveDispatcherExact model hash DataOffsetOK
        BuiltinExprOK BuiltinValuesOK) :
    RuntimePrimitiveDispatcherOf
      (RuntimeExprExactRelSim model hash)
      (RuntimeExprsExactRelSim model hash)
      (RuntimeExprsAsYulValuesExactRelSim model hash)
      DataOffsetOK BuiltinExprOK BuiltinValuesOK where
  dataOffset hOK := dispatcher.dataOffset hOK
  builtinExpr hOK hArgs := dispatcher.builtinExpr hOK hArgs
  builtinValues hOK hArgs := dispatcher.builtinValues hOK hArgs

