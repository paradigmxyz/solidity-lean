private theorem runtimeStmtFuelExactRelSim_forLoop_of_pre_exact_loop_inner
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    (fuel embedFuel : Nat)
    {concreteConfig : ConcreteYul.RuntimeConfig}
    {symbolicConfig : SymYul.GuidedConfig}
    {pre post body : ConcreteYul.Stmt} {cond : ConcreteYul.Expr}
    (hPreExact :
      RuntimeStmtFuelExactRelSim model hash fuel embedFuel concreteConfig
        symbolicConfig pre)
    (hLoop :
      ∀ {loopConfig : ConcreteYul.RuntimeConfig}
        {symbolicLoopConfig : SymYul.GuidedConfig},
        RuntimeConfigExactRel model loopConfig symbolicLoopConfig ->
        RuntimeForFuelExactRelSim model hash fuel embedFuel concreteConfig
          loopConfig symbolicConfig symbolicLoopConfig cond post body) :
    RuntimeStmtFuelExactRelSim model hash fuel.succ embedFuel.succ
      concreteConfig symbolicConfig
      (ConcreteYul.Stmt.forLoop pre cond post body) := by
  intro hInputExact concreteResult hConcreteResult
  cases hConcretePre :
      ConcreteYul.evalRuntimeStmtFuel hash fuel concreteConfig pre with
  | none =>
      simp [ConcreteYul.evalRuntimeStmtFuel, hConcretePre] at hConcreteResult
  | some preResult =>
      by_cases hNormal :
          preResult.flow = ConcreteYul.CompleteFlow.normal
      · rcases preResult with ⟨preFlow, loopConfig⟩
        cases hNormal
        have hConcretePreNormal :
            ConcreteYul.evalRuntimeStmtFuel hash fuel concreteConfig pre =
              some (ConcreteYul.runtimeNormalResult loopConfig) := by
          simpa [ConcreteYul.runtimeNormalResult] using hConcretePre
        have hConcreteLoop :
            ConcreteYul.evalRuntimeForFuel hash fuel concreteConfig
                loopConfig cond post body =
              some concreteResult := by
          simpa [ConcreteYul.evalRuntimeStmtFuel, hConcretePreNormal,
            ConcreteYul.runtimeNormalResult] using hConcreteResult
        rcases hPreExact hInputExact
            (ConcreteYul.runtimeNormalResult loopConfig)
            hConcretePreNormal with
          ⟨symbolicPreResult, hGuidedPre, hPreExactResult⟩
        rcases symbolicPreResult with
          ⟨symbolicPreFlow, symbolicLoopConfig⟩
        have hPreFlow :
            symbolicPreFlow = FullYul.Flow.normal := by
          simpa [ConcreteYul.runtimeNormalResult, embedCompleteFlow] using
            hPreExactResult.rel.flowRel
        subst symbolicPreFlow
        have hLoopSim := hLoop hPreExactResult.configExact
        rcases hLoopSim hInputExact hPreExactResult.configExact
            concreteResult hConcreteLoop with
          ⟨symbolicResult, hGuidedLoop, hResultExact⟩
        exact
          ⟨ symbolicResult
          , by
              cases fuel with
              | zero =>
                  simp [ConcreteYul.evalRuntimeStmtFuel] at hConcretePreNormal
              | succ fuel =>
                  simp [SymYul.guidedEvalStmtFuel,
                    embedConcreteStmtFuel, hGuidedPre, hGuidedLoop]
          , hResultExact ⟩
      · have hRestore :
            ConcreteYul.withRestoredRuntimeConfig concreteConfig
                preResult =
              some concreteResult :=
          evalRuntimeStmtFuel_forLoop_pre_non_normal_restore
            hNormal hConcretePre hConcreteResult
        rcases hPreExact hInputExact preResult hConcretePre with
          ⟨symbolicPreResult, hGuidedPre, hPreExactResult⟩
        rcases runtimeResultExactRel_withRestoredRuntimeConfig
            hInputExact hPreExactResult hRestore with
          ⟨symbolicRestored, hGuidedRestore, hRestoredExact⟩
        have hSymbolicFlow :
            symbolicPreResult.flow ≠ FullYul.Flow.normal :=
          hPreExactResult.rel.symbolic_flow_ne_normal hNormal
        exact
          ⟨ symbolicRestored
          , SymYul.guidedEvalStmtFuel_forLoop_pre_non_normal_restore
              hSymbolicFlow hGuidedPre hGuidedRestore
          , hRestoredExact ⟩

theorem runtimeStmtFuelExactRelSim_funDef_named_ge
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    {fuel embedFuel : Nat}
    {concreteConfig : ConcreteYul.RuntimeConfig}
    {symbolicConfig : SymYul.GuidedConfig}
    (fnName : FullYul.Name) (params returns : List FullYul.Name)
    (body : ConcreteYul.Stmt)
    (hEmbedFuel :
      sizeOf (ConcreteYul.Stmt.funDef fnName params returns body) + 1 ≤
        embedFuel) :
    RuntimeStmtFuelExactRelSim model hash fuel embedFuel concreteConfig
      symbolicConfig
      (ConcreteYul.Stmt.funDef fnName params returns body) := by
  cases fuel with
  | zero =>
      exact
        runtimeStmtFuelExactRelSim_of_concrete_none
          (by simp [ConcreteYul.evalRuntimeStmtFuel])
  | succ fuel =>
      cases embedFuel with
      | zero =>
          cases hEmbedFuel
      | succ bodyEmbedFuel =>
          intro hInputExact concreteResult hConcreteResult
          simp [ConcreteYul.evalRuntimeStmtFuel,
            ConcreteYul.runtimeNormalResult] at hConcreteResult
          cases hConcreteResult
          let fn : ConcreteYul.FunctionDef :=
            { params := params, returns := returns, body := body }
          let symbolicConfig' : SymYul.GuidedConfig :=
            { symbolicConfig with
              funcs :=
                SymYul.declareFunction symbolicConfig.funcs fnName
                  { params := params
                    returns := returns
                    body := embedConcreteStmtFuel bodyEmbedFuel body } }
          have hCanonicalLe :
              sizeOf (ConcreteYul.Stmt.funDef fnName params returns body) ≤
                bodyEmbedFuel :=
            Nat.succ_le_succ_iff.mp
              (by
                simpa [Nat.succ_eq_add_one] using hEmbedFuel)
          have hBodyLtCanonical :
              sizeOf body <
                sizeOf (ConcreteYul.Stmt.funDef fnName params returns body) := by
            simp
            omega
          have hBodyStable :
              embedConcreteStmtFuel bodyEmbedFuel body =
                (embedConcreteNamedFunctionDef fnName fn).body := by
            dsimp [embedConcreteNamedFunctionDef, fn]
            exact
              embedConcreteStmtFuel_eq_of_size_lt body
                (Nat.lt_of_lt_of_le hBodyLtCanonical hCanonicalLe)
                hBodyLtCanonical
          have hDeclareRel :
              SymYul.declareFunction symbolicConfig.funcs fnName
                  { params := params
                    returns := returns
                    body := embedConcreteStmtFuel bodyEmbedFuel body } =
                embedConcreteFunctionEnv
                  (ConcreteYul.declareFunction concreteConfig.funcs fnName
                    fn) := by
            calc
              SymYul.declareFunction symbolicConfig.funcs fnName
                  { params := params
                    returns := returns
                    body := embedConcreteStmtFuel bodyEmbedFuel body } =
                  SymYul.declareFunction
                    (embedConcreteFunctionEnv concreteConfig.funcs)
                    fnName
                    { params := params
                      returns := returns
                      body := embedConcreteStmtFuel bodyEmbedFuel body } := by
                    rw [hInputExact.rel.funcsRel]
              _ = SymYul.declareFunction
                    (embedConcreteFunctionEnv concreteConfig.funcs)
                    fnName (embedConcreteNamedFunctionDef fnName fn) := by
                    simp [embedConcreteNamedFunctionDef, fn, hBodyStable]
              _ = embedConcreteFunctionEnv
                    (ConcreteYul.declareFunction concreteConfig.funcs
                      fnName fn) := by
                    exact
                      (embedConcreteFunctionEnv_declareFunction
                        concreteConfig.funcs fnName fn).symm
          have hConfigExact :
              RuntimeConfigExactRel model
                { concreteConfig with
                  funcs :=
                    ConcreteYul.declareFunction concreteConfig.funcs
                      fnName fn }
                symbolicConfig' := by
            constructor
            · constructor
              · exact hInputExact.rel.envRel
              · exact hInputExact.rel.evmRel
              · exact hDeclareRel
              · exact hInputExact.rel.objectRel
            · exact hInputExact.envExact
          exact
            ⟨ SymYul.guidedNormalResult symbolicConfig'
            , by
                simp [SymYul.guidedEvalStmtFuel, embedConcreteStmtFuel,
                  SymYul.guidedNormalResult, symbolicConfig']
            , by
                simpa [ConcreteYul.runtimeNormalResult,
                  SymYul.guidedNormalResult, symbolicConfig'] using
                    runtimeResultExactRel_of_runtimeConfigExactRel
                      ConcreteYul.CompleteFlow.normal hConfigExact ⟩

