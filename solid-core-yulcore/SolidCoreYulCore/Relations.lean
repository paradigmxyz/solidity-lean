    SymYul.guidedEvalStmtFuel model fuel.succ (embedRuntimeConfig config)
        (embedConcreteStmt (ConcreteYul.Stmt.ifThen cond body)) =
      some (embedRuntimeResult (ConcreteYul.runtimeNormalResult config')) := by
  have hBool : SymYul.guidedBool model (embedWordValue value) = false := by
