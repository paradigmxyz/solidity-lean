theorem valueRel_evalPureUnaryWordBuiltin_word
    {model : SymYul.ConcreteModel}
    (builtin : Evm.Builtin)
    {concrete symbolicWord : Word}
    (hRel : ValueRel model concrete (FullYul.Value.word symbolicWord)) :
    ValueRel model (evalPureUnaryWordBuiltin builtin concrete)
      (embedWordValue
        (evalPureUnaryWordBuiltin builtin symbolicWord)) := by
  unfold ValueRel at hRel ⊢
  simp [embedWordValue, SymYul.interpValue] at hRel ⊢
  rw [← evalPureUnaryWordBuiltin_norm_arg builtin concrete]
  rw [← evalPureUnaryWordBuiltin_norm_arg builtin symbolicWord]
  rw [hRel]
  rw [norm_norm]

theorem valueRel_evalPureBinaryWordBuiltin_word
    {model : SymYul.ConcreteModel}
    (builtin : Evm.Builtin)
    {concreteLhs concreteRhs symbolicLhs symbolicRhs : Word}
    (hLhs :
      ValueRel model concreteLhs (FullYul.Value.word symbolicLhs))
    (hRhs :
      ValueRel model concreteRhs (FullYul.Value.word symbolicRhs)) :
    ValueRel model
      (evalPureBinaryWordBuiltin builtin concreteLhs concreteRhs)
      (embedWordValue
        (evalPureBinaryWordBuiltin builtin symbolicLhs symbolicRhs)) := by
  unfold ValueRel at hLhs hRhs ⊢
  simp [embedWordValue, SymYul.interpValue] at hLhs hRhs ⊢
  rw [← evalPureBinaryWordBuiltin_norm_args
    builtin concreteLhs concreteRhs]
  rw [← evalPureBinaryWordBuiltin_norm_args
    builtin symbolicLhs symbolicRhs]
  rw [hLhs, hRhs]
  rw [norm_norm]

theorem valueRel_evalPureTernaryWordBuiltin_word
    {model : SymYul.ConcreteModel}
    (builtin : Evm.Builtin)
    {concreteFirst concreteSecond concreteThird
      symbolicFirst symbolicSecond symbolicThird : Word}
    (hFirst :
      ValueRel model concreteFirst (FullYul.Value.word symbolicFirst))
    (hSecond :
      ValueRel model concreteSecond (FullYul.Value.word symbolicSecond))
    (hThird :
      ValueRel model concreteThird (FullYul.Value.word symbolicThird)) :
    ValueRel model
      (evalPureTernaryWordBuiltin builtin concreteFirst concreteSecond
        concreteThird)
      (embedWordValue
        (evalPureTernaryWordBuiltin builtin symbolicFirst symbolicSecond
          symbolicThird)) := by
  unfold ValueRel at hFirst hSecond hThird ⊢
  simp [embedWordValue, SymYul.interpValue] at hFirst hSecond hThird ⊢
  rw [← evalPureTernaryWordBuiltin_norm_args
    builtin concreteFirst concreteSecond concreteThird]
  rw [← evalPureTernaryWordBuiltin_norm_args
    builtin symbolicFirst symbolicSecond symbolicThird]
  rw [hFirst, hSecond, hThird]
  rw [norm_norm]

theorem RuntimePureWordModelSpec.pureWordConcreteModel :
    RuntimePureWordModelSpec pureWordConcreteModel where
  unary builtin value := by
    change
      norm (evalPureUnaryWordBuiltin builtin (norm value)) =
        norm (evalPureUnaryWordBuiltin builtin value)
    cases builtin <;>
      simp [evalPureUnaryWordBuiltin, iszeroWord_norm_arg,
        notWord_norm_arg, clzWord_norm_arg]
  binary builtin lhs rhs := by
    change
      norm (evalPureBinaryWordBuiltin builtin (norm lhs) (norm rhs)) =
        norm (evalPureBinaryWordBuiltin builtin lhs rhs)
    cases builtin <;>
      simp [evalPureBinaryWordBuiltin, addWord_norm_args,
        mulWord_norm_args, divWord_norm_args, sdivWord_norm_args,
        modWord_norm_args, smodWord_norm_args, expWord_norm_args,
        subWord_norm_args, eqWord_norm_args, ltWord_norm_args,
        gtWord_norm_args, sltWord_norm_args, sgtWord_norm_args,
        andWord_norm_args, orWord_norm_args, xorWord_norm_args,
        shlWord_norm_args, shrWord_norm_args, sarWord_norm_args,
        signextendWord_norm_args, byteWord_norm_args]
  ternary builtin first second third := by
    change
      norm
          (evalPureTernaryWordBuiltin builtin (norm first) (norm second)
            (norm third)) =
        norm (evalPureTernaryWordBuiltin builtin first second third)
    cases builtin <;>
      simp [evalPureTernaryWordBuiltin, addmodWord_norm_args,
        mulmodWord_norm_args]

