      simp [hConcreteEnv] at hConcrete
      cases hConcrete
      rcases envExactRel_restoreOuter hOuter.envExact hInner.envExact
          hConcreteEnv with
        ⟨symbolicRestoredEnv, hSymbolicEnv, hEnvExact⟩
