theorem runtimeStructuralBlockCoveredSpec_mono
    {spec : RuntimeCoverageSpec}
    {oldEmbedFuel newEmbedFuel : Nat}
    {stmts : List ConcreteYul.Stmt}
    (hCovered :
      RuntimeStructuralBlockCoveredSpec spec oldEmbedFuel stmts)
    (hLe : oldEmbedFuel ≤ newEmbedFuel) :
    RuntimeStructuralBlockCoveredSpec spec newEmbedFuel stmts := by
  cases hCovered with
  | nil =>
      exact RuntimeStructuralBlockCoveredSpec.nil
  | cons hStmt hStmtEmbed hRest =>
      cases newEmbedFuel with
      | zero =>
          cases hLe
      | succ newEmbedFuel =>
          have hInnerLe : _ ≤ newEmbedFuel :=
            Nat.succ_le_succ_iff.mp hLe
          exact
            RuntimeStructuralBlockCoveredSpec.cons hStmt
              (Nat.le_trans hStmtEmbed hInnerLe)
              (runtimeStructuralBlockCoveredSpec_mono hRest hInnerLe)
end

