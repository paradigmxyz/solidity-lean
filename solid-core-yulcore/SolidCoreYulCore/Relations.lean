      SymYul.guidedEvalFunctionFuel model fuel
          { env := embedConcreteEnv config'.env
            evm := embedConcreteState config'.state
            funcs := embedConcreteFunctionEnv config'.funcs
            object? := some (embedConcreteObject config'.object) }
          fnName (argValues.map embedWordValue) =
        some
          ( returnValues.map embedWordValue
          , { env := embedConcreteEnv config''.env
              evm := embedConcreteState config''.state
              funcs := embedConcreteFunctionEnv config''.funcs
              object? := some (embedConcreteObject config''.object) } ) := by
    simpa [embedRuntimeConfig] using hGuidedCall
  constructor
  · simp [ConcreteYul.evalRuntimeStmtFuel, hConcreteArgs, hConcreteCall,
      hAssign]
  · cases fuel <;>
      simp [SymYul.guidedEvalStmtFuel, embedConcreteStmt,
        embedConcreteStmtFuel, hGuidedArgs', hGuidedCall', hFull,
        embedRuntimeConfig, embedRuntimeResult, ConcreteYul.runtimeNormalResult,
        SymYul.guidedNormalResult, embedCompleteFlow]

private theorem evalRuntimeStmt_ifThen_false_refines_guided_of_cond
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    (fuel : Nat) {config config' : ConcreteYul.RuntimeConfig}
