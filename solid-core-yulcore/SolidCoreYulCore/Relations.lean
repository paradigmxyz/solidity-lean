inductive RuntimeStructuralBodyCoveredSpec
    (spec : RuntimeCoverageSpec) :
    Nat -> ConcreteYul.Stmt -> Prop where
  | legacy {minEmbedFuel : Nat} {stmt : ConcreteYul.Stmt} :
      RuntimeFunctionBodyCoveredSpec spec minEmbedFuel stmt ->
      RuntimeStructuralBodyCoveredSpec spec minEmbedFuel stmt
  | block {blockEmbedFuel : Nat} {stmts : List ConcreteYul.Stmt} :
      RuntimeStructuralBlockCoveredSpec spec blockEmbedFuel stmts ->
      RuntimeStructuralBodyCoveredSpec spec (blockEmbedFuel + 1)
        (ConcreteYul.Stmt.block stmts)
  | funDef {fnName : FullYul.Name} {params returns : List FullYul.Name}
      {body : ConcreteYul.Stmt} {bodyEmbedFuel : Nat} :
      RuntimeStructuralBodyCoveredSpec spec bodyEmbedFuel body ->
      bodyEmbedFuel ≤
        sizeOf (ConcreteYul.Stmt.funDef fnName params returns body) ->
      RuntimeStructuralBodyCoveredSpec spec
        (sizeOf (ConcreteYul.Stmt.funDef fnName params returns body) + 1)
        (ConcreteYul.Stmt.funDef fnName params returns body)
  | seq {first second : ConcreteYul.Stmt}
      {firstEmbedFuel secondEmbedFuel : Nat} :
      RuntimeStructuralBodyCoveredSpec spec firstEmbedFuel first ->
      RuntimeStructuralBodyCoveredSpec spec secondEmbedFuel second ->
      RuntimeStructuralBodyCoveredSpec spec
        (Nat.max firstEmbedFuel secondEmbedFuel + 1)
        (ConcreteYul.Stmt.seq first second)
  | ifThen {cond : ConcreteYul.Expr} {body : ConcreteYul.Stmt}
      {minBodyEmbedFuel : Nat} :
      RuntimeExprCoveredSpec spec cond ->
      RuntimeStructuralBodyCoveredSpec spec minBodyEmbedFuel body ->
      RuntimeStructuralBodyCoveredSpec spec (minBodyEmbedFuel + 1)
        (ConcreteYul.Stmt.ifThen cond body)
  | switch {baseFuel : Nat} {discr : ConcreteYul.Expr}
      {cases : List (Word × ConcreteYul.Stmt)}
      {defaultBranch : Option ConcreteYul.Stmt} :
      RuntimeStructuralSwitchCoveredSpec spec baseFuel discr cases
        defaultBranch ->
      RuntimeStructuralBodyCoveredSpec spec (cases.length + baseFuel + 3)
        (ConcreteYul.Stmt.switch discr cases defaultBranch)
  | forLoop {pre post body : ConcreteYul.Stmt} {cond : ConcreteYul.Expr}
      {preEmbedFuel postEmbedFuel bodyEmbedFuel : Nat} :
      RuntimeStructuralBodyCoveredSpec spec preEmbedFuel pre ->
      RuntimeExprCoveredSpec spec cond ->
      RuntimeStructuralBodyCoveredSpec spec postEmbedFuel post ->
      RuntimeStructuralBodyCoveredSpec spec bodyEmbedFuel body ->
      RuntimeStructuralBodyCoveredSpec spec
        (Nat.max preEmbedFuel (Nat.max postEmbedFuel bodyEmbedFuel) + 1)
        (ConcreteYul.Stmt.forLoop pre cond post body)

inductive RuntimeStructuralBlockCoveredSpec
    (spec : RuntimeCoverageSpec) :
