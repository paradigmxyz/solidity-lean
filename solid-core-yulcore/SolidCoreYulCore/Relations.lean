universe u v

structure RuntimePrimitiveDispatcherOf
    {C : Type u} {S : Type v}
    (ExprRel : C -> S -> ConcreteYul.Expr -> Prop)
    (ExprsRel : C -> S -> List ConcreteYul.Expr -> Prop)
    (ValuesRel : C -> S -> List ConcreteYul.Expr -> Prop)
    (DataOffsetOK : FullYul.DataLabel -> Prop)
    (BuiltinExprOK BuiltinValuesOK :
      Evm.Builtin -> List ConcreteYul.Expr -> Prop) : Prop where
  dataOffset :
    ∀ {concreteConfig : C} {symbolicConfig : S}
      {label : FullYul.DataLabel},
      DataOffsetOK label ->
      ExprRel concreteConfig symbolicConfig
        (ConcreteYul.Expr.dataOffset label)
  builtinExpr :
    ∀ {concreteConfig : C} {symbolicConfig : S}
      {builtin : Evm.Builtin} {args : List ConcreteYul.Expr},
      BuiltinExprOK builtin args ->
      ExprsRel concreteConfig symbolicConfig args ->
      ExprRel concreteConfig symbolicConfig
        (ConcreteYul.Expr.builtin builtin args)
  builtinValues :
    ∀ {concreteConfig : C} {symbolicConfig : S}
      {builtin : Evm.Builtin} {args : List ConcreteYul.Expr},
      BuiltinValuesOK builtin args ->
      ExprsRel concreteConfig symbolicConfig args ->
      ValuesRel concreteConfig symbolicConfig
        [ConcreteYul.Expr.builtin builtin args]

