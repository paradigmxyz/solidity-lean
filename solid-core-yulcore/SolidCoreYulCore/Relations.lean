    (hEval :
      ConcreteYul.evalRuntimeExpr hash expr config =
        some (value, afterConfig)) :
    RuntimeConfigFunctionsCoveredSpec spec afterConfig := by
  unfold ConcreteYul.evalRuntimeExpr at hEval
  cases hInner : ConcreteYul.evalExpr hash expr config.toConfig with
  | none =>
      simp [hInner] at hEval
  | some result =>
      cases result with
      | mk value' config' =>
          simp [hInner] at hEval
          rcases hEval with ⟨_hValue, hConfig⟩
          subst afterConfig
