theorem RuntimeCurrentSolidCoreWithMemoryBuiltinValueArgKinds.of_compilerProfile
    {builtin : Evm.Builtin} {args : List ConcreteYul.Expr}
    (hOK :
      (RuntimeCompilerProfileCoverageSpec
        FullYul.CompilerProfile.currentSolidCore.withMemoryBuiltins
      ).BuiltinExprOK builtin args) :
    ∃ kinds,
      RuntimeCurrentSolidCoreWithMemoryBuiltinValueArgKinds
        builtin args kinds := by
  cases hOK.1 with
  | inl hCurrent =>
      rcases
          RuntimeCurrentSolidCoreBuiltinOK.valueArgKinds
            (RuntimeCurrentSolidCoreBuiltinOK.of_compilerProfile
              ⟨hCurrent, hOK.2⟩) with
        ⟨kinds, hKinds⟩
      exact
        ⟨ kinds
        , RuntimeCurrentSolidCoreWithMemoryBuiltinValueArgKinds.current
            hKinds ⟩
  | inr hMemory =>
      rcases
          RuntimeMemoryBuiltinValueArgKinds.of_profileMemory
            hMemory hOK.2 with
        ⟨kinds, hKinds⟩
      exact
        ⟨ kinds
        , RuntimeCurrentSolidCoreWithMemoryBuiltinValueArgKinds.memory
            hKinds ⟩

