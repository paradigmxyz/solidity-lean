theorem runtimeBlockFuelValueExactRelSim_cons_of_head_tail
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    (fuel embedFuel : Nat)
    {concreteConfig : ConcreteYul.RuntimeConfig}
    {symbolicConfig : SymYul.GuidedConfig}
    {stmt : ConcreteYul.Stmt} {rest : List ConcreteYul.Stmt}
    (hHead :
      RuntimeStmtFuelValueExactRelSim model hash fuel embedFuel concreteConfig
        symbolicConfig stmt)
    (hTail :
      ∀ {concreteConfig' : ConcreteYul.RuntimeConfig}
        {symbolicConfig' : SymYul.GuidedConfig},
        RuntimeConfigValueExactRel model concreteConfig' symbolicConfig' ->
        RuntimeBlockFuelValueExactRelSim model hash fuel embedFuel
          concreteConfig' symbolicConfig' rest) :
    RuntimeBlockFuelValueExactRelSim model hash fuel.succ embedFuel.succ
      concreteConfig symbolicConfig (stmt :: rest) := by
  intro hInputExact concreteResult hConcrete
  cases hStmt :
      ConcreteYul.evalRuntimeStmtFuel hash fuel concreteConfig stmt with
  | none =>
      simp [ConcreteYul.evalRuntimeBlockFuel, hStmt] at hConcrete
  | some headResult =>
      rcases hHead hInputExact headResult hStmt with
        ⟨symbolicHead, hGuidedHead, hHeadExact⟩
      rcases headResult with ⟨headFlow, headConfig⟩
      by_cases hFlow : headFlow = ConcreteYul.CompleteFlow.normal
      · subst headFlow
        have hTailConcrete :
            ConcreteYul.evalRuntimeBlockFuel hash fuel headConfig rest =
              some concreteResult := by
          simpa [ConcreteYul.evalRuntimeBlockFuel, hStmt,
            ConcreteYul.runtimeNormalResult] using hConcrete
        rcases symbolicHead with ⟨symbolicFlow, symbolicHeadConfig⟩
        have hSymbolicFlow : symbolicFlow = FullYul.Flow.normal := by
          simpa [ConcreteYul.runtimeNormalResult, embedCompleteFlow] using
            hHeadExact.rel.flowRel
        subst symbolicFlow
        have hTailSim := hTail hHeadExact.configExact
        rcases hTailSim hHeadExact.configExact concreteResult
            hTailConcrete with
          ⟨symbolicResult, hGuidedTail, hResultExact⟩
        exact
          ⟨ symbolicResult
          , by
              cases fuel with
              | zero =>
                  simp [ConcreteYul.evalRuntimeStmtFuel] at hStmt
              | succ fuel =>
                  simp [SymYul.guidedEvalBlockFuel, embedConcreteStmtsFuel,
                    hGuidedHead, SymYul.guidedBindNormal, hGuidedTail]
          , hResultExact ⟩
      · have hConcreteEq :
            concreteResult = { flow := headFlow, config := headConfig } :=
          evalRuntimeBlockFuel_cons_non_normal_result_eq
            (by simpa using hFlow) hStmt hConcrete
        subst concreteResult
        have hSymbolicFlow : symbolicHead.flow ≠ FullYul.Flow.normal :=
          RuntimeResultValueRel.symbolic_flow_ne_normal hHeadExact.rel
            (by simpa using hFlow)
        exact
          ⟨ symbolicHead
          , SymYul.guidedEvalBlockFuel_cons_non_normal_of_head
              hSymbolicFlow hGuidedHead
          , hHeadExact ⟩

