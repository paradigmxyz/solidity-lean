    {symbolicConfig : SymYul.GuidedConfig}
    (builtin : Evm.Builtin) (wordEval : Word -> Word -> Word -> Word)
    {args : List ConcreteYul.Expr}
    (hBuiltinNe : builtin ≠ Evm.Builtin.datacopyOp)
    (hArgs :
      RuntimeExprsKindReadValueExactRelSim model hash concreteConfig
        symbolicConfig args
        [RuntimeArgKind.word, RuntimeArgKind.word, RuntimeArgKind.word]) :
    (∀ state first second third,
      ConcreteYul.evalBuiltin hash builtin [first, second, third] state =
        some (wordEval first second third, state)) ->
    (∀ state first second third,
      FullYul.evalEvmBuiltin builtin
          [embedWordValue first, embedWordValue second, embedWordValue third]
          state =
        some (embedWordValue (wordEval first second third), state)) ->
    (∀ first second third,
      norm (wordEval first second third) = wordEval first second third) ->
    RuntimeExprKindReadValueExactRelSim model hash concreteConfig
      symbolicConfig (ConcreteYul.Expr.builtin builtin args)
      RuntimeArgKind.word := by
  intro hConcreteEval hFullEval hNorm
  intro hExact concreteValue concreteConfig' hConcrete
  rcases
      evalRuntimeExpr_builtin_args_of_success hash concreteConfig
        builtin args hBuiltinNe hConcrete with
    ⟨concreteArgs, concreteArgConfig, concreteState',
      hConcreteArgs, hConcreteBuiltin, hAfterConfig⟩
  rcases hArgs hExact concreteArgs concreteArgConfig hConcreteArgs with
    ⟨symbolicArgs, symbolicArgConfig, hGuidedArgs, hArgsRel,
      hArgConfigExact⟩
  rcases RuntimeArgListKindRel.triple_word hArgsRel with
    ⟨first, second, third, hConcreteArgsEq, hSymbolicArgsEq,
      _hFirstNorm, _hSecondNorm, _hThirdNorm⟩
  subst concreteArgs
  rw [hConcreteEval concreteArgConfig.state first second third]
    at hConcreteBuiltin
  simp at hConcreteBuiltin
  rcases hConcreteBuiltin with ⟨hConcreteValue, hConcreteState'⟩
  subst concreteValue
  subst concreteState'
  exact
    ⟨ embedWordValue (wordEval first second third)
    , symbolicArgConfig
    , by
        simp [SymYul.guidedEvalExpr, embedConcreteExpr, hGuidedArgs,
          hSymbolicArgsEq, hFullEval]
    , by simp [RuntimeArgKindRel, hNorm]
    , by simpa [hAfterConfig] using hArgConfigExact ⟩

