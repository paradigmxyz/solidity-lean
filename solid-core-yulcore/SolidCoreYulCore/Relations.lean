            (if norm candidate = norm left then
                some entries
              else
                FullYul.lookupAccountValueEntries? rest left) =
            (if norm candidate = norm right then
                some entries
              else
                FullYul.lookupAccountValueEntries? rest right)
          by_cases h : norm candidate = norm left
          · simp [h, hAddress]
          · have h' : norm candidate ≠ norm right := by
              intro hRight
              apply h
              rw [hAddress]
              exact hRight
            simp [h, h', ih]

theorem lookupAccountValueMap?_eq_of_norm
    (accounts : FullYul.AccountValueMap) {left right : Word}
    (hAddress : norm left = norm right) (key : FullYul.Value) :
    FullYul.lookupAccountValueMap? accounts left key =
      FullYul.lookupAccountValueMap? accounts right key := by
  unfold FullYul.lookupAccountValueMap?
  rw [lookupAccountValueEntries?_eq_of_norm accounts hAddress]

theorem embedAccountWordMap_lookupAccountValueEntries?
    (accounts : ConcreteYul.AccountWordMap) (address : Word) :
    FullYul.lookupAccountValueEntries? (embedAccountWordMap accounts)
        address =
      (ConcreteYul.lookupAccountWordEntries? accounts address).map
        embedWordMap := by
  induction accounts with
  | nil =>
      simp [embedAccountWordMap, ConcreteYul.lookupAccountWordEntries?,
        FullYul.lookupAccountValueEntries?]
  | cons entry rest ih =>
      cases entry with
      | mk candidate entries =>
          change
            (if norm (norm candidate) = norm address then
                some (embedWordMap entries)
              else
                FullYul.lookupAccountValueEntries?
                  (embedAccountWordMap rest) address) =
            Option.map embedWordMap
              (if norm candidate = norm address then
                some entries
              else
                ConcreteYul.lookupAccountWordEntries? rest address)
          rw [norm_norm candidate]
          by_cases h : norm candidate = norm address
          · simp [h]
          · simp [h, ih]

theorem embedAccountWordMap_writeAccountWordMap
    (accounts : ConcreteYul.AccountWordMap)
    (address key value : Word) :
    embedAccountWordMap
        (ConcreteYul.writeAccountWordMap accounts address key value) =
      FullYul.writeAccountValueMap (embedAccountWordMap accounts)
        (norm address) (embedWordValue key) (embedWordValue value) := by
  have hLookup :
      FullYul.lookupAccountValueEntries? (embedAccountWordMap accounts)
          (norm address) =
        (ConcreteYul.lookupAccountWordEntries? accounts address).map
          embedWordMap := by
    simpa [lookupAccountWordEntries?_norm_address accounts address] using
      embedAccountWordMap_lookupAccountValueEntries? accounts (norm address)
  cases hEntries :
      ConcreteYul.lookupAccountWordEntries? accounts address with
  | none =>
      simp [ConcreteYul.writeAccountWordMap, FullYul.writeAccountValueMap,
        embedAccountWordMap, embedWordMap_writeWordMap, hLookup, hEntries,
        embedWordMap, norm_norm]
  | some entries =>
      simp [ConcreteYul.writeAccountWordMap, FullYul.writeAccountValueMap,
        embedAccountWordMap, embedWordMap_writeWordMap, hLookup, hEntries,
        norm_norm]

theorem embedWordMap_lookupValueMap?
    (entries : List (Word × Word)) (key : Word) :
    FullYul.lookupValueMap? (embedWordMap entries) (embedWordValue key) =
      (ConcreteYul.lookupWordMap? entries key).map embedWordValue := by
  induction entries with
  | nil =>
      simp [embedWordMap, ConcreteYul.lookupWordMap?,
        FullYul.lookupValueMap?]
  | cons entry rest ih =>
      cases entry with
      | mk candidate value =>
          by_cases h : norm candidate = norm key
          · have hEq : embedWordValue candidate = embedWordValue key := by
              simp [embedWordValue, h]
            simp [embedWordMap, ConcreteYul.lookupWordMap?,
              FullYul.lookupValueMap?, h, hEq]
          · have hNe : embedWordValue candidate ≠ embedWordValue key := by
              intro hEq
              apply h
              simpa [embedWordValue] using hEq
            simp [embedWordMap, ConcreteYul.lookupWordMap?,
              FullYul.lookupValueMap?, h, hNe, ih]

theorem embedAccountWordMap_lookupAccountValueMap?
    (accounts : ConcreteYul.AccountWordMap) (address key : Word) :
    FullYul.lookupAccountValueMap? (embedAccountWordMap accounts)
        (norm address) (embedWordValue key) =
      (ConcreteYul.lookupAccountWordMap? accounts address key).map
        embedWordValue := by
  unfold FullYul.lookupAccountValueMap?
  unfold ConcreteYul.lookupAccountWordMap?
  rw [embedAccountWordMap_lookupAccountValueEntries? accounts
    (norm address)]
  rw [lookupAccountWordEntries?_norm_address accounts address]
  cases hEntries :
      ConcreteYul.lookupAccountWordEntries? accounts address with
  | none =>
      simp
  | some entries =>
      simpa using embedWordMap_lookupValueMap? entries key

theorem wordMapRel_embedWordMap (model : SymYul.ConcreteModel)
    (entries : List (Word × Word)) :
    WordMapRel model entries (embedWordMap entries) := by
  intro key value hLookup
  simpa [WordMapRel, hLookup] using
    embedWordMap_lookupValueMap? entries key

theorem accountWordMapRel_embedAccountWordMap
    (model : SymYul.ConcreteModel)
    (accounts : ConcreteYul.AccountWordMap) :
    AccountWordMapRel model accounts (embedAccountWordMap accounts) := by
  intro address key value hLookup
  simpa [hLookup] using
    embedAccountWordMap_lookupAccountValueMap? accounts address key

theorem AccountWordMapRel.toValueRel
    {model : SymYul.ConcreteModel}
    {concrete : ConcreteYul.AccountWordMap}
    {symbolic : FullYul.AccountValueMap}
    (hRel : AccountWordMapRel model concrete symbolic) :
    AccountWordMapValueRel model concrete symbolic := by
  intro address key value hLookup
  exact
    ⟨ embedWordValue value
    , hRel address key value hLookup
    , valueRel_embedWordValue model value ⟩

theorem accountWordMapValueRel_embedAccountWordMap
    (model : SymYul.ConcreteModel)
    (accounts : ConcreteYul.AccountWordMap) :
    AccountWordMapValueRel model accounts (embedAccountWordMap accounts) :=
  (accountWordMapRel_embedAccountWordMap model accounts).toValueRel

theorem accountWordMapReadExactRel_embedAccountWordMap
    (model : SymYul.ConcreteModel)
    (accounts : ConcreteYul.AccountWordMap) :
    AccountWordMapReadExactRel model accounts
      (embedAccountWordMap accounts) := by
  intro address key
  unfold readAccountValueMapD readAccountWordMapD
  rw [embedAccountWordMap_lookupAccountValueMap? accounts address key]
  cases ConcreteYul.lookupAccountWordMap? accounts address key <;> simp

theorem AccountWordMapReadExactRel.toValueRel
    {model : SymYul.ConcreteModel}
    {concrete : ConcreteYul.AccountWordMap}
    {symbolic : FullYul.AccountValueMap}
    (hRel : AccountWordMapReadExactRel model concrete symbolic) :
    AccountWordMapReadValueRel model concrete symbolic := by
  intro address key
  rw [hRel address key]
  exact
    valueRel_embedWordValue model
      (readAccountWordMapD concrete address key)

theorem AccountWordMapRel.lookupActive
    {model : SymYul.ConcreteModel}
    {concrete : ConcreteYul.AccountWordMap}
    {symbolic : FullYul.AccountValueMap}
    (hRel : AccountWordMapRel model concrete symbolic)
    {concreteAddress symbolicAddress key value : Word}
    (hAddress : norm symbolicAddress = norm concreteAddress)
    (hLookup :
      ConcreteYul.lookupAccountWordMap? concrete concreteAddress key =
        some value) :
    FullYul.lookupAccountValueMap? symbolic symbolicAddress
        (embedWordValue key) = some (embedWordValue value) := by
  have hConcrete := hRel concreteAddress key value hLookup
  simpa [hConcrete] using
    (lookupAccountValueMap?_eq_of_norm symbolic
      (left := symbolicAddress) (right := norm concreteAddress)
      (by simpa [norm_norm] using hAddress)
      (embedWordValue key))

theorem AccountWordMapValueRel.lookupActive
    {model : SymYul.ConcreteModel}
    {concrete : ConcreteYul.AccountWordMap}
    {symbolic : FullYul.AccountValueMap}
    (hRel : AccountWordMapValueRel model concrete symbolic)
    {concreteAddress symbolicAddress key value : Word}
    (hAddress : norm symbolicAddress = norm concreteAddress)
    (hLookup :
      ConcreteYul.lookupAccountWordMap? concrete concreteAddress key =
        some value) :
    ∃ symbolicValue,
      FullYul.lookupAccountValueMap? symbolic symbolicAddress
          (embedWordValue key) = some symbolicValue ∧
        ValueRel model value symbolicValue := by
  rcases hRel concreteAddress key value hLookup with
    ⟨symbolicValue, hSymbolic, hValue⟩
  refine ⟨symbolicValue, ?_, hValue⟩
  simpa [hSymbolic] using
    (lookupAccountValueMap?_eq_of_norm symbolic
      (left := symbolicAddress) (right := norm concreteAddress)
      (by simpa [norm_norm] using hAddress)
      (embedWordValue key))

theorem accountWordMapReadValueRel_embedAccountWordMap
    (model : SymYul.ConcreteModel)
    (accounts : ConcreteYul.AccountWordMap) :
    AccountWordMapReadValueRel model accounts
      (embedAccountWordMap accounts) :=
  (accountWordMapReadExactRel_embedAccountWordMap model accounts).toValueRel

theorem accountWordMapRel_embedAccountWordMap_write
    (model : SymYul.ConcreteModel)
    (accounts : ConcreteYul.AccountWordMap)
    (address key value : Word) :
    AccountWordMapRel model
      (ConcreteYul.writeAccountWordMap accounts address key value)
      (FullYul.writeAccountValueMap (embedAccountWordMap accounts)
        (norm address) (embedWordValue key) (embedWordValue value)) := by
  rw [← embedAccountWordMap_writeAccountWordMap accounts address key value]
  exact
    accountWordMapRel_embedAccountWordMap model
      (ConcreteYul.writeAccountWordMap accounts address key value)

theorem accountWordMapReadExactRel_embedAccountWordMap_write
    (model : SymYul.ConcreteModel)
    (accounts : ConcreteYul.AccountWordMap)
    (address key value : Word) :
    AccountWordMapReadExactRel model
      (ConcreteYul.writeAccountWordMap accounts address key value)
      (FullYul.writeAccountValueMap (embedAccountWordMap accounts)
        (norm address) (embedWordValue key) (embedWordValue value)) := by
  rw [← embedAccountWordMap_writeAccountWordMap accounts address key value]
  exact
    accountWordMapReadExactRel_embedAccountWordMap model
      (ConcreteYul.writeAccountWordMap accounts address key value)

theorem accountWordMapReadValueRel_embedAccountWordMap_write
    (model : SymYul.ConcreteModel)
    (accounts : ConcreteYul.AccountWordMap)
    (address key value : Word) :
    AccountWordMapReadValueRel model
      (ConcreteYul.writeAccountWordMap accounts address key value)
      (FullYul.writeAccountValueMap (embedAccountWordMap accounts)
        (norm address) (embedWordValue key) (embedWordValue value)) :=
  (accountWordMapReadExactRel_embedAccountWordMap_write model accounts address
    key value).toValueRel

theorem concrete_lookupAccountWordMap_write_same_norm
    (accounts : ConcreteYul.AccountWordMap)
    {writeAddress queryAddress key query value : Word}
    (hAddress : norm queryAddress = norm writeAddress)
    (hKey : norm query = norm key) :
    ConcreteYul.lookupAccountWordMap?
        (ConcreteYul.writeAccountWordMap accounts writeAddress key value)
        queryAddress query =
      some (norm value) := by
  have hAddress' : norm (norm writeAddress) = norm queryAddress := by
    rw [norm_norm, hAddress]
  have hKey' : norm (norm key) = norm query := by
    rw [norm_norm, hKey]
  simp [ConcreteYul.lookupAccountWordMap?,
    ConcreteYul.writeAccountWordMap, ConcreteYul.lookupAccountWordEntries?,
    ConcreteYul.lookupWordMap?, ConcreteYul.writeWordMap, hAddress', hKey']

theorem concrete_lookupAccountWordMap_write_same_address_other_key_norm
    (accounts : ConcreteYul.AccountWordMap)
    {writeAddress queryAddress key query value : Word}
    (hAddress : norm queryAddress = norm writeAddress)
    (hKey : norm query ≠ norm key) :
    ConcreteYul.lookupAccountWordMap?
        (ConcreteYul.writeAccountWordMap accounts writeAddress key value)
        queryAddress query =
      ConcreteYul.lookupAccountWordMap? accounts queryAddress query := by
  have hAddress' : norm (norm writeAddress) = norm queryAddress := by
    rw [norm_norm, hAddress]
  have hKey' : norm (norm key) ≠ norm query := by
    rw [norm_norm]
    exact Ne.symm hKey
  simp [ConcreteYul.lookupAccountWordMap?,
    ConcreteYul.writeAccountWordMap, ConcreteYul.lookupAccountWordEntries?,
    ConcreteYul.lookupWordMap?, ConcreteYul.writeWordMap, hAddress', hKey']
  rw [lookupAccountWordEntries?_eq_of_norm accounts
    (left := writeAddress) (right := queryAddress) hAddress.symm]
  cases ConcreteYul.lookupAccountWordEntries? accounts queryAddress <;> rfl

theorem full_lookupAccountValueMap_write_same_norm
    (accounts : FullYul.AccountValueMap)
    {writeAddress queryAddress : Word}
    {key query value : FullYul.Value}
    (hAddress : norm queryAddress = norm writeAddress)
    (hKey : query = key) :
    FullYul.lookupAccountValueMap?
        (FullYul.writeAccountValueMap accounts writeAddress key value)
        queryAddress query =
      some value := by
  subst query
  have hAddress' : norm (norm writeAddress) = norm queryAddress := by
    rw [norm_norm, hAddress]
  simp [FullYul.lookupAccountValueMap?,
    FullYul.writeAccountValueMap, FullYul.lookupAccountValueEntries?,
    FullYul.lookupValueMap?, FullYul.writeValueMap, hAddress']

theorem full_lookupAccountValueMap_write_same_address_other_key_norm
    (accounts : FullYul.AccountValueMap)
    {writeAddress queryAddress : Word}
    {key query value : FullYul.Value}
    (hAddress : norm queryAddress = norm writeAddress)
    (hKey : query ≠ key) :
    FullYul.lookupAccountValueMap?
        (FullYul.writeAccountValueMap accounts writeAddress key value)
        queryAddress query =
      FullYul.lookupAccountValueMap? accounts queryAddress query := by
  have hAddress' : norm (norm writeAddress) = norm queryAddress := by
    rw [norm_norm, hAddress]
  have hKey' : key ≠ query := Ne.symm hKey
  simp [FullYul.lookupAccountValueMap?,
    FullYul.writeAccountValueMap, FullYul.lookupAccountValueEntries?,
    FullYul.lookupValueMap?, FullYul.writeValueMap, hAddress', hKey']
  rw [lookupAccountValueEntries?_eq_of_norm accounts
    (left := writeAddress) (right := queryAddress) hAddress.symm]
  cases FullYul.lookupAccountValueEntries? accounts queryAddress <;> rfl

theorem accountWordMapRel_writeAccountWordMap
    {model : SymYul.ConcreteModel}
    {concrete : ConcreteYul.AccountWordMap}
    {symbolic : FullYul.AccountValueMap}
    (hRel : AccountWordMapRel model concrete symbolic)
    {concreteAddress symbolicAddress key value : Word}
    (hAddress : norm symbolicAddress = norm concreteAddress) :
    AccountWordMapRel model
      (ConcreteYul.writeAccountWordMap concrete concreteAddress key value)
      (FullYul.writeAccountValueMap symbolic symbolicAddress
        (embedWordValue key) (embedWordValue value)) := by
  intro queryAddress queryKey result hLookup
  by_cases hQueryAddress : norm queryAddress = norm concreteAddress
  · by_cases hQueryKey : norm queryKey = norm key
    · have hConcreteNew :
          ConcreteYul.lookupAccountWordMap?
              (ConcreteYul.writeAccountWordMap concrete concreteAddress key value)
              queryAddress queryKey =
            some (norm value) :=
        concrete_lookupAccountWordMap_write_same_norm concrete
          hQueryAddress hQueryKey
      rw [hLookup] at hConcreteNew
      cases hConcreteNew
      have hSymbolicAddress : norm queryAddress = norm symbolicAddress := by
        rw [hQueryAddress, ← hAddress]
      have hSymbolicKey : embedWordValue queryKey = embedWordValue key := by
        simp [embedWordValue, hQueryKey]
      simpa [embedWordValue, norm_norm] using
        full_lookupAccountValueMap_write_same_norm symbolic
          (writeAddress := symbolicAddress)
          (queryAddress := norm queryAddress)
          (key := embedWordValue key)
          (query := embedWordValue queryKey)
          (value := embedWordValue value)
          (by simpa [norm_norm] using hSymbolicAddress)
          hSymbolicKey
    · have hConcreteOld :
          ConcreteYul.lookupAccountWordMap? concrete queryAddress queryKey =
            some result := by
        simpa [hLookup] using
          (concrete_lookupAccountWordMap_write_same_address_other_key_norm
            concrete (writeAddress := concreteAddress)
            (queryAddress := queryAddress) (key := key) (query := queryKey)
            (value := value) hQueryAddress hQueryKey).symm
      have hSymbolicOld := hRel queryAddress queryKey result hConcreteOld
      have hSymbolicAddress : norm queryAddress = norm symbolicAddress := by
        rw [hQueryAddress, ← hAddress]
      have hSymbolicKey :
          embedWordValue queryKey ≠ embedWordValue key := by
        intro hEq
        apply hQueryKey
        simpa [embedWordValue] using hEq
      simpa [hSymbolicOld] using
        (full_lookupAccountValueMap_write_same_address_other_key_norm
          symbolic (writeAddress := symbolicAddress)
          (queryAddress := norm queryAddress)
          (key := embedWordValue key)
          (query := embedWordValue queryKey)
          (value := embedWordValue value)
          (by simpa [norm_norm] using hSymbolicAddress)
          hSymbolicKey)
  · have hConcreteOld :
        ConcreteYul.lookupAccountWordMap? concrete queryAddress queryKey =
          some result := by
      have hOther : norm queryAddress ≠ norm concreteAddress := hQueryAddress
      simpa [hLookup] using
        (ConcreteYul.lookupAccountWordMap_write_other_address concrete
          (address := concreteAddress) (other := queryAddress)
          (key := key) (value := value) (query := queryKey)
          hOther).symm
    have hSymbolicOld := hRel queryAddress queryKey result hConcreteOld
    have hSymbolicOther : norm (norm queryAddress) ≠ norm symbolicAddress := by
      rw [norm_norm]
      intro hEq
      apply hQueryAddress
      rw [← hAddress]
      exact hEq
    simpa [hSymbolicOld] using
      (FullYul.lookupAccountValueMap_write_other_address symbolic
        (address := symbolicAddress) (other := norm queryAddress)
        (key := embedWordValue key) (value := embedWordValue value)
        (readKey := embedWordValue queryKey) hSymbolicOther)

theorem accountWordMapValueRel_writeAccountWordMap
    {model : SymYul.ConcreteModel}
    {concrete : ConcreteYul.AccountWordMap}
    {symbolic : FullYul.AccountValueMap}
    (hRel : AccountWordMapValueRel model concrete symbolic)
    {concreteAddress symbolicAddress key value : Word}
    {symbolicValue : FullYul.Value}
    (hAddress : norm symbolicAddress = norm concreteAddress)
    (hValue : ValueRel model value symbolicValue) :
    AccountWordMapValueRel model
      (ConcreteYul.writeAccountWordMap concrete concreteAddress key value)
      (FullYul.writeAccountValueMap symbolic symbolicAddress
        (embedWordValue key) symbolicValue) := by
  intro queryAddress queryKey result hLookup
  by_cases hQueryAddress : norm queryAddress = norm concreteAddress
  · by_cases hQueryKey : norm queryKey = norm key
    · have hConcreteNew :
          ConcreteYul.lookupAccountWordMap?
              (ConcreteYul.writeAccountWordMap concrete concreteAddress key value)
              queryAddress queryKey =
            some (norm value) :=
        concrete_lookupAccountWordMap_write_same_norm concrete
          hQueryAddress hQueryKey
      rw [hLookup] at hConcreteNew
      cases hConcreteNew
      have hSymbolicAddress : norm queryAddress = norm symbolicAddress := by
        rw [hQueryAddress, ← hAddress]
      have hSymbolicKey : embedWordValue queryKey = embedWordValue key := by
        simp [embedWordValue, hQueryKey]
      exact
        ⟨ symbolicValue
        , full_lookupAccountValueMap_write_same_norm symbolic
            (writeAddress := symbolicAddress)
            (queryAddress := norm queryAddress)
            (key := embedWordValue key)
            (query := embedWordValue queryKey)
            (value := symbolicValue)
            (by simpa [norm_norm] using hSymbolicAddress)
            hSymbolicKey
        , valueRel_norm_left hValue ⟩
    · have hConcreteOld :
          ConcreteYul.lookupAccountWordMap? concrete queryAddress queryKey =
            some result := by
        simpa [hLookup] using
          (concrete_lookupAccountWordMap_write_same_address_other_key_norm
            concrete (writeAddress := concreteAddress)
            (queryAddress := queryAddress) (key := key) (query := queryKey)
            (value := value) hQueryAddress hQueryKey).symm
      rcases hRel queryAddress queryKey result hConcreteOld with
        ⟨oldSymbolic, hOldLookup, hOldValue⟩
      have hSymbolicAddress : norm queryAddress = norm symbolicAddress := by
        rw [hQueryAddress, ← hAddress]
      have hSymbolicKey :
          embedWordValue queryKey ≠ embedWordValue key := by
        intro hEq
        apply hQueryKey
        simpa [embedWordValue] using hEq
      exact
        ⟨ oldSymbolic
        , by
            simpa [hOldLookup] using
              (full_lookupAccountValueMap_write_same_address_other_key_norm
                symbolic (writeAddress := symbolicAddress)
                (queryAddress := norm queryAddress)
                (key := embedWordValue key)
                (query := embedWordValue queryKey)
                (value := symbolicValue)
                (by simpa [norm_norm] using hSymbolicAddress)
                hSymbolicKey)
        , hOldValue ⟩
  · have hConcreteOld :
        ConcreteYul.lookupAccountWordMap? concrete queryAddress queryKey =
          some result := by
      simpa [hLookup] using
        (ConcreteYul.lookupAccountWordMap_write_other_address concrete
          (address := concreteAddress) (other := queryAddress)
          (key := key) (value := value) (query := queryKey)
          hQueryAddress).symm
    rcases hRel queryAddress queryKey result hConcreteOld with
      ⟨oldSymbolic, hOldLookup, hOldValue⟩
    have hSymbolicOther : norm (norm queryAddress) ≠ norm symbolicAddress := by
      rw [norm_norm]
      intro hEq
      apply hQueryAddress
      rw [← hAddress]
      exact hEq
    exact
      ⟨ oldSymbolic
      , by
          simpa [hOldLookup] using
            (FullYul.lookupAccountValueMap_write_other_address symbolic
              (address := symbolicAddress) (other := norm queryAddress)
              (key := embedWordValue key) (value := symbolicValue)
              (readKey := embedWordValue queryKey) hSymbolicOther)
      , hOldValue ⟩

theorem accountWordMapReadValueRel_writeAccountWordMap
    {model : SymYul.ConcreteModel}
    {concrete : ConcreteYul.AccountWordMap}
    {symbolic : FullYul.AccountValueMap}
    (hRel : AccountWordMapReadValueRel model concrete symbolic)
    {concreteAddress symbolicAddress key value : Word}
    {symbolicValue : FullYul.Value}
    (hAddress : norm symbolicAddress = norm concreteAddress)
    (hValue : ValueRel model value symbolicValue) :
    AccountWordMapReadValueRel model
      (ConcreteYul.writeAccountWordMap concrete concreteAddress key value)
      (FullYul.writeAccountValueMap symbolic symbolicAddress
        (embedWordValue key) symbolicValue) := by
  intro queryAddress queryKey
  by_cases hQueryAddress : norm queryAddress = norm concreteAddress
  · by_cases hQueryKey : norm queryKey = norm key
    · have hConcrete :
          ConcreteYul.lookupAccountWordMap?
              (ConcreteYul.writeAccountWordMap concrete concreteAddress key value)
              queryAddress queryKey =
            some (norm value) :=
        concrete_lookupAccountWordMap_write_same_norm concrete
          hQueryAddress hQueryKey
      have hSymbolicAddress :
          norm (norm queryAddress) = norm symbolicAddress := by
        rw [norm_norm, hQueryAddress, ← hAddress]
      have hSymbolicKey : embedWordValue queryKey = embedWordValue key := by
        simp [embedWordValue, hQueryKey]
      have hSymbolic :
          FullYul.lookupAccountValueMap?
              (FullYul.writeAccountValueMap symbolic symbolicAddress
                (embedWordValue key) symbolicValue)
              (norm queryAddress) (embedWordValue queryKey) =
            some symbolicValue :=
        full_lookupAccountValueMap_write_same_norm symbolic
          (writeAddress := symbolicAddress)
          (queryAddress := norm queryAddress)
          (key := embedWordValue key)
          (query := embedWordValue queryKey)
          (value := symbolicValue) hSymbolicAddress hSymbolicKey
      simpa [readAccountWordMapD, readAccountValueMapD, hConcrete,
        hSymbolic] using valueRel_norm_left hValue
    · have hConcrete :
          ConcreteYul.lookupAccountWordMap?
              (ConcreteYul.writeAccountWordMap concrete concreteAddress key value)
              queryAddress queryKey =
            ConcreteYul.lookupAccountWordMap? concrete queryAddress queryKey :=
        concrete_lookupAccountWordMap_write_same_address_other_key_norm
          concrete hQueryAddress hQueryKey
      have hSymbolicAddress :
          norm (norm queryAddress) = norm symbolicAddress := by
        rw [norm_norm, hQueryAddress, ← hAddress]
      have hSymbolicKey :
          embedWordValue queryKey ≠ embedWordValue key := by
        intro hEq
        apply hQueryKey
        simpa [embedWordValue] using hEq
      have hSymbolic :
          FullYul.lookupAccountValueMap?
              (FullYul.writeAccountValueMap symbolic symbolicAddress
                (embedWordValue key) symbolicValue)
              (norm queryAddress) (embedWordValue queryKey) =
            FullYul.lookupAccountValueMap? symbolic (norm queryAddress)
              (embedWordValue queryKey) :=
        full_lookupAccountValueMap_write_same_address_other_key_norm
          symbolic (writeAddress := symbolicAddress)
          (queryAddress := norm queryAddress)
          (key := embedWordValue key)
          (query := embedWordValue queryKey)
          (value := symbolicValue) hSymbolicAddress hSymbolicKey
      simpa [readAccountWordMapD, readAccountValueMapD, hConcrete,
        hSymbolic] using hRel queryAddress queryKey
  · have hConcrete :
        ConcreteYul.lookupAccountWordMap?
            (ConcreteYul.writeAccountWordMap concrete concreteAddress key value)
            queryAddress queryKey =
          ConcreteYul.lookupAccountWordMap? concrete queryAddress queryKey :=
      ConcreteYul.lookupAccountWordMap_write_other_address concrete
        (address := concreteAddress) (other := queryAddress)
        (key := key) (value := value) (query := queryKey) hQueryAddress
    have hSymbolicOther :
        norm (norm queryAddress) ≠ norm symbolicAddress := by
      rw [norm_norm]
      intro hEq
      apply hQueryAddress
      rw [← hAddress]
      exact hEq
    have hSymbolic :
        FullYul.lookupAccountValueMap?
            (FullYul.writeAccountValueMap symbolic symbolicAddress
              (embedWordValue key) symbolicValue)
            (norm queryAddress) (embedWordValue queryKey) =
          FullYul.lookupAccountValueMap? symbolic (norm queryAddress)
            (embedWordValue queryKey) :=
      FullYul.lookupAccountValueMap_write_other_address symbolic
        (address := symbolicAddress) (other := norm queryAddress)
        (key := embedWordValue key) (value := symbolicValue)
        (readKey := embedWordValue queryKey) hSymbolicOther
    simpa [readAccountWordMapD, readAccountValueMapD, hConcrete,
      hSymbolic] using hRel queryAddress queryKey

theorem WordMapRel.toValueRel
    {model : SymYul.ConcreteModel}
    {concrete : List (Word × Word)}
    {symbolic : List (FullYul.Value × FullYul.Value)}
    (hRel : WordMapRel model concrete symbolic) :
    WordMapValueRel model concrete symbolic := by
  intro key value hLookup
  exact
    ⟨ embedWordValue value
    , hRel key value hLookup
    , valueRel_embedWordValue model value ⟩

theorem wordMapValueRel_embedWordMap (model : SymYul.ConcreteModel)
    (entries : List (Word × Word)) :
    WordMapValueRel model entries (embedWordMap entries) :=
  (wordMapRel_embedWordMap model entries).toValueRel

theorem wordMapReadExactRel_embedWordMap (model : SymYul.ConcreteModel)
    (entries : List (Word × Word)) :
    WordMapReadExactRel model entries (embedWordMap entries) := by
  intro key
  unfold readValueMapD readWordMapD
  rw [embedWordMap_lookupValueMap? entries key]
  cases ConcreteYul.lookupWordMap? entries key <;> simp

theorem WordMapReadExactRel.toValueRel
    {model : SymYul.ConcreteModel}
    {concrete : List (Word × Word)}
    {symbolic : List (FullYul.Value × FullYul.Value)}
    (hRel : WordMapReadExactRel model concrete symbolic) :
    WordMapReadValueRel model concrete symbolic := by
  intro key
  rw [hRel key]
  exact valueRel_embedWordValue model (readWordMapD concrete key)

theorem wordMapReadValueRel_embedWordMap (model : SymYul.ConcreteModel)
    (entries : List (Word × Word)) :
