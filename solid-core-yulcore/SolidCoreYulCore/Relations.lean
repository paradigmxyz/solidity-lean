          rw [hConcreteStable]
  · intro callEnv symbolicCallEnv hCallExact
    have hFuelBudget : fuel.pred ≤ maxFuel :=
      Nat.le_trans (Nat.pred_le fuel) (Nat.le_trans (Nat.le_succ fuel) hFuel)
