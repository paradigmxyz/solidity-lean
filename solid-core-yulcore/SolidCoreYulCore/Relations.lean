  · simp [ConcreteYul.evalRuntimeExpr, ConcreteYul.evalExpr,
      ConcreteYul.evalExprs, ConcreteYul.evalBuiltin_mcopy_words,
      ConcreteYul.returnUnit, ConcreteYul.returnWord,
