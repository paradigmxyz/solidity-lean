private theorem runtimeStmtFuelExactRelSim_switch_of_structural_switch_covered_provider
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    (fuel baseFuel : Nat)
    {maxFunctionFuel : Nat}
    {spec : RuntimeCoverageSpec}
    (hDispatchers :
      RuntimeCoveredDispatchersExactUpTo model hash maxFunctionFuel spec)
    (hProvider :
      RuntimeStructuralBodyExactProviderUpTo model hash maxFunctionFuel spec)
    {concreteConfig : ConcreteYul.RuntimeConfig}
    {symbolicConfig : SymYul.GuidedConfig}
    {discr : ConcreteYul.Expr}
    {cases : List (Word × ConcreteYul.Stmt)}
    {defaultBranch : Option ConcreteYul.Stmt}
    (hFunctionFuel : fuel.pred ≤ maxFunctionFuel)
    (hSwitch :
      RuntimeStructuralSwitchCoveredSpec spec baseFuel discr cases
        defaultBranch) :
    RuntimeStmtFuelExactRelSim model hash fuel.succ
      (cases.length + baseFuel + 3) concreteConfig symbolicConfig
      (ConcreteYul.Stmt.switch discr cases defaultBranch) := by
  cases hSwitch with
  | intro hDiscr hCases hDefault =>
      let hSwitch' :
          RuntimeStructuralSwitchCoveredSpec spec baseFuel discr cases
            defaultBranch :=
        RuntimeStructuralSwitchCoveredSpec.intro hDiscr hCases hDefault
      exact
        runtimeStmtFuelSim_switch_of_expr_target_success
          (ConfigRel := RuntimeConfigExactRel model)
          (ResultRel := RuntimeResultExactRel model)
          model hash fuel (cases.length + baseFuel + 2)
          (hNormalRel := fun hConfigExact =>
            by
              simpa [ConcreteYul.runtimeNormalResult,
                SymYul.guidedNormalResult] using
                  runtimeResultExactRel_of_runtimeConfigExactRel
                    ConcreteYul.CompleteFlow.normal hConfigExact)
          (hExpr :=
            runtimeExprExactRelSim_of_covered_dispatcher model hash
              hDispatchers.primitive hDiscr)
          (hTarget := by
            intro value concreteConfig' target _hConcreteDiscr
              hConcreteTarget
            rcases
                runtimeStructuralSwitchCoveredSpec_target_guided
                  model hSwitch' hConcreteTarget with
              ⟨targetEmbedFuel, _minEmbedFuel, hBody, hBodyEmbed,
                hGuidedTarget⟩
            exact
              ⟨ targetEmbedFuel
              , hGuidedTarget
              , by
                  intro _symbolicValue _symbolicConfig' _hGuided
                    _hValueRel hConfigExact concreteResult
                    hConcreteTargetEval
                  exact
                    (hProvider hFunctionFuel hBody hBodyEmbed)
                      hConfigExact concreteResult hConcreteTargetEval ⟩)

theorem runtimeStructuralSwitchCasesCoveredSpec_mono_base
    {spec : RuntimeCoverageSpec} {oldBase newBase : Nat}
    {cases : List (Word × ConcreteYul.Stmt)}
    (hCases :
      RuntimeStructuralSwitchCasesCoveredSpec spec oldBase cases)
    (hBase : oldBase ≤ newBase) :
    RuntimeStructuralSwitchCasesCoveredSpec spec newBase cases := by
  induction cases with
  | nil =>
      exact RuntimeStructuralSwitchCasesCoveredSpec.nil
  | cons switchCase rest ih =>
      rcases switchCase with ⟨label, branch⟩
      cases hCases with
      | cons hBranch hBranchEmbed hRest =>
          exact
            RuntimeStructuralSwitchCasesCoveredSpec.cons hBranch
              (by omega) (ih hRest)

theorem runtimeStructuralSwitchDefaultCoveredSpec_mono_base
    {spec : RuntimeCoverageSpec} {oldBase newBase casesLength : Nat}
    {defaultBranch : Option ConcreteYul.Stmt}
    (hDefault :
      RuntimeStructuralSwitchDefaultCoveredSpec spec oldBase casesLength
        defaultBranch)
    (hBase : oldBase ≤ newBase) :
    RuntimeStructuralSwitchDefaultCoveredSpec spec newBase casesLength
      defaultBranch := by
  cases hDefault with
  | none =>
      exact RuntimeStructuralSwitchDefaultCoveredSpec.none
  | some hBody hBodyEmbed =>
      exact
        RuntimeStructuralSwitchDefaultCoveredSpec.some hBody (by omega)

theorem runtimeStructuralSwitchCoveredSpec_mono_base
    {spec : RuntimeCoverageSpec} {oldBase newBase : Nat}
    {discr : ConcreteYul.Expr}
    {cases : List (Word × ConcreteYul.Stmt)}
    {defaultBranch : Option ConcreteYul.Stmt}
    (hSwitch :
      RuntimeStructuralSwitchCoveredSpec spec oldBase discr cases
        defaultBranch)
    (hBase : oldBase ≤ newBase) :
    RuntimeStructuralSwitchCoveredSpec spec newBase discr cases
      defaultBranch := by
  cases hSwitch with
  | intro hDiscr hCases hDefault =>
      exact
        RuntimeStructuralSwitchCoveredSpec.intro hDiscr
          (runtimeStructuralSwitchCasesCoveredSpec_mono_base hCases hBase)
          (runtimeStructuralSwitchDefaultCoveredSpec_mono_base hDefault hBase)

private theorem runtimeStmtFuelExactRelSim_switch_of_structural_switch_covered_provider_fuel_upTo
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    {fuel embedFuel baseFuel maxFunctionFuel : Nat}
    {spec : RuntimeCoverageSpec}
    (hDispatchers :
      RuntimeCoveredDispatchersExactUpTo model hash maxFunctionFuel spec)
    (hProvider :
      RuntimeStructuralBodyExactProviderUpTo model hash maxFunctionFuel spec)
    {concreteConfig : ConcreteYul.RuntimeConfig}
    {symbolicConfig : SymYul.GuidedConfig}
    {discr : ConcreteYul.Expr}
    {cases : List (Word × ConcreteYul.Stmt)}
    {defaultBranch : Option ConcreteYul.Stmt}
    (hFunctionFuel : fuel.pred.pred ≤ maxFunctionFuel)
    (hSwitch :
      RuntimeStructuralSwitchCoveredSpec spec baseFuel discr cases
        defaultBranch)
    (hEmbedFuel : cases.length + baseFuel + 3 ≤ embedFuel) :
    RuntimeStmtFuelExactRelSim model hash fuel embedFuel concreteConfig
      symbolicConfig
      (ConcreteYul.Stmt.switch discr cases defaultBranch) := by
  cases fuel with
  | zero =>
      exact
        runtimeStmtFuelExactRelSim_of_concrete_none
          (by simp [ConcreteYul.evalRuntimeStmtFuel])
  | succ fuel =>
      let extraFuel := embedFuel - (cases.length + baseFuel + 3)
      have hBaseLe : baseFuel ≤ baseFuel + extraFuel :=
        Nat.le_add_right _ _
      have hSwitch' :
          RuntimeStructuralSwitchCoveredSpec spec
            (baseFuel + extraFuel) discr cases defaultBranch :=
        runtimeStructuralSwitchCoveredSpec_mono_base hSwitch hBaseLe
      have hEmbedEq :
          embedFuel = cases.length + (baseFuel + extraFuel) + 3 := by
        dsimp [extraFuel]
        omega
      have hInnerFunctionFuel :
          fuel.pred ≤ maxFunctionFuel := by
        simpa using hFunctionFuel
      rw [hEmbedEq]
      exact
        runtimeStmtFuelExactRelSim_switch_of_structural_switch_covered_provider
          model hash fuel (baseFuel + extraFuel) hDispatchers hProvider
          hInnerFunctionFuel hSwitch'

