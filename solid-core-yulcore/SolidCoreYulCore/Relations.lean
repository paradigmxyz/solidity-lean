@[simp] theorem embedConcreteExprs_length (exprs : List ConcreteYul.Expr) :
    (embedConcreteExprs exprs).length = exprs.length := by
  induction exprs with
  | nil =>
      rfl
  | cons _expr _rest ih =>
      simp [embedConcreteExprs, ih]

def RuntimeSignaturedCoverageSpec : RuntimeCoverageSpec where
  DataOffsetOK := fun _ => True
  BuiltinExprOK := fun builtin args =>
    ∃ sig, builtin.signature? = some sig ∧ sig.paramCount = args.length
  BuiltinValuesOK := fun builtin args =>
    ∃ sig, builtin.signature? = some sig ∧ sig.paramCount = args.length
  FunctionOK := fun _ _ => True

def RuntimeCompilerProfileCoverageSpec
    (profile : FullYul.CompilerProfile) : RuntimeCoverageSpec where
  DataOffsetOK := fun _ => profile.allowDataRefs
  BuiltinExprOK := fun builtin args =>
    profile.builtinOK builtin ∧
      ∃ sig, builtin.signature? = some sig ∧ sig.paramCount = args.length
  BuiltinValuesOK := fun builtin args =>
    profile.builtinOK builtin ∧
      ∃ sig, builtin.signature? = some sig ∧ sig.paramCount = args.length
  FunctionOK := fun _ _ => profile.allowFunctionCalls

theorem RuntimeCompilerProfileCoverageSpec.le_signatured
    (profile : FullYul.CompilerProfile) :
    RuntimeCoverageSpecLe (RuntimeCompilerProfileCoverageSpec profile)
      RuntimeSignaturedCoverageSpec where
  dataOffset _hOK := trivial
  builtinExpr hOK := hOK.2
  builtinValues hOK := hOK.2
  function _hOK := trivial

theorem RuntimeCompilerProfileCoverageSpec.le_of_profile_le
    {source target : FullYul.CompilerProfile}
    (hLe : FullYul.CompilerProfile.Le source target) :
    RuntimeCoverageSpecLe (RuntimeCompilerProfileCoverageSpec source)
      (RuntimeCompilerProfileCoverageSpec target) where
  dataOffset hOK := hLe.dataRefs hOK
  builtinExpr hOK := ⟨hLe.builtinOK hOK.1, hOK.2⟩
  builtinValues hOK := ⟨hLe.builtinOK hOK.1, hOK.2⟩
  function hOK := hLe.functionCalls hOK

