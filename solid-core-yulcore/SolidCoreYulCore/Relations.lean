theorem runtimeExprReadValueExactRelSim_mload_of_args
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    {concreteConfig : ConcreteYul.RuntimeConfig}
    {symbolicConfig : SymYul.GuidedConfig}
    {args : List ConcreteYul.Expr}
    (hArgs :
      RuntimeExprsKindReadValueExactRelSim model hash concreteConfig
        symbolicConfig args [RuntimeArgKind.word])
    (hMemoryWord :
      ∀ {concreteArgConfig : ConcreteYul.RuntimeConfig}
        {symbolicArgConfig : SymYul.GuidedConfig},
        RuntimeConfigReadValueExactRel model concreteArgConfig
          symbolicArgConfig ->
        RuntimeConfigMemoryWordReadRel model concreteArgConfig
          symbolicArgConfig) :
    RuntimeExprReadValueExactRelSim model hash concreteConfig symbolicConfig
      (ConcreteYul.Expr.builtin Evm.Builtin.mload args) := by
  apply
    runtimeExprReadValueExactRelSim_builtin_non_datacopy_of_runtimeExprsKindReadValueExactRel
      model hash
  · decide
  · exact hArgs
  · intro concreteArgs concreteArgConfig concreteAfterConfig concreteValue
      concreteState' hConcreteArgs hConcreteBuiltin hAfterConfig
      symbolicArgs symbolicArgConfig hGuidedArgs hArgsRel hArgConfigExact
    rcases RuntimeArgListKindRel.single_word hArgsRel with
      ⟨offset, hConcreteArgsEq, hSymbolicArgsEq, hOffsetNorm⟩
    subst concreteArgs
    have hConcreteMload :=
      ConcreteYul.evalBuiltin_mload_word hash concreteArgConfig.state offset
    rw [hConcreteMload] at hConcreteBuiltin
    simp [ConcreteYul.returnWord] at hConcreteBuiltin
    rcases hConcreteBuiltin with ⟨hConcreteValue, hConcreteStateEq⟩
    have hReadRel :
        match FullYul.lookupWordMap? symbolicArgConfig.evm.memoryWords offset with
        | some value =>
            ValueRel model
              (ConcreteYul.readWord concreteArgConfig.state.memory offset)
              value
        | none =>
            ValueRel model
              (ConcreteYul.readWord concreteArgConfig.state.memory offset)
              (FullYul.Value.memoryWordAt
                symbolicArgConfig.evm.memoryVersion offset) := by
      simpa [hOffsetNorm] using hMemoryWord hArgConfigExact offset
    cases hLookup :
        FullYul.lookupWordMap? symbolicArgConfig.evm.memoryWords offset with
    | some symbolicValue =>
        have hValue :
            ValueRel model
              (ConcreteYul.readWord concreteArgConfig.state.memory offset)
              symbolicValue := by
          simpa [hLookup] using hReadRel
        refine
          ⟨ symbolicValue
          , FullYul.expandMemory symbolicArgConfig.evm offset 32
          , ?_
          , by
              simpa [hConcreteValue] using valueRel_norm_left hValue
          , ?_ ⟩
        · simpa [hSymbolicArgsEq, hOffsetNorm, embedWordValue] using
            FullYul.evalEvmBuiltin_mload_present symbolicArgConfig.evm
              offset symbolicValue hLookup
        · simpa [hAfterConfig, ← hConcreteStateEq] using
            runtimeConfigReadValueExactRel_expandMemory hArgConfigExact
              offset 32
    | none =>
        have hValue :
            ValueRel model
              (ConcreteYul.readWord concreteArgConfig.state.memory offset)
              (FullYul.Value.memoryWordAt
                symbolicArgConfig.evm.memoryVersion offset) := by
          simpa [hLookup] using hReadRel
        refine
          ⟨ FullYul.Value.memoryWordAt symbolicArgConfig.evm.memoryVersion
              offset
          , FullYul.expandMemory symbolicArgConfig.evm offset 32
          , ?_
          , by
              simpa [hConcreteValue] using valueRel_norm_left hValue
          , ?_ ⟩
        · simpa [hSymbolicArgsEq, hOffsetNorm, embedWordValue] using
            FullYul.evalEvmBuiltin_mload_missing symbolicArgConfig.evm
              offset hLookup
        · simpa [hAfterConfig, ← hConcreteStateEq] using
            runtimeConfigReadValueExactRel_expandMemory hArgConfigExact
              offset 32

