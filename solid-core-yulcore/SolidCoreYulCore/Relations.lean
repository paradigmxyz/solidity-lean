theorem evalRuntimeExpr_datacopy_object_refines_guided
    (hash : ConcreteYul.HashOracle)
    {config : ConcreteYul.RuntimeConfig} {label : FullYul.DataLabel}
    {bytes : ConcreteYul.Bytes} (dest : Word)
    (hData : ConcreteYul.Object.data? config.object label = some bytes) :
    ConcreteYul.evalRuntimeExpr hash
        (ConcreteYul.Expr.builtin Evm.Builtin.datacopyOp
          [ ConcreteYul.Expr.word dest
          , ConcreteYul.Expr.dataOffset label
          , ConcreteYul.Expr.dataSize label ])
        config =
      some
        ( 0
        , { config with
            state :=
              ConcreteYul.setMemoryAfterAccess config.state
                (ConcreteYul.copyBytes config.state.memory (norm dest) bytes 0
                  (norm bytes.length))
                (norm dest) (norm bytes.length) } ) ∧
    SymYul.guidedEvalExpr (embedRuntimeConfig config)
        (embedConcreteExpr
          (ConcreteYul.Expr.builtin Evm.Builtin.datacopyOp
            [ ConcreteYul.Expr.word dest
            , ConcreteYul.Expr.dataOffset label
            , ConcreteYul.Expr.dataSize label ])) =
      if norm bytes.length = 0 then
        some (embedWordValue 0, embedRuntimeConfig config)
      else
        some
          ( embedWordValue 0
          , { embedRuntimeConfig config with
              evm :=
                FullYul.recordMemoryWrite
                  { embedConcreteState config.state with
                    memoryWords := []
                    memoryBytes :=
                      FullYul.ObjectMemory.write
                        (embedConcreteState config.state).memoryBytes
                        (norm dest)
                        (FullYul.SymbolicBytes.objectData label
                          (norm bytes.length)) }
                  (norm dest) (norm bytes.length) } ) := by
  have hFull :
      FullYul.YulObject.data? (embedConcreteObject config.object) label =
        some (embedConcreteBytes bytes) := by
    simpa [hData] using embedConcreteObject_data? config.object label
  constructor
  · simp [ConcreteYul.evalRuntimeExpr, ConcreteYul.evalExpr,
      ConcreteYul.RuntimeConfig.toConfig, ConcreteYul.RuntimeConfig.withConfig,
      hData]
  · by_cases hSize : norm bytes.length = 0
    · simp [SymYul.guidedEvalExpr, SymYul.guidedEvalExprs,
        embedConcreteExpr, embedConcreteExprs, embedRuntimeConfig, hFull,
