import Std
import SolidCoreYulCore.ConcreteYul
import SolidCoreYulCore.SymYul

set_option maxHeartbeats 1000000

namespace SolidCoreYulCore
namespace Relations

def embedWordValue (value : Word) : FullYul.Value :=
  FullYul.Value.word (norm value)

def embedWordMap : List (Word × Word) -> List (FullYul.Value × FullYul.Value)
  | [] => []
  | (key, value) :: rest =>
      (embedWordValue key, embedWordValue value) :: embedWordMap rest

def embedAccountWordMap :
    ConcreteYul.AccountWordMap -> FullYul.AccountValueMap
  | [] => []
  | (address, entries) :: rest =>
      (norm address, embedWordMap entries) :: embedAccountWordMap rest

def embedHalt : ConcreteYul.HaltState -> FullYul.EvmHalt
  | halt =>
      { kind := halt.kind
        returndata :=
          match halt.returndata with
          | [] => FullYul.SymbolicBytes.empty
          | _ => FullYul.SymbolicBytes.hexLiteral s!"concrete-returndata:{halt.returndata}" }

def embedHalt? : Option ConcreteYul.HaltState -> Option FullYul.EvmHalt
  | none => none
  | some halt => some (embedHalt halt)

def embedExternalActions (actions : List ConcreteYul.ExternalAction) :
    List Evm.Builtin :=
  actions.map (fun action => action.builtin)

def embedConcreteBufferBytes
    (bytes : ConcreteYul.Bytes) : FullYul.SymbolicBytes :=
  match bytes with
  | [] => FullYul.SymbolicBytes.empty
  | _ => FullYul.SymbolicBytes.concrete bytes

def embedWordValues : List Word -> List FullYul.Value
  | [] => []
  | value :: rest => embedWordValue value :: embedWordValues rest

def embedConcreteLogs :
    List (Nat × List Word × ConcreteYul.Bytes) ->
      List (Nat × List FullYul.Value × FullYul.SymbolicBytes)
  | [] => []
  | (arity, topics, data) :: rest =>
      (arity, embedWordValues topics, embedConcreteBufferBytes data) ::
        embedConcreteLogs rest

def embedConcreteMemoryBytes
    (bytes : ConcreteYul.Bytes) : FullYul.ObjectMemory :=
  match bytes with
  | [] => FullYul.ObjectMemory.empty
  | _ => FullYul.ObjectMemory.write FullYul.ObjectMemory.empty 0
      (embedConcreteBufferBytes bytes)

def embedConcreteState (state : ConcreteYul.State) : FullYul.EvmState :=
  { FullYul.EvmState.empty with
    storage := embedAccountWordMap state.storage
    transientStorage := embedAccountWordMap state.transientStorage
    immutables := embedWordMap state.immutables
    linkerSymbols := embedWordMap state.linkerSymbols
    memoryBytes := embedConcreteMemoryBytes state.memory
    calldata := embedConcreteBufferBytes state.calldata
    returndata := embedConcreteBufferBytes state.returndata
    code := embedConcreteBufferBytes state.code
    address := norm state.address
    origin := norm state.origin
    caller := norm state.caller
    callvalue := norm state.callvalue
    gasprice := norm state.gasprice
    coinbase := norm state.coinbase
    timestamp := norm state.timestamp
    number := norm state.number
    difficulty := norm state.difficulty
    prevrandao := norm state.prevrandao
    gaslimit := norm state.gaslimit
    chainid := norm state.chainid
    selfbalance := norm state.selfbalance
    basefee := norm state.basefee
    gas := norm state.gas
    pc := norm state.pc
    msize := norm state.memorySize
    blobbasefee := norm state.blobbasefee
    logs := embedConcreteLogs state.logs
    externalActions := embedExternalActions state.externalActions
    halt? := embedHalt? state.halt? }

def embedConcreteEnv : ConcreteYul.Env -> FullYul.Env
  | [] => []
  | (name, value) :: rest => (name, embedWordValue value) :: embedConcreteEnv rest

def embedConcreteBytes (bytes : ConcreteYul.Bytes) : FullYul.SymbolicBytes :=
  FullYul.SymbolicBytes.concrete bytes

theorem symbolicDataSize_embedConcreteBufferBytes
    (bytes : ConcreteYul.Bytes) :
    FullYul.symbolicDataSize (embedConcreteBufferBytes bytes) =
      norm bytes.length := by
  cases bytes <;> rfl

def ValueRel (model : SymYul.ConcreteModel)
    (concrete : Word) (symbolic : FullYul.Value) : Prop :=
  norm concrete = SymYul.interpValue model symbolic

def evalPureUnaryWordBuiltin (builtin : Evm.Builtin) (value : Word) : Word :=
  match builtin with
  | Evm.Builtin.iszero => iszeroWord value
  | Evm.Builtin.notOp => notWord value
  | Evm.Builtin.clzOp => clzWord value
  | _ => 0

def evalPureBinaryWordBuiltin
    (builtin : Evm.Builtin) (lhs rhs : Word) : Word :=
  match builtin with
  | Evm.Builtin.add => addWord lhs rhs
  | Evm.Builtin.mul => mulWord lhs rhs
  | Evm.Builtin.divOp => divWord lhs rhs
  | Evm.Builtin.sdivOp => sdivWord lhs rhs
  | Evm.Builtin.modOp => modWord lhs rhs
  | Evm.Builtin.smodOp => smodWord lhs rhs
  | Evm.Builtin.expOp => expWord lhs rhs
  | Evm.Builtin.sub => subWord lhs rhs
  | Evm.Builtin.eqOp => eqWord lhs rhs
  | Evm.Builtin.ltOp => ltWord lhs rhs
  | Evm.Builtin.gtOp => gtWord lhs rhs
  | Evm.Builtin.sltOp => sltWord lhs rhs
  | Evm.Builtin.sgtOp => sgtWord lhs rhs
  | Evm.Builtin.andOp => andWord lhs rhs
  | Evm.Builtin.orOp => orWord lhs rhs
  | Evm.Builtin.xorOp => xorWord lhs rhs
  | Evm.Builtin.shlOp => shlWord lhs rhs
  | Evm.Builtin.shrOp => shrWord lhs rhs
  | Evm.Builtin.sarOp => sarWord lhs rhs
  | Evm.Builtin.signextendOp => signextendWord lhs rhs
  | Evm.Builtin.byteOp => byteWord lhs rhs
  | _ => 0

def evalPureTernaryWordBuiltin
    (builtin : Evm.Builtin) (first second third : Word) : Word :=
  match builtin with
  | Evm.Builtin.addmodOp => addmodWord first second third
  | Evm.Builtin.mulmodOp => mulmodWord first second third
  | _ => 0

structure RuntimePureWordModelSpec
    (model : SymYul.ConcreteModel) : Prop where
  unary :
    ∀ builtin value,
      norm (model.unaryBuiltin builtin (norm value)) =
        norm (evalPureUnaryWordBuiltin builtin value)
  binary :
    ∀ builtin lhs rhs,
      norm (model.binaryBuiltin builtin (norm lhs) (norm rhs)) =
        norm (evalPureBinaryWordBuiltin builtin lhs rhs)
  ternary :
    ∀ builtin first second third,
      norm
          (model.ternaryBuiltin builtin (norm first) (norm second)
            (norm third)) =
        norm (evalPureTernaryWordBuiltin builtin first second third)

def modelWithCalldataWords (model : SymYul.ConcreteModel)
    (bytes : ConcreteYul.Bytes) : SymYul.ConcreteModel :=
  { model with
    calldataWord := fun offset => ConcreteYul.readWord bytes (norm offset) }

def modelWithMemoryWordAtBytes (model : SymYul.ConcreteModel)
    (version : Nat) (bytes : ConcreteYul.Bytes) : SymYul.ConcreteModel :=
  { model with
    memoryWordAt := fun queryVersion offset =>
      if queryVersion = version then
        ConcreteYul.readWord bytes (norm offset)
      else
        model.memoryWordAt queryVersion offset }

theorem RuntimePureWordModelSpec.modelWithCalldataWords
    {model : SymYul.ConcreteModel} {bytes : ConcreteYul.Bytes}
    (hModel : RuntimePureWordModelSpec model) :
    RuntimePureWordModelSpec (modelWithCalldataWords model bytes) where
  unary := hModel.unary
  binary := hModel.binary
  ternary := hModel.ternary

theorem RuntimePureWordModelSpec.modelWithMemoryWordAtBytes
    {model : SymYul.ConcreteModel} {version : Nat}
    {bytes : ConcreteYul.Bytes}
    (hModel : RuntimePureWordModelSpec model) :
    RuntimePureWordModelSpec
      (modelWithMemoryWordAtBytes model version bytes) where
  unary := hModel.unary
  binary := hModel.binary
  ternary := hModel.ternary

theorem modelStorageZero_modelWithCalldataWords
    {model : SymYul.ConcreteModel} {bytes : ConcreteYul.Bytes}
    (hStorageZero :
      ∀ address key, norm (model.storageWord (norm address) (norm key)) = 0) :
    ∀ address key,
      norm
        ((modelWithCalldataWords model bytes).storageWord
          (norm address) (norm key)) = 0 :=
  hStorageZero

theorem modelStorageZero_modelWithMemoryWordAtBytes
    {model : SymYul.ConcreteModel} {version : Nat}
    {bytes : ConcreteYul.Bytes}
    (hStorageZero :
      ∀ address key, norm (model.storageWord (norm address) (norm key)) = 0) :
    ∀ address key,
      norm
        ((modelWithMemoryWordAtBytes model version bytes).storageWord
          (norm address) (norm key)) = 0 :=
  hStorageZero

def pureWordConcreteModel : SymYul.ConcreteModel :=
  { SymYul.ConcreteModel.zero with
    unaryBuiltin := evalPureUnaryWordBuiltin
    binaryBuiltin := evalPureBinaryWordBuiltin
    ternaryBuiltin := evalPureTernaryWordBuiltin }

theorem valueRel_unaryBuiltin_of_pureWordModel
    {model : SymYul.ConcreteModel}
    (hModel : RuntimePureWordModelSpec model)
    (builtin : Evm.Builtin)
    {concrete : Word} {symbolic : FullYul.Value}
    (hValue : ValueRel model concrete symbolic) :
    ValueRel model (evalPureUnaryWordBuiltin builtin concrete)
      (FullYul.Value.unaryBuiltin builtin symbolic) := by
  unfold ValueRel at hValue ⊢
  simp [SymYul.interpValue]
  rw [← hValue]
  exact (hModel.unary builtin concrete).symm

theorem valueRel_binaryBuiltin_of_pureWordModel
    {model : SymYul.ConcreteModel}
    (hModel : RuntimePureWordModelSpec model)
    (builtin : Evm.Builtin)
    {concreteLhs concreteRhs : Word}
    {symbolicLhs symbolicRhs : FullYul.Value}
    (hLhs : ValueRel model concreteLhs symbolicLhs)
    (hRhs : ValueRel model concreteRhs symbolicRhs) :
    ValueRel model
      (evalPureBinaryWordBuiltin builtin concreteLhs concreteRhs)
      (FullYul.Value.binaryBuiltin builtin symbolicLhs symbolicRhs) := by
  unfold ValueRel at hLhs hRhs ⊢
  simp [SymYul.interpValue]
  rw [← hLhs, ← hRhs]
  exact (hModel.binary builtin concreteLhs concreteRhs).symm

theorem valueRel_ternaryBuiltin_of_pureWordModel
    {model : SymYul.ConcreteModel}
    (hModel : RuntimePureWordModelSpec model)
    (builtin : Evm.Builtin)
    {concreteFirst concreteSecond concreteThird : Word}
    {symbolicFirst symbolicSecond symbolicThird : FullYul.Value}
    (hFirst : ValueRel model concreteFirst symbolicFirst)
    (hSecond : ValueRel model concreteSecond symbolicSecond)
    (hThird : ValueRel model concreteThird symbolicThird) :
    ValueRel model
      (evalPureTernaryWordBuiltin builtin concreteFirst concreteSecond
        concreteThird)
      (FullYul.Value.ternaryBuiltin builtin symbolicFirst symbolicSecond
        symbolicThird) := by
  unfold ValueRel at hFirst hSecond hThird ⊢
  simp [SymYul.interpValue]
  rw [← hFirst, ← hSecond, ← hThird]
  exact
    (hModel.ternary builtin concreteFirst concreteSecond concreteThird).symm

def EnvRel (model : SymYul.ConcreteModel)
    (concrete : ConcreteYul.Env) (symbolic : FullYul.Env) : Prop :=
  ∀ name value,
    ConcreteYul.lookup? concrete name = some value ->
      ∃ symbolicValue,
        FullYul.lookup? symbolic name = some symbolicValue ∧
          ValueRel model value symbolicValue

def EnvEntryExactRel (model : SymYul.ConcreteModel)
    (concrete : FullYul.Name × Word)
    (symbolic : FullYul.Name × FullYul.Value) : Prop :=
  concrete.1 = symbolic.1 ∧ ValueRel model concrete.2 symbolic.2

def EnvExactRel (model : SymYul.ConcreteModel) :
    ConcreteYul.Env -> FullYul.Env -> Prop
  | [], [] => True
  | concreteEntry :: concreteRest, symbolicEntry :: symbolicRest =>
      EnvEntryExactRel model concreteEntry symbolicEntry ∧
        EnvExactRel model concreteRest symbolicRest
  | _, _ => False

def EnvWordExactRel
    (concrete : ConcreteYul.Env) (symbolic : FullYul.Env) : Prop :=
  ∀ name value,
    ConcreteYul.lookup? concrete name = some value ->
      FullYul.lookup? symbolic name = some (embedWordValue value) ∧
        norm value = value

def EnvNormalized (env : ConcreteYul.Env) : Prop :=
  ∀ name value,
    ConcreteYul.lookup? env name = some value ->
      norm value = value

def WordMapRel (_model : SymYul.ConcreteModel)
    (concrete : List (Word × Word))
    (symbolic : List (FullYul.Value × FullYul.Value)) : Prop :=
  ∀ key value,
    ConcreteYul.lookupWordMap? concrete key = some value ->
      FullYul.lookupValueMap? symbolic (embedWordValue key) =
        some (embedWordValue value)

def AccountWordMapRel (_model : SymYul.ConcreteModel)
    (concrete : ConcreteYul.AccountWordMap)
    (symbolic : FullYul.AccountValueMap) : Prop :=
  ∀ address key value,
    ConcreteYul.lookupAccountWordMap? concrete address key = some value ->
      FullYul.lookupAccountValueMap? symbolic (norm address)
        (embedWordValue key) = some (embedWordValue value)

def AccountWordMapValueRel (model : SymYul.ConcreteModel)
    (concrete : ConcreteYul.AccountWordMap)
    (symbolic : FullYul.AccountValueMap) : Prop :=
  ∀ address key value,
    ConcreteYul.lookupAccountWordMap? concrete address key = some value ->
      ∃ symbolicValue,
        FullYul.lookupAccountValueMap? symbolic (norm address)
          (embedWordValue key) = some symbolicValue ∧
        ValueRel model value symbolicValue

def WordMapValueRel (model : SymYul.ConcreteModel)
    (concrete : List (Word × Word))
    (symbolic : List (FullYul.Value × FullYul.Value)) : Prop :=
  ∀ key value,
    ConcreteYul.lookupWordMap? concrete key = some value ->
      ∃ symbolicValue,
        FullYul.lookupValueMap? symbolic (embedWordValue key) =
          some symbolicValue ∧
        ValueRel model value symbolicValue

def readWordMapD (entries : List (Word × Word)) (key : Word) : Word :=
  (ConcreteYul.lookupWordMap? entries key).getD (0 : Word)

def readValueMapD (entries : List (FullYul.Value × FullYul.Value))
    (key : FullYul.Value) : FullYul.Value :=
  (FullYul.lookupValueMap? entries key).getD (embedWordValue (0 : Word))

def readAccountWordMapD
    (accounts : ConcreteYul.AccountWordMap) (address key : Word) : Word :=
  (ConcreteYul.lookupAccountWordMap? accounts address key).getD (0 : Word)

def readAccountValueMapD
    (accounts : FullYul.AccountValueMap) (address : Word)
    (key : FullYul.Value) : FullYul.Value :=
  (FullYul.lookupAccountValueMap? accounts (norm address) key).getD
    (embedWordValue (0 : Word))

def WordMapReadExactRel (_model : SymYul.ConcreteModel)
    (concrete : List (Word × Word))
    (symbolic : List (FullYul.Value × FullYul.Value)) : Prop :=
  ∀ key,
    readValueMapD symbolic (embedWordValue key) =
      embedWordValue (readWordMapD concrete key)

def AccountWordMapReadExactRel (_model : SymYul.ConcreteModel)
    (concrete : ConcreteYul.AccountWordMap)
    (symbolic : FullYul.AccountValueMap) : Prop :=
  ∀ address key,
    readAccountValueMapD symbolic address (embedWordValue key) =
      embedWordValue (readAccountWordMapD concrete address key)

def WordMapReadValueRel (model : SymYul.ConcreteModel)
    (concrete : List (Word × Word))
    (symbolic : List (FullYul.Value × FullYul.Value)) : Prop :=
  ∀ key,
    ValueRel model (readWordMapD concrete key)
      (readValueMapD symbolic (embedWordValue key))

def AccountWordMapReadValueRel (model : SymYul.ConcreteModel)
    (concrete : ConcreteYul.AccountWordMap)
    (symbolic : FullYul.AccountValueMap) : Prop :=
  ∀ address key,
    ValueRel model (readAccountWordMapD concrete address key)
      (readAccountValueMapD symbolic address (embedWordValue key))

def BytesRel (concrete : ConcreteYul.Bytes)
    (symbolic : FullYul.SymbolicBytes) : Prop :=
  FullYul.symbolicDataSize symbolic = norm concrete.length

def CalldataWordReadRel (model : SymYul.ConcreteModel)
    (concrete : ConcreteYul.Bytes) : Prop :=
  ∀ offset,
    ValueRel model (ConcreteYul.readWord concrete (norm offset))
      (FullYul.Value.calldataWord offset)

def MemoryVersionWordReadRel (model : SymYul.ConcreteModel)
    (version : Nat) (concrete : ConcreteYul.Bytes) : Prop :=
  ∀ offset,
    ValueRel model (ConcreteYul.readWord concrete (norm offset))
      (FullYul.Value.memoryWordAt version offset)

def MemoryKnownWordsReadRel (model : SymYul.ConcreteModel)
    (concrete : ConcreteYul.Bytes)
    (memoryWords : List (Word × FullYul.Value)) : Prop :=
  ∀ offset value,
    FullYul.lookupWordMap? memoryWords offset = some value ->
      ValueRel model (ConcreteYul.readWord concrete (norm offset)) value

def MemoryWordReadRel (model : SymYul.ConcreteModel)
    (concrete : ConcreteYul.Bytes) (symbolic : FullYul.EvmState) : Prop :=
  ∀ offset,
    match FullYul.lookupWordMap? symbolic.memoryWords offset with
    | some value =>
        ValueRel model (ConcreteYul.readWord concrete (norm offset)) value
    | none =>
        ValueRel model (ConcreteYul.readWord concrete (norm offset))
          (FullYul.Value.memoryWordAt symbolic.memoryVersion offset)

theorem calldataWordReadRel_modelWithCalldataWords
    (model : SymYul.ConcreteModel) (bytes : ConcreteYul.Bytes) :
    CalldataWordReadRel (modelWithCalldataWords model bytes) bytes := by
  intro offset
  simp [ValueRel, modelWithCalldataWords, SymYul.interpValue]

theorem memoryVersionWordReadRel_modelWithMemoryWordAtBytes
    (model : SymYul.ConcreteModel) (version : Nat)
    (bytes : ConcreteYul.Bytes) :
    MemoryVersionWordReadRel
      (modelWithMemoryWordAtBytes model version bytes) version bytes := by
  intro offset
  simp [ValueRel, modelWithMemoryWordAtBytes, SymYul.interpValue]

theorem MemoryVersionWordReadRel.toMemoryWordReadRel_emptyWords
    {model : SymYul.ConcreteModel} {version : Nat}
    {bytes : ConcreteYul.Bytes} {symbolic : FullYul.EvmState}
    (hVersion : MemoryVersionWordReadRel model version bytes) :
    MemoryWordReadRel model bytes
      { symbolic with memoryWords := [], memoryVersion := version } := by
  intro offset
  simpa [FullYul.lookupWordMap?] using hVersion offset

theorem MemoryKnownWordsReadRel.nil
    (model : SymYul.ConcreteModel) (bytes : ConcreteYul.Bytes) :
    MemoryKnownWordsReadRel model bytes [] := by
  intro offset value hLookup
  simp [FullYul.lookupWordMap?] at hLookup

theorem MemoryKnownWordsReadRel.singleton
    {model : SymYul.ConcreteModel} {bytes : ConcreteYul.Bytes}
    {storedOffset : Word} {storedValue : FullYul.Value}
    (hStored :
      ∀ offset,
        norm storedOffset = norm offset ->
          ValueRel model (ConcreteYul.readWord bytes (norm offset))
            storedValue) :
    MemoryKnownWordsReadRel model bytes [(storedOffset, storedValue)] := by
  intro offset value hLookup
  by_cases hEq : norm storedOffset = norm offset
  · simp [FullYul.lookupWordMap?, hEq] at hLookup
    cases hLookup
    exact hStored offset hEq
  · simp [FullYul.lookupWordMap?, hEq] at hLookup

theorem MemoryKnownWordsReadRel.writeWord_singleton
    {model : SymYul.ConcreteModel} {memory : ConcreteYul.Bytes}
    {offset value : Word} {symbolicValue : FullYul.Value}
    (hOffsetNorm : norm offset = offset)
    (hValue :
      ValueRel model
        (ConcreteYul.bytesToWord (ConcreteYul.wordToBytes32 value))
        symbolicValue) :
    MemoryKnownWordsReadRel model
      (ConcreteYul.writeWord memory offset value)
      [(norm offset, symbolicValue)] := by
  apply MemoryKnownWordsReadRel.singleton
  intro query hEq
  have hQuery : norm query = offset := by
    exact hEq.symm.trans ((congrArg norm hOffsetNorm).trans hOffsetNorm)
  simpa [hQuery, ConcreteYul.readWord_writeWord_same] using hValue

theorem MemoryKnownWordsReadRel.writeWord_singleton_of_valueRel
    {model : SymYul.ConcreteModel} {memory : ConcreteYul.Bytes}
    {offset value : Word} {symbolicValue : FullYul.Value}
    (hOffsetNorm : norm offset = offset)
    (hValue : ValueRel model value symbolicValue) :
    MemoryKnownWordsReadRel model
      (ConcreteYul.writeWord memory offset value)
      [(norm offset, symbolicValue)] := by
  apply MemoryKnownWordsReadRel.writeWord_singleton hOffsetNorm
  unfold ValueRel at hValue ⊢
  exact (ConcreteYul.norm_bytesToWord_wordToBytes32 value).trans hValue

theorem MemoryKnownWordsReadRel.toMemoryWordReadRel
    {model : SymYul.ConcreteModel}
    {bytes : ConcreteYul.Bytes} {symbolic : FullYul.EvmState}
    (hKnown :
      MemoryKnownWordsReadRel model bytes symbolic.memoryWords)
    (hVersion :
      MemoryVersionWordReadRel model symbolic.memoryVersion bytes) :
    MemoryWordReadRel model bytes symbolic := by
  intro offset
  cases hLookup : FullYul.lookupWordMap? symbolic.memoryWords offset with
  | some value =>
      exact hKnown offset value hLookup
  | none =>
      simpa [hLookup] using hVersion offset

theorem memoryWordReadRel_emptyWords_modelWithMemoryWordAtBytes
    (model : SymYul.ConcreteModel) (version : Nat)
    (bytes : ConcreteYul.Bytes) (symbolic : FullYul.EvmState) :
    MemoryWordReadRel
      (modelWithMemoryWordAtBytes model version bytes)
      bytes
      { symbolic with memoryWords := [], memoryVersion := version } :=
  (memoryVersionWordReadRel_modelWithMemoryWordAtBytes model version
    bytes).toMemoryWordReadRel_emptyWords

def WordListRel (model : SymYul.ConcreteModel) :
    List Word -> List FullYul.Value -> Prop
  | [], [] => True
  | concrete :: concreteRest, symbolic :: symbolicRest =>
      ValueRel model concrete symbolic ∧
        WordListRel model concreteRest symbolicRest
  | _, _ => False

def LogsRel (model : SymYul.ConcreteModel) :
    List (Nat × List Word × ConcreteYul.Bytes) ->
      List (Nat × List FullYul.Value × FullYul.SymbolicBytes) -> Prop
  | [], [] => True
  | (concreteArity, concreteTopics, concreteData) :: concreteRest,
      (symbolicArity, symbolicTopics, symbolicData) :: symbolicRest =>
      concreteArity = symbolicArity ∧
        WordListRel model concreteTopics symbolicTopics ∧
        BytesRel concreteData symbolicData ∧
        LogsRel model concreteRest symbolicRest
  | _, _ => False

def HaltRel : Option ConcreteYul.HaltState -> Option FullYul.EvmHalt -> Prop
  | none, none => True
  | some concrete, some symbolic => concrete.kind = symbolic.kind
  | _, _ => False

def EvmStateAddressRel (concrete : ConcreteYul.State)
    (symbolic : FullYul.EvmState) : Prop :=
  norm symbolic.address = norm concrete.address

def EvmStateCalldataWordReadRel (model : SymYul.ConcreteModel)
    (concrete : ConcreteYul.State) (_symbolic : FullYul.EvmState) : Prop :=
  CalldataWordReadRel model concrete.calldata

def EvmStateMemoryWordReadRel (model : SymYul.ConcreteModel)
    (concrete : ConcreteYul.State) (symbolic : FullYul.EvmState) : Prop :=
  MemoryWordReadRel model concrete.memory symbolic

theorem evmStateMemoryWordReadRel_of_knownWords_and_version
    {model : SymYul.ConcreteModel}
    {concrete : ConcreteYul.State} {symbolic : FullYul.EvmState}
    (hKnown :
      MemoryKnownWordsReadRel model concrete.memory symbolic.memoryWords)
    (hVersion :
      MemoryVersionWordReadRel model symbolic.memoryVersion concrete.memory) :
    EvmStateMemoryWordReadRel model concrete symbolic :=
  hKnown.toMemoryWordReadRel hVersion

structure EvmStateRel (model : SymYul.ConcreteModel)
    (concrete : ConcreteYul.State) (symbolic : FullYul.EvmState) : Prop where
  storageRel : AccountWordMapRel model concrete.storage symbolic.storage
  transientStorageRel :
    AccountWordMapRel model concrete.transientStorage symbolic.transientStorage
  immutablesRel : WordMapRel model concrete.immutables symbolic.immutables
  linkerSymbolsRel :
    WordMapRel model concrete.linkerSymbols symbolic.linkerSymbols
  calldataRel : BytesRel concrete.calldata symbolic.calldata
  returndataRel : BytesRel concrete.returndata symbolic.returndata
  codeRel : BytesRel concrete.code symbolic.code
  memorySizeRel : norm symbolic.msize = norm concrete.memorySize
  logsRel : LogsRel model concrete.logs symbolic.logs
  externalActionsRel :
    symbolic.externalActions = embedExternalActions concrete.externalActions
  haltRel : HaltRel concrete.halt? symbolic.halt?
  addressRel : EvmStateAddressRel concrete symbolic

structure EvmStateValueRel (model : SymYul.ConcreteModel)
    (concrete : ConcreteYul.State) (symbolic : FullYul.EvmState) : Prop where
  storageRel : AccountWordMapValueRel model concrete.storage symbolic.storage
  transientStorageRel :
    AccountWordMapValueRel model concrete.transientStorage
      symbolic.transientStorage
  immutablesRel : WordMapValueRel model concrete.immutables symbolic.immutables
  linkerSymbolsRel :
    WordMapValueRel model concrete.linkerSymbols symbolic.linkerSymbols
  calldataRel : BytesRel concrete.calldata symbolic.calldata
  returndataRel : BytesRel concrete.returndata symbolic.returndata
  codeRel : BytesRel concrete.code symbolic.code
  memorySizeRel : norm symbolic.msize = norm concrete.memorySize
  logsRel : LogsRel model concrete.logs symbolic.logs
  externalActionsRel :
    symbolic.externalActions = embedExternalActions concrete.externalActions
  haltRel : HaltRel concrete.halt? symbolic.halt?
  addressRel : EvmStateAddressRel concrete symbolic

structure EvmStateReadValueRel (model : SymYul.ConcreteModel)
    (concrete : ConcreteYul.State) (symbolic : FullYul.EvmState) : Prop where
  valueRel : EvmStateValueRel model concrete symbolic
  storageReadRel :
    AccountWordMapReadValueRel model concrete.storage symbolic.storage
  transientStorageReadRel :
    AccountWordMapReadValueRel model concrete.transientStorage
      symbolic.transientStorage
  immutablesReadRel :
    WordMapReadValueRel model concrete.immutables symbolic.immutables
  linkerSymbolsReadRel :
    WordMapReadValueRel model concrete.linkerSymbols symbolic.linkerSymbols

theorem evmStateAddressRel_embedConcreteState
    (state : ConcreteYul.State) :
    EvmStateAddressRel state (embedConcreteState state) := by
  unfold EvmStateAddressRel embedConcreteState norm
  exact Nat.mod_mod state.address wordModulus

theorem valueRel_embedWordValue (model : SymYul.ConcreteModel)
    (value : Word) :
    ValueRel model value (embedWordValue value) := by
  unfold ValueRel embedWordValue SymYul.interpValue norm
  exact (Nat.mod_mod value wordModulus).symm

theorem envExactRel_lookup?
    {model : SymYul.ConcreteModel}
    {concrete : ConcreteYul.Env} {symbolic : FullYul.Env}
    (hExact : EnvExactRel model concrete symbolic)
    {name : FullYul.Name} {value : Word}
    (hLookup : ConcreteYul.lookup? concrete name = some value) :
    ∃ symbolicValue,
      FullYul.lookup? symbolic name = some symbolicValue ∧
        ValueRel model value symbolicValue := by
  induction concrete generalizing symbolic with
  | nil =>
      cases symbolic <;> simp [EnvExactRel, ConcreteYul.lookup?] at hExact hLookup
  | cons concreteEntry concreteRest ih =>
      cases symbolic with
      | nil =>
          simp [EnvExactRel] at hExact
      | cons symbolicEntry symbolicRest =>
          rcases hExact with ⟨hHead, hTail⟩
          cases concreteEntry with
          | mk concreteName concreteValue =>
              cases symbolicEntry with
              | mk symbolicName symbolicValue =>
                  rcases hHead with ⟨hName, hValueRel⟩
                  simp at hName hValueRel
                  by_cases hConcreteName : concreteName = name
                  · simp [ConcreteYul.lookup?, hConcreteName] at hLookup
                    cases hLookup
                    have hSymbolicName : symbolicName = name := by
                      rw [← hName, hConcreteName]
                    exact
                      ⟨ symbolicValue
                      , by simp [FullYul.lookup?, hSymbolicName]
                      , hValueRel ⟩
                  · have hSymbolicName : symbolicName ≠ name := by
                      intro hEq
                      apply hConcreteName
                      rw [hName, hEq]
                    simp [ConcreteYul.lookup?, hConcreteName] at hLookup
                    rcases ih hTail hLookup with
                      ⟨symbolicTailValue, hSymbolicLookup, hTailRel⟩
                    exact
                      ⟨ symbolicTailValue
                      , by
                          simp [FullYul.lookup?, hSymbolicName,
                            hSymbolicLookup]
                      , hTailRel ⟩

theorem envExactRel_to_envRel
    {model : SymYul.ConcreteModel}
    {concrete : ConcreteYul.Env} {symbolic : FullYul.Env}
    (hExact : EnvExactRel model concrete symbolic) :
    EnvRel model concrete symbolic := by
  intro name value hLookup
  exact envExactRel_lookup? hExact hLookup

theorem envWordExactRel_lookup?
    {concrete : ConcreteYul.Env} {symbolic : FullYul.Env}
    (hExact : EnvWordExactRel concrete symbolic)
    {name : FullYul.Name} {value : Word}
    (hLookup : ConcreteYul.lookup? concrete name = some value) :
    FullYul.lookup? symbolic name = some (embedWordValue value) ∧
      norm value = value :=
  hExact name value hLookup

theorem envExactRel_lookup?_none
    {model : SymYul.ConcreteModel}
    {concrete : ConcreteYul.Env} {symbolic : FullYul.Env}
    (hExact : EnvExactRel model concrete symbolic)
    {name : FullYul.Name}
    (hLookup : ConcreteYul.lookup? concrete name = none) :
    FullYul.lookup? symbolic name = none := by
  induction concrete generalizing symbolic with
  | nil =>
      cases symbolic <;> simp [EnvExactRel, FullYul.lookup?] at hExact ⊢
  | cons concreteEntry concreteRest ih =>
      cases symbolic with
      | nil =>
          simp [EnvExactRel] at hExact
      | cons symbolicEntry symbolicRest =>
          rcases hExact with ⟨hHead, hTail⟩
          cases concreteEntry with
          | mk concreteName concreteValue =>
              cases symbolicEntry with
              | mk symbolicName symbolicValue =>
                  rcases hHead with ⟨hName, _hValueRel⟩
                  simp at hName
                  by_cases hConcreteName : concreteName = name
                  · simp [ConcreteYul.lookup?, hConcreteName] at hLookup
                  · have hSymbolicName : symbolicName ≠ name := by
                      intro hEq
                      apply hConcreteName
                      rw [hName, hEq]
                    simp [ConcreteYul.lookup?, hConcreteName] at hLookup
                    simp [FullYul.lookup?, hSymbolicName, ih hTail hLookup]

theorem envExactRel_embedConcreteEnv (model : SymYul.ConcreteModel)
    (env : ConcreteYul.Env) :
    EnvExactRel model env (embedConcreteEnv env) := by
  induction env with
  | nil =>
      trivial
  | cons entry rest ih =>
      cases entry with
      | mk name value =>
          constructor
          · constructor
            · rfl
            · exact valueRel_embedWordValue model value
          · exact ih

theorem valueRel_norm_left {model : SymYul.ConcreteModel}
    {value : Word} {symbolic : FullYul.Value}
    (hRel : ValueRel model value symbolic) :
    ValueRel model (norm value) symbolic := by
  unfold ValueRel at hRel ⊢
  unfold norm at hRel ⊢
  rw [Nat.mod_mod]
  exact hRel

theorem wordListRel_norm_embedWordValues
    (model : SymYul.ConcreteModel) :
    ∀ topics : List Word,
      WordListRel model (topics.map norm) (topics.map embedWordValue)
  | [] => trivial
  | topic :: rest =>
      ⟨ valueRel_norm_left (valueRel_embedWordValue model topic)
      , wordListRel_norm_embedWordValues model rest ⟩

theorem interpValue_norm
    (model : SymYul.ConcreteModel) (value : FullYul.Value) :
    norm (SymYul.interpValue model value) =
      SymYul.interpValue model value := by
  induction value <;> simp [SymYul.interpValue, norm]

theorem guidedBool_false_of_valueRel_zero
    {model : SymYul.ConcreteModel} {value : Word}
    {symbolic : FullYul.Value}
    (hRel : ValueRel model value symbolic) (hZero : norm value = 0) :
    SymYul.guidedBool model symbolic = false := by
  have hSymbolicZero :
      norm (SymYul.interpValue model symbolic) = 0 := by
    rw [← hRel]
    unfold norm at *
    rw [Nat.mod_mod]
    exact hZero
  simp [SymYul.guidedBool, hSymbolicZero]

theorem guidedBool_true_of_valueRel_nonzero
    {model : SymYul.ConcreteModel} {value : Word}
    {symbolic : FullYul.Value}
    (hRel : ValueRel model value symbolic) (hNonzero : norm value ≠ 0) :
    SymYul.guidedBool model symbolic = true := by
  have hSymbolicNonzero :
      norm (SymYul.interpValue model symbolic) ≠ 0 := by
    intro hZero
    apply hNonzero
    rw [hRel]
    rw [← interpValue_norm model symbolic]
    exact hZero
  simp [SymYul.guidedBool, hSymbolicNonzero]

theorem bytesRel_embedConcreteBufferBytes (bytes : ConcreteYul.Bytes) :
    BytesRel bytes (embedConcreteBufferBytes bytes) := by
  simp [BytesRel, symbolicDataSize_embedConcreteBufferBytes]

theorem wordListRel_embedWordValues (model : SymYul.ConcreteModel)
    (values : List Word) :
    WordListRel model values (embedWordValues values) := by
  induction values with
  | nil => trivial
  | cons value rest ih =>
      constructor
      · exact valueRel_embedWordValue model value
      · exact ih

theorem wordListRel_map_embedWordValue (model : SymYul.ConcreteModel)
    (values : List Word) :
    WordListRel model values (values.map embedWordValue) := by
  induction values with
  | nil => trivial
  | cons value rest ih =>
      constructor
      · exact valueRel_embedWordValue model value
      · exact ih

theorem wordListRel_length {model : SymYul.ConcreteModel}
    {concrete : List Word} {symbolic : List FullYul.Value}
    (hRel : WordListRel model concrete symbolic) :
    concrete.length = symbolic.length := by
  induction concrete generalizing symbolic with
  | nil =>
      cases symbolic with
      | nil => rfl
      | cons _ _ =>
          exfalso
          simp [WordListRel] at hRel
  | cons _ concreteRest ih =>
      cases symbolic with
      | nil =>
          exfalso
          simp [WordListRel] at hRel
      | cons _ symbolicRest =>
          simp [WordListRel] at hRel ⊢
          exact ih hRel.2

theorem WordListRel.single
    {model : SymYul.ConcreteModel}
    {concrete : Word}
    {symbolicValues : List FullYul.Value}
    (hRel : WordListRel model [concrete] symbolicValues) :
    ∃ symbolic,
      symbolicValues = [symbolic] ∧ ValueRel model concrete symbolic := by
  cases symbolicValues with
  | nil =>
      simp [WordListRel] at hRel
  | cons symbolic rest =>
      cases rest with
      | nil =>
          simp [WordListRel] at hRel
          exact ⟨symbolic, rfl, hRel⟩
      | cons _ _ =>
          simp [WordListRel] at hRel

theorem WordListRel.pair
    {model : SymYul.ConcreteModel}
    {lhs rhs : Word}
    {symbolicValues : List FullYul.Value}
    (hRel : WordListRel model [lhs, rhs] symbolicValues) :
    ∃ symbolicLhs symbolicRhs,
      symbolicValues = [symbolicLhs, symbolicRhs] ∧
        ValueRel model lhs symbolicLhs ∧
        ValueRel model rhs symbolicRhs := by
  cases symbolicValues with
  | nil =>
      simp [WordListRel] at hRel
  | cons symbolicLhs rest =>
      cases rest with
      | nil =>
          simp [WordListRel] at hRel
      | cons symbolicRhs rest' =>
          cases rest' with
          | nil =>
              simp [WordListRel] at hRel
              exact ⟨symbolicLhs, symbolicRhs, rfl, hRel.1, hRel.2⟩
          | cons _ _ =>
              simp [WordListRel] at hRel

theorem WordListRel.triple
    {model : SymYul.ConcreteModel}
    {first second third : Word}
    {symbolicValues : List FullYul.Value}
    (hRel : WordListRel model [first, second, third] symbolicValues) :
    ∃ symbolicFirst symbolicSecond symbolicThird,
      symbolicValues = [symbolicFirst, symbolicSecond, symbolicThird] ∧
        ValueRel model first symbolicFirst ∧
        ValueRel model second symbolicSecond ∧
        ValueRel model third symbolicThird := by
  cases symbolicValues with
  | nil =>
      simp [WordListRel] at hRel
  | cons symbolicFirst rest =>
      cases rest with
      | nil =>
          simp [WordListRel] at hRel
      | cons symbolicSecond rest' =>
          cases rest' with
          | nil =>
              simp [WordListRel] at hRel
          | cons symbolicThird rest'' =>
              cases rest'' with
              | nil =>
                  simp [WordListRel] at hRel
                  exact
                    ⟨ symbolicFirst
                    , symbolicSecond
                    , symbolicThird
                    , rfl
                    , hRel.1
                    , hRel.2.1
                    , hRel.2.2 ⟩
              | cons _ _ =>
                  simp [WordListRel] at hRel

theorem embedWordValues_length (values : List Word) :
    (embedWordValues values).length = values.length := by
  induction values with
  | nil => rfl
  | cons _ rest ih =>
      simp [embedWordValues, ih]

theorem wordListRel_externalValueResults_length {model : SymYul.ConcreteModel}
    {results : List Word} {start count : Nat}
    (hRel : WordListRel model results
      (FullYul.externalValueResults start count)) :
    results.length = count := by
  rw [wordListRel_length hRel, FullYul.externalValueResults_length]

theorem logsRel_embedConcreteLogs (model : SymYul.ConcreteModel)
    (logs : List (Nat × List Word × ConcreteYul.Bytes)) :
    LogsRel model logs (embedConcreteLogs logs) := by
  induction logs with
  | nil => trivial
  | cons entry rest ih =>
      cases entry with
      | mk arity tail =>
          cases tail with
          | mk topics data =>
              constructor
              · rfl
              · constructor
                · exact wordListRel_embedWordValues model topics
                · constructor
                  · exact bytesRel_embedConcreteBufferBytes data
                  · exact ih

theorem haltRel_embedHalt? (halt? : Option ConcreteYul.HaltState) :
    HaltRel halt? (embedHalt? halt?) := by
  cases halt? <;> simp [HaltRel, embedHalt?, embedHalt]

def embedConcreteDataEntries :
    List (FullYul.DataLabel × ConcreteYul.Bytes) ->
      List (FullYul.DataLabel × FullYul.SymbolicBytes)
  | [] => []
  | (label, bytes) :: rest =>
      (label, embedConcreteBytes bytes) :: embedConcreteDataEntries rest

def embedConcreteObject (object : ConcreteYul.Object) : FullYul.YulObject :=
  FullYul.YulObject.mk 0 FullYul.Stmt.skip
    (embedConcreteDataEntries object.data ++
      embedConcreteDataEntries object.objects)
    []

theorem lookupData?_embedConcreteDataEntries
    (entries : List (FullYul.DataLabel × ConcreteYul.Bytes))
    (label : FullYul.DataLabel) :
    FullYul.lookupData? (embedConcreteDataEntries entries) label =
      (ConcreteYul.lookupData? entries label).map embedConcreteBytes := by
  induction entries with
  | nil =>
      simp [embedConcreteDataEntries, ConcreteYul.lookupData?,
        FullYul.lookupData?]
  | cons entry rest ih =>
      cases entry with
      | mk candidate bytes =>
          by_cases h : candidate = label
          · simp [embedConcreteDataEntries, ConcreteYul.lookupData?,
              FullYul.lookupData?, h]
          · simp [embedConcreteDataEntries, ConcreteYul.lookupData?,
              FullYul.lookupData?, h, ih]

theorem lookupData?_embedConcreteDataEntries_append
    (dataEntries objectEntries :
      List (FullYul.DataLabel × ConcreteYul.Bytes))
    (label : FullYul.DataLabel) :
    FullYul.lookupData?
        (embedConcreteDataEntries dataEntries ++
          embedConcreteDataEntries objectEntries)
        label =
      match ConcreteYul.lookupData? dataEntries label with
      | some bytes => some (embedConcreteBytes bytes)
      | none => (ConcreteYul.lookupData? objectEntries label).map
          embedConcreteBytes := by
  induction dataEntries with
  | nil =>
      simpa [embedConcreteDataEntries, ConcreteYul.lookupData?] using
        lookupData?_embedConcreteDataEntries objectEntries label
  | cons entry rest ih =>
      cases entry with
      | mk candidate bytes =>
          by_cases h : candidate = label
          · simp [embedConcreteDataEntries, ConcreteYul.lookupData?,
              FullYul.lookupData?, h]
          · simp [embedConcreteDataEntries, ConcreteYul.lookupData?,
              FullYul.lookupData?, h, ih]

theorem embedConcreteObject_data?
    (object : ConcreteYul.Object) (label : FullYul.DataLabel) :
    FullYul.YulObject.data? (embedConcreteObject object) label =
      (ConcreteYul.Object.data? object label).map embedConcreteBytes := by
  cases object with
  | mk dataEntries objectEntries code =>
      cases hData : ConcreteYul.lookupData? dataEntries label with
      | none =>
          simp [embedConcreteObject, FullYul.YulObject.data?,
            ConcreteYul.Object.data?, hData,
            lookupData?_embedConcreteDataEntries_append]
      | some bytes =>
          simp [embedConcreteObject, FullYul.YulObject.data?,
            ConcreteYul.Object.data?, hData,
            lookupData?_embedConcreteDataEntries_append]

mutual
  def embedConcreteExpr : ConcreteYul.Expr -> FullYul.Expr
    | ConcreteYul.Expr.word value => FullYul.Expr.value (embedWordValue value)
    | ConcreteYul.Expr.var name => FullYul.Expr.var name
    | ConcreteYul.Expr.builtin builtin args =>
        FullYul.Expr.builtin builtin (embedConcreteExprs args)
    | ConcreteYul.Expr.dataSize label => FullYul.Expr.dataSize label
    | ConcreteYul.Expr.dataOffset label => FullYul.Expr.dataOffset label

  def embedConcreteExprs : List ConcreteYul.Expr -> List FullYul.Expr
    | [] => []
    | expr :: rest => embedConcreteExpr expr :: embedConcreteExprs rest
end

mutual
  def embedConcreteStmtFuel : Nat -> ConcreteYul.Stmt -> FullYul.Stmt
    | 0, _ => FullYul.Stmt.skip
    | _fuel + 1, ConcreteYul.Stmt.skip => FullYul.Stmt.skip
    | _fuel + 1, ConcreteYul.Stmt.expr expr =>
        FullYul.Stmt.expr (embedConcreteExpr expr)
    | _fuel + 1, ConcreteYul.Stmt.let1 name init =>
        FullYul.Stmt.let1 name (init.map embedConcreteExpr)
    | _fuel + 1, ConcreteYul.Stmt.letMany names init =>
        FullYul.Stmt.letMany names (init.map embedConcreteExprs)
    | fuel + 1, ConcreteYul.Stmt.funDef name params returns body =>
        FullYul.Stmt.funDef name params returns (embedConcreteStmtFuel fuel body)
    | _fuel + 1, ConcreteYul.Stmt.assign name expr =>
        FullYul.Stmt.assign name (embedConcreteExpr expr)
    | _fuel + 1, ConcreteYul.Stmt.assignMany names exprs =>
        FullYul.Stmt.assignMany names (embedConcreteExprs exprs)
    | _fuel + 1, ConcreteYul.Stmt.letCall names fnName args =>
        FullYul.Stmt.letCall names fnName (embedConcreteExprs args)
    | _fuel + 1, ConcreteYul.Stmt.assignCall names fnName args =>
        FullYul.Stmt.assignCall names fnName (embedConcreteExprs args)
    | fuel + 1, ConcreteYul.Stmt.seq first second =>
        FullYul.Stmt.seq (embedConcreteStmtFuel fuel first)
          (embedConcreteStmtFuel fuel second)
    | fuel + 1, ConcreteYul.Stmt.block stmts =>
        FullYul.Stmt.block (embedConcreteStmtsFuel fuel stmts)
    | fuel + 1, ConcreteYul.Stmt.ifThen cond body =>
        FullYul.Stmt.ifThen (embedConcreteExpr cond)
          (embedConcreteStmtFuel fuel body)
    | fuel + 1, ConcreteYul.Stmt.switch discr cases defaultBranch =>
        FullYul.Stmt.switch (embedConcreteExpr discr)
          (embedConcreteSwitchCasesFuel fuel cases)
          (defaultBranch.map (embedConcreteStmtFuel fuel))
    | fuel + 1, ConcreteYul.Stmt.forLoop pre cond post body =>
        FullYul.Stmt.forLoop (embedConcreteStmtFuel fuel pre)
          (embedConcreteExpr cond) (embedConcreteStmtFuel fuel post)
          (embedConcreteStmtFuel fuel body)
    | _fuel + 1, ConcreteYul.Stmt.break => FullYul.Stmt.break
    | _fuel + 1, ConcreteYul.Stmt.continue => FullYul.Stmt.continue
    | _fuel + 1, ConcreteYul.Stmt.leave => FullYul.Stmt.leave

  def embedConcreteStmtsFuel : Nat -> List ConcreteYul.Stmt -> List FullYul.Stmt
    | 0, _ => []
    | _fuel + 1, [] => []
    | fuel + 1, stmt :: rest =>
        embedConcreteStmtFuel fuel stmt :: embedConcreteStmtsFuel fuel rest

  def embedConcreteSwitchCasesFuel :
      Nat -> List (Word × ConcreteYul.Stmt) ->
        List (FullYul.Value × FullYul.Stmt)
    | 0, _ => []
    | _fuel + 1, [] => []
    | fuel + 1, (label, branch) :: rest =>
        (embedWordValue label, embedConcreteStmtFuel fuel branch) ::
          embedConcreteSwitchCasesFuel fuel rest
end

mutual
  theorem embedConcreteStmtFuel_eq_of_size_lt
      (stmt : ConcreteYul.Stmt) {fuel₁ fuel₂ : Nat}
      (h₁ : sizeOf stmt < fuel₁) (h₂ : sizeOf stmt < fuel₂) :
      embedConcreteStmtFuel fuel₁ stmt = embedConcreteStmtFuel fuel₂ stmt := by
    cases fuel₁ with
    | zero => omega
    | succ fuel₁ =>
        cases fuel₂ with
        | zero => omega
        | succ fuel₂ =>
            cases stmt <;> simp [embedConcreteStmtFuel]
            case funDef name params returns body =>
              apply embedConcreteStmtFuel_eq_of_size_lt body
              · simp at h₁ ⊢
                omega
              · simp at h₂ ⊢
                omega
            case seq first second =>
              constructor
              · apply embedConcreteStmtFuel_eq_of_size_lt first
                · simp at h₁ ⊢
                  omega
                · simp at h₂ ⊢
                  omega
              · apply embedConcreteStmtFuel_eq_of_size_lt second
                · simp at h₁ ⊢
                  omega
                · simp at h₂ ⊢
                  omega
            case block stmts =>
              apply embedConcreteStmtsFuel_eq_of_size_lt stmts
              · simp at h₁ ⊢
                omega
              · simp at h₂ ⊢
                omega
            case ifThen cond body =>
              apply embedConcreteStmtFuel_eq_of_size_lt body
              · simp at h₁ ⊢
                omega
              · simp at h₂ ⊢
                omega
            case switch discr cases defaultBranch =>
              constructor
              · apply embedConcreteSwitchCasesFuel_eq_of_size_lt cases
                · simp at h₁ ⊢
                  omega
                · simp at h₂ ⊢
                  omega
              · cases defaultBranch with
                | none => rfl
                | some defaultStmt =>
                    simp
                    apply embedConcreteStmtFuel_eq_of_size_lt defaultStmt
                    · simp at h₁ ⊢
                      omega
                    · simp at h₂ ⊢
                      omega
            case forLoop pre cond post body =>
              constructor
              · apply embedConcreteStmtFuel_eq_of_size_lt pre
                · simp at h₁ ⊢
                  omega
                · simp at h₂ ⊢
                  omega
              · constructor
                · apply embedConcreteStmtFuel_eq_of_size_lt post
                  · simp at h₁ ⊢
                    omega
                  · simp at h₂ ⊢
                    omega
                · apply embedConcreteStmtFuel_eq_of_size_lt body
                  · simp at h₁ ⊢
                    omega
                  · simp at h₂ ⊢
                    omega

  theorem embedConcreteStmtsFuel_eq_of_size_lt
      (stmts : List ConcreteYul.Stmt) {fuel₁ fuel₂ : Nat}
      (h₁ : sizeOf stmts < fuel₁) (h₂ : sizeOf stmts < fuel₂) :
      embedConcreteStmtsFuel fuel₁ stmts =
        embedConcreteStmtsFuel fuel₂ stmts := by
    cases fuel₁ with
    | zero => omega
    | succ fuel₁ =>
        cases fuel₂ with
        | zero => omega
        | succ fuel₂ =>
            cases stmts with
            | nil => simp [embedConcreteStmtsFuel]
            | cons stmt rest =>
                simp [embedConcreteStmtsFuel]
                constructor
                · apply embedConcreteStmtFuel_eq_of_size_lt stmt
                  · simp at h₁ ⊢
                    omega
                  · simp at h₂ ⊢
                    omega
                · apply embedConcreteStmtsFuel_eq_of_size_lt rest
                  · simp at h₁ ⊢
                    omega
                  · simp at h₂ ⊢
                    omega

  theorem embedConcreteSwitchCasesFuel_eq_of_size_lt
      (cases : List (Word × ConcreteYul.Stmt)) {fuel₁ fuel₂ : Nat}
      (h₁ : sizeOf cases < fuel₁) (h₂ : sizeOf cases < fuel₂) :
      embedConcreteSwitchCasesFuel fuel₁ cases =
        embedConcreteSwitchCasesFuel fuel₂ cases := by
    cases fuel₁ with
    | zero => omega
    | succ fuel₁ =>
        cases fuel₂ with
        | zero => omega
        | succ fuel₂ =>
            cases cases with
            | nil => simp [embedConcreteSwitchCasesFuel]
            | cons head rest =>
                rcases head with ⟨label, branch⟩
                simp [embedConcreteSwitchCasesFuel]
                constructor
                · apply embedConcreteStmtFuel_eq_of_size_lt branch
                  · simp at h₁ ⊢
                    omega
                  · simp at h₂ ⊢
                    omega
                · apply embedConcreteSwitchCasesFuel_eq_of_size_lt rest
                  · simp at h₁ ⊢
                    omega
                  · simp at h₂ ⊢
                    omega
end

noncomputable def embedConcreteStmt (stmt : ConcreteYul.Stmt) : FullYul.Stmt :=
  embedConcreteStmtFuel (sizeOf stmt + 1) stmt

noncomputable def embedConcreteStmts
    (stmts : List ConcreteYul.Stmt) : List FullYul.Stmt :=
  embedConcreteStmtsFuel (sizeOf stmts + 1) stmts

noncomputable def embedConcreteSwitchCases
    (cases : List (Word × ConcreteYul.Stmt)) :
    List (FullYul.Value × FullYul.Stmt) :=
  embedConcreteSwitchCasesFuel (sizeOf cases + 1) cases

noncomputable def embedConcreteFunctionDef
    (fn : ConcreteYul.FunctionDef) : FullYul.FunctionDef :=
  { params := fn.params
    returns := fn.returns
    body := embedConcreteStmt fn.body }

noncomputable def embedConcreteNamedFunctionDef
    (name : FullYul.Name) (fn : ConcreteYul.FunctionDef) :
    FullYul.FunctionDef :=
  { params := fn.params
    returns := fn.returns
    body :=
      embedConcreteStmtFuel
        (sizeOf
          (ConcreteYul.Stmt.funDef name fn.params fn.returns fn.body))
        fn.body }

noncomputable def embedConcreteFunctionEnv :
    ConcreteYul.FunctionEnv -> FullYul.FunctionEnv
  | [] => []
  | (name, fn) :: rest =>
      (name, embedConcreteNamedFunctionDef name fn) ::
        embedConcreteFunctionEnv rest

def embedConcreteFlow : ConcreteYul.Flow -> FullYul.Flow
  | ConcreteYul.Flow.normal => FullYul.Flow.normal
  | ConcreteYul.Flow.broke => FullYul.Flow.broke
  | ConcreteYul.Flow.continued => FullYul.Flow.continued
  | ConcreteYul.Flow.left => FullYul.Flow.left
  | ConcreteYul.Flow.halted => FullYul.Flow.halted

def embedCompleteFlow : ConcreteYul.CompleteFlow -> FullYul.Flow
  | ConcreteYul.CompleteFlow.normal => FullYul.Flow.normal
  | ConcreteYul.CompleteFlow.broke => FullYul.Flow.broke
  | ConcreteYul.CompleteFlow.continued => FullYul.Flow.continued
  | ConcreteYul.CompleteFlow.left => FullYul.Flow.left
  | ConcreteYul.CompleteFlow.halted => FullYul.Flow.halted

theorem embedCompleteFlow_eq_normal_iff
    {flow : ConcreteYul.CompleteFlow} :
    embedCompleteFlow flow = FullYul.Flow.normal ↔
      flow = ConcreteYul.CompleteFlow.normal := by
  cases flow <;> simp [embedCompleteFlow]

def runtimeLoopRecurFlow (flow : ConcreteYul.CompleteFlow) : Prop :=
  flow = ConcreteYul.CompleteFlow.normal ∨
    flow = ConcreteYul.CompleteFlow.continued

def runtimeLoopTerminalFlow (flow : ConcreteYul.CompleteFlow) : Prop :=
  flow = ConcreteYul.CompleteFlow.broke ∨
    flow = ConcreteYul.CompleteFlow.left ∨
      flow = ConcreteYul.CompleteFlow.halted

def runtimeLoopRestoredResult
    (flow : ConcreteYul.CompleteFlow)
    (config : ConcreteYul.RuntimeConfig) : ConcreteYul.RuntimeResult :=
  match flow with
  | ConcreteYul.CompleteFlow.broke => ConcreteYul.runtimeNormalResult config
  | ConcreteYul.CompleteFlow.left =>
      { flow := ConcreteYul.CompleteFlow.left, config := config }
  | ConcreteYul.CompleteFlow.halted =>
      { flow := ConcreteYul.CompleteFlow.halted, config := config }
  | ConcreteYul.CompleteFlow.normal => ConcreteYul.runtimeNormalResult config
  | ConcreteYul.CompleteFlow.continued =>
      { flow := ConcreteYul.CompleteFlow.continued, config := config }

def runtimeLoopRestoredGuidedResult
    (flow : ConcreteYul.CompleteFlow)
    (config : SymYul.GuidedConfig) : SymYul.GuidedResult :=
  match flow with
  | ConcreteYul.CompleteFlow.broke => SymYul.guidedNormalResult config
  | ConcreteYul.CompleteFlow.left =>
      { flow := FullYul.Flow.left, config := config }
  | ConcreteYul.CompleteFlow.halted =>
      { flow := FullYul.Flow.halted, config := config }
  | ConcreteYul.CompleteFlow.normal => SymYul.guidedNormalResult config
  | ConcreteYul.CompleteFlow.continued =>
      { flow := FullYul.Flow.continued, config := config }

theorem runtimeLoopFlow_recur_or_terminal
    (flow : ConcreteYul.CompleteFlow) :
    runtimeLoopRecurFlow flow ∨ runtimeLoopTerminalFlow flow := by
  cases flow <;> simp [runtimeLoopRecurFlow, runtimeLoopTerminalFlow]

theorem runtimeLoopRecurFlow_elim
    {flow : ConcreteYul.CompleteFlow} {P : Prop}
    (hFlow : runtimeLoopRecurFlow flow)
    (hNormal : flow = ConcreteYul.CompleteFlow.normal -> P)
    (hContinued : flow = ConcreteYul.CompleteFlow.continued -> P) :
    P := by
  rcases hFlow with hNormal' | hContinued'
  · exact hNormal hNormal'
  · exact hContinued hContinued'

theorem runtimeLoopTerminalFlow_elim
    {flow : ConcreteYul.CompleteFlow} {P : Prop}
    (hFlow : runtimeLoopTerminalFlow flow)
    (hBroke : flow = ConcreteYul.CompleteFlow.broke -> P)
    (hLeft : flow = ConcreteYul.CompleteFlow.left -> P)
    (hHalted : flow = ConcreteYul.CompleteFlow.halted -> P) :
    P := by
  rcases hFlow with hBroke' | hLeftOrHalted
  · exact hBroke hBroke'
  · rcases hLeftOrHalted with hLeft' | hHalted'
    · exact hLeft hLeft'
    · exact hHalted hHalted'

theorem runtimeLoopRecurPairFlow_elim
    {bodyFlow postFlow : ConcreteYul.CompleteFlow} {P : Prop}
    (hBodyFlow : runtimeLoopRecurFlow bodyFlow)
    (hPostFlow : runtimeLoopRecurFlow postFlow)
    (hNormalNormal :
      bodyFlow = ConcreteYul.CompleteFlow.normal ->
      postFlow = ConcreteYul.CompleteFlow.normal ->
      P)
    (hNormalContinued :
      bodyFlow = ConcreteYul.CompleteFlow.normal ->
      postFlow = ConcreteYul.CompleteFlow.continued ->
      P)
    (hContinuedNormal :
      bodyFlow = ConcreteYul.CompleteFlow.continued ->
      postFlow = ConcreteYul.CompleteFlow.normal ->
      P)
    (hContinuedContinued :
      bodyFlow = ConcreteYul.CompleteFlow.continued ->
      postFlow = ConcreteYul.CompleteFlow.continued ->
      P) :
    P :=
  runtimeLoopRecurFlow_elim hBodyFlow
    (fun hBodyNormal =>
      runtimeLoopRecurFlow_elim hPostFlow
        (hNormalNormal hBodyNormal)
        (hNormalContinued hBodyNormal))
    (fun hBodyContinued =>
      runtimeLoopRecurFlow_elim hPostFlow
        (hContinuedNormal hBodyContinued)
        (hContinuedContinued hBodyContinued))

theorem runtimeLoopRecurTerminalFlow_elim
    {bodyFlow postFlow : ConcreteYul.CompleteFlow} {P : Prop}
    (hBodyFlow : runtimeLoopRecurFlow bodyFlow)
    (hPostFlow : runtimeLoopTerminalFlow postFlow)
    (hNormalBroke :
      bodyFlow = ConcreteYul.CompleteFlow.normal ->
      postFlow = ConcreteYul.CompleteFlow.broke ->
      P)
    (hNormalLeft :
      bodyFlow = ConcreteYul.CompleteFlow.normal ->
      postFlow = ConcreteYul.CompleteFlow.left ->
      P)
    (hNormalHalted :
      bodyFlow = ConcreteYul.CompleteFlow.normal ->
      postFlow = ConcreteYul.CompleteFlow.halted ->
      P)
    (hContinuedBroke :
      bodyFlow = ConcreteYul.CompleteFlow.continued ->
      postFlow = ConcreteYul.CompleteFlow.broke ->
      P)
    (hContinuedLeft :
      bodyFlow = ConcreteYul.CompleteFlow.continued ->
      postFlow = ConcreteYul.CompleteFlow.left ->
      P)
    (hContinuedHalted :
      bodyFlow = ConcreteYul.CompleteFlow.continued ->
      postFlow = ConcreteYul.CompleteFlow.halted ->
      P) :
    P :=
  runtimeLoopRecurFlow_elim hBodyFlow
    (fun hBodyNormal =>
      runtimeLoopTerminalFlow_elim hPostFlow
        (hNormalBroke hBodyNormal)
        (hNormalLeft hBodyNormal)
        (hNormalHalted hBodyNormal))
    (fun hBodyContinued =>
      runtimeLoopTerminalFlow_elim hPostFlow
        (hContinuedBroke hBodyContinued)
        (hContinuedLeft hBodyContinued)
        (hContinuedHalted hBodyContinued))

def runtimeFunctionReturnFlow (flow : ConcreteYul.CompleteFlow) : Prop :=
  flow = ConcreteYul.CompleteFlow.normal ∨
    flow = ConcreteYul.CompleteFlow.left

theorem runtimeFunctionReturnFlow_elim
    {flow : ConcreteYul.CompleteFlow} {P : Prop}
    (hFlow : runtimeFunctionReturnFlow flow)
    (hNormal : flow = ConcreteYul.CompleteFlow.normal -> P)
    (hLeft : flow = ConcreteYul.CompleteFlow.left -> P) :
    P := by
  rcases hFlow with hNormal' | hLeft'
  · exact hNormal hNormal'
  · exact hLeft hLeft'

private theorem evalRuntimeStmtFuel_forLoop_pre_non_normal_restore
    {hash : ConcreteYul.HashOracle} {fuel : Nat}
    {config : ConcreteYul.RuntimeConfig}
    {pre post body : ConcreteYul.Stmt} {cond : ConcreteYul.Expr}
    {preResult result : ConcreteYul.RuntimeResult}
    (hFlow : preResult.flow ≠ ConcreteYul.CompleteFlow.normal)
    (hPre :
      ConcreteYul.evalRuntimeStmtFuel hash fuel config pre =
        some preResult)
    (hEval :
      ConcreteYul.evalRuntimeStmtFuel hash fuel.succ config
          (ConcreteYul.Stmt.forLoop pre cond post body) =
        some result) :
    ConcreteYul.withRestoredRuntimeConfig config preResult = some result := by
  rcases preResult with ⟨flow, preConfig⟩
  cases flow with
  | normal =>
      exact False.elim (hFlow rfl)
  | broke =>
      simpa [ConcreteYul.evalRuntimeStmtFuel, hPre] using hEval
  | continued =>
      simpa [ConcreteYul.evalRuntimeStmtFuel, hPre] using hEval
  | left =>
      simpa [ConcreteYul.evalRuntimeStmtFuel, hPre] using hEval
  | halted =>
      simpa [ConcreteYul.evalRuntimeStmtFuel, hPre] using hEval

private theorem evalRuntimeStmtFuel_forLoop_pre_non_normal_of_restore
    {hash : ConcreteYul.HashOracle} {fuel : Nat}
    {config : ConcreteYul.RuntimeConfig}
    {pre post body : ConcreteYul.Stmt} {cond : ConcreteYul.Expr}
    {preResult restored : ConcreteYul.RuntimeResult}
    (hFlow : preResult.flow ≠ ConcreteYul.CompleteFlow.normal)
    (hPre :
      ConcreteYul.evalRuntimeStmtFuel hash fuel config pre =
        some preResult)
    (hRestore :
      ConcreteYul.withRestoredRuntimeConfig config preResult =
        some restored) :
    ConcreteYul.evalRuntimeStmtFuel hash fuel.succ config
        (ConcreteYul.Stmt.forLoop pre cond post body) =
      some restored := by
  rcases preResult with ⟨flow, preConfig⟩
  cases flow with
  | normal =>
      exact False.elim (hFlow rfl)
  | broke =>
      simpa [ConcreteYul.evalRuntimeStmtFuel, hPre] using hRestore
  | continued =>
      simpa [ConcreteYul.evalRuntimeStmtFuel, hPre] using hRestore
  | left =>
      simpa [ConcreteYul.evalRuntimeStmtFuel, hPre] using hRestore
  | halted =>
      simpa [ConcreteYul.evalRuntimeStmtFuel, hPre] using hRestore

private theorem evalRuntimeBlockFuel_cons_non_normal_of_head
    {hash : ConcreteYul.HashOracle} {fuel : Nat}
    {config : ConcreteYul.RuntimeConfig}
    {stmt : ConcreteYul.Stmt} {rest : List ConcreteYul.Stmt}
    {result : ConcreteYul.RuntimeResult}
    (hFlow : result.flow ≠ ConcreteYul.CompleteFlow.normal)
    (hHead :
      ConcreteYul.evalRuntimeStmtFuel hash fuel config stmt = some result) :
    ConcreteYul.evalRuntimeBlockFuel hash fuel.succ config (stmt :: rest) =
      some result := by
  rcases result with ⟨flow, resultConfig⟩
  cases flow with
  | normal => exact False.elim (hFlow rfl)
  | broke =>
      simp [ConcreteYul.evalRuntimeBlockFuel, hHead]
  | continued =>
      simp [ConcreteYul.evalRuntimeBlockFuel, hHead]
  | left =>
      simp [ConcreteYul.evalRuntimeBlockFuel, hHead]
  | halted =>
      simp [ConcreteYul.evalRuntimeBlockFuel, hHead]

private theorem evalRuntimeBlockFuel_cons_non_normal_result_eq
    {hash : ConcreteYul.HashOracle} {fuel : Nat}
    {config : ConcreteYul.RuntimeConfig}
    {stmt : ConcreteYul.Stmt} {rest : List ConcreteYul.Stmt}
    {headResult result : ConcreteYul.RuntimeResult}
    (hFlow : headResult.flow ≠ ConcreteYul.CompleteFlow.normal)
    (hHead :
      ConcreteYul.evalRuntimeStmtFuel hash fuel config stmt =
        some headResult)
    (hBlock :
      ConcreteYul.evalRuntimeBlockFuel hash fuel.succ config
          (stmt :: rest) =
        some result) :
    result = headResult := by
  have hEval :
      ConcreteYul.evalRuntimeBlockFuel hash fuel.succ config
          (stmt :: rest) =
        some headResult :=
    evalRuntimeBlockFuel_cons_non_normal_of_head hFlow hHead
  rw [hEval] at hBlock
  exact (Option.some.inj hBlock).symm

private theorem evalRuntimeStmtFuel_seq_first_non_normal_of_head
    {hash : ConcreteYul.HashOracle} {fuel : Nat}
    {config : ConcreteYul.RuntimeConfig}
    {first second : ConcreteYul.Stmt}
    {result : ConcreteYul.RuntimeResult}
    (hFlow : result.flow ≠ ConcreteYul.CompleteFlow.normal)
    (hFirst :
      ConcreteYul.evalRuntimeStmtFuel hash fuel
          { config with
            funcs :=
              ConcreteYul.collectStmtFunctionDefs
                (ConcreteYul.Stmt.seq first second) config.funcs }
          first =
        some result) :
    ConcreteYul.evalRuntimeStmtFuel hash fuel.succ config
        (ConcreteYul.Stmt.seq first second) =
      some result := by
  rcases result with ⟨flow, resultConfig⟩
  cases flow with
  | normal => exact False.elim (hFlow rfl)
  | broke =>
      simp [ConcreteYul.evalRuntimeStmtFuel, hFirst]
  | continued =>
      simp [ConcreteYul.evalRuntimeStmtFuel, hFirst]
  | left =>
      simp [ConcreteYul.evalRuntimeStmtFuel, hFirst]
  | halted =>
      simp [ConcreteYul.evalRuntimeStmtFuel, hFirst]

private theorem evalRuntimeStmtFuel_seq_first_non_normal_result_eq
    {hash : ConcreteYul.HashOracle} {fuel : Nat}
    {config : ConcreteYul.RuntimeConfig}
    {first second : ConcreteYul.Stmt}
    {firstResult result : ConcreteYul.RuntimeResult}
    (hFlow : firstResult.flow ≠ ConcreteYul.CompleteFlow.normal)
    (hFirst :
      ConcreteYul.evalRuntimeStmtFuel hash fuel
          { config with
            funcs :=
              ConcreteYul.collectStmtFunctionDefs
                (ConcreteYul.Stmt.seq first second) config.funcs }
          first =
        some firstResult)
    (hSeq :
      ConcreteYul.evalRuntimeStmtFuel hash fuel.succ config
          (ConcreteYul.Stmt.seq first second) =
        some result) :
    result = firstResult := by
  have hEval :
      ConcreteYul.evalRuntimeStmtFuel hash fuel.succ config
          (ConcreteYul.Stmt.seq first second) =
        some firstResult :=
    evalRuntimeStmtFuel_seq_first_non_normal_of_head hFlow hFirst
  rw [hEval] at hSeq
  exact (Option.some.inj hSeq).symm

