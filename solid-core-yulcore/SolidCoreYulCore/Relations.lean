theorem collectBlockFunctionDefs_embedRuntimeCoveredBlock
    {DataOffsetOK : FullYul.DataLabel -> Prop}
    {BuiltinExprOK BuiltinValuesOK :
      Evm.Builtin -> List ConcreteYul.Expr -> Prop}
    {FunctionOK : FullYul.Name -> List ConcreteYul.Expr -> Prop}
    {length : Nat} {stmts : List ConcreteYul.Stmt}
    (hCovered :
      RuntimeCoveredBlock DataOffsetOK BuiltinExprOK BuiltinValuesOK
        FunctionOK length stmts)
    (fuel : Nat)
    {concreteFuncs : ConcreteYul.FunctionEnv}
    {symbolicFuncs : FullYul.FunctionEnv}
    (hFuncs : symbolicFuncs = embedConcreteFunctionEnv concreteFuncs) :
    SymYul.collectBlockFunctionDefs
        (embedConcreteStmtsFuel (fuel + length + 2) stmts)
        symbolicFuncs =
      embedConcreteFunctionEnv
        (ConcreteYul.collectBlockFunctionDefs stmts concreteFuncs) :=
  (RuntimeCoveredBlock.foldLeafRel
    (C := ConcreteYul.FunctionEnv)
    (S := FullYul.FunctionEnv)
    (ConfigRel := fun concreteFuncs symbolicFuncs =>
      symbolicFuncs = embedConcreteFunctionEnv concreteFuncs)
    (StmtRel := fun fuel concreteFuncs symbolicFuncs stmt =>
      ConcreteYul.collectStmtFunctionDefs stmt concreteFuncs =
        concreteFuncs ∧
      SymYul.collectStmtFunctionDefs
          (embedConcreteStmtFuel fuel stmt) symbolicFuncs =
        symbolicFuncs)
    (BlockRel := fun fuel concreteFuncs symbolicFuncs stmts =>
      symbolicFuncs = embedConcreteFunctionEnv concreteFuncs ->
        SymYul.collectBlockFunctionDefs
            (embedConcreteStmtsFuel fuel stmts) symbolicFuncs =
          embedConcreteFunctionEnv
            (ConcreteYul.collectBlockFunctionDefs stmts concreteFuncs))
    (stmtRel := fun {_stmt} hStmt {_fuel} {_concreteFuncs}
        {_symbolicFuncs} =>
      ⟨ collectStmtFunctionDefs_runtimeCoveredStmt_stable hStmt
      , collectStmtFunctionDefs_embedRuntimeCoveredStmt_stable_any
          _ hStmt ⟩)
    (blockAlg :=
      { nil := by
          intro fuel concreteFuncs symbolicFuncs hFuncs
          cases fuel <;>
            simp [embedConcreteStmtsFuel, ConcreteYul.collectBlockFunctionDefs,
              SymYul.collectBlockFunctionDefs, hFuncs]
        cons := by
          intro fuel concreteFuncs symbolicFuncs stmt rest hStmt hTail hFuncs
          rcases hStmt with ⟨hConcreteHead, hSymbolicHead⟩
          simpa [embedConcreteStmtsFuel,
            ConcreteYul.collectBlockFunctionDefs,
            SymYul.collectBlockFunctionDefs, hConcreteHead, hSymbolicHead]
            using hTail hFuncs hFuncs })
    hCovered (fuel := fuel) (concreteConfig := concreteFuncs)
    (symbolicConfig := symbolicFuncs)) hFuncs

