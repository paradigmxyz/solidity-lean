theorem runtimeExprExactRelSim_mcopy_nonzero
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    (concreteConfig : ConcreteYul.RuntimeConfig)
    (symbolicConfig : SymYul.GuidedConfig) (dest source size : Word)
    (hSize : norm size ≠ 0)
    (hMemorySize :
      norm
        (FullYul.recordMemoryWrite
          (FullYul.expandMemory
            { symbolicConfig.evm with
              memoryWords := []
              memoryBytes :=
                FullYul.ObjectMemory.write symbolicConfig.evm.memoryBytes
                  (norm dest)
                  (FullYul.SymbolicBytes.memorySnapshot
                    symbolicConfig.evm.memoryVersion
                    (norm source) (norm size)) }
            (norm source) (norm size))
          (norm dest) (norm size)).msize =
        norm
          ({ ConcreteYul.expandMemory
              (ConcreteYul.setMemoryAfterAccess concreteConfig.state
                (ConcreteYul.copyBytes concreteConfig.state.memory
                  (norm dest) concreteConfig.state.memory (norm source)
                  (norm size))
                (norm dest) (norm size))
              (norm source) (norm size) with
            memory :=
              ConcreteYul.copyBytes concreteConfig.state.memory
                (norm dest) concreteConfig.state.memory (norm source)
                (norm size) }).memorySize) :
    RuntimeExprExactRelSim model hash concreteConfig symbolicConfig
      (ConcreteYul.Expr.builtin Evm.Builtin.mcopyOp
        [ ConcreteYul.Expr.word dest
        , ConcreteYul.Expr.word source
        , ConcreteYul.Expr.word size ]) := by
  intro hExact concreteValue concreteConfig' hConcrete
  have hConcreteExpected :=
    (evalRuntimeExpr_mcopy_nonzero_memory_summary
      hash concreteConfig dest source size hSize).1
  rw [hConcreteExpected] at hConcrete
  cases hConcrete
  have hSizeNorm : norm (norm size) ≠ 0 := by
    simpa [norm_norm] using hSize
  exact
    ⟨ embedWordValue 0
    , { symbolicConfig with
        evm :=
          FullYul.recordMemoryWrite
            (FullYul.expandMemory
              { symbolicConfig.evm with
                memoryWords := []
                memoryBytes :=
                  FullYul.ObjectMemory.write symbolicConfig.evm.memoryBytes
                    (norm dest)
                    (FullYul.SymbolicBytes.memorySnapshot
                      symbolicConfig.evm.memoryVersion
                      (norm source) (norm size)) }
              (norm source) (norm size))
            (norm dest) (norm size) }
    , by
        simp [SymYul.guidedEvalExpr, SymYul.guidedEvalExprs,
          FullYul.evalEvmBuiltin_mcopy_words, hSize, FullYul.returnUnit,
          FullYul.returnWord, embedConcreteExpr, embedConcreteExprs,
          embedWordValue, norm_norm, norm_zero]
    , valueRel_embedWordValue model 0
    , runtimeConfigExactRel_symbolicMemorySummary_write_after_expand hExact
        (ConcreteYul.copyBytes concreteConfig.state.memory
          (norm dest) concreteConfig.state.memory (norm source) (norm size))
        (norm dest) (norm source) (norm size)
        (FullYul.SymbolicBytes.memorySnapshot
          symbolicConfig.evm.memoryVersion (norm source) (norm size))
        hSizeNorm hMemorySize ⟩

theorem runtimeExprExactRelSim_log_of_evals
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    (concreteConfig : ConcreteYul.RuntimeConfig)
    (symbolicConfig : SymYul.GuidedConfig)
    (expr : ConcreteYul.Expr) (arity : Nat) (offset size : Word)
    (topics : List Word) (symbolicTopics : List FullYul.Value)
    (hTopics : WordListRel model topics symbolicTopics)
    (hConcreteExpected :
      ConcreteYul.evalRuntimeExpr hash expr concreteConfig =
        some
          ( 0
          , { concreteConfig with
              state :=
                { ConcreteYul.expandMemory concreteConfig.state
                    (norm offset) (norm size) with
                  logs :=
                    ( arity
                    , topics
                    , ConcreteYul.readBytes concreteConfig.state.memory
                        (norm offset) (norm size)) ::
                      concreteConfig.state.logs } } ))
    (hGuidedExpected :
      SymYul.guidedEvalExpr symbolicConfig (embedConcreteExpr expr) =
        some
          ( embedWordValue 0
          , { symbolicConfig with
              evm :=
                { FullYul.expandMemory symbolicConfig.evm
                    (norm offset) (norm size) with
                  logs :=
                    ( arity
                    , symbolicTopics
                    , FullYul.SymbolicBytes.memorySnapshot
                        symbolicConfig.evm.memoryVersion
                        (norm offset) (norm size)) ::
                      symbolicConfig.evm.logs } } )) :
    RuntimeExprExactRelSim model hash concreteConfig symbolicConfig expr := by
  intro hExact concreteValue concreteConfig' hConcrete
  rw [hConcreteExpected] at hConcrete
  cases hConcrete
  exact
    ⟨ embedWordValue 0
    , { symbolicConfig with
        evm :=
          { FullYul.expandMemory symbolicConfig.evm
              (norm offset) (norm size) with
            logs :=
              ( arity
              , symbolicTopics
              , FullYul.SymbolicBytes.memorySnapshot
                  symbolicConfig.evm.memoryVersion
                  (norm offset) (norm size)) ::
                symbolicConfig.evm.logs } }
    , hGuidedExpected
    , valueRel_embedWordValue model 0
    , runtimeConfigExactRel_log hExact arity topics symbolicTopics
        (norm offset) (norm size) hTopics
        (bytesRel_memorySnapshot_readBytes_normed
          concreteConfig.state.memory symbolicConfig.evm.memoryVersion
          offset size) ⟩

