      ConcreteYul.collectStmtFunctionDefs
          (ConcreteYul.Stmt.seq first second) config.funcs =
        config.funcs)
    (hGuidedCollectFirst :
      SymYul.collectStmtFunctionDefs
          (embedConcreteStmtFuel embedFuel first)
          (embedConcreteFunctionEnv config.funcs) =
        embedConcreteFunctionEnv config.funcs)
    (hGuidedCollectSecond :
      SymYul.collectStmtFunctionDefs
          (embedConcreteStmtFuel embedFuel second)
          (embedConcreteFunctionEnv config.funcs) =
        embedConcreteFunctionEnv config.funcs)
    (hConcreteFirst :
      ConcreteYul.evalRuntimeStmtFuel hash fuel config first =
        some (ConcreteYul.runtimeNormalResult config'))
    (hGuidedFirst :
      SymYul.guidedEvalStmtFuel model fuel (embedRuntimeConfig config)
          (embedConcreteStmtFuel embedFuel first) =
        some (embedRuntimeResult (ConcreteYul.runtimeNormalResult config')))
    (hConcreteSecond :
      ConcreteYul.evalRuntimeStmtFuel hash fuel config' second = some result)
    (hGuidedSecond :
      SymYul.guidedEvalStmtFuel model fuel (embedRuntimeConfig config')
          (embedConcreteStmtFuel embedFuel second) =
        some (embedRuntimeResult result)) :
    ConcreteYul.evalRuntimeStmtFuel hash fuel.succ config
        (ConcreteYul.Stmt.seq first second) =
      some result ∧
    SymYul.guidedEvalStmtFuel model fuel.succ (embedRuntimeConfig config)
        (embedConcreteStmtFuel embedFuel.succ
          (ConcreteYul.Stmt.seq first second)) =
      some (embedRuntimeResult result) := by
  have hCollected :
      { config with
        funcs :=
          ConcreteYul.collectStmtFunctionDefs
            (ConcreteYul.Stmt.seq first second) config.funcs } = config := by
    cases config
    simp [hCollect]
  have hGuidedCollect :
      SymYul.collectStmtFunctionDefs
          (FullYul.Stmt.seq (embedConcreteStmtFuel embedFuel first)
            (embedConcreteStmtFuel embedFuel second))
          (embedConcreteFunctionEnv config.funcs) =
        embedConcreteFunctionEnv config.funcs :=
    guidedCollect_seq_stable_of_parts hGuidedCollectFirst hGuidedCollectSecond
  constructor
  · simp [ConcreteYul.evalRuntimeStmtFuel, hCollected, hConcreteFirst,
      hConcreteSecond, ConcreteYul.runtimeNormalResult]
  · cases fuel with
    | zero =>
        simp [SymYul.guidedEvalStmtFuel] at hGuidedFirst
    | succ fuel =>
        simp [SymYul.guidedEvalStmtFuel, embedConcreteStmtFuel,
          embedRuntimeConfig, hGuidedCollect]
        have hGuidedFirst' :
            SymYul.guidedEvalStmtFuel model (fuel + 1)
                { env := embedConcreteEnv config.env
                  evm := embedConcreteState config.state
                  funcs := embedConcreteFunctionEnv config.funcs
                  object? := some (embedConcreteObject config.object) }
                (embedConcreteStmtFuel embedFuel first) =
              some
                (embedRuntimeResult
                  (ConcreteYul.runtimeNormalResult config')) := by
          simpa [embedRuntimeConfig] using hGuidedFirst
        rw [hGuidedFirst']
        simp [SymYul.guidedBindNormal, embedRuntimeResult,
          ConcreteYul.runtimeNormalResult, embedCompleteFlow, hGuidedSecond]

private theorem evalRuntimeStmt_seq_non_normal_refines_guided_of_first
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    (fuel embedFuel : Nat) {config : ConcreteYul.RuntimeConfig}
    {first second : ConcreteYul.Stmt} {result : ConcreteYul.RuntimeResult}
    (hFlow : result.flow ≠ ConcreteYul.CompleteFlow.normal)
    (hConcreteFirst :
      ConcreteYul.evalRuntimeStmtFuel hash fuel
          { config with
            funcs :=
              ConcreteYul.collectStmtFunctionDefs
                (ConcreteYul.Stmt.seq first second) config.funcs }
