    have h := (Nat.sub_add_cancel hFuel).symm
    simpa [Nat.succ_eq_add_one, Nat.add_assoc] using h
  have hEmbedFuelEq :
      embedFuel = (embedFuel - 2).succ.succ := by
    have h := (Nat.sub_add_cancel hEmbedFuel).symm
    simpa [Nat.succ_eq_add_one, Nat.add_assoc] using h
  rw [hFuelEq, hEmbedFuelEq]
  exact
