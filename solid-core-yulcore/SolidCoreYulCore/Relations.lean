                    ⟨symbolicRestValues, symbolicRestConfig, hGuidedRest,
                      hRestValuesRel, hRestConfigExact⟩
                  have hExprSim := hExpr hRestConfigExact
                  rcases hExprSim hRestConfigExact value exprConfig
