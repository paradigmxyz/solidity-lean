        Option ConcreteYul.Stmt -> Prop}
    (bodyAlg :
      RuntimeStructuralBodyCoveredAlg spec BodyRel BlockRel SwitchRel)
    (blockAlg : RuntimeStructuralBlockCoveredAlg BodyRel BlockRel)
    (casesAlg :
      RuntimeStructuralSwitchCasesCoveredAlg BodyRel CasesRel)
    (defaultAlg :
      RuntimeStructuralSwitchDefaultCoveredAlg BodyRel DefaultRel)
    (switchAlg :
      RuntimeStructuralSwitchCoveredAlg spec CasesRel DefaultRel
        SwitchRel) :
    ∀ {baseFuel casesLength : Nat}
      {defaultBranch : Option ConcreteYul.Stmt},
      RuntimeStructuralSwitchDefaultCoveredSpec spec baseFuel casesLength
        defaultBranch ->
      DefaultRel baseFuel casesLength defaultBranch
  | _, _, _, RuntimeStructuralSwitchDefaultCoveredSpec.none =>
      defaultAlg.none
  | _, _, _, RuntimeStructuralSwitchDefaultCoveredSpec.some hBody hEmbed =>
      defaultAlg.some
        (RuntimeStructuralBodyCoveredSpec.foldRel bodyAlg blockAlg casesAlg
          defaultAlg switchAlg hBody)
        hEmbed

theorem RuntimeStructuralSwitchCoveredSpec.foldRel
    {spec : RuntimeCoverageSpec}
    {BodyRel : Nat -> ConcreteYul.Stmt -> Prop}
    {BlockRel : Nat -> List ConcreteYul.Stmt -> Prop}
    {CasesRel : Nat -> List (Word × ConcreteYul.Stmt) -> Prop}
    {DefaultRel : Nat -> Nat -> Option ConcreteYul.Stmt -> Prop}
    {SwitchRel :
      Nat -> ConcreteYul.Expr -> List (Word × ConcreteYul.Stmt) ->
        Option ConcreteYul.Stmt -> Prop}
    (bodyAlg :
      RuntimeStructuralBodyCoveredAlg spec BodyRel BlockRel SwitchRel)
    (blockAlg : RuntimeStructuralBlockCoveredAlg BodyRel BlockRel)
    (casesAlg :
      RuntimeStructuralSwitchCasesCoveredAlg BodyRel CasesRel)
    (defaultAlg :
      RuntimeStructuralSwitchDefaultCoveredAlg BodyRel DefaultRel)
    (switchAlg :
      RuntimeStructuralSwitchCoveredAlg spec CasesRel DefaultRel
        SwitchRel) :
    ∀ {baseFuel : Nat} {discr : ConcreteYul.Expr}
      {cases : List (Word × ConcreteYul.Stmt)}
      {defaultBranch : Option ConcreteYul.Stmt},
      RuntimeStructuralSwitchCoveredSpec spec baseFuel discr cases
        defaultBranch ->
      SwitchRel baseFuel discr cases defaultBranch
  | _, _, _, _, RuntimeStructuralSwitchCoveredSpec.intro hDiscr hCases
        hDefault =>
      switchAlg.intro hDiscr
        (RuntimeStructuralSwitchCasesCoveredSpec.foldRel bodyAlg blockAlg
          casesAlg defaultAlg switchAlg hCases)
        (RuntimeStructuralSwitchDefaultCoveredSpec.foldRel bodyAlg blockAlg
          casesAlg defaultAlg switchAlg hDefault)
end

