      (hash.verbatimValues (Evm.Builtin.verbatimOp inputs 2) args).map norm =
        results)
    (hResultsRel :
      WordListRel model results
        (FullYul.externalValueResults symbolic.nextExternalId 2)) :
    ConcreteYul.evalBuiltinValues hash (Evm.Builtin.verbatimOp inputs 2)
        args concrete =
      some
        ( results
        , ConcreteYul.recordExternalAction (Evm.Builtin.verbatimOp inputs 2)
            args concrete ) ∧
    FullYul.evalEvmBuiltinValues (Evm.Builtin.verbatimOp inputs 2)
        (embedWordValues args) symbolic =
      some
        (FullYul.recordExternalValueEvents (Evm.Builtin.verbatimOp inputs 2)
          (embedWordValues args) 2 symbolic) ∧
    WordListRel model results
        (FullYul.recordExternalValueEvents (Evm.Builtin.verbatimOp inputs 2)
          (embedWordValues args) 2 symbolic).1 ∧
    EvmStateRel model
      (ConcreteYul.recordExternalAction (Evm.Builtin.verbatimOp inputs 2)
        args concrete)
      (FullYul.recordExternalValueEvents (Evm.Builtin.verbatimOp inputs 2)
        (embedWordValues args) 2 symbolic).2 := by
  have hLen : results.length = 2 :=
    wordListRel_externalValueResults_length hResultsRel
  have hRecord :=
    evmStateRel_recordExternalValueEvents hRel
      (Evm.Builtin.verbatimOp inputs 2) args (embedWordValues args)
      results 2 hResultsRel
  constructor
  · simp [ConcreteYul.evalBuiltinValues, hArgs, hResults, hLen]
  constructor
  · simp [FullYul.evalEvmBuiltinValues, embedWordValues_length, hArgs]
  · exact hRecord

