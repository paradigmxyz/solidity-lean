    RuntimeProgramBodyCoveredSpec RuntimeSignaturedCoverageSpec program :=
  let hCoveredExists :=
    runtimeStructuralBodyCoveredSpec_signatured_of_checkStmtFuel_embed hCheck
  { minEmbedFuel := Classical.choose hCoveredExists
