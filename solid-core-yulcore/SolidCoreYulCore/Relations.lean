        RuntimeNamedStructuralFunctionBodyCoveredSpec.intro minEmbedFuel
          (RuntimeStructuralBodyCoveredSpec.legacy hBody) hEmbed

structure RuntimeCoverageSpecLe
    (source target : RuntimeCoverageSpec) : Prop where
  dataOffset :
    ∀ {label : FullYul.DataLabel},
      source.DataOffsetOK label -> target.DataOffsetOK label
  builtinExpr :
    ∀ {builtin : Evm.Builtin} {args : List ConcreteYul.Expr},
      source.BuiltinExprOK builtin args ->
        target.BuiltinExprOK builtin args
  builtinValues :
    ∀ {builtin : Evm.Builtin} {args : List ConcreteYul.Expr},
      source.BuiltinValuesOK builtin args ->
        target.BuiltinValuesOK builtin args
  function :
    ∀ {fnName : FullYul.Name} {args : List ConcreteYul.Expr},
      source.FunctionOK fnName args -> target.FunctionOK fnName args

theorem RuntimeCoverageSpecLe.refl (spec : RuntimeCoverageSpec) :
    RuntimeCoverageSpecLe spec spec where
  dataOffset hOK := hOK
  builtinExpr hOK := hOK
  builtinValues hOK := hOK
  function hOK := hOK

theorem RuntimeCoverageSpecLe.trans
    {first second third : RuntimeCoverageSpec}
    (hFirstSecond : RuntimeCoverageSpecLe first second)
    (hSecondThird : RuntimeCoverageSpecLe second third) :
    RuntimeCoverageSpecLe first third where
  dataOffset hOK := hSecondThird.dataOffset (hFirstSecond.dataOffset hOK)
  builtinExpr hOK :=
    hSecondThird.builtinExpr (hFirstSecond.builtinExpr hOK)
  builtinValues hOK :=
    hSecondThird.builtinValues (hFirstSecond.builtinValues hOK)
  function hOK := hSecondThird.function (hFirstSecond.function hOK)

