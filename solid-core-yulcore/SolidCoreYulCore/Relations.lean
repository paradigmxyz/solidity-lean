theorem runtimeStructuralSwitchCasesCoveredSpec_target_guided
    (model : SymYul.ConcreteModel)
    {spec : RuntimeCoverageSpec}
    {baseFuel defaultCasesLength defaultEmbedFuel : Nat}
    {value : Word} {cases : List (Word × ConcreteYul.Stmt)}
    {defaultBranch : Option ConcreteYul.Stmt}
    {target : ConcreteYul.Stmt}
    (hCases :
      RuntimeStructuralSwitchCasesCoveredSpec spec baseFuel cases)
    (hDefault :
      RuntimeStructuralSwitchDefaultCoveredSpec spec baseFuel
        defaultCasesLength defaultBranch)
    (hDefaultFuel :
      defaultCasesLength + baseFuel + 2 ≤ defaultEmbedFuel)
    (hTarget :
      ConcreteYul.switchTarget? value cases defaultBranch = some target) :
    ∃ targetEmbedFuel, ∃ minEmbedFuel,
      RuntimeStructuralBodyCoveredSpec spec minEmbedFuel target ∧
      minEmbedFuel ≤ targetEmbedFuel ∧
      ∀ symbolicValue,
        ValueRel model value symbolicValue ->
        SymYul.guidedSwitchTarget? model symbolicValue
            (embedConcreteSwitchCasesFuel
              (cases.length + baseFuel + 2) cases)
            (defaultBranch.map (embedConcreteStmtFuel defaultEmbedFuel)) =
          some (embedConcreteStmtFuel targetEmbedFuel target) := by
  induction cases generalizing target defaultBranch with
  | nil =>
      cases hCases
      cases defaultBranch with
      | none =>
          simp [ConcreteYul.switchTarget?] at hTarget
      | some branch =>
          cases hDefault with
          | some hBody hBodyEmbed =>
              have hEq : branch = target := by
                simpa [ConcreteYul.switchTarget?] using hTarget
              subst target
              exact
                ⟨ defaultEmbedFuel
                , _
                , hBody
                , by omega
                , by
                    intro symbolicValue _hValueRel
                    simp [embedConcreteSwitchCasesFuel,
                      SymYul.guidedSwitchTarget?] ⟩
  | cons switchCase rest ih =>
      rcases switchCase with ⟨label, branch⟩
      cases hCases with
      | cons hBranch hBranchEmbed hRest =>
          rename_i branchEmbedFuel
          by_cases hMatch : norm label = norm value
          · have hEq : branch = target := by
              simpa [ConcreteYul.switchTarget?, hMatch] using hTarget
            subst target
            exact
              ⟨ rest.length + baseFuel + 2
              , branchEmbedFuel
              , hBranch
              , hBranchEmbed
              , by
                  intro symbolicValue hValueRel
                  have hGuidedMatch :
                      norm (SymYul.interpValue model symbolicValue) =
                        norm (SymYul.interpValue model
                          (embedWordValue label)) := by
                    have hLeft :
                        norm (SymYul.interpValue model symbolicValue) =
                          norm value := by
                      rw [interpValue_norm model symbolicValue, ← hValueRel]
                    have hRight :
                        norm (SymYul.interpValue model (embedWordValue label)) =
                          norm label := by
                      simp [SymYul.interpValue, embedWordValue, norm_norm]
                    calc
                      norm (SymYul.interpValue model symbolicValue) =
                          norm value :=
                        hLeft
                      _ = norm label := hMatch.symm
                      _ = norm
                          (SymYul.interpValue model (embedWordValue label)) :=
                        hRight.symm
                  simp [embedConcreteSwitchCasesFuel,
                    SymYul.guidedSwitchTarget?, hGuidedMatch, Nat.add_assoc,
                    Nat.add_left_comm, Nat.add_comm] ⟩
          · have hRestTarget :
                ConcreteYul.switchTarget? value rest defaultBranch =
                  some target := by
              simpa [ConcreteYul.switchTarget?, hMatch] using hTarget
            rcases
                ih hRest hDefault hRestTarget with
              ⟨targetEmbedFuel, minEmbedFuel, hBody, hEmbedFuel,
                hGuidedRest⟩
            exact
              ⟨ targetEmbedFuel
              , minEmbedFuel
              , hBody
              , hEmbedFuel
              , by
                  intro symbolicValue hValueRel
                  have hGuidedNe :
                      norm (SymYul.interpValue model symbolicValue) ≠
                        norm (SymYul.interpValue model
                          (embedWordValue label)) := by
                    intro hEq
                    apply hMatch
                    have hLeft :
                        norm (SymYul.interpValue model symbolicValue) =
                          norm value := by
                      rw [interpValue_norm model symbolicValue, ← hValueRel]
                    have hRight :
                        norm (SymYul.interpValue model
                            (embedWordValue label)) =
                          norm label := by
                      simp [SymYul.interpValue, embedWordValue, norm_norm]
                    calc
                      norm label =
                          norm (SymYul.interpValue model
                            (embedWordValue label)) :=
                        hRight.symm
                      _ = norm (SymYul.interpValue model symbolicValue) :=
                        hEq.symm
                      _ = norm value := hLeft
                  have hGuidedRest' := hGuidedRest symbolicValue hValueRel
                  simp only [embedConcreteSwitchCasesFuel,
                    SymYul.guidedSwitchTarget?]
                  rw [if_neg hGuidedNe]
                  simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm]
                    using hGuidedRest' ⟩

