theorem runtimeFunctionBodyBlockCoveredSpec_mono
    {spec : RuntimeCoverageSpec}
    {oldEmbedFuel newEmbedFuel : Nat}
    {stmts : List ConcreteYul.Stmt}
    (hCovered :
      RuntimeFunctionBodyBlockCoveredSpec spec oldEmbedFuel stmts)
    (hLe : oldEmbedFuel ≤ newEmbedFuel) :
    RuntimeFunctionBodyBlockCoveredSpec spec newEmbedFuel stmts := by
  induction hCovered generalizing newEmbedFuel with
  | nil =>
      exact RuntimeFunctionBodyBlockCoveredSpec.nil
  | cons hStmt hStmtEmbed _hRest ih =>
      cases newEmbedFuel with
      | zero =>
          cases hLe
      | succ newEmbedFuel =>
          have hInnerLe : _ ≤ newEmbedFuel :=
            Nat.succ_le_succ_iff.mp hLe
          exact
            RuntimeFunctionBodyBlockCoveredSpec.cons hStmt
              (Nat.le_trans hStmtEmbed hInnerLe) (ih hInnerLe)

theorem collectBlockFunctionDefs_embedRuntimeFunctionBodyBlockCovered_rel
    {spec : RuntimeCoverageSpec}
    {embedFuel : Nat} {stmts : List ConcreteYul.Stmt}
    {concreteFuncs : ConcreteYul.FunctionEnv}
    {symbolicFuncs : FullYul.FunctionEnv}
    (hCovered :
      RuntimeFunctionBodyBlockCoveredSpec spec embedFuel stmts)
    (hFuncs : symbolicFuncs = embedConcreteFunctionEnv concreteFuncs) :
    SymYul.collectBlockFunctionDefs
        (embedConcreteStmtsFuel embedFuel stmts) symbolicFuncs =
      embedConcreteFunctionEnv
        (ConcreteYul.collectBlockFunctionDefs stmts concreteFuncs) := by
  induction hCovered generalizing concreteFuncs symbolicFuncs with
  | nil =>
      rename_i blockEmbedFuel
      cases blockEmbedFuel <;>
        simp [embedConcreteStmtsFuel, ConcreteYul.collectBlockFunctionDefs,
          SymYul.collectBlockFunctionDefs, hFuncs]
  | cons hStmt hStmtEmbed _hRest ih =>
      have hStmtRel :
          SymYul.collectStmtFunctionDefs
              (embedConcreteStmtFuel _ _) symbolicFuncs =
            embedConcreteFunctionEnv
              (ConcreteYul.collectStmtFunctionDefs _ concreteFuncs) :=
        collectStmtFunctionDefs_embedRuntimeFunctionBodyCovered_rel_ge
          hStmt hStmtEmbed hFuncs
      have hRestRel :=
        ih (concreteFuncs :=
              ConcreteYul.collectStmtFunctionDefs _ concreteFuncs)
          (symbolicFuncs :=
            SymYul.collectStmtFunctionDefs
              (embedConcreteStmtFuel _ _) symbolicFuncs)
          hStmtRel
      simp [embedConcreteStmtsFuel, ConcreteYul.collectBlockFunctionDefs,
        SymYul.collectBlockFunctionDefs]
      exact hRestRel

