      { embedRuntimeConfig config with evm := symbolicEvent.2 }
    ConcreteYul.declareMany? concreteAfter.env names results = some concreteEnv ->
    FullYul.declareMany? symbolicAfter.env names symbolicEvent.1 =
      some symbolicEnv ->
    let concreteResult :=
      ConcreteYul.runtimeNormalResult { concreteAfter with env := concreteEnv }
    let symbolicResult :=
      SymYul.guidedNormalResult { symbolicAfter with env := symbolicEnv }
    ConcreteYul.evalRuntimeStmtFuel hash fuel.succ config
        (ConcreteYul.Stmt.letMany names
          (some
            [ConcreteYul.Expr.builtin builtin
              (args.map ConcreteYul.Expr.word)])) =
      some concreteResult ∧
    SymYul.guidedEvalStmtFuel model fuel.succ (embedRuntimeConfig config)
        (embedConcreteStmt
          (ConcreteYul.Stmt.letMany names
            (some
              [ConcreteYul.Expr.builtin builtin
                (args.map ConcreteYul.Expr.word)]))) =
      some symbolicResult ∧
    RuntimeResultRel model concreteResult symbolicResult := by
  intro builtin concreteArgs symbolicArgs concreteAfter symbolicEvent
    symbolicAfter hConcreteDeclare hSymbolicDeclare concreteResult
