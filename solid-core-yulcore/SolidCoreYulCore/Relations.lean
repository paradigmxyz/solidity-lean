structure RuntimeFunctionBodySwitchCoveredSpec
    (spec : RuntimeCoverageSpec) (baseFuel : Nat)
    (discr : ConcreteYul.Expr)
    (cases : List (Word × ConcreteYul.Stmt))
    (defaultBranch : Option ConcreteYul.Stmt) : Prop where
  discrCovered : RuntimeExprCoveredSpec spec discr
  casesCovered :
    RuntimeFunctionBodySwitchCasesCoveredSpec spec baseFuel cases
  defaultCovered :
    match defaultBranch with
    | none => True
    | some stmt =>
        ∃ minEmbedFuel,
          RuntimeFunctionBodyCoveredSpec spec minEmbedFuel stmt ∧
            minEmbedFuel ≤ cases.length + baseFuel + 2

theorem runtimeFunctionBodySwitchCasesCoveredSpec_mono_base
    {spec : RuntimeCoverageSpec} {oldBase newBase : Nat}
    {cases : List (Word × ConcreteYul.Stmt)}
    (hCases :
      RuntimeFunctionBodySwitchCasesCoveredSpec spec oldBase cases)
    (hBase : oldBase ≤ newBase) :
    RuntimeFunctionBodySwitchCasesCoveredSpec spec newBase cases := by
  induction hCases with
  | nil =>
      exact RuntimeFunctionBodySwitchCasesCoveredSpec.nil
  | cons hBranch hBranchEmbed hRest ih =>
      exact
        RuntimeFunctionBodySwitchCasesCoveredSpec.cons hBranch
          (by omega) ih

theorem runtimeFunctionBodySwitchCoveredSpec_mono_base
    {spec : RuntimeCoverageSpec} {oldBase newBase : Nat}
    {discr : ConcreteYul.Expr}
    {cases : List (Word × ConcreteYul.Stmt)}
    {defaultBranch : Option ConcreteYul.Stmt}
    (hSwitch :
      RuntimeFunctionBodySwitchCoveredSpec spec oldBase discr cases
        defaultBranch)
    (hBase : oldBase ≤ newBase) :
    RuntimeFunctionBodySwitchCoveredSpec spec newBase discr cases
      defaultBranch where
  discrCovered := hSwitch.discrCovered
  casesCovered :=
    runtimeFunctionBodySwitchCasesCoveredSpec_mono_base
      hSwitch.casesCovered hBase
  defaultCovered := by
    cases defaultBranch with
    | none =>
        trivial
    | some stmt =>
        rcases hSwitch.defaultCovered with
          ⟨minEmbedFuel, hBody, hEmbedFuel⟩
        exact ⟨minEmbedFuel, hBody, by omega⟩

