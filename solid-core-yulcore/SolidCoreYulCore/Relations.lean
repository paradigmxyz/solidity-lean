    (config : ConcreteYul.RuntimeConfig) (size : Word) :
    ConcreteYul.evalRuntimeExpr hash
        (ConcreteYul.Expr.builtin Evm.Builtin.memoryguardOp
          [ConcreteYul.Expr.word size]) config =
      some (norm size, config) ∧
    SymYul.guidedEvalExpr (embedRuntimeConfig config)
        (embedConcreteExpr
          (ConcreteYul.Expr.builtin Evm.Builtin.memoryguardOp
            [ConcreteYul.Expr.word size])) =
      some (embedWordValue size, embedRuntimeConfig config) := by
  constructor
  · simp [ConcreteYul.evalRuntimeExpr, ConcreteYul.evalExpr,
      ConcreteYul.evalExprs, ConcreteYul.evalBuiltin_memoryguard_word,
      ConcreteYul.returnWord,
      ConcreteYul.RuntimeConfig.toConfig, ConcreteYul.RuntimeConfig.withConfig,
      norm_norm]
  · simp [SymYul.guidedEvalExpr, SymYul.guidedEvalExprs,
      FullYul.evalEvmBuiltin_memoryguard_word, FullYul.returnWord,
      embedConcreteExpr, embedConcreteExprs, embedRuntimeConfig,
      embedWordValue]

theorem runtimeExprExactRelSim_memoryguard_word
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    (concreteConfig : ConcreteYul.RuntimeConfig)
    (symbolicConfig : SymYul.GuidedConfig) (size : Word) :
    RuntimeExprExactRelSim model hash concreteConfig symbolicConfig
      (ConcreteYul.Expr.builtin Evm.Builtin.memoryguardOp
        [ConcreteYul.Expr.word size]) := by
  intro hExact concreteValue concreteConfig' hConcrete
  have hConcreteExpected :=
    (evalRuntimeExpr_memoryguard_refines_guided
      hash concreteConfig size).1
  rw [hConcreteExpected] at hConcrete
  cases hConcrete
  exact
    ⟨ embedWordValue size
    , symbolicConfig
    , by
        simp [SymYul.guidedEvalExpr, SymYul.guidedEvalExprs,
          FullYul.evalEvmBuiltin_memoryguard_word, FullYul.returnWord,
          embedConcreteExpr, embedConcreteExprs, embedWordValue]
    , valueRel_norm_left (valueRel_embedWordValue model size)
    , hExact ⟩

theorem runtimeExprReadValueExactRelSim_memoryguard_of_args
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    {concreteConfig : ConcreteYul.RuntimeConfig}
    {symbolicConfig : SymYul.GuidedConfig}
    {args : List ConcreteYul.Expr}
    (hArgs :
      RuntimeExprsKindReadValueExactRelSim model hash concreteConfig
        symbolicConfig args [RuntimeArgKind.word]) :
    RuntimeExprReadValueExactRelSim model hash concreteConfig symbolicConfig
      (ConcreteYul.Expr.builtin Evm.Builtin.memoryguardOp args) := by
  apply
    runtimeExprReadValueExactRelSim_builtin_non_datacopy_of_runtimeExprsKindReadValueExactRel
      model hash
  · decide
  · exact hArgs
  · intro concreteArgs concreteArgConfig concreteAfterConfig concreteValue
      concreteState' hConcreteArgs hConcreteBuiltin hAfterConfig
      symbolicArgs symbolicArgConfig hGuidedArgs hArgsRel hArgConfigExact
    rcases RuntimeArgListKindRel.single_word hArgsRel with
      ⟨size, hConcreteArgsEq, hSymbolicArgsEq, hSizeNorm⟩
    subst concreteArgs
    have hConcreteMemoryguard :=
      ConcreteYul.evalBuiltin_memoryguard_word hash concreteArgConfig.state
        size
    rw [hConcreteMemoryguard] at hConcreteBuiltin
    simp [ConcreteYul.returnWord] at hConcreteBuiltin
    rcases hConcreteBuiltin with ⟨hConcreteValue, hConcreteStateEq⟩
    have hConcreteValueEq : concreteValue = size := by
      rw [← hConcreteValue]
      exact hSizeNorm
    refine
      ⟨ embedWordValue size
      , symbolicArgConfig.evm
      , ?_
      , by simpa [hConcreteValueEq] using valueRel_embedWordValue model size
      , ?_ ⟩
    · simpa [hSymbolicArgsEq, hSizeNorm, embedWordValue] using
        FullYul.evalEvmBuiltin_memoryguard_word symbolicArgConfig.evm size
    · simpa [hAfterConfig, ← hConcreteStateEq] using hArgConfigExact

