theorem envExactRel_initFunctionEnv_of_concrete
    {model : SymYul.ConcreteModel}
    {params returns : List FullYul.Name}
    {args : List Word} {symbolicArgs : List FullYul.Value}
    {callEnv : ConcreteYul.Env}
    (hInit :
      ConcreteYul.initFunctionEnv params args returns = some callEnv)
    (hArgs : WordListRel model args symbolicArgs) :
    ∃ symbolicCallEnv,
      FullYul.initFunctionEnv params symbolicArgs returns =
        some symbolicCallEnv ∧
      EnvExactRel model callEnv symbolicCallEnv := by
  cases hParams :
      ConcreteYul.declareMany? [] params args with
  | none =>
      simp [ConcreteYul.initFunctionEnv, hParams] at hInit
  | some paramEnv =>
      have hReturns :
          ConcreteYul.declareMany? paramEnv returns
              (returns.map (fun _ => 0)) =
            some callEnv := by
        simpa [ConcreteYul.initFunctionEnv, hParams] using hInit
      rcases
          envExactRel_declareMany?_of_concrete
            (model := model) (concrete := []) (symbolic := [])
            (hExact := trivial)
            hParams hArgs with
        ⟨symbolicParamEnv, hSymbolicParams, hParamsExact⟩
      rcases
