theorem runtimeStmtSim_funDef
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    (fuel : Nat) (config : ConcreteYul.RuntimeConfig)
    (fnName : FullYul.Name) (params returns : List FullYul.Name)
    (body : ConcreteYul.Stmt) :
    RuntimeStmtSim model hash fuel.succ config
      (ConcreteYul.Stmt.funDef fnName params returns body) := by
  intro concreteResult hConcreteResult
  cases hLookup : ConcreteYul.lookupFunction? config.funcs fnName with
  | none =>
      rcases evalRuntimeStmt_funDef_refines_guided_of_fresh
          model hash fuel (body := body) hLookup with
        ⟨hConcrete, hGuided⟩
      rw [hConcrete] at hConcreteResult
      cases hConcreteResult
      exact
        ⟨ embedRuntimeResult
            (ConcreteYul.runtimeNormalResult
              { config with
                funcs :=
                  ConcreteYul.declareFunction config.funcs fnName
                    { params := params, returns := returns, body := body } })
        , hGuided
        , runtimeResultRel_embedRuntimeResult model
            (ConcreteYul.runtimeNormalResult
              { config with
                funcs :=
                  ConcreteYul.declareFunction config.funcs fnName
                    { params := params, returns := returns, body := body } }) ⟩
  | some existing =>
      rcases evalRuntimeStmt_funDef_refines_guided_of_present
          model hash fuel (params := params) (returns := returns)
          (body := body) hLookup with
        ⟨hConcrete, hGuided⟩
      rw [hConcrete] at hConcreteResult
      cases hConcreteResult
      exact
        ⟨ embedRuntimeResult (ConcreteYul.runtimeNormalResult config)
        , hGuided
        , runtimeResultRel_embedRuntimeResult model
            (ConcreteYul.runtimeNormalResult config) ⟩

