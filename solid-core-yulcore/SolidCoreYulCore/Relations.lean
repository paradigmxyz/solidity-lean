theorem evalRuntimeExprsAsYulValues_verbatim_multi_outputs_refines_guided_model
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    {config : ConcreteYul.RuntimeConfig}
    {inputs extraOutputs : Nat} {args results : List Word}
    (hArgs : args.length = inputs)
    (hResults :
      (hash.verbatimValues
          (Evm.Builtin.verbatimOp inputs extraOutputs.succ.succ)
          (args.map norm)).map norm = results)
    (hResultsRel :
      WordListRel model results
        (FullYul.externalValueResults
          (embedRuntimeConfig config).evm.nextExternalId
          extraOutputs.succ.succ)) :
    let builtin := Evm.Builtin.verbatimOp inputs extraOutputs.succ.succ
    let concreteArgs := args.map norm
    let symbolicArgs := args.map embedWordValue
    let concreteAfter : ConcreteYul.RuntimeConfig :=
      { config with
        state := ConcreteYul.recordExternalAction builtin concreteArgs
          config.state }
    let symbolicAfter : SymYul.GuidedConfig :=
      { embedRuntimeConfig config with
        evm := (FullYul.recordExternalValueEvents builtin symbolicArgs
          extraOutputs.succ.succ (embedRuntimeConfig config).evm).2 }
    ConcreteYul.evalRuntimeExprsAsYulValues hash
        [ConcreteYul.Expr.builtin builtin (args.map ConcreteYul.Expr.word)]
        config =
      some (results, concreteAfter) ∧
    SymYul.guidedEvalExprsAsYulValues (embedRuntimeConfig config)
        (embedConcreteExprs
          [ConcreteYul.Expr.builtin builtin
            (args.map ConcreteYul.Expr.word)]) =
      some
        ((FullYul.recordExternalValueEvents builtin symbolicArgs
          extraOutputs.succ.succ (embedRuntimeConfig config).evm).1,
          symbolicAfter) ∧
    WordListRel model results
        (FullYul.recordExternalValueEvents builtin symbolicArgs
          extraOutputs.succ.succ (embedRuntimeConfig config).evm).1 ∧
    RuntimeConfigRel model concreteAfter symbolicAfter := by
  let builtin := Evm.Builtin.verbatimOp inputs extraOutputs.succ.succ
  let concreteArgs := args.map norm
  let symbolicArgs := args.map embedWordValue
  have hLen : results.length = extraOutputs.succ.succ :=
    wordListRel_externalValueResults_length hResultsRel
  let concreteAfter : ConcreteYul.RuntimeConfig :=
    { config with
      state := ConcreteYul.recordExternalAction builtin concreteArgs
        config.state }
  let symbolicAfter : SymYul.GuidedConfig :=
    { embedRuntimeConfig config with
      evm := (FullYul.recordExternalValueEvents builtin symbolicArgs
        extraOutputs.succ.succ (embedRuntimeConfig config).evm).2 }
  have hConcreteArgs :
      ConcreteYul.evalExprs hash (args.map ConcreteYul.Expr.word)
          config.toConfig =
        some (concreteArgs, config.toConfig) := by
    simpa [concreteArgs] using
      concrete_evalExprs_word_args hash config.toConfig args
  have hConcreteArgs' :
      ConcreteYul.evalExprs hash (args.map ConcreteYul.Expr.word)
          { env := config.env, state := config.state, object := config.object } =
        some
          ( concreteArgs
          , { env := config.env, state := config.state, object := config.object } ) := by
    simpa [ConcreteYul.RuntimeConfig.toConfig] using hConcreteArgs
  have hGuidedArgs' :
      SymYul.guidedEvalExprs (embedRuntimeConfig config)
          (embedConcreteExprs (args.map ConcreteYul.Expr.word)) =
        some (symbolicArgs, embedRuntimeConfig config) := by
    simpa [symbolicArgs] using
      (evalRuntimeExprs_word_args_refines_guided hash config args).2
  have hConcreteLen : concreteArgs.length = inputs := by
    simpa [concreteArgs] using hArgs
  have hSymbolicLen : symbolicArgs.length = inputs := by
    simpa [symbolicArgs] using hArgs
  have hResults' :
      (hash.verbatimValues builtin concreteArgs).map norm = results := by
    simpa [builtin, concreteArgs] using hResults
  have hRecord :=
    runtimeConfigRel_recordExternalValueEvents
      (runtimeConfigRel_embedRuntimeConfig model config)
      builtin concreteArgs symbolicArgs results extraOutputs.succ.succ
      hResultsRel
  dsimp only
  constructor
  · simp [ConcreteYul.evalRuntimeExprsAsYulValues,
      ConcreteYul.evalExprsAsYulValues, hConcreteArgs',
      ConcreteYul.evalBuiltinValues, Evm.Builtin.signature?, hConcreteLen,
      ConcreteYul.RuntimeConfig.withConfig,
      ConcreteYul.RuntimeConfig.toConfig, builtin, concreteArgs, hResults',
      hLen]
  constructor
  · simp [SymYul.guidedEvalExprsAsYulValues, embedConcreteExprs,
      embedConcreteExpr, hGuidedArgs', FullYul.evalEvmBuiltinValues,
      Evm.Builtin.signature?, hSymbolicLen, symbolicArgs]
  · exact hRecord

theorem evalRuntimeStmt_letMany_verbatim_multi_outputs_refines_guided_model
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
