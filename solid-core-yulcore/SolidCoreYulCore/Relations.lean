        some (symbolicEvent.1, symbolicAfter) := by
    simpa using hExpr.2.1
  have hConfigRel : RuntimeConfigRel model concreteAfter symbolicAfter := by
    exact hExpr.2.2.2
  have hResultConfigRel :
      RuntimeConfigRel model { concreteAfter with env := concreteEnv }
        { symbolicAfter with env := symbolicEnv } :=
    runtimeConfigRel_declareMany? hConfigRel hConcreteDeclare
      hSymbolicDeclare hExpr.2.2.1
  constructor
  · simp [ConcreteYul.evalRuntimeStmtFuel, hConcreteExpr, hConcreteDeclare,
      concreteResult]
  constructor
  · simp [SymYul.guidedEvalStmtFuel, embedConcreteStmt,
      embedConcreteStmtFuel, hGuidedExpr, hSymbolicDeclare, symbolicResult]
  · constructor
    · rfl
    · exact hResultConfigRel

