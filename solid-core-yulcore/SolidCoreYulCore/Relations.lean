structure CompilerAcceptedProgramCoverageEvidence
    (profile : FullYul.CompilerProfile)
    (program : ConcreteYul.Program) where
  accepted :
    ∃ fuel ctx ctx' inLoop inFunction,
      FullYul.CompilerAcceptedStmt profile fuel ctx inLoop inFunction
        (embedConcreteStmt program.body) ctx'
  builtinEvidence :
    FullYul.StmtBuiltinSemanticEvidence (embedConcreteStmt program.body)
  profileCoverage :
    RuntimeProgramBodyCoveredSpec (RuntimeCompilerProfileCoverageSpec profile)
      program
  signaturedCoverage :
    RuntimeProgramBodyCoveredSpec RuntimeSignaturedCoverageSpec program

noncomputable def CompilerAcceptedProgramCoverageEvidence.of_compilerAccepted
    (profile : FullYul.CompilerProfile)
    {fuel : Nat} {ctx ctx' : FullYul.StaticContext}
    {inLoop inFunction : Bool} {program : ConcreteYul.Program}
    (hAccepted :
      FullYul.CompilerAcceptedStmt profile fuel ctx inLoop inFunction
        (embedConcreteStmt program.body) ctx') :
    CompilerAcceptedProgramCoverageEvidence profile program where
  accepted :=
    ⟨fuel, ctx, ctx', inLoop, inFunction, hAccepted⟩
  builtinEvidence :=
    hAccepted.builtinSemanticEvidence
  profileCoverage :=
    RuntimeProgramBodyCoveredSpec.compilerAccepted_profile_embed profile
      hAccepted
  signaturedCoverage :=
    RuntimeProgramBodyCoveredSpec.compilerAccepted_signatured_embed profile
      hAccepted

noncomputable def CompilerAcceptedProgramCoverageEvidence.of_compilerAcceptedAt
    (profile : FullYul.CompilerProfile)
    (entryCtx : FullYul.StaticContext)
    {program : ConcreteYul.Program}
    (hAccepted : CompilerAcceptedProgramAt profile entryCtx program) :
    CompilerAcceptedProgramCoverageEvidence profile program :=
  let fuel := Classical.choose hAccepted
  let hAcceptedTail := Classical.choose_spec hAccepted
  let ctx' := Classical.choose hAcceptedTail
  let hStmt := Classical.choose_spec hAcceptedTail
  CompilerAcceptedProgramCoverageEvidence.of_compilerAccepted profile
    (fuel := fuel) (ctx := entryCtx) (ctx' := ctx')
    (inLoop := false) (inFunction := false) hStmt

theorem CompilerAcceptedProgramCoverageEvidence.customBuiltinEvidence
    {profile : FullYul.CompilerProfile}
    {builtinEvidence : Evm.Builtin -> Prop}
    (hProfileBuiltin :
      ∀ {builtin : Evm.Builtin}, profile.builtinOK builtin ->
        builtinEvidence builtin)
    {program : ConcreteYul.Program}
    (hEvidence : CompilerAcceptedProgramCoverageEvidence profile program) :
    FullYul.StmtBuiltinEvidence builtinEvidence
      (embedConcreteStmt program.body) := by
  rcases hEvidence.accepted with
    ⟨fuel, ctx, ctx', inLoop, inFunction, hAccepted⟩
  exact
    FullYul.CompilerAcceptedStmt.builtinEvidence hProfileBuiltin hAccepted

