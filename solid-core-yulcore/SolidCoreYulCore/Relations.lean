structure RuntimeCompilerArtifactProviderOk
    (model : SymYul.ConcreteModel) : Prop where
  loadimmutableMissing :
    ∀ {concreteConfig : ConcreteYul.RuntimeConfig}
      {symbolicConfig : SymYul.GuidedConfig} {key : Word},
      RuntimeConfigReadValueExactRel model concreteConfig symbolicConfig ->
      ConcreteYul.lookupWordMap? concreteConfig.state.immutables key = none ->
      FullYul.lookupValueMap? symbolicConfig.evm.immutables
          (embedWordValue key) = none ∧
        norm (model.unaryBuiltin Evm.Builtin.loadimmutableOp (norm key)) = 0
  linkersymbolMissing :
    ∀ {concreteConfig : ConcreteYul.RuntimeConfig}
      {symbolicConfig : SymYul.GuidedConfig} {key : Word},
      RuntimeConfigReadValueExactRel model concreteConfig symbolicConfig ->
      ConcreteYul.lookupWordMap? concreteConfig.state.linkerSymbols key =
        none ->
      FullYul.lookupValueMap? symbolicConfig.evm.linkerSymbols
          (embedWordValue key) = none ∧
        norm (model.unaryBuiltin Evm.Builtin.linkersymbolOp (norm key)) = 0
  setimmutablePositionedMemorySize :
    ∀ {concreteConfig : ConcreteYul.RuntimeConfig}
      {symbolicConfig : SymYul.GuidedConfig}
      {offset key value : Word} {symbolicValue : FullYul.Value}
      {positions : List Word},
      RuntimeConfigReadValueExactRel model concreteConfig symbolicConfig ->
      ValueRel model value symbolicValue ->
      ConcreteYul.lookupWordListMap?
          concreteConfig.state.immutablePositions key = some positions ->
      norm symbolicConfig.evm.msize =
        norm
          (ConcreteYul.writeImmutableMemory
            { concreteConfig.state with
              immutables :=
                ConcreteYul.writeWordMap
                  concreteConfig.state.immutables key value }
            offset positions value).memorySize

