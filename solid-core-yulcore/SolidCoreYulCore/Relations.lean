  constructor
  · simp [ConcreteYul.evalRuntimeExpr, ConcreteYul.evalExpr,
      ConcreteYul.RuntimeConfig.toConfig, ConcreteYul.RuntimeConfig.withConfig,
      hData]
  · simp [SymYul.guidedEvalExpr, embedConcreteExpr, embedRuntimeConfig, hFull,
      embedConcreteBytes, embedWordValue, FullYul.symbolicDataSize_concrete]

