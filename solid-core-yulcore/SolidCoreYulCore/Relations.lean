structure CompilerAcceptedProgramSemanticBoundaryEvidence
    (profile : FullYul.CompilerProfile)
    (claimOK : Evm.ClaimKind -> Prop)
    (coverageOK : Evm.SemanticCoverage -> Prop)
    (entryCtx : FullYul.StaticContext)
    (program : ConcreteYul.Program) where
  acceptedAt :
    CompilerAcceptedProgramAtCoverageEvidence profile entryCtx program
  builtinClaims :
    FullYul.StmtBuiltinClaimEvidence claimOK
      (embedConcreteStmt program.body)
  builtinCoverage :
    FullYul.StmtBuiltinCoverageEvidence coverageOK
      (embedConcreteStmt program.body)

namespace CompilerAcceptedProgramSemanticBoundaryEvidence

theorem builtinSemanticEvidence
    {profile : FullYul.CompilerProfile}
    {claimOK : Evm.ClaimKind -> Prop}
    {coverageOK : Evm.SemanticCoverage -> Prop}
    {entryCtx : FullYul.StaticContext}
    {program : ConcreteYul.Program}
    (hEvidence :
      CompilerAcceptedProgramSemanticBoundaryEvidence profile claimOK
        coverageOK entryCtx program) :
    FullYul.StmtBuiltinSemanticEvidence
      (embedConcreteStmt program.body) :=
  hEvidence.acceptedAt.coverage.builtinEvidence

def profileCoverage
    {profile : FullYul.CompilerProfile}
    {claimOK : Evm.ClaimKind -> Prop}
    {coverageOK : Evm.SemanticCoverage -> Prop}
    {entryCtx : FullYul.StaticContext}
    {program : ConcreteYul.Program}
    (hEvidence :
      CompilerAcceptedProgramSemanticBoundaryEvidence profile claimOK
        coverageOK entryCtx program) :
    RuntimeProgramBodyCoveredSpec (RuntimeCompilerProfileCoverageSpec profile)
      program :=
  hEvidence.acceptedAt.coverage.profileCoverage

def signaturedCoverage
    {profile : FullYul.CompilerProfile}
    {claimOK : Evm.ClaimKind -> Prop}
    {coverageOK : Evm.SemanticCoverage -> Prop}
    {entryCtx : FullYul.StaticContext}
    {program : ConcreteYul.Program}
    (hEvidence :
      CompilerAcceptedProgramSemanticBoundaryEvidence profile claimOK
        coverageOK entryCtx program) :
    RuntimeProgramBodyCoveredSpec RuntimeSignaturedCoverageSpec program :=
  hEvidence.acceptedAt.coverage.signaturedCoverage

theorem builtinClaimEvidence_nonDeferred
    {profile : FullYul.CompilerProfile}
    {claimOK : Evm.ClaimKind -> Prop}
    {coverageOK : Evm.SemanticCoverage -> Prop}
    {entryCtx : FullYul.StaticContext}
    {program : ConcreteYul.Program}
    (hClaimOK :
      ∀ {claim : Evm.ClaimKind}, claimOK claim ->
        FullYul.NonDeferredClaim claim)
    (hEvidence :
      CompilerAcceptedProgramSemanticBoundaryEvidence profile claimOK
        coverageOK entryCtx program) :
    FullYul.StmtBuiltinClaimEvidence FullYul.NonDeferredClaim
      (embedConcreteStmt program.body) :=
  FullYul.StmtBuiltinEvidence.mono
    (fun hBuiltin =>
      FullYul.BuiltinClaimEvidence.mono
        (fun hClaim => hClaimOK hClaim)
        hBuiltin)
    hEvidence.builtinClaims

end CompilerAcceptedProgramSemanticBoundaryEvidence

