theorem runtimeConfigFunctionsCoveredSpec_evalRuntimeStmtFuel_of_straight_stmt
    {spec : RuntimeCoverageSpec}
    {hash : ConcreteYul.HashOracle} {fuel : Nat}
    {config : ConcreteYul.RuntimeConfig}
    {stmt : ConcreteYul.Stmt}
    {result : ConcreteYul.RuntimeResult}
    (hCovered : RuntimeStraightStmtCoveredSpec spec stmt)
    (hFuncs : RuntimeConfigFunctionsCoveredSpec spec config)
    (hEval :
      ConcreteYul.evalRuntimeStmtFuel hash fuel config stmt =
        some result) :
    RuntimeConfigFunctionsCoveredSpec spec result.config := by
  cases fuel with
  | zero =>
      simp [ConcreteYul.evalRuntimeStmtFuel] at hEval
  | succ fuel =>
      cases hCovered with
      | skip =>
          simp [ConcreteYul.evalRuntimeStmtFuel,
            ConcreteYul.runtimeNormalResult] at hEval
          subst result
          exact hFuncs
      | expr hExpr =>
          rename_i expr
          cases hExprEval :
              ConcreteYul.evalRuntimeExpr hash expr config with
          | none =>
              simp [ConcreteYul.evalRuntimeStmtFuel, hExprEval] at hEval
          | some exprResult =>
              cases exprResult with
              | mk value exprConfig =>
                  have hExprFuncs :
                      RuntimeConfigFunctionsCoveredSpec spec exprConfig :=
                    runtimeConfigFunctionsCoveredSpec_evalRuntimeExpr
                      hFuncs hExprEval
                  simp [ConcreteYul.evalRuntimeStmtFuel, hExprEval,
                    ConcreteYul.runtimeResultAfterExpr] at hEval
                  split at hEval
                  · subst result
                    change RuntimeConfigFunctionsCoveredSpec spec exprConfig
                    exact hExprFuncs
                  · subst result
                    change RuntimeConfigFunctionsCoveredSpec spec exprConfig
                    exact hExprFuncs
      | let1None =>
          rename_i name
          cases hDeclare : ConcreteYul.declare? config.env name 0 with
          | none =>
              simp [ConcreteYul.evalRuntimeStmtFuel, hDeclare] at hEval
          | some env' =>
              simp [ConcreteYul.evalRuntimeStmtFuel, hDeclare,
                ConcreteYul.runtimeNormalResult] at hEval
              subst result
              exact runtimeConfigFunctionsCoveredSpec_with_env hFuncs
      | let1Some hExpr =>
          rename_i name expr
          cases hExprEval :
              ConcreteYul.evalRuntimeExpr hash expr config with
          | none =>
              simp [ConcreteYul.evalRuntimeStmtFuel, hExprEval] at hEval
          | some exprResult =>
              cases exprResult with
              | mk value exprConfig =>
                  have hExprFuncs :
                      RuntimeConfigFunctionsCoveredSpec spec exprConfig :=
                    runtimeConfigFunctionsCoveredSpec_evalRuntimeExpr
                      hFuncs hExprEval
                  cases hDeclare :
                      ConcreteYul.declare? exprConfig.env name value with
                  | none =>
                      simp [ConcreteYul.evalRuntimeStmtFuel, hExprEval,
                        hDeclare] at hEval
                  | some env' =>
                      simp [ConcreteYul.evalRuntimeStmtFuel, hExprEval,
                        hDeclare, ConcreteYul.runtimeNormalResult] at hEval
                      subst result
                      change
                        RuntimeConfigFunctionsCoveredSpec spec
                          { exprConfig with env := env' }
                      exact runtimeConfigFunctionsCoveredSpec_with_env hExprFuncs
      | letManyNone =>
          rename_i names
          cases hDeclare :
              ConcreteYul.declareMany? config.env names
                (names.map (fun _ => 0)) with
          | none =>
              simp [ConcreteYul.evalRuntimeStmtFuel, hDeclare] at hEval
          | some env' =>
              simp [ConcreteYul.evalRuntimeStmtFuel, hDeclare,
                ConcreteYul.runtimeNormalResult] at hEval
              subst result
              exact runtimeConfigFunctionsCoveredSpec_with_env hFuncs
      | letManySome hExprs =>
          rename_i names exprs
          cases hExprsEval :
              ConcreteYul.evalRuntimeExprsAsYulValues hash exprs config with
          | none =>
              simp [ConcreteYul.evalRuntimeStmtFuel, hExprsEval] at hEval
          | some exprsResult =>
              cases exprsResult with
              | mk values exprsConfig =>
                  have hExprsFuncs :
                      RuntimeConfigFunctionsCoveredSpec spec exprsConfig :=
                    runtimeConfigFunctionsCoveredSpec_evalRuntimeExprsAsYulValues
                      hFuncs hExprsEval
                  cases hDeclare :
                      ConcreteYul.declareMany? exprsConfig.env names values with
                  | none =>
                      simp [ConcreteYul.evalRuntimeStmtFuel, hExprsEval,
                        hDeclare] at hEval
                  | some env' =>
                      simp [ConcreteYul.evalRuntimeStmtFuel, hExprsEval,
                        hDeclare, ConcreteYul.runtimeNormalResult] at hEval
                      subst result
                      change
                        RuntimeConfigFunctionsCoveredSpec spec
                          { exprsConfig with env := env' }
                      exact
                        runtimeConfigFunctionsCoveredSpec_with_env hExprsFuncs
      | assign hExpr =>
          rename_i name expr
          cases hExprEval :
              ConcreteYul.evalRuntimeExpr hash expr config with
          | none =>
              simp [ConcreteYul.evalRuntimeStmtFuel, hExprEval] at hEval
          | some exprResult =>
              cases exprResult with
              | mk value exprConfig =>
                  have hExprFuncs :
                      RuntimeConfigFunctionsCoveredSpec spec exprConfig :=
                    runtimeConfigFunctionsCoveredSpec_evalRuntimeExpr
                      hFuncs hExprEval
                  cases hAssign :
                      ConcreteYul.assign? exprConfig.env name value with
                  | none =>
                      simp [ConcreteYul.evalRuntimeStmtFuel, hExprEval,
                        hAssign] at hEval
                  | some env' =>
                      simp [ConcreteYul.evalRuntimeStmtFuel, hExprEval,
                        hAssign, ConcreteYul.runtimeNormalResult] at hEval
                      subst result
                      change
                        RuntimeConfigFunctionsCoveredSpec spec
                          { exprConfig with env := env' }
                      exact runtimeConfigFunctionsCoveredSpec_with_env hExprFuncs
      | assignMany hExprs =>
          rename_i names exprs
          cases hExprsEval :
              ConcreteYul.evalRuntimeExprsAsYulValues hash exprs config with
          | none =>
              simp [ConcreteYul.evalRuntimeStmtFuel, hExprsEval] at hEval
          | some exprsResult =>
              cases exprsResult with
              | mk values exprsConfig =>
                  have hExprsFuncs :
                      RuntimeConfigFunctionsCoveredSpec spec exprsConfig :=
                    runtimeConfigFunctionsCoveredSpec_evalRuntimeExprsAsYulValues
                      hFuncs hExprsEval
                  cases hAssign :
                      ConcreteYul.assignMany? exprsConfig.env names values with
                  | none =>
                      simp [ConcreteYul.evalRuntimeStmtFuel, hExprsEval,
                        hAssign] at hEval
                  | some env' =>
                      simp [ConcreteYul.evalRuntimeStmtFuel, hExprsEval,
                        hAssign, ConcreteYul.runtimeNormalResult] at hEval
                      subst result
                      change
                        RuntimeConfigFunctionsCoveredSpec spec
                          { exprsConfig with env := env' }
                      exact
                        runtimeConfigFunctionsCoveredSpec_with_env hExprsFuncs
      | «break» =>
          simp [ConcreteYul.evalRuntimeStmtFuel] at hEval
          subst result
          exact hFuncs
      | «continue» =>
          simp [ConcreteYul.evalRuntimeStmtFuel] at hEval
          subst result
          exact hFuncs
      | «leave» =>
          simp [ConcreteYul.evalRuntimeStmtFuel] at hEval
          subst result
          exact hFuncs

theorem runtimeConfigFunctionsCoveredSpec_evalRuntimeStmtFuel_of_covered_stmt
    {spec : RuntimeCoverageSpec}
    {hash : ConcreteYul.HashOracle} {fuel : Nat}
    {config : ConcreteYul.RuntimeConfig}
    {stmt : ConcreteYul.Stmt}
    {result : ConcreteYul.RuntimeResult}
    (hCovered : RuntimeCoveredStmtSpec spec stmt)
    (hFuncs : RuntimeConfigFunctionsCoveredSpec spec config)
    (hEval :
      ConcreteYul.evalRuntimeStmtFuel hash fuel config stmt =
        some result) :
    RuntimeConfigFunctionsCoveredSpec spec result.config := by
  cases fuel with
  | zero =>
      simp [ConcreteYul.evalRuntimeStmtFuel] at hEval
  | succ fuel =>
      cases hCovered with
      | straight hStmt =>
          exact
            runtimeConfigFunctionsCoveredSpec_evalRuntimeStmtFuel_of_straight_stmt
              hStmt hFuncs hEval
      | letCall hArgs hOK =>
          rename_i names fnName args
          cases hEvalArgs :
              ConcreteYul.evalRuntimeExprs hash args config with
          | none =>
              simp [ConcreteYul.evalRuntimeStmtFuel, hEvalArgs] at hEval
          | some argsResult =>
              cases argsResult with
              | mk argValues argConfig =>
                  have hArgFuncs :
                      RuntimeConfigFunctionsCoveredSpec spec argConfig :=
                    runtimeConfigFunctionsCoveredSpec_evalRuntimeExprs
                      hFuncs hEvalArgs
                  cases hCall :
                      ConcreteYul.evalRuntimeFunctionFuel hash fuel fnName
                        argValues argConfig with
                  | none =>
                      simp [ConcreteYul.evalRuntimeStmtFuel, hEvalArgs,
                        hCall] at hEval
                  | some callResult =>
                      cases callResult with
                      | mk returnValues afterCallConfig =>
                          have hAfterCallFuncs :
                              RuntimeConfigFunctionsCoveredSpec spec
                                afterCallConfig :=
                            runtimeConfigFunctionsCoveredSpec_evalRuntimeFunctionFuel
                              hArgFuncs hCall
                          cases hDeclare :
                              ConcreteYul.declareMany? afterCallConfig.env
                                names returnValues with
                          | none =>
                              simp [ConcreteYul.evalRuntimeStmtFuel,
                                hEvalArgs, hCall, hDeclare] at hEval
                          | some env' =>
                              simp [ConcreteYul.evalRuntimeStmtFuel,
                                hEvalArgs, hCall, hDeclare,
                                ConcreteYul.runtimeNormalResult] at hEval
                              subst result
                              change
                                RuntimeConfigFunctionsCoveredSpec spec
                                  { afterCallConfig with env := env' }
                              exact
                                runtimeConfigFunctionsCoveredSpec_with_env
                                  hAfterCallFuncs
      | assignCall hArgs hOK =>
          rename_i names fnName args
          cases hEvalArgs :
              ConcreteYul.evalRuntimeExprs hash args config with
          | none =>
              simp [ConcreteYul.evalRuntimeStmtFuel, hEvalArgs] at hEval
          | some argsResult =>
              cases argsResult with
              | mk argValues argConfig =>
                  have hArgFuncs :
                      RuntimeConfigFunctionsCoveredSpec spec argConfig :=
                    runtimeConfigFunctionsCoveredSpec_evalRuntimeExprs
                      hFuncs hEvalArgs
                  cases hCall :
                      ConcreteYul.evalRuntimeFunctionFuel hash fuel fnName
                        argValues argConfig with
                  | none =>
                      simp [ConcreteYul.evalRuntimeStmtFuel, hEvalArgs,
                        hCall] at hEval
                  | some callResult =>
                      cases callResult with
                      | mk returnValues afterCallConfig =>
                          have hAfterCallFuncs :
                              RuntimeConfigFunctionsCoveredSpec spec
                                afterCallConfig :=
                            runtimeConfigFunctionsCoveredSpec_evalRuntimeFunctionFuel
                              hArgFuncs hCall
                          cases hAssign :
                              ConcreteYul.assignMany? afterCallConfig.env
                                names returnValues with
                          | none =>
                              simp [ConcreteYul.evalRuntimeStmtFuel,
                                hEvalArgs, hCall, hAssign] at hEval
                          | some env' =>
                              simp [ConcreteYul.evalRuntimeStmtFuel,
                                hEvalArgs, hCall, hAssign,
                                ConcreteYul.runtimeNormalResult] at hEval
                              subst result
                              change
                                RuntimeConfigFunctionsCoveredSpec spec
                                  { afterCallConfig with env := env' }
                              exact
                                runtimeConfigFunctionsCoveredSpec_with_env
                                  hAfterCallFuncs
      | ifStraight hCond hBody =>
          rename_i cond body
          cases hCondEval :
              ConcreteYul.evalRuntimeExpr hash cond config with
          | none =>
              simp [ConcreteYul.evalRuntimeStmtFuel, hCondEval] at hEval
          | some condResult =>
              cases condResult with
              | mk value condConfig =>
                  have hCondFuncs :
                      RuntimeConfigFunctionsCoveredSpec spec condConfig :=
                    runtimeConfigFunctionsCoveredSpec_evalRuntimeExpr
                      hFuncs hCondEval
                  show RuntimeConfigFunctionsCoveredSpec spec result.config
                  by_cases hZero : norm value = 0
                  · simp [ConcreteYul.evalRuntimeStmtFuel, hCondEval, hZero,
                      ConcreteYul.runtimeNormalResult] at hEval
                    subst result
                    exact
                      runtimeConfigFunctionsCoveredSpec_runtimeNormalResult
                        hCondFuncs
                  · have hBodyEval :
                        ConcreteYul.evalRuntimeStmtFuel hash fuel condConfig
                            body =
                          some result := by
                      simpa [ConcreteYul.evalRuntimeStmtFuel, hCondEval,
                        hZero] using hEval
                    simpa using
                      runtimeConfigFunctionsCoveredSpec_evalRuntimeStmtFuel_of_straight_stmt
                        hBody hCondFuncs hBodyEval

theorem runtimeConfigPredicate_evalRuntimeBlockFuel_cons_of_preserved_head_tail
    {hash : ConcreteYul.HashOracle} {fuel : Nat}
    {config : ConcreteYul.RuntimeConfig}
    {stmt : ConcreteYul.Stmt} {rest : List ConcreteYul.Stmt}
    {result : ConcreteYul.RuntimeResult}
    {P : ConcreteYul.RuntimeConfig -> Prop}
    (hHeadPreserve :
      ∀ {headResult : ConcreteYul.RuntimeResult},
        P config ->
        ConcreteYul.evalRuntimeStmtFuel hash fuel config stmt =
          some headResult ->
        P headResult.config)
    (hTailPreserve :
      ∀ {headConfig : ConcreteYul.RuntimeConfig}
        {result : ConcreteYul.RuntimeResult},
        P headConfig ->
        ConcreteYul.evalRuntimeBlockFuel hash fuel headConfig rest =
          some result ->
        P result.config)
    (hConfig : P config)
    (hEval :
      ConcreteYul.evalRuntimeBlockFuel hash fuel.succ config (stmt :: rest) =
        some result) :
    P result.config := by
  cases hStmtEval :
      ConcreteYul.evalRuntimeStmtFuel hash fuel config stmt with
  | none =>
      simp [ConcreteYul.evalRuntimeBlockFuel, hStmtEval] at hEval
  | some headResult =>
      have hHeadConfig : P headResult.config :=
        hHeadPreserve hConfig hStmtEval
      by_cases hNormal : headResult.flow = ConcreteYul.CompleteFlow.normal
      · rcases headResult with ⟨headFlow, headConfig⟩
        cases hNormal
        have hRestEval :
            ConcreteYul.evalRuntimeBlockFuel hash fuel headConfig rest =
              some result := by
          simpa [ConcreteYul.evalRuntimeBlockFuel, hStmtEval,
            ConcreteYul.runtimeNormalResult] using hEval
        exact hTailPreserve hHeadConfig hRestEval
      · have hEq : result = headResult :=
          evalRuntimeBlockFuel_cons_non_normal_result_eq hNormal hStmtEval
            hEval
        rw [hEq]
        exact hHeadConfig

theorem runtimeConfigPredicate_evalRuntimeStmtFuel_block_of_restore
    {hash : ConcreteYul.HashOracle} {fuel : Nat}
    {config : ConcreteYul.RuntimeConfig}
    {stmts : List ConcreteYul.Stmt}
    {result : ConcreteYul.RuntimeResult}
    {P : ConcreteYul.RuntimeConfig -> Prop}
    (hRestorePreserve :
      ∀ {blockResult restored : ConcreteYul.RuntimeResult},
        P config ->
        ConcreteYul.withRestoredRuntimeConfig config blockResult =
          some restored ->
        P restored.config)
    (hConfig : P config)
    (hEval :
      ConcreteYul.evalRuntimeStmtFuel hash fuel config
          (ConcreteYul.Stmt.block stmts) =
        some result) :
    P result.config := by
  cases fuel with
  | zero =>
      simp [ConcreteYul.evalRuntimeStmtFuel] at hEval
  | succ fuel =>
      cases hBlockEval :
          ConcreteYul.evalRuntimeBlockFuel hash fuel
            { config with
              funcs := ConcreteYul.collectBlockFunctionDefs stmts
                config.funcs }
            stmts with
      | none =>
          simp [ConcreteYul.evalRuntimeStmtFuel, hBlockEval] at hEval
      | some blockResult =>
          cases hRestore :
              ConcreteYul.withRestoredRuntimeConfig config blockResult with
          | none =>
              simp [ConcreteYul.evalRuntimeStmtFuel, hBlockEval, hRestore]
                at hEval
          | some restored =>
              simp [ConcreteYul.evalRuntimeStmtFuel, hBlockEval, hRestore]
                at hEval
              subst result
              exact hRestorePreserve hConfig hRestore

theorem runtimeConfigPredicate_evalRuntimeStmtFuel_ifThen_of_preserved_parts
    {hash : ConcreteYul.HashOracle} {fuel : Nat}
    {config : ConcreteYul.RuntimeConfig}
    {cond : ConcreteYul.Expr} {body : ConcreteYul.Stmt}
    {result : ConcreteYul.RuntimeResult}
    {P : ConcreteYul.RuntimeConfig -> Prop}
    (hCondPreserve :
      ∀ {value : Word} {condConfig : ConcreteYul.RuntimeConfig},
        P config ->
        ConcreteYul.evalRuntimeExpr hash cond config =
          some (value, condConfig) ->
        P condConfig)
    (hBodyPreserve :
      ∀ {innerFuel : Nat} {condConfig : ConcreteYul.RuntimeConfig}
        {result : ConcreteYul.RuntimeResult},
        P condConfig ->
        ConcreteYul.evalRuntimeStmtFuel hash innerFuel condConfig body =
          some result ->
        P result.config)
    (hConfig : P config)
    (hEval :
      ConcreteYul.evalRuntimeStmtFuel hash fuel config
          (ConcreteYul.Stmt.ifThen cond body) =
        some result) :
    P result.config := by
  cases fuel with
  | zero =>
      simp [ConcreteYul.evalRuntimeStmtFuel] at hEval
  | succ fuel =>
      cases hCondEval :
          ConcreteYul.evalRuntimeExpr hash cond config with
      | none =>
          simp [ConcreteYul.evalRuntimeStmtFuel, hCondEval] at hEval
      | some condResult =>
          rcases condResult with ⟨value, condConfig⟩
          have hCondConfig : P condConfig :=
            hCondPreserve hConfig hCondEval
          by_cases hZero : norm value = 0
          · simp [ConcreteYul.evalRuntimeStmtFuel, hCondEval, hZero,
              ConcreteYul.runtimeNormalResult] at hEval
            subst result
            exact hCondConfig
          · have hBodyEval :
                ConcreteYul.evalRuntimeStmtFuel hash fuel condConfig body =
                  some result := by
              simpa [ConcreteYul.evalRuntimeStmtFuel, hCondEval, hZero]
                using hEval
            exact hBodyPreserve hCondConfig hBodyEval

theorem runtimeConfigPredicate_evalRuntimeStmtFuel_seq_of_preserved_parts
    {hash : ConcreteYul.HashOracle} {fuel : Nat}
    {config : ConcreteYul.RuntimeConfig}
    {first second : ConcreteYul.Stmt}
    {result : ConcreteYul.RuntimeResult}
    {P : ConcreteYul.RuntimeConfig -> Prop}
    (hSeqConfig :
      P
        { config with
          funcs :=
            ConcreteYul.collectStmtFunctionDefs
              (ConcreteYul.Stmt.seq first second) config.funcs })
    (hFirstPreserve :
      ∀ {innerFuel : Nat} {firstResult : ConcreteYul.RuntimeResult},
