abbrev RuntimeCoveredBlockListSpec (spec : RuntimeCoverageSpec)
    (stmts : List ConcreteYul.Stmt) : Prop :=
  RuntimeCoveredBlockSpec spec stmts.length stmts

structure RuntimeSwitchCoveredSpec (spec : RuntimeCoverageSpec)
    (discr : ConcreteYul.Expr)
    (cases : List (Word × ConcreteYul.Stmt))
    (defaultBranch : Option ConcreteYul.Stmt) : Prop where
  discrCovered : RuntimeExprCoveredSpec spec discr
  casesCovered :
    ∀ switchCase, switchCase ∈ cases ->
      RuntimeCoveredStmtSpec spec switchCase.2
  defaultCovered :
    match defaultBranch with
    | none => True
    | some stmt => RuntimeCoveredStmtSpec spec stmt

inductive RuntimeFunctionBodyCoveredSpec (spec : RuntimeCoverageSpec) :
    Nat -> ConcreteYul.Stmt -> Prop where
  | stmt {stmt : ConcreteYul.Stmt} :
      RuntimeCoveredStmtSpec spec stmt ->
      RuntimeFunctionBodyCoveredSpec spec 2 stmt
  | block {length : Nat} {stmts : List ConcreteYul.Stmt} :
      RuntimeCoveredBlockSpec spec length stmts ->
      RuntimeFunctionBodyCoveredSpec spec (length + 3)
        (ConcreteYul.Stmt.block stmts)
  | funDef {fnName : FullYul.Name} {params returns : List FullYul.Name}
      {body : ConcreteYul.Stmt} {bodyEmbedFuel : Nat} :
      RuntimeFunctionBodyCoveredSpec spec bodyEmbedFuel body ->
      bodyEmbedFuel ≤
        sizeOf (ConcreteYul.Stmt.funDef fnName params returns body) ->
      RuntimeFunctionBodyCoveredSpec spec
        (sizeOf (ConcreteYul.Stmt.funDef fnName params returns body) + 1)
        (ConcreteYul.Stmt.funDef fnName params returns body)
  | seq {first second : ConcreteYul.Stmt}
      {firstEmbedFuel secondEmbedFuel : Nat} :
      RuntimeFunctionBodyCoveredSpec spec firstEmbedFuel first ->
      RuntimeFunctionBodyCoveredSpec spec secondEmbedFuel second ->
      RuntimeFunctionBodyCoveredSpec spec
        (Nat.max firstEmbedFuel secondEmbedFuel + 1)
        (ConcreteYul.Stmt.seq first second)
  | ifThen {cond : ConcreteYul.Expr} {body : ConcreteYul.Stmt}
      {minBodyEmbedFuel : Nat} :
      RuntimeExprCoveredSpec spec cond ->
      RuntimeFunctionBodyCoveredSpec spec minBodyEmbedFuel body ->
      RuntimeFunctionBodyCoveredSpec spec (minBodyEmbedFuel + 1)
        (ConcreteYul.Stmt.ifThen cond body)
  | switch {discr : ConcreteYul.Expr}
      {cases : List (Word × ConcreteYul.Stmt)}
      {defaultBranch : Option ConcreteYul.Stmt} :
      RuntimeSwitchCoveredSpec spec discr cases defaultBranch ->
      RuntimeFunctionBodyCoveredSpec spec (cases.length + 3)
        (ConcreteYul.Stmt.switch discr cases defaultBranch)
  | forLoop {pre post body : ConcreteYul.Stmt} {cond : ConcreteYul.Expr}
      {preEmbedFuel postEmbedFuel bodyEmbedFuel : Nat} :
      RuntimeFunctionBodyCoveredSpec spec preEmbedFuel pre ->
      RuntimeExprCoveredSpec spec cond ->
      RuntimeFunctionBodyCoveredSpec spec postEmbedFuel post ->
      RuntimeFunctionBodyCoveredSpec spec bodyEmbedFuel body ->
      RuntimeFunctionBodyCoveredSpec spec
        (Nat.max preEmbedFuel (Nat.max postEmbedFuel bodyEmbedFuel) + 1)
        (ConcreteYul.Stmt.forLoop pre cond post body)

inductive RuntimeNamedFunctionBodyCoveredSpec
    (spec : RuntimeCoverageSpec)
    (fnName : FullYul.Name)
    (fn : ConcreteYul.FunctionDef) : Prop where
  | intro (minEmbedFuel : Nat) :
      RuntimeFunctionBodyCoveredSpec spec minEmbedFuel fn.body ->
      minEmbedFuel ≤
        sizeOf
          (ConcreteYul.Stmt.funDef fnName fn.params fn.returns fn.body) ->
      RuntimeNamedFunctionBodyCoveredSpec spec fnName fn

structure RuntimeFunctionBodyCoveredAlg
    (spec : RuntimeCoverageSpec)
    (BodyRel : Nat -> ConcreteYul.Stmt -> Prop) : Prop where
  stmt :
    ∀ {stmt : ConcreteYul.Stmt},
      RuntimeCoveredStmtSpec spec stmt ->
      BodyRel 2 stmt
  block :
    ∀ {length : Nat} {stmts : List ConcreteYul.Stmt},
      RuntimeCoveredBlockSpec spec length stmts ->
      BodyRel (length + 3) (ConcreteYul.Stmt.block stmts)
  funDef :
    ∀ {fnName : FullYul.Name} {params returns : List FullYul.Name}
      {body : ConcreteYul.Stmt} {bodyEmbedFuel : Nat},
      BodyRel bodyEmbedFuel body ->
      bodyEmbedFuel ≤
        sizeOf (ConcreteYul.Stmt.funDef fnName params returns body) ->
      BodyRel
        (sizeOf (ConcreteYul.Stmt.funDef fnName params returns body) + 1)
        (ConcreteYul.Stmt.funDef fnName params returns body)
  seq :
    ∀ {first second : ConcreteYul.Stmt}
      {firstEmbedFuel secondEmbedFuel : Nat},
      BodyRel firstEmbedFuel first ->
      BodyRel secondEmbedFuel second ->
      BodyRel (Nat.max firstEmbedFuel secondEmbedFuel + 1)
        (ConcreteYul.Stmt.seq first second)
  ifThen :
    ∀ {cond : ConcreteYul.Expr} {body : ConcreteYul.Stmt}
      {minBodyEmbedFuel : Nat},
      RuntimeExprCoveredSpec spec cond ->
      BodyRel minBodyEmbedFuel body ->
      BodyRel (minBodyEmbedFuel + 1) (ConcreteYul.Stmt.ifThen cond body)
  switch :
    ∀ {discr : ConcreteYul.Expr}
      {cases : List (Word × ConcreteYul.Stmt)}
      {defaultBranch : Option ConcreteYul.Stmt},
      RuntimeSwitchCoveredSpec spec discr cases defaultBranch ->
      BodyRel (cases.length + 3)
        (ConcreteYul.Stmt.switch discr cases defaultBranch)
  forLoop :
    ∀ {pre post body : ConcreteYul.Stmt} {cond : ConcreteYul.Expr}
      {preEmbedFuel postEmbedFuel bodyEmbedFuel : Nat},
      BodyRel preEmbedFuel pre ->
      RuntimeExprCoveredSpec spec cond ->
      BodyRel postEmbedFuel post ->
      BodyRel bodyEmbedFuel body ->
      BodyRel (Nat.max preEmbedFuel
        (Nat.max postEmbedFuel bodyEmbedFuel) + 1)
        (ConcreteYul.Stmt.forLoop pre cond post body)

theorem RuntimeFunctionBodyCoveredSpec.foldRel
    {spec : RuntimeCoverageSpec}
    {BodyRel : Nat -> ConcreteYul.Stmt -> Prop}
    (alg : RuntimeFunctionBodyCoveredAlg spec BodyRel) :
    ∀ {minEmbedFuel : Nat} {stmt : ConcreteYul.Stmt},
      RuntimeFunctionBodyCoveredSpec spec minEmbedFuel stmt ->
      BodyRel minEmbedFuel stmt
  | _, _, RuntimeFunctionBodyCoveredSpec.stmt hStmt =>
      alg.stmt hStmt
  | _, _, RuntimeFunctionBodyCoveredSpec.block hBlock =>
      alg.block hBlock
  | _, _, RuntimeFunctionBodyCoveredSpec.funDef hBody hEmbed =>
      alg.funDef (RuntimeFunctionBodyCoveredSpec.foldRel alg hBody) hEmbed
  | _, _, RuntimeFunctionBodyCoveredSpec.seq hFirst hSecond =>
      alg.seq
        (RuntimeFunctionBodyCoveredSpec.foldRel alg hFirst)
        (RuntimeFunctionBodyCoveredSpec.foldRel alg hSecond)
  | _, _, RuntimeFunctionBodyCoveredSpec.ifThen hCond hBody =>
      alg.ifThen hCond
        (RuntimeFunctionBodyCoveredSpec.foldRel alg hBody)
  | _, _, RuntimeFunctionBodyCoveredSpec.switch hSwitch =>
      alg.switch hSwitch
  | _, _, RuntimeFunctionBodyCoveredSpec.forLoop hPre hCond hPost hBody =>
      alg.forLoop
        (RuntimeFunctionBodyCoveredSpec.foldRel alg hPre)
        hCond
        (RuntimeFunctionBodyCoveredSpec.foldRel alg hPost)
        (RuntimeFunctionBodyCoveredSpec.foldRel alg hBody)

theorem runtimeCoveredBlock_length
    {DataOffsetOK : FullYul.DataLabel -> Prop}
    {BuiltinExprOK BuiltinValuesOK :
      Evm.Builtin -> List ConcreteYul.Expr -> Prop}
    {FunctionOK : FullYul.Name -> List ConcreteYul.Expr -> Prop}
    {length : Nat} {stmts : List ConcreteYul.Stmt}
    (hCovered :
      RuntimeCoveredBlock DataOffsetOK BuiltinExprOK BuiltinValuesOK
        FunctionOK length stmts) :
    length = stmts.length := by
  induction hCovered with
  | nil => rfl
  | cons _hStmt _hRest ih =>
      simp [ih]

theorem runtimeCoveredBlockSpec_to_list
    {spec : RuntimeCoverageSpec}
    {length : Nat} {stmts : List ConcreteYul.Stmt}
    (hCovered : RuntimeCoveredBlockSpec spec length stmts) :
    RuntimeCoveredBlockListSpec spec stmts := by
  have hLength := runtimeCoveredBlock_length hCovered
  simpa [RuntimeCoveredBlockListSpec, hLength] using hCovered

theorem runtimeSwitchCoveredSpec_target
    {spec : RuntimeCoverageSpec}
    {discr : ConcreteYul.Expr}
    {value : Word} {cases : List (Word × ConcreteYul.Stmt)}
    {defaultBranch : Option ConcreteYul.Stmt} {target : ConcreteYul.Stmt}
    (hSwitch : RuntimeSwitchCoveredSpec spec discr cases defaultBranch)
    (hTarget :
      ConcreteYul.switchTarget? value cases defaultBranch = some target) :
    RuntimeCoveredStmtSpec spec target := by
  induction cases generalizing defaultBranch target with
  | nil =>
      cases defaultBranch with
      | none =>
          simp [ConcreteYul.switchTarget?] at hTarget
      | some branch =>
          simp [ConcreteYul.switchTarget?] at hTarget
          subst target
          exact hSwitch.defaultCovered
  | cons head rest ih =>
      rcases head with ⟨label, branch⟩
      have hBranch :
          RuntimeCoveredStmtSpec spec branch :=
        hSwitch.casesCovered (label, branch) (by simp)
      have hRest :
          RuntimeSwitchCoveredSpec spec discr rest defaultBranch := {
        discrCovered := hSwitch.discrCovered
        casesCovered := by
          intro switchCase hMem
          exact hSwitch.casesCovered switchCase (by simp [hMem])
        defaultCovered := hSwitch.defaultCovered }
      by_cases hMatch : norm label = norm value
      · have hEq : branch = target := by
          simpa [ConcreteYul.switchTarget?, hMatch] using hTarget
        subst target
        simpa using hBranch
      · exact
          ih hRest
            (by
              simpa [ConcreteYul.switchTarget?, hMatch] using hTarget)

theorem norm_norm (value : Word) : norm (norm value) = norm value := by
  unfold norm
  exact Nat.mod_mod value wordModulus

theorem norm_zero : norm 0 = 0 := by
  rfl

theorem memorySizeAfter_norm_current (current offset size : Word) :
    memorySizeAfter (norm current) offset size =
      memorySizeAfter current offset size := by
  unfold memorySizeAfter
  simp [norm_norm]

theorem memorySizeAfter_congr_current {lhs rhs offset size : Word}
    (h : norm lhs = norm rhs) :
    memorySizeAfter lhs offset size = memorySizeAfter rhs offset size := by
  unfold memorySizeAfter
  simp [h]

theorem memorySizeAfter_zero_norm_size
    (current offset size : Word) (hSize : norm size = 0) :
    memorySizeAfter current offset size = norm current := by
  unfold memorySizeAfter
  simp [hSize]

theorem addWord_norm_args (lhs rhs : Word) :
    addWord (norm lhs) (norm rhs) = addWord lhs rhs := by
  unfold addWord norm
  rw [← Nat.add_mod lhs rhs wordModulus]

theorem mulWord_norm_args (lhs rhs : Word) :
    mulWord (norm lhs) (norm rhs) = mulWord lhs rhs := by
  unfold mulWord norm
  rw [← Nat.mul_mod lhs rhs wordModulus]

theorem divWord_norm_args (lhs rhs : Word) :
    divWord (norm lhs) (norm rhs) = divWord lhs rhs := by
  unfold divWord
  simp [norm_norm]

theorem modWord_norm_args (lhs rhs : Word) :
    modWord (norm lhs) (norm rhs) = modWord lhs rhs := by
  unfold modWord
  simp [norm_norm]

theorem addmodWord_norm_args (lhs rhs modulus : Word) :
    addmodWord (norm lhs) (norm rhs) (norm modulus) =
      addmodWord lhs rhs modulus := by
  unfold addmodWord
  simp [norm_norm]

theorem mulmodWord_norm_args (lhs rhs modulus : Word) :
    mulmodWord (norm lhs) (norm rhs) (norm modulus) =
      mulmodWord lhs rhs modulus := by
  unfold mulmodWord
  simp [norm_norm]

theorem expWord_norm_args (base exponent : Word) :
    expWord (norm base) (norm exponent) = expWord base exponent := by
  unfold expWord
  simp [norm_norm]

theorem subWord_norm_args (lhs rhs : Word) :
    subWord (norm lhs) (norm rhs) = subWord lhs rhs := by
  unfold subWord norm
  simp

theorem iszeroWord_norm_arg (value : Word) :
    iszeroWord (norm value) = iszeroWord value := by
  unfold iszeroWord
  simp [norm_norm]

theorem eqWord_norm_args (lhs rhs : Word) :
    eqWord (norm lhs) (norm rhs) = eqWord lhs rhs := by
  unfold eqWord
  simp [norm_norm]

theorem ltWord_norm_args (lhs rhs : Word) :
    ltWord (norm lhs) (norm rhs) = ltWord lhs rhs := by
  unfold ltWord
  simp [norm_norm]

theorem gtWord_norm_args (lhs rhs : Word) :
    gtWord (norm lhs) (norm rhs) = gtWord lhs rhs := by
  unfold gtWord
  simp [norm_norm]

theorem signedValue_norm_arg (value : Word) :
    signedValue (norm value) = signedValue value := by
  unfold signedValue
  simp [norm_norm]

theorem sltWord_norm_args (lhs rhs : Word) :
    sltWord (norm lhs) (norm rhs) = sltWord lhs rhs := by
  unfold sltWord
  simp [signedValue_norm_arg]

theorem sgtWord_norm_args (lhs rhs : Word) :
    sgtWord (norm lhs) (norm rhs) = sgtWord lhs rhs := by
  unfold sgtWord
  simp [signedValue_norm_arg]

theorem andWord_norm_args (lhs rhs : Word) :
    andWord (norm lhs) (norm rhs) = andWord lhs rhs := by
  unfold andWord
  simp [norm_norm]

theorem orWord_norm_args (lhs rhs : Word) :
    orWord (norm lhs) (norm rhs) = orWord lhs rhs := by
  unfold orWord
  simp [norm_norm]

theorem xorWord_norm_args (lhs rhs : Word) :
    xorWord (norm lhs) (norm rhs) = xorWord lhs rhs := by
  unfold xorWord
  simp [norm_norm]

theorem notWord_norm_arg (value : Word) :
    notWord (norm value) = notWord value := by
  unfold notWord
  simp [norm_norm]

theorem shlWord_norm_args (shift value : Word) :
    shlWord (norm shift) (norm value) = shlWord shift value := by
  unfold shlWord
  simp [norm_norm]

theorem shrWord_norm_args (shift value : Word) :
    shrWord (norm shift) (norm value) = shrWord shift value := by
  unfold shrWord
  simp [norm_norm]

theorem sarWord_norm_args (shift value : Word) :
    sarWord (norm shift) (norm value) = sarWord shift value := by
  unfold sarWord
  simp [norm_norm, signedValue_norm_arg]

theorem byteWord_norm_args (ix value : Word) :
    byteWord (norm ix) (norm value) = byteWord ix value := by
  unfold byteWord
  simp [norm_norm]

theorem signextendWord_norm_args (ix value : Word) :
    signextendWord (norm ix) (norm value) = signextendWord ix value := by
  unfold signextendWord
  simp [norm_norm]

theorem clzWordAux_norm_arg (remaining bit value : Word) :
    clzWordAux remaining bit (norm value) = clzWordAux remaining bit value := by
  induction remaining generalizing bit with
  | zero =>
      rfl
  | succ remaining ih =>
      unfold clzWordAux
      simp [norm_norm, ih]

theorem clzWord_norm_arg (value : Word) :
    clzWord (norm value) = clzWord value := by
  unfold clzWord
  rw [clzWordAux_norm_arg]

theorem sdivWord_norm_args (lhs rhs : Word) :
    sdivWord (norm lhs) (norm rhs) = sdivWord lhs rhs := by
  unfold sdivWord
  simp [norm_norm, signedValue_norm_arg]

theorem smodWord_norm_args (lhs rhs : Word) :
    smodWord (norm lhs) (norm rhs) = smodWord lhs rhs := by
  unfold smodWord
  simp [norm_norm, signedValue_norm_arg]

theorem norm_addWord (lhs rhs : Word) :
    norm (addWord lhs rhs) = addWord lhs rhs := by
  unfold addWord norm
  exact Nat.mod_mod (lhs + rhs) wordModulus

theorem norm_mulWord (lhs rhs : Word) :
    norm (mulWord lhs rhs) = mulWord lhs rhs := by
  unfold mulWord norm
  exact Nat.mod_mod (lhs * rhs) wordModulus

theorem norm_divWord (lhs rhs : Word) :
    norm (divWord lhs rhs) = divWord lhs rhs := by
  unfold divWord
  by_cases h : norm rhs = 0
  · simp only [h, if_true]
    rfl
  · simp only [h, if_false]
    exact norm_norm (norm lhs / norm rhs)

theorem norm_modWord (lhs rhs : Word) :
    norm (modWord lhs rhs) = modWord lhs rhs := by
  unfold modWord
  by_cases h : norm rhs = 0
  · simp only [h, if_true]
    rfl
  · simp only [h, if_false]
    exact norm_norm (norm lhs % norm rhs)

theorem norm_addmodWord (lhs rhs modulus : Word) :
    norm (addmodWord lhs rhs modulus) = addmodWord lhs rhs modulus := by
  unfold addmodWord
  by_cases h : norm modulus = 0
  · simp only [h, if_true]
    rfl
  · simp only [h, if_false]
    exact norm_norm ((norm lhs + norm rhs) % norm modulus)

theorem norm_mulmodWord (lhs rhs modulus : Word) :
    norm (mulmodWord lhs rhs modulus) = mulmodWord lhs rhs modulus := by
  unfold mulmodWord
  by_cases h : norm modulus = 0
  · simp only [h, if_true]
    rfl
  · simp only [h, if_false]
    exact norm_norm ((norm lhs * norm rhs) % norm modulus)

theorem norm_expWord (base exponent : Word) :
    norm (expWord base exponent) = expWord base exponent := by
  unfold expWord
  exact norm_norm (norm base ^ norm exponent)

theorem norm_signedToWord (value : Int) :
    norm (signedToWord value) = signedToWord value := by
  unfold signedToWord
  split <;> simp [norm_norm]

theorem norm_sdivWord (lhs rhs : Word) :
    norm (sdivWord lhs rhs) = sdivWord lhs rhs := by
  unfold sdivWord
  by_cases h : norm rhs = 0
  · simp only [h, if_true]
    rfl
  · simp only [h, if_false]
    by_cases hSign : signedValue lhs < 0 ↔ signedValue rhs < 0
    · simp [hSign, norm_signedToWord]
    · simp [hSign, norm_signedToWord]

theorem norm_smodWord (lhs rhs : Word) :
    norm (smodWord lhs rhs) = smodWord lhs rhs := by
  unfold smodWord
  by_cases h : norm rhs = 0
  · simp only [h, if_true]
    rfl
  · simp only [h, if_false]
    by_cases hSign : signedValue lhs < 0
    · simp [hSign, norm_signedToWord]
    · simp [hSign, norm_signedToWord]

theorem norm_subWord (lhs rhs : Word) :
    norm (subWord lhs rhs) = subWord lhs rhs := by
  unfold subWord norm
  exact Nat.mod_mod
    (wordModulus + lhs % wordModulus - rhs % wordModulus) wordModulus

theorem norm_iszeroWord (value : Word) :
    norm (iszeroWord value) = iszeroWord value := by
  unfold norm
  change iszeroWord value % wordModulus = iszeroWord value
  unfold iszeroWord
  change (if norm value = 0 then 1 else 0) % wordModulus =
    if norm value = 0 then 1 else 0
  by_cases h : norm value = 0 <;> simp [h, wordModulus]

theorem norm_eqWord (lhs rhs : Word) :
    norm (eqWord lhs rhs) = eqWord lhs rhs := by
  unfold norm
  change eqWord lhs rhs % wordModulus = eqWord lhs rhs
  unfold eqWord
  change (if norm lhs = norm rhs then 1 else 0) % wordModulus =
    if norm lhs = norm rhs then 1 else 0
  by_cases h : norm lhs = norm rhs <;> simp [h, wordModulus]

theorem eqWord_eq_norm (lhs rhs : Word) :
    eqWord lhs rhs = norm (eqWord lhs rhs) :=
  (norm_eqWord lhs rhs).symm

theorem boolWord_eq_norm (p : Prop) [Decidable p] :
    (if p then (1 : Word) else 0) =
      norm (if p then (1 : Word) else 0) := by
  by_cases h : p <;> simp [h, norm, wordModulus]

theorem boolWord_eq_mod_wordModulus (p : Prop) [Decidable p] :
    (if p then (1 : Word) else 0) =
      (if p then (1 : Word) else 0) % wordModulus := by
  by_cases h : p <;> simp [h, wordModulus]

theorem norm_ltWord (lhs rhs : Word) :
    norm (ltWord lhs rhs) = ltWord lhs rhs := by
  unfold norm
  change ltWord lhs rhs % wordModulus = ltWord lhs rhs
  unfold ltWord
  change (if norm lhs < norm rhs then 1 else 0) % wordModulus =
    if norm lhs < norm rhs then 1 else 0
  by_cases h : norm lhs < norm rhs <;> simp [h, wordModulus]

theorem norm_gtWord (lhs rhs : Word) :
    norm (gtWord lhs rhs) = gtWord lhs rhs := by
  unfold norm
  change gtWord lhs rhs % wordModulus = gtWord lhs rhs
  unfold gtWord
  change (if norm rhs < norm lhs then 1 else 0) % wordModulus =
    if norm rhs < norm lhs then 1 else 0
  by_cases h : norm rhs < norm lhs <;> simp [h, wordModulus]

theorem norm_sltWord (lhs rhs : Word) :
    norm (sltWord lhs rhs) = sltWord lhs rhs := by
  unfold norm
  change sltWord lhs rhs % wordModulus = sltWord lhs rhs
  unfold sltWord
  change (if signedValue lhs < signedValue rhs then 1 else 0) %
      wordModulus =
    if signedValue lhs < signedValue rhs then 1 else 0
  by_cases h : signedValue lhs < signedValue rhs <;> simp [h, wordModulus]

theorem norm_sgtWord (lhs rhs : Word) :
    norm (sgtWord lhs rhs) = sgtWord lhs rhs := by
  unfold norm
  change sgtWord lhs rhs % wordModulus = sgtWord lhs rhs
  unfold sgtWord
  change (if signedValue rhs < signedValue lhs then 1 else 0) %
      wordModulus =
    if signedValue rhs < signedValue lhs then 1 else 0
  by_cases h : signedValue rhs < signedValue lhs <;> simp [h, wordModulus]

theorem norm_andWord (lhs rhs : Word) :
    norm (andWord lhs rhs) = andWord lhs rhs := by
  simp [andWord, norm_norm]

theorem norm_orWord (lhs rhs : Word) :
    norm (orWord lhs rhs) = orWord lhs rhs := by
  simp [orWord, norm_norm]

theorem norm_xorWord (lhs rhs : Word) :
    norm (xorWord lhs rhs) = xorWord lhs rhs := by
  simp [xorWord, norm_norm]

theorem norm_notWord (value : Word) :
    norm (notWord value) = notWord value := by
  simp [notWord, norm_norm]

theorem norm_shlWord (shift value : Word) :
    norm (shlWord shift value) = shlWord shift value := by
  unfold shlWord
  by_cases h : 256 <= norm shift
  · simp only [h, if_true]
    simp [norm]
  · simp [h, norm_norm]

theorem norm_shrWord (shift value : Word) :
    norm (shrWord shift value) = shrWord shift value := by
  unfold shrWord
  by_cases h : 256 <= norm shift
  · simp only [h, if_true]
    simp [norm]
  · simp [h, norm_norm]

theorem norm_sarWord (shift value : Word) :
    norm (sarWord shift value) = sarWord shift value := by
  unfold sarWord
  by_cases h : 256 <= norm shift
  · simp only [h, if_true]
    by_cases hSign : signedValue value < 0
    · simp [hSign, norm_norm]
    · simp [hSign, norm_zero]
  · simp [h, norm_signedToWord]

theorem norm_byteWord (ix value : Word) :
    norm (byteWord ix value) = byteWord ix value := by
  unfold byteWord
  by_cases h : norm ix < 32
  · simp [h, norm_norm]
  · simp only [h, if_false]
    simp [norm]

theorem norm_signextendWord (ix value : Word) :
    norm (signextendWord ix value) = signextendWord ix value := by
  unfold signextendWord
  by_cases hIx : norm ix < 32
  · simp only [hIx, if_true]
    by_cases hSign :
        2 ^ (8 * norm ix + 7) ≤ norm value % 2 ^ (8 * norm ix + 7 + 1)
    · simp [hSign, norm_norm]
    · simp [hSign, norm_norm]
  · simp [hIx, norm_norm]

theorem norm_clzWord (value : Word) :
    norm (clzWord value) = clzWord value := by
  unfold clzWord
  simp [norm_norm]

theorem evalPureUnaryWordBuiltin_norm_arg
    (builtin : Evm.Builtin) (value : Word) :
    evalPureUnaryWordBuiltin builtin (norm value) =
      evalPureUnaryWordBuiltin builtin value := by
  cases builtin <;>
    simp [evalPureUnaryWordBuiltin, iszeroWord_norm_arg,
