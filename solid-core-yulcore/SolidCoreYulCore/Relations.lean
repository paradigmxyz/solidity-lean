theorem embedConcreteEnv_lookup? (env : ConcreteYul.Env) (name : FullYul.Name) :
    FullYul.lookup? (embedConcreteEnv env) name =
      (ConcreteYul.lookup? env name).map embedWordValue := by
  induction env with
  | nil =>
      rfl
  | cons binding rest ih =>
      cases binding with
      | mk candidate value =>
          by_cases hName : candidate = name
          · subst candidate
            simp [embedConcreteEnv, ConcreteYul.lookup?, FullYul.lookup?]
          · simp [embedConcreteEnv, ConcreteYul.lookup?, FullYul.lookup?,
              hName, ih]

theorem envWordExactRel_embedConcreteEnv_of_normalized
    {env : ConcreteYul.Env}
    (hNorm : EnvNormalized env) :
    EnvWordExactRel env (embedConcreteEnv env) := by
  intro name value hLookup
  exact
    ⟨ by simpa [hLookup] using embedConcreteEnv_lookup? env name
    , hNorm name value hLookup ⟩

theorem envRel_embedConcreteEnv (model : SymYul.ConcreteModel)
    (env : ConcreteYul.Env) :
    EnvRel model env (embedConcreteEnv env) := by
  intro name value hLookup
  refine ⟨embedWordValue value, ?_, ?_⟩
  · simpa [hLookup] using embedConcreteEnv_lookup? env name
  · exact valueRel_embedWordValue model value

theorem envRel_valuesForNames?
    {model : SymYul.ConcreteModel}
    {concrete : ConcreteYul.Env} {symbolic : FullYul.Env}
    {names : List FullYul.Name} {values : List Word}
    (hRel : EnvRel model concrete symbolic)
    (hConcrete :
      ConcreteYul.valuesForNames? concrete names = some values) :
    ∃ symbolicValues,
      FullYul.valuesForNames? symbolic names = some symbolicValues ∧
        WordListRel model values symbolicValues := by
  induction names generalizing values with
  | nil =>
      simp [ConcreteYul.valuesForNames?] at hConcrete
      cases hConcrete
      exact ⟨[], rfl, trivial⟩
  | cons name rest ih =>
      cases hLookup : ConcreteYul.lookup? concrete name with
      | none =>
          simp [ConcreteYul.valuesForNames?, hLookup] at hConcrete
      | some value =>
          cases hRest :
              ConcreteYul.valuesForNames? concrete rest with
          | none =>
              simp [ConcreteYul.valuesForNames?, hLookup, hRest] at hConcrete
          | some restValues =>
              simp [ConcreteYul.valuesForNames?, hLookup, hRest] at hConcrete
              cases hConcrete
              rcases hRel name value hLookup with
                ⟨symbolicValue, hSymbolicLookup, hValueRel⟩
              rcases ih hRest with
                ⟨symbolicRestValues, hSymbolicRest, hRestRel⟩
              exact
                ⟨ symbolicValue :: symbolicRestValues
                , by
                    simp [FullYul.valuesForNames?, hSymbolicLookup,
                      hSymbolicRest]
                , by simp [WordListRel, hValueRel, hRestRel] ⟩

theorem concrete_restoreOuter_lookup_inner
    {outer inner restored : ConcreteYul.Env}
    {name : FullYul.Name} {value : Word}
    (hRestore : ConcreteYul.restoreOuter outer inner = some restored)
    (hLookup : ConcreteYul.lookup? restored name = some value) :
    ConcreteYul.lookup? inner name = some value := by
  induction outer generalizing restored with
  | nil =>
      simp [ConcreteYul.restoreOuter] at hRestore
      cases hRestore
      simp [ConcreteYul.lookup?] at hLookup
  | cons binding rest ih =>
      cases binding with
      | mk currentName currentValue =>
          cases hInner : ConcreteYul.lookup? inner currentName with
          | none =>
              simp [ConcreteYul.restoreOuter, hInner] at hRestore
          | some innerValue =>
              cases hRest : ConcreteYul.restoreOuter rest inner with
              | none =>
                  simp [ConcreteYul.restoreOuter, hInner, hRest] at hRestore
              | some restoredRest =>
                  simp [ConcreteYul.restoreOuter, hInner, hRest] at hRestore
                  cases hRestore
                  by_cases hName : currentName = name
                  · subst currentName
                    simp [ConcreteYul.lookup?] at hLookup
                    cases hLookup
                    exact hInner
                  · simp [ConcreteYul.lookup?, hName] at hLookup
                    exact ih hRest hLookup

theorem concrete_restoreOuter_lookup_outer_exists
    {outer inner restored : ConcreteYul.Env}
    {name : FullYul.Name} {value : Word}
    (hRestore : ConcreteYul.restoreOuter outer inner = some restored)
    (hLookup : ConcreteYul.lookup? restored name = some value) :
    ∃ outerValue, ConcreteYul.lookup? outer name = some outerValue := by
  induction outer generalizing restored with
  | nil =>
      simp [ConcreteYul.restoreOuter] at hRestore
      cases hRestore
      simp [ConcreteYul.lookup?] at hLookup
  | cons binding rest ih =>
      cases binding with
      | mk currentName currentValue =>
          cases hInner : ConcreteYul.lookup? inner currentName with
          | none =>
              simp [ConcreteYul.restoreOuter, hInner] at hRestore
          | some innerValue =>
              cases hRest : ConcreteYul.restoreOuter rest inner with
              | none =>
                  simp [ConcreteYul.restoreOuter, hInner, hRest] at hRestore
              | some restoredRest =>
                  simp [ConcreteYul.restoreOuter, hInner, hRest] at hRestore
                  cases hRestore
                  by_cases hName : currentName = name
                  · subst currentName
                    exact ⟨currentValue, by simp [ConcreteYul.lookup?]⟩
                  · simp [ConcreteYul.lookup?, hName] at hLookup
                    rcases ih hRest hLookup with ⟨outerValue, hOuter⟩
                    exact
                      ⟨ outerValue
                      , by simp [ConcreteYul.lookup?, hName, hOuter] ⟩

theorem envRel_restoreOuter
    {model : SymYul.ConcreteModel}
    {concreteOuter concreteInner concreteRestored : ConcreteYul.Env}
    {symbolicOuter symbolicInner symbolicRestored : FullYul.Env}
    (hOuter : EnvRel model concreteOuter symbolicOuter)
    (hInner : EnvRel model concreteInner symbolicInner)
    (hConcrete :
      ConcreteYul.restoreOuter concreteOuter concreteInner =
        some concreteRestored)
    (hSymbolic :
      FullYul.restoreOuter symbolicOuter symbolicInner =
        some symbolicRestored) :
    EnvRel model concreteRestored symbolicRestored := by
  intro name value hLookup
  have hInnerLookup :
      ConcreteYul.lookup? concreteInner name = some value :=
    concrete_restoreOuter_lookup_inner hConcrete hLookup
  rcases concrete_restoreOuter_lookup_outer_exists hConcrete hLookup with
    ⟨outerValue, hOuterLookup⟩
  rcases hInner name value hInnerLookup with
    ⟨symbolicValue, hSymbolicInnerLookup, hValueRel⟩
  rcases hOuter name outerValue hOuterLookup with
    ⟨symbolicOuterValue, hSymbolicOuterLookup, _hOuterValueRel⟩
  refine ⟨symbolicValue, ?_, hValueRel⟩
  rw [FullYul.restoreOuter_preserves_outer_lookup hSymbolic
    hSymbolicOuterLookup]
  exact hSymbolicInnerLookup

theorem envExactRel_restoreOuter
    {model : SymYul.ConcreteModel}
    {concreteOuter concreteInner concreteRestored : ConcreteYul.Env}
    {symbolicOuter symbolicInner : FullYul.Env}
    (hOuter : EnvExactRel model concreteOuter symbolicOuter)
    (hInner : EnvExactRel model concreteInner symbolicInner)
    (hConcrete :
      ConcreteYul.restoreOuter concreteOuter concreteInner =
        some concreteRestored) :
    ∃ symbolicRestored,
      FullYul.restoreOuter symbolicOuter symbolicInner =
        some symbolicRestored ∧
      EnvExactRel model concreteRestored symbolicRestored := by
  induction concreteOuter generalizing symbolicOuter concreteRestored with
  | nil =>
      cases symbolicOuter with
      | nil =>
          simp [ConcreteYul.restoreOuter] at hConcrete
          cases hConcrete
          exact ⟨[], by simp [FullYul.restoreOuter], by trivial⟩
      | cons symbolicEntry symbolicRest =>
          simp [EnvExactRel] at hOuter
  | cons concreteEntry concreteRest ih =>
      cases symbolicOuter with
      | nil =>
          simp [EnvExactRel] at hOuter
      | cons symbolicEntry symbolicRest =>
          rcases hOuter with ⟨hHead, hTail⟩
          cases concreteEntry with
          | mk concreteName concreteValue =>
              cases symbolicEntry with
              | mk symbolicName symbolicValue =>
                  rcases hHead with ⟨hName, hValueRelOuter⟩
                  simp at hName hValueRelOuter
                  cases hLookup :
                      ConcreteYul.lookup? concreteInner concreteName with
                  | none =>
                      simp [ConcreteYul.restoreOuter, hLookup] at hConcrete
                  | some restoredValue =>
                      cases hRest :
                          ConcreteYul.restoreOuter concreteRest
                            concreteInner with
                      | none =>
                          simp [ConcreteYul.restoreOuter, hLookup, hRest]
                            at hConcrete
                      | some restoredRest =>
                          simp [ConcreteYul.restoreOuter, hLookup, hRest]
                            at hConcrete
                          cases hConcrete
                          rcases envExactRel_lookup? hInner hLookup with
                            ⟨symbolicRestoredValue, hSymbolicLookup,
                              hValueRel⟩
                          have hSymbolicLookup' :
                              FullYul.lookup? symbolicInner symbolicName =
                                some symbolicRestoredValue := by
                            simpa [← hName] using hSymbolicLookup
                          rcases ih hTail hRest with
                            ⟨symbolicRestoredRest, hSymbolicRest,
                              hRestExact⟩
                          exact
                            ⟨ (symbolicName, symbolicRestoredValue) ::
                                symbolicRestoredRest
                            , by
                                simp [FullYul.restoreOuter,
                                  hSymbolicLookup', hSymbolicRest]
                            , by
                                constructor
                                · constructor
                                  · exact hName
                                  · exact hValueRel
                                · exact hRestExact ⟩

theorem concrete_lookup?_assign_same
    {env env' : ConcreteYul.Env} {name : FullYul.Name} {value : Word}
    (hAssign : ConcreteYul.assign? env name value = some env') :
    ConcreteYul.lookup? env' name = some (norm value) := by
  induction env generalizing env' with
  | nil =>
      simp [ConcreteYul.assign?] at hAssign
  | cons binding rest ih =>
      cases binding with
      | mk candidate current =>
          by_cases hName : candidate = name
          · subst candidate
            simp [ConcreteYul.assign?] at hAssign ⊢
            cases hAssign
            simp [ConcreteYul.lookup?]
          · simp [ConcreteYul.assign?, hName] at hAssign
            cases hRest : ConcreteYul.assign? rest name value with
            | none =>
                simp [hRest] at hAssign
            | some rest' =>
                simp [hRest] at hAssign
                cases hAssign
                simp [ConcreteYul.lookup?, hName, ih hRest]

theorem concrete_lookup?_assign_other
    {env env' : ConcreteYul.Env} {assigned other : FullYul.Name}
    {value : Word}
    (hNe : other ≠ assigned)
    (hAssign : ConcreteYul.assign? env assigned value = some env') :
    ConcreteYul.lookup? env' other = ConcreteYul.lookup? env other := by
  induction env generalizing env' with
  | nil =>
      simp [ConcreteYul.assign?] at hAssign
  | cons binding rest ih =>
      cases binding with
      | mk candidate current =>
          by_cases hAssigned : candidate = assigned
          · subst candidate
            have hAssignedOther : assigned ≠ other := by
              intro hEq
              exact hNe hEq.symm
            simp [ConcreteYul.assign?] at hAssign ⊢
            cases hAssign
            simp [ConcreteYul.lookup?, hAssignedOther]
          · simp [ConcreteYul.assign?, hAssigned] at hAssign
            cases hRest : ConcreteYul.assign? rest assigned value with
            | none =>
                simp [hRest] at hAssign
            | some rest' =>
                simp [hRest] at hAssign
                cases hAssign
                by_cases hOther : candidate = other
                · subst candidate
                  simp [ConcreteYul.lookup?]
                · simp [ConcreteYul.lookup?, hOther, ih hRest]

theorem full_lookup?_assign_same
    {env env' : FullYul.Env} {name : FullYul.Name}
    {value : FullYul.Value}
    (hAssign : FullYul.assign? env name value = some env') :
    FullYul.lookup? env' name = some value := by
  induction env generalizing env' with
  | nil =>
      simp [FullYul.assign?] at hAssign
  | cons binding rest ih =>
      cases binding with
      | mk candidate current =>
          by_cases hName : candidate = name
          · subst candidate
            simp [FullYul.assign?] at hAssign ⊢
            cases hAssign
            simp [FullYul.lookup?]
          · simp [FullYul.assign?, hName] at hAssign
            cases hRest : FullYul.assign? rest name value with
            | none =>
                simp [hRest] at hAssign
            | some rest' =>
                simp [hRest] at hAssign
                cases hAssign
                simp [FullYul.lookup?, hName, ih hRest]

theorem full_lookup?_assign_other
    {env env' : FullYul.Env} {assigned other : FullYul.Name}
    {value : FullYul.Value}
    (hNe : other ≠ assigned)
