    | succ fuel =>
        simp [SymYul.guidedEvalStmtFuel, embedConcreteStmt,
          embedConcreteStmtFuel, hGuidedCond, hBool, hGuidedBody']

theorem concreteSwitchTarget_default_of_none
    {value : Word} {cases : List (Word × ConcreteYul.Stmt)}
    {defaultBranch : ConcreteYul.Stmt}
    (hNoCase : ConcreteYul.switchTarget? value cases none = none) :
    ConcreteYul.switchTarget? value cases (some defaultBranch) =
      some defaultBranch := by
  induction cases with
  | nil =>
      simp [ConcreteYul.switchTarget?]
  | cons head rest ih =>
      rcases head with ⟨label, branch⟩
      by_cases hMatch : norm label = norm value
      · simp [ConcreteYul.switchTarget?, hMatch] at hNoCase
      · have hRest :
            ConcreteYul.switchTarget? value rest none = none := by
          simpa [ConcreteYul.switchTarget?, hMatch] using hNoCase
        simp [ConcreteYul.switchTarget?, hMatch, ih hRest]

theorem concreteSwitchTarget_none_implies_no_default
    {value : Word} {cases : List (Word × ConcreteYul.Stmt)}
    {defaultBranch : Option ConcreteYul.Stmt}
    (hTarget :
      ConcreteYul.switchTarget? value cases defaultBranch = none) :
    defaultBranch = none := by
  induction cases with
  | nil =>
      cases defaultBranch <;> simp [ConcreteYul.switchTarget?] at hTarget
      rfl
  | cons head rest ih =>
      rcases head with ⟨label, branch⟩
      by_cases hMatch : norm label = norm value
      · simp [ConcreteYul.switchTarget?, hMatch] at hTarget
      · exact ih (by
          simpa [ConcreteYul.switchTarget?, hMatch] using hTarget)

theorem guidedSwitchTarget_embed_of_concrete_none
    (model : SymYul.ConcreteModel) (embedFuel : Nat)
    {value : Word} {cases : List (Word × ConcreteYul.Stmt)}
    {defaultBranch : Option FullYul.Stmt}
    (hNoCase : ConcreteYul.switchTarget? value cases none = none) :
    SymYul.guidedSwitchTarget? model (embedWordValue value)
        (embedConcreteSwitchCasesFuel embedFuel cases) defaultBranch =
      defaultBranch := by
  induction embedFuel generalizing cases with
  | zero =>
      simp [embedConcreteSwitchCasesFuel, SymYul.guidedSwitchTarget?]
  | succ embedFuel ih =>
      cases cases with
      | nil =>
          simp [embedConcreteSwitchCasesFuel, SymYul.guidedSwitchTarget?]
      | cons head rest =>
          rcases head with ⟨label, branch⟩
          by_cases hMatch : norm label = norm value
          · simp [ConcreteYul.switchTarget?, hMatch] at hNoCase
          · have hRest :
                ConcreteYul.switchTarget? value rest none = none := by
              simpa [ConcreteYul.switchTarget?, hMatch] using hNoCase
            have hGuidedNe : norm value ≠ norm label := by
              intro hEq
              exact hMatch hEq.symm
            simpa [embedConcreteSwitchCasesFuel, SymYul.guidedSwitchTarget?,
              SymYul.interpValue, embedWordValue, norm_norm, hGuidedNe]
              using ih hRest

theorem guidedSwitchTarget_rel_of_concrete_none
    (model : SymYul.ConcreteModel) (embedFuel : Nat)
    {value : Word} {symbolicValue : FullYul.Value}
    {cases : List (Word × ConcreteYul.Stmt)}
    {defaultBranch : Option FullYul.Stmt}
    (hValueRel : ValueRel model value symbolicValue)
    (hNoCase : ConcreteYul.switchTarget? value cases none = none) :
    SymYul.guidedSwitchTarget? model symbolicValue
        (embedConcreteSwitchCasesFuel embedFuel cases) defaultBranch =
      defaultBranch := by
  induction embedFuel generalizing cases with
  | zero =>
      simp [embedConcreteSwitchCasesFuel, SymYul.guidedSwitchTarget?]
  | succ embedFuel ih =>
      cases cases with
      | nil =>
          simp [embedConcreteSwitchCasesFuel, SymYul.guidedSwitchTarget?]
      | cons head rest =>
          rcases head with ⟨label, branch⟩
          by_cases hMatch : norm label = norm value
          · simp [ConcreteYul.switchTarget?, hMatch] at hNoCase
          · have hRest :
                ConcreteYul.switchTarget? value rest none = none := by
              simpa [ConcreteYul.switchTarget?, hMatch] using hNoCase
            have hGuidedNe :
                norm (SymYul.interpValue model symbolicValue) ≠
                  norm (SymYul.interpValue model (embedWordValue label)) := by
              intro hEq
              apply hMatch
              have hLeft :
                  norm (SymYul.interpValue model symbolicValue) =
                    norm value := by
                rw [interpValue_norm model symbolicValue, ← hValueRel]
              have hRight :
                  norm
                      (SymYul.interpValue model (embedWordValue label)) =
                    norm label := by
                simp [SymYul.interpValue, embedWordValue, norm_norm]
              calc
                norm label =
                    norm
                      (SymYul.interpValue model (embedWordValue label)) :=
                  hRight.symm
                _ = norm (SymYul.interpValue model symbolicValue) := hEq.symm
                _ = norm value := hLeft
            simpa [embedConcreteSwitchCasesFuel,
              SymYul.guidedSwitchTarget?, hGuidedNe] using ih hRest

theorem guidedSwitchTarget_rel_of_concrete_some_positional
    (model : SymYul.ConcreteModel) (baseFuel defaultEmbedFuel : Nat)
    {value : Word}
    {cases : List (Word × ConcreteYul.Stmt)}
    {defaultBranch : Option ConcreteYul.Stmt} {target : ConcreteYul.Stmt}
    (hDefaultFuel : 2 ≤ defaultEmbedFuel)
    (hTarget :
      ConcreteYul.switchTarget? value cases defaultBranch = some target) :
    ∃ targetEmbedFuel,
      2 ≤ targetEmbedFuel ∧
      ∀ symbolicValue,
        ValueRel model value symbolicValue ->
        SymYul.guidedSwitchTarget? model symbolicValue
            (embedConcreteSwitchCasesFuel (cases.length + baseFuel + 2) cases)
            (defaultBranch.map (embedConcreteStmtFuel defaultEmbedFuel)) =
          some (embedConcreteStmtFuel targetEmbedFuel target) := by
  induction cases generalizing target defaultBranch with
  | nil =>
      cases defaultBranch with
      | none =>
          simp [ConcreteYul.switchTarget?] at hTarget
      | some branch =>
          have hEq : branch = target := by
            simpa [ConcreteYul.switchTarget?] using hTarget
          subst target
          exact
            ⟨ defaultEmbedFuel
            , hDefaultFuel
            , by
                intro symbolicValue _hValueRel
                simp [embedConcreteSwitchCasesFuel,
                  SymYul.guidedSwitchTarget?] ⟩
  | cons head rest ih =>
      rcases head with ⟨label, branch⟩
      by_cases hMatch : norm label = norm value
      · have hEq : branch = target := by
          simpa [ConcreteYul.switchTarget?, hMatch] using hTarget
        subst target
        exact
          ⟨ rest.length + baseFuel + 2
          , by
              simpa [Nat.add_assoc] using
                Nat.le_add_left 2 (rest.length + baseFuel)
          , by
              intro symbolicValue hValueRel
              have hGuidedMatch :
                  norm (SymYul.interpValue model symbolicValue) =
                    norm (SymYul.interpValue model (embedWordValue label)) := by
                have hLeft :
                    norm (SymYul.interpValue model symbolicValue) =
                      norm value := by
                  rw [interpValue_norm model symbolicValue, ← hValueRel]
                have hRight :
                    norm (SymYul.interpValue model (embedWordValue label)) =
                      norm label := by
                  simp [SymYul.interpValue, embedWordValue, norm_norm]
                calc
                  norm (SymYul.interpValue model symbolicValue) =
                      norm value :=
                    hLeft
                  _ = norm label := hMatch.symm
                  _ = norm (SymYul.interpValue model (embedWordValue label)) :=
                    hRight.symm
              simp [embedConcreteSwitchCasesFuel, SymYul.guidedSwitchTarget?,
                hGuidedMatch, Nat.add_assoc,
                Nat.add_left_comm, Nat.add_comm] ⟩
      · have hRestTarget :
            ConcreteYul.switchTarget? value rest defaultBranch =
              some target := by
          simpa [ConcreteYul.switchTarget?, hMatch] using hTarget
        rcases ih hRestTarget with
          ⟨targetEmbedFuel, hTargetFuel, hGuidedRest⟩
        exact
          ⟨ targetEmbedFuel
          , hTargetFuel
          , by
              intro symbolicValue hValueRel
              have hGuidedNe :
                  norm (SymYul.interpValue model symbolicValue) ≠
                    norm (SymYul.interpValue model (embedWordValue label)) := by
                intro hEq
                apply hMatch
                have hLeft :
                    norm (SymYul.interpValue model symbolicValue) =
                      norm value := by
                  rw [interpValue_norm model symbolicValue, ← hValueRel]
                have hRight :
                    norm (SymYul.interpValue model (embedWordValue label)) =
                      norm label := by
                  simp [SymYul.interpValue, embedWordValue, norm_norm]
                calc
                  norm label =
                      norm (SymYul.interpValue model (embedWordValue label)) :=
                    hRight.symm
                  _ = norm (SymYul.interpValue model symbolicValue) := hEq.symm
                  _ = norm value := hLeft
              have hGuidedRest' := hGuidedRest symbolicValue hValueRel
              simp only [embedConcreteSwitchCasesFuel,
                SymYul.guidedSwitchTarget?]
              rw [if_neg hGuidedNe]
              simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm]
                using hGuidedRest' ⟩

theorem guidedSwitchTarget_rel_second_of_valueRel
    (model : SymYul.ConcreteModel) (targetEmbedFuel : Nat)
    {value : Word} {symbolicValue : FullYul.Value}
    {label₁ label₂ : Word} {branch₁ branch₂ : ConcreteYul.Stmt}
    {defaultBranch : Option FullYul.Stmt}
    (hValueRel : ValueRel model value symbolicValue)
    (hMiss : norm label₁ ≠ norm value)
    (hMatch : norm label₂ = norm value) :
    SymYul.guidedSwitchTarget? model symbolicValue
        (embedConcreteSwitchCasesFuel targetEmbedFuel.succ.succ
          [(label₁, branch₁), (label₂, branch₂)])
        defaultBranch =
      some (embedConcreteStmtFuel targetEmbedFuel branch₂) := by
  have hGuidedMiss :
      norm (SymYul.interpValue model symbolicValue) ≠
        norm (SymYul.interpValue model (embedWordValue label₁)) := by
    intro hEq
    apply hMiss
    have hLeft :
        norm (SymYul.interpValue model symbolicValue) = norm value := by
      rw [interpValue_norm model symbolicValue, ← hValueRel]
    have hRight :
        norm (SymYul.interpValue model (embedWordValue label₁)) =
          norm label₁ := by
      simp [SymYul.interpValue, embedWordValue, norm_norm]
    calc
      norm label₁ =
          norm (SymYul.interpValue model (embedWordValue label₁)) :=
        hRight.symm
      _ = norm (SymYul.interpValue model symbolicValue) := hEq.symm
      _ = norm value := hLeft
  have hGuidedMatch :
      norm (SymYul.interpValue model symbolicValue) =
        norm (SymYul.interpValue model (embedWordValue label₂)) := by
    have hLeft :
        norm (SymYul.interpValue model symbolicValue) = norm value := by
      rw [interpValue_norm model symbolicValue, ← hValueRel]
    have hRight :
        norm (SymYul.interpValue model (embedWordValue label₂)) =
          norm label₂ := by
      simp [SymYul.interpValue, embedWordValue, norm_norm]
    calc
      norm (SymYul.interpValue model symbolicValue) = norm value := hLeft
      _ = norm label₂ := hMatch.symm
      _ = norm (SymYul.interpValue model (embedWordValue label₂)) :=
        hRight.symm
  simp only [embedConcreteSwitchCasesFuel, SymYul.guidedSwitchTarget?]
  rw [if_neg hGuidedMiss]
  rw [if_pos hGuidedMatch]

private theorem evalRuntimeStmt_switch_first_refines_guided_of_discr_body
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    (fuel embedFuel : Nat) {config config' : ConcreteYul.RuntimeConfig}
    {discr : ConcreteYul.Expr} {label value : Word}
    {branch : ConcreteYul.Stmt} {rest : List (Word × ConcreteYul.Stmt)}
