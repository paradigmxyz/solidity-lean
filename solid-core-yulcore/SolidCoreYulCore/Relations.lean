theorem runtimeBlockFuelRelSim_of_covered_spec_fuel_upTo
    {StmtRel :
      Nat -> Nat -> ConcreteYul.RuntimeConfig -> SymYul.GuidedConfig ->
        ConcreteYul.Stmt -> Prop}
    {BlockRel :
      Nat -> Nat -> ConcreteYul.RuntimeConfig -> SymYul.GuidedConfig ->
        List ConcreteYul.Stmt -> Prop}
    {ConfigRel :
      ConcreteYul.RuntimeConfig -> SymYul.GuidedConfig -> Prop}
    {fuel embedFuel maxFunctionFuel : Nat}
    {spec : RuntimeCoverageSpec}
    (zeroRel :
      ∀ {embedFuel : Nat}
        {concreteConfig : ConcreteYul.RuntimeConfig}
        {symbolicConfig : SymYul.GuidedConfig}
        {stmts : List ConcreteYul.Stmt},
        BlockRel 0 embedFuel concreteConfig symbolicConfig stmts)
    (emptyRel :
      ∀ {fuel embedFuel : Nat}
        {concreteConfig : ConcreteYul.RuntimeConfig}
        {symbolicConfig : SymYul.GuidedConfig},
        BlockRel fuel.succ embedFuel concreteConfig symbolicConfig [])
    (consRel :
      ∀ {fuel embedFuel : Nat}
        {concreteConfig : ConcreteYul.RuntimeConfig}
        {symbolicConfig : SymYul.GuidedConfig}
        {stmt : ConcreteYul.Stmt} {rest : List ConcreteYul.Stmt},
        StmtRel fuel embedFuel concreteConfig symbolicConfig stmt ->
        (∀ {concreteConfig' : ConcreteYul.RuntimeConfig}
          {symbolicConfig' : SymYul.GuidedConfig},
          ConfigRel concreteConfig' symbolicConfig' ->
          BlockRel fuel embedFuel concreteConfig' symbolicConfig' rest) ->
        BlockRel fuel.succ embedFuel.succ concreteConfig symbolicConfig
          (stmt :: rest))
    (headRel :
      ∀ {fuel embedFuel : Nat}
        {stmt : ConcreteYul.Stmt}
        {concreteConfig : ConcreteYul.RuntimeConfig}
        {symbolicConfig : SymYul.GuidedConfig},
        fuel.pred ≤ maxFunctionFuel ->
        RuntimeCoveredStmtSpec spec stmt ->
        2 ≤ embedFuel ->
        StmtRel fuel embedFuel concreteConfig symbolicConfig stmt)
    {length : Nat} {stmts : List ConcreteYul.Stmt}
    {concreteConfig : ConcreteYul.RuntimeConfig}
    {symbolicConfig : SymYul.GuidedConfig}
    (hFunctionFuel : fuel.pred ≤ maxFunctionFuel)
    (hCovered : RuntimeCoveredBlockSpec spec length stmts)
    (hEmbedFuel : length + 2 ≤ embedFuel) :
    BlockRel fuel embedFuel concreteConfig symbolicConfig stmts := by
  induction hCovered generalizing fuel embedFuel concreteConfig symbolicConfig with
  | nil =>
      cases fuel with
      | zero =>
          exact zeroRel
      | succ fuel =>
          exact emptyRel
  | cons hStmt hRest ih =>
      rename_i stmt rest length
      cases fuel with
      | zero =>
          exact zeroRel
      | succ fuel =>
          cases embedFuel with
          | zero =>
              cases hEmbedFuel
          | succ embedFuel =>
              have hTailEmbed : length + 2 ≤ embedFuel := by
                exact
                  Nat.succ_le_succ_iff.mp
                    (by
                      simpa [Nat.succ_eq_add_one, Nat.add_assoc] using
                        hEmbedFuel)
              have hHeadEmbed : 2 ≤ embedFuel :=
                Nat.le_trans (Nat.le_add_left 2 length) hTailEmbed
              have hHeadFunctionFuel : fuel.pred ≤ maxFunctionFuel :=
                Nat.le_trans (Nat.pred_le fuel) hFunctionFuel
              simpa [Nat.succ_eq_add_one, Nat.add_assoc] using
                consRel
                  (headRel hHeadFunctionFuel hStmt hHeadEmbed)
                  (fun {_concreteConfig'} {_symbolicConfig'} _hConfigRel =>
                    ih hHeadFunctionFuel hTailEmbed)

theorem runtimeBlockFuelReadValueExactRelSim_of_covered_spec_dispatchers_fuel_upTo
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
