      exact
        embedCompleteFlow_eq_normal_iff.mp
          (by simpa [embedRuntimeResult, hSymbolic])
    simpa [embedRuntimeConfig, embedConcreteStmtFuel] using
      (SymYul.guidedEvalStmtFuel_seq_first_non_normal_of_head
        (model := model) (fuel := fuel)
        (config := embedRuntimeConfig config)
        (first := embedConcreteStmtFuel embedFuel first)
        (second := embedConcreteStmtFuel embedFuel second)
        hSymbolicFlow
        (by simpa [embedRuntimeConfig] using hGuidedFirst))

