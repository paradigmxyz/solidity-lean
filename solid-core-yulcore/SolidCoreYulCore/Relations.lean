structure RuntimePrimitiveDispatcherExact
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    (DataOffsetOK : FullYul.DataLabel -> Prop)
    (BuiltinExprOK BuiltinValuesOK :
      Evm.Builtin -> List ConcreteYul.Expr -> Prop) : Prop where
  dataOffset :
    ∀ {concreteConfig : ConcreteYul.RuntimeConfig}
      {symbolicConfig : SymYul.GuidedConfig}
      {label : FullYul.DataLabel},
      DataOffsetOK label ->
      RuntimeExprExactRelSim model hash concreteConfig symbolicConfig
        (ConcreteYul.Expr.dataOffset label)
  builtinExpr :
    ∀ {concreteConfig : ConcreteYul.RuntimeConfig}
      {symbolicConfig : SymYul.GuidedConfig}
      {builtin : Evm.Builtin} {args : List ConcreteYul.Expr},
      BuiltinExprOK builtin args ->
      RuntimeExprsExactRelSim model hash concreteConfig symbolicConfig args ->
      RuntimeExprExactRelSim model hash concreteConfig symbolicConfig
        (ConcreteYul.Expr.builtin builtin args)
  builtinValues :
    ∀ {concreteConfig : ConcreteYul.RuntimeConfig}
      {symbolicConfig : SymYul.GuidedConfig}
      {builtin : Evm.Builtin} {args : List ConcreteYul.Expr},
      BuiltinValuesOK builtin args ->
      RuntimeExprsExactRelSim model hash concreteConfig symbolicConfig args ->
      RuntimeExprsAsYulValuesExactRelSim model hash concreteConfig
        symbolicConfig [ConcreteYul.Expr.builtin builtin args]

