theorem runtimeFunctionDispatcherExactUpTo_of_body_provider
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    (maxFuel : Nat)
    {FunctionOK : FullYul.Name -> List ConcreteYul.Expr -> Prop}
    (hBody :
      RuntimeFunctionBodyProviderExactUpTo model hash maxFuel FunctionOK) :
    RuntimeFunctionDispatcherExactUpTo model hash maxFuel FunctionOK where
  function := by
    intro fuel concreteConfig symbolicConfig fnName args argValues
      symbolicArgValues hFuel hOK
    cases fuel with
    | zero =>
        exact
          runtimeFunctionExactRelSim_of_concrete_none
            (by simp [ConcreteYul.evalRuntimeFunctionFuel])
    | succ fuel =>
        cases hLookup :
            ConcreteYul.lookupFunction? concreteConfig.funcs fnName with
        | none =>
            exact
              runtimeFunctionExactRelSim_of_concrete_none
                (by
                  simp [ConcreteYul.evalRuntimeFunctionFuel, hLookup])
        | some fn =>
            intro hInputExact hArgsRel concreteValues concreteConfig'
              hConcreteResult
            rcases hBody hFuel hOK hInputExact hLookup with
              ⟨hCollectedRel, hBodyExact⟩
            exact
              (runtimeFunctionExactRelSim_of_body model hash fuel hLookup
                hCollectedRel hBodyExact)
                hInputExact hArgsRel concreteValues concreteConfig'
                hConcreteResult

