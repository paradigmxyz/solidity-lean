theorem namedFunctionBodyEmbedFuel_ge_two
    (fnName : FullYul.Name) (fn : ConcreteYul.FunctionDef) :
    2 ≤
      1 + fnName + sizeOf fn.params + sizeOf fn.returns +
        sizeOf fn.body := by
  have hBody : 1 ≤ sizeOf fn.body := by
    cases fn.body <;> simp [Nat.add_assoc] <;>
      exact Nat.succ_le_succ (Nat.zero_le _)
  have hReturns : 1 ≤ sizeOf fn.returns + sizeOf fn.body :=
    Nat.le_trans hBody (Nat.le_add_left _ _)
  have hParams :
      1 ≤ sizeOf fn.params + (sizeOf fn.returns + sizeOf fn.body) :=
    Nat.le_trans hReturns (Nat.le_add_left _ _)
  have hName :
      1 ≤ fnName +
        (sizeOf fn.params + (sizeOf fn.returns + sizeOf fn.body)) :=
    Nat.le_trans hParams (Nat.le_add_left _ _)
  have h := Nat.add_le_add_left hName 1
  simpa [Nat.add_assoc, Nat.succ_eq_add_one] using h

theorem runtimeFunctionBodyProviderExactUpTo_of_covered_bodies_using_dispatchers
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    (bodyMaxFuel dispatcherMaxFuel : Nat)
    {spec : RuntimeCoverageSpec}
    (hDispatchers :
      RuntimeCoveredDispatchersExactUpTo model hash dispatcherMaxFuel spec)
    (hFuelBudget :
      ∀ {fuel : Nat}, fuel.succ ≤ bodyMaxFuel ->
        fuel.pred ≤ dispatcherMaxFuel)
    (hBodies :
      ∀ {concreteConfig : ConcreteYul.RuntimeConfig}
        {symbolicConfig : SymYul.GuidedConfig}
        {fnName : FullYul.Name} {args : List ConcreteYul.Expr}
        {fn : ConcreteYul.FunctionDef},
        RuntimeConfigExactRel model concreteConfig symbolicConfig ->
        spec.FunctionOK fnName args ->
        ConcreteYul.lookupFunction? concreteConfig.funcs fnName = some fn ->
        RuntimeCoveredStmtSpec spec fn.body) :
    RuntimeFunctionBodyProviderExactUpTo model hash bodyMaxFuel
      spec.FunctionOK := by
  intro fuel concreteConfig symbolicConfig fnName args fn hFuel hOK
    hConfigExact hLookup
  let bodyEmbedFuel :=
    1 + fnName + sizeOf fn.params + sizeOf fn.returns + sizeOf fn.body
  have hCovered : RuntimeCoveredStmtSpec spec fn.body :=
    hBodies hConfigExact hOK hLookup
  have hConcreteStable :
      ConcreteYul.collectStmtFunctionDefs fn.body concreteConfig.funcs =
        concreteConfig.funcs :=
    collectStmtFunctionDefs_runtimeCoveredStmt_stable hCovered
  have hBodyEmbedFuel : 2 ≤ bodyEmbedFuel := by
    dsimp [bodyEmbedFuel]
    exact namedFunctionBodyEmbedFuel_ge_two fnName fn
  have hBodyEmbedFuelEq :
      bodyEmbedFuel = (bodyEmbedFuel - 2).succ.succ := by
    have h := (Nat.sub_add_cancel hBodyEmbedFuel).symm
    simpa [Nat.succ_eq_add_one, Nat.add_assoc] using h
  have hSymbolicStable :
      SymYul.collectStmtFunctionDefs
          (embedConcreteNamedFunctionDef fnName fn).body
          symbolicConfig.funcs =
        symbolicConfig.funcs := by
    dsimp [embedConcreteNamedFunctionDef, bodyEmbedFuel] at hBodyEmbedFuelEq ⊢
    rw [hBodyEmbedFuelEq]
    exact
      collectStmtFunctionDefs_embedRuntimeCoveredStmt_stable
        (bodyEmbedFuel - 2) hCovered
  constructor
  · calc
      SymYul.collectStmtFunctionDefs
          (embedConcreteNamedFunctionDef fnName fn).body
          symbolicConfig.funcs =
          symbolicConfig.funcs := hSymbolicStable
      _ = embedConcreteFunctionEnv concreteConfig.funcs :=
          hConfigExact.rel.funcsRel
      _ = embedConcreteFunctionEnv
            (ConcreteYul.collectStmtFunctionDefs fn.body
              concreteConfig.funcs) := by
          rw [hConcreteStable]
  · intro callEnv symbolicCallEnv hCallExact
    exact
      runtimeStmtFuelExactRelSim_of_covered_spec_dispatchers_fuel_upTo
        model hash hDispatchers (hFuelBudget hFuel) hCovered hBodyEmbedFuel

theorem runtimeFunctionBodyProviderExactUpTo_succ_of_covered_function_bodies
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    (prevFuel : Nat)
    {spec : RuntimeCoverageSpec}
    (hDispatchers :
