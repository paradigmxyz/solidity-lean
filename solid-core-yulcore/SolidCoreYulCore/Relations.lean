noncomputable def RuntimeFunctionBodyProviderExactUpTo
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    (maxFuel : Nat)
    (FunctionOK : FullYul.Name -> List ConcreteYul.Expr -> Prop) : Prop :=
  ∀ {fuel : Nat}
    {concreteConfig : ConcreteYul.RuntimeConfig}
    {symbolicConfig : SymYul.GuidedConfig}
    {fnName : FullYul.Name} {args : List ConcreteYul.Expr}
    {fn : ConcreteYul.FunctionDef},
    fuel.succ ≤ maxFuel ->
    FunctionOK fnName args ->
    RuntimeConfigExactRel model concreteConfig symbolicConfig ->
    ConcreteYul.lookupFunction? concreteConfig.funcs fnName = some fn ->
    SymYul.collectStmtFunctionDefs
        (embedConcreteNamedFunctionDef fnName fn).body
        symbolicConfig.funcs =
      embedConcreteFunctionEnv
        (ConcreteYul.collectStmtFunctionDefs fn.body concreteConfig.funcs) ∧
    ∀ {callEnv : ConcreteYul.Env} {symbolicCallEnv : FullYul.Env},
      RuntimeConfigExactRel model
        { concreteConfig with
          env := callEnv
          funcs :=
            ConcreteYul.collectStmtFunctionDefs fn.body
              concreteConfig.funcs }
        { symbolicConfig with
          env := symbolicCallEnv
          funcs :=
            SymYul.collectStmtFunctionDefs
              (embedConcreteNamedFunctionDef fnName fn).body
              symbolicConfig.funcs } ->
      RuntimeStmtFuelExactRelSim model hash fuel
        (1 + fnName + sizeOf fn.params + sizeOf fn.returns +
          sizeOf fn.body)
        { concreteConfig with
          env := callEnv
          funcs :=
            ConcreteYul.collectStmtFunctionDefs fn.body
              concreteConfig.funcs }
        { symbolicConfig with
          env := symbolicCallEnv
          funcs :=
            SymYul.collectStmtFunctionDefs
              (embedConcreteNamedFunctionDef fnName fn).body
              symbolicConfig.funcs }
        fn.body

