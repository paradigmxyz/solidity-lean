        ConcreteYul.lookupFunction? concreteConfig.funcs fnName = some fn ->
        RuntimeCoveredStmtSpec spec fn.body) :
    RuntimeFunctionBodyProviderExactUpTo model hash prevFuel.succ
      spec.FunctionOK :=
  runtimeFunctionBodyProviderExactUpTo_of_covered_bodies_using_dispatchers
    model hash prevFuel.succ prevFuel hDispatchers
    (by
      intro fuel hFuel
      exact Nat.le_trans (Nat.pred_le fuel)
