theorem runtimeExprsRelSim_cons_of_rest_expr
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    {concreteConfig : ConcreteYul.RuntimeConfig}
    {symbolicConfig : SymYul.GuidedConfig}
    {expr : ConcreteYul.Expr} {rest : List ConcreteYul.Expr}
    (hRest :
      RuntimeExprsRelSim model hash concreteConfig symbolicConfig rest)
    (hExpr :
      ∀ {concreteRestConfig : ConcreteYul.RuntimeConfig}
        {symbolicRestConfig : SymYul.GuidedConfig},
        RuntimeConfigRel model concreteRestConfig symbolicRestConfig ->
        RuntimeExprRelSim model hash concreteRestConfig symbolicRestConfig
          expr) :
    RuntimeExprsRelSim model hash concreteConfig symbolicConfig
      (expr :: rest) := by
  intro hInputRel concreteValues concreteConfig' hConcrete
  cases hRestEval :
      ConcreteYul.evalRuntimeExprs hash rest concreteConfig with
  | none =>
      simp [ConcreteYul.evalRuntimeExprs, hRestEval] at hConcrete
  | some restResult =>
      cases restResult with
      | mk restValues restConfig =>
          cases hExprEval :
              ConcreteYul.evalRuntimeExpr hash expr restConfig with
          | none =>
              simp [ConcreteYul.evalRuntimeExprs, hRestEval, hExprEval]
                at hConcrete
          | some exprResult =>
              cases exprResult with
              | mk value exprConfig =>
                  simp [ConcreteYul.evalRuntimeExprs, hRestEval, hExprEval]
                    at hConcrete
                  rcases hConcrete with ⟨hValues, hConfig⟩
                  subst concreteValues
                  subst concreteConfig'
                  rcases hRest hInputRel restValues restConfig hRestEval with
                    ⟨symbolicRestValues, symbolicRestConfig, hGuidedRest,
                      hRestValuesRel, hRestConfigRel⟩
                  have hExprSim := hExpr hRestConfigRel
                  rcases hExprSim hRestConfigRel value exprConfig
                      hExprEval with
                    ⟨symbolicValue, symbolicExprConfig, hGuidedExpr,
                      hValueRel, hExprConfigRel⟩
                  exact
                    ⟨ symbolicValue :: symbolicRestValues
                    , symbolicExprConfig
                    , by
                        simp [SymYul.guidedEvalExprs, embedConcreteExprs,
                          hGuidedRest, hGuidedExpr]
                    , by simp [WordListRel, hValueRel, hRestValuesRel]
                    , hExprConfigRel ⟩

