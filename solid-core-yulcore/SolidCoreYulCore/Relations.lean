theorem evalRuntimeExpr_setimmutable_positions_memory_summary
    (hash : ConcreteYul.HashOracle)
    (config : ConcreteYul.RuntimeConfig) (offset key value : Word)
    (positions : List Word)
    (hPositions :
      ConcreteYul.lookupWordListMap? config.state.immutablePositions key =
        some positions) :
    ConcreteYul.evalRuntimeExpr hash
        (ConcreteYul.Expr.builtin Evm.Builtin.setimmutableOp
          [ ConcreteYul.Expr.word offset
          , ConcreteYul.Expr.word key
          , ConcreteYul.Expr.word value ]) config =
      some
        ( 0
        , { config with
            state :=
              ConcreteYul.writeImmutableMemory
                { config.state with
                  immutables :=
                    ConcreteYul.writeWordMap
                      config.state.immutables key value }
                (norm offset) positions (norm value) } ) ∧
    SymYul.guidedEvalExpr (embedRuntimeConfig config)
        (embedConcreteExpr
          (ConcreteYul.Expr.builtin Evm.Builtin.setimmutableOp
            [ ConcreteYul.Expr.word offset
            , ConcreteYul.Expr.word key
            , ConcreteYul.Expr.word value ])) =
      some
        ( embedWordValue 0
        , embedRuntimeConfig
            { config with
              state :=
                { config.state with
                  immutables :=
                    ConcreteYul.writeWordMap
                      config.state.immutables key value } } ) := by
  have hPositionsNorm :
      ConcreteYul.lookupWordListMap? config.state.immutablePositions
          (norm key) = some positions := by
    simpa [concrete_lookupWordListMap?_norm_key] using hPositions
  constructor
  · simp [ConcreteYul.evalRuntimeExpr, ConcreteYul.evalExpr,
      ConcreteYul.evalExprs, ConcreteYul.evalBuiltin_setimmutable_positions,
      hPositionsNorm, ConcreteYul.returnUnit, ConcreteYul.returnWord,
      ConcreteYul.RuntimeConfig.toConfig, ConcreteYul.RuntimeConfig.withConfig,
      concrete_writeWordMap_norm_args, norm_zero]
  · simp [SymYul.guidedEvalExpr, SymYul.guidedEvalExprs,
      FullYul.evalEvmBuiltin_setimmutable_values, FullYul.returnUnit,
      FullYul.returnWord,
      embedConcreteExpr, embedConcreteExprs, embedRuntimeConfig, embedWordValue,
      embedConcreteState_immutables_write, norm_zero]

theorem runtimeExprExactRelSim_setimmutable_positions_model
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    (concreteConfig : ConcreteYul.RuntimeConfig)
    (symbolicConfig : SymYul.GuidedConfig) (offset key value : Word)
    (positions : List Word)
    (hPositions :
      ConcreteYul.lookupWordListMap?
          concreteConfig.state.immutablePositions key = some positions)
    (hMemorySize :
      norm symbolicConfig.evm.msize =
        norm
          (ConcreteYul.writeImmutableMemory
            { concreteConfig.state with
              immutables :=
                ConcreteYul.writeWordMap concreteConfig.state.immutables
                  key value }
            (norm offset) positions (norm value)).memorySize) :
    RuntimeExprExactRelSim model hash concreteConfig symbolicConfig
      (ConcreteYul.Expr.builtin Evm.Builtin.setimmutableOp
        [ ConcreteYul.Expr.word offset
        , ConcreteYul.Expr.word key
        , ConcreteYul.Expr.word value ]) := by
  intro hExact concreteValue concreteConfig' hConcrete
  have hConcreteExpected :=
    (evalRuntimeExpr_setimmutable_positions_memory_summary
      hash concreteConfig offset key value positions hPositions).1
  rw [hConcreteExpected] at hConcrete
  cases hConcrete
  have hMemorySizeNorm :
      norm symbolicConfig.evm.msize =
        norm
          (ConcreteYul.writeImmutableMemory
            { concreteConfig.state with
              immutables :=
                ConcreteYul.writeWordMap concreteConfig.state.immutables
                  key (norm value) }
            (norm offset) positions (norm value)).memorySize := by
    simpa [ConcreteYul.writeWordMap, norm_norm] using hMemorySize
  exact
    ⟨ embedWordValue 0
    , { symbolicConfig with
        evm :=
          { symbolicConfig.evm with
            immutables :=
              FullYul.writeValueMap symbolicConfig.evm.immutables
                (embedWordValue key) (embedWordValue value) } }
    , by
        simp [SymYul.guidedEvalExpr, SymYul.guidedEvalExprs,
          FullYul.evalEvmBuiltin_setimmutable_values, FullYul.returnUnit,
          FullYul.returnWord, embedConcreteExpr, embedConcreteExprs,
          embedWordValue, norm_zero]
    , valueRel_embedWordValue model 0
    , by
        simpa [ConcreteYul.writeWordMap, embedWordValue, norm_norm] using
          runtimeConfigExactRel_positionedImmutable_write hExact
            (norm offset) positions key (norm value) hMemorySizeNorm ⟩

theorem concrete_stop_empty_refines_full_symbolic_halt
    (hash : ConcreteYul.HashOracle) :
    ConcreteYul.evalBuiltin hash Evm.Builtin.stopOp [] ConcreteYul.State.empty =
      some
        ( 0
        , { ConcreteYul.State.empty with
            halt? := some { kind := Evm.HaltKind.stop, returndata := [] } } ) ∧
    FullYul.evalEvmBuiltin Evm.Builtin.stopOp []
        (embedConcreteState ConcreteYul.State.empty) =
      some
        ( embedWordValue 0
        , embedConcreteState
            { ConcreteYul.State.empty with
              halt? := some { kind := Evm.HaltKind.stop, returndata := [] } } ) := by
  constructor <;> rfl

theorem concrete_mstore_empty_has_full_symbolic_memory_summary
    (hash : ConcreteYul.HashOracle) :
    ConcreteYul.evalBuiltin hash Evm.Builtin.mstore [0, 7]
        ConcreteYul.State.empty =
      some
        ( 0
        , { ConcreteYul.State.empty with
            memory := ConcreteYul.writeWord [] 0 7
            memorySize := 32 } ) ∧
    FullYul.evalEvmBuiltin Evm.Builtin.mstore
        [embedWordValue 0, embedWordValue 7]
        (embedConcreteState ConcreteYul.State.empty) =
      some
        ( embedWordValue 0
        , { FullYul.EvmState.empty with
            memoryVersion := 1
            msize := 32
            memoryWords := [(0, embedWordValue 7)] } ) := by
  constructor <;> rfl

