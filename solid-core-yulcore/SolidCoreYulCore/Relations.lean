private theorem runtimeFunctionExactRelSim_return_of_body
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    (fuel : Nat)
    {concreteConfig resultConfig : ConcreteYul.RuntimeConfig}
    {symbolicConfig : SymYul.GuidedConfig}
    {fnName : FullYul.Name} {fn : ConcreteYul.FunctionDef}
    {args values : List Word} {symbolicArgs : List FullYul.Value}
    {callEnv : ConcreteYul.Env} {symbolicCallEnv : FullYul.Env}
    {flow : ConcreteYul.CompleteFlow}
    (hFlow : runtimeFunctionReturnFlow flow)
    (hLookup : ConcreteYul.lookupFunction? concreteConfig.funcs fnName =
      some fn)
    (hInit :
      ConcreteYul.initFunctionEnv fn.params args fn.returns = some callEnv)
    (hGuidedInit :
      FullYul.initFunctionEnv fn.params symbolicArgs fn.returns =
        some symbolicCallEnv)
    (hCallConfigExact :
      RuntimeConfigExactRel model
        { concreteConfig with
          env := callEnv
          funcs :=
            ConcreteYul.collectStmtFunctionDefs fn.body
              concreteConfig.funcs }
        { symbolicConfig with
          env := symbolicCallEnv
          funcs :=
            SymYul.collectStmtFunctionDefs
              (embedConcreteNamedFunctionDef fnName fn).body
              symbolicConfig.funcs })
    (hConcreteBody :
      ConcreteYul.evalRuntimeStmtFuel hash fuel
          { concreteConfig with
            env := callEnv
            funcs :=
              ConcreteYul.collectStmtFunctionDefs fn.body
                concreteConfig.funcs }
          fn.body =
        some { flow := flow, config := resultConfig })
    (hBody :
      RuntimeStmtFuelExactRelSim model hash fuel
        (1 + fnName + sizeOf fn.params + sizeOf fn.returns + sizeOf fn.body)
        { concreteConfig with
          env := callEnv
          funcs :=
            ConcreteYul.collectStmtFunctionDefs fn.body
              concreteConfig.funcs }
        { symbolicConfig with
          env := symbolicCallEnv
          funcs :=
            SymYul.collectStmtFunctionDefs
              (embedConcreteNamedFunctionDef fnName fn).body
              symbolicConfig.funcs }
        fn.body)
    (hValues :
      ConcreteYul.valuesForNames? resultConfig.env fn.returns = some values) :
    RuntimeFunctionExactRelSim model hash fuel.succ concreteConfig
      symbolicConfig fnName args symbolicArgs := by
  intro hInputExact _hArgsRel concreteValues concreteConfig' hConcreteResult
  have hFullLookup :
      FullYul.lookupFunction? symbolicConfig.funcs fnName =
        some (embedConcreteNamedFunctionDef fnName fn) := by
    rw [hInputExact.rel.funcsRel]
    simpa [hLookup] using
      embedConcreteFunctionEnv_lookupFunction? concreteConfig.funcs fnName
  have hConcreteCall :
      ConcreteYul.evalRuntimeFunctionFuel hash fuel.succ fnName args
          concreteConfig =
        some
          ( values
          , { resultConfig with
              env := concreteConfig.env
              funcs := concreteConfig.funcs } ) := by
    exact
      runtimeFunctionReturnFlow_elim hFlow
        (fun hNormal => by
          cases hNormal
          simp [ConcreteYul.evalRuntimeFunctionFuel, hLookup, hInit,
            hConcreteBody, hValues])
        (fun hLeft => by
          cases hLeft
          simp [ConcreteYul.evalRuntimeFunctionFuel, hLookup, hInit,
            hConcreteBody, hValues])
  rw [hConcreteCall] at hConcreteResult
  simp at hConcreteResult
  rcases hConcreteResult with ⟨hConcreteValues, hConcreteConfig⟩
  subst concreteValues
  subst concreteConfig'
  rcases hBody hCallConfigExact
      { flow := flow, config := resultConfig } hConcreteBody with
    ⟨symbolicBodyResult, hGuidedBody, hBodyExact⟩
  have hGuidedBody' :
      SymYul.guidedEvalStmtFuel model fuel
          { symbolicConfig with
            env := symbolicCallEnv
            funcs :=
              SymYul.collectStmtFunctionDefs
                (embedConcreteStmtFuel
                  (1 + fnName + sizeOf fn.params + sizeOf fn.returns +
                    sizeOf fn.body)
                  fn.body)
                symbolicConfig.funcs }
          (embedConcreteStmtFuel
            (1 + fnName + sizeOf fn.params + sizeOf fn.returns +
              sizeOf fn.body)
            fn.body) =
        some symbolicBodyResult := by
    simpa [embedConcreteNamedFunctionDef] using hGuidedBody
  rcases
      runtimeResultExactRel_guidedReturnValues_of_returnFlow hFlow
        hBodyExact hValues with
    ⟨symbolicValues, symbolicResultConfig, hGuidedReturns, hValuesRel,
      hResultConfigExact⟩
  exact
    ⟨ symbolicValues
    , { symbolicResultConfig with
        env := symbolicConfig.env
        funcs := symbolicConfig.funcs }
    , by
        simp [SymYul.guidedEvalFunctionFuel, hFullLookup,
          embedConcreteNamedFunctionDef, hGuidedInit, hGuidedBody',
          hGuidedReturns]
    , hValuesRel
    , runtimeConfigExactRel_restoreCallerFrame hInputExact
        hResultConfigExact ⟩

theorem runtimeFunctionExactRelSim_of_body
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    (fuel : Nat)
    {concreteConfig : ConcreteYul.RuntimeConfig}
    {symbolicConfig : SymYul.GuidedConfig}
    {fnName : FullYul.Name} {fn : ConcreteYul.FunctionDef}
