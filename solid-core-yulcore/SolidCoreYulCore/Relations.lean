inductive RuntimeCurrentSolidCoreBuiltinOK :
    Evm.Builtin -> List ConcreteYul.Expr -> Prop where
  | add {lhs rhs : ConcreteYul.Expr} :
      RuntimeCurrentSolidCoreBuiltinOK Evm.Builtin.add [lhs, rhs]
  | addmodOp {lhs rhs modulus : ConcreteYul.Expr} :
      RuntimeCurrentSolidCoreBuiltinOK Evm.Builtin.addmodOp
        [lhs, rhs, modulus]
  | andOp {lhs rhs : ConcreteYul.Expr} :
      RuntimeCurrentSolidCoreBuiltinOK Evm.Builtin.andOp [lhs, rhs]
  | byteOp {ix value : ConcreteYul.Expr} :
      RuntimeCurrentSolidCoreBuiltinOK Evm.Builtin.byteOp [ix, value]
  | clzOp {value : ConcreteYul.Expr} :
