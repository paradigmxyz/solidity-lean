theorem runtimeStmtFuelRelSim_block_of_block_restore
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    (fuel embedFuel : Nat)
    {concreteConfig : ConcreteYul.RuntimeConfig}
    {symbolicConfig : SymYul.GuidedConfig}
    {stmts : List ConcreteYul.Stmt}
    {result restored : ConcreteYul.RuntimeResult}
    (hCollectedRel :
      SymYul.collectBlockFunctionDefs
          (embedConcreteStmtsFuel embedFuel stmts) symbolicConfig.funcs =
        embedConcreteFunctionEnv
          (ConcreteYul.collectBlockFunctionDefs stmts
            concreteConfig.funcs))
    (hBlock :
      RuntimeBlockFuelRelSim model hash fuel embedFuel
        { concreteConfig with
          funcs :=
            ConcreteYul.collectBlockFunctionDefs stmts
              concreteConfig.funcs }
        { symbolicConfig with
          funcs :=
            SymYul.collectBlockFunctionDefs
              (embedConcreteStmtsFuel embedFuel stmts)
              symbolicConfig.funcs }
        stmts)
    (hConcreteBlock :
      ConcreteYul.evalRuntimeBlockFuel hash fuel
          { concreteConfig with
            funcs :=
              ConcreteYul.collectBlockFunctionDefs stmts
                concreteConfig.funcs }
          stmts =
        some result)
    (hConcreteRestore :
      ConcreteYul.withRestoredRuntimeConfig concreteConfig result =
        some restored)
    (hRestore :
      ∀ symbolicResult,
        RuntimeResultRel model result symbolicResult ->
          ∃ symbolicRestored,
            SymYul.withRestoredGuidedConfig symbolicConfig symbolicResult =
              some symbolicRestored ∧
            RuntimeResultRel model restored symbolicRestored) :
    RuntimeStmtFuelRelSim model hash fuel.succ embedFuel.succ concreteConfig
      symbolicConfig (ConcreteYul.Stmt.block stmts) := by
  intro hInputRel concreteResult hConcreteResult
  have hConcreteRestored :
      ConcreteYul.withRestoredRuntimeConfig concreteConfig result =
        some concreteResult := by
    simpa [ConcreteYul.evalRuntimeStmtFuel, hConcreteBlock] using
      hConcreteResult
  rw [hConcreteRestore] at hConcreteRestored
  cases hConcreteRestored
  have hBlockConfigRel :
      RuntimeConfigRel model
        { concreteConfig with
          funcs :=
            ConcreteYul.collectBlockFunctionDefs stmts
              concreteConfig.funcs }
        { symbolicConfig with
          funcs :=
            SymYul.collectBlockFunctionDefs
              (embedConcreteStmtsFuel embedFuel stmts)
              symbolicConfig.funcs } := by
    constructor
    · exact hInputRel.envRel
    · exact hInputRel.evmRel
    · exact hCollectedRel
    · exact hInputRel.objectRel
  rcases hBlock hBlockConfigRel result hConcreteBlock with
    ⟨symbolicResult, hGuidedBlock, hResultRel⟩
  rcases hRestore symbolicResult hResultRel with
    ⟨symbolicRestored, hGuidedRestore, hRestoredRel⟩
  exact
    ⟨ symbolicRestored
    , by
        cases fuel with
        | zero =>
            simp [ConcreteYul.evalRuntimeBlockFuel] at hConcreteBlock
        | succ fuel =>
            simp [SymYul.guidedEvalStmtFuel, embedConcreteStmtFuel,
              hGuidedBlock, hGuidedRestore]
    , hRestoredRel ⟩

