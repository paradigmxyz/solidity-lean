  seq := fun {first} {second} {firstEmbedFuel} {secondEmbedFuel}
      hFirst hSecond =>
    ⟨ RuntimeFunctionBodyCoveredSpec.seq hFirst.1 hSecond.1
    , fun {fuel} {embedFuel} {concreteConfig} {symbolicConfig}
        hFunctionFuel hEmbedFuel => by
        cases fuel with
        | zero =>
            exact
              runtimeStmtFuelValueExactRelSim_of_concrete_none
                (by simp [ConcreteYul.evalRuntimeStmtFuel])
