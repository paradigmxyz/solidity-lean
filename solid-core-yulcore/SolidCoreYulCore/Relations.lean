    Evm.Builtin -> List ConcreteYul.Expr -> List RuntimeArgKind -> Prop where
  | setimmutableOp {offset key value : ConcreteYul.Expr} :
      RuntimeCompilerArtifactBuiltinValueArgKinds
        Evm.Builtin.setimmutableOp [offset, key, value]
        [RuntimeArgKind.word, RuntimeArgKind.word, RuntimeArgKind.value]
  | loadimmutableOp {key : ConcreteYul.Expr} :
      RuntimeCompilerArtifactBuiltinValueArgKinds
        Evm.Builtin.loadimmutableOp [key] [RuntimeArgKind.word]
  | linkersymbolOp {key : ConcreteYul.Expr} :
