theorem runtimeLoopRestoredResult_of_runtimeConfig
    {ConfigRel : ConcreteYul.RuntimeConfig -> SymYul.GuidedConfig -> Prop}
    {ResultRel : ConcreteYul.RuntimeResult -> SymYul.GuidedResult -> Prop}
    {concrete : ConcreteYul.RuntimeConfig}
    {symbolic : SymYul.GuidedConfig}
    {flow : ConcreteYul.CompleteFlow}
    (hFlow : runtimeLoopTerminalFlow flow)
    (hConfig : ConfigRel concrete symbolic)
    (hResult :
      ∀ flow,
        ConfigRel concrete symbolic ->
        ResultRel
          ({ flow := flow, config := concrete } : ConcreteYul.RuntimeResult)
          ({ flow := embedCompleteFlow flow, config := symbolic } :
            SymYul.GuidedResult)) :
    ResultRel
      (runtimeLoopRestoredResult flow concrete)
      (runtimeLoopRestoredGuidedResult flow symbolic) := by
  exact
    runtimeLoopTerminalFlow_elim hFlow
      (fun hBroke => by
        cases hBroke
        simpa [runtimeLoopRestoredResult,
          runtimeLoopRestoredGuidedResult,
          ConcreteYul.runtimeNormalResult,
          SymYul.guidedNormalResult] using
            hResult ConcreteYul.CompleteFlow.normal hConfig)
      (fun hLeft => by
        cases hLeft
        simpa [runtimeLoopRestoredResult,
          runtimeLoopRestoredGuidedResult] using
            hResult ConcreteYul.CompleteFlow.left hConfig)
      (fun hHalted => by
        cases hHalted
        simpa [runtimeLoopRestoredResult,
          runtimeLoopRestoredGuidedResult] using
            hResult ConcreteYul.CompleteFlow.halted hConfig)

