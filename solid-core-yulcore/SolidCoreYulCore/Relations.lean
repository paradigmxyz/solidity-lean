            funcs :=
              SymYul.collectStmtFunctionDefs
                (embedConcreteNamedFunctionDef fnName fn).body
                symbolicConfig.funcs }
          fn.body) :
    RuntimeFunctionExactRelSim model hash fuel.succ concreteConfig
      symbolicConfig fnName args symbolicArgs := by
  intro hInputExact hArgsRel concreteValues concreteConfig' hConcreteResult
  cases hInit :
      ConcreteYul.initFunctionEnv fn.params args fn.returns with
  | none =>
      simp [ConcreteYul.evalRuntimeFunctionFuel, hLookup, hInit]
        at hConcreteResult
  | some callEnv =>
      rcases envExactRel_initFunctionEnv_of_concrete hInit hArgsRel with
        ⟨symbolicCallEnv, hGuidedInit, hCallEnvExact⟩
      let concreteCallConfig : ConcreteYul.RuntimeConfig :=
        { concreteConfig with
          env := callEnv
          funcs :=
            ConcreteYul.collectStmtFunctionDefs fn.body
              concreteConfig.funcs }
      let symbolicCallConfig : SymYul.GuidedConfig :=
        { symbolicConfig with
          env := symbolicCallEnv
          funcs :=
            SymYul.collectStmtFunctionDefs
              (embedConcreteNamedFunctionDef fnName fn).body
              symbolicConfig.funcs }
      have hCallConfigExact :
          RuntimeConfigExactRel model concreteCallConfig symbolicCallConfig := by
        constructor
        · constructor
          · exact envExactRel_to_envRel hCallEnvExact
          · exact hInputExact.rel.evmRel
          · exact hCollectedRel
          · exact hInputExact.rel.objectRel
        · exact hCallEnvExact
      cases hConcreteBody :
          ConcreteYul.evalRuntimeStmtFuel hash fuel concreteCallConfig
            fn.body with
      | none =>
          simp [ConcreteYul.evalRuntimeFunctionFuel, hLookup, hInit,
            concreteCallConfig, hConcreteBody] at hConcreteResult
      | some bodyResult =>
          rcases bodyResult with ⟨flow, resultConfig⟩
          cases flow with
          | normal =>
              cases hValues :
                  ConcreteYul.valuesForNames? resultConfig.env
                    fn.returns with
              | none =>
                  simp [ConcreteYul.evalRuntimeFunctionFuel, hLookup,
                    hInit, concreteCallConfig, hConcreteBody, hValues]
                    at hConcreteResult
              | some values =>
                  exact
                    (runtimeFunctionExactRelSim_return_of_body
                      model hash fuel (Or.inl rfl) hLookup hInit hGuidedInit
                      (by
                        simpa [concreteCallConfig, symbolicCallConfig] using
                          hCallConfigExact)
                      (by
                        simpa [concreteCallConfig] using hConcreteBody)
                      (by
                        simpa [concreteCallConfig, symbolicCallConfig] using
                          hBody
                            (by
                              simpa [concreteCallConfig, symbolicCallConfig]
                                using hCallConfigExact))
                      hValues)
                      hInputExact hArgsRel concreteValues concreteConfig'
                      hConcreteResult
          | broke =>
              simp [ConcreteYul.evalRuntimeFunctionFuel, hLookup, hInit,
                concreteCallConfig, hConcreteBody] at hConcreteResult
          | continued =>
              simp [ConcreteYul.evalRuntimeFunctionFuel, hLookup, hInit,
                concreteCallConfig, hConcreteBody] at hConcreteResult
          | left =>
              cases hValues :
                  ConcreteYul.valuesForNames? resultConfig.env
                    fn.returns with
              | none =>
                  simp [ConcreteYul.evalRuntimeFunctionFuel, hLookup,
                    hInit, concreteCallConfig, hConcreteBody, hValues]
                    at hConcreteResult
              | some values =>
                  exact
                    (runtimeFunctionExactRelSim_return_of_body
                      model hash fuel (Or.inr rfl) hLookup hInit hGuidedInit
                      (by
                        simpa [concreteCallConfig, symbolicCallConfig] using
                          hCallConfigExact)
                      (by
                        simpa [concreteCallConfig] using hConcreteBody)
                      (by
                        simpa [concreteCallConfig, symbolicCallConfig] using
                          hBody
                            (by
                              simpa [concreteCallConfig, symbolicCallConfig]
                                using hCallConfigExact))
                      hValues)
                      hInputExact hArgsRel concreteValues concreteConfig'
                      hConcreteResult
          | halted =>
              simp [ConcreteYul.evalRuntimeFunctionFuel, hLookup, hInit,
                concreteCallConfig, hConcreteBody] at hConcreteResult

