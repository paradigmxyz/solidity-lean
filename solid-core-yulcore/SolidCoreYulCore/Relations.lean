          (ConcreteYul.copyBytes concreteConfig.state.memory
            (norm dest) (concreteConfig.state.extcode (norm address))
            (norm offset) (norm size))
          (norm dest) (norm size)
          (FullYul.SymbolicBytes.extcodeSlice
            (norm address) (norm offset) (norm size)) ⟩

