  constructor
  · simpa [FullYul.returnUnit, FullYul.returnWord, embedWordValue,
      norm_zero] using
          FullYul.evalEvmBuiltin_sstore_values symbolic
          (embedWordValue key) symbolicValue
  · exact evmStateReadValueRel_storage_write hRel key value hValue

theorem runtimeExprReadValueExactRelSim_sload_word
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    {concreteConfig : ConcreteYul.RuntimeConfig}
    {symbolicConfig : SymYul.GuidedConfig} (key : Word)
    (hModelStorageZero :
