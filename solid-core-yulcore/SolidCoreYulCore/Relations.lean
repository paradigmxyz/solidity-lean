private theorem runtimeForFuelSim_false_of_expr_restore
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    (fuel embedFuel : Nat)
    {ConfigRel :
      ConcreteYul.RuntimeConfig -> SymYul.GuidedConfig -> Prop}
    {ResultRel :
      ConcreteYul.RuntimeResult -> SymYul.GuidedResult -> Prop}
    {concreteOuter concreteLoopConfig concreteCondConfig restored :
      ConcreteYul.RuntimeConfig}
    {symbolicOuter symbolicLoopConfig : SymYul.GuidedConfig}
    {cond : ConcreteYul.Expr} {post body : ConcreteYul.Stmt}
    {value : Word}
    (hNormalRel :
      ∀ {concreteConfig symbolicConfig},
        ConfigRel concreteConfig symbolicConfig ->
        ResultRel (ConcreteYul.runtimeNormalResult concreteConfig)
          (SymYul.guidedNormalResult symbolicConfig))
    (hCond :
      ConfigRel concreteLoopConfig symbolicLoopConfig ->
      ∀ concreteValue concreteConfig',
        ConcreteYul.evalRuntimeExpr hash cond concreteLoopConfig =
          some (concreteValue, concreteConfig') ->
        ∃ symbolicValue symbolicConfig',
          SymYul.guidedEvalExpr symbolicLoopConfig (embedConcreteExpr cond) =
            some (symbolicValue, symbolicConfig') ∧
          ValueRel model concreteValue symbolicValue ∧
          ConfigRel concreteConfig' symbolicConfig')
    (hConcreteCond :
      ConcreteYul.evalRuntimeExpr hash cond concreteLoopConfig =
        some (value, concreteCondConfig))
    (hZero : norm value = 0)
    (hConcreteRestore :
      ConcreteYul.restoreRuntimeBlockConfig concreteOuter concreteCondConfig =
        some restored)
    (hRestore :
      ConfigRel concreteOuter symbolicOuter ->
      ∀ {symbolicCondConfig},
        ConfigRel concreteCondConfig symbolicCondConfig ->
          ∃ symbolicRestored,
            SymYul.restoreGuidedBlockConfig symbolicOuter symbolicCondConfig =
              some symbolicRestored ∧
            ConfigRel restored symbolicRestored) :
    ConfigRel concreteOuter symbolicOuter ->
      ConfigRel concreteLoopConfig symbolicLoopConfig ->
      ∀ concreteResult,
        ConcreteYul.evalRuntimeForFuel hash fuel.succ concreteOuter
            concreteLoopConfig cond post body =
          some concreteResult ->
        ∃ symbolicResult,
          SymYul.guidedEvalForFuel model fuel.succ symbolicOuter
              symbolicLoopConfig (embedConcreteExpr cond)
              (embedConcreteStmtFuel embedFuel post)
              (embedConcreteStmtFuel embedFuel body) =
            some symbolicResult ∧
          ResultRel concreteResult symbolicResult := by
  intro hOuterRel hLoopRel concreteResult hConcreteResult
  simp [ConcreteYul.evalRuntimeForFuel, hConcreteCond, hZero,
    hConcreteRestore, ConcreteYul.runtimeNormalResult] at hConcreteResult
  cases hConcreteResult
  rcases hCond hLoopRel value concreteCondConfig hConcreteCond with
    ⟨symbolicValue, symbolicCondConfig, hGuidedCond, hValueRel,
      hCondConfigRel⟩
  rcases hRestore hOuterRel hCondConfigRel with
    ⟨symbolicRestored, hGuidedRestore, hRestoredRel⟩
  have hBool := guidedBool_false_of_valueRel_zero hValueRel hZero
  exact
    ⟨ SymYul.guidedNormalResult symbolicRestored
    , by
        simp [SymYul.guidedEvalForFuel, hGuidedCond, hBool,
          hGuidedRestore, SymYul.guidedNormalResult]
    , hNormalRel hRestoredRel ⟩

private theorem runtimeForFuelSim_body_terminal_of_expr_body_restore
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    (fuel embedFuel : Nat)
    {ConfigRel :
      ConcreteYul.RuntimeConfig -> SymYul.GuidedConfig -> Prop}
    {ResultRel :
      ConcreteYul.RuntimeResult -> SymYul.GuidedResult -> Prop}
    {concreteOuter concreteLoopConfig concreteCondConfig bodyConfig
      restored : ConcreteYul.RuntimeConfig}
    {symbolicOuter symbolicLoopConfig : SymYul.GuidedConfig}
    {cond : ConcreteYul.Expr} {post body : ConcreteYul.Stmt}
    {value : Word} {bodyFlow : ConcreteYul.CompleteFlow}
    (hCond :
      ConfigRel concreteLoopConfig symbolicLoopConfig ->
      ∀ concreteValue concreteConfig',
        ConcreteYul.evalRuntimeExpr hash cond concreteLoopConfig =
          some (concreteValue, concreteConfig') ->
        ∃ symbolicValue symbolicConfig',
          SymYul.guidedEvalExpr symbolicLoopConfig (embedConcreteExpr cond) =
            some (symbolicValue, symbolicConfig') ∧
          ValueRel model concreteValue symbolicValue ∧
          ConfigRel concreteConfig' symbolicConfig')
    (hConcreteCond :
      ConcreteYul.evalRuntimeExpr hash cond concreteLoopConfig =
        some (value, concreteCondConfig))
    (hNonzero : norm value ≠ 0)
    (hBody :
      ∀ symbolicValue symbolicCondConfig,
        SymYul.guidedEvalExpr symbolicLoopConfig (embedConcreteExpr cond) =
          some (symbolicValue, symbolicCondConfig) ->
        ValueRel model value symbolicValue ->
        ConfigRel concreteCondConfig symbolicCondConfig ->
        ∀ concreteBodyResult,
          ConcreteYul.evalRuntimeStmtFuel hash fuel concreteCondConfig body =
            some concreteBodyResult ->
          ∃ symbolicBodyConfig,
            SymYul.guidedEvalStmtFuel model fuel symbolicCondConfig
                (embedConcreteStmtFuel embedFuel body) =
              some
                { flow := embedCompleteFlow concreteBodyResult.flow
                  config := symbolicBodyConfig } ∧
            ConfigRel concreteBodyResult.config symbolicBodyConfig)
    (hConcreteBody :
      ConcreteYul.evalRuntimeStmtFuel hash fuel concreteCondConfig body =
        some { flow := bodyFlow, config := bodyConfig })
    (hBodyFlow : runtimeLoopTerminalFlow bodyFlow)
    (hConcreteRestore :
      ConcreteYul.restoreRuntimeBlockConfig concreteOuter bodyConfig =
        some restored)
    (hRestore :
      ConfigRel concreteOuter symbolicOuter ->
      ∀ {symbolicBodyConfig},
        ConfigRel bodyConfig symbolicBodyConfig ->
          ∃ symbolicRestored,
            SymYul.restoreGuidedBlockConfig symbolicOuter symbolicBodyConfig =
              some symbolicRestored ∧
            ConfigRel restored symbolicRestored)
    (hRestoredResultRel :
      ∀ {symbolicRestored},
        ConfigRel restored symbolicRestored ->
        ResultRel (runtimeLoopRestoredResult bodyFlow restored)
          (runtimeLoopRestoredGuidedResult bodyFlow symbolicRestored)) :
    ConfigRel concreteOuter symbolicOuter ->
      ConfigRel concreteLoopConfig symbolicLoopConfig ->
      ∀ concreteResult,
        ConcreteYul.evalRuntimeForFuel hash fuel.succ concreteOuter
            concreteLoopConfig cond post body =
          some concreteResult ->
        ∃ symbolicResult,
          SymYul.guidedEvalForFuel model fuel.succ symbolicOuter
              symbolicLoopConfig (embedConcreteExpr cond)
              (embedConcreteStmtFuel embedFuel post)
              (embedConcreteStmtFuel embedFuel body) =
            some symbolicResult ∧
          ResultRel concreteResult symbolicResult := by
  intro hOuterRel hLoopRel concreteResult hConcreteResult
  rcases hCond hLoopRel value concreteCondConfig hConcreteCond with
    ⟨symbolicValue, symbolicCondConfig, hGuidedCond, hValueRel,
      hCondConfigRel⟩
  rcases
      hBody symbolicValue symbolicCondConfig hGuidedCond hValueRel
        hCondConfigRel
        { flow := bodyFlow, config := bodyConfig } hConcreteBody with
    ⟨symbolicBodyConfig, hGuidedBody, hBodyConfigRel⟩
  rcases hRestore hOuterRel hBodyConfigRel with
    ⟨symbolicRestored, hGuidedRestore, hRestoredRel⟩
  have hBool := guidedBool_true_of_valueRel_nonzero hValueRel hNonzero
  exact
    runtimeLoopTerminalFlow_elim hBodyFlow
      (fun hBroke => by
        cases hBroke
        simp [ConcreteYul.evalRuntimeForFuel, hConcreteCond, hNonzero,
          hConcreteBody, hConcreteRestore, ConcreteYul.runtimeNormalResult]
          at hConcreteResult
        cases hConcreteResult
        exact
          ⟨ SymYul.guidedNormalResult symbolicRestored
          , by
              simp [SymYul.guidedEvalForFuel, hGuidedCond, hBool,
                hGuidedBody, hGuidedRestore, embedCompleteFlow,
                SymYul.guidedNormalResult]
          , by
              simpa [runtimeLoopRestoredResult,
                runtimeLoopRestoredGuidedResult,
                ConcreteYul.runtimeNormalResult,
                SymYul.guidedNormalResult] using
                  hRestoredResultRel hRestoredRel ⟩)
      (fun hLeft => by
        cases hLeft
        simp [ConcreteYul.evalRuntimeForFuel, hConcreteCond, hNonzero,
          hConcreteBody, hConcreteRestore] at hConcreteResult
        cases hConcreteResult
        exact
          ⟨ { flow := FullYul.Flow.left, config := symbolicRestored }
          , by
              simp [SymYul.guidedEvalForFuel, hGuidedCond, hBool,
                hGuidedBody, hGuidedRestore, embedCompleteFlow]
          , by
              simpa [runtimeLoopRestoredResult,
                runtimeLoopRestoredGuidedResult] using
                  hRestoredResultRel hRestoredRel ⟩)
      (fun hHalted => by
        cases hHalted
        simp [ConcreteYul.evalRuntimeForFuel, hConcreteCond, hNonzero,
          hConcreteBody, hConcreteRestore] at hConcreteResult
        cases hConcreteResult
        exact
          ⟨ { flow := FullYul.Flow.halted, config := symbolicRestored }
          , by
              simp [SymYul.guidedEvalForFuel, hGuidedCond, hBool,
                hGuidedBody, hGuidedRestore, embedCompleteFlow]
          , by
              simpa [runtimeLoopRestoredResult,
                runtimeLoopRestoredGuidedResult] using
                  hRestoredResultRel hRestoredRel ⟩)

