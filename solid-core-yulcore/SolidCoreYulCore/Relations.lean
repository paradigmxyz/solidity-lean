mutual
  inductive RuntimeExprCovered
      (DataOffsetOK : FullYul.DataLabel -> Prop)
      (BuiltinExprOK BuiltinValuesOK :
        Evm.Builtin -> List ConcreteYul.Expr -> Prop) :
      ConcreteYul.Expr -> Prop where
    | word {value : Word} :
        RuntimeExprCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK
          (ConcreteYul.Expr.word value)
    | var {name : FullYul.Name} :
        RuntimeExprCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK
          (ConcreteYul.Expr.var name)
    | dataSize {label : FullYul.DataLabel} :
        RuntimeExprCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK
          (ConcreteYul.Expr.dataSize label)
    | dataOffset {label : FullYul.DataLabel} :
        DataOffsetOK label ->
        RuntimeExprCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK
          (ConcreteYul.Expr.dataOffset label)
    | builtin {builtin : Evm.Builtin} {args : List ConcreteYul.Expr} :
        RuntimeExprsCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK args ->
        BuiltinExprOK builtin args ->
        RuntimeExprCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK
          (ConcreteYul.Expr.builtin builtin args)

  inductive RuntimeExprsCovered
      (DataOffsetOK : FullYul.DataLabel -> Prop)
      (BuiltinExprOK BuiltinValuesOK :
        Evm.Builtin -> List ConcreteYul.Expr -> Prop) :
      List ConcreteYul.Expr -> Prop where
    | nil :
        RuntimeExprsCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK []
    | cons {expr : ConcreteYul.Expr} {rest : List ConcreteYul.Expr} :
        RuntimeExprCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK expr ->
        RuntimeExprsCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK rest ->
        RuntimeExprsCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK
          (expr :: rest)
end

structure RuntimeExprCoveredAlg
    {C : Type u} {S : Type v}
    (DataOffsetOK : FullYul.DataLabel -> Prop)
    (BuiltinExprOK BuiltinValuesOK :
      Evm.Builtin -> List ConcreteYul.Expr -> Prop)
    (ExprRel : C -> S -> ConcreteYul.Expr -> Prop)
    (ExprsRel : C -> S -> List ConcreteYul.Expr -> Prop) : Prop where
  word :
    ∀ {concreteConfig : C} {symbolicConfig : S} {value : Word},
      ExprRel concreteConfig symbolicConfig (ConcreteYul.Expr.word value)
  var :
    ∀ {concreteConfig : C} {symbolicConfig : S}
      {name : FullYul.Name},
      ExprRel concreteConfig symbolicConfig (ConcreteYul.Expr.var name)
  dataSize :
    ∀ {concreteConfig : C} {symbolicConfig : S}
      {label : FullYul.DataLabel},
      ExprRel concreteConfig symbolicConfig
        (ConcreteYul.Expr.dataSize label)
  dataOffset :
    ∀ {concreteConfig : C} {symbolicConfig : S}
      {label : FullYul.DataLabel},
      DataOffsetOK label ->
      ExprRel concreteConfig symbolicConfig
        (ConcreteYul.Expr.dataOffset label)
  builtin :
    ∀ {concreteConfig : C} {symbolicConfig : S}
      {builtin : Evm.Builtin} {args : List ConcreteYul.Expr},
      BuiltinExprOK builtin args ->
      ExprsRel concreteConfig symbolicConfig args ->
      ExprRel concreteConfig symbolicConfig
        (ConcreteYul.Expr.builtin builtin args)
  nil :
    ∀ {concreteConfig : C} {symbolicConfig : S},
      ExprsRel concreteConfig symbolicConfig []
  cons :
    ∀ {concreteConfig : C} {symbolicConfig : S}
      {expr : ConcreteYul.Expr} {rest : List ConcreteYul.Expr},
      (∀ {concreteConfig' : C} {symbolicConfig' : S},
        ExprRel concreteConfig' symbolicConfig' expr) ->
      (∀ {concreteConfig' : C} {symbolicConfig' : S},
        ExprsRel concreteConfig' symbolicConfig' rest) ->
      ExprsRel concreteConfig symbolicConfig (expr :: rest)

def RuntimeExprCoveredAlg.ofPrimitive
    {C : Type u} {S : Type v}
    {DataOffsetOK : FullYul.DataLabel -> Prop}
    {BuiltinExprOK BuiltinValuesOK :
      Evm.Builtin -> List ConcreteYul.Expr -> Prop}
    {ExprRel : C -> S -> ConcreteYul.Expr -> Prop}
    {ExprsRel : C -> S -> List ConcreteYul.Expr -> Prop}
    {ValuesRel : C -> S -> List ConcreteYul.Expr -> Prop}
    (primitive :
      RuntimePrimitiveDispatcherOf ExprRel ExprsRel ValuesRel
        DataOffsetOK BuiltinExprOK BuiltinValuesOK)
    (wordRel :
      ∀ {concreteConfig : C} {symbolicConfig : S} {value : Word},
        ExprRel concreteConfig symbolicConfig (ConcreteYul.Expr.word value))
    (varRel :
      ∀ {concreteConfig : C} {symbolicConfig : S}
        {name : FullYul.Name},
        ExprRel concreteConfig symbolicConfig (ConcreteYul.Expr.var name))
    (dataSizeRel :
      ∀ {concreteConfig : C} {symbolicConfig : S}
        {label : FullYul.DataLabel},
        ExprRel concreteConfig symbolicConfig
          (ConcreteYul.Expr.dataSize label))
    (nilRel :
      ∀ {concreteConfig : C} {symbolicConfig : S},
        ExprsRel concreteConfig symbolicConfig [])
    (consRel :
      ∀ {concreteConfig : C} {symbolicConfig : S}
        {expr : ConcreteYul.Expr} {rest : List ConcreteYul.Expr},
        (∀ {concreteConfig' : C} {symbolicConfig' : S},
          ExprRel concreteConfig' symbolicConfig' expr) ->
        (∀ {concreteConfig' : C} {symbolicConfig' : S},
          ExprsRel concreteConfig' symbolicConfig' rest) ->
        ExprsRel concreteConfig symbolicConfig (expr :: rest)) :
    RuntimeExprCoveredAlg DataOffsetOK BuiltinExprOK BuiltinValuesOK
      ExprRel ExprsRel where
  word := wordRel
  var := varRel
  dataSize := dataSizeRel
  dataOffset hOK := primitive.dataOffset hOK
  builtin hOK hArgs := primitive.builtinExpr hOK hArgs
  nil := nilRel
  cons := consRel

mutual
  theorem RuntimeExprCovered.foldRel
      {C : Type u} {S : Type v}
      {DataOffsetOK : FullYul.DataLabel -> Prop}
      {BuiltinExprOK BuiltinValuesOK :
        Evm.Builtin -> List ConcreteYul.Expr -> Prop}
      {ExprRel : C -> S -> ConcreteYul.Expr -> Prop}
      {ExprsRel : C -> S -> List ConcreteYul.Expr -> Prop}
      (alg :
        RuntimeExprCoveredAlg DataOffsetOK BuiltinExprOK BuiltinValuesOK
          ExprRel ExprsRel) :
      ∀ {expr : ConcreteYul.Expr},
        RuntimeExprCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK
          expr ->
        ∀ {concreteConfig : C} {symbolicConfig : S},
          ExprRel concreteConfig symbolicConfig expr
    | _, RuntimeExprCovered.word => alg.word
    | _, RuntimeExprCovered.var => alg.var
    | _, RuntimeExprCovered.dataSize => alg.dataSize
    | _, RuntimeExprCovered.dataOffset hOK => alg.dataOffset hOK
    | _, RuntimeExprCovered.builtin hArgs hOK =>
        alg.builtin hOK (RuntimeExprsCovered.foldRel alg hArgs)

  theorem RuntimeExprsCovered.foldRel
      {C : Type u} {S : Type v}
      {DataOffsetOK : FullYul.DataLabel -> Prop}
      {BuiltinExprOK BuiltinValuesOK :
        Evm.Builtin -> List ConcreteYul.Expr -> Prop}
      {ExprRel : C -> S -> ConcreteYul.Expr -> Prop}
      {ExprsRel : C -> S -> List ConcreteYul.Expr -> Prop}
      (alg :
        RuntimeExprCoveredAlg DataOffsetOK BuiltinExprOK BuiltinValuesOK
          ExprRel ExprsRel) :
      ∀ {exprs : List ConcreteYul.Expr},
        RuntimeExprsCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK
          exprs ->
        ∀ {concreteConfig : C} {symbolicConfig : S},
          ExprsRel concreteConfig symbolicConfig exprs
    | _, RuntimeExprsCovered.nil => alg.nil
    | _, RuntimeExprsCovered.cons hExpr hRest =>
        alg.cons
          (RuntimeExprCovered.foldRel alg hExpr)
          (RuntimeExprsCovered.foldRel alg hRest)
end

inductive RuntimeExprsAsYulValuesCovered
    (DataOffsetOK : FullYul.DataLabel -> Prop)
    (BuiltinExprOK BuiltinValuesOK :
      Evm.Builtin -> List ConcreteYul.Expr -> Prop) :
    List ConcreteYul.Expr -> Prop where
  | nil :
      RuntimeExprsAsYulValuesCovered DataOffsetOK BuiltinExprOK
        BuiltinValuesOK []
  | consCons {expr₁ expr₂ : ConcreteYul.Expr}
      {rest : List ConcreteYul.Expr} :
      RuntimeExprCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK expr₁ ->
      RuntimeExprCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK expr₂ ->
      RuntimeExprsCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK rest ->
      RuntimeExprsAsYulValuesCovered DataOffsetOK BuiltinExprOK
        BuiltinValuesOK (expr₁ :: expr₂ :: rest)
  | singleNonBuiltin {expr : ConcreteYul.Expr} :
      (∀ builtin args, expr ≠ ConcreteYul.Expr.builtin builtin args) ->
      RuntimeExprCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK expr ->
      RuntimeExprsAsYulValuesCovered DataOffsetOK BuiltinExprOK
        BuiltinValuesOK [expr]
  | singleBuiltinOne {builtin : Evm.Builtin} {args : List ConcreteYul.Expr}
      {sig : Evm.BuiltinSignature} :
      RuntimeExprsCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK args ->
      BuiltinExprOK builtin args ->
      builtin.signature? = some sig ->
      sig.resultCount = 1 ->
      RuntimeExprsAsYulValuesCovered DataOffsetOK BuiltinExprOK
        BuiltinValuesOK [ConcreteYul.Expr.builtin builtin args]
  | singleBuiltinValues {builtin : Evm.Builtin}
      {args : List ConcreteYul.Expr} :
      RuntimeExprsCovered DataOffsetOK BuiltinExprOK BuiltinValuesOK args ->
      BuiltinValuesOK builtin args ->
      RuntimeExprsAsYulValuesCovered DataOffsetOK BuiltinExprOK
        BuiltinValuesOK [ConcreteYul.Expr.builtin builtin args]

structure RuntimeExprsAsYulValuesCoveredAlg
    {C : Type u} {S : Type v}
    (BuiltinExprOK BuiltinValuesOK :
      Evm.Builtin -> List ConcreteYul.Expr -> Prop)
    (ExprRel : C -> S -> ConcreteYul.Expr -> Prop)
    (ExprsRel : C -> S -> List ConcreteYul.Expr -> Prop)
    (ValuesRel : C -> S -> List ConcreteYul.Expr -> Prop) : Prop where
  nil :
    ∀ {concreteConfig : C} {symbolicConfig : S},
      ValuesRel concreteConfig symbolicConfig []
  consCons :
    ∀ {concreteConfig : C} {symbolicConfig : S}
      {expr₁ expr₂ : ConcreteYul.Expr} {rest : List ConcreteYul.Expr},
      (∀ {concreteConfig' : C} {symbolicConfig' : S},
        ExprRel concreteConfig' symbolicConfig' expr₁) ->
      (∀ {concreteConfig' : C} {symbolicConfig' : S},
        ExprRel concreteConfig' symbolicConfig' expr₂) ->
      (∀ {concreteConfig' : C} {symbolicConfig' : S},
        ExprsRel concreteConfig' symbolicConfig' rest) ->
      ValuesRel concreteConfig symbolicConfig (expr₁ :: expr₂ :: rest)
  singleNonBuiltin :
    ∀ {concreteConfig : C} {symbolicConfig : S}
      {expr : ConcreteYul.Expr},
      (∀ builtin args, expr ≠ ConcreteYul.Expr.builtin builtin args) ->
      (∀ {concreteConfig' : C} {symbolicConfig' : S},
        ExprRel concreteConfig' symbolicConfig' expr) ->
      ValuesRel concreteConfig symbolicConfig [expr]
  singleBuiltinOne :
    ∀ {concreteConfig : C} {symbolicConfig : S}
      {builtin : Evm.Builtin} {args : List ConcreteYul.Expr}
      {sig : Evm.BuiltinSignature},
      BuiltinExprOK builtin args ->
      builtin.signature? = some sig ->
      sig.resultCount = 1 ->
      ExprsRel concreteConfig symbolicConfig args ->
      ValuesRel concreteConfig symbolicConfig
        [ConcreteYul.Expr.builtin builtin args]
  singleBuiltinValues :
    ∀ {concreteConfig : C} {symbolicConfig : S}
      {builtin : Evm.Builtin} {args : List ConcreteYul.Expr},
      BuiltinValuesOK builtin args ->
      ExprsRel concreteConfig symbolicConfig args ->
      ValuesRel concreteConfig symbolicConfig
        [ConcreteYul.Expr.builtin builtin args]

def RuntimeExprsAsYulValuesCoveredAlg.ofPrimitive
    {C : Type u} {S : Type v}
    {DataOffsetOK : FullYul.DataLabel -> Prop}
    {BuiltinExprOK BuiltinValuesOK :
      Evm.Builtin -> List ConcreteYul.Expr -> Prop}
    {ExprRel : C -> S -> ConcreteYul.Expr -> Prop}
    {ExprsRel : C -> S -> List ConcreteYul.Expr -> Prop}
    {ValuesRel : C -> S -> List ConcreteYul.Expr -> Prop}
    (primitive :
      RuntimePrimitiveDispatcherOf ExprRel ExprsRel ValuesRel
        DataOffsetOK BuiltinExprOK BuiltinValuesOK)
    (nilRel :
      ∀ {concreteConfig : C} {symbolicConfig : S},
