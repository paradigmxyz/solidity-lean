            (runtimeExprCoveredSpec_of_checkExpr_embed hSyntax ctx
              hChecks.1)
  | [ConcreteYul.Expr.dataOffset label], _resultCount, hCheck =>
      by
        have hChecks :
            FullYul.checkExpr ctx
              (embedConcreteExpr (ConcreteYul.Expr.dataOffset label)) =
                true ∧ _resultCount = 1 := by
          simpa [FullYul.checkExprsAsYulValues, embedConcreteExprs,
            embedConcreteExpr, FullYul.checkExprs] using hCheck
        exact
          RuntimeExprsAsYulValuesCovered.singleNonBuiltin
            (concreteExpr_dataOffset_not_builtin label)
            (runtimeExprCoveredSpec_of_checkExpr_embed hSyntax ctx
              hChecks.1)
  | [ConcreteYul.Expr.builtin builtin args], resultCount, hCheck =>
      by
        cases hSig : builtin.signature? with
        | none =>
            simp [FullYul.checkExprsAsYulValues, embedConcreteExprs,
              embedConcreteExpr, hSig] at hCheck
        | some sig =>
            have hRaw :
                (sig.paramCount = args.length ∧
                  sig.resultCount = resultCount) ∧
                  FullYul.checkExprs ctx (embedConcreteExprs args) = true := by
              simpa [FullYul.checkExprsAsYulValues, embedConcreteExprs,
                embedConcreteExpr, hSig] using hCheck
            by_cases hResult : sig.resultCount = 1
            · exact
                RuntimeExprsAsYulValuesCovered.singleBuiltinOne
                  (runtimeExprsCoveredSpec_of_checkExprs_embed hSyntax ctx
                    hRaw.2)
                  (hSyntax.builtinExpr hSig hRaw.1.1)
