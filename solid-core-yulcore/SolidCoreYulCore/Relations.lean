        (1 + fnName + sizeOf fn.params + sizeOf fn.returns +
          sizeOf fn.body)
        { concreteConfig with
          env := callEnv
          funcs :=
            ConcreteYul.collectStmtFunctionDefs fn.body
              concreteConfig.funcs }
        { symbolicConfig with
          env := symbolicCallEnv
          funcs :=
            SymYul.collectStmtFunctionDefs
              (embedConcreteNamedFunctionDef fnName fn).body
              symbolicConfig.funcs }
        fn.body

