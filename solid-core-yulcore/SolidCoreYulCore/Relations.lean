inductive RuntimeArgKind where
  | word
  | value
  deriving DecidableEq, Repr

def RuntimeArgKindRel (model : SymYul.ConcreteModel) :
    RuntimeArgKind -> Word -> FullYul.Value -> Prop
  | RuntimeArgKind.word, concrete, symbolic =>
      norm concrete = concrete ∧ symbolic = embedWordValue concrete
  | RuntimeArgKind.value, concrete, symbolic =>
      ValueRel model concrete symbolic

def RuntimeArgListKindRel (model : SymYul.ConcreteModel) :
    List RuntimeArgKind -> List Word -> List FullYul.Value -> Prop
  | [], [], [] => True
  | kind :: kindRest, concrete :: concreteRest, symbolic :: symbolicRest =>
      RuntimeArgKindRel model kind concrete symbolic ∧
        RuntimeArgListKindRel model kindRest concreteRest symbolicRest
  | _, _, _ => False

noncomputable def RuntimeExprKindRelSim
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    (concreteConfig : ConcreteYul.RuntimeConfig)
    (symbolicConfig : SymYul.GuidedConfig)
    (expr : ConcreteYul.Expr) (kind : RuntimeArgKind) : Prop :=
  RuntimeConfigValueExactRel model concreteConfig symbolicConfig ->
    ∀ concreteValue concreteConfig',
      ConcreteYul.evalRuntimeExpr hash expr concreteConfig =
        some (concreteValue, concreteConfig') ->
      ∃ symbolicValue symbolicConfig',
        SymYul.guidedEvalExpr symbolicConfig
            (embedConcreteExpr expr) =
          some (symbolicValue, symbolicConfig') ∧
        RuntimeArgKindRel model kind concreteValue symbolicValue ∧
        RuntimeConfigValueExactRel model concreteConfig' symbolicConfig'

noncomputable def RuntimeExprWordValueExactRelSim
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    (concreteConfig : ConcreteYul.RuntimeConfig)
    (symbolicConfig : SymYul.GuidedConfig)
    (expr : ConcreteYul.Expr) : Prop :=
  RuntimeConfigValueExactRel model concreteConfig symbolicConfig ->
    ∀ concreteValue concreteConfig',
      ConcreteYul.evalRuntimeExpr hash expr concreteConfig =
        some (concreteValue, concreteConfig') ->
      ∃ symbolicConfig',
        norm concreteValue = concreteValue ∧
        SymYul.guidedEvalExpr symbolicConfig
            (embedConcreteExpr expr) =
          some (embedWordValue concreteValue, symbolicConfig') ∧
        RuntimeConfigValueExactRel model concreteConfig' symbolicConfig'

noncomputable def RuntimeExprsKindRelSim
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    (concreteConfig : ConcreteYul.RuntimeConfig)
    (symbolicConfig : SymYul.GuidedConfig)
    (exprs : List ConcreteYul.Expr) (kinds : List RuntimeArgKind) : Prop :=
  RuntimeConfigValueExactRel model concreteConfig symbolicConfig ->
    ∀ concreteValues concreteConfig',
      ConcreteYul.evalRuntimeExprs hash exprs concreteConfig =
        some (concreteValues, concreteConfig') ->
      ∃ symbolicValues symbolicConfig',
        SymYul.guidedEvalExprs symbolicConfig
            (embedConcreteExprs exprs) =
          some (symbolicValues, symbolicConfig') ∧
        RuntimeArgListKindRel model kinds concreteValues symbolicValues ∧
        RuntimeConfigValueExactRel model concreteConfig' symbolicConfig'

theorem RuntimeArgKindRel.toValueRel
    {model : SymYul.ConcreteModel} {kind : RuntimeArgKind}
    {concrete : Word} {symbolic : FullYul.Value}
    (hRel : RuntimeArgKindRel model kind concrete symbolic) :
    ValueRel model concrete symbolic := by
  cases kind with
  | word =>
      simp [RuntimeArgKindRel] at hRel
      rcases hRel with ⟨_hNorm, hSymbolic⟩
      rw [hSymbolic]
      exact valueRel_embedWordValue model concrete
  | value =>
      exact hRel

theorem RuntimeArgListKindRel.toWordListRel
    {model : SymYul.ConcreteModel}
    {kinds : List RuntimeArgKind}
    {concreteValues : List Word}
    {symbolicValues : List FullYul.Value}
    (hRel :
      RuntimeArgListKindRel model kinds concreteValues symbolicValues) :
    WordListRel model concreteValues symbolicValues := by
  induction kinds generalizing concreteValues symbolicValues with
  | nil =>
      cases concreteValues <;> cases symbolicValues <;>
        simp [RuntimeArgListKindRel, WordListRel] at hRel ⊢
  | cons kind kindRest ih =>
      cases concreteValues <;> cases symbolicValues <;>
        simp [RuntimeArgListKindRel, WordListRel] at hRel ⊢
      rcases hRel with ⟨hHead, hTail⟩
      exact ⟨hHead.toValueRel, ih hTail⟩

theorem RuntimeArgListKindRel.single_word
    {model : SymYul.ConcreteModel}
    {concreteValues : List Word}
    {symbolicValues : List FullYul.Value}
    (hRel :
      RuntimeArgListKindRel model [RuntimeArgKind.word]
        concreteValues symbolicValues) :
    ∃ key,
      concreteValues = [key] ∧
        symbolicValues = [embedWordValue key] ∧
        norm key = key := by
  cases concreteValues with
  | nil =>
      simp [RuntimeArgListKindRel] at hRel
  | cons key concreteRest =>
      cases concreteRest with
      | nil =>
          cases symbolicValues with
          | nil =>
              simp [RuntimeArgListKindRel] at hRel
          | cons symbolic symbolicRest =>
              cases symbolicRest with
              | nil =>
                  simp [RuntimeArgListKindRel, RuntimeArgKindRel] at hRel
                  rcases hRel with ⟨hNorm, hSymbolic⟩
                  exact ⟨key, rfl, by simp [hSymbolic], hNorm⟩
              | cons _ _ =>
                  simp [RuntimeArgListKindRel] at hRel
      | cons _ _ =>
          cases symbolicValues <;> simp [RuntimeArgListKindRel] at hRel

theorem RuntimeArgListKindRel.single_value
    {model : SymYul.ConcreteModel}
    {concreteValues : List Word}
    {symbolicValues : List FullYul.Value}
    (hRel :
      RuntimeArgListKindRel model [RuntimeArgKind.value]
        concreteValues symbolicValues) :
    ∃ value symbolicValue,
      concreteValues = [value] ∧
        symbolicValues = [symbolicValue] ∧
        ValueRel model value symbolicValue := by
  cases concreteValues with
  | nil =>
      simp [RuntimeArgListKindRel] at hRel
  | cons value concreteRest =>
      cases concreteRest with
      | nil =>
          cases symbolicValues with
          | nil =>
              simp [RuntimeArgListKindRel] at hRel
          | cons symbolicValue symbolicRest =>
              cases symbolicRest with
              | nil =>
                  simp [RuntimeArgListKindRel, RuntimeArgKindRel] at hRel
                  exact ⟨value, symbolicValue, rfl, rfl, hRel⟩
              | cons _ _ =>
                  simp [RuntimeArgListKindRel] at hRel
      | cons _ _ =>
          cases symbolicValues <;> simp [RuntimeArgListKindRel] at hRel

theorem RuntimeArgListKindRel.pair_word_value
    {model : SymYul.ConcreteModel}
    {concreteValues : List Word}
    {symbolicValues : List FullYul.Value}
    (hRel :
      RuntimeArgListKindRel model
        [RuntimeArgKind.word, RuntimeArgKind.value]
        concreteValues symbolicValues) :
    ∃ key value symbolicValue,
      concreteValues = [key, value] ∧
        symbolicValues = [embedWordValue key, symbolicValue] ∧
        norm key = key ∧
        ValueRel model value symbolicValue := by
  cases concreteValues with
  | nil =>
      simp [RuntimeArgListKindRel] at hRel
  | cons key concreteRest =>
      cases concreteRest with
      | nil =>
          cases symbolicValues <;> simp [RuntimeArgListKindRel] at hRel
      | cons value concreteRest =>
          cases concreteRest with
          | nil =>
              cases symbolicValues with
              | nil =>
                  simp [RuntimeArgListKindRel] at hRel
              | cons symbolicKey symbolicRest =>
                  cases symbolicRest with
                  | nil =>
                      simp [RuntimeArgListKindRel] at hRel
                  | cons symbolicValue symbolicRest =>
                      cases symbolicRest with
                      | nil =>
                          simp [RuntimeArgListKindRel, RuntimeArgKindRel]
                            at hRel
                          rcases hRel with ⟨hKey, hValue⟩
                          rcases hKey with ⟨hKeyNorm, hSymbolicKey⟩
                          exact
                            ⟨ key
                            , value
                            , symbolicValue
                            , rfl
                            , by simp [hSymbolicKey]
                            , hKeyNorm
                            , hValue ⟩
                      | cons _ _ =>
                          simp [RuntimeArgListKindRel] at hRel
          | cons _ _ =>
              cases symbolicValues with
              | nil =>
                  simp [RuntimeArgListKindRel] at hRel
              | cons _ symbolicRest =>
                  cases symbolicRest with
                  | nil =>
                      simp [RuntimeArgListKindRel] at hRel
                  | cons _ symbolicRest =>
                      cases symbolicRest <;>
                        simp [RuntimeArgListKindRel] at hRel

theorem RuntimeArgListKindRel.pair_word_word
    {model : SymYul.ConcreteModel}
    {concreteValues : List Word}
    {symbolicValues : List FullYul.Value}
    (hRel :
      RuntimeArgListKindRel model
        [RuntimeArgKind.word, RuntimeArgKind.word]
        concreteValues symbolicValues) :
    ∃ first second,
      concreteValues = [first, second] ∧
        symbolicValues = [embedWordValue first, embedWordValue second] ∧
        norm first = first ∧ norm second = second := by
  cases concreteValues with
  | nil =>
      simp [RuntimeArgListKindRel] at hRel
  | cons first concreteRest =>
      cases concreteRest with
      | nil =>
          cases symbolicValues <;> simp [RuntimeArgListKindRel] at hRel
      | cons second concreteRest =>
          cases concreteRest with
          | nil =>
              cases symbolicValues with
              | nil =>
                  simp [RuntimeArgListKindRel] at hRel
              | cons symbolicFirst symbolicRest =>
                  cases symbolicRest with
                  | nil =>
                      simp [RuntimeArgListKindRel] at hRel
                  | cons symbolicSecond symbolicRest =>
                      cases symbolicRest with
                      | nil =>
                          simp [RuntimeArgListKindRel, RuntimeArgKindRel]
                            at hRel
                          rcases hRel with ⟨hFirst, hSecond⟩
                          rcases hFirst with ⟨hFirstNorm, hSymbolicFirst⟩
                          rcases hSecond with
                            ⟨hSecondNorm, hSymbolicSecond⟩
                          exact
                            ⟨ first
                            , second
                            , rfl
                            , by simp [hSymbolicFirst, hSymbolicSecond]
                            , hFirstNorm
                            , hSecondNorm ⟩
                      | cons _ _ =>
                          simp [RuntimeArgListKindRel] at hRel
          | cons _ _ =>
              cases symbolicValues with
              | nil =>
                  simp [RuntimeArgListKindRel] at hRel
              | cons _ symbolicRest =>
                  cases symbolicRest with
                  | nil =>
                      simp [RuntimeArgListKindRel] at hRel
                  | cons _ symbolicRest =>
                      cases symbolicRest <;>
                        simp [RuntimeArgListKindRel] at hRel

theorem RuntimeArgListKindRel.triple_word
    {model : SymYul.ConcreteModel}
    {concreteValues : List Word}
    {symbolicValues : List FullYul.Value}
    (hRel :
      RuntimeArgListKindRel model
        [RuntimeArgKind.word, RuntimeArgKind.word, RuntimeArgKind.word]
        concreteValues symbolicValues) :
    ∃ first second third,
      concreteValues = [first, second, third] ∧
        symbolicValues =
          [embedWordValue first, embedWordValue second,
            embedWordValue third] ∧
        norm first = first ∧ norm second = second ∧ norm third = third := by
  cases concreteValues with
  | nil =>
      simp [RuntimeArgListKindRel] at hRel
  | cons first concreteRest =>
      cases concreteRest with
      | nil =>
          cases symbolicValues <;> simp [RuntimeArgListKindRel] at hRel
      | cons second concreteRest =>
          cases concreteRest with
          | nil =>
              cases symbolicValues with
              | nil =>
                  simp [RuntimeArgListKindRel] at hRel
              | cons _ symbolicRest =>
                  cases symbolicRest <;> simp [RuntimeArgListKindRel] at hRel
          | cons third concreteRest =>
              cases concreteRest with
              | nil =>
                  cases symbolicValues with
                  | nil =>
                      simp [RuntimeArgListKindRel] at hRel
                  | cons symbolicFirst symbolicRest =>
                      cases symbolicRest with
                      | nil =>
                          simp [RuntimeArgListKindRel] at hRel
                      | cons symbolicSecond symbolicRest =>
                          cases symbolicRest with
                          | nil =>
                              simp [RuntimeArgListKindRel] at hRel
                          | cons symbolicThird symbolicRest =>
                              cases symbolicRest with
                              | nil =>
                                  simp [RuntimeArgListKindRel,
                                    RuntimeArgKindRel] at hRel
                                  rcases hRel with
                                    ⟨hFirst, hSecond, hThird⟩
                                  rcases hFirst with
                                    ⟨hFirstNorm, hSymbolicFirst⟩
                                  rcases hSecond with
                                    ⟨hSecondNorm, hSymbolicSecond⟩
                                  rcases hThird with
                                    ⟨hThirdNorm, hSymbolicThird⟩
                                  exact
                                    ⟨ first
                                    , second
                                    , third
                                    , rfl
                                    , by
                                        simp [hSymbolicFirst,
                                          hSymbolicSecond, hSymbolicThird]
                                    , hFirstNorm
                                    , hSecondNorm
                                    , hThirdNorm ⟩
                              | cons _ _ =>
                                  simp [RuntimeArgListKindRel] at hRel
              | cons extra concreteRest =>
                  cases symbolicValues with
                  | nil =>
                      simp [RuntimeArgListKindRel] at hRel
                  | cons _ symbolicRest =>
                      have hTail :
                          RuntimeArgListKindRel model
                            [RuntimeArgKind.word, RuntimeArgKind.word]
                            (second :: third :: extra :: concreteRest)
                            symbolicRest := by
                        simpa [RuntimeArgListKindRel] using hRel.2
                      rcases RuntimeArgListKindRel.pair_word_word hTail with
                        ⟨_, _, hConcreteTail, _, _, _⟩
                      cases hConcreteTail

