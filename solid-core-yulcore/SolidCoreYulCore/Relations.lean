theorem runtimeConfigFunctionsCoveredSpec_evalRuntimeExprs
    {spec : RuntimeCoverageSpec}
    {hash : ConcreteYul.HashOracle}
    {exprs : List ConcreteYul.Expr}
    {config afterConfig : ConcreteYul.RuntimeConfig}
    {values : List Word}
    (hCovered : RuntimeConfigFunctionsCoveredSpec spec config)
    (hEval :
      ConcreteYul.evalRuntimeExprs hash exprs config =
        some (values, afterConfig)) :
    RuntimeConfigFunctionsCoveredSpec spec afterConfig := by
  induction exprs generalizing config values afterConfig with
  | nil =>
      simp [ConcreteYul.evalRuntimeExprs] at hEval
      rcases hEval with ⟨_hValues, hConfig⟩
      subst afterConfig
      exact hCovered
  | cons expr rest ih =>
      cases hRest :
          ConcreteYul.evalRuntimeExprs hash rest config with
      | none =>
          simp [ConcreteYul.evalRuntimeExprs, hRest] at hEval
      | some restResult =>
          cases restResult with
          | mk restValues restConfig =>
              cases hExpr :
                  ConcreteYul.evalRuntimeExpr hash expr restConfig with
              | none =>
                  simp [ConcreteYul.evalRuntimeExprs, hRest, hExpr]
                    at hEval
              | some exprResult =>
                  cases exprResult with
                  | mk value exprConfig =>
                      simp [ConcreteYul.evalRuntimeExprs, hRest, hExpr]
                        at hEval
                      rcases hEval with ⟨_hValues, hConfig⟩
                      subst afterConfig
                      exact
                        runtimeConfigFunctionsCoveredSpec_evalRuntimeExpr
                          (ih hCovered hRest) hExpr

