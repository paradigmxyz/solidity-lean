      ConcreteYul.withRestoredRuntimeConfig concreteConfig result =
        some restored) :
    RuntimeStmtFuelReadValueExactRelSim model hash fuel.succ embedFuel.succ
      concreteConfig symbolicConfig (ConcreteYul.Stmt.block stmts) := by
  intro hInputExact concreteResult hConcreteResult
  have hConcreteRestored :
      ConcreteYul.withRestoredRuntimeConfig concreteConfig result =
        some concreteResult := by
    simpa [ConcreteYul.evalRuntimeStmtFuel, hConcreteBlock] using
      hConcreteResult
  rw [hConcreteRestore] at hConcreteRestored
  cases hConcreteRestored
  have hBlockConfigExact :
      RuntimeConfigReadValueExactRel model
        { concreteConfig with
          funcs :=
            ConcreteYul.collectBlockFunctionDefs stmts
              concreteConfig.funcs }
        { symbolicConfig with
          funcs :=
            SymYul.collectBlockFunctionDefs
              (embedConcreteStmtsFuel embedFuel stmts)
              symbolicConfig.funcs } := by
    constructor
    · exact hInputExact.envRel
    · exact hInputExact.evmRel
    · exact hCollectedRel
    · exact hInputExact.objectRel
    · exact hInputExact.envExact
  rcases hBlock hBlockConfigExact result hConcreteBlock with
    ⟨symbolicResult, hGuidedBlock, hResultExact⟩
  rcases runtimeResultReadValueExactRel_withRestoredRuntimeConfig
      hInputExact hResultExact hConcreteRestore with
    ⟨symbolicRestored, hGuidedRestore, hRestoredExact⟩
  exact
    ⟨ symbolicRestored
    , by
        cases fuel with
        | zero =>
            simp [ConcreteYul.evalRuntimeBlockFuel] at hConcreteBlock
        | succ fuel =>
            simp [SymYul.guidedEvalStmtFuel, embedConcreteStmtFuel,
              hGuidedBlock, hGuidedRestore]
