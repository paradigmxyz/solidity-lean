theorem evalRuntimeExprs_eq_evalExprs
    (hash : ConcreteYul.HashOracle) (exprs : List ConcreteYul.Expr)
    (config : ConcreteYul.RuntimeConfig) :
    ConcreteYul.evalRuntimeExprs hash exprs config =
      match ConcreteYul.evalExprs hash exprs config.toConfig with
      | some (values, config') =>
          some (values, config.withConfig config')
      | none => none := by
  induction exprs generalizing config with
  | nil =>
      rfl
  | cons expr rest ih =>
      simp [ConcreteYul.evalRuntimeExprs, ConcreteYul.evalExprs, ih]
      cases hRest : ConcreteYul.evalExprs hash rest config.toConfig with
      | none =>
          simp
      | some restResult =>
          rcases restResult with ⟨restValues, restConfig⟩
          rcases restConfig with ⟨env, state, object⟩
          cases hExpr :
              ConcreteYul.evalExpr hash expr
                { env := env, state := state, object := object } with
          | none =>
              simp [ConcreteYul.evalRuntimeExpr,
                ConcreteYul.RuntimeConfig.toConfig,
                ConcreteYul.RuntimeConfig.withConfig, hExpr]
          | some exprResult =>
              rcases exprResult with ⟨value, exprConfig⟩
              cases exprConfig
              simp [ConcreteYul.evalRuntimeExpr,
                ConcreteYul.RuntimeConfig.toConfig,
                ConcreteYul.RuntimeConfig.withConfig, hExpr]

theorem evalRuntimeExpr_builtin_args_of_success
    (hash : ConcreteYul.HashOracle) (config : ConcreteYul.RuntimeConfig)
    (builtin : Evm.Builtin) (args : List ConcreteYul.Expr)
    {value : Word} {config' : ConcreteYul.RuntimeConfig}
    (hBuiltinNe : builtin ≠ Evm.Builtin.datacopyOp)
    (hEval :
      ConcreteYul.evalRuntimeExpr hash
          (ConcreteYul.Expr.builtin builtin args) config =
        some (value, config')) :
    ∃ argValues argConfig state',
      ConcreteYul.evalRuntimeExprs hash args config =
        some (argValues, argConfig) ∧
      ConcreteYul.evalBuiltin hash builtin argValues argConfig.state =
        some (value, state') ∧
      config' = { argConfig with state := state' } := by
  unfold ConcreteYul.evalRuntimeExpr at hEval
  simp [ConcreteYul.evalExpr, hBuiltinNe] at hEval
  cases hExprs : ConcreteYul.evalExprs hash args config.toConfig with
  | none =>
      simp [hExprs] at hEval
  | some argResult =>
      rcases argResult with ⟨argValues, coreArgConfig⟩
      cases hBuiltin :
          ConcreteYul.evalBuiltin hash builtin argValues
            coreArgConfig.state with
      | none =>
          simp [hExprs, hBuiltin] at hEval
      | some builtinResult =>
          rcases builtinResult with ⟨builtinValue, state'⟩
          simp [hExprs, hBuiltin, ConcreteYul.RuntimeConfig.withConfig]
            at hEval
          rcases hEval with ⟨hValue, hConfig'⟩
          subst value
          subst config'
          refine
            ⟨ argValues
            , config.withConfig coreArgConfig
            , state'
            , ?_
            , ?_
            , rfl ⟩
          · rw [evalRuntimeExprs_eq_evalExprs]
            simp [hExprs]
          · simpa [ConcreteYul.RuntimeConfig.withConfig] using hBuiltin

