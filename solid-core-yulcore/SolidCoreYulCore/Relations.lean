def RuntimePureWordCoverageSpec : RuntimeCoverageSpec where
  DataOffsetOK := fun _ => False
  BuiltinExprOK := RuntimePureWordBuiltinExprOK
  BuiltinValuesOK := fun _ _ => False
  FunctionOK := fun _ _ => False

theorem RuntimePureWordCoverageSpec.le_signatured :
    RuntimeCoverageSpecLe RuntimePureWordCoverageSpec
      RuntimeSignaturedCoverageSpec where
  dataOffset hOK := False.elim hOK
  builtinExpr hOK := by
    rcases RuntimePureWordBuiltinExprOK.signature hOK with
      ⟨sig, hSig, hParam, _hResult, _hCoverage⟩
    exact ⟨sig, hSig, hParam⟩
  builtinValues hOK := False.elim hOK
  function hOK := False.elim hOK

theorem RuntimePureWordBuiltinExprOK.to_compilerProfileCoverage
    {profile : FullYul.CompilerProfile}
    {builtin : Evm.Builtin} {args : List ConcreteYul.Expr}
    (hBuiltin : profile.builtinOK builtin)
    (hOK : RuntimePureWordBuiltinExprOK builtin args) :
    (RuntimeCompilerProfileCoverageSpec profile).BuiltinExprOK builtin args := by
  rcases RuntimePureWordBuiltinExprOK.signature hOK with
    ⟨sig, hSig, hParam, _hResult, _hCoverage⟩
  exact ⟨hBuiltin, ⟨sig, hSig, hParam⟩⟩

structure RuntimePrimitiveSyntaxCoverageSpec
    (spec : RuntimeCoverageSpec) : Prop where
  dataOffset :
    ∀ {label : FullYul.DataLabel}, spec.DataOffsetOK label
  builtinExpr :
    ∀ {builtin : Evm.Builtin} {args : List ConcreteYul.Expr}
      {sig : Evm.BuiltinSignature},
      builtin.signature? = some sig ->
      sig.paramCount = args.length ->
      spec.BuiltinExprOK builtin args
  builtinValues :
    ∀ {builtin : Evm.Builtin} {args : List ConcreteYul.Expr}
      {sig : Evm.BuiltinSignature},
      builtin.signature? = some sig ->
      sig.paramCount = args.length ->
      spec.BuiltinValuesOK builtin args

theorem RuntimePrimitiveSyntaxCoverageSpec.signatured :
    RuntimePrimitiveSyntaxCoverageSpec RuntimeSignaturedCoverageSpec where
  dataOffset := trivial
  builtinExpr hSig hParam := ⟨_, hSig, hParam⟩
  builtinValues hSig hParam := ⟨_, hSig, hParam⟩

def RuntimeStaticContextCoverageSpec
    (ctx : FullYul.StaticContext) : RuntimeCoverageSpec where
  DataOffsetOK := fun _ => True
  BuiltinExprOK := RuntimeSignaturedCoverageSpec.BuiltinExprOK
  BuiltinValuesOK := RuntimeSignaturedCoverageSpec.BuiltinValuesOK
  FunctionOK := fun fnName args =>
    ∃ sig,
      FullYul.lookupFunctionSig? ctx.funcs fnName = some sig ∧
        sig.paramCount = args.length

theorem RuntimePrimitiveSyntaxCoverageSpec.staticContext
    (ctx : FullYul.StaticContext) :
    RuntimePrimitiveSyntaxCoverageSpec
      (RuntimeStaticContextCoverageSpec ctx) where
  dataOffset := trivial
  builtinExpr hSig hParam := ⟨_, hSig, hParam⟩
  builtinValues hSig hParam := ⟨_, hSig, hParam⟩

theorem RuntimeStaticContextCoverageSpec.le_signatured
    (ctx : FullYul.StaticContext) :
    RuntimeCoverageSpecLe (RuntimeStaticContextCoverageSpec ctx)
      RuntimeSignaturedCoverageSpec where
  dataOffset _hOK := trivial
  builtinExpr hOK := hOK
  builtinValues hOK := hOK
  function _hOK := trivial

theorem RuntimeStaticContextCoverageSpec.le_of_funcs_eq
    {source target : FullYul.StaticContext}
    (hFuncs : source.funcs = target.funcs) :
    RuntimeCoverageSpecLe (RuntimeStaticContextCoverageSpec source)
      (RuntimeStaticContextCoverageSpec target) where
  dataOffset _hOK := trivial
  builtinExpr hOK := hOK
  builtinValues hOK := hOK
  function hOK := by
    rcases hOK with ⟨sig, hLookup, hParam⟩
    exact ⟨sig, by simpa [← hFuncs] using hLookup, hParam⟩

theorem FullYul.addVarName?_funcs_eq
    {ctx ctx' : FullYul.StaticContext} {name : FullYul.Name}
    (hAdd : FullYul.addVarName? ctx name = some ctx') :
    ctx'.funcs = ctx.funcs := by
  unfold FullYul.addVarName? at hAdd
  split at hAdd
  · simp at hAdd
  · cases hScope : FullYul.addScopedName? ctx.vars name with
    | none =>
        simp [hScope] at hAdd
    | some vars' =>
        simp [hScope] at hAdd
        cases hAdd
        rfl

theorem FullYul.addVarNames?_funcs_eq :
    ∀ {names : List FullYul.Name} {ctx ctx' : FullYul.StaticContext},
      FullYul.addVarNames? ctx names = some ctx' ->
        ctx'.funcs = ctx.funcs
  | [], _ctx, _ctx', hAdd =>
      by
        simp [FullYul.addVarNames?] at hAdd
        cases hAdd
        rfl
  | name :: rest, ctx, ctx', hAdd =>
      by
        cases hHead : FullYul.addVarName? ctx name with
        | none =>
            simp [FullYul.addVarNames?, hHead] at hAdd
        | some headCtx =>
            have hRest :
                FullYul.addVarNames? headCtx rest = some ctx' := by
              simpa [FullYul.addVarNames?, hHead] using hAdd
            exact
              Eq.trans
                (FullYul.addVarNames?_funcs_eq hRest)
                (FullYul.addVarName?_funcs_eq hHead)

theorem FullYul.predeclareStmtFunctionSigs?_eq_self_of_stmtHasNoFunDefs
    (ctx : FullYul.StaticContext) :
    ∀ {stmt : FullYul.Stmt},
      FullYul.stmtHasNoFunDefs stmt = true ->
        FullYul.predeclareStmtFunctionSigs? ctx stmt = some ctx
  | FullYul.Stmt.funDef _ _ _ _, hNoFun =>
      by simp [FullYul.stmtHasNoFunDefs] at hNoFun
  | FullYul.Stmt.seq first second, hNoFun =>
      by
        have hParts :
            FullYul.stmtHasNoFunDefs first = true ∧
              FullYul.stmtHasNoFunDefs second = true := by
          simpa [FullYul.stmtHasNoFunDefs] using hNoFun
        have hFirst :=
          FullYul.predeclareStmtFunctionSigs?_eq_self_of_stmtHasNoFunDefs
            ctx hParts.1
        have hSecond :=
          FullYul.predeclareStmtFunctionSigs?_eq_self_of_stmtHasNoFunDefs
            ctx hParts.2
        simp [FullYul.predeclareStmtFunctionSigs?, hFirst, hSecond]
  | FullYul.Stmt.skip, _hNoFun =>
      rfl
  | FullYul.Stmt.expr _expr, _hNoFun =>
      rfl
  | FullYul.Stmt.let1 _name _init, _hNoFun =>
      rfl
  | FullYul.Stmt.letMany _names _init, _hNoFun =>
      rfl
  | FullYul.Stmt.assign _name _expr, _hNoFun =>
      rfl
  | FullYul.Stmt.assignMany _names _exprs, _hNoFun =>
      rfl
  | FullYul.Stmt.letCall _names _fnName _args, _hNoFun =>
      rfl
  | FullYul.Stmt.assignCall _names _fnName _args, _hNoFun =>
      rfl
  | FullYul.Stmt.block _stmts, _hNoFun =>
      rfl
  | FullYul.Stmt.ifThen _cond _body, _hNoFun =>
      rfl
  | FullYul.Stmt.switch _discr _cases _defaultBranch, _hNoFun =>
      rfl
  | FullYul.Stmt.forLoop _pre _cond _post _body, _hNoFun =>
      rfl
  | FullYul.Stmt.break, _hNoFun =>
      rfl
  | FullYul.Stmt.continue, _hNoFun =>
      rfl
  | FullYul.Stmt.leave, _hNoFun =>
      rfl

theorem FullYul.predeclareBlockFunctionSigs?_eq_self_of_blockHasNoFunDefs
    (ctx : FullYul.StaticContext) :
    ∀ {stmts : List FullYul.Stmt},
      FullYul.blockHasNoFunDefs stmts = true ->
        FullYul.predeclareBlockFunctionSigs? ctx stmts = some ctx
  | [], _hNoFun =>
      rfl
  | stmt :: rest, hNoFun =>
      by
        have hParts :
            FullYul.stmtHasNoFunDefs stmt = true ∧
              FullYul.blockHasNoFunDefs rest = true := by
          simpa [FullYul.blockHasNoFunDefs] using hNoFun
        have hStmt :=
          FullYul.predeclareStmtFunctionSigs?_eq_self_of_stmtHasNoFunDefs
            ctx hParts.1
        have hRest :=
          FullYul.predeclareBlockFunctionSigs?_eq_self_of_blockHasNoFunDefs
            ctx hParts.2
        simp [FullYul.predeclareBlockFunctionSigs?, hStmt, hRest]

mutual
theorem FullYul.checkStmtFuel_funcs_eq_of_stmtHasNoFunDefs :
    ∀ {fuel : Nat} {ctx ctx' : FullYul.StaticContext}
      {inLoop inFunction : Bool} {stmt : FullYul.Stmt},
      FullYul.stmtHasNoFunDefs stmt = true ->
      FullYul.checkStmtFuel fuel ctx inLoop inFunction stmt = some ctx' ->
        ctx'.funcs = ctx.funcs
  | 0, _ctx, _ctx', _inLoop, _inFunction, _stmt, _hNoFun, hCheck =>
      by simp [FullYul.checkStmtFuel] at hCheck
  | fuel + 1, ctx, ctx', inLoop, inFunction, stmt, hNoFun, hCheck =>
      by
        cases stmt with
        | skip =>
            have hAccepted :=
              FullYul.checkStmtFuel_skip_accepted_implies hCheck
            subst ctx'
            rfl
        | expr expr =>
            have hAccepted :=
              FullYul.checkStmtFuel_expr_accepted_implies hCheck
            exact hAccepted.2 ▸ rfl
        | let1 name init =>
            cases init with
            | none =>
                rcases
                    FullYul.checkStmtFuel_let1_default_accepted_implies
                      hCheck with
                  ⟨declCtx, hAdd, hCtx⟩
                subst ctx'
                exact FullYul.addVarName?_funcs_eq hAdd
            | some expr =>
                rcases
                    FullYul.checkStmtFuel_let1_init_accepted_implies
                      hCheck with
                  ⟨_hExpr, declCtx, hAdd, hCtx⟩
                subst ctx'
                exact FullYul.addVarName?_funcs_eq hAdd
        | letMany names init =>
            cases init with
            | none =>
                rcases
                    FullYul.checkStmtFuel_letMany_default_accepted_implies
                      hCheck with
                  ⟨declCtx, hAdd, hCtx⟩
                subst ctx'
                exact FullYul.addVarNames?_funcs_eq hAdd
            | some exprs =>
                rcases
                    FullYul.checkStmtFuel_letMany_init_accepted_implies
                      hCheck with
                  ⟨_hExprs, declCtx, hAdd, hCtx⟩
                subst ctx'
                exact FullYul.addVarNames?_funcs_eq hAdd
        | funDef name params returns body =>
            simp [FullYul.stmtHasNoFunDefs] at hNoFun
        | assign name expr =>
            have hAccepted :=
              FullYul.checkStmtFuel_assign_accepted_implies hCheck
            exact hAccepted.2.2 ▸ rfl
        | assignMany names exprs =>
            have hAccepted :=
              FullYul.checkStmtFuel_assignMany_accepted_implies hCheck
            exact hAccepted.2.2.2 ▸ rfl
        | letCall names fnName args =>
            rcases
                FullYul.checkStmtFuel_letCall_accepted_implies hCheck with
              ⟨_sig, _declCtx, _hLookup, _hArgs, _hParam, _hReturn,
                hAdd, hCtx⟩
            subst ctx'
            exact FullYul.addVarNames?_funcs_eq hAdd
        | assignCall names fnName args =>
            rcases
                FullYul.checkStmtFuel_assignCall_accepted_implies hCheck with
              ⟨_sig, _hLookup, _hUnique, _hNames, _hArgs, _hParam,
                _hReturn, hCtx⟩
            exact hCtx ▸ rfl
        | seq first second =>
            have hParts :
                FullYul.stmtHasNoFunDefs first = true ∧
                  FullYul.stmtHasNoFunDefs second = true := by
              simpa [FullYul.stmtHasNoFunDefs] using hNoFun
            rcases
                FullYul.checkStmtFuel_seq_accepted_implies hCheck with
              ⟨seqCtx, midCtx, hPre, hFirst, hSecond⟩
            have hPreSelf :
                seqCtx = ctx := by
              have hPre' :=
                FullYul.predeclareStmtFunctionSigs?_eq_self_of_stmtHasNoFunDefs
                  ctx hNoFun
              rw [hPre'] at hPre
              cases hPre
              rfl
            subst seqCtx
            have hFirstFuncs :=
              FullYul.checkStmtFuel_funcs_eq_of_stmtHasNoFunDefs
                hParts.1 hFirst
            have hSecondFuncs :=
              FullYul.checkStmtFuel_funcs_eq_of_stmtHasNoFunDefs
                hParts.2 hSecond
            exact Eq.trans hSecondFuncs hFirstFuncs
        | block stmts =>
            have hAccepted :=
              FullYul.checkStmtFuel_block_accepted_implies hCheck
            exact hAccepted.1 ▸ rfl
        | ifThen cond body =>
            have hAccepted :=
              FullYul.checkStmtFuel_if_accepted_implies hCheck
            exact hAccepted.2.1 ▸ rfl
        | switch discr cases defaultBranch =>
            have hAccepted :=
              FullYul.checkStmtFuel_switch_accepted_implies hCheck
            exact hAccepted.2.2.2.1 ▸ rfl
        | forLoop pre cond post body =>
            have hAccepted :=
              FullYul.checkStmtFuel_for_accepted_implies_any_loop hCheck
            exact hAccepted.1 ▸ rfl
        | «break» =>
            simp [FullYul.checkStmtFuel] at hCheck
            rw [← hCheck.2]
        | «continue» =>
            simp [FullYul.checkStmtFuel] at hCheck
            rw [← hCheck.2]
        | «leave» =>
            simp [FullYul.checkStmtFuel] at hCheck
            rw [← hCheck.2]

theorem FullYul.checkBlockFuel_funcs_eq_of_blockHasNoFunDefs :
    ∀ {fuel : Nat} {ctx ctx' : FullYul.StaticContext}
      {inLoop inFunction : Bool} {stmts : List FullYul.Stmt},
      FullYul.blockHasNoFunDefs stmts = true ->
      FullYul.checkBlockFuel fuel ctx inLoop inFunction stmts = some ctx' ->
        ctx'.funcs = ctx.funcs
  | 0, _ctx, _ctx', _inLoop, _inFunction, _stmts, _hNoFun, hCheck =>
      by simp [FullYul.checkBlockFuel] at hCheck
  | fuel + 1, ctx, ctx', inLoop, inFunction, [], _hNoFun, hCheck =>
      by
        have hAccepted :=
          FullYul.checkBlockFuel_empty_accepted_implies hCheck
        subst ctx'
        rfl
  | fuel + 1, ctx, ctx', inLoop, inFunction, stmt :: rest, hNoFun, hCheck =>
      by
        have hParts :
            FullYul.stmtHasNoFunDefs stmt = true ∧
              FullYul.blockHasNoFunDefs rest = true := by
          simpa [FullYul.blockHasNoFunDefs] using hNoFun
        rcases
            FullYul.checkBlockFuel_cons_accepted_implies hCheck with
          ⟨midCtx, hStmt, hRest⟩
        have hStmtFuncs :=
          FullYul.checkStmtFuel_funcs_eq_of_stmtHasNoFunDefs
            hParts.1 hStmt
        have hRestFuncs :=
          FullYul.checkBlockFuel_funcs_eq_of_blockHasNoFunDefs
            hParts.2 hRest
        exact Eq.trans hRestFuncs hStmtFuncs
end

