              some
                ( FullYul.Value.ternaryBuiltin builtin symbolicFirst
                    symbolicSecond symbolicThird
                , state ))
    (state : FullYul.EvmState)
    {firstValue secondValue thirdValue : Word}
    {symbolicFirst symbolicSecond symbolicThird : FullYul.Value}
    (hFirst : ValueRel model firstValue symbolicFirst)
    (hSecond : ValueRel model secondValue symbolicSecond)
    (hThird : ValueRel model thirdValue symbolicThird) :
