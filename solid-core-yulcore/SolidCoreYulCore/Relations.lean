            ConcreteYul.collectBlockFunctionDefs stmts
              concreteConfig.funcs }
        { symbolicConfig with
          funcs :=
            SymYul.collectBlockFunctionDefs
              (embedConcreteStmtsFuel embedFuel stmts)
              symbolicConfig.funcs }
        stmts)
    (hConcreteBlock :
      ConcreteYul.evalRuntimeBlockFuel hash fuel
          { concreteConfig with
