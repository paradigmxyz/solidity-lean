      FullYul.checkStmtFuel fuel ctx inLoop inFunction
          (embedConcreteStmt program.body) = some ctx') :
    RuntimeProgramBodyCoveredSpec (RuntimeStaticContextCoverageSpec ctx)
      program :=
  let hCoveredExists :=
    runtimeStructuralBodyCoveredSpec_staticContext_of_checkStmtFuel_embed_noFun
      hNoFun hCheck
  { minEmbedFuel := Classical.choose hCoveredExists
    covered := (Classical.choose_spec hCoveredExists).1 }

