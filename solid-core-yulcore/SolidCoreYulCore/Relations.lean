theorem RuntimeStructuralBodyCoveredSpec.foldRel
    {spec : RuntimeCoverageSpec}
    {BodyRel : Nat -> ConcreteYul.Stmt -> Prop}
    {BlockRel : Nat -> List ConcreteYul.Stmt -> Prop}
    {CasesRel : Nat -> List (Word × ConcreteYul.Stmt) -> Prop}
    {DefaultRel : Nat -> Nat -> Option ConcreteYul.Stmt -> Prop}
    {SwitchRel :
      Nat -> ConcreteYul.Expr -> List (Word × ConcreteYul.Stmt) ->
        Option ConcreteYul.Stmt -> Prop}
    (bodyAlg :
      RuntimeStructuralBodyCoveredAlg spec BodyRel BlockRel SwitchRel)
    (blockAlg : RuntimeStructuralBlockCoveredAlg BodyRel BlockRel)
    (casesAlg :
      RuntimeStructuralSwitchCasesCoveredAlg BodyRel CasesRel)
    (defaultAlg :
      RuntimeStructuralSwitchDefaultCoveredAlg BodyRel DefaultRel)
    (switchAlg :
      RuntimeStructuralSwitchCoveredAlg spec CasesRel DefaultRel
        SwitchRel) :
    ∀ {minEmbedFuel : Nat} {stmt : ConcreteYul.Stmt},
      RuntimeStructuralBodyCoveredSpec spec minEmbedFuel stmt ->
      BodyRel minEmbedFuel stmt
  | _, _, RuntimeStructuralBodyCoveredSpec.legacy hBody =>
      bodyAlg.legacy hBody
  | _, _, RuntimeStructuralBodyCoveredSpec.block hBlock =>
      bodyAlg.block
        (RuntimeStructuralBlockCoveredSpec.foldRel bodyAlg blockAlg
          casesAlg defaultAlg switchAlg hBlock)
  | _, _, RuntimeStructuralBodyCoveredSpec.funDef hBody hEmbed =>
      bodyAlg.funDef
        (RuntimeStructuralBodyCoveredSpec.foldRel bodyAlg blockAlg casesAlg
          defaultAlg switchAlg hBody)
        hEmbed
  | _, _, RuntimeStructuralBodyCoveredSpec.seq hFirst hSecond =>
      bodyAlg.seq
        (RuntimeStructuralBodyCoveredSpec.foldRel bodyAlg blockAlg casesAlg
          defaultAlg switchAlg hFirst)
        (RuntimeStructuralBodyCoveredSpec.foldRel bodyAlg blockAlg casesAlg
          defaultAlg switchAlg hSecond)
  | _, _, RuntimeStructuralBodyCoveredSpec.ifThen hCond hBody =>
      bodyAlg.ifThen hCond
        (RuntimeStructuralBodyCoveredSpec.foldRel bodyAlg blockAlg casesAlg
          defaultAlg switchAlg hBody)
  | _, _, RuntimeStructuralBodyCoveredSpec.switch hSwitch =>
      bodyAlg.switch
        (RuntimeStructuralSwitchCoveredSpec.foldRel bodyAlg blockAlg
          casesAlg defaultAlg switchAlg hSwitch)
  | _, _, RuntimeStructuralBodyCoveredSpec.forLoop hPre hCond hPost hBody =>
      bodyAlg.forLoop
        (RuntimeStructuralBodyCoveredSpec.foldRel bodyAlg blockAlg casesAlg
          defaultAlg switchAlg hPre)
        hCond
        (RuntimeStructuralBodyCoveredSpec.foldRel bodyAlg blockAlg casesAlg
          defaultAlg switchAlg hPost)
        (RuntimeStructuralBodyCoveredSpec.foldRel bodyAlg blockAlg casesAlg
          defaultAlg switchAlg hBody)

