        Evm.Builtin.linkersymbolOp [key] [RuntimeArgKind.word]

theorem RuntimeCompilerArtifactBuiltinValueArgKinds.of_profileArtifact
    {builtin : Evm.Builtin} {args : List ConcreteYul.Expr}
    (hBuiltin :
      FullYul.CompilerProfile.CompilerArtifactBuiltin builtin)
    (hSig : ∃ sig, builtin.signature? = some sig ∧
      sig.paramCount = args.length) :
    ∃ kinds,
      RuntimeCompilerArtifactBuiltinValueArgKinds builtin args kinds := by
  cases hBuiltin with
  | setimmutableOp =>
      rcases hSig with ⟨sig, hSig, hLen⟩
      simp [Evm.Builtin.signature?] at hSig
      cases hSig
      cases args with
      | nil =>
          simp at hLen
      | cons offset rest =>
          cases rest with
          | nil =>
              simp at hLen
          | cons key restTail =>
              cases restTail with
              | nil =>
                  simp at hLen
              | cons value restTailTail =>
                  cases restTailTail with
                  | nil =>
                      exact
                        ⟨ [ RuntimeArgKind.word
                          , RuntimeArgKind.word
                          , RuntimeArgKind.value ]
                        , RuntimeCompilerArtifactBuiltinValueArgKinds.setimmutableOp ⟩
                  | cons _ _ =>
                      simp at hLen
  | loadimmutableOp =>
      rcases hSig with ⟨sig, hSig, hLen⟩
      simp [Evm.Builtin.signature?] at hSig
      cases hSig
      cases args with
      | nil =>
          simp at hLen
      | cons key rest =>
          cases rest with
          | nil =>
              exact
                ⟨ [RuntimeArgKind.word]
                , RuntimeCompilerArtifactBuiltinValueArgKinds.loadimmutableOp ⟩
          | cons _ _ =>
              simp at hLen
  | linkersymbolOp =>
      rcases hSig with ⟨sig, hSig, hLen⟩
      simp [Evm.Builtin.signature?] at hSig
      cases hSig
      cases args with
      | nil =>
          simp at hLen
      | cons key rest =>
          cases rest with
          | nil =>
              exact
                ⟨ [RuntimeArgKind.word]
                , RuntimeCompilerArtifactBuiltinValueArgKinds.linkersymbolOp ⟩
          | cons _ _ =>
              simp at hLen

theorem runtimeExprReadValueExactRelSim_loadimmutable_of_args
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    {concreteConfig : ConcreteYul.RuntimeConfig}
    {symbolicConfig : SymYul.GuidedConfig}
    {args : List ConcreteYul.Expr}
    (hArgs :
      RuntimeExprsKindReadValueExactRelSim model hash concreteConfig
        symbolicConfig args [RuntimeArgKind.word])
    (hProvider : RuntimeCompilerArtifactProviderOk model) :
    RuntimeExprReadValueExactRelSim model hash concreteConfig symbolicConfig
      (ConcreteYul.Expr.builtin Evm.Builtin.loadimmutableOp args) := by
  apply
    runtimeExprReadValueExactRelSim_builtin_non_datacopy_of_runtimeExprsKindReadValueExactRel
      model hash
  · decide
  · exact hArgs
  · intro concreteArgs concreteArgConfig concreteAfterConfig concreteValue
      concreteState' hConcreteArgs hConcreteBuiltin hAfterConfig
      symbolicArgs symbolicArgConfig hGuidedArgs hArgsRel hArgConfigExact
    rcases RuntimeArgListKindRel.single_word hArgsRel with
      ⟨key, hConcreteArgsEq, hSymbolicArgsEq, hKeyNorm⟩
    subst concreteArgs
    cases hLookup :
        ConcreteYul.lookupWordMap? concreteArgConfig.state.immutables key with
    | some value =>
        have hConcreteLoad :=
          ConcreteYul.evalBuiltin_loadimmutable_present hash
            concreteArgConfig.state key value hLookup
        rw [hConcreteLoad] at hConcreteBuiltin
        simp [ConcreteYul.returnWord] at hConcreteBuiltin
        rcases hConcreteBuiltin with ⟨hConcreteValue, hConcreteStateEq⟩
        rcases
            hArgConfigExact.evmRel.valueRel.immutablesRel key value hLookup
          with ⟨symbolicValue, hSymbolicLookup, hValueRel⟩
        refine
          ⟨ symbolicValue
          , symbolicArgConfig.evm
          , ?_
          , by
              simpa [hConcreteValue] using valueRel_norm_left hValueRel
          , ?_ ⟩
        · simpa [hSymbolicArgsEq, hKeyNorm, embedWordValue] using
            FullYul.evalEvmBuiltin_loadimmutable_present
              symbolicArgConfig.evm (embedWordValue key) symbolicValue
              hSymbolicLookup
        · simpa [hAfterConfig, ← hConcreteStateEq] using hArgConfigExact
    | none =>
        have hConcreteLoad :=
          ConcreteYul.evalBuiltin_loadimmutable_missing hash
            concreteArgConfig.state key hLookup
        rw [hConcreteLoad] at hConcreteBuiltin
        simp [ConcreteYul.returnWord] at hConcreteBuiltin
        rcases hConcreteBuiltin with ⟨hConcreteValue, hConcreteStateEq⟩
        rcases hProvider.loadimmutableMissing hArgConfigExact hLookup with
          ⟨hSymbolicLookup, hModel⟩
        refine
          ⟨ FullYul.Value.unaryBuiltin Evm.Builtin.loadimmutableOp
              (embedWordValue key)
          , symbolicArgConfig.evm
          , ?_
          , ?_
          , ?_ ⟩
        · simpa [hSymbolicArgsEq, hKeyNorm, embedWordValue] using
            FullYul.evalEvmBuiltin_loadimmutable_missing
              symbolicArgConfig.evm (embedWordValue key) hSymbolicLookup
        · unfold ValueRel embedWordValue
          simp [SymYul.interpValue]
          rw [← hConcreteValue, hKeyNorm]
          simpa [norm_zero] using hModel.symm
        · simpa [hAfterConfig, ← hConcreteStateEq] using hArgConfigExact

