theorem runtimeStmtFuelValueExactRelSim_of_covered_spec_dispatchers_fuel_upTo
    (model : SymYul.ConcreteModel) (hash : ConcreteYul.HashOracle)
    {fuel embedFuel maxFunctionFuel : Nat}
    {spec : RuntimeCoverageSpec}
    (hDispatchers :
      RuntimeCoveredDispatchersValueExactUpTo model hash maxFunctionFuel
        spec)
    {stmt : ConcreteYul.Stmt}
    {concreteConfig : ConcreteYul.RuntimeConfig}
    {symbolicConfig : SymYul.GuidedConfig}
    (hFunctionFuel : fuel.pred ≤ maxFunctionFuel)
    (hCovered : RuntimeCoveredStmtSpec spec stmt)
    (hEmbedFuel : 2 ≤ embedFuel) :
    RuntimeStmtFuelValueExactRelSim model hash fuel embedFuel
      concreteConfig symbolicConfig stmt := by
  cases fuel with
  | zero =>
      exact
        runtimeStmtFuelValueExactRelSim_of_concrete_none
          (by simp [ConcreteYul.evalRuntimeStmtFuel])
  | succ fuel =>
      cases fuel with
      | zero =>
          have hEmbedFuelOne : 1 ≤ embedFuel :=
            Nat.le_trans (by decide : 1 ≤ 2) hEmbedFuel
          have hEmbedFuelEq :
              embedFuel = (embedFuel - 1).succ := by
            have h := (Nat.sub_add_cancel hEmbedFuelOne).symm
            simpa [Nat.succ_eq_add_one] using h
          rw [hEmbedFuelEq]
          exact
            runtimeStmtFuelValueExactRelSim_of_covered_spec_dispatchers_one_upTo
              model hash (embedFuel - 1) maxFunctionFuel hDispatchers
              hCovered
      | succ fuel =>
          have hFuel : 2 ≤ fuel.succ.succ :=
            Nat.succ_le_succ (Nat.succ_le_succ (Nat.zero_le fuel))
          have hFuelBudget : (fuel.succ.succ - 2).succ ≤ maxFunctionFuel := by
            simpa using hFunctionFuel
          exact
            runtimeStmtFuelValueExactRelSim_of_covered_spec_dispatchers_ge_upTo
              model hash hDispatchers hFuelBudget hCovered hFuel
              hEmbedFuel

