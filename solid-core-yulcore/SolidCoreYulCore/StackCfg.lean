        (depthOf := depthOf) (fuel := fuel) (layout := layout)
        (dest := dest) (entry := entry) (thenLabel := entry + 1)
        (exit := exit) (cond := cond) (body := body)
        (cfg := cfg) (tailDepth := tailDepth)
        hCompile hEntry (hThen rfl) (hIfExit rfl)
        (fun hCond hBody hOut =>
