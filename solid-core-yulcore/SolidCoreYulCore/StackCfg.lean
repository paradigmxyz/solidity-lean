theorem compileSwitchTwoDefaultFrom_cfg_correct
    {compileFuel : Nat} {layout : Layout}
    {discr : ConcreteYul.Expr}
    {firstValue secondValue : Word}
    {firstBody secondBody defaultBody : ConcreteYul.Stmt}
    {cfg : CfgCodegen} {hash : ConcreteYul.HashOracle} {evalFuel : Nat}
    {source : ConcreteYul.Config} {result : ConcreteYul.Result}
    {tail : Stack} {target : TargetState}
    (hLayout : layout.WellFormed)
    (hCompile :
      compileSwitchTwoDefaultFrom compileFuel layout discr firstValue
          firstBody secondValue secondBody defaultBody =
        some cfg)
    (hEval :
      ConcreteYul.evalStmtFuel hash evalFuel.succ.succ source
        (ConcreteYul.Stmt.switch discr
          [(firstValue, firstBody), (secondValue, secondBody)]
          (some defaultBody)) =
        some result)
    (hNoHalt : source.state.halt? = none)
    (hRel : StackRel layout source [] tail target) :
    ∃ target',
      Reaches cfg.program (Config.at 0 target)
        (Config.halted target') ∧
        StackRel cfg.outLayout result.config [] tail target' ∧
        result.flow = ConcreteYul.Flow.normal := by
  simp [compileSwitchTwoDefaultFrom] at hCompile
  cases hDiscrCode : compileExprAt layout 0 discr with
  | none =>
      simp [hDiscrCode] at hCompile
  | some discrCode =>
      cases hFirstCompile :
          compileStmtFuelFrom compileFuel layout firstBody with
      | none =>
          simp [hDiscrCode, hFirstCompile] at hCompile
      | some firstGen =>
          cases hSecondCompile :
              compileStmtFuelFrom compileFuel layout secondBody with
          | none =>
              simp [hDiscrCode, hFirstCompile, hSecondCompile] at hCompile
          | some secondGen =>
              cases hDefaultCompile :
                  compileStmtFuelFrom compileFuel layout defaultBody with
              | none =>
                  simp [hDiscrCode, hFirstCompile, hSecondCompile,
                    hDefaultCompile] at hCompile
              | some defaultGen =>
                  by_cases hFirstSame : firstGen.outLayout = layout
                  · by_cases hSecondSame : secondGen.outLayout = layout
                    · by_cases hDefaultSame :
                        defaultGen.outLayout = layout
                      · simp [hDiscrCode, hFirstCompile, hSecondCompile,
                          hDefaultCompile, hFirstSame, hSecondSame,
                          hDefaultSame] at hCompile
                        cases hCompile
                        simp [ConcreteYul.evalStmtFuel] at hEval
                        cases hDiscrEval :
                            ConcreteYul.evalExpr hash discr source with
                        | none =>
                            simp [hDiscrEval] at hEval
                        | some discrResult =>
                            cases discrResult with
                            | mk discrValue discrConfig =>
                                simp [hDiscrEval] at hEval
                                have hDiscrConfigEq :
                                    discrConfig = source :=
                                  compileExprAt_eval_config_eq
                                    hDiscrCode hDiscrEval
                                have hDiscrNoHalt :
                                    discrConfig.state.halt? = none := by
                                  simpa [hDiscrConfigEq] using hNoHalt
                                rcases
                                  compileExprAt_execList_correct
                                    hDiscrCode hDiscrEval hRel with
                                  ⟨discrTarget, hDiscrExec, hDiscrRel⟩
                                let poppedTarget : TargetState :=
                                  { discrTarget with
                                    stack :=
                                      frameOf layout discrConfig.env ++ tail }
                                have hPoppedRel :
                                    StackRel layout discrConfig [] tail
                                      poppedTarget :=
                                  stackRel_drop_word_temp hDiscrRel
                                by_cases hFirstMatch :
                                    norm firstValue = norm discrValue
                                · have hFirstBranch :
                                      norm discrValue = norm firstValue :=
                                    hFirstMatch.symm
                                  simp [ConcreteYul.switchTarget?,
                                    hFirstMatch] at hEval
                                  rcases
                                    compileStmtFuelFrom_execList_correct
                                      hLayout hFirstCompile hEval
                                        hDiscrNoHalt hPoppedRel with
                                    ⟨firstTarget, hFirstExec, hFirstRel,
                                      hFirstFlow, _hFirstNoHalt,
                                      _hFirstLayout⟩
                                  have hFirstRelLayout :
                                      StackRel layout result.config [] tail
                                        firstTarget := by
                                    simpa [hFirstSame] using hFirstRel
                                  refine
                                    ⟨firstTarget, ?_, hFirstRelLayout,
                                      hFirstFlow⟩
                                  refine
                                    Reaches.step
                                      (next := Config.at 1 discrTarget)
                                      ?_ ?_
                                  · simp [step, switchTwoDefaultProgram,
                                      lookupBlock?, hDiscrExec, execTerm,
                                      hDiscrRel.stack_eq, hFirstBranch]
                                  · refine
                                      Reaches.step
                                        (next := Config.at 5 firstTarget)
                                        ?_ ?_
                                    · simp [step, switchTwoDefaultProgram,
                                        lookupBlock?, execList, execInstr,
                                        hDiscrRel.stack_eq, poppedTarget,
                                        hFirstExec, execTerm]
                                    · exact
                                        reaches_one
                                          (program :=
                                            switchTwoDefaultProgram
                                              discrCode firstValue
                                              secondValue firstGen.code
                                              secondGen.code
                                              defaultGen.code)
                                          (by
                                            simp [step,
                                              switchTwoDefaultProgram,
                                              lookupBlock?, execList,
                                              execTerm])
                                · have hFirstBranchNo :
                                      ¬ norm discrValue = norm firstValue := by
                                    intro h
                                    exact hFirstMatch h.symm
                                  by_cases hSecondMatch :
                                      norm secondValue = norm discrValue
                                  · have hSecondBranch :
                                        norm discrValue = norm secondValue :=
                                      hSecondMatch.symm
                                    simp [ConcreteYul.switchTarget?,
                                      hFirstMatch, hSecondMatch] at hEval
                                    rcases
                                      compileStmtFuelFrom_execList_correct
                                        hLayout hSecondCompile hEval
                                          hDiscrNoHalt hPoppedRel with
                                      ⟨secondTarget, hSecondExec,
                                        hSecondRel, hSecondFlow,
                                        _hSecondNoHalt, _hSecondLayout⟩
                                    have hSecondRelLayout :
                                        StackRel layout result.config [] tail
                                          secondTarget := by
                                      simpa [hSecondSame] using hSecondRel
                                    refine
                                      ⟨secondTarget, ?_,
                                        hSecondRelLayout, hSecondFlow⟩
                                    refine
                                      Reaches.step
                                        (next := Config.at 2 discrTarget)
                                        ?_ ?_
                                    · simp [step, switchTwoDefaultProgram,
                                        lookupBlock?, hDiscrExec, execTerm,
                                        hDiscrRel.stack_eq, hFirstBranchNo]
                                    · refine
                                        Reaches.step
                                          (next := Config.at 3 discrTarget)
                                          ?_ ?_
                                      · simp [step, switchTwoDefaultProgram,
                                          lookupBlock?, execList, execTerm,
                                          hDiscrRel.stack_eq, hSecondBranch]
                                      · refine
                                          Reaches.step
                                            (next :=
                                              Config.at 5 secondTarget)
                                            ?_ ?_
                                        · simp [step,
                                            switchTwoDefaultProgram,
                                            lookupBlock?, execList,
                                            execInstr, hDiscrRel.stack_eq,
                                            poppedTarget, hSecondExec,
                                            execTerm]
                                        · exact
                                            reaches_one
                                              (program :=
                                                switchTwoDefaultProgram
                                                  discrCode firstValue
                                                  secondValue firstGen.code
                                                  secondGen.code
                                                  defaultGen.code)
                                              (by
                                                simp [step,
                                                  switchTwoDefaultProgram,
                                                  lookupBlock?, execList,
                                                  execTerm])
                                  · have hSecondBranchNo :
                                        ¬ norm discrValue = norm secondValue := by
                                      intro h
                                      exact hSecondMatch h.symm
                                    simp [ConcreteYul.switchTarget?,
                                      hFirstMatch, hSecondMatch] at hEval
                                    rcases
                                      compileStmtFuelFrom_execList_correct
                                        hLayout hDefaultCompile hEval
                                          hDiscrNoHalt hPoppedRel with
                                      ⟨defaultTarget, hDefaultExec,
                                        hDefaultRel, hDefaultFlow,
                                        _hDefaultNoHalt, _hDefaultLayout⟩
                                    have hDefaultRelLayout :
                                        StackRel layout result.config [] tail
                                          defaultTarget := by
                                      simpa [hDefaultSame] using hDefaultRel
                                    refine
                                      ⟨defaultTarget, ?_,
                                        hDefaultRelLayout, hDefaultFlow⟩
                                    refine
                                      Reaches.step
                                        (next := Config.at 2 discrTarget)
                                        ?_ ?_
                                    · simp [step, switchTwoDefaultProgram,
                                        lookupBlock?, hDiscrExec, execTerm,
                                        hDiscrRel.stack_eq, hFirstBranchNo]
                                    · refine
                                        Reaches.step
                                          (next := Config.at 4 discrTarget)
                                          ?_ ?_
                                      · simp [step, switchTwoDefaultProgram,
                                          lookupBlock?, execList, execTerm,
                                          hDiscrRel.stack_eq,
                                          hSecondBranchNo]
                                      · refine
                                          Reaches.step
                                            (next :=
                                              Config.at 5 defaultTarget)
                                            ?_ ?_
                                        · simp [step,
                                            switchTwoDefaultProgram,
                                            lookupBlock?, execList,
                                            execInstr, hDiscrRel.stack_eq,
                                            poppedTarget, hDefaultExec,
                                            execTerm]
                                        · exact
                                            reaches_one
                                              (program :=
                                                switchTwoDefaultProgram
                                                  discrCode firstValue
                                                  secondValue firstGen.code
                                                  secondGen.code
                                                  defaultGen.code)
                                              (by
                                                simp [step,
                                                  switchTwoDefaultProgram,
                                                  lookupBlock?, execList,
                                                  execTerm])
                      · simp [hDiscrCode, hFirstCompile, hSecondCompile,
                          hDefaultCompile, hFirstSame, hSecondSame,
                          hDefaultSame] at hCompile
                    · simp [hDiscrCode, hFirstCompile, hSecondCompile,
                        hDefaultCompile, hFirstSame, hSecondSame] at hCompile
                  · simp [hDiscrCode, hFirstCompile, hSecondCompile,
                      hDefaultCompile, hFirstSame] at hCompile

theorem compileSwitchTwoDefaultTo_cfg_correct
    {compileFuel : Nat} {layout : Layout}
    {discr : ConcreteYul.Expr}
    {firstValue secondValue : Word}
    {firstBody secondBody defaultBody : ConcreteYul.Stmt}
    {discrCode : List Instr} {firstGen secondGen defaultGen : Codegen}
    {hash : ConcreteYul.HashOracle} {evalFuel : Nat}
    {source : ConcreteYul.Config} {result : ConcreteYul.Result}
    {tail : Stack} {target : TargetState}
    {entry firstLabel testLabel secondLabel defaultLabel joinLabel : Label}
    (hEntryFirst : entry ≠ firstLabel)
    (hEntryTest : entry ≠ testLabel)
    (hFirstTest : firstLabel ≠ testLabel)
    (hEntrySecond : entry ≠ secondLabel)
    (hFirstSecond : firstLabel ≠ secondLabel)
    (hTestSecond : testLabel ≠ secondLabel)
    (hEntryDefault : entry ≠ defaultLabel)
    (hFirstDefault : firstLabel ≠ defaultLabel)
    (hTestDefault : testLabel ≠ defaultLabel)
    (hSecondDefault : secondLabel ≠ defaultLabel)
    (hLayout : layout.WellFormed)
    (hDiscr : compileExprAt layout 0 discr = some discrCode)
    (hFirst :
      compileStmtFuelFrom compileFuel layout firstBody = some firstGen)
    (hSecond :
      compileStmtFuelFrom compileFuel layout secondBody = some secondGen)
    (hDefault :
      compileStmtFuelFrom compileFuel layout defaultBody = some defaultGen)
    (hFirstOut : firstGen.outLayout = layout)
    (hSecondOut : secondGen.outLayout = layout)
    (hDefaultOut : defaultGen.outLayout = layout)
    (hEval :
      ConcreteYul.evalStmtFuel hash evalFuel.succ.succ source
        (ConcreteYul.Stmt.switch discr
          [(firstValue, firstBody), (secondValue, secondBody)]
          (some defaultBody)) =
        some result)
    (hNoHalt : source.state.halt? = none)
    (hRel : StackRel layout source [] tail target) :
    ∃ target',
      Reaches
        (switchTwoDefaultToProgram entry firstLabel testLabel secondLabel
          defaultLabel joinLabel discrCode firstValue secondValue
          firstGen.code secondGen.code defaultGen.code)
        (Config.at entry target) (Config.at joinLabel target') ∧
        StackRel layout result.config [] tail target' ∧
        result.flow = ConcreteYul.Flow.normal := by
  simp [ConcreteYul.evalStmtFuel] at hEval
  cases hDiscrEval : ConcreteYul.evalExpr hash discr source with
  | none =>
      simp [hDiscrEval] at hEval
  | some discrResult =>
      cases discrResult with
      | mk discrValue discrConfig =>
          simp [hDiscrEval] at hEval
          have hDiscrConfigEq : discrConfig = source :=
            compileExprAt_eval_config_eq hDiscr hDiscrEval
          have hDiscrNoHalt :
              discrConfig.state.halt? = none := by
            simpa [hDiscrConfigEq] using hNoHalt
          rcases
            compileExprAt_execList_correct hDiscr hDiscrEval hRel with
            ⟨discrTarget, hDiscrExec, hDiscrRel⟩
          let poppedTarget : TargetState :=
            { discrTarget with
              stack := frameOf layout discrConfig.env ++ tail }
          have hPoppedRel :
              StackRel layout discrConfig [] tail poppedTarget :=
            stackRel_drop_word_temp hDiscrRel
          by_cases hFirstMatch : norm firstValue = norm discrValue
          · have hFirstBranch :
                norm discrValue = norm firstValue := hFirstMatch.symm
            simp [ConcreteYul.switchTarget?, hFirstMatch] at hEval
            rcases
              compileStmtFuelFrom_execList_correct hLayout hFirst hEval
                hDiscrNoHalt hPoppedRel with
              ⟨firstTarget, hFirstExec, hFirstRel, hFirstFlow,
                _hFirstNoHalt, _hFirstLayout⟩
            have hFirstRelLayout :
                StackRel layout result.config [] tail firstTarget := by
              simpa [hFirstOut] using hFirstRel
            refine ⟨firstTarget, ?_, hFirstRelLayout, hFirstFlow⟩
            refine
              Reaches.step
                (next := Config.at firstLabel discrTarget) ?_ ?_
            · simp [step, switchTwoDefaultToProgram, lookupBlock?,
                hDiscrExec, execTerm, hDiscrRel.stack_eq, hFirstBranch]
            · apply reaches_one
              simp [step, switchTwoDefaultToProgram, lookupBlock?,
                hEntryFirst, execList, execInstr, hDiscrRel.stack_eq,
                poppedTarget, hFirstExec, execTerm]
          · have hFirstBranchNo :
                ¬ norm discrValue = norm firstValue := by
              intro h
              exact hFirstMatch h.symm
            by_cases hSecondMatch : norm secondValue = norm discrValue
            · have hSecondBranch :
                  norm discrValue = norm secondValue := hSecondMatch.symm
              simp [ConcreteYul.switchTarget?, hFirstMatch,
                hSecondMatch] at hEval
              rcases
                compileStmtFuelFrom_execList_correct hLayout hSecond hEval
                  hDiscrNoHalt hPoppedRel with
                ⟨secondTarget, hSecondExec, hSecondRel, hSecondFlow,
                  _hSecondNoHalt, _hSecondLayout⟩
              have hSecondRelLayout :
                  StackRel layout result.config [] tail secondTarget := by
                simpa [hSecondOut] using hSecondRel
