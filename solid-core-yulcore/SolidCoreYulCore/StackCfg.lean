        simp [compileCfgStmtOpenCtxRecFrom] at hCompile
        split at hCompile
        · simp at hCompile
        · rename_i cfg hCfg
          cases hCompile
          exact
            compileCfgStmtOpenCtxAutoFrom_outLayout_wf
              (layout := layout) (ctx := ctx) (entry := entry)
              (normalLabel := normalLabel) (stmt := _) hLayout hCfg

