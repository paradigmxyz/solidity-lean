import SolidCoreYulCore.ConcreteYul

set_option maxHeartbeats 1000000

namespace SolidCoreYulCore
namespace StackCfg

abbrev Label := Nat

def labelRange (start count : Label) : List Label :=
  (List.range count).map (fun offset => start + offset)

def nextLabelAfter (start count : Label) : Label :=
  start + count

theorem labelRange_length (start count : Label) :
    (labelRange start count).length = count := by
  simp [labelRange]

theorem labelRange_zero (start : Label) :
    labelRange start 0 = [] := by
  rfl

theorem labelRange_succ (start count : Label) :
    labelRange start (count + 1) =
      labelRange start count ++ [start + count] := by
  simp [labelRange, List.range_succ, List.map_append]

theorem nextLabelAfter_zero (start : Label) :
    nextLabelAfter start 0 = start := by
  simp [nextLabelAfter]

theorem nextLabelAfter_succ (start count : Label) :
    nextLabelAfter start (count + 1) =
      nextLabelAfter start count + 1 := by
  simp [nextLabelAfter, Nat.add_assoc]

theorem mem_labelRange_bounds {start count label : Label}
    (hMem : label ∈ labelRange start count) :
    start ≤ label ∧ label < nextLabelAfter start count := by
  simp [labelRange] at hMem
  rcases hMem with ⟨offset, hOffset, hLabel⟩
  subst label
  have hOffsetLt : offset < count := by
    simpa using hOffset
  exact ⟨Nat.le_add_right start offset, by
    simp [nextLabelAfter]
    omega⟩

theorem nextLabelAfter_not_mem_labelRange (start count : Label) :
    nextLabelAfter start count ∉ labelRange start count := by
  intro hMem
  rcases mem_labelRange_bounds hMem with ⟨_hLe, hLt⟩
  exact (Nat.lt_irrefl (nextLabelAfter start count)) hLt

inductive Atom where
  | word : Word -> Atom
  | label : Label -> Atom
  deriving DecidableEq, Repr

abbrev Stack := List Atom

structure Layout where
  slots : List ConcreteYul.Name := []
  deriving DecidableEq, Repr

def indexOf? : List ConcreteYul.Name -> ConcreteYul.Name -> Option Nat
  | [], _ => none
  | candidate :: rest, name =>
      if candidate = name then some 0
      else (indexOf? rest name).map Nat.succ

def Layout.index? (layout : Layout) (name : ConcreteYul.Name) : Option Nat :=
  indexOf? layout.slots name

theorem indexOf?_lt_length
    {slots : List ConcreteYul.Name} {name : ConcreteYul.Name}
    {index : Nat}
    (hIndex : indexOf? slots name = some index) :
    index < slots.length := by
  induction slots generalizing index with
  | nil =>
      simp [indexOf?] at hIndex
  | cons candidate rest ih =>
      by_cases hName : candidate = name
      · simp [indexOf?, hName] at hIndex
        cases hIndex
        simp
      · simp [indexOf?, hName] at hIndex
        cases hRest : indexOf? rest name with
        | none =>
            simp [hRest] at hIndex
        | some restIndex =>
            simp [hRest] at hIndex
            cases hIndex
            exact Nat.succ_lt_succ (ih hRest)

inductive SlotsDistinct : List ConcreteYul.Name -> Prop where
  | nil : SlotsDistinct []
  | cons {name : ConcreteYul.Name} {rest : List ConcreteYul.Name} :
      indexOf? rest name = none ->
      SlotsDistinct rest ->
      SlotsDistinct (name :: rest)

theorem SlotsDistinct.of_append_right
    {left right : List ConcreteYul.Name}
    (hDistinct : SlotsDistinct (left ++ right)) :
    SlotsDistinct right := by
  induction left with
  | nil =>
      simpa using hDistinct
  | cons _ rest ih =>
      cases hDistinct with
      | cons _ hRest =>
          exact ih hRest

def Layout.WellFormed (layout : Layout) : Prop :=
  SlotsDistinct layout.slots

def SlotsBound (slots : List ConcreteYul.Name) (env : ConcreteYul.Env) :
    Prop :=
  ∀ {name index}, indexOf? slots name = some index ->
    ∃ value, ConcreteYul.lookup? env name = some value

def Layout.Bound (layout : Layout) (env : ConcreteYul.Env) : Prop :=
  SlotsBound layout.slots env

theorem SlotsBound.of_append_right
    {left right : List ConcreteYul.Name} {env : ConcreteYul.Env}
    (hBound : SlotsBound (left ++ right) env) :
    SlotsBound right env := by
  induction left with
  | nil =>
      intro name index hIndex
      exact hBound hIndex
  | cons head rest ih =>
      apply ih
      intro name index hIndex
      by_cases hName : head = name
      · subst name
        exact hBound (name := head) (index := 0) (by simp [indexOf?])
      · exact
          hBound (name := name) (index := index + 1)
            (by simp [indexOf?, hName, hIndex])

def frameOfSlots : List ConcreteYul.Name -> ConcreteYul.Env -> Stack
  | [], _ => []
  | name :: rest, env =>
      Atom.word ((ConcreteYul.lookup? env name).getD 0) ::
        frameOfSlots rest env

def frameOf (layout : Layout) (env : ConcreteYul.Env) : Stack :=
  frameOfSlots layout.slots env

inductive Instr where
  | pushWord : Word -> Instr
  | dup : Nat -> Instr
  | normTop : Instr
  | store : Nat -> Instr
  | pop : Instr
  | drop : Nat -> Instr
  deriving DecidableEq, Repr

inductive Term where
  | jump : Label -> Term
  | branchNZ : Label -> Label -> Term
  | branchEq : Word -> Label -> Label -> Term
  | call : ConcreteYul.Name -> Nat -> Nat -> Label -> Term
  | halt : Term
  deriving DecidableEq, Repr

structure Block where
  body : List Instr := []
  term : Term := Term.halt
  deriving DecidableEq, Repr

abbrev Program := List (Label × Block)

structure TargetState where
  stack : Stack := []
  state : ConcreteYul.State := ConcreteYul.State.empty
  deriving DecidableEq, Repr

inductive Config where
  | at : Label -> TargetState -> Config
  | halted : TargetState -> Config
  | stuck : Label -> TargetState -> Config
  deriving DecidableEq, Repr

abbrev CallSem :=
  Nat -> ConcreteYul.Name -> List Word -> ConcreteYul.State ->
    Option (List Word × ConcreteYul.State)

def CallSemCorrectBelow (hash : ConcreteYul.HashOracle)
    (funcs : ConcreteYul.FunctionEnv) (callSem : CallSem)
    (fuel : Nat) : Prop :=
  ∀ {m fnName args callerConfig returnValues resultConfig},
    m < fuel ->
      ConcreteYul.evalFunctionFuel hash funcs m fnName args callerConfig =
        some (returnValues, resultConfig) ->
      callSem m fnName (args.map norm) callerConfig.state =
        some (returnValues, resultConfig.state)

theorem CallSemCorrectBelow.mono
    {hash : ConcreteYul.HashOracle}
    {funcs : ConcreteYul.FunctionEnv} {callSem : CallSem}
    {low high : Nat}
    (hCorrect : CallSemCorrectBelow hash funcs callSem high)
    (hLe : low ≤ high) :
    CallSemCorrectBelow hash funcs callSem low := by
  intro m fnName args callerConfig returnValues resultConfig hLt hEval
  exact hCorrect (Nat.lt_of_lt_of_le hLt hLe) hEval

structure CallContext where
  object : ConcreteYul.Object := {}
  deriving DecidableEq, Repr

def CallContext.ofConfig (config : ConcreteYul.Config) : CallContext :=
  { object := config.object }

abbrev ContextualCallSem :=
  Nat -> CallContext -> ConcreteYul.Name -> List Word ->
    ConcreteYul.State -> Option (List Word × ConcreteYul.State)

def ContextualCallSem.toCallSem (sem : ContextualCallSem)
    (ctx : CallContext) : CallSem :=
  fun fuel fnName args state => sem fuel ctx fnName args state

def CallSemCorrectBelowAtObject (hash : ConcreteYul.HashOracle)
    (funcs : ConcreteYul.FunctionEnv) (callSem : CallSem)
    (object : ConcreteYul.Object) (fuel : Nat) : Prop :=
  ∀ {m fnName args callerConfig returnValues resultConfig},
    m < fuel ->
      callerConfig.object = object ->
      ConcreteYul.evalFunctionFuel hash funcs m fnName args callerConfig =
        some (returnValues, resultConfig) ->
      callSem m fnName (args.map norm) callerConfig.state =
        some (returnValues, resultConfig.state)

def CallSemCorrectForConfig (hash : ConcreteYul.HashOracle)
    (funcs : ConcreteYul.FunctionEnv) (callSem : CallSem)
    (callerConfig : ConcreteYul.Config) (fuel : Nat) : Prop :=
  ∀ {m fnName args returnValues resultConfig},
    m < fuel ->
      ConcreteYul.evalFunctionFuel hash funcs m fnName args callerConfig =
        some (returnValues, resultConfig) ->
      callSem m fnName (args.map norm) callerConfig.state =
        some (returnValues, resultConfig.state)

def ContextualCallSemCorrectBelowAt (hash : ConcreteYul.HashOracle)
    (funcs : ConcreteYul.FunctionEnv) (sem : ContextualCallSem)
    (ctx : CallContext) (fuel : Nat) : Prop :=
  CallSemCorrectBelowAtObject hash funcs (sem.toCallSem ctx) ctx.object fuel

theorem CallSemCorrectBelow.atObject
    {hash : ConcreteYul.HashOracle}
    {funcs : ConcreteYul.FunctionEnv} {callSem : CallSem}
    {object : ConcreteYul.Object} {fuel : Nat}
    (hCorrect : CallSemCorrectBelow hash funcs callSem fuel) :
    CallSemCorrectBelowAtObject hash funcs callSem object fuel := by
  intro m fnName args callerConfig returnValues resultConfig hLt _hObject
    hEval
  exact hCorrect hLt hEval

theorem CallSemCorrectBelowAtObject.mono
    {hash : ConcreteYul.HashOracle}
    {funcs : ConcreteYul.FunctionEnv} {callSem : CallSem}
    {object : ConcreteYul.Object} {low high : Nat}
    (hCorrect :
      CallSemCorrectBelowAtObject hash funcs callSem object high)
    (hLe : low ≤ high) :
    CallSemCorrectBelowAtObject hash funcs callSem object low := by
  intro m fnName args callerConfig returnValues resultConfig hLt hObject
    hEval
  exact hCorrect (Nat.lt_of_lt_of_le hLt hLe) hObject hEval

theorem CallSemCorrectBelow.forConfig
    {hash : ConcreteYul.HashOracle}
    {funcs : ConcreteYul.FunctionEnv} {callSem : CallSem}
    {callerConfig : ConcreteYul.Config} {fuel : Nat}
    (hCorrect : CallSemCorrectBelow hash funcs callSem fuel) :
    CallSemCorrectForConfig hash funcs callSem callerConfig fuel := by
  intro m fnName args returnValues resultConfig hLt hEval
  exact hCorrect hLt hEval

theorem CallSemCorrectBelowAtObject.forConfig
    {hash : ConcreteYul.HashOracle}
    {funcs : ConcreteYul.FunctionEnv} {callSem : CallSem}
    {object : ConcreteYul.Object}
    {callerConfig : ConcreteYul.Config} {fuel : Nat}
    (hCorrect :
      CallSemCorrectBelowAtObject hash funcs callSem object fuel)
    (hObject : callerConfig.object = object) :
    CallSemCorrectForConfig hash funcs callSem callerConfig fuel := by
  intro m fnName args returnValues resultConfig hLt hEval
  exact hCorrect hLt hObject hEval

theorem CallSemCorrectForConfig.mono
    {hash : ConcreteYul.HashOracle}
    {funcs : ConcreteYul.FunctionEnv} {callSem : CallSem}
    {callerConfig : ConcreteYul.Config} {low high : Nat}
    (hCorrect :
      CallSemCorrectForConfig hash funcs callSem callerConfig high)
    (hLe : low ≤ high) :
    CallSemCorrectForConfig hash funcs callSem callerConfig low := by
  intro m fnName args returnValues resultConfig hLt hEval
  exact hCorrect (Nat.lt_of_lt_of_le hLt hLe) hEval

def lookupBlock? : Program -> Label -> Option Block
  | [], _ => none
  | (candidate, block) :: rest, label =>
      if candidate = label then some block else lookupBlock? rest label

def Program.HasLabel (program : Program) (label : Label) : Prop :=
  ∃ block, lookupBlock? program label = some block

def Program.Fresh (program : Program) (label : Label) : Prop :=
  lookupBlock? program label = none

def Program.Extends (base extended : Program) : Prop :=
  ∀ {label block}, lookupBlock? base label = some block ->
    lookupBlock? extended label = some block

theorem lookupBlock?_append_of_some
    (base extra : Program) {label : Label} {block : Block}
    (hLookup : lookupBlock? base label = some block) :
    lookupBlock? (base ++ extra) label = some block := by
  induction base with
  | nil =>
      simp [lookupBlock?] at hLookup
  | cons entry rest ih =>
      cases entry with
      | mk candidate candidateBlock =>
          by_cases hCandidate : candidate = label
          · subst candidate
            simp [lookupBlock?] at hLookup ⊢
            exact hLookup
          · simp [lookupBlock?, hCandidate] at hLookup ⊢
            exact ih hLookup

theorem lookupBlock?_append_of_none
    (base extra : Program) {label : Label}
    (hFresh : lookupBlock? base label = none) :
    lookupBlock? (base ++ extra) label = lookupBlock? extra label := by
  induction base with
  | nil =>
      rfl
  | cons entry rest ih =>
      cases entry with
      | mk candidate block =>
          by_cases hCandidate : candidate = label
          · subst candidate
            simp [lookupBlock?] at hFresh
          · simp [lookupBlock?, hCandidate] at hFresh ⊢
            exact ih hFresh

theorem lookupBlock?_append_some
    (base extra : Program) {label : Label} {block : Block}
    (hLookup : lookupBlock? (base ++ extra) label = some block) :
    lookupBlock? base label = some block ∨
      lookupBlock? base label = none ∧
        lookupBlock? extra label = some block := by
  induction base with
  | nil =>
      right
      constructor
      · rfl
      · simpa [lookupBlock?] using hLookup
  | cons entry rest ih =>
      cases entry with
      | mk candidate candidateBlock =>
          by_cases hCandidate : candidate = label
          · subst candidate
            simp [lookupBlock?] at hLookup ⊢
            exact hLookup
          · simp [lookupBlock?, hCandidate] at hLookup ⊢
            exact ih hLookup

theorem Program.extends_refl (program : Program) :
    Program.Extends program program := by
  intro label block hLookup
  exact hLookup

theorem Program.extends_trans {first second third : Program}
    (hFirstSecond : Program.Extends first second)
    (hSecondThird : Program.Extends second third) :
    Program.Extends first third := by
  intro label block hLookup
  exact hSecondThird (hFirstSecond hLookup)

theorem Program.extends_append_right (base extra : Program) :
    Program.Extends base (base ++ extra) := by
  intro label block hLookup
  exact lookupBlock?_append_of_some base extra hLookup

theorem Program.extends_append_left_of_fresh
    (pre base : Program)
    (hFresh :
      ∀ {label block}, lookupBlock? base label = some block ->
        lookupBlock? pre label = none) :
    Program.Extends base (pre ++ base) := by
  intro label block hLookup
  rw [lookupBlock?_append_of_none pre base (hFresh hLookup)]
  exact hLookup

theorem Program.extends_append_left_right_of_fresh
    (pre base suffix : Program)
    (hFresh :
      ∀ {label block}, lookupBlock? base label = some block ->
        lookupBlock? pre label = none) :
    Program.Extends base (pre ++ base ++ suffix) := by
  intro label block hLookup
  rw [List.append_assoc]
  rw [lookupBlock?_append_of_none pre (base ++ suffix) (hFresh hLookup)]
  exact lookupBlock?_append_of_some base suffix hLookup

def replaceAt? {α : Type} : List α -> Nat -> α -> Option (List α)
  | [], _, _ => none
  | _ :: rest, 0, value => some (value :: rest)
  | head :: rest, index + 1, value =>
      match replaceAt? rest index value with
      | some rest' => some (head :: rest')
      | none => none

def removeAt? {α : Type} : List α -> Nat -> Option (List α)
  | [], _ => none
  | _ :: rest, 0 => some rest
  | head :: rest, index + 1 =>
      match removeAt? rest index with
      | some rest' => some (head :: rest')
      | none => none

def execInstr : Instr -> TargetState -> Option TargetState
  | Instr.pushWord value, target =>
      some { target with stack := Atom.word (norm value) :: target.stack }
  | Instr.dup index, target =>
      match target.stack[index]? with
      | some atom => some { target with stack := atom :: target.stack }
      | none => none
  | Instr.normTop, target =>
      match target.stack with
      | Atom.word value :: rest =>
          some { target with stack := Atom.word (norm value) :: rest }
      | _ => none
  | Instr.store index, target =>
      match target.stack with
      | Atom.word value :: rest =>
          match replaceAt? rest index (Atom.word (norm value)) with
          | some stack => some { target with stack := stack }
          | none => none
      | _ => none
  | Instr.pop, target =>
      match target.stack with
      | _ :: rest => some { target with stack := rest }
      | [] => none
  | Instr.drop index, target =>
      match removeAt? target.stack index with
      | some stack => some { target with stack := stack }
      | none => none

def execList : List Instr -> TargetState -> Option TargetState
  | [], target => some target
  | instr :: rest, target =>
      match execInstr instr target with
      | some target' => execList rest target'
      | none => none

def instrDepthAfter? : Instr -> Nat -> Option Nat
  | Instr.pushWord _, depth => some (depth + 1)
  | Instr.dup index, depth =>
      if index < depth then some (depth + 1) else none
  | Instr.normTop, depth =>
      if 0 < depth then some depth else none
  | Instr.store index, depth =>
      if index + 1 < depth then some (depth - 1) else none
  | Instr.pop, depth =>
      if 0 < depth then some (depth - 1) else none
  | Instr.drop index, depth =>
      if index < depth then some (depth - 1) else none

def codeDepthAfter? : List Instr -> Nat -> Option Nat
  | [], depth => some depth
  | instr :: rest, depth =>
      match instrDepthAfter? instr depth with
      | some depth' => codeDepthAfter? rest depth'
      | none => none

def termDepthAfter? : Term -> Nat -> Option Nat
  | Term.jump _, depth => some depth
  | Term.branchNZ _ _, depth =>
      if 0 < depth then some (depth - 1) else none
  | Term.branchEq _ _ _, depth =>
      if 0 < depth then some depth else none
  | Term.call _ argCount retCount _, depth =>
      if argCount ≤ depth then some (depth - argCount + retCount)
      else none
  | Term.halt, depth => some depth

def blockDepthAfter? (block : Block) (depth : Nat) : Option Nat :=
  match codeDepthAfter? block.body depth with
  | some bodyDepth => termDepthAfter? block.term bodyDepth
  | none => none

abbrev DepthEnv := Label -> Option Nat

def termDepthAfterWithTargets? (depthOf : DepthEnv) :
    Term -> Nat -> Option Nat
  | Term.jump label, depth =>
      match depthOf label with
      | some targetDepth =>
          if targetDepth = depth then some depth else none
      | none => none
  | Term.branchNZ thenLabel elseLabel, depth =>
      if 0 < depth then
        let branchDepth := depth - 1
        match depthOf thenLabel, depthOf elseLabel with
        | some thenDepth, some elseDepth =>
            if thenDepth = branchDepth then
              if elseDepth = branchDepth then some branchDepth else none
            else none
        | _, _ => none
      else none
  | Term.branchEq _ thenLabel elseLabel, depth =>
      if 0 < depth then
        match depthOf thenLabel, depthOf elseLabel with
        | some thenDepth, some elseDepth =>
            if thenDepth = depth then
              if elseDepth = depth then some depth else none
            else none
        | _, _ => none
      else none
  | Term.call _ argCount retCount returnLabel, depth =>
      if argCount ≤ depth then
        let returnDepth := depth - argCount + retCount
        match depthOf returnLabel with
        | some targetDepth =>
            if targetDepth = returnDepth then some returnDepth else none
        | none => none
      else none
  | Term.halt, depth => some depth

def blockDepthAfterWithTargets? (depthOf : DepthEnv)
    (block : Block) (depth : Nat) : Option Nat :=
  match codeDepthAfter? block.body depth with
  | some bodyDepth => termDepthAfterWithTargets? depthOf block.term bodyDepth
  | none => none

def Program.DepthChecked (depthOf : DepthEnv) (program : Program) :
    Prop :=
  ∀ {label block},
    lookupBlock? program label = some block ->
      ∃ depth outDepth,
        depthOf label = some depth ∧
          blockDepthAfterWithTargets? depthOf block depth = some outDepth

theorem Program.DepthChecked.nil {depthOf : DepthEnv} :
    Program.DepthChecked depthOf [] := by
  intro label block hLookup
  simp [lookupBlock?] at hLookup

theorem Program.DepthChecked.cons
    {depthOf : DepthEnv} {entry : Label} {block : Block}
    {rest : Program} {depth outDepth : Nat}
    (hEntryDepth : depthOf entry = some depth)
    (hBlock :
      blockDepthAfterWithTargets? depthOf block depth = some outDepth)
    (hRest : Program.DepthChecked depthOf rest) :
    Program.DepthChecked depthOf ((entry, block) :: rest) := by
  intro label foundBlock hLookup
  change
    (if entry = label then some block else lookupBlock? rest label) =
      some foundBlock at hLookup
  by_cases hLabel : entry = label
  · simp [hLabel] at hLookup
    cases hLookup
    have hDepth : depthOf label = some depth := by
      simpa [← hLabel] using hEntryDepth
    exact ⟨depth, outDepth, hDepth, hBlock⟩
  · simp [hLabel] at hLookup
    exact hRest hLookup

theorem Program.DepthChecked.append
    {depthOf : DepthEnv} {first second : Program}
    (hFirst : Program.DepthChecked depthOf first)
    (hSecond : Program.DepthChecked depthOf second) :
    Program.DepthChecked depthOf (first ++ second) := by
  intro label block hLookup
  cases lookupBlock?_append_some first second hLookup with
  | inl hFirstLookup =>
      exact hFirst hFirstLookup
  | inr hSecondLookup =>
      exact hSecond hSecondLookup.2

def popArgWords : Nat -> Stack -> Option (List Word × Stack)
  | 0, stack => some ([], stack)
  | count + 1, Atom.word value :: rest =>
      match popArgWords count rest with
      | some (values, stack) => some (values ++ [norm value], stack)
      | none => none
  | _ + 1, _ => none

def pushReturnWords (values : List Word) (stack : Stack) : Stack :=
  values.map (fun value => Atom.word (norm value)) ++ stack

theorem popArgWords_word_atoms (values : List Word) (tail : Stack) :
    popArgWords values.length
        (values.map (fun value => Atom.word value) ++ tail) =
      some ((values.map norm).reverse, tail) := by
  induction values with
  | nil =>
      rfl
  | cons value rest ih =>
      simp [popArgWords, ih]

theorem popArgWords_expr_values (values : List Word) (tail : Stack) :
    popArgWords values.length
        ((values.map (fun value => Atom.word (norm value))).reverse ++
          tail) =
      some (values.map norm, tail) := by
  have h :=
    popArgWords_word_atoms (values.reverse.map norm) tail
  simp [List.map_reverse, List.map_map] at h
  have hAtoms :
      List.map ((fun value => Atom.word value) ∘ norm) values =
        List.map (fun value => Atom.word (norm value)) values := by
    induction values <;> simp [*]
  have hValues :
      List.map (norm ∘ norm) values = List.map norm values := by
    induction values <;> simp [*, ConcreteYul.norm_norm]
  rw [hAtoms, hValues] at h
  exact h

def popN : Nat -> List Instr
  | 0 => []
  | count + 1 => Instr.pop :: popN count

def dropUnderTemps (tempCount : Nat) : Nat -> List Instr
  | 0 => []
  | count + 1 => Instr.drop tempCount :: dropUnderTemps tempCount count

def dupTopValuesSourceAux : Nat -> Nat -> List Instr
  | _, 0 => []
  | copied, count + 1 =>
      Instr.dup (copied + copied) ::
        dupTopValuesSourceAux (copied + 1) count

def dupTopValuesSource (count : Nat) : List Instr :=
  dupTopValuesSourceAux 0 count

def callAssignCleanupCode (returnCount calleeFrameSize : Nat)
    (storeCode : List Instr) : List Instr :=
  dupTopValuesSource returnCount ++
    (storeCode ++ dropUnderTemps 0 calleeFrameSize)

def callLetCleanupCode (returnCount calleeRestSize : Nat) :
    List Instr :=
  dropUnderTemps returnCount calleeRestSize

def reverseTopValuesCode (count : Nat) : List Instr :=
  dupTopValuesSource count ++ dropUnderTemps count count

def execTerm : Term -> TargetState -> Config
  | Term.jump label, target => Config.at label target
  | Term.branchNZ thenLabel elseLabel, target =>
      match target.stack with
      | Atom.word value :: rest =>
          if norm value = 0 then
            Config.at elseLabel { target with stack := rest }
          else
            Config.at thenLabel { target with stack := rest }
      | _ => Config.stuck thenLabel target
  | Term.branchEq expected thenLabel elseLabel, target =>
      match target.stack with
      | Atom.word value :: _ =>
          if norm value = norm expected then
            Config.at thenLabel target
          else
            Config.at elseLabel target
      | _ => Config.stuck thenLabel target
  | Term.call _ _ _ returnLabel, target => Config.stuck returnLabel target
  | Term.halt, target => Config.halted target

def execTermWithCalls (callSem : CallSem) (fuel : Nat) :
    Term -> TargetState -> Config
  | Term.call fnName argCount retCount returnLabel, target =>
      match popArgWords argCount target.stack with
      | some (args, stack') =>
          match callSem fuel fnName args target.state with
          | some (returns, state') =>
              if returns.length = retCount then
                Config.at returnLabel
                  { target with
                    stack := pushReturnWords returns stack'
                    state := state' }
              else Config.stuck returnLabel target
          | none => Config.stuck returnLabel target
      | none => Config.stuck returnLabel target
  | term, target => execTerm term target

def Term.CallFree : Term -> Prop
  | Term.call _ _ _ _ => False
  | _ => True

def Program.CallFree (program : Program) : Prop :=
  ∀ {label block}, lookupBlock? program label = some block ->
    block.term.CallFree

theorem execTermWithCalls_eq_execTerm_of_callFree
    {callSem : CallSem} {fuel : Nat} {term : Term}
    {target : TargetState}
    (hCallFree : term.CallFree) :
    execTermWithCalls callSem fuel term target = execTerm term target := by
  cases term <;> simp [Term.CallFree] at hCallFree
  all_goals rfl

theorem execTermWithCalls_call_success
    {callSem : CallSem} {fuel : Nat} {fnName : ConcreteYul.Name}
    {argCount retCount : Nat} {returnLabel : Label}
    {target : TargetState} {args returns : List Word}
    {stack' : Stack} {state' : ConcreteYul.State}
    (hPop : popArgWords argCount target.stack = some (args, stack'))
    (hCall :
      callSem fuel fnName args target.state = some (returns, state'))
    (hLen : returns.length = retCount) :
    execTermWithCalls callSem fuel
        (Term.call fnName argCount retCount returnLabel) target =
      Config.at returnLabel
        { target with
          stack := pushReturnWords returns stack'
          state := state' } := by
  simp [execTermWithCalls, hPop, hCall, hLen]

def step (program : Program) : Config -> Config
  | Config.at label target =>
      match lookupBlock? program label with
      | none => Config.stuck label target
      | some block =>
          match execList block.body target with
          | some target' => execTerm block.term target'
          | none => Config.stuck label target
  | config => config

def stepWithCalls (callSem : CallSem) (fuel : Nat)
    (program : Program) : Config -> Config
  | Config.at label target =>
      match lookupBlock? program label with
      | none => Config.stuck label target
      | some block =>
          match execList block.body target with
          | some target' => execTermWithCalls callSem fuel block.term target'
          | none => Config.stuck label target
  | config => config

theorem stepWithCalls_eq_step_of_callFree_at
    {callSem : CallSem} {fuel : Nat} {program : Program}
    {label : Label} {target : TargetState} {block : Block}
    (hLookup : lookupBlock? program label = some block)
    (hCallFree : block.term.CallFree) :
    stepWithCalls callSem fuel program (Config.at label target) =
      step program (Config.at label target) := by
  simp [stepWithCalls, step, hLookup]
  cases hExec : execList block.body target with
  | none =>
      rfl
  | some target' =>
      exact execTermWithCalls_eq_execTerm_of_callFree hCallFree

theorem stepWithCalls_eq_step_of_callFree
    {callSem : CallSem} {fuel : Nat} {program : Program}
    (hProgram : Program.CallFree program) (config : Config) :
    stepWithCalls callSem fuel program config = step program config := by
  cases config with
  | «at» label target =>
      cases hLookup : lookupBlock? program label with
      | none =>
          simp [stepWithCalls, step, hLookup]
      | some block =>
          exact
            stepWithCalls_eq_step_of_callFree_at hLookup
              (hProgram hLookup)
  | halted target =>
      rfl
  | stuck label target =>
      rfl

inductive Reaches (program : Program) : Config -> Config -> Prop where
  | refl (config : Config) : Reaches program config config
  | step {start next finish : Config} :
      step program start = next ->
      Reaches program next finish ->
      Reaches program start finish

inductive ReachesWithCalls (callSem : CallSem) (fuel : Nat)
    (program : Program) : Config -> Config -> Prop where
  | refl (config : Config) :
      ReachesWithCalls callSem fuel program config config
  | step {start next finish : Config} :
      stepWithCalls callSem fuel program start = next ->
      ReachesWithCalls callSem fuel program next finish ->
      ReachesWithCalls callSem fuel program start finish

theorem reaches_one {program : Program} {start finish : Config}
    (h : step program start = finish) :
    Reaches program start finish :=
  Reaches.step h (Reaches.refl finish)

theorem reachesWithCalls_one
    {callSem : CallSem} {fuel : Nat} {program : Program}
    {start finish : Config}
    (h : stepWithCalls callSem fuel program start = finish) :
    ReachesWithCalls callSem fuel program start finish :=
  ReachesWithCalls.step h (ReachesWithCalls.refl finish)

theorem reaches_trans {program : Program} {start middle finish : Config}
    (hFirst : Reaches program start middle)
    (hSecond : Reaches program middle finish) :
    Reaches program start finish := by
  induction hFirst with
  | refl _ =>
      exact hSecond
  | step hStep _ ih =>
      exact Reaches.step hStep (ih hSecond)

theorem reachesWithCalls_trans
    {callSem : CallSem} {fuel : Nat} {program : Program}
    {start middle finish : Config}
    (hFirst : ReachesWithCalls callSem fuel program start middle)
    (hSecond : ReachesWithCalls callSem fuel program middle finish) :
    ReachesWithCalls callSem fuel program start finish := by
  induction hFirst with
  | refl _ =>
      exact hSecond
  | step hStep _ ih =>
      exact ReachesWithCalls.step hStep (ih hSecond)

theorem reachesWithCalls_of_reaches_callFree
    {callSem : CallSem} {fuel : Nat} {program : Program}
    {start finish : Config}
    (hProgram : Program.CallFree program)
    (hReach : Reaches program start finish) :
    ReachesWithCalls callSem fuel program start finish := by
  induction hReach with
  | refl config =>
      exact ReachesWithCalls.refl config
  | step hStep _ ih =>
      exact
        ReachesWithCalls.step
          (by rw [stepWithCalls_eq_step_of_callFree hProgram, hStep])
          ih

theorem step_of_extends_at
    {base extended : Program} {label : Label} {target : TargetState}
    {block : Block}
    (hExtends : Program.Extends base extended)
    (hLookup : lookupBlock? base label = some block) :
    step extended (Config.at label target) =
      step base (Config.at label target) := by
  simp [step, hLookup, hExtends hLookup]

theorem reaches_one_of_extends_at
    {base extended : Program} {label : Label} {target : TargetState}
    {block : Block} {finish : Config}
    (hExtends : Program.Extends base extended)
    (hLookup : lookupBlock? base label = some block)
    (hStep : step base (Config.at label target) = finish) :
    Reaches extended (Config.at label target) finish := by
  apply reaches_one
  rw [step_of_extends_at hExtends hLookup]
  exact hStep

theorem execList_append (first second : List Instr) (target : TargetState) :
    execList (first ++ second) target =
      match execList first target with
      | some target' => execList second target'
      | none => none := by
  induction first generalizing target with
  | nil =>
      rfl
  | cons instr rest ih =>
      simp [execList]
      cases hInstr : execInstr instr target <;> simp [ih]

theorem codeDepthAfter?_append
    {left right : List Instr} {start middle finish : Nat}
    (hLeft : codeDepthAfter? left start = some middle)
    (hRight : codeDepthAfter? right middle = some finish) :
    codeDepthAfter? (left ++ right) start = some finish := by
  induction left generalizing start with
  | nil =>
      simp [codeDepthAfter?] at hLeft
      cases hLeft
      exact hRight
  | cons instr rest ih =>
      simp [codeDepthAfter?] at hLeft ⊢
      cases hInstr : instrDepthAfter? instr start with
      | none =>
          simp [hInstr] at hLeft
      | some depth =>
          simp [hInstr] at hLeft ⊢
          exact ih hLeft

theorem blockDepthAfter?_jump_of_codeDepthAfter
    {body : List Instr} {target : Label} {start finish : Nat}
    (hBody : codeDepthAfter? body start = some finish) :
    blockDepthAfter? { body := body, term := Term.jump target } start =
      some finish := by
  simp [blockDepthAfter?, hBody, termDepthAfter?]

theorem blockDepthAfter?_halt_of_codeDepthAfter
    {body : List Instr} {start finish : Nat}
    (hBody : codeDepthAfter? body start = some finish) :
    blockDepthAfter? { body := body, term := Term.halt } start =
      some finish := by
  simp [blockDepthAfter?, hBody, termDepthAfter?]

theorem blockDepthAfterWithTargets?_jump_of_codeDepthAfter
    {depthOf : DepthEnv} {body : List Instr} {target : Label}
    {start finish : Nat}
    (hBody : codeDepthAfter? body start = some finish)
    (hTarget : depthOf target = some finish) :
    blockDepthAfterWithTargets? depthOf
        { body := body, term := Term.jump target } start =
      some finish := by
  simp [blockDepthAfterWithTargets?, hBody,
    termDepthAfterWithTargets?, hTarget]

theorem blockDepthAfterWithTargets?_halt_of_codeDepthAfter
    {depthOf : DepthEnv} {body : List Instr} {start finish : Nat}
    (hBody : codeDepthAfter? body start = some finish) :
    blockDepthAfterWithTargets? depthOf
        { body := body, term := Term.halt } start =
      some finish := by
  simp [blockDepthAfterWithTargets?, hBody, termDepthAfterWithTargets?]

theorem blockDepthAfterWithTargets?_branchNZ_of_codeDepthAfter
    {depthOf : DepthEnv} {body : List Instr}
    {thenLabel elseLabel : Label} {start branchInput branchDepth : Nat}
    (hBody : codeDepthAfter? body start = some branchInput)
    (hPos : 0 < branchInput)
    (hBranchDepth : branchInput - 1 = branchDepth)
    (hThen : depthOf thenLabel = some branchDepth)
    (hElse : depthOf elseLabel = some branchDepth) :
    blockDepthAfterWithTargets? depthOf
        { body := body, term := Term.branchNZ thenLabel elseLabel }
        start =
      some branchDepth := by
  subst branchDepth
  simp [blockDepthAfterWithTargets?, hBody, termDepthAfterWithTargets?,
    hPos, hThen, hElse]

theorem blockDepthAfterWithTargets?_branchEq_of_codeDepthAfter
    {depthOf : DepthEnv} {body : List Instr}
    {expected : Word} {thenLabel elseLabel : Label}
    {start branchDepth : Nat}
    (hBody : codeDepthAfter? body start = some branchDepth)
    (hPos : 0 < branchDepth)
    (hThen : depthOf thenLabel = some branchDepth)
    (hElse : depthOf elseLabel = some branchDepth) :
    blockDepthAfterWithTargets? depthOf
        { body := body
          term := Term.branchEq expected thenLabel elseLabel }
        start =
      some branchDepth := by
  simp [blockDepthAfterWithTargets?, hBody, termDepthAfterWithTargets?,
    hPos, hThen, hElse]

theorem blockDepthAfterWithTargets?_call_of_codeDepthAfter
    {depthOf : DepthEnv} {body : List Instr}
    {fnName : ConcreteYul.Name} {argCount retCount returnLabel : Nat}
    {start callDepth returnDepth : Nat}
    (hBody : codeDepthAfter? body start = some callDepth)
    (hLe : argCount ≤ callDepth)
    (hReturnDepth : callDepth - argCount + retCount = returnDepth)
    (hReturnLabel : depthOf returnLabel = some returnDepth) :
    blockDepthAfterWithTargets? depthOf
        { body := body
          term := Term.call fnName argCount retCount returnLabel }
        start =
      some returnDepth := by
  subst returnDepth
  simp [blockDepthAfterWithTargets?, hBody, termDepthAfterWithTargets?,
    hLe, hReturnLabel]

theorem execList_popN_frameOfSlots
    (pref base : List ConcreteYul.Name) (env : ConcreteYul.Env)
    (tail : Stack) (target : TargetState) :
    execList (popN pref.length)
        { target with
          stack := frameOfSlots pref env ++ frameOfSlots base env ++ tail } =
      some { target with stack := frameOfSlots base env ++ tail } := by
  induction pref with
  | nil =>
      rfl
  | cons name rest ih =>
      simpa [popN, frameOfSlots, execList, execInstr, List.append_assoc]
        using ih

theorem codeDepthAfter?_popN {count depth : Nat}
    (hLe : count ≤ depth) :
    codeDepthAfter? (popN count) depth = some (depth - count) := by
  induction count generalizing depth with
  | zero =>
      simp [popN, codeDepthAfter?]
  | succ count ih =>
      cases depth with
      | zero =>
          omega
      | succ depth =>
          have hCountLe : count ≤ depth := Nat.succ_le_succ_iff.mp hLe
          simp [popN, codeDepthAfter?, instrDepthAfter?]
          simpa [Nat.succ_sub_succ_eq_sub] using ih hCountLe

theorem removeAt?_append_right_length {α : Type}
    (left : List α) {right right' : List α} {index : Nat}
    (h : removeAt? right index = some right') :
    removeAt? (left ++ right) (left.length + index) =
      some (left ++ right') := by
  induction left generalizing index right right' with
  | nil =>
      simpa using h
  | cons head rest ih =>
      simp [removeAt?, Nat.succ_add]
      rw [ih h]

theorem removeAt?_append_right_zero {α : Type}
    (left : List α) (head : α) (right : List α) :
    removeAt? (left ++ head :: right) left.length =
      some (left ++ right) := by
  induction left with
  | nil =>
      rfl
  | cons value rest ih =>
      simp [removeAt?]
      rw [ih]

theorem execList_dropUnderTemps
    (temps dropped rest : Stack) (target : TargetState) :
    execList (dropUnderTemps temps.length dropped.length)
        { target with stack := temps ++ dropped ++ rest } =
      some { target with stack := temps ++ rest } := by
  induction dropped generalizing temps with
  | nil =>
      simp [dropUnderTemps, execList]
  | cons atom remaining ih =>
      simp [dropUnderTemps, execList, execInstr]
      rw [removeAt?_append_right_zero temps atom (remaining ++ rest)]
      simpa [List.append_assoc] using ih temps

theorem codeDepthAfter?_dropUnderTemps
    {tempCount dropped depth : Nat}
    (hLe : tempCount + dropped ≤ depth) :
    codeDepthAfter? (dropUnderTemps tempCount dropped) depth =
      some (depth - dropped) := by
  induction dropped generalizing depth with
  | zero =>
      simp [dropUnderTemps, codeDepthAfter?]
  | succ dropped ih =>
      have hPos : tempCount < depth := by omega
      have hLeTail : tempCount + dropped ≤ depth - 1 := by omega
      simp [dropUnderTemps, codeDepthAfter?, instrDepthAfter?, hPos]
      simpa [Nat.sub_sub, Nat.add_comm, Nat.add_left_comm, Nat.add_assoc]
        using ih hLeTail

theorem get?_append_right_length {α : Type} (left right : List α)
    (index : Nat) :
    (left ++ right)[left.length + index]? = right[index]? := by
  induction left generalizing index with
  | nil =>
      simp
  | cons _ rest ih =>
      simpa [Nat.succ_add] using ih index

theorem get?_dupTopValuesSource_index
    (copied : Stack) (head : Atom) (remaining tail : Stack) :
    ((copied.reverse ++ copied ++ head :: remaining ++ tail)[copied.length + copied.length]?) =
      some head := by
  have hGet :
      ((copied.reverse ++ (copied ++ head :: remaining ++ tail))[copied.reverse.length + copied.length]?) =
        some head := by
    rw [get?_append_right_length copied.reverse
      (copied ++ head :: remaining ++ tail) copied.length]
    simp
  rw [show copied.length + copied.length =
      copied.reverse.length + copied.length by simp]
  simp [List.append_assoc] at hGet ⊢

theorem execList_dupTopValuesSourceAux
    (copied remaining tail : Stack) (target : TargetState) :
    execList
        (dupTopValuesSourceAux copied.length remaining.length)
        { target with
          stack := copied.reverse ++ copied ++ remaining ++ tail } =
      some
        { target with
          stack := (copied ++ remaining).reverse ++
            copied ++ remaining ++ tail } := by
  induction remaining generalizing copied with
  | nil =>
      simp [dupTopValuesSourceAux, execList]
  | cons head rest ih =>
      simp [dupTopValuesSourceAux, execList, execInstr]
      simpa [List.append_assoc] using ih (copied ++ [head])

theorem codeDepthAfter?_dupTopValuesSourceAux
    {copied remaining depth : Nat}
    (hLe : copied + copied + remaining ≤ depth) :
    codeDepthAfter? (dupTopValuesSourceAux copied remaining) depth =
      some (depth + remaining) := by
  induction remaining generalizing copied depth with
  | zero =>
      simp [dupTopValuesSourceAux, codeDepthAfter?]
  | succ remaining ih =>
      have hIndex : copied + copied < depth := by omega
      have hTail :
          (copied + 1) + (copied + 1) + remaining ≤ depth + 1 := by
        omega
      simp [dupTopValuesSourceAux, codeDepthAfter?, instrDepthAfter?,
        hIndex]
      have hIH := ih hTail
      simpa [Nat.add_comm, Nat.add_left_comm, Nat.add_assoc] using hIH

theorem execList_dupTopValuesSource
    (values tail : Stack) (target : TargetState) :
    execList (dupTopValuesSource values.length)
        { target with stack := values ++ tail } =
      some
        { target with stack := values.reverse ++ values ++ tail } := by
  simpa [dupTopValuesSource] using
    execList_dupTopValuesSourceAux ([] : Stack) values tail target

theorem codeDepthAfter?_dupTopValuesSource {count depth : Nat}
    (hLe : count ≤ depth) :
    codeDepthAfter? (dupTopValuesSource count) depth =
      some (depth + count) := by
  simpa [dupTopValuesSource] using
    (codeDepthAfter?_dupTopValuesSourceAux (copied := 0)
      (remaining := count) (depth := depth) (by omega))

theorem execList_reverseTopValuesCode
    (values tail : Stack) (target : TargetState) :
    execList (reverseTopValuesCode values.length)
        { target with stack := values ++ tail } =
      some { target with stack := values.reverse ++ tail } := by
  have hDup :=
    execList_dupTopValuesSource values tail target
  have hDrop :=
    execList_dropUnderTemps values.reverse values tail target
  rw [reverseTopValuesCode, execList_append]
  rw [hDup]
  simpa [List.length_reverse] using hDrop

theorem codeDepthAfter?_reverseTopValuesCode {count depth : Nat}
    (hLe : count ≤ depth) :
    codeDepthAfter? (reverseTopValuesCode count) depth = some depth := by
  rw [reverseTopValuesCode]
  have hDup :=
    codeDepthAfter?_dupTopValuesSource (count := count) (depth := depth) hLe
  have hDrop :=
    codeDepthAfter?_dropUnderTemps (tempCount := count) (dropped := count)
      (depth := depth + count) (by omega)
  exact codeDepthAfter?_append hDup (by simpa using hDrop)

theorem get?_append_of_get?_some {α : Type} (left right : List α)
    {index : Nat} {value : α}
    (h : left[index]? = some value) :
    (left ++ right)[index]? = some value := by
  induction left generalizing index with
  | nil =>
      cases index <;> simp at h
  | cons _ rest ih =>
      cases index with
      | zero =>
          simpa using h
      | succ index =>
          simp at h
          simpa using ih h

theorem replaceAt?_append_of_left {α : Type}
    {left left' right : List α} {index : Nat} {value : α}
    (h : replaceAt? left index value = some left') :
    replaceAt? (left ++ right) index value = some (left' ++ right) := by
  induction left generalizing index left' with
  | nil =>
      cases index <;> simp [replaceAt?] at h
  | cons head rest ih =>
      cases index with
      | zero =>
          simp [replaceAt?] at h
          cases h
          rfl
      | succ index =>
          simp [replaceAt?] at h
          cases hRest : replaceAt? rest index value with
          | none =>
              simp [hRest] at h
          | some rest' =>
              simp [hRest] at h
              cases h
              simp [replaceAt?, ih hRest]

theorem replaceAt?_append_right_length {α : Type}
    (left : List α) {right right' : List α} {index : Nat}
    {value : α}
    (h : replaceAt? right index value = some right') :
    replaceAt? (left ++ right) (left.length + index) value =
      some (left ++ right') := by
  induction left generalizing index right right' with
  | nil =>
      simpa using h
  | cons head rest ih =>
      simp [replaceAt?, Nat.succ_add]
      rw [ih h]

theorem frameOfSlots_get?_of_index?
    {slots : List ConcreteYul.Name} {env : ConcreteYul.Env}
    {name : ConcreteYul.Name} {index : Nat} {value : Word}
    (hIndex : indexOf? slots name = some index)
    (hLookup : ConcreteYul.lookup? env name = some value) :
    (frameOfSlots slots env)[index]? = some (Atom.word value) := by
  induction slots generalizing index with
  | nil =>
      simp [indexOf?] at hIndex
  | cons candidate rest ih =>
      by_cases hName : candidate = name
      · subst candidate
        simp [indexOf?] at hIndex
        cases hIndex
        simp [frameOfSlots, hLookup]
      · simp [indexOf?, hName] at hIndex
        cases hRest : indexOf? rest name with
        | none =>
            simp [hRest] at hIndex
        | some restIndex =>
            simp [hRest] at hIndex
            cases hIndex
            simp [frameOfSlots, ih hRest]

theorem frameOfSlots_append
    (left right : List ConcreteYul.Name) (env : ConcreteYul.Env) :
    frameOfSlots (left ++ right) env =
      frameOfSlots left env ++ frameOfSlots right env := by
  induction left with
  | nil =>
      rfl
  | cons name rest ih =>
      simp [frameOfSlots, ih]

structure StackRel (layout : Layout) (source : ConcreteYul.Config)
    (temps tail : Stack) (target : TargetState) : Prop where
  state_eq : target.state = source.state
  stack_eq : target.stack = temps ++ frameOf layout source.env ++ tail
  bound : layout.Bound source.env

theorem stack_get?_of_layout_index
    {layout : Layout} {source : ConcreteYul.Config}
    {temps tail : Stack} {target : TargetState}
    {name : ConcreteYul.Name} {index : Nat} {value : Word}
    (hRel : StackRel layout source temps tail target)
    (hIndex : layout.index? name = some index)
    (hLookup : ConcreteYul.lookup? source.env name = some value) :
    target.stack[temps.length + index]? = some (Atom.word value) := by
  rw [hRel.stack_eq]
  rw [List.append_assoc]
  rw [get?_append_right_length temps (frameOf layout source.env ++ tail) index]
  exact
    get?_append_of_get?_some (frameOf layout source.env) tail
      (by
        exact frameOfSlots_get?_of_index?
          (slots := layout.slots) (env := source.env)
          (name := name) (index := index) (value := value)
          hIndex hLookup)

theorem stackRel_drop_word_temp
    {layout : Layout} {source : ConcreteYul.Config}
    {value : Word} {tail : Stack} {target : TargetState} :
    StackRel layout source [Atom.word value] tail target ->
    StackRel layout source [] tail
      { target with stack := frameOf layout source.env ++ tail } := by
  intro hRel
  exact
    { state_eq := hRel.state_eq
      stack_eq := by simp
      bound := hRel.bound }

def compileExprAt (layout : Layout) (tempDepth : Nat) :
    ConcreteYul.Expr -> Option (List Instr)
  | ConcreteYul.Expr.word value => some [Instr.pushWord value]
  | ConcreteYul.Expr.var name =>
      match layout.index? name with
      | some index => some [Instr.dup (tempDepth + index)]
      | none => none
  | ConcreteYul.Expr.builtin _ _ => none
  | ConcreteYul.Expr.dataSize _ => none
  | ConcreteYul.Expr.dataOffset _ => none

def compileExprsAt (layout : Layout) : Nat ->
    List ConcreteYul.Expr -> Option (List Instr)
  | _, [] => some []
  | tempDepth, expr :: rest =>
      match compileExprAt layout tempDepth expr,
          compileExprsAt layout (tempDepth + 1) rest with
      | some code, some restCode =>
          some (code ++ [Instr.normTop] ++ restCode)
      | _, _ => none

def compileExprsSourceAt (layout : Layout) : Nat ->
    List ConcreteYul.Expr -> Option (List Instr)
  | _, [] => some []
  | tempDepth, expr :: rest =>
      match compileExprsSourceAt layout tempDepth rest,
          compileExprAt layout (tempDepth + rest.length) expr with
      | some restCode, some code =>
          some (restCode ++ code ++ [Instr.normTop])
      | _, _ => none

theorem compileExprAt_codeDepthAfter
    {layout : Layout} {tempDepth : Nat} {expr : ConcreteYul.Expr}
    {code : List Instr} {tailDepth : Nat}
    (hCompile : compileExprAt layout tempDepth expr = some code) :
    codeDepthAfter? code (tempDepth + layout.slots.length + tailDepth) =
      some (tempDepth + layout.slots.length + tailDepth + 1) := by
  cases expr with
  | word value =>
      simp [compileExprAt] at hCompile
      cases hCompile
      simp [codeDepthAfter?, instrDepthAfter?]
  | var name =>
      simp [compileExprAt] at hCompile
      cases hIndex : layout.index? name with
      | none =>
          simp [hIndex] at hCompile
      | some index =>
          simp [hIndex] at hCompile
          cases hCompile
          have hLt : index < layout.slots.length :=
            indexOf?_lt_length hIndex
          have hDepth :
              tempDepth + index <
                tempDepth + layout.slots.length + tailDepth := by
            omega
          simp [codeDepthAfter?, instrDepthAfter?, hDepth]
  | builtin builtin args =>
      simp [compileExprAt] at hCompile
  | dataSize label =>
      simp [compileExprAt] at hCompile
  | dataOffset label =>
      simp [compileExprAt] at hCompile

theorem compileExprsAt_codeDepthAfter
    {layout : Layout} {tempDepth : Nat}
    {exprs : List ConcreteYul.Expr} {code : List Instr}
    {tailDepth : Nat}
    (hCompile : compileExprsAt layout tempDepth exprs = some code) :
    codeDepthAfter? code (tempDepth + layout.slots.length + tailDepth) =
      some (tempDepth + layout.slots.length + tailDepth + exprs.length) := by
  induction exprs generalizing tempDepth code tailDepth with
  | nil =>
      simp [compileExprsAt] at hCompile
      cases hCompile
      simp [codeDepthAfter?]
  | cons expr rest ih =>
      simp [compileExprsAt] at hCompile
      cases hHead : compileExprAt layout tempDepth expr with
      | none =>
          simp [hHead] at hCompile
      | some headCode =>
          cases hRest : compileExprsAt layout (tempDepth + 1) rest with
          | none =>
              simp [hHead, hRest] at hCompile
          | some restCode =>
              simp [hHead, hRest] at hCompile
              cases hCompile
              have hHeadDepth :=
                compileExprAt_codeDepthAfter (tailDepth := tailDepth)
                  hHead
              have hNorm :
                  codeDepthAfter? [Instr.normTop]
                    (tempDepth + layout.slots.length + tailDepth + 1) =
                    some
                      (tempDepth + layout.slots.length + tailDepth + 1) := by
                simp [codeDepthAfter?, instrDepthAfter?]
              have hRestDepth :=
                ih (tempDepth := tempDepth + 1) (tailDepth := tailDepth)
                  hRest
              have hRestDepth' :
                  codeDepthAfter? restCode
                    (tempDepth + layout.slots.length + tailDepth + 1) =
                    some
                      (tempDepth + layout.slots.length + tailDepth + 1 +
                        rest.length) := by
                simpa [Nat.add_comm, Nat.add_left_comm, Nat.add_assoc]
                  using hRestDepth
              have hHeadNorm := codeDepthAfter?_append hHeadDepth hNorm
              have hAll := codeDepthAfter?_append hHeadNorm hRestDepth'
              simpa [Nat.add_comm, Nat.add_left_comm, Nat.add_assoc]
                using hAll

theorem compileExprsSourceAt_codeDepthAfter
    {layout : Layout} {tempDepth : Nat}
    {exprs : List ConcreteYul.Expr} {code : List Instr}
    {tailDepth : Nat}
    (hCompile : compileExprsSourceAt layout tempDepth exprs = some code) :
    codeDepthAfter? code (tempDepth + layout.slots.length + tailDepth) =
      some (tempDepth + layout.slots.length + tailDepth + exprs.length) := by
  induction exprs generalizing tempDepth code tailDepth with
  | nil =>
      simp [compileExprsSourceAt] at hCompile
      cases hCompile
      simp [codeDepthAfter?]
  | cons expr rest ih =>
      simp [compileExprsSourceAt] at hCompile
      cases hRest : compileExprsSourceAt layout tempDepth rest with
      | none =>
          simp [hRest] at hCompile
      | some restCode =>
          cases hHead :
              compileExprAt layout (tempDepth + rest.length) expr with
          | none =>
              simp [hRest, hHead] at hCompile
          | some headCode =>
              simp [hRest, hHead] at hCompile
              cases hCompile
              have hRestDepth :=
                ih (tempDepth := tempDepth) (tailDepth := tailDepth) hRest
              have hHeadDepth :=
                compileExprAt_codeDepthAfter (layout := layout)
                  (tempDepth := tempDepth + rest.length)
                  (tailDepth := tailDepth) hHead
              have hHeadDepth' :
                  codeDepthAfter? headCode
                    (tempDepth + layout.slots.length + tailDepth +
                      rest.length) =
                    some
                      (tempDepth + layout.slots.length + tailDepth +
                        rest.length + 1) := by
                simpa [Nat.add_comm, Nat.add_left_comm, Nat.add_assoc]
                  using hHeadDepth
              have hNorm :
                  codeDepthAfter? [Instr.normTop]
                    (tempDepth + layout.slots.length + tailDepth +
                      rest.length + 1) =
                    some
                      (tempDepth + layout.slots.length + tailDepth +
                        rest.length + 1) := by
                simp [codeDepthAfter?, instrDepthAfter?]
              have hRestHead :=
                codeDepthAfter?_append hRestDepth hHeadDepth'
              have hAll := codeDepthAfter?_append hRestHead hNorm
              simpa [Nat.add_comm, Nat.add_left_comm, Nat.add_assoc]
                using hAll

def returnValueExprs (names : List ConcreteYul.Name) :
    List ConcreteYul.Expr :=
  names.map ConcreteYul.Expr.var

def compileReturnValuesFrom (layout : Layout)
    (names : List ConcreteYul.Name) : Option (List Instr) :=
  compileExprsSourceAt layout 0 (returnValueExprs names)

theorem compileReturnValuesFrom_codeDepthAfter
    {layout : Layout} {names : List ConcreteYul.Name}
    {code : List Instr} {tailDepth : Nat}
    (hCompile : compileReturnValuesFrom layout names = some code) :
    codeDepthAfter? code (layout.slots.length + tailDepth) =
      some (layout.slots.length + tailDepth + names.length) := by
  have hDepth :=
    compileExprsSourceAt_codeDepthAfter
      (layout := layout) (tempDepth := 0)
      (exprs := returnValueExprs names) (code := code)
      (tailDepth := tailDepth)
      (by simpa [compileReturnValuesFrom] using hCompile)
  simpa [returnValueExprs] using hDepth

def exprProgram (code : List Instr) : Program :=
  [(0, { body := code, term := Term.halt })]

def compileExprStmtAt (layout : Layout) (expr : ConcreteYul.Expr) :
    Option (List Instr) :=
  (compileExprAt layout 0 expr).map (fun code => code ++ [Instr.pop])

theorem compileExprStmtAt_codeDepthAfter
    {layout : Layout} {expr : ConcreteYul.Expr}
    {code : List Instr} {tailDepth : Nat}
    (hCompile : compileExprStmtAt layout expr = some code) :
    codeDepthAfter? code (layout.slots.length + tailDepth) =
      some (layout.slots.length + tailDepth) := by
  simp [compileExprStmtAt] at hCompile
  cases hExprCode : compileExprAt layout 0 expr with
  | none =>
      simp [hExprCode] at hCompile
  | some exprCode =>
      simp [hExprCode] at hCompile
      cases hCompile
      have hExprDepth :=
        compileExprAt_codeDepthAfter (layout := layout) (tempDepth := 0)
          (tailDepth := tailDepth) hExprCode
      have hExprDepth' :
          codeDepthAfter? exprCode (layout.slots.length + tailDepth) =
            some (layout.slots.length + tailDepth + 1) := by
        simpa using hExprDepth
      have hPop :
          codeDepthAfter? [Instr.pop] (layout.slots.length + tailDepth + 1) =
            some (layout.slots.length + tailDepth) := by
        simp [codeDepthAfter?, instrDepthAfter?]
      exact codeDepthAfter?_append hExprDepth' hPop

def compileStmtAt (layout : Layout) :
    ConcreteYul.Stmt -> Option (List Instr)
  | ConcreteYul.Stmt.skip => some []
  | ConcreteYul.Stmt.expr expr => compileExprStmtAt layout expr
  | ConcreteYul.Stmt.let1 _ _ => none
  | ConcreteYul.Stmt.letMany _ _ => none
  | ConcreteYul.Stmt.funDef _ _ _ _ => some []
  | ConcreteYul.Stmt.assign _ _ => none
  | ConcreteYul.Stmt.assignMany _ _ => none
  | ConcreteYul.Stmt.letCall _ _ _ => none
  | ConcreteYul.Stmt.assignCall _ _ _ => none
  | ConcreteYul.Stmt.seq _ _ => none
  | ConcreteYul.Stmt.block _ => none
  | ConcreteYul.Stmt.ifThen _ _ => none
  | ConcreteYul.Stmt.switch _ _ _ => none
  | ConcreteYul.Stmt.forLoop _ _ _ _ => none
  | ConcreteYul.Stmt.break => none
  | ConcreteYul.Stmt.continue => none
  | ConcreteYul.Stmt.leave => none

def extendLayout (layout : Layout) (name : ConcreteYul.Name) : Layout :=
  { slots := name :: layout.slots }

structure Codegen where
  code : List Instr
  outLayout : Layout
  deriving DecidableEq, Repr

structure CfgCodegen where
  program : Program
  outLayout : Layout
  deriving DecidableEq, Repr

structure OpenCfgCodegen where
  program : Program
  outLayout : Layout
  nextLabel : Label
  deriving DecidableEq, Repr

structure ControlDest where
  breakLabel : Label := 0
  continueLabel : Label := 0
  leaveLabel : Label := 0
  deriving DecidableEq, Repr

structure ExitTarget where
  label : Label
  layout : Layout
  deriving DecidableEq, Repr

structure ControlCtx where
  breakTarget? : Option ExitTarget := none
  continueTarget? : Option ExitTarget := none
  leaveTarget? : Option ExitTarget := none
  deriving DecidableEq, Repr

def ControlCtx.empty : ControlCtx := {}

def ControlCtx.fromDest (dest : ControlDest) (layout : Layout) :
    ControlCtx :=
  { breakTarget? := some { label := dest.breakLabel, layout := layout }
    continueTarget? :=
      some { label := dest.continueLabel, layout := layout }
    leaveTarget? := some { label := dest.leaveLabel, layout := layout } }

def ControlCtx.fromDestLayouts (dest : ControlDest)
    (breakLayout continueLayout leaveLayout : Layout) : ControlCtx :=
  { breakTarget? := some { label := dest.breakLabel, layout := breakLayout }
    continueTarget? :=
      some { label := dest.continueLabel, layout := continueLayout }
    leaveTarget? :=
      some { label := dest.leaveLabel, layout := leaveLayout } }

def ControlCtx.functionReturn (returnLabel : Label) (layout : Layout) :
    ControlCtx :=
  { leaveTarget? := some { label := returnLabel, layout := layout } }

def ControlCtx.withLoopTargets (ctx : ControlCtx)
    (breakTarget continueTarget : ExitTarget) : ControlCtx :=
  { breakTarget? := some breakTarget
    continueTarget? := some continueTarget
    leaveTarget? := ctx.leaveTarget? }

def ControlCtx.withLoopLabels (ctx : ControlCtx)
    (breakLabel continueLabel : Label)
    (breakLayout continueLayout : Layout) : ControlCtx :=
  ctx.withLoopTargets
    { label := breakLabel, layout := breakLayout }
    { label := continueLabel, layout := continueLayout }

theorem ControlCtx.fromDest_eq_fromDestLayouts
    (dest : ControlDest) (layout : Layout) :
    ControlCtx.fromDest dest layout =
      ControlCtx.fromDestLayouts dest layout layout layout := by
  rfl

inductive ExitsTo (normalLabel : Label) (normalLayout : Layout)
    (ctx : ControlCtx) : ConcreteYul.Flow -> ExitTarget -> Prop where
  | normal :
      ExitsTo normalLabel normalLayout ctx ConcreteYul.Flow.normal
        { label := normalLabel, layout := normalLayout }
  | broke {target : ExitTarget} :
      ctx.breakTarget? = some target ->
      ExitsTo normalLabel normalLayout ctx ConcreteYul.Flow.broke target
  | continued {target : ExitTarget} :
      ctx.continueTarget? = some target ->
      ExitsTo normalLabel normalLayout ctx ConcreteYul.Flow.continued target
  | left {target : ExitTarget} :
      ctx.leaveTarget? = some target ->
      ExitsTo normalLabel normalLayout ctx ConcreteYul.Flow.left target

structure SwitchCaseCode where
  value : Word
  code : List Instr
  deriving DecidableEq, Repr

def zeroInitCode : List ConcreteYul.Name -> List Instr
  | [] => []
  | _ :: rest => Instr.pushWord 0 :: zeroInitCode rest

def callSetupCode (argCode : List Instr)
    (returns : List ConcreteYul.Name) : List Instr :=
  argCode ++ zeroInitCode returns

def extendLayoutMany? : Layout -> List ConcreteYul.Name -> Option Layout
  | layout, [] => some layout
  | layout, name :: names =>
      match layout.index? name with
      | some _ => none
      | none => extendLayoutMany? (extendLayout layout name) names

def functionEntryLayout? (params returns : List ConcreteYul.Name) :
    Option Layout :=
  match extendLayoutMany? ({} : Layout) params with
  | none => none
  | some paramLayout => extendLayoutMany? paramLayout returns

def compileLet1From (layout : Layout) (name : ConcreteYul.Name)
    (init : Option ConcreteYul.Expr) : Option Codegen :=
  match layout.index? name with
  | some _ => none
  | none =>
      match init with
      | none =>
          some
            { code := [Instr.pushWord 0]
              outLayout := extendLayout layout name }
      | some expr =>
          match compileExprAt layout 0 expr with
          | some code =>
              some
                { code := code ++ [Instr.normTop]
                  outLayout := extendLayout layout name }
          | none => none

def compileLetManyFrom (layout : Layout) (names : List ConcreteYul.Name)
    (init : Option (List ConcreteYul.Expr)) : Option Codegen :=
  match init with
  | none =>
      match extendLayoutMany? layout names with
      | some outLayout =>
          some
            { code := zeroInitCode names
              outLayout := outLayout }
      | none => none
  | some exprs =>
      if names.length = exprs.length then
        match compileExprsAt layout 0 exprs,
            extendLayoutMany? layout names with
        | some code, some outLayout =>
            some
              { code := code
                outLayout := outLayout }
        | _, _ => none
      else none

def compileAssignFrom (layout : Layout) (name : ConcreteYul.Name)
    (expr : ConcreteYul.Expr) : Option Codegen :=
  match layout.index? name with
  | none => none
  | some index =>
      match compileExprAt layout 0 expr with
      | some code =>
          some { code := code ++ [Instr.store index], outLayout := layout }
      | none => none

def compileStoresSourceFromTop? (layout : Layout) :
    List ConcreteYul.Name -> Option (List Instr)
  | [] => some []
  | name :: rest =>
      match layout.index? name,
          compileStoresSourceFromTop? layout rest with
      | some index, some code =>
          some (Instr.store (rest.length + index) :: code)
      | _, _ => none

theorem compileStoresSourceFromTop?_codeDepthAfter
    {layout : Layout} {names : List ConcreteYul.Name}
    {code : List Instr} {tailDepth : Nat}
    (hCompile : compileStoresSourceFromTop? layout names = some code) :
    codeDepthAfter? code (names.length + layout.slots.length + tailDepth) =
      some (layout.slots.length + tailDepth) := by
  induction names generalizing code tailDepth with
  | nil =>
      simp [compileStoresSourceFromTop?] at hCompile
      cases hCompile
      simp [codeDepthAfter?]
  | cons name rest ih =>
      simp [compileStoresSourceFromTop?] at hCompile
      cases hIndex : layout.index? name with
      | none =>
          simp [hIndex] at hCompile
      | some index =>
          cases hRestCode : compileStoresSourceFromTop? layout rest with
          | none =>
              simp [hIndex, hRestCode] at hCompile
          | some restCode =>
              simp [hIndex, hRestCode] at hCompile
              cases hCompile
              have hLt : index < layout.slots.length :=
                indexOf?_lt_length hIndex
              have hStoreOk :
                  rest.length + index + 1 <
                    rest.length + 1 + layout.slots.length + tailDepth := by
                omega
              have hStoreDepth :
                  (rest.length + 1 + layout.slots.length + tailDepth) - 1 =
                    rest.length + layout.slots.length + tailDepth := by
                omega
              have hStore :
                  instrDepthAfter? (Instr.store (rest.length + index))
                      (rest.length + 1 + layout.slots.length + tailDepth) =
                    some
                      (rest.length + layout.slots.length + tailDepth) := by
                simp [instrDepthAfter?, hStoreOk, hStoreDepth]
              have hRestDepth :=
                ih (code := restCode) (tailDepth := tailDepth) hRestCode
              simpa [codeDepthAfter?, hStore] using hRestDepth

def compileStoresSourceFromTopAt? (layout : Layout) (offset : Nat) :
    List ConcreteYul.Name -> Option (List Instr)
  | [] => some []
  | name :: rest =>
      match layout.index? name,
          compileStoresSourceFromTopAt? layout offset rest with
      | some index, some code =>
          some (Instr.store (rest.length + offset + index) :: code)
      | _, _ => none

theorem compileStoresSourceFromTopAt?_codeDepthAfter
    {layout : Layout} {offset : Nat}
    {names : List ConcreteYul.Name}
    {code : List Instr} {tailDepth : Nat}
    (hCompile :
      compileStoresSourceFromTopAt? layout offset names = some code) :
    codeDepthAfter? code
        (names.length + offset + layout.slots.length + tailDepth) =
      some (offset + layout.slots.length + tailDepth) := by
  induction names generalizing code tailDepth with
  | nil =>
      simp [compileStoresSourceFromTopAt?] at hCompile
      cases hCompile
      simp [codeDepthAfter?]
  | cons name rest ih =>
      simp [compileStoresSourceFromTopAt?] at hCompile
      cases hIndex : layout.index? name with
      | none =>
          simp [hIndex] at hCompile
      | some index =>
          cases hRestCode :
              compileStoresSourceFromTopAt? layout offset rest with
          | none =>
              simp [hIndex, hRestCode] at hCompile
          | some restCode =>
              simp [hIndex, hRestCode] at hCompile
              cases hCompile
              have hLt : index < layout.slots.length :=
                indexOf?_lt_length hIndex
              have hStoreOk :
                  rest.length + offset + index + 1 <
                    rest.length + 1 + offset + layout.slots.length +
                      tailDepth := by
                omega
              have hStoreDepth :
                  (rest.length + 1 + offset + layout.slots.length +
                      tailDepth) - 1 =
                    rest.length + offset + layout.slots.length +
                      tailDepth := by
                omega
              have hStore :
                  instrDepthAfter?
                      (Instr.store (rest.length + offset + index))
                      (rest.length + 1 + offset + layout.slots.length +
                        tailDepth) =
                    some
                      (rest.length + offset + layout.slots.length +
                        tailDepth) := by
                simp [instrDepthAfter?, hStoreOk, hStoreDepth]
              have hStoreNorm :
                  instrDepthAfter?
                      (Instr.store (offset + (index + rest.length)))
                      (offset +
                        (tailDepth +
                          (rest.length + (layout.slots.length + 1)))) =
                    some
                      (offset +
                        (tailDepth +
                          (rest.length + layout.slots.length))) := by
                simpa [Nat.add_comm, Nat.add_left_comm, Nat.add_assoc]
                  using hStore
              have hRestDepth :=
                ih (code := restCode) (tailDepth := tailDepth) hRestCode
              simpa [codeDepthAfter?, hStoreNorm, Nat.add_comm,
                Nat.add_left_comm, Nat.add_assoc] using hRestDepth

theorem callAssignCleanupCode_codeDepthAfter
    {layout : Layout} {names : List ConcreteYul.Name}
    {storeCode : List Instr}
    {returnCount calleeFrameSize tailDepth : Nat}
    (hReturnFits :
      returnCount ≤ calleeFrameSize + layout.slots.length + tailDepth)
    (hNames : names.length = returnCount)
    (hStores :
      compileStoresSourceFromTopAt? layout calleeFrameSize names =
        some storeCode) :
    codeDepthAfter?
        (callAssignCleanupCode returnCount calleeFrameSize storeCode)
        (calleeFrameSize + layout.slots.length + tailDepth) =
      some (layout.slots.length + tailDepth) := by
  have hDup :
      codeDepthAfter? (dupTopValuesSource returnCount)
          (calleeFrameSize + layout.slots.length + tailDepth) =
        some
          (calleeFrameSize + layout.slots.length + tailDepth +
            returnCount) :=
    codeDepthAfter?_dupTopValuesSource
      (count := returnCount)
      (depth := calleeFrameSize + layout.slots.length + tailDepth)
      hReturnFits
  have hStoreBase :=
    compileStoresSourceFromTopAt?_codeDepthAfter
      (layout := layout) (offset := calleeFrameSize)
      (names := names) (code := storeCode) (tailDepth := tailDepth)
      hStores
  have hStore :
      codeDepthAfter? storeCode
          (calleeFrameSize + layout.slots.length + tailDepth +
            returnCount) =
        some (calleeFrameSize + layout.slots.length + tailDepth) := by
    simpa [hNames, Nat.add_comm, Nat.add_left_comm, Nat.add_assoc]
      using hStoreBase
  have hDropLe :
      0 + calleeFrameSize ≤
        calleeFrameSize + layout.slots.length + tailDepth := by
    omega
  have hDropBase :=
    codeDepthAfter?_dropUnderTemps
      (tempCount := 0) (dropped := calleeFrameSize)
      (depth := calleeFrameSize + layout.slots.length + tailDepth)
      hDropLe
  have hDropSub :
      (calleeFrameSize + layout.slots.length + tailDepth) -
          calleeFrameSize =
        layout.slots.length + tailDepth := by
    omega
  have hDrop :
      codeDepthAfter? (dropUnderTemps 0 calleeFrameSize)
          (calleeFrameSize + layout.slots.length + tailDepth) =
        some (layout.slots.length + tailDepth) := by
    simpa [hDropSub] using hDropBase
  have hStoreDrop :=
    codeDepthAfter?_append hStore hDrop
  have hAll :=
    codeDepthAfter?_append hDup hStoreDrop
  simpa [callAssignCleanupCode, Nat.add_comm, Nat.add_left_comm,
    Nat.add_assoc] using hAll

theorem callLetCleanupCode_codeDepthAfter
    {layout : Layout}
    {returnCount calleeRestSize tailDepth : Nat} :
    codeDepthAfter? (callLetCleanupCode returnCount calleeRestSize)
        (returnCount + calleeRestSize + layout.slots.length + tailDepth) =
      some (returnCount + layout.slots.length + tailDepth) := by
  have hDropLe :
      returnCount + calleeRestSize ≤
        returnCount + calleeRestSize + layout.slots.length + tailDepth := by
    omega
  have hDropBase :=
    codeDepthAfter?_dropUnderTemps
      (tempCount := returnCount) (dropped := calleeRestSize)
      (depth :=
        returnCount + calleeRestSize + layout.slots.length + tailDepth)
      hDropLe
  have hDropSub :
      (returnCount + calleeRestSize + layout.slots.length + tailDepth) -
          calleeRestSize =
        returnCount + layout.slots.length + tailDepth := by
    omega
  have hDropSubNorm :
      returnCount + (calleeRestSize + (tailDepth + layout.slots.length)) -
          calleeRestSize =
        returnCount + (tailDepth + layout.slots.length) := by
    omega
  simpa [callLetCleanupCode, hDropSub, hDropSubNorm, Nat.add_comm,
    Nat.add_left_comm,
    Nat.add_assoc] using hDropBase

def compileAssignManyFrom (layout : Layout) (names : List ConcreteYul.Name)
    (exprs : List ConcreteYul.Expr) : Option Codegen :=
  if names.length = exprs.length then
    match compileExprsSourceAt layout 0 exprs,
        compileStoresSourceFromTop? layout names with
    | some exprCode, some storeCode =>
        some
          { code := exprCode ++ storeCode
            outLayout := layout }
    | _, _ => none
  else none

theorem zeroInitCode_codeDepthAfter
    {names : List ConcreteYul.Name} {depth : Nat} :
    codeDepthAfter? (zeroInitCode names) depth =
      some (depth + names.length) := by
  induction names generalizing depth with
  | nil =>
      simp [zeroInitCode, codeDepthAfter?]
  | cons _ rest ih =>
      simp [zeroInitCode, codeDepthAfter?, instrDepthAfter?]
      simpa [Nat.add_comm, Nat.add_left_comm, Nat.add_assoc]
        using ih (depth := depth + 1)

theorem callSetupCode_codeDepthAfter
    {layout : Layout} {args : List ConcreteYul.Expr}
    {returns : List ConcreteYul.Name} {argCode : List Instr}
    {tailDepth : Nat}
    (hArgs : compileExprsSourceAt layout 0 args = some argCode) :
    codeDepthAfter? (callSetupCode argCode returns)
        (layout.slots.length + tailDepth) =
      some
        (layout.slots.length + tailDepth + args.length +
          returns.length) := by
  have hArgDepth :=
    compileExprsSourceAt_codeDepthAfter
      (layout := layout) (tempDepth := 0)
      (exprs := args) (code := argCode)
      (tailDepth := tailDepth) hArgs
  have hArgDepth' :
      codeDepthAfter? argCode (layout.slots.length + tailDepth) =
        some (layout.slots.length + tailDepth + args.length) := by
    simpa using hArgDepth
  have hZero :=
    zeroInitCode_codeDepthAfter
      (names := returns)
      (depth := layout.slots.length + tailDepth + args.length)
  have hAll := codeDepthAfter?_append hArgDepth' hZero
  simpa [callSetupCode, Nat.add_comm, Nat.add_left_comm, Nat.add_assoc]
    using hAll

theorem extendLayoutMany?_slots_length
    {layout outLayout : Layout} {names : List ConcreteYul.Name}
    (hExtend : extendLayoutMany? layout names = some outLayout) :
    outLayout.slots.length = layout.slots.length + names.length := by
  induction names generalizing layout outLayout with
  | nil =>
      simp [extendLayoutMany?] at hExtend
      cases hExtend
      simp
  | cons name rest ih =>
      simp [extendLayoutMany?] at hExtend
      cases hIndex : layout.index? name with
      | some index =>
          simp [hIndex] at hExtend
      | none =>
          cases hRest :
              extendLayoutMany? (extendLayout layout name) rest with
          | none =>
              simp [hIndex, hRest] at hExtend
          | some restLayout =>
              simp [hIndex, hRest] at hExtend
              cases hExtend
              have hRestLen :=
                ih (layout := extendLayout layout name)
                  hRest
              simp [extendLayout] at hRestLen ⊢
              omega

theorem compileLet1From_codeDepthAfter
    {layout : Layout} {name : ConcreteYul.Name}
    {init : Option ConcreteYul.Expr} {gen : Codegen}
    {tailDepth : Nat}
    (hCompile : compileLet1From layout name init = some gen) :
    codeDepthAfter? gen.code (layout.slots.length + tailDepth) =
      some (gen.outLayout.slots.length + tailDepth) := by
  cases hIndex : layout.index? name with
  | some index =>
      simp [compileLet1From, hIndex] at hCompile
  | none =>
      cases init with
      | none =>
          simp [compileLet1From, hIndex] at hCompile
          cases hCompile
          simp [codeDepthAfter?, instrDepthAfter?, extendLayout]
          omega
      | some expr =>
          simp [compileLet1From, hIndex] at hCompile
          cases hExpr : compileExprAt layout 0 expr with
          | none =>
              simp [hExpr] at hCompile
          | some exprCode =>
              simp [hExpr] at hCompile
              cases hCompile
              have hExprDepth :=
                compileExprAt_codeDepthAfter
                  (layout := layout) (tempDepth := 0)
                  (expr := expr) (code := exprCode)
                  (tailDepth := tailDepth) hExpr
              have hExprDepth' :
                  codeDepthAfter? exprCode
                      (layout.slots.length + tailDepth) =
                    some (layout.slots.length + tailDepth + 1) := by
                simpa using hExprDepth
              have hNorm :
                  codeDepthAfter? [Instr.normTop]
                      (layout.slots.length + tailDepth + 1) =
                    some (layout.slots.length + tailDepth + 1) := by
                simp [codeDepthAfter?, instrDepthAfter?]
              have hAll := codeDepthAfter?_append hExprDepth' hNorm
              simpa [extendLayout, Nat.add_comm, Nat.add_left_comm,
                Nat.add_assoc] using hAll

theorem compileLetManyFrom_codeDepthAfter
    {layout : Layout} {names : List ConcreteYul.Name}
    {init : Option (List ConcreteYul.Expr)} {gen : Codegen}
    {tailDepth : Nat}
    (hCompile : compileLetManyFrom layout names init = some gen) :
    codeDepthAfter? gen.code (layout.slots.length + tailDepth) =
      some (gen.outLayout.slots.length + tailDepth) := by
  cases init with
  | none =>
      simp [compileLetManyFrom] at hCompile
      cases hExtend : extendLayoutMany? layout names with
      | none =>
          simp [hExtend] at hCompile
      | some outLayout =>
          simp [hExtend] at hCompile
          cases hCompile
          have hZero :=
            zeroInitCode_codeDepthAfter
              (names := names)
              (depth := layout.slots.length + tailDepth)
          have hLen :=
            extendLayoutMany?_slots_length hExtend
          simpa [hLen, Nat.add_comm, Nat.add_left_comm, Nat.add_assoc]
            using hZero
  | some exprs =>
      by_cases hLen : names.length = exprs.length
      · simp [compileLetManyFrom, hLen] at hCompile
        cases hExprs : compileExprsAt layout 0 exprs with
        | none =>
            simp [hExprs] at hCompile
        | some exprCode =>
            cases hExtend : extendLayoutMany? layout names with
            | none =>
                simp [hExprs, hExtend] at hCompile
            | some outLayout =>
                simp [hExprs, hExtend] at hCompile
                cases hCompile
                have hExprDepth :=
                  compileExprsAt_codeDepthAfter
                    (layout := layout) (tempDepth := 0)
                    (exprs := exprs) (code := exprCode)
                    (tailDepth := tailDepth) hExprs
                have hOutLen :=
                  extendLayoutMany?_slots_length hExtend
                simpa [hLen, hOutLen, Nat.add_comm, Nat.add_left_comm,
                  Nat.add_assoc] using hExprDepth
      · simp [compileLetManyFrom, hLen] at hCompile

theorem compileAssignFrom_codeDepthAfter
    {layout : Layout} {name : ConcreteYul.Name}
    {expr : ConcreteYul.Expr} {gen : Codegen}
    {tailDepth : Nat}
    (hCompile : compileAssignFrom layout name expr = some gen) :
    codeDepthAfter? gen.code (layout.slots.length + tailDepth) =
      some (gen.outLayout.slots.length + tailDepth) := by
  cases hIndex : layout.index? name with
  | none =>
      simp [compileAssignFrom, hIndex] at hCompile
  | some index =>
      simp [compileAssignFrom, hIndex] at hCompile
      cases hExpr : compileExprAt layout 0 expr with
      | none =>
          simp [hExpr] at hCompile
      | some exprCode =>
          simp [hExpr] at hCompile
          cases hCompile
          have hLt : index < layout.slots.length :=
            indexOf?_lt_length hIndex
          have hExprDepth :=
            compileExprAt_codeDepthAfter
              (layout := layout) (tempDepth := 0)
              (expr := expr) (code := exprCode)
              (tailDepth := tailDepth) hExpr
          have hExprDepth' :
              codeDepthAfter? exprCode
                  (layout.slots.length + tailDepth) =
                some (layout.slots.length + tailDepth + 1) := by
            simpa using hExprDepth
          have hStoreOk :
              index + 1 < layout.slots.length + tailDepth + 1 := by
            omega
          have hStoreDepth :
              (layout.slots.length + tailDepth + 1) - 1 =
                layout.slots.length + tailDepth := by
            omega
          have hStore :
              codeDepthAfter? [Instr.store index]
                  (layout.slots.length + tailDepth + 1) =
                some (layout.slots.length + tailDepth) := by
            simp [codeDepthAfter?, instrDepthAfter?, hStoreOk,
              hStoreDepth]
          have hAll := codeDepthAfter?_append hExprDepth' hStore
          simpa using hAll

theorem compileAssignManyFrom_codeDepthAfter
    {layout : Layout} {names : List ConcreteYul.Name}
    {exprs : List ConcreteYul.Expr} {gen : Codegen}
    {tailDepth : Nat}
    (hCompile : compileAssignManyFrom layout names exprs = some gen) :
    codeDepthAfter? gen.code (layout.slots.length + tailDepth) =
      some (gen.outLayout.slots.length + tailDepth) := by
  by_cases hLen : names.length = exprs.length
  · simp [compileAssignManyFrom, hLen] at hCompile
    cases hExprs : compileExprsSourceAt layout 0 exprs with
    | none =>
        simp [hExprs] at hCompile
    | some exprCode =>
        cases hStores : compileStoresSourceFromTop? layout names with
        | none =>
            simp [hExprs, hStores] at hCompile
        | some storeCode =>
            simp [hExprs, hStores] at hCompile
            cases hCompile
            have hExprDepth :=
              compileExprsSourceAt_codeDepthAfter
                (layout := layout) (tempDepth := 0)
                (exprs := exprs) (code := exprCode)
                (tailDepth := tailDepth) hExprs
            have hExprDepth' :
                codeDepthAfter? exprCode
                    (layout.slots.length + tailDepth) =
                  some
                    (layout.slots.length + tailDepth + exprs.length) := by
              simpa using hExprDepth
            have hStoreBase :=
              compileStoresSourceFromTop?_codeDepthAfter
                (layout := layout) (names := names)
                (code := storeCode) (tailDepth := tailDepth)
                hStores
            have hStore :
                codeDepthAfter? storeCode
                    (layout.slots.length + tailDepth + exprs.length) =
                  some (layout.slots.length + tailDepth) := by
              simpa [hLen, Nat.add_comm, Nat.add_left_comm, Nat.add_assoc]
                using hStoreBase
            have hAll := codeDepthAfter?_append hExprDepth' hStore
            simpa using hAll
  · simp [compileAssignManyFrom, hLen] at hCompile

def compileStmtFrom (layout : Layout) :
    ConcreteYul.Stmt -> Option Codegen
  | ConcreteYul.Stmt.skip =>
      some { code := [], outLayout := layout }
  | ConcreteYul.Stmt.expr expr =>
      match compileExprStmtAt layout expr with
      | some code => some { code := code, outLayout := layout }
      | none => none
  | ConcreteYul.Stmt.let1 name init => compileLet1From layout name init
  | ConcreteYul.Stmt.letMany names init =>
      compileLetManyFrom layout names init
  | ConcreteYul.Stmt.funDef _ _ _ _ =>
      some { code := [], outLayout := layout }
  | ConcreteYul.Stmt.assign name expr => compileAssignFrom layout name expr
  | ConcreteYul.Stmt.assignMany names exprs =>
      compileAssignManyFrom layout names exprs
  | ConcreteYul.Stmt.letCall _ _ _ => none
  | ConcreteYul.Stmt.assignCall _ _ _ => none
  | ConcreteYul.Stmt.seq _ _ => none
  | ConcreteYul.Stmt.block _ => none
  | ConcreteYul.Stmt.ifThen _ _ => none
  | ConcreteYul.Stmt.switch _ _ _ => none
  | ConcreteYul.Stmt.forLoop _ _ _ _ => none
  | ConcreteYul.Stmt.break => none
  | ConcreteYul.Stmt.continue => none
  | ConcreteYul.Stmt.leave => none

theorem compileStmtFrom_codeDepthAfter
    {layout : Layout} {stmt : ConcreteYul.Stmt} {gen : Codegen}
    {tailDepth : Nat}
    (hCompile : compileStmtFrom layout stmt = some gen) :
    codeDepthAfter? gen.code (layout.slots.length + tailDepth) =
      some (gen.outLayout.slots.length + tailDepth) := by
  cases stmt with
  | skip =>
      simp [compileStmtFrom] at hCompile
      cases hCompile
      simp [codeDepthAfter?]
  | expr expr =>
      simp [compileStmtFrom] at hCompile
      cases hCode : compileExprStmtAt layout expr with
      | none =>
          simp [hCode] at hCompile
      | some code =>
          simp [hCode] at hCompile
          cases hCompile
          simpa using
            compileExprStmtAt_codeDepthAfter
              (layout := layout) (expr := expr) (code := code)
              (tailDepth := tailDepth) hCode
  | let1 name init =>
      exact compileLet1From_codeDepthAfter hCompile
  | letMany names init =>
      exact compileLetManyFrom_codeDepthAfter hCompile
  | funDef name params returns body =>
      simp [compileStmtFrom] at hCompile
      cases hCompile
      simp [codeDepthAfter?]
  | assign name expr =>
      exact compileAssignFrom_codeDepthAfter hCompile
  | assignMany names exprs =>
      exact compileAssignManyFrom_codeDepthAfter hCompile
  | letCall names callee args =>
      simp [compileStmtFrom] at hCompile
  | assignCall names callee args =>
      simp [compileStmtFrom] at hCompile
  | seq first second =>
      simp [compileStmtFrom] at hCompile
  | block stmts =>
      simp [compileStmtFrom] at hCompile
  | ifThen cond body =>
      simp [compileStmtFrom] at hCompile
  | switch discr cases defaultBranch =>
      simp [compileStmtFrom] at hCompile
  | forLoop pre cond post body =>
      simp [compileStmtFrom] at hCompile
  | «break» =>
      simp [compileStmtFrom] at hCompile
  | «continue» =>
      simp [compileStmtFrom] at hCompile
  | «leave» =>
      simp [compileStmtFrom] at hCompile

def compileSeqFrom (layout : Layout)
    (first second : ConcreteYul.Stmt) : Option Codegen :=
  match compileStmtFrom layout first with
  | none => none
  | some firstGen =>
      match compileStmtFrom firstGen.outLayout second with
      | none => none
      | some secondGen =>
          some
                  { code := firstGen.code ++ secondGen.code
                    outLayout := secondGen.outLayout }

theorem compileSeqFrom_codeDepthAfter
    {layout : Layout} {first second : ConcreteYul.Stmt}
    {gen : Codegen} {tailDepth : Nat}
    (hCompile : compileSeqFrom layout first second = some gen) :
    codeDepthAfter? gen.code (layout.slots.length + tailDepth) =
      some (gen.outLayout.slots.length + tailDepth) := by
  simp [compileSeqFrom] at hCompile
  cases hFirst : compileStmtFrom layout first with
  | none =>
      simp [hFirst] at hCompile
  | some firstGen =>
      cases hSecond : compileStmtFrom firstGen.outLayout second with
      | none =>
          simp [hFirst, hSecond] at hCompile
      | some secondGen =>
          simp [hFirst, hSecond] at hCompile
          cases hCompile
          have hFirstDepth :=
            compileStmtFrom_codeDepthAfter
              (layout := layout) (stmt := first)
              (gen := firstGen) (tailDepth := tailDepth) hFirst
          have hSecondDepth :=
            compileStmtFrom_codeDepthAfter
              (layout := firstGen.outLayout) (stmt := second)
              (gen := secondGen) (tailDepth := tailDepth) hSecond
          exact codeDepthAfter?_append hFirstDepth hSecondDepth

mutual
  def compileStmtFuelFrom : Nat -> Layout -> ConcreteYul.Stmt -> Option Codegen
    | 0, _, _ => none
    | fuel + 1, layout, ConcreteYul.Stmt.seq first second =>
        match compileStmtFuelFrom fuel layout first with
        | none => none
        | some firstGen =>
            match compileStmtFuelFrom fuel firstGen.outLayout second with
            | none => none
            | some secondGen =>
                some
                  { code := firstGen.code ++ secondGen.code
                    outLayout := secondGen.outLayout }
    | fuel + 1, layout, ConcreteYul.Stmt.block stmts =>
        match compileBlockFuelBodyFrom fuel layout stmts with
        | none => none
        | some bodyGen =>
            some
              { code :=
                  bodyGen.code ++
                    popN (bodyGen.outLayout.slots.length -
                      layout.slots.length)
                outLayout := layout }
    | _fuel + 1, layout, stmt => compileStmtFrom layout stmt

  def compileBlockFuelBodyFrom : Nat -> Layout -> List ConcreteYul.Stmt ->
      Option Codegen
    | 0, _, _ => none
    | _fuel + 1, layout, [] =>
        some { code := [], outLayout := layout }
    | fuel + 1, layout, stmt :: rest =>
        match compileStmtFuelFrom fuel layout stmt with
        | none => none
        | some stmtGen =>
            match compileBlockFuelBodyFrom fuel stmtGen.outLayout rest with
            | none => none
            | some restGen =>
                some
                  { code := stmtGen.code ++ restGen.code
                    outLayout := restGen.outLayout }
end

def compileSwitchCasesFrom (fuel : Nat) (layout : Layout) :
    List (Word × ConcreteYul.Stmt) -> Option (List SwitchCaseCode)
  | [] => some []
  | (value, stmt) :: rest =>
      match compileStmtFuelFrom fuel layout stmt,
          compileSwitchCasesFrom fuel layout rest with
      | some gen, some restCodes =>
          if gen.outLayout = layout then
            some ({ value := value, code := gen.code } :: restCodes)
          else none
      | _, _ => none

def compileSwitchDefaultFrom (fuel : Nat) (layout : Layout) :
    Option ConcreteYul.Stmt -> Option (Option (List Instr))
  | none => some none
  | some stmt =>
      match compileStmtFuelFrom fuel layout stmt with
      | some gen =>
          if gen.outLayout = layout then some (some gen.code) else none
      | none => none

theorem compileSwitchCasesFrom_length
    {fuel : Nat} {layout : Layout} {cases : List (Word × ConcreteYul.Stmt)}
    {caseCodes : List SwitchCaseCode}
    (hCompile : compileSwitchCasesFrom fuel layout cases = some caseCodes) :
    caseCodes.length = cases.length := by
  induction cases generalizing caseCodes with
  | nil =>
      simp [compileSwitchCasesFrom] at hCompile
      cases hCompile
      trivial
  | cons entry rest ih =>
      cases entry with
      | mk value stmt =>
          simp [compileSwitchCasesFrom] at hCompile
          cases hStmt : compileStmtFuelFrom fuel layout stmt with
          | none =>
              simp [hStmt] at hCompile
          | some gen =>
              cases hRest :
                  compileSwitchCasesFrom fuel layout rest with
              | none =>
                  simp [hStmt, hRest] at hCompile
              | some restCodes =>
                  by_cases hOut : gen.outLayout = layout
                  · simp [hStmt, hRest, hOut] at hCompile
                    cases hCompile
                    simp [ih hRest]
                  · simp [hStmt, hRest, hOut] at hCompile

theorem compileSwitchCasesFrom_cons
    {fuel : Nat} {layout : Layout} {value : Word}
    {stmt : ConcreteYul.Stmt} {rest : List (Word × ConcreteYul.Stmt)}
    {caseCodes : List SwitchCaseCode}
    (hCompile :
      compileSwitchCasesFrom fuel layout ((value, stmt) :: rest) =
        some caseCodes) :
    ∃ gen restCodes,
      compileStmtFuelFrom fuel layout stmt = some gen ∧
        gen.outLayout = layout ∧
        compileSwitchCasesFrom fuel layout rest = some restCodes ∧
        caseCodes = { value := value, code := gen.code } :: restCodes := by
  simp [compileSwitchCasesFrom] at hCompile
  cases hStmt : compileStmtFuelFrom fuel layout stmt with
  | none =>
      simp [hStmt] at hCompile
  | some gen =>
      cases hRest : compileSwitchCasesFrom fuel layout rest with
      | none =>
          simp [hStmt, hRest] at hCompile
      | some restCodes =>
          by_cases hOut : gen.outLayout = layout
          · simp [hStmt, hRest, hOut] at hCompile
            cases hCompile
            exact ⟨gen, restCodes, rfl, hOut, rfl, rfl⟩
          · simp [hStmt, hRest, hOut] at hCompile

theorem compileSwitchCasesFrom_nil
    {fuel : Nat} {layout : Layout} {caseCodes : List SwitchCaseCode}
    (hCompile : compileSwitchCasesFrom fuel layout [] = some caseCodes) :
    caseCodes = [] := by
  simpa [compileSwitchCasesFrom] using hCompile.symm

theorem compileSwitchDefaultFrom_some
    {fuel : Nat} {layout : Layout} {stmt : ConcreteYul.Stmt}
    {code : List Instr}
    (hCompile :
      compileSwitchDefaultFrom fuel layout (some stmt) = some (some code)) :
    ∃ gen,
      compileStmtFuelFrom fuel layout stmt = some gen ∧
        gen.outLayout = layout ∧
        code = gen.code := by
  simp [compileSwitchDefaultFrom] at hCompile
  cases hStmt : compileStmtFuelFrom fuel layout stmt with
  | none =>
      simp [hStmt] at hCompile
  | some gen =>
      by_cases hOut : gen.outLayout = layout
      · simp [hStmt, hOut] at hCompile
        cases hCompile
        exact ⟨gen, rfl, hOut, rfl⟩
      · simp [hStmt, hOut] at hCompile

theorem compileSwitchDefaultFrom_none
    {fuel : Nat} {layout : Layout} {defaultCode? : Option (List Instr)}
    (hCompile :
      compileSwitchDefaultFrom fuel layout none = some defaultCode?) :
    defaultCode? = none := by
  simpa [compileSwitchDefaultFrom] using hCompile.symm

def ifThenProgram (condCode bodyCode : List Instr) : Program :=
  [ (0, { body := condCode, term := Term.branchNZ 1 2 })
  , (1, { body := bodyCode, term := Term.jump 2 })
  , (2, { body := [], term := Term.halt })
  ]

def ifThenToProgram (entry thenLabel joinLabel : Label)
    (condCode bodyCode : List Instr) : Program :=
  [ (entry, { body := condCode, term := Term.branchNZ thenLabel joinLabel })
  , (thenLabel, { body := bodyCode, term := Term.jump joinLabel })
  ]

def linearToProgram (entry exit : Label) (code : List Instr) : Program :=
  [(entry, { body := code, term := Term.jump exit })]

def assignCallWithCallsProgram (argCode storeCode : List Instr)
    (fnName : ConcreteYul.Name) (argCount retCount : Nat) : Program :=
  [ (0, { body := argCode,
          term := Term.call fnName argCount retCount 1 })
  , (1, { body := storeCode, term := Term.halt })
  ]

def assignCallToProgram (entry afterCall exit : Label)
    (argCode storeCode : List Instr) (fnName : ConcreteYul.Name)
    (argCount retCount : Nat) : Program :=
  [ (entry,
      { body := argCode
        term := Term.call fnName argCount retCount afterCall })
  , (afterCall, { body := storeCode, term := Term.jump exit })
  ]

def letCallWithCallsProgram (argCode : List Instr)
    (fnName : ConcreteYul.Name) (argCount retCount : Nat) : Program :=
  [ (0, { body := argCode,
          term := Term.call fnName argCount retCount 1 })
  , (1, { body := reverseTopValuesCode retCount, term := Term.halt })
  ]

def letCallToProgram (entry afterCall exit : Label) (argCode : List Instr)
    (fnName : ConcreteYul.Name) (argCount retCount : Nat) : Program :=
  [ (entry,
      { body := argCode
        term := Term.call fnName argCount retCount afterCall })
  , (afterCall,
      { body := reverseTopValuesCode retCount
        term := Term.jump exit })
  ]

def forLoopCondFalseToProgram
    (entry condLabel bodyLabel cleanupLabel exitLabel : Label)
    (preCode condCode : List Instr) (dropCount : Nat) : Program :=
  [ (entry, { body := preCode, term := Term.jump condLabel })
  , (condLabel, { body := condCode,
                  term := Term.branchNZ bodyLabel cleanupLabel })
  , (cleanupLabel, { body := popN dropCount, term := Term.jump exitLabel })
  ]

def forLoopLinearProgram
    (preCode condCode bodyCode postCode : List Instr)
    (dropCount : Nat) : Program :=
  [ (0, { body := preCode, term := Term.jump 1 })
  , (1, { body := condCode, term := Term.branchNZ 2 4 })
  , (2, { body := bodyCode, term := Term.jump 3 })
  , (3, { body := postCode, term := Term.jump 1 })
  , (4, { body := popN dropCount, term := Term.jump 5 })
  , (5, { body := [], term := Term.halt })
  ]

def switchOneNoDefaultProgram (discrCode : List Instr) (caseValue : Word)
    (caseCode : List Instr) : Program :=
  [ (0, { body := discrCode, term := Term.branchEq caseValue 1 2 })
  , (1, { body := Instr.pop :: caseCode, term := Term.jump 3 })
  , (2, { body := [Instr.pop], term := Term.jump 3 })
  , (3, { body := [], term := Term.halt })
  ]

def switchOneNoDefaultToProgram
    (entry caseLabel missLabel joinLabel : Label)
    (discrCode : List Instr) (caseValue : Word)
    (caseCode : List Instr) : Program :=
  [ (entry, { body := discrCode,
              term := Term.branchEq caseValue caseLabel missLabel })
  , (caseLabel, { body := Instr.pop :: caseCode,
                  term := Term.jump joinLabel })
  , (missLabel, { body := [Instr.pop], term := Term.jump joinLabel })
  ]

def switchOneDefaultProgram (discrCode : List Instr) (caseValue : Word)
    (caseCode defaultCode : List Instr) : Program :=
  [ (0, { body := discrCode, term := Term.branchEq caseValue 1 2 })
  , (1, { body := Instr.pop :: caseCode, term := Term.jump 3 })
  , (2, { body := Instr.pop :: defaultCode, term := Term.jump 3 })
  , (3, { body := [], term := Term.halt })
  ]

def switchOneDefaultToProgram
    (entry caseLabel defaultLabel joinLabel : Label)
    (discrCode : List Instr) (caseValue : Word)
    (caseCode defaultCode : List Instr) : Program :=
  [ (entry, { body := discrCode,
              term := Term.branchEq caseValue caseLabel defaultLabel })
  , (caseLabel, { body := Instr.pop :: caseCode,
                  term := Term.jump joinLabel })
  , (defaultLabel, { body := Instr.pop :: defaultCode,
                     term := Term.jump joinLabel })
  ]

def switchTwoNoDefaultProgram (discrCode : List Instr)
    (firstValue secondValue : Word)
    (firstCode secondCode : List Instr) : Program :=
  [ (0, { body := discrCode, term := Term.branchEq firstValue 1 2 })
  , (1, { body := Instr.pop :: firstCode, term := Term.jump 5 })
  , (2, { body := [], term := Term.branchEq secondValue 3 4 })
  , (3, { body := Instr.pop :: secondCode, term := Term.jump 5 })
  , (4, { body := [Instr.pop], term := Term.jump 5 })
  , (5, { body := [], term := Term.halt })
  ]

def switchTwoNoDefaultToProgram
    (entry firstLabel testLabel secondLabel missLabel joinLabel : Label)
    (discrCode : List Instr) (firstValue secondValue : Word)
    (firstCode secondCode : List Instr) : Program :=
  [ (entry, { body := discrCode,
              term := Term.branchEq firstValue firstLabel testLabel })
  , (firstLabel, { body := Instr.pop :: firstCode,
                   term := Term.jump joinLabel })
  , (testLabel, { body := [],
                  term := Term.branchEq secondValue secondLabel missLabel })
  , (secondLabel, { body := Instr.pop :: secondCode,
                    term := Term.jump joinLabel })
  , (missLabel, { body := [Instr.pop], term := Term.jump joinLabel })
  ]

def switchTwoDefaultProgram (discrCode : List Instr)
    (firstValue secondValue : Word)
    (firstCode secondCode defaultCode : List Instr) : Program :=
  [ (0, { body := discrCode, term := Term.branchEq firstValue 1 2 })
  , (1, { body := Instr.pop :: firstCode, term := Term.jump 5 })
  , (2, { body := [], term := Term.branchEq secondValue 3 4 })
  , (3, { body := Instr.pop :: secondCode, term := Term.jump 5 })
  , (4, { body := Instr.pop :: defaultCode, term := Term.jump 5 })
  , (5, { body := [], term := Term.halt })
  ]

def switchTwoDefaultToProgram
    (entry firstLabel testLabel secondLabel defaultLabel joinLabel : Label)
    (discrCode : List Instr) (firstValue secondValue : Word)
    (firstCode secondCode defaultCode : List Instr) : Program :=
  [ (entry, { body := discrCode,
              term := Term.branchEq firstValue firstLabel testLabel })
  , (firstLabel, { body := Instr.pop :: firstCode,
                   term := Term.jump joinLabel })
  , (testLabel, { body := [],
                  term := Term.branchEq secondValue secondLabel
                    defaultLabel })
  , (secondLabel, { body := Instr.pop :: secondCode,
                    term := Term.jump joinLabel })
  , (defaultLabel, { body := Instr.pop :: defaultCode,
                     term := Term.jump joinLabel })
  ]

def switchFallbackBody : Option (List Instr) -> List Instr
  | none => [Instr.pop]
  | some code => Instr.pop :: code

theorem execList_switchFallbackBody_none
    {target : TargetState} {discrValue : Word} {stackRest : Stack} :
    target.stack = Atom.word discrValue :: stackRest ->
      execList (switchFallbackBody none) target =
        some { target with stack := stackRest } := by
  intro hStack
  simp [switchFallbackBody, execList, execInstr, hStack]

theorem execList_switchFallbackBody_some
    {code : List Instr} {target : TargetState}
    {discrValue : Word} {stackRest : Stack} :
    target.stack = Atom.word discrValue :: stackRest ->
      execList (switchFallbackBody (some code)) target =
        execList code { target with stack := stackRest } := by
  intro hStack
  simp [switchFallbackBody, execList, execInstr, hStack]

def switchEntryTerm (caseLabelStart testLabelStart fallbackLabel : Label) :
    List SwitchCaseCode -> Term
  | [] => Term.jump fallbackLabel
  | firstCase :: [] =>
      Term.branchEq firstCase.value caseLabelStart fallbackLabel
  | firstCase :: _ :: _ =>
      Term.branchEq firstCase.value caseLabelStart testLabelStart

def switchCaseBlocksFrom (caseLabelStart joinLabel : Label) :
    List SwitchCaseCode -> Program
  | [] => []
  | caseCode :: rest =>
      (caseLabelStart,
        { body := Instr.pop :: caseCode.code, term := Term.jump joinLabel }) ::
        switchCaseBlocksFrom (caseLabelStart + 1) joinLabel rest

def switchTailTestBlocksFrom (testLabel caseLabel fallbackLabel : Label) :
    List SwitchCaseCode -> Program
  | [] => []
  | caseCode :: rest =>
      let nextLabel :=
        match rest with
        | [] => fallbackLabel
        | _ :: _ => testLabel + 1
      (testLabel,
        { body := []
          term := Term.branchEq caseCode.value caseLabel nextLabel }) ::
        switchTailTestBlocksFrom (testLabel + 1) (caseLabel + 1)
          fallbackLabel rest

def switchChainTestBlocksFrom
    (testLabelStart caseLabelStart fallbackLabel : Label)
    (cases : List SwitchCaseCode) : Program :=
  match cases with
  | [] => []
  | _ :: rest =>
      switchTailTestBlocksFrom testLabelStart (caseLabelStart + 1)
        fallbackLabel rest

def switchChainTestLabelStart (caseLabelStart : Label)
    (cases : List SwitchCaseCode) : Label :=
  nextLabelAfter caseLabelStart cases.length

def switchChainFallbackLabel (caseLabelStart : Label)
    (cases : List SwitchCaseCode) : Label :=
  nextLabelAfter (switchChainTestLabelStart caseLabelStart cases)
    (cases.length - 1)

def switchChainToProgram
    (entry caseLabelStart testLabelStart fallbackLabel joinLabel : Label)
    (discrCode : List Instr) (cases : List SwitchCaseCode)
    (defaultCode? : Option (List Instr)) : Program :=
  [ (entry,
      { body := discrCode
        term := switchEntryTerm caseLabelStart testLabelStart fallbackLabel
          cases }) ] ++
    switchCaseBlocksFrom caseLabelStart joinLabel cases ++
    switchChainTestBlocksFrom testLabelStart caseLabelStart fallbackLabel
      cases ++
    [ (fallbackLabel,
        { body := switchFallbackBody defaultCode?
          term := Term.jump joinLabel }) ]

def switchChainAutoToProgram
    (entry caseLabelStart joinLabel : Label)
    (discrCode : List Instr) (cases : List SwitchCaseCode)
    (defaultCode? : Option (List Instr)) : Program :=
  switchChainToProgram entry caseLabelStart
    (switchChainTestLabelStart caseLabelStart cases)
    (switchChainFallbackLabel caseLabelStart cases) joinLabel discrCode cases
    defaultCode?

def compileSwitchChainFrom (fuel : Nat) (layout : Layout)
    (entry caseLabelStart joinLabel : Label)
    (discr : ConcreteYul.Expr)
    (cases : List (Word × ConcreteYul.Stmt))
    (defaultBranch : Option ConcreteYul.Stmt) : Option CfgCodegen :=
  match compileExprAt layout 0 discr,
      compileSwitchCasesFrom fuel layout cases,
      compileSwitchDefaultFrom fuel layout defaultBranch with
  | some discrCode, some caseCodes, some defaultCode? =>
      some
        { program :=
            switchChainAutoToProgram entry caseLabelStart joinLabel discrCode
              caseCodes defaultCode?
          outLayout := layout }
  | _, _, _ => none

def switchChainClosedJoinLabel (cases : List SwitchCaseCode) : Label :=
  switchChainFallbackLabel 1 cases + 1

def switchChainClosedProgram
    (discrCode : List Instr) (cases : List SwitchCaseCode)
    (defaultCode? : Option (List Instr)) : Program :=
  let joinLabel := switchChainClosedJoinLabel cases
  switchChainAutoToProgram 0 1 joinLabel discrCode cases defaultCode? ++
    [(joinLabel, { body := [], term := Term.halt })]

theorem Program.callFree_nil :
    Program.CallFree ([] : Program) := by
  intro label block hLookup
  simp [lookupBlock?] at hLookup

theorem Program.callFree_cons
    {label : Label} {block : Block} {rest : Program}
    (hBlock : block.term.CallFree) (hRest : Program.CallFree rest) :
    Program.CallFree ((label, block) :: rest) := by
  intro query found hLookup
  by_cases hLabel : label = query
  · subst query
    simp [lookupBlock?] at hLookup
    cases hLookup
    exact hBlock
  · simp [lookupBlock?, hLabel] at hLookup
    exact hRest hLookup

theorem Program.callFree_append
    {first second : Program}
    (hFirst : Program.CallFree first)
    (hSecond : Program.CallFree second) :
  Program.CallFree (first ++ second) := by
  intro label block hLookup
  cases lookupBlock?_append_some first second hLookup with
  | inl hFirstLookup =>
      exact hFirst hFirstLookup
  | inr hSecondLookup =>
      exact hSecond hSecondLookup.2

theorem exprProgram_callFree (code : List Instr) :
    Program.CallFree (exprProgram code) := by
  unfold exprProgram
  exact Program.callFree_cons (by simp [Term.CallFree])
    Program.callFree_nil

theorem ifThenProgram_callFree
    (condCode bodyCode : List Instr) :
    Program.CallFree (ifThenProgram condCode bodyCode) := by
  unfold ifThenProgram
  exact Program.callFree_cons (by simp [Term.CallFree])
    (Program.callFree_cons (by simp [Term.CallFree])
      (Program.callFree_cons (by simp [Term.CallFree])
        Program.callFree_nil))

theorem linearToProgram_callFree (entry exit : Label)
    (code : List Instr) :
    Program.CallFree (linearToProgram entry exit code) := by
  unfold linearToProgram
  exact Program.callFree_cons (by simp [Term.CallFree])
    Program.callFree_nil

theorem forLoopLinearProgram_callFree
    (preCode condCode bodyCode postCode : List Instr)
    (dropCount : Nat) :
    Program.CallFree
      (forLoopLinearProgram preCode condCode bodyCode postCode
        dropCount) := by
  unfold forLoopLinearProgram
  exact Program.callFree_cons (by simp [Term.CallFree])
    (Program.callFree_cons (by simp [Term.CallFree])
      (Program.callFree_cons (by simp [Term.CallFree])
        (Program.callFree_cons (by simp [Term.CallFree])
          (Program.callFree_cons (by simp [Term.CallFree])
            (Program.callFree_cons (by simp [Term.CallFree])
              Program.callFree_nil)))))

theorem switchEntryTerm_callFree
    (caseLabelStart testLabelStart fallbackLabel : Label)
    (cases : List SwitchCaseCode) :
    Term.CallFree
      (switchEntryTerm caseLabelStart testLabelStart fallbackLabel
        cases) := by
  cases cases with
  | nil =>
      simp [switchEntryTerm, Term.CallFree]
  | cons first rest =>
      cases rest <;> simp [switchEntryTerm, Term.CallFree]

theorem switchCaseBlocksFrom_callFree
    (caseLabelStart joinLabel : Label) (cases : List SwitchCaseCode) :
    Program.CallFree
      (switchCaseBlocksFrom caseLabelStart joinLabel cases) := by
  induction cases generalizing caseLabelStart with
  | nil =>
      simp [switchCaseBlocksFrom]
      exact Program.callFree_nil
  | cons caseCode rest ih =>
      simp [switchCaseBlocksFrom]
      exact Program.callFree_cons (by simp [Term.CallFree])
        (ih (caseLabelStart + 1))

theorem switchTailTestBlocksFrom_callFree
    (testLabel caseLabel fallbackLabel : Label)
    (cases : List SwitchCaseCode) :
    Program.CallFree
      (switchTailTestBlocksFrom testLabel caseLabel fallbackLabel
        cases) := by
  induction cases generalizing testLabel caseLabel with
  | nil =>
      simp [switchTailTestBlocksFrom]
      exact Program.callFree_nil
  | cons caseCode rest ih =>
      simp [switchTailTestBlocksFrom]
      exact Program.callFree_cons (by simp [Term.CallFree])
        (ih (testLabel + 1) (caseLabel + 1))

theorem switchChainTestBlocksFrom_callFree
    (testLabelStart caseLabelStart fallbackLabel : Label)
    (cases : List SwitchCaseCode) :
    Program.CallFree
      (switchChainTestBlocksFrom testLabelStart caseLabelStart fallbackLabel
        cases) := by
  cases cases with
  | nil =>
      simp [switchChainTestBlocksFrom]
      exact Program.callFree_nil
  | cons first rest =>
      simp [switchChainTestBlocksFrom]
      change
        Program.CallFree
          (switchTailTestBlocksFrom testLabelStart (caseLabelStart + 1)
            fallbackLabel rest)
      exact
        switchTailTestBlocksFrom_callFree testLabelStart
          (caseLabelStart + 1) fallbackLabel rest

theorem switchChainToProgram_callFree
    (entry caseLabelStart testLabelStart fallbackLabel joinLabel : Label)
    (discrCode : List Instr) (cases : List SwitchCaseCode)
    (defaultCode? : Option (List Instr)) :
    Program.CallFree
    (switchChainToProgram entry caseLabelStart testLabelStart fallbackLabel
      joinLabel discrCode cases defaultCode?) := by
  have hEntry :
      Program.CallFree
        [ (entry,
            { body := discrCode
              term :=
                switchEntryTerm caseLabelStart testLabelStart fallbackLabel
                  cases }) ] :=
    Program.callFree_cons
      (by
        simpa using
          switchEntryTerm_callFree caseLabelStart testLabelStart
            fallbackLabel cases)
      Program.callFree_nil
  have hCases :
      Program.CallFree
        (switchCaseBlocksFrom caseLabelStart joinLabel cases) :=
    switchCaseBlocksFrom_callFree caseLabelStart joinLabel cases
  have hTests :
      Program.CallFree
        (switchChainTestBlocksFrom testLabelStart caseLabelStart
          fallbackLabel cases) :=
    switchChainTestBlocksFrom_callFree testLabelStart caseLabelStart
      fallbackLabel cases
  have hFallback :
      Program.CallFree
        [ (fallbackLabel,
            { body := switchFallbackBody defaultCode?
              term := Term.jump joinLabel }) ] :=
    Program.callFree_cons (by simp [Term.CallFree]) Program.callFree_nil
  have hCombined :
      Program.CallFree
        ((([ (entry,
            { body := discrCode
              term :=
                switchEntryTerm caseLabelStart testLabelStart fallbackLabel
                  cases }) ] : Program) ++
          switchCaseBlocksFrom caseLabelStart joinLabel cases) ++
          switchChainTestBlocksFrom testLabelStart caseLabelStart
            fallbackLabel cases ++
          [ (fallbackLabel,
              { body := switchFallbackBody defaultCode?
                term := Term.jump joinLabel }) ]) :=
    Program.callFree_append
      (Program.callFree_append
        (Program.callFree_append hEntry hCases) hTests)
      hFallback
  intro label block hLookup
  exact
    hCombined
      (by simpa [switchChainToProgram, List.append_assoc] using hLookup)

theorem switchChainAutoToProgram_callFree
    (entry caseLabelStart joinLabel : Label)
    (discrCode : List Instr) (cases : List SwitchCaseCode)
    (defaultCode? : Option (List Instr)) :
    Program.CallFree
      (switchChainAutoToProgram entry caseLabelStart joinLabel discrCode
        cases defaultCode?) :=
  switchChainToProgram_callFree entry caseLabelStart
    (switchChainTestLabelStart caseLabelStart cases)
    (switchChainFallbackLabel caseLabelStart cases) joinLabel discrCode
    cases defaultCode?

theorem switchChainClosedProgram_callFree
    (discrCode : List Instr) (cases : List SwitchCaseCode)
    (defaultCode? : Option (List Instr)) :
    Program.CallFree
      (switchChainClosedProgram discrCode cases defaultCode?) := by
  unfold switchChainClosedProgram
  apply Program.callFree_append
  · exact
      switchChainAutoToProgram_callFree 0 1
        (switchChainClosedJoinLabel cases) discrCode cases defaultCode?
  · exact Program.callFree_cons (by simp [Term.CallFree])
      Program.callFree_nil

def compileSwitchChainClosedFrom (fuel : Nat) (layout : Layout)
    (discr : ConcreteYul.Expr)
    (cases : List (Word × ConcreteYul.Stmt))
    (defaultBranch : Option ConcreteYul.Stmt) : Option CfgCodegen :=
  match compileExprAt layout 0 discr,
      compileSwitchCasesFrom fuel layout cases,
      compileSwitchDefaultFrom fuel layout defaultBranch with
  | some discrCode, some caseCodes, some defaultCode? =>
      some
        { program := switchChainClosedProgram discrCode caseCodes defaultCode?
          outLayout := layout }
  | _, _, _ => none

theorem compileSwitchChainFrom_outLayout
    {fuel : Nat} {layout : Layout}
    {entry caseLabelStart joinLabel : Label}
    {discr : ConcreteYul.Expr}
    {cases : List (Word × ConcreteYul.Stmt)}
    {defaultBranch : Option ConcreteYul.Stmt} {cfg : CfgCodegen}
    (hCompile :
      compileSwitchChainFrom fuel layout entry caseLabelStart joinLabel discr
        cases defaultBranch = some cfg) :
    cfg.outLayout = layout := by
  simp [compileSwitchChainFrom] at hCompile
  cases hDiscr : compileExprAt layout 0 discr with
  | none =>
      simp [hDiscr] at hCompile
  | some discrCode =>
      cases hCases : compileSwitchCasesFrom fuel layout cases with
      | none =>
          simp [hDiscr, hCases] at hCompile
      | some caseCodes =>
          cases hDefault :
              compileSwitchDefaultFrom fuel layout defaultBranch with
          | none =>
              simp [hDiscr, hCases, hDefault] at hCompile
          | some defaultCode =>
              simp [hDiscr, hCases, hDefault] at hCompile
              cases hCompile
              rfl

theorem switchCaseBlocksFrom_length
    (caseLabelStart joinLabel : Label) (cases : List SwitchCaseCode) :
    (switchCaseBlocksFrom caseLabelStart joinLabel cases).length =
      cases.length := by
  induction cases generalizing caseLabelStart with
  | nil =>
      rfl
  | cons caseCode rest ih =>
      simp [switchCaseBlocksFrom, ih]

theorem switchTailTestBlocksFrom_length
    (testLabel caseLabel fallbackLabel : Label)
    (cases : List SwitchCaseCode) :
    (switchTailTestBlocksFrom testLabel caseLabel fallbackLabel cases).length =
      cases.length := by
  induction cases generalizing testLabel caseLabel with
  | nil =>
      rfl
  | cons caseCode rest ih =>
      simp [switchTailTestBlocksFrom, ih]

theorem switchChainTestBlocksFrom_length
    (testLabelStart caseLabelStart fallbackLabel : Label)
    (cases : List SwitchCaseCode) :
    (switchChainTestBlocksFrom testLabelStart caseLabelStart fallbackLabel
        cases).length =
      cases.length - 1 := by
  cases cases with
  | nil =>
      rfl
  | cons caseCode rest =>
      simp [switchChainTestBlocksFrom, switchTailTestBlocksFrom_length]

theorem lookupBlock?_switchCaseBlocksFrom_none_before
    {label caseLabelStart joinLabel : Label}
    {cases : List SwitchCaseCode}
    (hBefore : label < caseLabelStart) :
    lookupBlock? (switchCaseBlocksFrom caseLabelStart joinLabel cases)
        label =
      none := by
  revert caseLabelStart
  induction cases with
  | nil =>
      intro caseLabelStart hBefore
      rfl
  | cons caseCode rest ih =>
      intro caseLabelStart hBefore
      have hNe : caseLabelStart ≠ label := Nat.ne_of_gt hBefore
      simp [switchCaseBlocksFrom, lookupBlock?, hNe]
      exact
        ih (caseLabelStart := caseLabelStart + 1)
          (Nat.lt_trans hBefore (Nat.lt_succ_self caseLabelStart))

theorem lookupBlock?_switchCaseBlocksFrom_none_at_or_after
    {label caseLabelStart joinLabel : Label}
    {cases : List SwitchCaseCode}
    (hAfter : nextLabelAfter caseLabelStart cases.length ≤ label) :
    lookupBlock? (switchCaseBlocksFrom caseLabelStart joinLabel cases)
        label =
      none := by
  revert caseLabelStart
  induction cases with
  | nil =>
      intro caseLabelStart hAfter
      rfl
  | cons caseCode rest ih =>
      intro caseLabelStart hAfter
      have hRec :
          nextLabelAfter (caseLabelStart + 1) rest.length ≤ label := by
        simpa [nextLabelAfter, Nat.add_assoc, Nat.add_comm,
          Nat.add_left_comm] using hAfter
      have hStartLt : caseLabelStart < label := by
        exact
          Nat.lt_of_succ_le
            (Nat.le_trans (by simp [nextLabelAfter]) hRec)
      have hNe : caseLabelStart ≠ label := Nat.ne_of_lt hStartLt
      simp [switchCaseBlocksFrom, lookupBlock?, hNe]
      exact ih (caseLabelStart := caseLabelStart + 1) hRec

theorem switchCaseBlocksFrom_tail_extends
    (caseLabelStart joinLabel : Label)
    (caseCode : SwitchCaseCode) (restCases : List SwitchCaseCode) :
    Program.Extends
      (switchCaseBlocksFrom (caseLabelStart + 1) joinLabel restCases)
      (switchCaseBlocksFrom caseLabelStart joinLabel
        (caseCode :: restCases)) := by
  intro label block hLookup
  have hBefore :
      lookupBlock?
          (switchCaseBlocksFrom (caseLabelStart + 1) joinLabel restCases)
          caseLabelStart =
        none :=
    lookupBlock?_switchCaseBlocksFrom_none_before
      (label := caseLabelStart) (caseLabelStart := caseLabelStart + 1)
      (joinLabel := joinLabel) (cases := restCases)
      (Nat.lt_succ_self caseLabelStart)
  by_cases hLabel : caseLabelStart = label
  · subst label
    simp [hBefore] at hLookup
  · simpa [switchCaseBlocksFrom, lookupBlock?, hLabel] using hLookup

theorem switchCaseBlocksFrom_head_lookup
    (caseLabel joinLabel : Label)
    (caseCode : SwitchCaseCode) (restCases : List SwitchCaseCode) :
    lookupBlock?
        (switchCaseBlocksFrom caseLabel joinLabel
          (caseCode :: restCases))
        caseLabel =
      some
        ({ body := Instr.pop :: caseCode.code
           term := Term.jump joinLabel } : Block) := by
  simp [switchCaseBlocksFrom, lookupBlock?]

theorem switchCaseBlocksFrom_head_step
    {caseLabel joinLabel : Label}
    {caseCode : SwitchCaseCode} {restCases : List SwitchCaseCode}
    {discrTarget caseTarget : TargetState} {discrValue : Word}
    {stackRest : Stack}
    (hStack : discrTarget.stack = Atom.word discrValue :: stackRest)
    (hExec :
      execList caseCode.code { discrTarget with stack := stackRest } =
        some caseTarget) :
    step
        (switchCaseBlocksFrom caseLabel joinLabel
          (caseCode :: restCases))
        (Config.at caseLabel discrTarget) =
      Config.at joinLabel caseTarget := by
  simp [step, switchCaseBlocksFrom_head_lookup, execList, execInstr,
    hStack, hExec, execTerm]

theorem lookupBlock?_switchTailTestBlocksFrom_none_before
    {label testLabel caseLabel fallbackLabel : Label}
    {cases : List SwitchCaseCode}
    (hBefore : label < testLabel) :
    lookupBlock?
        (switchTailTestBlocksFrom testLabel caseLabel fallbackLabel cases)
        label =
      none := by
  revert testLabel caseLabel
  induction cases with
  | nil =>
      intro testLabel caseLabel hBefore
      rfl
  | cons caseCode rest ih =>
      intro testLabel caseLabel hBefore
      have hNe : testLabel ≠ label := Nat.ne_of_gt hBefore
      simp [switchTailTestBlocksFrom, lookupBlock?, hNe]
      exact
        ih (testLabel := testLabel + 1) (caseLabel := caseLabel + 1)
          (Nat.lt_trans hBefore (Nat.lt_succ_self testLabel))

theorem lookupBlock?_switchTailTestBlocksFrom_none_at_or_after
    {label testLabel caseLabel fallbackLabel : Label}
    {cases : List SwitchCaseCode}
    (hAfter : nextLabelAfter testLabel cases.length ≤ label) :
    lookupBlock?
        (switchTailTestBlocksFrom testLabel caseLabel fallbackLabel cases)
        label =
      none := by
  revert testLabel caseLabel
  induction cases with
  | nil =>
      intro testLabel caseLabel hAfter
      rfl
  | cons caseCode rest ih =>
      intro testLabel caseLabel hAfter
      have hRec :
          nextLabelAfter (testLabel + 1) rest.length ≤ label := by
        simpa [nextLabelAfter, Nat.add_assoc, Nat.add_comm,
          Nat.add_left_comm] using hAfter
      have hStartLt : testLabel < label := by
        exact
          Nat.lt_of_succ_le
            (Nat.le_trans (by simp [nextLabelAfter]) hRec)
      have hNe : testLabel ≠ label := Nat.ne_of_lt hStartLt
      simp [switchTailTestBlocksFrom, lookupBlock?, hNe]
      exact
        ih (testLabel := testLabel + 1) (caseLabel := caseLabel + 1)
          hRec

theorem switchChainToProgram_entry_lookup
    (entry caseLabelStart testLabelStart fallbackLabel joinLabel : Label)
    (discrCode : List Instr) (cases : List SwitchCaseCode)
    (defaultCode? : Option (List Instr)) :
    lookupBlock?
        (switchChainToProgram entry caseLabelStart testLabelStart
          fallbackLabel joinLabel discrCode cases defaultCode?)
        entry =
      some
        ({ body := discrCode
           term :=
            switchEntryTerm caseLabelStart testLabelStart fallbackLabel
              cases } : Block) := by
  simp [switchChainToProgram, lookupBlock?]

theorem switchChainToProgram_entry_step
    {entry caseLabelStart testLabelStart fallbackLabel joinLabel : Label}
    {discrCode : List Instr} {cases : List SwitchCaseCode}
    {defaultCode? : Option (List Instr)}
    {target discrTarget : TargetState}
    (hExec : execList discrCode target = some discrTarget) :
    step
        (switchChainToProgram entry caseLabelStart testLabelStart
          fallbackLabel joinLabel discrCode cases defaultCode?)
        (Config.at entry target) =
      execTerm
        (switchEntryTerm caseLabelStart testLabelStart fallbackLabel cases)
        discrTarget := by
  simp [step, switchChainToProgram_entry_lookup, hExec]

theorem switchChainToProgram_entry_empty_step
    {entry caseLabelStart testLabelStart fallbackLabel joinLabel : Label}
    {discrCode : List Instr} {defaultCode? : Option (List Instr)}
    {target discrTarget : TargetState}
    (hExec : execList discrCode target = some discrTarget) :
    step
        (switchChainToProgram entry caseLabelStart testLabelStart
          fallbackLabel joinLabel discrCode [] defaultCode?)
        (Config.at entry target) =
      Config.at fallbackLabel discrTarget := by
  rw [switchChainToProgram_entry_step (cases := []) hExec]
  rfl

theorem switchChainToProgram_entry_first_match_step
    {entry caseLabelStart testLabelStart fallbackLabel joinLabel : Label}
    {discrCode : List Instr} {firstCase : SwitchCaseCode}
    {restCases : List SwitchCaseCode} {defaultCode? : Option (List Instr)}
    {target discrTarget : TargetState} {discrValue : Word} {stackRest : Stack}
    (hExec : execList discrCode target = some discrTarget)
    (hStack : discrTarget.stack = Atom.word discrValue :: stackRest)
    (hMatch : norm discrValue = norm firstCase.value) :
    step
        (switchChainToProgram entry caseLabelStart testLabelStart
          fallbackLabel joinLabel discrCode (firstCase :: restCases)
          defaultCode?)
        (Config.at entry target) =
      Config.at caseLabelStart discrTarget := by
  rw [switchChainToProgram_entry_step hExec]
  cases restCases with
  | nil =>
      simp [switchEntryTerm, execTerm, hStack, hMatch]
  | cons secondCase restCases =>
      simp [switchEntryTerm, execTerm, hStack, hMatch]

theorem switchChainToProgram_entry_one_miss_step
    {entry caseLabelStart testLabelStart fallbackLabel joinLabel : Label}
    {discrCode : List Instr} {firstCase : SwitchCaseCode}
    {defaultCode? : Option (List Instr)}
    {target discrTarget : TargetState} {discrValue : Word} {stackRest : Stack}
    (hExec : execList discrCode target = some discrTarget)
    (hStack : discrTarget.stack = Atom.word discrValue :: stackRest)
    (hMiss : norm discrValue ≠ norm firstCase.value) :
    step
        (switchChainToProgram entry caseLabelStart testLabelStart
          fallbackLabel joinLabel discrCode [firstCase] defaultCode?)
        (Config.at entry target) =
      Config.at fallbackLabel discrTarget := by
  rw [switchChainToProgram_entry_step hExec]
  simp [switchEntryTerm, execTerm, hStack, hMiss]

theorem switchChainToProgram_entry_many_miss_step
    {entry caseLabelStart testLabelStart fallbackLabel joinLabel : Label}
    {discrCode : List Instr} {firstCase secondCase : SwitchCaseCode}
    {restCases : List SwitchCaseCode} {defaultCode? : Option (List Instr)}
    {target discrTarget : TargetState} {discrValue : Word} {stackRest : Stack}
    (hExec : execList discrCode target = some discrTarget)
    (hStack : discrTarget.stack = Atom.word discrValue :: stackRest)
    (hMiss : norm discrValue ≠ norm firstCase.value) :
    step
        (switchChainToProgram entry caseLabelStart testLabelStart
          fallbackLabel joinLabel discrCode
          (firstCase :: secondCase :: restCases) defaultCode?)
        (Config.at entry target) =
      Config.at testLabelStart discrTarget := by
  rw [switchChainToProgram_entry_step hExec]
  simp [switchEntryTerm, execTerm, hStack, hMiss]

theorem switchChainToProgram_first_case_lookup
    {entry caseLabelStart testLabelStart fallbackLabel joinLabel : Label}
    {discrCode : List Instr} {firstCase : SwitchCaseCode}
    {restCases : List SwitchCaseCode} {defaultCode? : Option (List Instr)}
    (hEntryCase : entry ≠ caseLabelStart) :
    lookupBlock?
        (switchChainToProgram entry caseLabelStart testLabelStart
          fallbackLabel joinLabel discrCode (firstCase :: restCases)
          defaultCode?)
        caseLabelStart =
      some
        ({ body := Instr.pop :: firstCase.code
           term := Term.jump joinLabel } : Block) := by
  simp [switchChainToProgram, switchCaseBlocksFrom, lookupBlock?,
    hEntryCase]

theorem switchChainToProgram_first_case_step
    {entry caseLabelStart testLabelStart fallbackLabel joinLabel : Label}
    {discrCode : List Instr} {firstCase : SwitchCaseCode}
    {restCases : List SwitchCaseCode} {defaultCode? : Option (List Instr)}
    {discrTarget caseTarget : TargetState} {discrValue : Word}
    {stackRest : Stack}
    (hEntryCase : entry ≠ caseLabelStart)
    (hStack : discrTarget.stack = Atom.word discrValue :: stackRest)
    (hExec :
      execList firstCase.code { discrTarget with stack := stackRest } =
        some caseTarget) :
    step
        (switchChainToProgram entry caseLabelStart testLabelStart
          fallbackLabel joinLabel discrCode (firstCase :: restCases)
          defaultCode?)
        (Config.at caseLabelStart discrTarget) =
      Config.at joinLabel caseTarget := by
  simp [step, switchChainToProgram_first_case_lookup hEntryCase,
    execList, execInstr, hStack, hExec, execTerm]

theorem switchChainToProgram_first_case_reaches
    {entry caseLabelStart testLabelStart fallbackLabel joinLabel : Label}
    {discrCode : List Instr} {firstCase : SwitchCaseCode}
    {restCases : List SwitchCaseCode} {defaultCode? : Option (List Instr)}
    {target discrTarget caseTarget : TargetState} {discrValue : Word}
    {stackRest : Stack}
    (hEntryCase : entry ≠ caseLabelStart)
    (hDiscrExec : execList discrCode target = some discrTarget)
    (hStack : discrTarget.stack = Atom.word discrValue :: stackRest)
    (hMatch : norm discrValue = norm firstCase.value)
    (hCaseExec :
      execList firstCase.code { discrTarget with stack := stackRest } =
        some caseTarget) :
    Reaches
        (switchChainToProgram entry caseLabelStart testLabelStart
          fallbackLabel joinLabel discrCode (firstCase :: restCases)
          defaultCode?)
        (Config.at entry target) (Config.at joinLabel caseTarget) := by
  refine
    Reaches.step
      (next := Config.at caseLabelStart discrTarget) ?_ ?_
  · exact
      switchChainToProgram_entry_first_match_step
        (firstCase := firstCase) (restCases := restCases)
        hDiscrExec hStack hMatch
  · apply reaches_one
    exact
      switchChainToProgram_first_case_step
        (firstCase := firstCase) (restCases := restCases)
        hEntryCase hStack hCaseExec

theorem switchChainToProgram_fallback_lookup
    {entry caseLabelStart testLabelStart fallbackLabel joinLabel : Label}
    {discrCode : List Instr} {cases : List SwitchCaseCode}
    {defaultCode? : Option (List Instr)}
    (hEntryFallback : entry ≠ fallbackLabel)
    (hCaseFresh :
      lookupBlock? (switchCaseBlocksFrom caseLabelStart joinLabel cases)
        fallbackLabel = none)
    (hTestFresh :
      lookupBlock?
          (switchChainTestBlocksFrom testLabelStart caseLabelStart
            fallbackLabel cases)
          fallbackLabel =
        none) :
    lookupBlock?
        (switchChainToProgram entry caseLabelStart testLabelStart
          fallbackLabel joinLabel discrCode cases defaultCode?)
        fallbackLabel =
      some
        ({ body := switchFallbackBody defaultCode?
           term := Term.jump joinLabel } : Block) := by
  simp [switchChainToProgram, lookupBlock?, hEntryFallback]
  calc
    lookupBlock?
        (switchCaseBlocksFrom caseLabelStart joinLabel cases ++
          (switchChainTestBlocksFrom testLabelStart caseLabelStart
            fallbackLabel cases ++
            [(fallbackLabel,
              { body := switchFallbackBody defaultCode?
                term := Term.jump joinLabel })]))
        fallbackLabel =
      lookupBlock?
        (switchChainTestBlocksFrom testLabelStart caseLabelStart
          fallbackLabel cases ++
          [(fallbackLabel,
            { body := switchFallbackBody defaultCode?
              term := Term.jump joinLabel })])
        fallbackLabel := by
          exact
            lookupBlock?_append_of_none
              (switchCaseBlocksFrom caseLabelStart joinLabel cases)
              (switchChainTestBlocksFrom testLabelStart caseLabelStart
                fallbackLabel cases ++
                [(fallbackLabel,
                  { body := switchFallbackBody defaultCode?
                    term := Term.jump joinLabel })])
              hCaseFresh
    _ =
      lookupBlock?
        [(fallbackLabel,
          { body := switchFallbackBody defaultCode?
            term := Term.jump joinLabel })]
        fallbackLabel := by
          exact
            lookupBlock?_append_of_none
              (switchChainTestBlocksFrom testLabelStart caseLabelStart
                fallbackLabel cases)
              [(fallbackLabel,
                { body := switchFallbackBody defaultCode?
                  term := Term.jump joinLabel })]
              hTestFresh
    _ =
      some
        ({ body := switchFallbackBody defaultCode?
           term := Term.jump joinLabel } : Block) := by
          simp [lookupBlock?]

theorem lookupBlock?_switchCaseBlocksFrom_none_at_fallback
    (caseLabelStart joinLabel : Label) (cases : List SwitchCaseCode) :
    lookupBlock?
        (switchCaseBlocksFrom caseLabelStart joinLabel cases)
        (switchChainFallbackLabel caseLabelStart cases) =
      none := by
  apply lookupBlock?_switchCaseBlocksFrom_none_at_or_after
