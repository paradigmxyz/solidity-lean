                hNoHalt hRel
        | assignMany names exprs =>
            exact
              compileStmtFrom_execList_correct hLayout hCompile hEval
                hNoHalt hRel
        | letCall names fnName args =>
            exact
              compileStmtFrom_execList_correct hLayout hCompile hEval
                hNoHalt hRel
        | assignCall names fnName args =>
            exact
              compileStmtFrom_execList_correct hLayout hCompile hEval
                hNoHalt hRel
        | ifThen cond body =>
            exact
              compileStmtFrom_execList_correct hLayout hCompile hEval
