                · apply reaches_one
                  simp [step, switchTwoDefaultToProgram, lookupBlock?,
                    hEntrySecond, hFirstSecond, hTestSecond,
                    execList, execInstr, hDiscrRel.stack_eq,
                    poppedTarget, hSecondExec, execTerm]
            · have hSecondBranchNo :
                  ¬ norm discrValue = norm secondValue := by
                intro h
                exact hSecondMatch h.symm
