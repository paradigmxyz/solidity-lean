                          ih.2 hLayout hBodyCompile hBodyEval hNoHalt
                            hRel with
                          ⟨bodyTarget, hBodyExec, hBodyRel, hBodyFlow,
                            hBodyNoHalt, hBodyLayout⟩
                        cases bodyResult with
                        | mk bodyFlow bodyConfig =>
                            cases bodyFlow <;>
                              simp [hBodyEval] at hEval hBodyFlow
                            cases hRestore :
                                ConcreteYul.restoreBlockConfig source
                                  bodyConfig with
                            | none =>
                                simp [ConcreteYul.withRestoredConfig,
