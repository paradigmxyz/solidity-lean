theorem compileCfgStmtOpenRecFrom_if_programDepthChecked
    {depthOf : DepthEnv} {fuel : Nat} {layout : Layout}
    {dest : ControlDest} {entry exit next : Label}
    {cond : ConcreteYul.Expr} {body : ConcreteYul.Stmt}
    {openCfg : OpenCfgCodegen} {tailDepth : Nat}
    (hCompile :
      compileCfgStmtOpenRecFrom (fuel + 1) layout dest entry exit next
        (ConcreteYul.Stmt.ifThen cond body) =
          some openCfg)
    (hEntry : depthOf entry = some (layout.slots.length + tailDepth))
    (hNext : depthOf next = some (layout.slots.length + tailDepth))
    (hExit : depthOf exit = some (layout.slots.length + tailDepth))
    (hBodyChecked :
      ∀ {condCode bodyOpen},
        compileExprAt layout 0 cond = some condCode ->
        compileCfgStmtOpenRecFrom fuel layout dest next exit
            (next + 1) body =
          some bodyOpen ->
        bodyOpen.outLayout = layout ->
        Program.DepthChecked depthOf bodyOpen.program) :
    Program.DepthChecked depthOf openCfg.program := by
  simp [compileCfgStmtOpenRecFrom] at hCompile
  cases hCond : compileExprAt layout 0 cond with
  | none =>
      simp [hCond] at hCompile
  | some condCode =>
      cases hBody :
          compileCfgStmtOpenRecFrom fuel layout dest next exit
            (next + 1) body with
      | none =>
          simp [hCond, hBody] at hCompile
      | some bodyOpen =>
          by_cases hOut : bodyOpen.outLayout = layout
          · simp [hCond, hBody, hOut] at hCompile
            cases hCompile
            have hChecked :
                Program.DepthChecked depthOf
                  ((entry,
                      { body := condCode
                        term := Term.branchNZ next exit }) ::
                    bodyOpen.program) :=
              Program.DepthChecked.cons
                (entry := entry)
                (block := { body := condCode
                            term := Term.branchNZ next exit })
                (rest := bodyOpen.program)
                (depth := layout.slots.length + tailDepth)
                (outDepth := layout.slots.length + tailDepth)
                hEntry
                (ifThenEntryBlockDepthAfterWithTargets
                  (depthOf := depthOf) (layout := layout)
                  (cond := cond) (condCode := condCode)
                  (thenLabel := next) (exit := exit)
                  (tailDepth := tailDepth)
                  hCond hNext hExit)
                (hBodyChecked hCond hBody hOut)
            simpa using hChecked
          · simp [hCond, hBody, hOut] at hCompile

theorem compileCfgStmtOpenRecFrom_seq_fallback_programDepthChecked
    {depthOf : DepthEnv} {fuel : Nat} {layout : Layout}
    {dest : ControlDest} {entry exit next : Label}
    {first second : ConcreteYul.Stmt}
    {openCfg : OpenCfgCodegen} {tailDepth : Nat}
    (hDirect :
      compileCfgStmtOpenFrom (fuel + 1) layout dest entry exit
        (ConcreteYul.Stmt.seq first second) =
          none)
    (hCompile :
      compileCfgStmtOpenRecFrom (fuel + 1) layout dest entry exit next
        (ConcreteYul.Stmt.seq first second) =
          some openCfg)
    (hEntry : depthOf entry = some (layout.slots.length + tailDepth))
    (hNext :
      ∀ {firstGen},
        compileStmtFuelFrom fuel layout first = some firstGen ->
          depthOf next =
            some (firstGen.outLayout.slots.length + tailDepth))
    (hSecondChecked :
      ∀ {firstGen secondOpen},
        compileStmtFuelFrom fuel layout first = some firstGen ->
        compileCfgStmtOpenRecFrom fuel firstGen.outLayout dest next exit
            (next + 1) second =
          some secondOpen ->
        Program.DepthChecked depthOf secondOpen.program) :
    Program.DepthChecked depthOf openCfg.program := by
  simp [compileCfgStmtOpenRecFrom] at hCompile
  simp [hDirect] at hCompile
  cases hFirst : compileStmtFuelFrom fuel layout first with
  | none =>
      simp [hFirst] at hCompile
  | some firstGen =>
      cases hSecond :
          compileCfgStmtOpenRecFrom fuel firstGen.outLayout dest next exit
            (next + 1) second with
      | none =>
          simp [hFirst, hSecond] at hCompile
      | some secondOpen =>
          simp [hFirst, hSecond] at hCompile
          cases hCompile
          have hFirstChecked :
              Program.DepthChecked depthOf
                (linearToProgram entry next firstGen.code) :=
            compileStmtFuelFrom_linearProgramDepthChecked
              (depthOf := depthOf) (compileFuel := fuel)
              (layout := layout) (stmt := first) (gen := firstGen)
              (entry := entry) (exit := next) (tailDepth := tailDepth)
              hFirst hEntry (hNext hFirst)
          have hAll :
              Program.DepthChecked depthOf
                (linearToProgram entry next firstGen.code ++
                  secondOpen.program) :=
            Program.DepthChecked.append hFirstChecked
              (hSecondChecked hFirst hSecond)
          intro label block hLookup
          exact hAll hLookup

structure OpenRecDepthObligations
    (depthOf : DepthEnv) (fuel : Nat) (layout : Layout)
    (dest : ControlDest) (entry exit next : Label)
    (stmt : ConcreteYul.Stmt) (tailDepth : Nat) : Prop where
  entryDepth :
    depthOf entry = some (layout.slots.length + tailDepth)
  exitDepth :
    ∀ {gen},
      compileStmtFuelFrom (fuel + 1) layout stmt = some gen ->
        depthOf exit =
          some (gen.outLayout.slots.length + tailDepth)
  controlDepth :
    ∀ {label},
      controlExitLabel? dest stmt = some label ->
        depthOf label = some (layout.slots.length + tailDepth)
  ifNextDepth :
    ∀ {cond body},
      stmt = ConcreteYul.Stmt.ifThen cond body ->
        depthOf next = some (layout.slots.length + tailDepth)
  ifExitDepth :
    ∀ {cond body},
      stmt = ConcreteYul.Stmt.ifThen cond body ->
        depthOf exit = some (layout.slots.length + tailDepth)
  ifBodyChecked :
    ∀ {cond body condCode bodyOpen},
      stmt = ConcreteYul.Stmt.ifThen cond body ->
      compileExprAt layout 0 cond = some condCode ->
      compileCfgStmtOpenRecFrom fuel layout dest next exit
          (next + 1) body =
        some bodyOpen ->
      bodyOpen.outLayout = layout ->
        Program.DepthChecked depthOf bodyOpen.program
  seqNextDepth :
    ∀ {first second firstGen},
      stmt = ConcreteYul.Stmt.seq first second ->
      compileCfgStmtOpenFrom (fuel + 1) layout dest entry exit
          (ConcreteYul.Stmt.seq first second) =
        none ->
      compileStmtFuelFrom fuel layout first = some firstGen ->
        depthOf next =
          some (firstGen.outLayout.slots.length + tailDepth)
  seqSecondChecked :
    ∀ {first second firstGen secondOpen},
      stmt = ConcreteYul.Stmt.seq first second ->
      compileCfgStmtOpenFrom (fuel + 1) layout dest entry exit
          (ConcreteYul.Stmt.seq first second) =
        none ->
      compileStmtFuelFrom fuel layout first = some firstGen ->
      compileCfgStmtOpenRecFrom fuel firstGen.outLayout dest next exit
          (next + 1) second =
        some secondOpen ->
        Program.DepthChecked depthOf secondOpen.program

theorem compileCfgStmtOpenRecFrom_programDepthChecked
    {depthOf : DepthEnv} {fuel : Nat} {layout : Layout}
    {dest : ControlDest} {entry exit next : Label}
    {stmt : ConcreteYul.Stmt} {openCfg : OpenCfgCodegen}
    {tailDepth : Nat}
    (hCompile :
      compileCfgStmtOpenRecFrom (fuel + 1) layout dest entry exit next stmt =
        some openCfg)
    (hEntry : depthOf entry = some (layout.slots.length + tailDepth))
    (hExit :
      ∀ {gen},
        compileStmtFuelFrom (fuel + 1) layout stmt = some gen ->
          depthOf exit =
            some (gen.outLayout.slots.length + tailDepth))
    (hControl :
      ∀ {label},
        controlExitLabel? dest stmt = some label ->
          depthOf label = some (layout.slots.length + tailDepth))
    (hIfNext :
      ∀ {cond body},
        stmt = ConcreteYul.Stmt.ifThen cond body ->
          depthOf next = some (layout.slots.length + tailDepth))
    (hIfExit :
      ∀ {cond body},
        stmt = ConcreteYul.Stmt.ifThen cond body ->
          depthOf exit = some (layout.slots.length + tailDepth))
    (hIfBodyChecked :
      ∀ {cond body condCode bodyOpen},
        stmt = ConcreteYul.Stmt.ifThen cond body ->
        compileExprAt layout 0 cond = some condCode ->
        compileCfgStmtOpenRecFrom fuel layout dest next exit
            (next + 1) body =
          some bodyOpen ->
        bodyOpen.outLayout = layout ->
        Program.DepthChecked depthOf bodyOpen.program)
    (hSeqNext :
      ∀ {first second firstGen},
        stmt = ConcreteYul.Stmt.seq first second ->
        compileCfgStmtOpenFrom (fuel + 1) layout dest entry exit
            (ConcreteYul.Stmt.seq first second) =
          none ->
        compileStmtFuelFrom fuel layout first = some firstGen ->
          depthOf next =
            some (firstGen.outLayout.slots.length + tailDepth))
    (hSeqSecondChecked :
      ∀ {first second firstGen secondOpen},
        stmt = ConcreteYul.Stmt.seq first second ->
        compileCfgStmtOpenFrom (fuel + 1) layout dest entry exit
            (ConcreteYul.Stmt.seq first second) =
          none ->
        compileStmtFuelFrom fuel layout first = some firstGen ->
        compileCfgStmtOpenRecFrom fuel firstGen.outLayout dest next exit
            (next + 1) second =
          some secondOpen ->
        Program.DepthChecked depthOf secondOpen.program) :
    Program.DepthChecked depthOf openCfg.program := by
  cases stmt
  case ifThen cond body =>
    exact
      compileCfgStmtOpenRecFrom_if_programDepthChecked
        (depthOf := depthOf) (fuel := fuel) (layout := layout)
        (dest := dest) (entry := entry) (exit := exit)
        (next := next) (cond := cond) (body := body)
        (openCfg := openCfg) (tailDepth := tailDepth)
        hCompile hEntry (hIfNext rfl) (hIfExit rfl)
        (fun hCond hBody hOut =>
          hIfBodyChecked rfl hCond hBody hOut)
  case seq first second =>
    cases hDirect :
        compileCfgStmtOpenFrom (fuel + 1) layout dest entry exit
          (ConcreteYul.Stmt.seq first second) with
    | some cfg =>
        simp [compileCfgStmtOpenRecFrom, hDirect] at hCompile
        cases hCompile
        exact
          compileCfgStmtOpenFrom_programDepthChecked
            (depthOf := depthOf) (fuel := fuel + 1)
            (layout := layout) (dest := dest) (entry := entry)
            (exit := exit) (stmt := ConcreteYul.Stmt.seq first second)
            (cfg := cfg) (tailDepth := tailDepth)
            hDirect hEntry hExit hControl
    | none =>
        exact
          compileCfgStmtOpenRecFrom_seq_fallback_programDepthChecked
            (depthOf := depthOf) (fuel := fuel) (layout := layout)
            (dest := dest) (entry := entry) (exit := exit)
            (next := next) (first := first) (second := second)
            (openCfg := openCfg) (tailDepth := tailDepth)
            hDirect hCompile hEntry
            (fun hFirst => hSeqNext rfl hDirect hFirst)
            (fun hFirst hSecond =>
              hSeqSecondChecked rfl hDirect hFirst hSecond)
  all_goals
    simp [compileCfgStmtOpenRecFrom] at hCompile
    split at hCompile
    · rename_i cfg hOpen
      simp at hCompile
      cases hCompile
      exact
        compileCfgStmtOpenFrom_programDepthChecked
          (depthOf := depthOf) (fuel := fuel + 1)
          (layout := layout) (dest := dest) (entry := entry)
          (exit := exit) (cfg := cfg) (tailDepth := tailDepth)
          hOpen hEntry hExit hControl
    · simp at hCompile

