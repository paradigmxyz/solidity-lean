theorem extendLayout_wf
    {layout : Layout} {name : ConcreteYul.Name}
    (hLayout : layout.WellFormed)
    (hFresh : layout.index? name = none) :
    (extendLayout layout name).WellFormed := by
  exact SlotsDistinct.cons (by simpa [Layout.index?] using hFresh) hLayout

theorem compileLet1From_outLayout_wf
    {layout : Layout} {name : ConcreteYul.Name}
    {init : Option ConcreteYul.Expr} {gen : Codegen}
    (hLayout : layout.WellFormed)
    (hCompile : compileLet1From layout name init = some gen) :
    gen.outLayout.WellFormed := by
  simp [compileLet1From] at hCompile
  cases hFresh : layout.index? name with
  | some index =>
      simp [hFresh] at hCompile
  | none =>
      cases init with
      | none =>
          simp [hFresh] at hCompile
          cases hCompile
          exact extendLayout_wf hLayout hFresh
      | some expr =>
          cases hCode : compileExprAt layout 0 expr with
          | none =>
              simp [hFresh, hCode] at hCompile
          | some code =>
              simp [hFresh, hCode] at hCompile
              cases hCompile
              exact extendLayout_wf hLayout hFresh

theorem compileAssignFrom_outLayout_wf
    {layout : Layout} {name : ConcreteYul.Name}
    {expr : ConcreteYul.Expr} {gen : Codegen}
    (hLayout : layout.WellFormed)
    (hCompile : compileAssignFrom layout name expr = some gen) :
    gen.outLayout.WellFormed := by
  simp [compileAssignFrom] at hCompile
  cases hIndex : layout.index? name with
  | none =>
      simp [hIndex] at hCompile
  | some index =>
      cases hCode : compileExprAt layout 0 expr with
      | none =>
          simp [hIndex, hCode] at hCompile
      | some code =>
          simp [hIndex, hCode] at hCompile
          cases hCompile
          exact hLayout

theorem compileStmtFrom_outLayout_wf
    {layout : Layout} {stmt : ConcreteYul.Stmt} {gen : Codegen}
    (hLayout : layout.WellFormed)
    (hCompile : compileStmtFrom layout stmt = some gen) :
    gen.outLayout.WellFormed := by
  cases stmt with
  | skip =>
      simp [compileStmtFrom] at hCompile
      cases hCompile
      exact hLayout
  | expr expr =>
      simp [compileStmtFrom] at hCompile
      cases hCode : compileExprStmtAt layout expr with
      | none =>
          simp [hCode] at hCompile
      | some code =>
          simp [hCode] at hCompile
          cases hCompile
          exact hLayout
  | let1 name init =>
      exact compileLet1From_outLayout_wf hLayout hCompile
  | letMany names init =>
      simp [compileStmtFrom, compileLetManyFrom] at hCompile
      cases init with
      | some exprs =>
          by_cases hLen : names.length = exprs.length
          · simp [hLen] at hCompile
            cases hExprs : compileExprsAt layout 0 exprs with
            | none =>
                simp [hExprs] at hCompile
            | some code =>
                cases hExtend : extendLayoutMany? layout names with
                | none =>
                    simp [hExprs, hExtend] at hCompile
                | some outLayout =>
                    simp [hExprs, hExtend] at hCompile
                    cases hCompile
                    exact extendLayoutMany?_wellFormed hLayout hExtend
          · simp [hLen] at hCompile
      | none =>
          cases hExtend : extendLayoutMany? layout names with
          | none =>
              simp [hExtend] at hCompile
          | some outLayout =>
              simp [hExtend] at hCompile
              cases hCompile
              exact extendLayoutMany?_wellFormed hLayout hExtend
  | funDef name params returns body =>
      simp [compileStmtFrom] at hCompile
      cases hCompile
      exact hLayout
  | assign name expr =>
      exact compileAssignFrom_outLayout_wf hLayout hCompile
  | assignMany names exprs =>
      simp [compileStmtFrom, compileAssignManyFrom] at hCompile
      by_cases hLen : names.length = exprs.length
      · simp [hLen] at hCompile
        cases hExprs : compileExprsSourceAt layout 0 exprs with
        | none =>
            simp [hExprs] at hCompile
        | some exprCode =>
            cases hStores : compileStoresSourceFromTop? layout names with
            | none =>
                simp [hExprs, hStores] at hCompile
            | some storeCode =>
                simp [hExprs, hStores] at hCompile
                cases hCompile
                exact hLayout
      · simp [hLen] at hCompile
  | letCall names fnName args =>
      simp [compileStmtFrom] at hCompile
  | assignCall names fnName args =>
      simp [compileStmtFrom] at hCompile
  | seq first second =>
      simp [compileStmtFrom] at hCompile
  | block stmts =>
      simp [compileStmtFrom] at hCompile
  | ifThen cond body =>
      simp [compileStmtFrom] at hCompile
  | switch discr cases defaultBranch =>
      simp [compileStmtFrom] at hCompile
  | forLoop pre cond post body =>
      simp [compileStmtFrom] at hCompile
  | «break» =>
      simp [compileStmtFrom] at hCompile
  | «continue» =>
      simp [compileStmtFrom] at hCompile
  | «leave» =>
      simp [compileStmtFrom] at hCompile

theorem compileFuelFrom_outLayout_wf_pair (compileFuel : Nat) :
    (∀ {layout : Layout} {stmt : ConcreteYul.Stmt} {gen : Codegen},
      layout.WellFormed ->
      compileStmtFuelFrom compileFuel layout stmt = some gen ->
      gen.outLayout.WellFormed) ∧
    (∀ {layout : Layout} {stmts : List ConcreteYul.Stmt} {gen : Codegen},
      layout.WellFormed ->
      compileBlockFuelBodyFrom compileFuel layout stmts = some gen ->
      gen.outLayout.WellFormed) := by
  induction compileFuel with
  | zero =>
      constructor
      · intro layout stmt gen hLayout hCompile
        simp [compileStmtFuelFrom] at hCompile
      · intro layout stmts gen hLayout hCompile
        simp [compileBlockFuelBodyFrom] at hCompile
  | succ compileFuel ih =>
      constructor
      · intro layout stmt gen hLayout hCompile
        cases stmt with
        | seq first second =>
            simp [compileStmtFuelFrom] at hCompile
            cases hFirst :
                compileStmtFuelFrom compileFuel layout first with
            | none =>
                simp [hFirst] at hCompile
            | some firstGen =>
                cases hSecond :
                    compileStmtFuelFrom compileFuel firstGen.outLayout
                      second with
                | none =>
                    simp [hFirst, hSecond] at hCompile
                | some secondGen =>
                    simp [hFirst, hSecond] at hCompile
                    cases hCompile
                    simpa using
                      (ih.1 (layout := firstGen.outLayout)
                        (stmt := second) (gen := secondGen)
                        (ih.1 hLayout hFirst) hSecond)
        | block stmts =>
            simp [compileStmtFuelFrom] at hCompile
            cases hBody :
                compileBlockFuelBodyFrom compileFuel layout stmts with
            | none =>
                simp [hBody] at hCompile
            | some bodyGen =>
                simp [hBody] at hCompile
                cases hCompile
                exact hLayout
        | skip =>
            exact compileStmtFrom_outLayout_wf hLayout hCompile
        | expr expr =>
            exact compileStmtFrom_outLayout_wf hLayout hCompile
        | let1 name init =>
            exact compileStmtFrom_outLayout_wf hLayout hCompile
        | letMany names init =>
            exact compileStmtFrom_outLayout_wf hLayout hCompile
        | funDef name params returns body =>
            exact compileStmtFrom_outLayout_wf hLayout hCompile
        | assign name expr =>
            exact compileStmtFrom_outLayout_wf hLayout hCompile
        | assignMany names exprs =>
            exact compileStmtFrom_outLayout_wf hLayout hCompile
        | letCall names fnName args =>
            exact compileStmtFrom_outLayout_wf hLayout hCompile
        | assignCall names fnName args =>
            exact compileStmtFrom_outLayout_wf hLayout hCompile
        | ifThen cond body =>
            exact compileStmtFrom_outLayout_wf hLayout hCompile
        | switch discr cases defaultBranch =>
            exact compileStmtFrom_outLayout_wf hLayout hCompile
        | forLoop pre cond post body =>
            exact compileStmtFrom_outLayout_wf hLayout hCompile
        | «break» =>
            exact compileStmtFrom_outLayout_wf hLayout hCompile
        | «continue» =>
            exact compileStmtFrom_outLayout_wf hLayout hCompile
        | «leave» =>
            exact compileStmtFrom_outLayout_wf hLayout hCompile
      · intro layout stmts gen hLayout hCompile
        cases stmts with
        | nil =>
            simp [compileBlockFuelBodyFrom] at hCompile
            cases hCompile
            exact hLayout
        | cons stmt rest =>
            simp [compileBlockFuelBodyFrom] at hCompile
            cases hStmt :
                compileStmtFuelFrom compileFuel layout stmt with
            | none =>
                simp [hStmt] at hCompile
            | some stmtGen =>
                cases hRest :
                    compileBlockFuelBodyFrom compileFuel stmtGen.outLayout
                      rest with
                | none =>
                    simp [hStmt, hRest] at hCompile
                | some restGen =>
                    simp [hStmt, hRest] at hCompile
                    cases hCompile
                    simpa using
                      (ih.2 (layout := stmtGen.outLayout)
                        (stmts := rest) (gen := restGen)
                        (ih.1 hLayout hStmt) hRest)

theorem compileStmtFuelFrom_outLayout_wf
    {compileFuel : Nat} {layout : Layout} {stmt : ConcreteYul.Stmt}
    {gen : Codegen}
    (hLayout : layout.WellFormed)
    (hCompile : compileStmtFuelFrom compileFuel layout stmt = some gen) :
    gen.outLayout.WellFormed :=
