theorem compileControlExitTo_extends_cfg_correct
    {dest : ControlDest} {layout : Layout} {stmt : ConcreteYul.Stmt}
    {hash : ConcreteYul.HashOracle} {fuel : Nat}
    {source : ConcreteYul.Config} {result : ConcreteYul.Result}
    {tail : Stack} {target : TargetState} {entry label : Label}
    {program : Program}
    (hExtends : Program.Extends (jumpOnlyToProgram entry label) program)
    (hControl : controlExitLabel? dest stmt = some label)
    (hEval :
      ConcreteYul.evalStmtFuel hash fuel.succ source stmt = some result)
    (hRel : StackRel layout source [] tail target) :
    ∃ target',
      flowLabel? dest result.flow = some label ∧
        Reaches program (Config.at entry target)
          (Config.at label target') ∧
        StackRel layout result.config [] tail target' := by
  have hLookup :
      lookupBlock? (jumpOnlyToProgram entry label) entry =
        some ({ body := [], term := Term.jump label } : Block) := by
    simp [jumpOnlyToProgram, lookupBlock?]
  have hStep :
      step (jumpOnlyToProgram entry label) (Config.at entry target) =
        Config.at label target := by
    simp [jumpOnlyToProgram, step, lookupBlock?, execList, execTerm]
  cases stmt with
  | skip =>
      simp [controlExitLabel?] at hControl
  | expr expr =>
      simp [controlExitLabel?] at hControl
  | let1 name init =>
      simp [controlExitLabel?] at hControl
  | letMany names init =>
      simp [controlExitLabel?] at hControl
  | funDef name params returns body =>
      simp [controlExitLabel?] at hControl
  | assign name expr =>
      simp [controlExitLabel?] at hControl
  | assignMany names exprs =>
      simp [controlExitLabel?] at hControl
  | letCall names fnName args =>
      simp [controlExitLabel?] at hControl
  | assignCall names fnName args =>
      simp [controlExitLabel?] at hControl
  | seq first second =>
      simp [controlExitLabel?] at hControl
  | block stmts =>
      simp [controlExitLabel?] at hControl
  | ifThen cond body =>
      simp [controlExitLabel?] at hControl
  | switch discr cases defaultBranch =>
      simp [controlExitLabel?] at hControl
  | forLoop pre cond post body =>
      simp [controlExitLabel?] at hControl
  | «break» =>
      simp [controlExitLabel?] at hControl
      cases hControl
      simp [ConcreteYul.evalStmtFuel] at hEval
      cases hEval
      refine ⟨target, rfl, ?_, hRel⟩
      exact reaches_one_of_extends_at hExtends hLookup hStep
  | «continue» =>
      simp [controlExitLabel?] at hControl
      cases hControl
      simp [ConcreteYul.evalStmtFuel] at hEval
      cases hEval
      refine ⟨target, rfl, ?_, hRel⟩
      exact reaches_one_of_extends_at hExtends hLookup hStep
  | «leave» =>
      simp [controlExitLabel?] at hControl
      cases hControl
      simp [ConcreteYul.evalStmtFuel] at hEval
      cases hEval
      refine ⟨target, rfl, ?_, hRel⟩
      exact reaches_one_of_extends_at hExtends hLookup hStep

theorem compileCfgStmtOpenFrom_to_extends_cfg_correct
    {compileFuel : Nat} {layout : Layout} {stmt : ConcreteYul.Stmt}
    {dest : ControlDest} {entry exit : Label} {cfg : CfgCodegen}
    {program : Program} {hash : ConcreteYul.HashOracle} {evalFuel : Nat}
    {source : ConcreteYul.Config} {result : ConcreteYul.Result}
    {tail : Stack} {target : TargetState}
    (hExtends : Program.Extends cfg.program program)
    (hLayout : layout.WellFormed)
    (hCompile :
      compileCfgStmtOpenFrom compileFuel layout dest entry exit stmt =
        some cfg)
    (hEval :
      ConcreteYul.evalStmtFuel hash evalFuel.succ source stmt = some result)
    (hNoHalt : source.state.halt? = none)
    (hRel : StackRel layout source [] tail target) :
    ∃ target' label,
      flowOrExitLabel? dest exit result.flow = some label ∧
        Reaches program (Config.at entry target)
          (Config.at label target') ∧
        StackRel cfg.outLayout result.config [] tail target' := by
  simp [compileCfgStmtOpenFrom] at hCompile
  cases hControl : controlExitLabel? dest stmt with
  | some label =>
      simp [hControl] at hCompile
      cases hCompile
      rcases
        compileControlExitTo_extends_cfg_correct
          (dest := dest) (layout := layout) (stmt := stmt)
          (program := program) (hash := hash) (fuel := evalFuel)
          (source := source) (result := result) (tail := tail)
          (target := target) (entry := entry) (label := label)
          hExtends hControl hEval hRel with
      ⟨target', hFlow, hReach, hRel'⟩
      exact
        ⟨target', label, flowOrExitLabel?_of_flowLabel? hFlow,
          hReach, hRel'⟩
  | none =>
      simp [hControl] at hCompile
      cases hStmtCompile :
          compileStmtFuelFrom compileFuel layout stmt with
      | none =>
          simp [hStmtCompile] at hCompile
      | some gen =>
          simp [hStmtCompile] at hCompile
          cases hCompile
          rcases
            compileStmtFuelFrom_to_extends_cfg_correct hExtends hLayout
              hStmtCompile hEval hNoHalt hRel with
          ⟨target', hReach, hRel', hFlow⟩
          exact ⟨target', exit, by simp [flowOrExitLabel?, hFlow],
            hReach, hRel'⟩

theorem compileIfThenOpenFrom_to_cfg_correct
    {compileFuel : Nat} {layout : Layout}
    {dest : ControlDest} {entry thenLabel exit : Label}
    {cond : ConcreteYul.Expr} {body : ConcreteYul.Stmt}
    {cfg : CfgCodegen} {hash : ConcreteYul.HashOracle} {evalFuel : Nat}
    {source : ConcreteYul.Config} {result : ConcreteYul.Result}
    {tail : Stack} {target : TargetState}
    (hEntryThen : entry ≠ thenLabel)
    (hLayout : layout.WellFormed)
    (hCompile :
      compileIfThenOpenFrom compileFuel layout dest entry thenLabel exit
        cond body =
        some cfg)
    (hEval :
      ConcreteYul.evalStmtFuel hash evalFuel.succ.succ source
        (ConcreteYul.Stmt.ifThen cond body) =
        some result)
    (hNoHalt : source.state.halt? = none)
    (hRel : StackRel layout source [] tail target) :
    ∃ target' label,
      flowOrExitLabel? dest exit result.flow = some label ∧
        Reaches cfg.program (Config.at entry target)
          (Config.at label target') ∧
        StackRel cfg.outLayout result.config [] tail target' := by
  simp [compileIfThenOpenFrom] at hCompile
  cases hCondCode : compileExprAt layout 0 cond with
  | none =>
      simp [hCondCode] at hCompile
  | some condCode =>
      cases hBodyCompile :
          compileCfgStmtOpenFrom compileFuel layout dest thenLabel exit
            body with
      | none =>
          simp [hCondCode, hBodyCompile] at hCompile
      | some bodyCfg =>
          by_cases hBodyOut : bodyCfg.outLayout = layout
          · simp [hCondCode, hBodyCompile, hBodyOut] at hCompile
            cases hCompile
            simp [ConcreteYul.evalStmtFuel] at hEval
            cases hCondEval : ConcreteYul.evalExpr hash cond source with
            | none =>
                simp [hCondEval] at hEval
            | some condResult =>
                cases condResult with
                | mk condValue condConfig =>
                    simp [hCondEval] at hEval
                    have hCondConfigEq : condConfig = source :=
                      compileExprAt_eval_config_eq hCondCode hCondEval
                    have hCondNoHalt :
                        condConfig.state.halt? = none := by
                      simpa [hCondConfigEq] using hNoHalt
                    rcases
                      compileExprAt_execList_correct hCondCode hCondEval
                        hRel with
                    ⟨condTarget, hCondExec, hCondRel⟩
                    let branchTarget : TargetState :=
                      { condTarget with
                        stack := frameOf layout condConfig.env ++ tail }
                    have hBranchRel :
                        StackRel layout condConfig [] tail branchTarget :=
                      stackRel_drop_word_temp hCondRel
                    by_cases hZero : norm condValue = 0
                    · simp [hZero, ConcreteYul.normalResult] at hEval
                      cases hEval
                      refine ⟨branchTarget, exit, rfl, ?_, ?_⟩
                      · apply reaches_one
                        simp [step, lookupBlock?, hCondExec, execTerm,
                          hCondRel.stack_eq, branchTarget, hZero]
                      · simpa using hBranchRel
                    · simp [hZero] at hEval
                      have hBodyNoEntry :
                          lookupBlock? bodyCfg.program entry = none :=
                        compileCfgStmtOpenFrom_lookup_none_of_ne
                          (entry := thenLabel) (label := entry)
                          (exit := exit) (cfg := bodyCfg)
                          (stmt := body) (dest := dest)
                          (compileFuel := compileFuel) (layout := layout)
                          hEntryThen.symm hBodyCompile
                      have hBodyExtends :
                          Program.Extends bodyCfg.program
                            ([(entry,
                              { body := condCode
                                term := Term.branchNZ thenLabel exit })] ++
                              bodyCfg.program) := by
                        apply Program.extends_append_left_of_fresh
                        intro label block hLookup
                        by_cases hEntryLabel : entry = label
                        · subst label
                          simp [hBodyNoEntry] at hLookup
                        · simp [lookupBlock?, hEntryLabel]
                      rcases
                        compileCfgStmtOpenFrom_to_extends_cfg_correct
                          (cfg := bodyCfg)
                          (program :=
                            [(entry,
                              { body := condCode
                                term := Term.branchNZ thenLabel exit })] ++
                              bodyCfg.program)
                          hBodyExtends hLayout hBodyCompile hEval
                          hCondNoHalt hBranchRel with
                      ⟨bodyTarget, label, hFlowLabel, hBodyReach,
                        hBodyRel⟩
                      refine ⟨bodyTarget, label, hFlowLabel, ?_, ?_⟩
                      · refine
                          Reaches.step
                            (next := Config.at thenLabel branchTarget) ?_
                            hBodyReach
                        simp [step, lookupBlock?, hCondExec, execTerm,
                          hCondRel.stack_eq, branchTarget, hZero]
                      · simpa [hBodyOut] using hBodyRel
          · simp [hCondCode, hBodyCompile, hBodyOut] at hCompile

