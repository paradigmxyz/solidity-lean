      (caseLabelStart := caseLabelStart) (joinLabel := joinLabel)
      (tailDepth := tailDepth)
      hCases hCaseDepth hJoin
  have hTestPrograms :
      Program.DepthChecked depthOf
        (switchChainTestBlocksFrom testLabelStart caseLabelStart
          fallbackLabel caseCodes) :=
    switchChainTestBlocksFrom_depthChecked
      (depthOf := depthOf) (layout := layout) (cases := caseCodes)
      (testLabelStart := testLabelStart)
      (caseLabelStart := caseLabelStart)
      (fallbackLabel := fallbackLabel) (tailDepth := tailDepth)
