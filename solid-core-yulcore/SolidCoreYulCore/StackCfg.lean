theorem compileCfgStmtOpenCtxAutoFrom_outLayout_wf
    {fuel : Nat} {layout : Layout} {ctx : ControlCtx}
    {entry normalLabel : Label} {stmt : ConcreteYul.Stmt}
    {cfg : CfgCodegen}
    (hLayout : layout.WellFormed)
    (hCompile :
      compileCfgStmtOpenCtxAutoFrom fuel layout ctx entry normalLabel stmt =
