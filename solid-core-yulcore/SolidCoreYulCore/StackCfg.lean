      ∀ {preGen},
        compileStmtFuelFrom fuel layout pre = some preGen ->
          depthOf 1 =
            some (preGen.outLayout.slots.length + tailDepth))
    (h2 :
      ∀ {preGen},
        compileStmtFuelFrom fuel layout pre = some preGen ->
          depthOf 2 =
            some (preGen.outLayout.slots.length + tailDepth))
