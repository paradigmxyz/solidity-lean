theorem evalFunctionFuel_restores_caller_env
    {hash : ConcreteYul.HashOracle} {funcs : ConcreteYul.FunctionEnv}
    {fuel : Nat} {fnName : ConcreteYul.Name}
    {args returnValues : List Word}
    {callerConfig resultConfig : ConcreteYul.Config}
    (hEval :
      ConcreteYul.evalFunctionFuel hash funcs fuel fnName args
        callerConfig =
        some (returnValues, resultConfig)) :
    resultConfig.env = callerConfig.env := by
  cases fuel with
  | zero =>
      simp [ConcreteYul.evalFunctionFuel] at hEval
  | succ fuel =>
      simp [ConcreteYul.evalFunctionFuel] at hEval
      cases hLookup : ConcreteYul.lookupFunction? funcs fnName with
      | none =>
          simp [hLookup] at hEval
      | some fn =>
          cases hInit :
              ConcreteYul.initFunctionEnv fn.params args fn.returns with
          | none =>
              simp [hLookup, hInit] at hEval
          | some callEnv =>
              cases hBody :
                  ConcreteYul.evalProgramStmtFuel hash funcs fuel
                    { callerConfig with env := callEnv } fn.body with
              | none =>
                  simp [hLookup, hInit, hBody] at hEval
              | some bodyResult =>
                  cases bodyResult with
                  | mk flow bodyConfig =>
                      cases flow <;>
                        simp [hLookup, hInit, hBody] at hEval
                      · cases hValues :
                            ConcreteYul.valuesForNames? bodyConfig.env
                              fn.returns with
                        | none =>
                            simp [hValues] at hEval
                        | some values =>
                            simp [hValues] at hEval
                            rcases hEval with ⟨_hReturns, hConfig⟩
                            rw [← hConfig]
                      · cases hValues :
                            ConcreteYul.valuesForNames? bodyConfig.env
                              fn.returns with
                        | none =>
                            simp [hValues] at hEval
                        | some values =>
                            simp [hValues] at hEval
                            rcases hEval with ⟨_hReturns, hConfig⟩
                            rw [← hConfig]

theorem compileLetCallFrom_callSem_cfg_correct
    {layout : Layout} {names : List ConcreteYul.Name}
    {fnName : ConcreteYul.Name} {args : List ConcreteYul.Expr}
    {cfg : CfgCodegen} {callSem : CallSem}
    {hash : ConcreteYul.HashOracle} {funcs : ConcreteYul.FunctionEnv}
    {evalFuel : Nat}
    {source : ConcreteYul.Config} {result : ConcreteYul.Result}
    {tail : Stack} {target : TargetState}
    (hCompile : compileLetCallFrom layout names fnName args = some cfg)
    (hCall : CallSemCorrectForConfig hash funcs callSem source
      evalFuel.succ)
    (hEval :
      ConcreteYul.evalProgramStmtFuel hash funcs evalFuel.succ source
        (ConcreteYul.Stmt.letCall names fnName args) = some result)
    (hRel : StackRel layout source [] tail target) :
    ∃ target',
      ReachesWithCalls callSem evalFuel cfg.program
        (Config.at 0 target) (Config.halted target') ∧
        StackRel cfg.outLayout result.config [] tail target' ∧
        result.flow = ConcreteYul.Flow.normal := by
  simp [compileLetCallFrom] at hCompile
  cases hArgCode : compileExprsAt layout 0 args with
  | none =>
      simp [hArgCode] at hCompile
  | some argCode =>
      cases hExtend : extendLayoutMany? layout names with
      | none =>
          simp [hArgCode, hExtend] at hCompile
      | some outLayout =>
          simp [hArgCode, hExtend] at hCompile
          cases hCompile
          simp [ConcreteYul.evalProgramStmtFuel] at hEval
          cases hArgEval : ConcreteYul.evalExprs hash args source with
          | none =>
              simp [hArgEval] at hEval
          | some argResult =>
              cases argResult with
              | mk argValues argSource =>
                  simp [hArgEval] at hEval
                  cases hFun :
                      ConcreteYul.evalFunctionFuel hash funcs evalFuel
                        fnName argValues argSource with
                  | none =>
                      simp [hFun] at hEval
                  | some funResult =>
                      cases funResult with
                      | mk returnValues funConfig =>
                          simp [hFun] at hEval
                          cases hDecl :
                              ConcreteYul.declareMany? funConfig.env names
                                returnValues with
                          | none =>
                              simp [hDecl] at hEval
                          | some declaredEnv =>
                              simp [hDecl, ConcreteYul.normalResult] at hEval
                              cases hEval
                              rcases
                                compileExprsAt_execList_correct hArgCode
                                  hArgEval hRel with
                              ⟨argTarget, hArgExec, hArgRel⟩
                              have hArgLen :
                                  argValues.length = args.length :=
                                evalExprs_length hArgEval
                              have hArgSource : argSource = source :=
                                compileExprsAt_eval_config_eq hArgCode
                                  hArgEval
                              subst argSource
                              have hPop :
                                  popArgWords args.length argTarget.stack =
                                    some
                                      (argValues.map norm,
                                        frameOf layout source.env ++ tail) := by
                                rw [hArgRel.stack_eq]
                                rw [← hArgLen]
                                simpa [List.append_assoc]
                                  using
                                    popArgWords_expr_values argValues
                                      (frameOf layout source.env ++ tail)
                              have hCallResultSource :
                                  callSem evalFuel fnName
                                      (argValues.map norm) source.state =
                                    some (returnValues, funConfig.state) :=
                                hCall (Nat.lt_succ_self evalFuel) hFun
                              have hCallResult :
                                  callSem evalFuel fnName
                                      (argValues.map norm)
                                      argTarget.state =
                                    some (returnValues, funConfig.state) := by
                                simpa [hArgRel.state_eq]
                                  using hCallResultSource
                              have hRetLen :
                                  returnValues.length = names.length :=
                                (declareMany?_length hDecl).symm
                              have hFunEnv :
                                  funConfig.env = source.env :=
                                evalFunctionFuel_restores_caller_env hFun
                              let afterCall : TargetState :=
                                { argTarget with
                                  stack :=
                                    pushReturnWords returnValues
                                      (frameOf layout source.env ++ tail)
                                  state := funConfig.state }
                              let finalTarget : TargetState :=
                                { afterCall with
                                  stack :=
                                    (returnValues.map
                                      (fun value =>
                                        Atom.word (norm value))).reverse ++
                                      frameOf layout source.env ++ tail }
                              have hCallStep :
                                  stepWithCalls callSem evalFuel
                                      (letCallWithCallsProgram argCode fnName
                                        args.length names.length)
                                      (Config.at 0 target) =
                                    Config.at 1 afterCall := by
                                simp [stepWithCalls,
                                  letCallWithCallsProgram, lookupBlock?,
                                  hArgExec]
                                exact
                                  execTermWithCalls_call_success hPop
                                    hCallResult hRetLen
                              have hReverseExec :
                                  execList (reverseTopValuesCode names.length)
                                      afterCall =
                                    some finalTarget := by
                                have hReverse :=
                                  execList_reverseTopValuesCode
                                    (returnValues.map
                                      (fun value =>
                                        Atom.word (norm value)))
                                    (frameOf layout source.env ++ tail)
                                    afterCall
