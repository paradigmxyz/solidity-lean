theorem cleanupJumpTo_cfg_correct
    {fromLayout toLayout : Layout}
    {localSlots : List ConcreteYul.Name}
    {source : ConcreteYul.Config}
    {tail : Stack} {target : TargetState}
    {entry label : Label}
    (hSlots : fromLayout.slots = localSlots ++ toLayout.slots)
    (hRel : StackRel fromLayout source [] tail target) :
    ∃ target',
      Reaches
          (cleanupJumpToProgram entry label localSlots.length)
          (Config.at entry target) (Config.at label target') ∧
        StackRel toLayout source [] tail target' := by
  let poppedTarget : TargetState :=
    { target with stack := frameOf toLayout source.env ++ tail }
  have hTargetEq :
      target =
        { target with
          stack := frameOf fromLayout source.env ++ tail } := by
    cases target
    simpa using hRel.stack_eq
  have hExec :
      execList (popN localSlots.length) target = some poppedTarget := by
    rw [hTargetEq]
    simpa [poppedTarget, frameOf, hSlots, frameOfSlots_append] using
      execList_popN_frameOfSlots localSlots toLayout.slots source.env
        tail target
  have hStep :
      step (cleanupJumpToProgram entry label localSlots.length)
          (Config.at entry target) =
        Config.at label poppedTarget := by
    simp [cleanupJumpToProgram, step, lookupBlock?, hExec, execTerm]
  have hBoundAll :
      SlotsBound (localSlots ++ toLayout.slots) source.env := by
    intro name index hIndex
    exact
      hRel.bound (name := name) (index := index)
        (by simpa [hSlots] using hIndex)
  refine ⟨poppedTarget, reaches_one hStep, ?_⟩
  exact
    { state_eq := by
        simp [poppedTarget, hRel.state_eq]
      stack_eq := by
        simp [poppedTarget]
      bound :=
        SlotsBound.of_append_right
          (left := localSlots) (right := toLayout.slots) hBoundAll }

