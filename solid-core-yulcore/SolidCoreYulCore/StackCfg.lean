theorem evalProgramStmtFuel_eq_evalStmtFuel_of_compileForLoopLinearFrom
    {compileFuel : Nat} {layout : Layout}
    {pre post body : ConcreteYul.Stmt} {cond : ConcreteYul.Expr}
    {cfg : CfgCodegen}
    {hash : ConcreteYul.HashOracle} {funcs : ConcreteYul.FunctionEnv}
    {evalFuel : Nat} {source : ConcreteYul.Config}
    (hCompile :
      compileForLoopLinearFrom compileFuel layout pre cond post body =
        some cfg) :
    ConcreteYul.evalProgramStmtFuel hash funcs evalFuel source
        (ConcreteYul.Stmt.forLoop pre cond post body) =
      ConcreteYul.evalStmtFuel hash evalFuel source
        (ConcreteYul.Stmt.forLoop pre cond post body) := by
  cases evalFuel with
  | zero =>
      simp [ConcreteYul.evalProgramStmtFuel, ConcreteYul.evalStmtFuel]
  | succ evalFuel =>
      simp [compileForLoopLinearFrom] at hCompile
      cases hPreCompile :
          compileStmtFuelFrom compileFuel layout pre with
      | none =>
          simp [hPreCompile] at hCompile
      | some preGen =>
          cases hCondCode : compileExprAt preGen.outLayout 0 cond with
          | none =>
              simp [hPreCompile, hCondCode] at hCompile
          | some condCode =>
              cases hBodyCompile :
                  compileStmtFuelFrom compileFuel preGen.outLayout body with
              | none =>
                  simp [hPreCompile, hCondCode, hBodyCompile] at hCompile
              | some bodyGen =>
                  cases hPostCompile :
                      compileStmtFuelFrom compileFuel preGen.outLayout post with
                  | none =>
                      simp [hPreCompile, hCondCode, hBodyCompile,
                        hPostCompile] at hCompile
                  | some postGen =>
                      by_cases hBodyOut :
                          bodyGen.outLayout = preGen.outLayout
                      · by_cases hPostOut :
                          postGen.outLayout = preGen.outLayout
                        · simp [hPreCompile, hCondCode, hBodyCompile,
                            hPostCompile, hBodyOut, hPostOut] at hCompile
                          cases hCompile
                          simp [ConcreteYul.evalProgramStmtFuel,
                            ConcreteYul.evalStmtFuel]
                          rw [
                            evalProgramStmtFuel_eq_evalStmtFuel_of_compileStmtFuelFrom
                              hPreCompile]
                          cases hPreEval :
                              ConcreteYul.evalStmtFuel hash evalFuel source
                                pre with
                          | none =>
                              rfl
                          | some preResult =>
                              cases preResult with
                              | mk preFlow loopConfig =>
                                  cases preFlow with
                                  | normal =>
                                      simp
                                      exact
                                        evalProgramForFuel_eq_evalForFuel_of_compileStmtFuelFrom
                                          hBodyCompile hPostCompile
                                  | broke =>
                                      simp
                                  | continued =>
                                      simp
                                  | left =>
                                      simp
                                  | halted =>
                                      simp
                        · simp [hPreCompile, hCondCode, hBodyCompile,
                            hPostCompile, hBodyOut, hPostOut] at hCompile
                      · simp [hPreCompile, hCondCode, hBodyCompile,
                          hPostCompile, hBodyOut] at hCompile

