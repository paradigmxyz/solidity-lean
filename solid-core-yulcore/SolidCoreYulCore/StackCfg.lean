theorem compileSwitchChainFrom_two_default_to_cfg_correct
    {compileFuel : Nat} {layout : Layout}
    {entry caseLabelStart joinLabel : Label}
    {discr : ConcreteYul.Expr}
    {firstValue secondValue : Word}
    {firstBody secondBody defaultBody : ConcreteYul.Stmt}
    {cfg : CfgCodegen}
    {hash : ConcreteYul.HashOracle} {evalFuel : Nat}
    {source : ConcreteYul.Config} {result : ConcreteYul.Result}
    {tail : Stack} {target : TargetState}
    (hEntryBefore : entry < caseLabelStart)
    (hLayout : layout.WellFormed)
    (hCompile :
      compileSwitchChainFrom compileFuel layout entry caseLabelStart
        joinLabel discr [(firstValue, firstBody), (secondValue, secondBody)]
        (some defaultBody) =
        some cfg)
    (hEval :
      ConcreteYul.evalStmtFuel hash evalFuel.succ.succ source
        (ConcreteYul.Stmt.switch discr
          [(firstValue, firstBody), (secondValue, secondBody)]
          (some defaultBody)) =
        some result)
    (hNoHalt : source.state.halt? = none)
    (hRel : StackRel layout source [] tail target) :
    ∃ target',
      Reaches cfg.program (Config.at entry target)
        (Config.at joinLabel target') ∧
        StackRel cfg.outLayout result.config [] tail target' ∧
        result.flow = ConcreteYul.Flow.normal := by
  simp [compileSwitchChainFrom, compileSwitchCasesFrom,
    compileSwitchDefaultFrom] at hCompile
  cases hDiscrCode : compileExprAt layout 0 discr with
  | none =>
      simp [hDiscrCode] at hCompile
  | some discrCode =>
      cases hFirstCompile :
          compileStmtFuelFrom compileFuel layout firstBody with
      | none =>
          simp [hDiscrCode, hFirstCompile] at hCompile
      | some firstGen =>
          cases hSecondCompile :
              compileStmtFuelFrom compileFuel layout secondBody with
          | none =>
              simp [hDiscrCode, hFirstCompile, hSecondCompile] at hCompile
          | some secondGen =>
              cases hDefaultCompile :
                  compileStmtFuelFrom compileFuel layout defaultBody with
              | none =>
                  simp [hDiscrCode, hFirstCompile, hSecondCompile,
                    hDefaultCompile] at hCompile
              | some defaultGen =>
                  by_cases hFirstOut : firstGen.outLayout = layout
                  · by_cases hSecondOut : secondGen.outLayout = layout
                    · by_cases hDefaultOut :
                        defaultGen.outLayout = layout
                      · simp [hDiscrCode, hFirstCompile, hSecondCompile,
                          hDefaultCompile, hFirstOut, hSecondOut,
                          hDefaultOut] at hCompile
                        cases hCompile
                        have hStartSecond :
                            caseLabelStart < caseLabelStart + 1 :=
                          Nat.lt_succ_self caseLabelStart
                        have hSecondTestLt :
                            caseLabelStart + 1 < caseLabelStart + 2 :=
                          Nat.lt_succ_self (caseLabelStart + 1)
                        have hTestDefaultLt :
                            caseLabelStart + 2 < caseLabelStart + 3 :=
                          Nat.lt_succ_self (caseLabelStart + 2)
                        have hStartTest :
                            caseLabelStart < caseLabelStart + 2 :=
                          Nat.lt_trans hStartSecond hSecondTestLt
                        have hStartDefault :
                            caseLabelStart < caseLabelStart + 3 :=
                          Nat.lt_trans hStartTest hTestDefaultLt
                        have hSecondDefaultLt :
                            caseLabelStart + 1 < caseLabelStart + 3 :=
                          Nat.lt_trans hSecondTestLt hTestDefaultLt
                        exact
                          compileSwitchTwoDefaultTo_extends_cfg_correct
                            (program :=
                              switchChainAutoToProgram entry caseLabelStart
                                joinLabel discrCode
                                [ { value := firstValue
                                    code := firstGen.code }
                                , { value := secondValue
                                    code := secondGen.code }
                                ]
                                (some defaultGen.code))
                            (hExtends :=
                              switchChainAutoToProgram_twoDefault_extends_switchTwoDefault
                                (entry := entry)
                                (caseLabelStart := caseLabelStart)
                                (joinLabel := joinLabel)
                                (discrCode := discrCode)
                                (firstCode := firstGen.code)
                                (secondCode := secondGen.code)
                                (defaultCode := defaultGen.code)
                                (firstValue := firstValue)
                                (secondValue := secondValue)
                                hEntryBefore)
                            (hEntryFirst := Nat.ne_of_lt hEntryBefore)
                            (hEntryTest :=
                              Nat.ne_of_lt
                                (Nat.lt_trans hEntryBefore hStartTest))
                            (hFirstTest := Nat.ne_of_lt hStartTest)
                            (hEntrySecond :=
                              Nat.ne_of_lt
                                (Nat.lt_trans hEntryBefore hStartSecond))
                            (hFirstSecond := Nat.ne_of_lt hStartSecond)
                            (hTestSecond :=
                              (Nat.ne_of_lt hSecondTestLt).symm)
                            (hEntryDefault :=
                              Nat.ne_of_lt
                                (Nat.lt_trans hEntryBefore hStartDefault))
                            (hFirstDefault := Nat.ne_of_lt hStartDefault)
                            (hTestDefault := Nat.ne_of_lt hTestDefaultLt)
                            (hSecondDefault :=
                              Nat.ne_of_lt hSecondDefaultLt)
                            hLayout hDiscrCode hFirstCompile hSecondCompile
                            hDefaultCompile hFirstOut hSecondOut
                            hDefaultOut hEval hNoHalt hRel
                      · simp [hDiscrCode, hFirstCompile, hSecondCompile,
                          hDefaultCompile, hFirstOut, hSecondOut,
                          hDefaultOut] at hCompile
                    · by_cases hDefaultOut :
                        defaultGen.outLayout = layout
                      · simp [hDiscrCode, hFirstCompile, hSecondCompile,
                          hDefaultCompile, hSecondOut,
                          hDefaultOut] at hCompile
                      · simp [hDiscrCode, hFirstCompile, hSecondCompile,
                          hDefaultCompile, hSecondOut,
                          hDefaultOut] at hCompile
                  · by_cases hSecondOut : secondGen.outLayout = layout
                    · by_cases hDefaultOut :
                        defaultGen.outLayout = layout
                      · simp [hDiscrCode, hFirstCompile, hSecondCompile,
                          hDefaultCompile, hFirstOut, hSecondOut,
                          hDefaultOut] at hCompile
                      · simp [hDiscrCode, hFirstCompile, hSecondCompile,
                          hDefaultCompile, hFirstOut, hSecondOut,
                          hDefaultOut] at hCompile
                    · by_cases hDefaultOut :
                        defaultGen.outLayout = layout
                      · simp [hDiscrCode, hFirstCompile, hSecondCompile,
                          hDefaultCompile, hSecondOut,
                          hDefaultOut] at hCompile
                      · simp [hDiscrCode, hFirstCompile, hSecondCompile,
