def compileForLoopLinearFrom (fuel : Nat) (layout : Layout)
    (pre : ConcreteYul.Stmt) (cond : ConcreteYul.Expr)
    (post body : ConcreteYul.Stmt) : Option CfgCodegen :=
  match compileStmtFuelFrom fuel layout pre with
  | none => none
  | some preGen =>
      match compileExprAt preGen.outLayout 0 cond,
          compileStmtFuelFrom fuel preGen.outLayout body,
          compileStmtFuelFrom fuel preGen.outLayout post with
      | some condCode, some bodyGen, some postGen =>
          if bodyGen.outLayout = preGen.outLayout then
            if postGen.outLayout = preGen.outLayout then
              some
                { program :=
                    forLoopLinearProgram preGen.code condCode bodyGen.code
                      postGen.code
                      (preGen.outLayout.slots.length - layout.slots.length)
                  outLayout := layout }
            else none
          else none
      | _, _, _ => none

def compileCfgStmtFrom (fuel : Nat) (layout : Layout) :
    ConcreteYul.Stmt -> Option CfgCodegen
  | ConcreteYul.Stmt.ifThen cond body =>
      compileIfThenFrom fuel layout cond body
  | ConcreteYul.Stmt.switch discr cases defaultBranch =>
      compileSwitchChainClosedFrom fuel layout discr cases defaultBranch
  | ConcreteYul.Stmt.forLoop pre cond post body =>
      compileForLoopLinearFrom fuel layout pre cond post body
  | stmt => compileLinearCfgStmtFrom fuel layout stmt

def compileCfgStmtWithCallsFrom (fuel : Nat) (layout : Layout) :
    ConcreteYul.Stmt -> Option CfgCodegen
  | ConcreteYul.Stmt.letCall names fnName args =>
      compileLetCallFrom layout names fnName args
  | ConcreteYul.Stmt.assignCall names fnName args =>
      compileAssignCallFrom layout names fnName args
  | stmt => compileCfgStmtFrom fuel layout stmt

theorem compileLinearCfgStmtFrom_callFree
    {fuel : Nat} {layout : Layout} {stmt : ConcreteYul.Stmt}
    {cfg : CfgCodegen}
    (hCompile : compileLinearCfgStmtFrom fuel layout stmt = some cfg) :
    Program.CallFree cfg.program := by
  simp [compileLinearCfgStmtFrom] at hCompile
  cases hGen : compileStmtFuelFrom fuel layout stmt with
  | none =>
      simp [hGen] at hCompile
  | some gen =>
      simp [hGen] at hCompile
      cases hCompile
      exact exprProgram_callFree gen.code

theorem compileIfThenFrom_callFree
    {fuel : Nat} {layout : Layout} {cond : ConcreteYul.Expr}
    {body : ConcreteYul.Stmt} {cfg : CfgCodegen}
    (hCompile : compileIfThenFrom fuel layout cond body = some cfg) :
    Program.CallFree cfg.program := by
  simp [compileIfThenFrom] at hCompile
  cases hCond : compileExprAt layout 0 cond with
  | none =>
      simp [hCond] at hCompile
  | some condCode =>
      cases hBody : compileStmtFuelFrom fuel layout body with
      | none =>
          simp [hCond, hBody] at hCompile
      | some bodyGen =>
          by_cases hOut : bodyGen.outLayout = layout
          · simp [hCond, hBody, hOut] at hCompile
            cases hCompile
            exact ifThenProgram_callFree condCode bodyGen.code
          · simp [hCond, hBody, hOut] at hCompile

theorem compileSwitchChainClosedFrom_callFree
    {fuel : Nat} {layout : Layout} {discr : ConcreteYul.Expr}
    {cases : List (Word × ConcreteYul.Stmt)}
    {defaultBranch : Option ConcreteYul.Stmt} {cfg : CfgCodegen}
    (hCompile :
      compileSwitchChainClosedFrom fuel layout discr cases defaultBranch =
        some cfg) :
    Program.CallFree cfg.program := by
  simp [compileSwitchChainClosedFrom] at hCompile
  cases hDiscr : compileExprAt layout 0 discr with
  | none =>
      simp [hDiscr] at hCompile
  | some discrCode =>
      cases hCases : compileSwitchCasesFrom fuel layout cases with
      | none =>
          simp [hDiscr, hCases] at hCompile
      | some caseCodes =>
          cases hDefault :
              compileSwitchDefaultFrom fuel layout defaultBranch with
          | none =>
              simp [hDiscr, hCases, hDefault] at hCompile
          | some defaultCode? =>
              simp [hDiscr, hCases, hDefault] at hCompile
              cases hCompile
              exact switchChainClosedProgram_callFree discrCode caseCodes
                defaultCode?

theorem compileForLoopLinearFrom_callFree
    {fuel : Nat} {layout : Layout} {pre body post : ConcreteYul.Stmt}
    {cond : ConcreteYul.Expr} {cfg : CfgCodegen}
    (hCompile :
      compileForLoopLinearFrom fuel layout pre cond post body = some cfg) :
    Program.CallFree cfg.program := by
  simp [compileForLoopLinearFrom] at hCompile
  cases hPre : compileStmtFuelFrom fuel layout pre with
  | none =>
      simp [hPre] at hCompile
  | some preGen =>
      cases hCond : compileExprAt preGen.outLayout 0 cond with
      | none =>
          simp [hPre, hCond] at hCompile
      | some condCode =>
          cases hBody :
              compileStmtFuelFrom fuel preGen.outLayout body with
          | none =>
              simp [hPre, hCond, hBody] at hCompile
          | some bodyGen =>
              cases hPost :
                  compileStmtFuelFrom fuel preGen.outLayout post with
              | none =>
                  simp [hPre, hCond, hBody, hPost] at hCompile
              | some postGen =>
                  by_cases hBodyOut :
                      bodyGen.outLayout = preGen.outLayout
                  · by_cases hPostOut :
                        postGen.outLayout = preGen.outLayout
                    · simp [hPre, hCond, hBody, hPost, hBodyOut,
                        hPostOut] at hCompile
                      cases hCompile
                      exact
                        forLoopLinearProgram_callFree preGen.code condCode
                          bodyGen.code postGen.code
                          (preGen.outLayout.slots.length -
                            layout.slots.length)
                    · simp [hPre, hCond, hBody, hPost, hBodyOut,
                        hPostOut] at hCompile
                  · simp [hPre, hCond, hBody, hPost, hBodyOut] at hCompile

theorem compileCfgStmtFrom_callFree
    {fuel : Nat} {layout : Layout} {stmt : ConcreteYul.Stmt}
    {cfg : CfgCodegen}
    (hCompile : compileCfgStmtFrom fuel layout stmt = some cfg) :
    Program.CallFree cfg.program := by
  cases stmt with
  | ifThen cond body =>
      exact compileIfThenFrom_callFree hCompile
  | switch discr cases defaultBranch =>
      exact compileSwitchChainClosedFrom_callFree hCompile
  | forLoop pre cond post body =>
      exact compileForLoopLinearFrom_callFree hCompile
  | skip =>
      exact compileLinearCfgStmtFrom_callFree hCompile
  | expr expr =>
      exact compileLinearCfgStmtFrom_callFree hCompile
  | let1 name init =>
      exact compileLinearCfgStmtFrom_callFree hCompile
  | letMany names init =>
      exact compileLinearCfgStmtFrom_callFree hCompile
  | funDef name params returns body =>
      exact compileLinearCfgStmtFrom_callFree hCompile
  | assign name expr =>
      exact compileLinearCfgStmtFrom_callFree hCompile
  | assignMany names exprs =>
      exact compileLinearCfgStmtFrom_callFree hCompile
  | letCall names fnName args =>
      exact compileLinearCfgStmtFrom_callFree hCompile
  | assignCall names fnName args =>
      exact compileLinearCfgStmtFrom_callFree hCompile
  | seq first second =>
      exact compileLinearCfgStmtFrom_callFree hCompile
  | block stmts =>
      exact compileLinearCfgStmtFrom_callFree hCompile
  | «break» =>
      exact compileLinearCfgStmtFrom_callFree hCompile
  | «continue» =>
      exact compileLinearCfgStmtFrom_callFree hCompile
  | «leave» =>
      exact compileLinearCfgStmtFrom_callFree hCompile

def ProgramCfgBridgeStmt : ConcreteYul.Stmt -> Prop
  | ConcreteYul.Stmt.forLoop _ _ _ _ => False
  | _ => True

theorem frameOfSlots_cons_env_fresh
    {slots : List ConcreteYul.Name} {env : ConcreteYul.Env}
    {name : ConcreteYul.Name} {value : Word}
    (hFresh : indexOf? slots name = none) :
    frameOfSlots slots ((name, value) :: env) = frameOfSlots slots env := by
  induction slots with
  | nil =>
      rfl
  | cons candidate rest ih =>
      by_cases hCandidate : candidate = name
      · subst candidate
        simp [indexOf?] at hFresh
      · have hRest : indexOf? rest name = none := by
          simpa [indexOf?, hCandidate] using hFresh
        have hHead : name ≠ candidate := by
          intro h
          exact hCandidate h.symm
        simp [frameOfSlots, ConcreteYul.lookup?, hHead, ih hRest]

theorem frameOf_extend_declared
    {layout : Layout} {env : ConcreteYul.Env}
    {name : ConcreteYul.Name} {value : Word}
    (hFresh : layout.index? name = none) :
    frameOf (extendLayout layout name) ((name, value) :: env) =
      Atom.word value :: frameOf layout env := by
  simp [frameOf, extendLayout, frameOfSlots,
    ConcreteYul.lookup?, frameOfSlots_cons_env_fresh hFresh]

theorem extendLayout_wellFormed
    {layout : Layout} {name : ConcreteYul.Name}
    (hLayout : layout.WellFormed)
    (hFresh : layout.index? name = none) :
    (extendLayout layout name).WellFormed := by
  exact SlotsDistinct.cons hFresh hLayout

theorem extendLayoutMany?_wellFormed
    {layout outLayout : Layout} {names : List ConcreteYul.Name}
    (hLayout : layout.WellFormed)
    (hExtend : extendLayoutMany? layout names = some outLayout) :
    outLayout.WellFormed := by
  induction names generalizing layout with
  | nil =>
      simp [extendLayoutMany?] at hExtend
      cases hExtend
      exact hLayout
  | cons name rest ih =>
      simp [extendLayoutMany?] at hExtend
      cases hFresh : layout.index? name with
      | some _ =>
          simp [hFresh] at hExtend
      | none =>
          simp [hFresh] at hExtend
          exact
            ih (extendLayout_wellFormed hLayout hFresh) hExtend

theorem extendLayoutMany?_extends
    {layout outLayout : Layout} {names : List ConcreteYul.Name}
    (hExtend : extendLayoutMany? layout names = some outLayout) :
    ∃ pref, outLayout.slots = pref ++ layout.slots := by
  induction names generalizing layout with
  | nil =>
      simp [extendLayoutMany?] at hExtend
      cases hExtend
      exact ⟨[], rfl⟩
  | cons name rest ih =>
      simp [extendLayoutMany?] at hExtend
      cases hFresh : layout.index? name with
      | some _ =>
          simp [hFresh] at hExtend
      | none =>
          simp [hFresh] at hExtend
          rcases ih hExtend with ⟨pref, hPref⟩
          refine ⟨pref ++ [name], ?_⟩
          rw [hPref]
          simp [extendLayout, List.append_assoc]

theorem slotsBound_extend_declared
    {slots : List ConcreteYul.Name} {env : ConcreteYul.Env}
    {name : ConcreteYul.Name} {value : Word}
    (hBound : SlotsBound slots env) :
    SlotsBound (name :: slots) ((name, norm value) :: env) := by
  intro query index hIndex
  by_cases hHead : name = query
  · subst query
    exact ⟨norm value, by simp [ConcreteYul.lookup?]⟩
  · simp [indexOf?, hHead] at hIndex
    cases hRest : indexOf? slots query with
    | none =>
        simp [hRest] at hIndex
    | some restIndex =>
        simp [hRest] at hIndex
        rcases hBound hRest with ⟨found, hFound⟩
        exact
          ⟨found, by
            simp [ConcreteYul.lookup?, hHead, hFound]⟩

theorem extendLayout_bound_declared
    {layout : Layout} {env : ConcreteYul.Env}
    {name : ConcreteYul.Name} {value : Word}
    (hBound : layout.Bound env) :
    (extendLayout layout name).Bound ((name, norm value) :: env) := by
  exact slotsBound_extend_declared hBound

theorem lookup?_assign?_same
    {env env' : ConcreteYul.Env} {name : ConcreteYul.Name}
    {value : Word}
    (hAssign : ConcreteYul.assign? env name value = some env') :
    ConcreteYul.lookup? env' name = some (norm value) := by
  induction env generalizing env' with
  | nil =>
      simp [ConcreteYul.assign?] at hAssign
  | cons binding rest ih =>
      cases binding with
      | mk candidate current =>
          by_cases hName : candidate = name
          · subst candidate
            simp [ConcreteYul.assign?] at hAssign
            cases hAssign
            simp [ConcreteYul.lookup?]
          · simp [ConcreteYul.assign?, hName] at hAssign
            cases hRest : ConcreteYul.assign? rest name value with
            | none =>
                simp [hRest] at hAssign
            | some rest' =>
                simp [hRest] at hAssign
                cases hAssign
                simp [ConcreteYul.lookup?, hName, ih hRest]

theorem lookup?_assign?_other
    {env env' : ConcreteYul.Env} {assigned other : ConcreteYul.Name}
    {value : Word}
    (hAssign : ConcreteYul.assign? env assigned value = some env')
    (hOther : other ≠ assigned) :
    ConcreteYul.lookup? env' other = ConcreteYul.lookup? env other := by
  induction env generalizing env' with
  | nil =>
      simp [ConcreteYul.assign?] at hAssign
  | cons binding rest ih =>
      cases binding with
      | mk candidate current =>
          by_cases hAssigned : candidate = assigned
          · subst candidate
            have hHead : assigned ≠ other := by
              intro h
              exact hOther h.symm
            simp [ConcreteYul.assign?, ConcreteYul.lookup?, hHead] at hAssign ⊢
            cases hAssign
            simp [ConcreteYul.lookup?, hHead]
          · simp [ConcreteYul.assign?, hAssigned] at hAssign
            cases hRest : ConcreteYul.assign? rest assigned value with
            | none =>
                simp [hRest] at hAssign
            | some rest' =>
                simp [hRest] at hAssign
                cases hAssign
                by_cases hCandidate : candidate = other
                · subst candidate
                  simp [ConcreteYul.lookup?]
                · simp [ConcreteYul.lookup?, hCandidate, ih hRest]

theorem slotsBound_assign?
    {slots : List ConcreteYul.Name} {env env' : ConcreteYul.Env}
    {name : ConcreteYul.Name} {value : Word}
    (hBound : SlotsBound slots env)
    (hAssign : ConcreteYul.assign? env name value = some env') :
    SlotsBound slots env' := by
  intro query index hIndex
  by_cases hQuery : query = name
  · subst query
    exact ⟨norm value, lookup?_assign?_same hAssign⟩
  · rcases hBound hIndex with ⟨found, hFound⟩
    exact
      ⟨found, by
        rw [lookup?_assign?_other hAssign hQuery]
        exact hFound⟩

theorem assignMany?_length
    {env env' : ConcreteYul.Env} {names : List ConcreteYul.Name}
    {values : List Word}
    (hAssign :
      ConcreteYul.assignMany? env names values = some env') :
    names.length = values.length := by
  induction names generalizing env values with
  | nil =>
      cases values with
      | nil =>
          rfl
      | cons value rest =>
          simp [ConcreteYul.assignMany?] at hAssign
  | cons name rest ih =>
      cases values with
      | nil =>
          simp [ConcreteYul.assignMany?] at hAssign
      | cons value restValues =>
          simp [ConcreteYul.assignMany?] at hAssign
          cases hHead : ConcreteYul.assign? env name value with
          | none =>
              simp [hHead] at hAssign
          | some envHead =>
              simp [hHead] at hAssign
              exact congrArg Nat.succ (ih hAssign)

theorem declareMany?_length
    {env env' : ConcreteYul.Env} {names : List ConcreteYul.Name}
    {values : List Word}
    (hDecl :
      ConcreteYul.declareMany? env names values = some env') :
    names.length = values.length := by
  induction names generalizing env values with
  | nil =>
      cases values with
      | nil =>
          rfl
      | cons value rest =>
          simp [ConcreteYul.declareMany?] at hDecl
  | cons name rest ih =>
      cases values with
      | nil =>
          simp [ConcreteYul.declareMany?] at hDecl
      | cons value restValues =>
          simp [ConcreteYul.declareMany?] at hDecl
          cases hHead : ConcreteYul.declare? env name value with
          | none =>
              simp [hHead] at hDecl
          | some envHead =>
              simp [hHead] at hDecl
              exact congrArg Nat.succ (ih hDecl)

theorem declare?_norm
    (env : ConcreteYul.Env) (name : ConcreteYul.Name) (value : Word) :
    ConcreteYul.declare? env name (norm value) =
      ConcreteYul.declare? env name value := by
  unfold ConcreteYul.declare?
  cases ConcreteYul.lookup? env name <;> simp [ConcreteYul.norm_norm]

theorem declareMany?_map_norm_values
    (env : ConcreteYul.Env) (names : List ConcreteYul.Name)
    (values : List Word) :
    ConcreteYul.declareMany? env names (values.map norm) =
      ConcreteYul.declareMany? env names values := by
  induction names generalizing env values with
  | nil =>
      cases values <;> rfl
  | cons name rest ih =>
      cases values with
      | nil =>
          rfl
      | cons value restValues =>
          simp [ConcreteYul.declareMany?]
          rw [declare?_norm]
          cases hDecl : ConcreteYul.declare? env name value with
          | none =>
              rfl
          | some envHead =>
              exact ih envHead restValues

theorem initFunctionEnv_norm_args
    (params returns : List ConcreteYul.Name) (args : List Word) :
    ConcreteYul.initFunctionEnv params (args.map norm) returns =
      ConcreteYul.initFunctionEnv params args returns := by
  unfold ConcreteYul.initFunctionEnv
  rw [declareMany?_map_norm_values]

theorem evalFunctionFuel_norm_args
    (hash : ConcreteYul.HashOracle) (funcs : ConcreteYul.FunctionEnv)
    (fuel : Nat) (fnName : ConcreteYul.Name)
    (args : List Word) (callerConfig : ConcreteYul.Config) :
    ConcreteYul.evalFunctionFuel hash funcs fuel fnName
        (args.map norm) callerConfig =
      ConcreteYul.evalFunctionFuel hash funcs fuel fnName args
        callerConfig := by
  cases fuel with
  | zero =>
      rfl
  | succ fuel =>
      simp [ConcreteYul.evalFunctionFuel, initFunctionEnv_norm_args]

theorem evalFunctionFuel_replace_env
    (hash : ConcreteYul.HashOracle) (funcs : ConcreteYul.FunctionEnv)
    (fuel : Nat) (fnName : ConcreteYul.Name) (args : List Word)
    (callerConfig : ConcreteYul.Config) (env : ConcreteYul.Env) :
    ConcreteYul.evalFunctionFuel hash funcs fuel fnName args
        ({ callerConfig with env := env } : ConcreteYul.Config) =
      match
        ConcreteYul.evalFunctionFuel hash funcs fuel fnName args
          callerConfig with
      | some (values, resultConfig) =>
          some (values, { resultConfig with env := env })
      | none => none := by
  cases fuel with
  | zero =>
      rfl
  | succ fuel =>
      cases hLookup : ConcreteYul.lookupFunction? funcs fnName with
      | none =>
          simp [ConcreteYul.evalFunctionFuel, hLookup]
      | some fn =>
          cases hInit :
              ConcreteYul.initFunctionEnv fn.params args fn.returns with
          | none =>
              simp [ConcreteYul.evalFunctionFuel, hLookup, hInit]
          | some callEnv =>
              cases hBody :
                  ConcreteYul.evalProgramStmtFuel hash funcs fuel
                    ({ callerConfig with env := callEnv } :
                      ConcreteYul.Config)
                    fn.body with
              | none =>
                  simp [ConcreteYul.evalFunctionFuel, hLookup, hInit,
                    hBody]
              | some bodyResult =>
                  cases bodyResult with
                  | mk flow bodyConfig =>
                      cases flow
                      · cases hValues :
                            ConcreteYul.valuesForNames? bodyConfig.env
                              fn.returns with
                        | none =>
                            simp [ConcreteYul.evalFunctionFuel, hLookup,
                              hInit, hBody, hValues]
                        | some values =>
                            simp [ConcreteYul.evalFunctionFuel, hLookup,
                              hInit, hBody, hValues]
                      · simp [ConcreteYul.evalFunctionFuel, hLookup,
                          hInit, hBody]
                      · simp [ConcreteYul.evalFunctionFuel, hLookup,
                          hInit, hBody]
                      · cases hValues :
                            ConcreteYul.valuesForNames? bodyConfig.env
                              fn.returns with
                        | none =>
                            simp [ConcreteYul.evalFunctionFuel, hLookup,
                              hInit, hBody, hValues]
                        | some values =>
                            simp [ConcreteYul.evalFunctionFuel, hLookup,
                              hInit, hBody, hValues]
                      · simp [ConcreteYul.evalFunctionFuel, hLookup,
                          hInit, hBody]

def sourceBackedCallSemAtObject (hash : ConcreteYul.HashOracle)
    (funcs : ConcreteYul.FunctionEnv) (object : ConcreteYul.Object) :
    CallSem :=
  fun fuel fnName args state =>
    match
      ConcreteYul.evalFunctionFuel hash funcs fuel fnName args
        ({ env := [], state := state, object := object } :
          ConcreteYul.Config) with
    | some (returns, resultConfig) => some (returns, resultConfig.state)
    | none => none

def sourceBackedContextualCallSem (hash : ConcreteYul.HashOracle)
    (funcs : ConcreteYul.FunctionEnv) : ContextualCallSem :=
  fun fuel ctx fnName args state =>
    sourceBackedCallSemAtObject hash funcs ctx.object fuel fnName args state

theorem sourceBackedCallSemAtObject_correctBelowAtObject
    {hash : ConcreteYul.HashOracle} {funcs : ConcreteYul.FunctionEnv}
    {object : ConcreteYul.Object} {fuel : Nat} :
    CallSemCorrectBelowAtObject hash funcs
      (sourceBackedCallSemAtObject hash funcs object) object fuel := by
  intro m fnName args callerConfig returnValues resultConfig _hLt hObject
    hEval
  unfold sourceBackedCallSemAtObject
  have hEvalEmpty :
      ConcreteYul.evalFunctionFuel hash funcs m fnName args
          ({ callerConfig with env := [] } : ConcreteYul.Config) =
        some (returnValues, { resultConfig with env := [] }) := by
    rw [evalFunctionFuel_replace_env]
    rw [hEval]
  have hEvalEmptyNorm :
      ConcreteYul.evalFunctionFuel hash funcs m fnName (args.map norm)
          ({ callerConfig with env := [] } : ConcreteYul.Config) =
        some (returnValues, { resultConfig with env := [] }) := by
    rw [evalFunctionFuel_norm_args]
    exact hEvalEmpty
  have hConfigEq :
      ({ env := [], state := callerConfig.state, object := object } :
        ConcreteYul.Config) =
      ({ callerConfig with env := [] } : ConcreteYul.Config) := by
    cases callerConfig
    simp_all
  rw [hConfigEq]
  rw [hEvalEmptyNorm]

theorem sourceBackedContextualCallSem_correctBelowAt
    {hash : ConcreteYul.HashOracle} {funcs : ConcreteYul.FunctionEnv}
    {ctx : CallContext} {fuel : Nat} :
    ContextualCallSemCorrectBelowAt hash funcs
      (sourceBackedContextualCallSem hash funcs) ctx fuel := by
  exact sourceBackedCallSemAtObject_correctBelowAtObject

theorem lookup?_restoreOuter_of_lookup?
    {outer inner restored : ConcreteYul.Env}
    {name : ConcreteYul.Name} {old : Word}
    (hRestore : ConcreteYul.restoreOuter outer inner = some restored)
    (hLookup : ConcreteYul.lookup? outer name = some old) :
    ConcreteYul.lookup? restored name =
      ConcreteYul.lookup? inner name := by
  induction outer generalizing restored with
  | nil =>
      simp [ConcreteYul.lookup?] at hLookup
  | cons binding rest ih =>
      cases binding with
      | mk candidate current =>
          simp [ConcreteYul.restoreOuter] at hRestore
          cases hInner : ConcreteYul.lookup? inner candidate with
          | none =>
              simp [hInner] at hRestore
          | some innerValue =>
              cases hRest :
                  ConcreteYul.restoreOuter rest inner with
              | none =>
                  simp [hInner, hRest] at hRestore
              | some restoredRest =>
                  simp [hInner, hRest] at hRestore
                  cases hRestore
                  by_cases hCandidate : candidate = name
                  · subst candidate
                    simp [ConcreteYul.lookup?, hInner]
                  · simp [ConcreteYul.lookup?, hCandidate] at hLookup ⊢
                    exact ih hRest hLookup

theorem lookup?_restoreOuter_some_of_lookup?
    {outer inner restored : ConcreteYul.Env}
    {name : ConcreteYul.Name} {old : Word}
    (hRestore : ConcreteYul.restoreOuter outer inner = some restored)
    (hLookup : ConcreteYul.lookup? outer name = some old) :
    ∃ value, ConcreteYul.lookup? restored name = some value := by
  induction outer generalizing restored with
  | nil =>
      simp [ConcreteYul.lookup?] at hLookup
  | cons binding rest ih =>
      cases binding with
      | mk candidate current =>
          simp [ConcreteYul.restoreOuter] at hRestore
          cases hInner : ConcreteYul.lookup? inner candidate with
          | none =>
              simp [hInner] at hRestore
          | some innerValue =>
              cases hRest :
                  ConcreteYul.restoreOuter rest inner with
              | none =>
                  simp [hInner, hRest] at hRestore
              | some restoredRest =>
                  simp [hInner, hRest] at hRestore
                  cases hRestore
                  by_cases hCandidate : candidate = name
                  · subst candidate
                    exact ⟨innerValue, by simp [ConcreteYul.lookup?]⟩
                  · simp [ConcreteYul.lookup?, hCandidate] at hLookup ⊢
                    exact ih hRest hLookup

theorem slotsBound_restoreOuter
    {slots : List ConcreteYul.Name} {outer inner restored : ConcreteYul.Env}
    (hBound : SlotsBound slots outer)
    (hRestore : ConcreteYul.restoreOuter outer inner = some restored) :
    SlotsBound slots restored := by
  intro name index hIndex
  rcases hBound hIndex with ⟨old, hLookup⟩
  exact lookup?_restoreOuter_some_of_lookup? hRestore hLookup

theorem frameOfSlots_restoreOuter
    {slots : List ConcreteYul.Name} {outer inner restored : ConcreteYul.Env}
    (hDistinct : SlotsDistinct slots)
    (hBound : SlotsBound slots outer)
    (hRestore : ConcreteYul.restoreOuter outer inner = some restored) :
    frameOfSlots slots restored = frameOfSlots slots inner := by
  induction slots with
  | nil =>
      rfl
  | cons candidate rest ih =>
      cases hDistinct with
      | cons hFresh hRestDistinct =>
          have hCandidateBound :
              ∃ value, ConcreteYul.lookup? outer candidate = some value :=
            hBound (name := candidate) (index := 0) (by simp [indexOf?])
          rcases hCandidateBound with ⟨old, hOld⟩
          have hHead :
              ConcreteYul.lookup? restored candidate =
                ConcreteYul.lookup? inner candidate :=
            lookup?_restoreOuter_of_lookup? hRestore hOld
          have hRestBound : SlotsBound rest outer := by
            intro name index hIndex
            have hName : candidate ≠ name := by
              intro h
              subst name
              simp [hFresh] at hIndex
            exact
              hBound (name := name) (index := index.succ)
                (by simp [indexOf?, hName, hIndex])
          simp [frameOfSlots, hHead,
            ih hRestDistinct hRestBound]

theorem stackRel_restoreBlockConfig_after_pop
    {layout bodyLayout : Layout}
    {source bodyConfig restoredConfig : ConcreteYul.Config}
    {tail : Stack} {bodyTarget : TargetState}
    {localSlots : List ConcreteYul.Name}
    (hLayout : layout.WellFormed)
    (hOuterBound : layout.Bound source.env)
    (hBodyRel : StackRel bodyLayout bodyConfig [] tail bodyTarget)
    (hBodySlots : bodyLayout.slots = localSlots ++ layout.slots)
    (hRestore :
      ConcreteYul.restoreBlockConfig source bodyConfig = some restoredConfig) :
    ∃ poppedTarget,
      execList
          (popN (bodyLayout.slots.length - layout.slots.length))
          bodyTarget =
        some poppedTarget ∧
        StackRel layout restoredConfig [] tail poppedTarget := by
  have hDropCount :
      bodyLayout.slots.length - layout.slots.length = localSlots.length := by
    rw [hBodySlots]
    simp
  let poppedTarget : TargetState :=
    { bodyTarget with stack := frameOf layout bodyConfig.env ++ tail }
  have hPop :
      execList (popN (bodyLayout.slots.length - layout.slots.length))
          bodyTarget =
        some poppedTarget := by
    have hBodyTargetEq :
        bodyTarget =
          { bodyTarget with
            stack := frameOf bodyLayout bodyConfig.env ++ tail } := by
      cases bodyTarget
      simpa using hBodyRel.stack_eq
    rw [hDropCount]
    rw [hBodyTargetEq]
    simpa [poppedTarget, frameOf, hBodySlots, frameOfSlots_append] using
      execList_popN_frameOfSlots localSlots layout.slots bodyConfig.env
        tail bodyTarget
  have hFrameRestore :
      frameOf layout restoredConfig.env =
        frameOf layout bodyConfig.env := by
    unfold ConcreteYul.restoreBlockConfig at hRestore
    cases hRestoreOuter :
        ConcreteYul.restoreOuter source.env bodyConfig.env with
    | none =>
        simp [hRestoreOuter] at hRestore
    | some restoredEnv =>
        simp [hRestoreOuter] at hRestore
        cases hRestore
        simpa [frameOf] using
          frameOfSlots_restoreOuter hLayout hOuterBound hRestoreOuter
  have hRestoreBound : layout.Bound restoredConfig.env := by
    unfold ConcreteYul.restoreBlockConfig at hRestore
    cases hRestoreOuter :
        ConcreteYul.restoreOuter source.env bodyConfig.env with
    | none =>
        simp [hRestoreOuter] at hRestore
    | some restoredEnv =>
        simp [hRestoreOuter] at hRestore
        cases hRestore
        exact slotsBound_restoreOuter hOuterBound hRestoreOuter
  refine ⟨poppedTarget, hPop, ?_⟩
  exact
    { state_eq := by
        rw [ConcreteYul.restoreBlockConfig_preserves_state hRestore]
        exact hBodyRel.state_eq
      stack_eq := by simp [poppedTarget, hFrameRestore]
      bound := hRestoreBound }

theorem frameOfSlots_assign_not_in
    {slots : List ConcreteYul.Name} {env env' : ConcreteYul.Env}
    {name : ConcreteYul.Name} {value : Word}
    (hNotIn : indexOf? slots name = none)
    (hAssign : ConcreteYul.assign? env name value = some env') :
    frameOfSlots slots env' = frameOfSlots slots env := by
  induction slots with
  | nil =>
      rfl
  | cons candidate rest ih =>
      by_cases hCandidate : candidate = name
      · subst candidate
        simp [indexOf?] at hNotIn
      · have hRest : indexOf? rest name = none := by
          simpa [indexOf?, hCandidate] using hNotIn
        have hLookup :
            ConcreteYul.lookup? env' candidate =
              ConcreteYul.lookup? env candidate :=
          lookup?_assign?_other hAssign hCandidate
        simp [frameOfSlots, hLookup, ih hRest]

theorem replaceAt?_frameOfSlots_assign
    {slots : List ConcreteYul.Name} {env env' : ConcreteYul.Env}
    {name : ConcreteYul.Name} {index : Nat} {value : Word}
    (hDistinct : SlotsDistinct slots)
    (hIndex : indexOf? slots name = some index)
    (hAssign : ConcreteYul.assign? env name value = some env') :
    replaceAt? (frameOfSlots slots env) index (Atom.word (norm value)) =
      some (frameOfSlots slots env') := by
  induction slots generalizing index with
  | nil =>
      simp [indexOf?] at hIndex
  | cons candidate rest ih =>
      cases hDistinct with
      | cons hFresh hRestDistinct =>
          by_cases hCandidate : candidate = name
          · subst candidate
            simp [indexOf?] at hIndex
            cases hIndex
            have hLookup := lookup?_assign?_same hAssign
            have hRestFrame :=
              frameOfSlots_assign_not_in hFresh hAssign
            simp [replaceAt?, frameOfSlots, hLookup, hRestFrame]
          · simp [indexOf?, hCandidate] at hIndex
            cases hRestIndex : indexOf? rest name with
            | none =>
                simp [hRestIndex] at hIndex
            | some restIndex =>
                simp [hRestIndex] at hIndex
                cases hIndex
                have hLookup :
                    ConcreteYul.lookup? env' candidate =
                      ConcreteYul.lookup? env candidate :=
                  lookup?_assign?_other hAssign hCandidate
                have hReplace :=
                  ih hRestDistinct hRestIndex
                simp [replaceAt?, frameOfSlots, hLookup, hReplace]

theorem compileExprAt_execList_correct
    {layout : Layout} {expr : ConcreteYul.Expr} {code : List Instr}
    {hash : ConcreteYul.HashOracle} {source source' : ConcreteYul.Config}
    {value : Word} {temps tail : Stack} {target : TargetState}
    (hCompile : compileExprAt layout temps.length expr = some code)
    (hEval : ConcreteYul.evalExpr hash expr source = some (value, source'))
    (hRel : StackRel layout source temps tail target) :
    ∃ target',
      execList code target = some target' ∧
        StackRel layout source' (Atom.word value :: temps) tail target' := by
  cases expr with
  | word literal =>
      simp [compileExprAt] at hCompile
      cases hCompile
      simp [ConcreteYul.evalExpr] at hEval
      rcases hEval with ⟨hValue, hSource⟩
      subst value
      subst source'
      refine
        ⟨{ target with stack := Atom.word (norm literal) :: target.stack },
          ?_, ?_⟩
      · simp [execList, execInstr]
      · exact
          { state_eq := hRel.state_eq
            stack_eq := by simp [hRel.stack_eq]
            bound := hRel.bound }
  | var name =>
      simp [compileExprAt] at hCompile
      cases hIndex : layout.index? name with
      | none =>
          simp [hIndex] at hCompile
      | some index =>
          simp [hIndex] at hCompile
          cases hCompile
          simp [ConcreteYul.evalExpr] at hEval
          cases hLookup : ConcreteYul.lookup? source.env name with
          | none =>
              simp [hLookup] at hEval
          | some found =>
              simp [hLookup] at hEval
              rcases hEval with ⟨hValue, hSource⟩
              subst value
              subst source'
              have hStack :
                  target.stack[temps.length + index]? =
                    some (Atom.word found) :=
                stack_get?_of_layout_index hRel hIndex hLookup
              refine
                ⟨{ target with stack := Atom.word found :: target.stack },
                  ?_, ?_⟩
              · simp [execList, execInstr, hStack]
              · exact
                  { state_eq := hRel.state_eq
                    stack_eq := by simp [hRel.stack_eq]
                    bound := hRel.bound }
  | builtin builtin args =>
      simp [compileExprAt] at hCompile
  | dataSize label =>
      simp [compileExprAt] at hCompile
  | dataOffset label =>
      simp [compileExprAt] at hCompile

theorem compileExprAt_eval_config_eq
    {layout : Layout} {tempDepth : Nat} {expr : ConcreteYul.Expr}
    {code : List Instr} {hash : ConcreteYul.HashOracle}
    {source source' : ConcreteYul.Config} {value : Word}
    (hCompile : compileExprAt layout tempDepth expr = some code)
    (hEval : ConcreteYul.evalExpr hash expr source = some (value, source')) :
    source' = source := by
  cases expr with
  | word literal =>
      simp [compileExprAt] at hCompile
      cases hCompile
      simp [ConcreteYul.evalExpr] at hEval
      exact hEval.2.symm
  | var name =>
      simp [compileExprAt] at hCompile
      cases hIndex : layout.index? name with
      | none =>
          simp [hIndex] at hCompile
      | some index =>
          simp [hIndex] at hCompile
          cases hCompile
          simp [ConcreteYul.evalExpr] at hEval
          cases hLookup : ConcreteYul.lookup? source.env name with
          | none =>
              simp [hLookup] at hEval
          | some found =>
              simp [hLookup] at hEval
              exact hEval.2.symm
  | builtin builtin args =>
      simp [compileExprAt] at hCompile
  | dataSize label =>
      simp [compileExprAt] at hCompile
  | dataOffset label =>
      simp [compileExprAt] at hCompile

theorem compileExprsAt_eval_config_eq
    {layout : Layout} {tempDepth : Nat}
    {exprs : List ConcreteYul.Expr} {code : List Instr}
    {hash : ConcreteYul.HashOracle}
    {source source' : ConcreteYul.Config} {values : List Word}
    (hCompile : compileExprsAt layout tempDepth exprs = some code)
    (hEval :
      ConcreteYul.evalExprs hash exprs source = some (values, source')) :
    source' = source := by
  induction exprs generalizing tempDepth code source source' values with
  | nil =>
      simp [compileExprsAt] at hCompile
      cases hCompile
      simp [ConcreteYul.evalExprs] at hEval
      cases hEval
      subst values
      subst source'
      rfl
  | cons expr rest ih =>
      simp [compileExprsAt] at hCompile
      cases hHeadCode : compileExprAt layout tempDepth expr with
      | none =>
          simp [hHeadCode] at hCompile
      | some headCode =>
          cases hRestCode :
              compileExprsAt layout (tempDepth + 1) rest with
          | none =>
              simp [hHeadCode, hRestCode] at hCompile
          | some restCode =>
              simp [hHeadCode, hRestCode] at hCompile
              cases hCompile
              simp [ConcreteYul.evalExprs] at hEval
              cases hRestEval :
                  ConcreteYul.evalExprs hash rest source with
              | none =>
                  simp [hRestEval] at hEval
              | some restResult =>
                  cases restResult with
                  | mk restValues restSource =>
                      simp [hRestEval] at hEval
                      cases hHeadEval :
                          ConcreteYul.evalExpr hash expr restSource with
                      | none =>
                          simp [hHeadEval] at hEval
                      | some headResult =>
                          cases headResult with
                          | mk headValue headSource =>
                              simp [hHeadEval] at hEval
                              cases hEval
                              subst values
                              subst source'
                              have hRestSource :
                                  restSource = source :=
                                ih hRestCode hRestEval
                              subst restSource
                              exact
                                compileExprAt_eval_config_eq hHeadCode
                                  hHeadEval

theorem evalExprs_length
    {hash : ConcreteYul.HashOracle} {exprs : List ConcreteYul.Expr}
    {source source' : ConcreteYul.Config} {values : List Word}
    (hEval :
      ConcreteYul.evalExprs hash exprs source = some (values, source')) :
    values.length = exprs.length := by
  induction exprs generalizing source source' values with
  | nil =>
      simp [ConcreteYul.evalExprs] at hEval
      cases hEval
      subst values
      subst source'
      rfl
  | cons expr rest ih =>
      simp [ConcreteYul.evalExprs] at hEval
      cases hRestEval : ConcreteYul.evalExprs hash rest source with
      | none =>
          simp [hRestEval] at hEval
      | some restResult =>
          cases restResult with
          | mk restValues restSource =>
              simp [hRestEval] at hEval
              cases hHeadEval :
                  ConcreteYul.evalExpr hash expr restSource with
              | none =>
                  simp [hHeadEval] at hEval
              | some headResult =>
                  cases headResult with
                  | mk headValue headSource =>
                      simp [hHeadEval] at hEval
                      cases hEval
                      subst values
                      subst source'
                      exact congrArg Nat.succ (ih hRestEval)

theorem evalExprs_returnValueExprs_of_valuesForNames?
    {hash : ConcreteYul.HashOracle} {names : List ConcreteYul.Name}
    {source : ConcreteYul.Config} {values : List Word}
    (hValues :
      ConcreteYul.valuesForNames? source.env names = some values) :
    ConcreteYul.evalExprs hash (returnValueExprs names) source =
      some (values, source) := by
  induction names generalizing values with
  | nil =>
      simp [ConcreteYul.valuesForNames?] at hValues
      cases hValues
      rfl
  | cons name rest ih =>
      simp [ConcreteYul.valuesForNames?, returnValueExprs] at hValues ⊢
      cases hLookup : ConcreteYul.lookup? source.env name with
      | none =>
          simp [hLookup] at hValues
      | some value =>
          cases hRest :
              ConcreteYul.valuesForNames? source.env rest with
          | none =>
              simp [hLookup, hRest] at hValues
          | some restValues =>
              simp [hLookup, hRest] at hValues
              cases hValues
              have hRestEval := ih hRest
              change
                (match
                    ConcreteYul.evalExprs hash (returnValueExprs rest)
                      source with
                  | some (values, config') =>
                      match
                        ConcreteYul.evalExpr hash
                          (ConcreteYul.Expr.var name) config' with
                      | some (value, config'') =>
                          some (value :: values, config'')
                      | none => none
                  | none => none) =
                  some (value :: restValues, source)
              rw [hRestEval]
              simp [ConcreteYul.evalExpr, hLookup]

theorem valuesForNames?_length
    {env : ConcreteYul.Env} {names : List ConcreteYul.Name}
    {values : List Word}
    (hValues : ConcreteYul.valuesForNames? env names = some values) :
    values.length = names.length := by
  induction names generalizing values with
  | nil =>
      simp [ConcreteYul.valuesForNames?] at hValues
      cases hValues
      rfl
  | cons name rest ih =>
      simp [ConcreteYul.valuesForNames?] at hValues
      cases hLookup : ConcreteYul.lookup? env name with
      | none =>
          simp [hLookup] at hValues
      | some value =>
          cases hRest : ConcreteYul.valuesForNames? env rest with
          | none =>
              simp [hLookup, hRest] at hValues
          | some restValues =>
              simp [hLookup, hRest] at hValues
              cases hValues
              exact congrArg Nat.succ (ih hRest)

theorem compileExprsSourceAt_eval_config_eq
    {layout : Layout} {tempDepth : Nat}
    {exprs : List ConcreteYul.Expr} {code : List Instr}
    {hash : ConcreteYul.HashOracle}
    {source source' : ConcreteYul.Config} {values : List Word}
    (hCompile : compileExprsSourceAt layout tempDepth exprs = some code)
    (hEval :
      ConcreteYul.evalExprs hash exprs source = some (values, source')) :
    source' = source := by
  induction exprs generalizing tempDepth code source source' values with
  | nil =>
      simp [compileExprsSourceAt] at hCompile
      cases hCompile
      simp [ConcreteYul.evalExprs] at hEval
      cases hEval
      subst values
      subst source'
      rfl
  | cons expr rest ih =>
      simp [compileExprsSourceAt] at hCompile
      cases hRestCode : compileExprsSourceAt layout tempDepth rest with
      | none =>
          simp [hRestCode] at hCompile
      | some restCode =>
          cases hHeadCode :
              compileExprAt layout (tempDepth + rest.length) expr with
          | none =>
              simp [hRestCode, hHeadCode] at hCompile
          | some headCode =>
              simp [hRestCode, hHeadCode] at hCompile
              cases hCompile
              simp [ConcreteYul.evalExprs] at hEval
              cases hRestEval :
                  ConcreteYul.evalExprs hash rest source with
              | none =>
                  simp [hRestEval] at hEval
              | some restResult =>
                  cases restResult with
                  | mk restValues restSource =>
                      simp [hRestEval] at hEval
                      cases hHeadEval :
                          ConcreteYul.evalExpr hash expr restSource with
                      | none =>
                          simp [hHeadEval] at hEval
                      | some headResult =>
                          cases headResult with
                          | mk headValue headSource =>
                              simp [hHeadEval] at hEval
                              cases hEval
                              subst values
                              subst source'
                              have hRestSource :
                                  restSource = source :=
                                ih hRestCode hRestEval
                              subst restSource
                              exact
                                compileExprAt_eval_config_eq hHeadCode
                                  hHeadEval

theorem compileExprsAt_execList_correct
    {layout : Layout} {exprs : List ConcreteYul.Expr}
    {code : List Instr} {hash : ConcreteYul.HashOracle}
    {source source' : ConcreteYul.Config} {values : List Word}
    {temps tail : Stack} {target : TargetState}
    (hCompile :
      compileExprsAt layout temps.length exprs = some code)
    (hEval :
      ConcreteYul.evalExprs hash exprs source = some (values, source'))
    (hRel : StackRel layout source temps tail target) :
    ∃ target',
      execList code target = some target' ∧
        StackRel layout source'
          ((values.reverse.map (fun value => Atom.word (norm value))) ++
            temps)
          tail target' := by
  induction exprs generalizing code source source' values temps target with
  | nil =>
      simp [compileExprsAt] at hCompile
      cases hCompile
      simp [ConcreteYul.evalExprs] at hEval
      cases hEval
      subst values
      subst source'
      exact ⟨target, rfl, by simpa using hRel⟩
  | cons expr rest ih =>
      simp [compileExprsAt] at hCompile
      cases hHeadCode : compileExprAt layout temps.length expr with
      | none =>
          simp [hHeadCode] at hCompile
      | some headCode =>
          cases hRestCode :
              compileExprsAt layout (temps.length + 1) rest with
          | none =>
              simp [hHeadCode, hRestCode] at hCompile
          | some restCode =>
              simp [hHeadCode, hRestCode] at hCompile
              cases hCompile
              simp [ConcreteYul.evalExprs] at hEval
              cases hRestEval :
                  ConcreteYul.evalExprs hash rest source with
              | none =>
                  simp [hRestEval] at hEval
              | some restResult =>
                  cases restResult with
                  | mk restValues restSource =>
                      simp [hRestEval] at hEval
                      cases hHeadEval :
                          ConcreteYul.evalExpr hash expr restSource with
                      | none =>
                          simp [hHeadEval] at hEval
                      | some headResult =>
                          cases headResult with
                          | mk headValue headSource =>
                              simp [hHeadEval] at hEval
                              cases hEval
                              subst values
                              subst source'
                              have hRestSource :
                                  restSource = source :=
                                compileExprsAt_eval_config_eq hRestCode
                                  hRestEval
                              subst restSource
                              have hHeadSource :
                                  headSource = source :=
                                compileExprAt_eval_config_eq hHeadCode
                                  hHeadEval
                              subst headSource
                              rcases
                                compileExprAt_execList_correct hHeadCode
                                  hHeadEval hRel with
                              ⟨headTarget, hHeadExec, hHeadRel⟩
                              let normTarget : TargetState :=
                                { headTarget with
                                  stack :=
                                    Atom.word (norm headValue) ::
                                      temps ++
                                        frameOf layout source.env ++ tail }
                              have hNormExec :
                                  execList [Instr.normTop] headTarget =
                                    some normTarget := by
                                simp [execList, execInstr,
                                  hHeadRel.stack_eq, normTarget]
                              have hNormRel :
                                  StackRel layout source
                                    (Atom.word (norm headValue) :: temps)
                                    tail normTarget := by
                                exact
                                  { state_eq := by
                                      simp [normTarget,
                                        hHeadRel.state_eq]
                                    stack_eq := by
                                      simp [normTarget]
                                    bound := hHeadRel.bound }
                              have hRestCompile :
                                  compileExprsAt layout
                                      (Atom.word (norm headValue) ::
                                        temps).length
                                      rest =
                                    some restCode := by
                                simpa [Nat.add_comm, Nat.succ_eq_add_one]
                                  using hRestCode
                              rcases
                                ih hRestCompile hRestEval hNormRel with
                              ⟨target', hRestExec, hRel'⟩
                              refine ⟨target', ?_, ?_⟩
                              · rw [execList_append]
                                simp [hHeadExec]
                                change
                                  execList ([Instr.normTop] ++ restCode)
                                      headTarget =
                                    some target'
                                rw [execList_append]
                                simp [hNormExec, hRestExec]
                              · simpa [List.map_append, List.append_assoc]
                                  using hRel'

theorem compileExprsSourceAt_execList_correct
    {layout : Layout} {exprs : List ConcreteYul.Expr}
    {code : List Instr} {hash : ConcreteYul.HashOracle}
    {source source' : ConcreteYul.Config} {values : List Word}
    {temps tail : Stack} {target : TargetState}
    (hCompile :
      compileExprsSourceAt layout temps.length exprs = some code)
    (hEval :
      ConcreteYul.evalExprs hash exprs source = some (values, source'))
    (hRel : StackRel layout source temps tail target) :
    ∃ target',
      execList code target = some target' ∧
        StackRel layout source'
          ((values.map (fun value => Atom.word (norm value))) ++ temps)
          tail target' := by
  induction exprs generalizing code source source' values temps target with
  | nil =>
      simp [compileExprsSourceAt] at hCompile
      cases hCompile
      simp [ConcreteYul.evalExprs] at hEval
      cases hEval
      subst values
      subst source'
      exact ⟨target, rfl, by simpa using hRel⟩
  | cons expr rest ih =>
      simp [compileExprsSourceAt] at hCompile
      cases hRestCode : compileExprsSourceAt layout temps.length rest with
      | none =>
          simp [hRestCode] at hCompile
      | some restCode =>
          cases hHeadCode :
              compileExprAt layout (temps.length + rest.length) expr with
          | none =>
              simp [hRestCode, hHeadCode] at hCompile
          | some headCode =>
              simp [hRestCode, hHeadCode] at hCompile
              cases hCompile
              simp [ConcreteYul.evalExprs] at hEval
              cases hRestEval :
                  ConcreteYul.evalExprs hash rest source with
              | none =>
                  simp [hRestEval] at hEval
              | some restResult =>
                  cases restResult with
                  | mk restValues restSource =>
                      simp [hRestEval] at hEval
                      cases hHeadEval :
                          ConcreteYul.evalExpr hash expr restSource with
                      | none =>
                          simp [hHeadEval] at hEval
                      | some headResult =>
                          cases headResult with
                          | mk headValue headSource =>
                              simp [hHeadEval] at hEval
                              cases hEval
                              subst values
                              subst source'
                              have hRestSource :
                                  restSource = source :=
                                compileExprsSourceAt_eval_config_eq
                                  hRestCode hRestEval
                              subst restSource
                              have hHeadSource :
                                  headSource = source :=
                                compileExprAt_eval_config_eq hHeadCode
                                  hHeadEval
                              subst headSource
                              rcases
                                ih hRestCode hRestEval hRel with
                              ⟨restTarget, hRestExec, hRestRel⟩
                              have hRestValuesLen :
                                  restValues.length = rest.length :=
                                evalExprs_length hRestEval
                              have hHeadCompile :
                                  compileExprAt layout
                                      ((restValues.map
                                            (fun value =>
                                              Atom.word (norm value))) ++
                                          temps).length
                                      expr =
                                    some headCode := by
                                simpa [List.length_map, hRestValuesLen,
                                  Nat.add_comm, Nat.add_left_comm,
                                  Nat.add_assoc] using hHeadCode
                              rcases
                                compileExprAt_execList_correct hHeadCompile
                                  hHeadEval hRestRel with
                              ⟨headTarget, hHeadExec, hHeadRel⟩
                              let normTarget : TargetState :=
                                { headTarget with
                                  stack :=
                                    Atom.word (norm headValue) ::
                                      (restValues.map
                                          (fun value =>
                                            Atom.word (norm value))) ++
                                        temps ++
                                        frameOf layout source.env ++ tail }
                              have hNormExec :
                                  execList [Instr.normTop] headTarget =
                                    some normTarget := by
                                simp [execList, execInstr,
                                  hHeadRel.stack_eq, normTarget]
                              have hNormRel :
                                  StackRel layout source
                                    (Atom.word (norm headValue) ::
                                      (restValues.map
                                          (fun value =>
                                            Atom.word (norm value))) ++
                                        temps)
                                    tail normTarget := by
                                exact
                                  { state_eq := by
                                      simp [normTarget,
                                        hHeadRel.state_eq]
                                    stack_eq := by
                                      simp [normTarget, List.append_assoc]
                                    bound := hHeadRel.bound }
                              refine ⟨normTarget, ?_, ?_⟩
                              · rw [execList_append]
                                simp [hRestExec]
                                rw [execList_append]
                                simp [hHeadExec]
                                change
                                  execList [Instr.normTop] headTarget =
                                    some normTarget
                                exact hNormExec
                              · simpa [List.append_assoc] using hNormRel

theorem compileReturnValuesFrom_execList_correct
    {layout : Layout} {names : List ConcreteYul.Name}
    {code : List Instr} {hash : ConcreteYul.HashOracle}
    {source : ConcreteYul.Config} {values : List Word}
    {tail : Stack} {target : TargetState}
    (hCompile : compileReturnValuesFrom layout names = some code)
    (hValues :
      ConcreteYul.valuesForNames? source.env names = some values)
    (hRel : StackRel layout source [] tail target) :
    ∃ target',
      execList code target = some target' ∧
        StackRel layout source
          (values.map (fun value => Atom.word (norm value))) tail
          target' := by
  have hEval :
      ConcreteYul.evalExprs hash (returnValueExprs names) source =
        some (values, source) :=
    evalExprs_returnValueExprs_of_valuesForNames? hValues
  rcases
    compileExprsSourceAt_execList_correct
      (by simpa [compileReturnValuesFrom] using hCompile)
      hEval hRel with
  ⟨target', hExec, hRel'⟩
  exact ⟨target', hExec, by simpa using hRel'⟩

theorem evalExprsAsYulValues_eq_evalExprs_of_compileExprsAt
    {layout : Layout} {tempDepth : Nat}
    {exprs : List ConcreteYul.Expr} {code : List Instr}
    {hash : ConcreteYul.HashOracle} {source : ConcreteYul.Config}
    (hCompile : compileExprsAt layout tempDepth exprs = some code) :
    ConcreteYul.evalExprsAsYulValues hash exprs source =
      ConcreteYul.evalExprs hash exprs source := by
  cases exprs with
  | nil =>
      rfl
  | cons expr rest =>
      cases rest with
      | nil =>
          cases expr <;>
            simp [ConcreteYul.evalExprsAsYulValues, compileExprsAt,
              compileExprAt] at hCompile ⊢
      | cons second rest =>
          simp [ConcreteYul.evalExprsAsYulValues]

theorem evalExprsAsYulValues_eq_evalExprs_of_compileExprsSourceAt
    {layout : Layout} {tempDepth : Nat}
    {exprs : List ConcreteYul.Expr} {code : List Instr}
    {hash : ConcreteYul.HashOracle} {source : ConcreteYul.Config}
    (hCompile : compileExprsSourceAt layout tempDepth exprs = some code) :
    ConcreteYul.evalExprsAsYulValues hash exprs source =
      ConcreteYul.evalExprs hash exprs source := by
  cases exprs with
  | nil =>
      rfl
  | cons expr rest =>
      cases rest with
      | nil =>
          cases expr <;>
            simp [ConcreteYul.evalExprsAsYulValues,
              compileExprsSourceAt, compileExprAt] at hCompile ⊢
      | cons second rest =>
          simp [ConcreteYul.evalExprsAsYulValues]

theorem compileExprAt_cfg_correct
    {layout : Layout} {expr : ConcreteYul.Expr} {code : List Instr}
    {hash : ConcreteYul.HashOracle} {source source' : ConcreteYul.Config}
    {value : Word} {temps tail : Stack} {target : TargetState}
    (hCompile : compileExprAt layout temps.length expr = some code)
    (hEval : ConcreteYul.evalExpr hash expr source = some (value, source'))
    (hRel : StackRel layout source temps tail target) :
    ∃ target',
      Reaches (exprProgram code) (Config.at 0 target)
        (Config.halted target') ∧
        StackRel layout source' (Atom.word value :: temps) tail target' := by
  rcases compileExprAt_execList_correct hCompile hEval hRel with
    ⟨target', hExec, hRel'⟩
  refine ⟨target', ?_, hRel'⟩
  apply reaches_one
  simp [step, exprProgram, lookupBlock?, hExec, execTerm]

theorem compileExprStmtAt_execList_correct
    {layout : Layout} {expr : ConcreteYul.Expr} {code : List Instr}
    {hash : ConcreteYul.HashOracle} {fuel : Nat}
    {source : ConcreteYul.Config} {result : ConcreteYul.Result}
    {tail : Stack} {target : TargetState}
    (hCompile : compileExprStmtAt layout expr = some code)
    (hEval :
      ConcreteYul.evalStmtFuel hash fuel.succ source
        (ConcreteYul.Stmt.expr expr) = some result)
    (hNoHalt : source.state.halt? = none)
    (hRel : StackRel layout source [] tail target) :
    ∃ target',
      execList code target = some target' ∧
        StackRel layout result.config [] tail target' ∧
        result.flow = ConcreteYul.Flow.normal ∧
        result.config.state.halt? = none := by
  cases expr with
  | word literal =>
      simp [compileExprStmtAt, compileExprAt] at hCompile
      cases hCompile
      simp [ConcreteYul.evalStmtFuel, ConcreteYul.evalExpr,
        ConcreteYul.resultAfterExpr, ConcreteYul.normalResult, hNoHalt] at hEval
      cases hEval
      refine ⟨target, ?_, hRel, rfl, hNoHalt⟩
      simp [execList, execInstr]
  | var name =>
      simp [compileExprStmtAt, compileExprAt] at hCompile
      cases hIndex : layout.index? name with
      | none =>
          simp [hIndex] at hCompile
      | some index =>
          simp [hIndex] at hCompile
          cases hCompile
          simp [ConcreteYul.evalStmtFuel, ConcreteYul.evalExpr] at hEval
          cases hLookup : ConcreteYul.lookup? source.env name with
          | none =>
              simp [hLookup] at hEval
          | some found =>
              simp [hLookup, ConcreteYul.resultAfterExpr,
                ConcreteYul.normalResult, hNoHalt] at hEval
              cases hEval
              have hStack :
                  target.stack[index]? = some (Atom.word found) := by
                simpa using
                  (stack_get?_of_layout_index
                    (layout := layout) (source := source)
                    (temps := []) (tail := tail) (target := target)
                    (name := name) (index := index) (value := found)
                    hRel hIndex hLookup)
              refine ⟨target, ?_, hRel, rfl, hNoHalt⟩
              simp [execList, execInstr, hStack]
  | builtin builtin args =>
      simp [compileExprStmtAt, compileExprAt] at hCompile
  | dataSize label =>
      simp [compileExprStmtAt, compileExprAt] at hCompile
  | dataOffset label =>
      simp [compileExprStmtAt, compileExprAt] at hCompile

theorem compileStmtAt_execList_correct
    {layout : Layout} {stmt : ConcreteYul.Stmt} {code : List Instr}
    {hash : ConcreteYul.HashOracle} {fuel : Nat}
    {source : ConcreteYul.Config} {result : ConcreteYul.Result}
    {tail : Stack} {target : TargetState}
    (hCompile : compileStmtAt layout stmt = some code)
    (hEval :
      ConcreteYul.evalStmtFuel hash fuel.succ source stmt = some result)
    (hNoHalt : source.state.halt? = none)
    (hRel : StackRel layout source [] tail target) :
    ∃ target',
      execList code target = some target' ∧
        StackRel layout result.config [] tail target' ∧
        result.flow = ConcreteYul.Flow.normal := by
  cases stmt with
  | skip =>
      simp [compileStmtAt] at hCompile
      cases hCompile
      simp [ConcreteYul.evalStmtFuel, ConcreteYul.normalResult] at hEval
      cases hEval
      exact ⟨target, rfl, hRel, rfl⟩
  | expr expr =>
      rcases compileExprStmtAt_execList_correct hCompile hEval hNoHalt hRel with
        ⟨target', hExec, hRel', hFlow, _hNoHalt'⟩
      exact ⟨target', hExec, hRel', hFlow⟩
  | let1 name init =>
      simp [compileStmtAt] at hCompile
  | letMany names init =>
      simp [compileStmtAt] at hCompile
  | funDef name params returns body =>
      simp [compileStmtAt] at hCompile
      cases hCompile
      simp [ConcreteYul.evalStmtFuel, ConcreteYul.normalResult] at hEval
      cases hEval
      exact ⟨target, rfl, hRel, rfl⟩
  | assign name expr =>
      simp [compileStmtAt] at hCompile
  | assignMany names exprs =>
      simp [compileStmtAt] at hCompile
  | letCall names fnName args =>
      simp [compileStmtAt] at hCompile
  | assignCall names fnName args =>
      simp [compileStmtAt] at hCompile
  | seq first second =>
      simp [compileStmtAt] at hCompile
  | block stmts =>
      simp [compileStmtAt] at hCompile
  | ifThen cond body =>
      simp [compileStmtAt] at hCompile
  | switch discr cases defaultBranch =>
      simp [compileStmtAt] at hCompile
  | forLoop pre cond post body =>
      simp [compileStmtAt] at hCompile
  | «break» =>
      simp [compileStmtAt] at hCompile
  | «continue» =>
      simp [compileStmtAt] at hCompile
  | «leave» =>
      simp [compileStmtAt] at hCompile

theorem compileStmtAt_cfg_correct
    {layout : Layout} {stmt : ConcreteYul.Stmt} {code : List Instr}
    {hash : ConcreteYul.HashOracle} {fuel : Nat}
    {source : ConcreteYul.Config} {result : ConcreteYul.Result}
    {tail : Stack} {target : TargetState}
    (hCompile : compileStmtAt layout stmt = some code)
    (hEval :
      ConcreteYul.evalStmtFuel hash fuel.succ source stmt = some result)
    (hNoHalt : source.state.halt? = none)
    (hRel : StackRel layout source [] tail target) :
    ∃ target',
      Reaches (exprProgram code) (Config.at 0 target)
        (Config.halted target') ∧
        StackRel layout result.config [] tail target' ∧
        result.flow = ConcreteYul.Flow.normal := by
  rcases compileStmtAt_execList_correct hCompile hEval hNoHalt hRel with
    ⟨target', hExec, hRel', hFlow⟩
  refine ⟨target', ?_, hRel', hFlow⟩
  apply reaches_one
  simp [step, exprProgram, lookupBlock?, hExec, execTerm]

theorem declare?_some_eq_cons
    {env : ConcreteYul.Env} {name : ConcreteYul.Name}
    {value : Word} {env' : ConcreteYul.Env}
    (hDecl : ConcreteYul.declare? env name value = some env') :
    env' = (name, norm value) :: env := by
  cases hLookup : ConcreteYul.lookup? env name with
  | none =>
      simp [ConcreteYul.declare?, hLookup] at hDecl
      cases hDecl
      rfl
  | some _ =>
      simp [ConcreteYul.declare?, hLookup] at hDecl

theorem frameOf_extendLayoutMany?_declareMany
    {layout outLayout : Layout} {names : List ConcreteYul.Name}
    {values : List Word} {env declaredEnv : ConcreteYul.Env}
    (hExtend : extendLayoutMany? layout names = some outLayout)
    (hDecl :
      ConcreteYul.declareMany? env names values = some declaredEnv) :
    frameOf outLayout declaredEnv =
      (values.reverse.map (fun value => Atom.word (norm value))) ++
        frameOf layout env := by
  induction names generalizing layout outLayout values env declaredEnv with
  | nil =>
      simp [extendLayoutMany?] at hExtend
      cases hExtend
      cases values with
      | nil =>
          simp [ConcreteYul.declareMany?] at hDecl
          cases hDecl
          rfl
      | cons value rest =>
          simp [ConcreteYul.declareMany?] at hDecl
  | cons name rest ih =>
      simp [extendLayoutMany?] at hExtend
      cases hFresh : layout.index? name with
      | some _ =>
          simp [hFresh] at hExtend
      | none =>
          simp [hFresh] at hExtend
          cases values with
          | nil =>
              simp [ConcreteYul.declareMany?] at hDecl
          | cons value restValues =>
              simp [ConcreteYul.declareMany?] at hDecl
              cases hHeadDecl : ConcreteYul.declare? env name value with
              | none =>
                  simp [hHeadDecl] at hDecl
              | some headEnv =>
                  simp [hHeadDecl] at hDecl
                  have hHeadEnv :
                      headEnv = (name, norm value) :: env :=
                    declare?_some_eq_cons hHeadDecl
                  subst headEnv
                  rw [ih hExtend hDecl]
                  simp [frameOf_extend_declared hFresh, List.map_append,
                    List.append_assoc]

theorem extendLayoutMany?_bound_declaredMany
    {layout outLayout : Layout} {names : List ConcreteYul.Name}
    {values : List Word} {env declaredEnv : ConcreteYul.Env}
    (hBound : layout.Bound env)
    (hExtend : extendLayoutMany? layout names = some outLayout)
    (hDecl :
      ConcreteYul.declareMany? env names values = some declaredEnv) :
    outLayout.Bound declaredEnv := by
  induction names generalizing layout outLayout values env declaredEnv with
  | nil =>
      simp [extendLayoutMany?] at hExtend
      cases hExtend
      cases values with
      | nil =>
          simp [ConcreteYul.declareMany?] at hDecl
          cases hDecl
          exact hBound
      | cons value rest =>
          simp [ConcreteYul.declareMany?] at hDecl
  | cons name rest ih =>
      simp [extendLayoutMany?] at hExtend
      cases hFresh : layout.index? name with
      | some _ =>
          simp [hFresh] at hExtend
      | none =>
          simp [hFresh] at hExtend
          cases values with
          | nil =>
              simp [ConcreteYul.declareMany?] at hDecl
          | cons value restValues =>
              simp [ConcreteYul.declareMany?] at hDecl
              cases hHeadDecl : ConcreteYul.declare? env name value with
              | none =>
                  simp [hHeadDecl] at hDecl
              | some headEnv =>
                  simp [hHeadDecl] at hDecl
                  have hHeadEnv :
                      headEnv = (name, norm value) :: env :=
                    declare?_some_eq_cons hHeadDecl
                  subst headEnv
                  have hNextBound :
                      (extendLayout layout name).Bound
                        ((name, norm value) :: env) :=
                    extendLayout_bound_declared
                      (layout := layout) (env := env)
                      (name := name) (value := value) hBound
                  change SlotsBound outLayout.slots declaredEnv
                  exact
                    ih
                      (layout := extendLayout layout name)
                      (outLayout := outLayout)
                      (values := restValues)
                      (env := (name, norm value) :: env)
                      (declaredEnv := declaredEnv)
                      hNextBound
                      hExtend hDecl

theorem functionEntryLayout?_wellFormed
    {params returns : List ConcreteYul.Name} {entryLayout : Layout}
    (hEntry :
      functionEntryLayout? params returns = some entryLayout) :
    entryLayout.WellFormed := by
  simp [functionEntryLayout?] at hEntry
  cases hParams : extendLayoutMany? ({} : Layout) params with
  | none =>
      simp [hParams] at hEntry
  | some paramLayout =>
      simp [hParams] at hEntry
      have hParamLayout :
          paramLayout.WellFormed :=
        extendLayoutMany?_wellFormed SlotsDistinct.nil hParams
      exact extendLayoutMany?_wellFormed hParamLayout hEntry

theorem functionEntryLayout?_frameOf_initFunctionEnv
    {params returns : List ConcreteYul.Name} {entryLayout : Layout}
    {args : List Word} {callEnv : ConcreteYul.Env}
    (hEntry :
      functionEntryLayout? params returns = some entryLayout)
    (hInit :
      ConcreteYul.initFunctionEnv params args returns = some callEnv) :
    frameOf entryLayout callEnv =
      ((returns.map (fun _ => (0 : Word))).reverse.map
          (fun value => Atom.word (norm value))) ++
        (args.reverse.map (fun value => Atom.word (norm value))) := by
  simp [functionEntryLayout?] at hEntry
  cases hParamsExtend : extendLayoutMany? ({} : Layout) params with
  | none =>
      simp [hParamsExtend] at hEntry
  | some paramLayout =>
      simp [hParamsExtend] at hEntry
      simp [ConcreteYul.initFunctionEnv] at hInit
      cases hParamsDecl :
          ConcreteYul.declareMany? [] params args with
      | none =>
          simp [hParamsDecl] at hInit
      | some paramEnv =>
          simp [hParamsDecl] at hInit
          have hParamFrame :
              frameOf paramLayout paramEnv =
                args.reverse.map
                  (fun value => Atom.word (norm value)) := by
            have h :=
              frameOf_extendLayoutMany?_declareMany
                hParamsExtend hParamsDecl
            simpa [frameOf, frameOfSlots, List.map_reverse] using h
          have hEntryFrame :
              frameOf entryLayout callEnv =
                ((returns.map (fun _ => (0 : Word))).reverse.map
                    (fun value => Atom.word (norm value))) ++
                  frameOf paramLayout paramEnv :=
            frameOf_extendLayoutMany?_declareMany hEntry hInit
          rw [hEntryFrame, hParamFrame]

theorem functionEntryLayout?_bound_initFunctionEnv
    {params returns : List ConcreteYul.Name} {entryLayout : Layout}
    {args : List Word} {callEnv : ConcreteYul.Env}
    (hEntry :
      functionEntryLayout? params returns = some entryLayout)
    (hInit :
      ConcreteYul.initFunctionEnv params args returns = some callEnv) :
    entryLayout.Bound callEnv := by
  simp [functionEntryLayout?] at hEntry
  cases hParamsExtend : extendLayoutMany? ({} : Layout) params with
  | none =>
      simp [hParamsExtend] at hEntry
  | some paramLayout =>
      simp [hParamsExtend] at hEntry
      simp [ConcreteYul.initFunctionEnv] at hInit
      cases hParamsDecl :
          ConcreteYul.declareMany? [] params args with
      | none =>
          simp [hParamsDecl] at hInit
      | some paramEnv =>
          simp [hParamsDecl] at hInit
          have hEmptyBound :
              ({} : Layout).Bound ([] : ConcreteYul.Env) := by
            intro name index hIndex
            simp [indexOf?] at hIndex
          have hParamBound :
              paramLayout.Bound paramEnv :=
            extendLayoutMany?_bound_declaredMany hEmptyBound
              hParamsExtend hParamsDecl
          change SlotsBound entryLayout.slots callEnv
          exact extendLayoutMany?_bound_declaredMany hParamBound hEntry hInit

theorem compileLetManyInit_execList_correct
    {layout outLayout : Layout} {names : List ConcreteYul.Name}
    {exprs : List ConcreteYul.Expr} {code : List Instr}
    {hash : ConcreteYul.HashOracle}
    {source exprSource : ConcreteYul.Config} {values : List Word}
    {declaredEnv : ConcreteYul.Env}
    {tail : Stack} {target : TargetState}
    (hLayout : layout.WellFormed)
    (hExprCompile : compileExprsAt layout 0 exprs = some code)
    (hExtend : extendLayoutMany? layout names = some outLayout)
    (hEval :
      ConcreteYul.evalExprs hash exprs source = some (values, exprSource))
    (hDecl :
      ConcreteYul.declareMany? exprSource.env names values =
        some declaredEnv)
    (hRel : StackRel layout source [] tail target) :
    ∃ target',
      execList code target = some target' ∧
        StackRel outLayout { exprSource with env := declaredEnv } [] tail
          target' ∧
        outLayout.WellFormed := by
  have hExprSource : exprSource = source :=
    compileExprsAt_eval_config_eq hExprCompile hEval
  subst exprSource
  rcases
    compileExprsAt_execList_correct hExprCompile hEval hRel with
  ⟨target', hExec, hExprRel⟩
  have hFrame :
      frameOf outLayout declaredEnv =
        (values.reverse.map (fun value => Atom.word (norm value))) ++
          frameOf layout source.env :=
    frameOf_extendLayoutMany?_declareMany hExtend hDecl
  refine ⟨target', hExec, ?_, extendLayoutMany?_wellFormed hLayout hExtend⟩
  exact
    { state_eq := by
        simpa using hExprRel.state_eq
      stack_eq := by
        simpa [hFrame, List.append_assoc] using hExprRel.stack_eq
      bound :=
        extendLayoutMany?_bound_declaredMany hExprRel.bound hExtend hDecl }

theorem compileStoresSourceFromTop?_execList_correct
    {layout : Layout} {names : List ConcreteYul.Name}
    {code : List Instr} {values : List Word}
    {source : ConcreteYul.Config} {assignedEnv : ConcreteYul.Env}
    {tail : Stack} {target : TargetState}
    (hLayout : layout.WellFormed)
    (hCompile : compileStoresSourceFromTop? layout names = some code)
    (hAssign :
      ConcreteYul.assignMany? source.env names values = some assignedEnv)
    (hRel :
      StackRel layout source
        (values.map (fun value => Atom.word (norm value))) tail target) :
    ∃ target',
      execList code target = some target' ∧
        StackRel layout { source with env := assignedEnv } [] tail
          target' := by
  induction names generalizing code values source target with
  | nil =>
      simp [compileStoresSourceFromTop?] at hCompile
      cases hCompile
      cases values with
      | nil =>
          simp [ConcreteYul.assignMany?] at hAssign
          cases hAssign
          exact ⟨target, rfl, by simpa using hRel⟩
      | cons value restValues =>
          simp [ConcreteYul.assignMany?] at hAssign
  | cons name rest ih =>
      simp [compileStoresSourceFromTop?] at hCompile
      cases hIndex : layout.index? name with
      | none =>
          simp [hIndex] at hCompile
      | some index =>
          cases hRestCode : compileStoresSourceFromTop? layout rest with
          | none =>
              simp [hIndex, hRestCode] at hCompile
          | some restCode =>
              simp [hIndex, hRestCode] at hCompile
              cases hCompile
              cases values with
              | nil =>
                  simp [ConcreteYul.assignMany?] at hAssign
              | cons value restValues =>
                  simp [ConcreteYul.assignMany?] at hAssign
                  cases hHeadAssign :
                      ConcreteYul.assign? source.env name value with
                  | none =>
                      simp [hHeadAssign] at hAssign
                  | some headEnv =>
                      simp [hHeadAssign] at hAssign
                      have hRestLen :
                          rest.length = restValues.length :=
                        assignMany?_length hAssign
                      have hFrameReplace :
                          replaceAt? (frameOf layout source.env) index
                              (Atom.word (norm value)) =
                            some (frameOf layout headEnv) :=
                        replaceAt?_frameOfSlots_assign
                          (slots := layout.slots) (env := source.env)
                          (env' := headEnv) (name := name)
                          (index := index) (value := value) hLayout
                          hIndex hHeadAssign
                      have hFrameTailReplace :
                          replaceAt? (frameOf layout source.env ++ tail)
                              index (Atom.word (norm value)) =
                            some (frameOf layout headEnv ++ tail) :=
                        replaceAt?_append_of_left hFrameReplace
                      have hStackReplace :
                          replaceAt?
                              ((restValues.map
                                  (fun value => Atom.word (norm value))) ++
                                frameOf layout source.env ++ tail)
                              (rest.length + index)
                              (Atom.word (norm value)) =
                            some
                              ((restValues.map
                                  (fun value => Atom.word (norm value))) ++
                                frameOf layout headEnv ++ tail) := by
                        simpa [hRestLen, List.append_assoc]
                          using
                            replaceAt?_append_right_length
                              (restValues.map
                                (fun value => Atom.word (norm value)))
                              hFrameTailReplace
                      let headSource : ConcreteYul.Config :=
                        { source with env := headEnv }
                      let headTarget : TargetState :=
                        { target with
                          stack :=
                            (restValues.map
                              (fun value => Atom.word (norm value))) ++
                              frameOf layout headEnv ++ tail }
                      have hStackReplaceNorm :
                          replaceAt?
                              ((restValues.map
                                  (fun value => Atom.word (norm value))) ++
                                (frameOf layout source.env ++ tail))
                              (rest.length + index)
                              (Atom.word (norm (norm value))) =
                            some
                              ((restValues.map
                                  (fun value => Atom.word (norm value))) ++
                                (frameOf layout headEnv ++ tail)) := by
                        simpa [ConcreteYul.norm_norm, List.append_assoc]
                          using hStackReplace
                      have hHeadExec :
                          execInstr (Instr.store (rest.length + index))
                              target =
                            some headTarget := by
                        simp [execInstr, hRel.stack_eq,
                          hStackReplaceNorm, headTarget]
                      have hHeadRel :
                          StackRel layout headSource
                            (restValues.map
                              (fun value => Atom.word (norm value)))
                            tail headTarget := by
                        exact
                          { state_eq := by
                              simp [headSource, headTarget, hRel.state_eq]
                            stack_eq := by
                              simp [headTarget, headSource]
                            bound :=
                              slotsBound_assign? hRel.bound hHeadAssign }
                      rcases
                        ih hRestCode hAssign hHeadRel with
                      ⟨target', hRestExec, hRel'⟩
                      refine ⟨target', ?_, hRel'⟩
                      simp [execList, hHeadExec, hRestExec]

theorem compileStoresSourceFromTopAt?_execList_correct
    {layout : Layout} {offset : Nat} {names : List ConcreteYul.Name}
    {code : List Instr} {values : List Word}
    {source : ConcreteYul.Config} {assignedEnv : ConcreteYul.Env}
    {preserved tail : Stack} {target : TargetState}
    (hLayout : layout.WellFormed)
    (hPreservedLen : preserved.length = offset)
    (hCompile :
      compileStoresSourceFromTopAt? layout offset names = some code)
    (hAssign :
      ConcreteYul.assignMany? source.env names values = some assignedEnv) :
    execList code
        { target with
          stack :=
            (values.map (fun value => Atom.word (norm value))) ++
              preserved ++ frameOf layout source.env ++ tail } =
      some
        { target with
          stack := preserved ++ frameOf layout assignedEnv ++ tail } := by
  induction names generalizing code values source target with
  | nil =>
      simp [compileStoresSourceFromTopAt?] at hCompile
      cases hCompile
      cases values with
      | nil =>
          simp [ConcreteYul.assignMany?] at hAssign
          cases hAssign
          simp [execList, List.append_assoc]
      | cons value restValues =>
          simp [ConcreteYul.assignMany?] at hAssign
  | cons name rest ih =>
      simp [compileStoresSourceFromTopAt?] at hCompile
      cases hIndex : layout.index? name with
      | none =>
          simp [hIndex] at hCompile
      | some index =>
          cases hRestCode :
              compileStoresSourceFromTopAt? layout offset rest with
          | none =>
              simp [hIndex, hRestCode] at hCompile
          | some restCode =>
              simp [hIndex, hRestCode] at hCompile
              cases hCompile
              cases values with
              | nil =>
                  simp [ConcreteYul.assignMany?] at hAssign
              | cons value restValues =>
                  simp [ConcreteYul.assignMany?] at hAssign
                  cases hHeadAssign :
                      ConcreteYul.assign? source.env name value with
                  | none =>
                      simp [hHeadAssign] at hAssign
                  | some headEnv =>
                      simp [hHeadAssign] at hAssign
                      have hRestLen :
                          rest.length = restValues.length :=
                        assignMany?_length hAssign
                      have hFrameReplace :
                          replaceAt? (frameOf layout source.env) index
                              (Atom.word (norm value)) =
                            some (frameOf layout headEnv) :=
                        replaceAt?_frameOfSlots_assign
                          (slots := layout.slots) (env := source.env)
                          (env' := headEnv) (name := name)
                          (index := index) (value := value) hLayout
                          hIndex hHeadAssign
                      have hFrameTailReplace :
                          replaceAt? (frameOf layout source.env ++ tail)
                              index (Atom.word (norm value)) =
                            some (frameOf layout headEnv ++ tail) :=
                        replaceAt?_append_of_left hFrameReplace
                      have hStackReplace :
                          replaceAt?
                              (((restValues.map
                                    (fun value => Atom.word (norm value))) ++
                                  preserved) ++
                                frameOf layout source.env ++ tail)
                              (rest.length + offset + index)
                              (Atom.word (norm value)) =
                            some
                              (((restValues.map
                                    (fun value => Atom.word (norm value))) ++
                                  preserved) ++
                                frameOf layout headEnv ++ tail) := by
                        have hReplace :=
                          replaceAt?_append_right_length
                            ((restValues.map
                                (fun value => Atom.word (norm value))) ++
                              preserved)
                            hFrameTailReplace
                        simpa [List.length_map, hRestLen, hPreservedLen,
                          Nat.add_assoc, Nat.add_comm, Nat.add_left_comm,
                          List.append_assoc] using hReplace
                      have hStackReplaceNorm :
                          replaceAt?
                              ((restValues.map
                                  (fun value => Atom.word (norm value))) ++
                                (preserved ++
                                  (frameOf layout source.env ++ tail)))
                              (rest.length + offset + index)
                              (Atom.word (norm (norm value))) =
                            some
                              ((restValues.map
                                  (fun value => Atom.word (norm value))) ++
                                (preserved ++
                                  (frameOf layout headEnv ++ tail))) := by
                        simpa [ConcreteYul.norm_norm, List.append_assoc]
                          using hStackReplace
                      let headSource : ConcreteYul.Config :=
                        { source with env := headEnv }
                      let headTarget : TargetState :=
                        { target with
                          stack :=
                            (restValues.map
                              (fun value => Atom.word (norm value))) ++
                              preserved ++ frameOf layout headEnv ++ tail }
                      have hHeadExec :
                          execInstr
                              (Instr.store (rest.length + offset + index))
                              { target with
                                stack :=
                                  Atom.word (norm value) ::
                                    ((restValues.map
                                        (fun value =>
                                          Atom.word (norm value))) ++
                                      preserved ++
                                      frameOf layout source.env ++ tail) } =
                            some headTarget := by
                        simp [execInstr, hStackReplaceNorm, headTarget,
                          List.append_assoc]
                      have hRestExec :
                          execList restCode headTarget =
                            some
                              { headTarget with
                                stack :=
                                  preserved ++ frameOf layout assignedEnv ++
                                    tail } := by
                        simpa [headSource, headTarget, List.append_assoc]
                          using
                            ih hRestCode hAssign
                              (target := headTarget)
                              (source := headSource)
                      rw [execList]
                      change
                        (match
                            execInstr
                              (Instr.store
                                (rest.length + offset + index))
                              { target with
                                stack :=
                                  Atom.word (norm value) ::
                                    ((restValues.map
                                        (fun value =>
                                          Atom.word (norm value))) ++
                                      preserved ++
                                      frameOf layout source.env ++ tail) }
                          with
                          | some target' => execList restCode target'
                          | none => none) =
                          some
                            { target with
                              stack :=
                                preserved ++ frameOf layout assignedEnv ++
                                  tail }
                      rw [hHeadExec]
                      simpa [headTarget, List.append_assoc] using hRestExec

theorem callAssignCleanupCode_execList_correct
    {layout : Layout} {names : List ConcreteYul.Name}
    {storeCode : List Instr} {returnValues : List Word}
    {source : ConcreteYul.Config} {assignedEnv : ConcreteYul.Env}
    {calleeRest tail : Stack} {target : TargetState}
    (hLayout : layout.WellFormed)
    (hStores :
      compileStoresSourceFromTopAt? layout
          (returnValues.length + calleeRest.length) names =
        some storeCode)
    (hAssign :
      ConcreteYul.assignMany? source.env names returnValues =
        some assignedEnv) :
    execList
        (callAssignCleanupCode returnValues.length
          (returnValues.length + calleeRest.length) storeCode)
        { target with
          stack :=
            (returnValues.map (fun value => Atom.word (norm value))).reverse ++
              calleeRest ++ frameOf layout source.env ++ tail } =
      some { target with stack := frameOf layout assignedEnv ++ tail } := by
  let returnAtoms : Stack :=
    returnValues.map (fun value => Atom.word (norm value))
  let calleeFrame : Stack := returnAtoms.reverse ++ calleeRest
  have hReturnLen : returnAtoms.length = returnValues.length := by
    simp [returnAtoms]
  have hCalleeLen :
      calleeFrame.length = returnValues.length + calleeRest.length := by
    simp [calleeFrame, hReturnLen]
  have hDup :
      execList (dupTopValuesSource returnValues.length)
          { target with
            stack := returnAtoms.reverse ++
              (calleeRest ++ frameOf layout source.env ++ tail) } =
        some
          { target with
            stack := returnAtoms ++ returnAtoms.reverse ++
              (calleeRest ++ frameOf layout source.env ++ tail) } := by
    simpa [hReturnLen, List.append_assoc] using
      execList_dupTopValuesSource returnAtoms.reverse
        (calleeRest ++ frameOf layout source.env ++ tail) target
  have hStore :
      execList storeCode
          { target with
            stack :=
              returnAtoms ++ calleeFrame ++ frameOf layout source.env ++
                tail } =
        some
          { target with
            stack := calleeFrame ++ frameOf layout assignedEnv ++ tail } := by
    simpa [calleeFrame, hCalleeLen, List.append_assoc] using
      compileStoresSourceFromTopAt?_execList_correct
        (layout := layout)
        (offset := returnValues.length + calleeRest.length)
        (names := names)
        (code := storeCode)
        (values := returnValues)
        (source := source)
        (assignedEnv := assignedEnv)
        (preserved := calleeFrame)
        (tail := tail)
        (target := target)
        hLayout hCalleeLen hStores hAssign
  have hDrop :
      execList (dropUnderTemps 0 (returnValues.length + calleeRest.length))
          { target with
            stack := calleeFrame ++ frameOf layout assignedEnv ++ tail } =
        some { target with stack := frameOf layout assignedEnv ++ tail } := by
    simpa [hCalleeLen, List.append_assoc] using
      execList_dropUnderTemps ([] : Stack) calleeFrame
        (frameOf layout assignedEnv ++ tail) target
  have hDupExact :
      execList (dupTopValuesSource returnValues.length)
          { target with
            stack :=
              (returnValues.map
                (fun value => Atom.word (norm value))).reverse ++
                calleeRest ++ frameOf layout source.env ++ tail } =
        some
          { target with
            stack := returnAtoms ++ calleeFrame ++
              frameOf layout source.env ++ tail } := by
    simpa [returnAtoms, calleeFrame, List.append_assoc] using hDup
  have hStoreExact :
      execList storeCode
          { target with
            stack :=
              returnAtoms ++
                (calleeFrame ++ (frameOf layout source.env ++ tail)) } =
        some
          { target with
            stack := calleeFrame ++ frameOf layout assignedEnv ++ tail } := by
    simpa [List.append_assoc] using hStore
  rw [callAssignCleanupCode]
  rw [execList_append]
  rw [hDupExact]
  simp
  rw [execList_append]
  rw [hStoreExact]
  exact hDrop

theorem callLetCleanupCode_stackRel_correct
    {layout outLayout : Layout} {names : List ConcreteYul.Name}
    {returnValues : List Word}
    {source : ConcreteYul.Config} {declaredEnv : ConcreteYul.Env}
    {calleeRest tail : Stack} {target : TargetState}
    (hLayout : layout.WellFormed)
    (hBound : layout.Bound source.env)
    (hState : target.state = source.state)
    (hExtend : extendLayoutMany? layout names = some outLayout)
    (hDecl :
      ConcreteYul.declareMany? source.env names returnValues =
        some declaredEnv) :
    ∃ target',
      execList
          (callLetCleanupCode returnValues.length calleeRest.length)
          { target with
            stack :=
              (returnValues.map
                (fun value => Atom.word (norm value))).reverse ++
                calleeRest ++ frameOf layout source.env ++ tail } =
        some target' ∧
        StackRel outLayout { source with env := declaredEnv } [] tail
          target' ∧
        outLayout.WellFormed := by
  let returnAtoms : Stack :=
    returnValues.map (fun value => Atom.word (norm value))
  let startTarget : TargetState :=
    { target with
      stack := returnAtoms.reverse ++ calleeRest ++
        frameOf layout source.env ++ tail }
  let target' : TargetState :=
    { target with stack := frameOf outLayout declaredEnv ++ tail }
  have hReturnLen : returnAtoms.length = returnValues.length := by
    simp [returnAtoms]
  have hFrame :
      frameOf outLayout declaredEnv =
        returnAtoms.reverse ++ frameOf layout source.env := by
    simpa [returnAtoms] using
      frameOf_extendLayoutMany?_declareMany hExtend hDecl
  have hExec :
      execList
          (callLetCleanupCode returnValues.length calleeRest.length)
          startTarget =
        some target' := by
    have hDrop :=
      execList_dropUnderTemps returnAtoms.reverse calleeRest
        (frameOf layout source.env ++ tail) target
    simpa [callLetCleanupCode, startTarget, target', hReturnLen, hFrame,
      List.length_reverse, List.append_assoc] using hDrop
  refine ⟨target', ?_, ?_, extendLayoutMany?_wellFormed hLayout hExtend⟩
  · simpa [startTarget, returnAtoms, List.append_assoc] using hExec
  · exact
      { state_eq := by
          simp [target', hState]
        stack_eq := by
          simp [target']
        bound :=
          extendLayoutMany?_bound_declaredMany hBound hExtend hDecl }

theorem execList_zeroInitCode
    (names : List ConcreteYul.Name) (stack : Stack)
    (target : TargetState) :
    execList (zeroInitCode names) { target with stack := stack } =
      some
        { target with
          stack :=
            ((names.map (fun _ => (0 : Word))).reverse.map
              (fun value => Atom.word (norm value))) ++ stack } := by
  induction names generalizing stack with
  | nil =>
      simp [zeroInitCode, execList]
  | cons name rest ih =>
      simp [zeroInitCode, execList, execInstr]
      simpa [List.map_append, List.append_assoc] using
        ih (Atom.word (norm (0 : Word)) :: stack)

theorem callSetupCode_stackRel_correct
    {callerLayout entryLayout : Layout}
    {params returns : List ConcreteYul.Name}
    {argExprs : List ConcreteYul.Expr} {argCode : List Instr}
    {hash : ConcreteYul.HashOracle}
    {source argSource : ConcreteYul.Config}
    {argValues : List Word} {callEnv : ConcreteYul.Env}
    {tail : Stack} {target : TargetState}
    (hArgCompile :
      compileExprsAt callerLayout 0 argExprs = some argCode)
    (hArgEval :
      ConcreteYul.evalExprs hash argExprs source =
        some (argValues, argSource))
    (hEntry :
      functionEntryLayout? params returns = some entryLayout)
    (hInit :
      ConcreteYul.initFunctionEnv params argValues returns =
        some callEnv)
    (hRel : StackRel callerLayout source [] tail target) :
    ∃ target',
      execList (callSetupCode argCode returns) target = some target' ∧
        StackRel entryLayout { argSource with env := callEnv } []
          (frameOf callerLayout argSource.env ++ tail) target' ∧
        entryLayout.WellFormed := by
  rcases
    compileExprsAt_execList_correct hArgCompile hArgEval hRel with
  ⟨argTarget, hArgExec, hArgRel⟩
  let target' : TargetState :=
    { argTarget with
      stack := frameOf entryLayout callEnv ++
        frameOf callerLayout argSource.env ++ tail }
  have hFrame :
      frameOf entryLayout callEnv =
        ((returns.map (fun _ => (0 : Word))).reverse.map
            (fun value => Atom.word (norm value))) ++
          (argValues.reverse.map
            (fun value => Atom.word (norm value))) :=
    functionEntryLayout?_frameOf_initFunctionEnv hEntry hInit
  have hArgStack :
      argTarget.stack =
        (argValues.reverse.map
          (fun value => Atom.word (norm value))) ++
          frameOf callerLayout argSource.env ++ tail := by
    simpa [List.append_assoc] using hArgRel.stack_eq
  have hArgTargetEq :
      { argTarget with
        stack :=
          (argValues.reverse.map
            (fun value => Atom.word (norm value))) ++
            frameOf callerLayout argSource.env ++ tail } =
        argTarget := by
    cases argTarget
    simp at hArgStack ⊢
    exact hArgStack.symm
  have hZero :
      execList (zeroInitCode returns) argTarget = some target' := by
    have hZeroExec :=
      execList_zeroInitCode returns
        ((argValues.reverse.map
            (fun value => Atom.word (norm value))) ++
          frameOf callerLayout argSource.env ++ tail)
        argTarget
    rw [hArgTargetEq] at hZeroExec
    simpa [target', hFrame, List.append_assoc] using hZeroExec
  refine
    ⟨target', ?_, ?_, functionEntryLayout?_wellFormed hEntry⟩
  · rw [callSetupCode, execList_append]
    simp [hArgExec, hZero]
  · exact
      { state_eq := by
          simp [target', hArgRel.state_eq]
        stack_eq := by
          simp [target']
        bound := functionEntryLayout?_bound_initFunctionEnv hEntry hInit }

theorem compileLetManyNone_execList_correct
    {layout outLayout : Layout} {names : List ConcreteYul.Name}
    {source : ConcreteYul.Config} {declaredEnv : ConcreteYul.Env}
    {tail : Stack} {target : TargetState}
    (hLayout : layout.WellFormed)
    (hExtend : extendLayoutMany? layout names = some outLayout)
    (hDecl :
      ConcreteYul.declareMany? source.env names
        (names.map (fun _ => (0 : Word))) =
        some declaredEnv)
    (hRel : StackRel layout source [] tail target) :
    ∃ target',
      execList (zeroInitCode names) target = some target' ∧
        StackRel outLayout { source with env := declaredEnv } [] tail
          target' ∧
        outLayout.WellFormed := by
  induction names generalizing layout outLayout source target with
  | nil =>
      simp [extendLayoutMany?] at hExtend
      cases hExtend
      simp [ConcreteYul.declareMany?] at hDecl
      cases hDecl
      exact ⟨target, rfl, hRel, hLayout⟩
  | cons name rest ih =>
      simp [extendLayoutMany?] at hExtend
      cases hFresh : layout.index? name with
      | some _ =>
          simp [hFresh] at hExtend
      | none =>
          simp [hFresh] at hExtend
          simp [ConcreteYul.declareMany?] at hDecl
          cases hHeadDecl :
              ConcreteYul.declare? source.env name 0 with
          | none =>
              simp [hHeadDecl] at hDecl
          | some headEnv =>
              simp [hHeadDecl] at hDecl
              have hHeadEnv :
                  headEnv = (name, norm (0 : Word)) :: source.env :=
                declare?_some_eq_cons hHeadDecl
              subst headEnv
              let headSource : ConcreteYul.Config :=
                { source with
                  env := (name, norm (0 : Word)) :: source.env }
              let headTarget : TargetState :=
                { target with
                  stack :=
                    Atom.word (norm (0 : Word)) ::
                      frameOf layout source.env ++ tail }
              have hHeadRel :
                  StackRel (extendLayout layout name) headSource [] tail
                    headTarget := by
                exact
                  { state_eq := by
                      simp [headTarget, headSource, hRel.state_eq]
                    stack_eq := by
                      simp [headTarget, headSource,
                        frameOf_extend_declared hFresh]
                    bound :=
                      extendLayout_bound_declared
                        (layout := layout) (env := source.env)
                        (name := name) (value := 0) hRel.bound }
              rcases
                ih (layout := extendLayout layout name)
                  (outLayout := outLayout) (source := headSource)
                  (target := headTarget)
                  (extendLayout_wellFormed hLayout hFresh) hExtend
                  hDecl hHeadRel with
              ⟨target', hExecRest, hRel', hOutLayout⟩
              refine ⟨target', ?_, hRel', hOutLayout⟩
              simpa [zeroInitCode, execList, execInstr, headTarget,
                hRel.stack_eq] using hExecRest

theorem compileStmtFrom_execList_correct
    {layout : Layout} {stmt : ConcreteYul.Stmt} {gen : Codegen}
    {hash : ConcreteYul.HashOracle} {fuel : Nat}
    {source : ConcreteYul.Config} {result : ConcreteYul.Result}
    {tail : Stack} {target : TargetState}
    (hLayout : layout.WellFormed)
    (hCompile : compileStmtFrom layout stmt = some gen)
    (hEval :
      ConcreteYul.evalStmtFuel hash fuel.succ source stmt = some result)
    (hNoHalt : source.state.halt? = none)
    (hRel : StackRel layout source [] tail target) :
    ∃ target',
      execList gen.code target = some target' ∧
        StackRel gen.outLayout result.config [] tail target' ∧
        result.flow = ConcreteYul.Flow.normal ∧
        result.config.state.halt? = none ∧
        gen.outLayout.WellFormed := by
  cases stmt with
  | skip =>
      simp [compileStmtFrom] at hCompile
      cases hCompile
      simp [ConcreteYul.evalStmtFuel, ConcreteYul.normalResult] at hEval
      cases hEval
      exact ⟨target, rfl, hRel, rfl, hNoHalt, hLayout⟩
  | expr expr =>
      simp [compileStmtFrom] at hCompile
      cases hCode : compileExprStmtAt layout expr with
      | none =>
          simp [hCode] at hCompile
      | some code =>
          simp [hCode] at hCompile
          cases hCompile
          rcases
            compileExprStmtAt_execList_correct hCode hEval hNoHalt hRel with
            ⟨target', hExec, hRel', hFlow, hNoHalt'⟩
          exact ⟨target', hExec, hRel', hFlow, hNoHalt', hLayout⟩
  | let1 name init =>
      simp [compileStmtFrom, compileLet1From] at hCompile
      cases hFresh : layout.index? name with
      | some index =>
          simp [hFresh] at hCompile
      | none =>
          cases init with
          | none =>
              simp [hFresh] at hCompile
              cases hCompile
              simp [ConcreteYul.evalStmtFuel] at hEval
              cases hDecl : ConcreteYul.declare? source.env name 0 with
              | none =>
                  simp [hDecl] at hEval
              | some declaredEnv =>
                  simp [hDecl, ConcreteYul.normalResult] at hEval
                  cases hEval
                  have hDeclared :
                      declaredEnv = (name, norm 0) :: source.env :=
                    declare?_some_eq_cons hDecl
                  subst declaredEnv
                  refine
                    ⟨{ target with
                        stack := Atom.word (norm 0) :: target.stack },
                      ?_, ?_, rfl, hNoHalt,
                      extendLayout_wellFormed hLayout hFresh⟩
                  · simp [execList, execInstr, norm, wordModulus]
                  · exact
                      { state_eq := hRel.state_eq
                        stack_eq := by
                          simp [hRel.stack_eq,
                            frameOf_extend_declared hFresh, norm,
                            wordModulus]
                        bound :=
                          extendLayout_bound_declared
                            (layout := layout) (env := source.env)
                            (name := name) (value := 0) hRel.bound }
          | some expr =>
              cases hExprCode : compileExprAt layout 0 expr with
              | none =>
                  simp [hFresh, hExprCode] at hCompile
              | some code =>
                  simp [hFresh, hExprCode] at hCompile
                  cases hCompile
                  simp [ConcreteYul.evalStmtFuel] at hEval
                  cases hExprEval :
                      ConcreteYul.evalExpr hash expr source with
                  | none =>
                      simp [hExprEval] at hEval
                  | some exprResult =>
                      cases exprResult with
                      | mk value exprSource =>
                          simp [hExprEval] at hEval
                          cases hDecl :
                              ConcreteYul.declare? exprSource.env name value with
                          | none =>
                              simp [hDecl] at hEval
                          | some declaredEnv =>
                              simp [hDecl, ConcreteYul.normalResult] at hEval
                              cases hEval
                              have hExprSourceEq :
                                  exprSource = source :=
                                compileExprAt_eval_config_eq hExprCode hExprEval
                              rcases
                                compileExprAt_execList_correct
                                  hExprCode hExprEval hRel with
                                ⟨exprTarget, hExec, hExprRel⟩
                              have hDeclared :
                                  declaredEnv = (name, norm value) ::
                                    exprSource.env :=
                                declare?_some_eq_cons hDecl
                              subst declaredEnv
                              let declaredTarget : TargetState :=
                                { exprTarget with
                                  stack :=
                                    Atom.word (norm value) ::
                                      (frameOf layout exprSource.env ++ tail) }
                              refine
                                ⟨declaredTarget, ?_, ?_, rfl, ?_,
                                  extendLayout_wellFormed hLayout hFresh⟩
                              · rw [execList_append]
                                simp [hExec, execList, execInstr,
                                  hExprRel.stack_eq, declaredTarget]
                              exact
                                { state_eq := by
                                    simpa using hExprRel.state_eq
                                  stack_eq := by
                                    simp [declaredTarget,
                                      frameOf_extend_declared
                                        (layout := layout)
                                        (env := exprSource.env)
                                        (name := name)
                                        (value := norm value)
                                        hFresh]
                                  bound :=
                                    extendLayout_bound_declared
                                      (layout := layout)
                                      (env := exprSource.env)
                                      (name := name) (value := value)
                                      hExprRel.bound }
                              · simpa [hExprSourceEq] using hNoHalt
  | letMany names init =>
      simp [compileStmtFrom, compileLetManyFrom] at hCompile
      cases init with
      | some exprs =>
          by_cases hLen : names.length = exprs.length
          · simp [hLen] at hCompile
            cases hExprCode : compileExprsAt layout 0 exprs with
            | none =>
                simp [hExprCode] at hCompile
            | some code =>
                cases hExtend : extendLayoutMany? layout names with
                | none =>
                    simp [hExprCode, hExtend] at hCompile
                | some outLayout =>
                    simp [hExprCode, hExtend] at hCompile
                    cases hCompile
                    simp [ConcreteYul.evalStmtFuel] at hEval
                    cases hExprEval :
                        ConcreteYul.evalExprsAsYulValues hash exprs
                          source with
                    | none =>
                        simp [hExprEval] at hEval
                    | some exprResult =>
                        cases exprResult with
                        | mk values exprSource =>
                            simp [hExprEval] at hEval
                            have hExprEvalPlain :
                                ConcreteYul.evalExprs hash exprs source =
                                  some (values, exprSource) := by
                              rw [
                                ← evalExprsAsYulValues_eq_evalExprs_of_compileExprsAt
                                  hExprCode]
                              exact hExprEval
                            cases hDecl :
                                ConcreteYul.declareMany? exprSource.env names
                                  values with
                            | none =>
                                simp [hDecl] at hEval
                            | some declaredEnv =>
                                simp [hDecl, ConcreteYul.normalResult]
                                  at hEval
                                cases hEval
                                rcases
                                  compileLetManyInit_execList_correct hLayout
                                    hExprCode hExtend hExprEvalPlain hDecl
                                    hRel with
                                ⟨target', hExec, hRel', hOutLayout⟩
                                have hNoHalt' :
                                    exprSource.state.halt? = none := by
                                  have hExprSourceEq :
                                      exprSource = source :=
                                    compileExprsAt_eval_config_eq hExprCode
                                      hExprEvalPlain
                                  simpa [hExprSourceEq] using hNoHalt
                                exact
                                  ⟨target', hExec, hRel', rfl, hNoHalt',
                                    hOutLayout⟩
          · simp [hLen] at hCompile
      | none =>
          cases hExtend : extendLayoutMany? layout names with
          | none =>
              simp [hExtend] at hCompile
          | some outLayout =>
              simp [hExtend] at hCompile
              cases hCompile
              simp [ConcreteYul.evalStmtFuel] at hEval
              cases hDecl :
                  ConcreteYul.declareMany? source.env names
                    (names.map (fun _ => (0 : Word))) with
              | none =>
                  simp [hDecl] at hEval
              | some declaredEnv =>
                  simp [hDecl, ConcreteYul.normalResult] at hEval
                  cases hEval
                  rcases
                    compileLetManyNone_execList_correct hLayout hExtend
                      hDecl hRel with
                  ⟨target', hExec, hRel', hOutLayout⟩
                  exact
                    ⟨target', hExec, hRel', rfl, by simpa using hNoHalt,
                      hOutLayout⟩
  | funDef name params returns body =>
      simp [compileStmtFrom] at hCompile
      cases hCompile
      simp [ConcreteYul.evalStmtFuel, ConcreteYul.normalResult] at hEval
      cases hEval
      exact ⟨target, rfl, hRel, rfl, hNoHalt, hLayout⟩
  | assign name expr =>
      simp [compileStmtFrom, compileAssignFrom] at hCompile
      cases hIndex : layout.index? name with
      | none =>
          simp [hIndex] at hCompile
      | some index =>
          cases hExprCode : compileExprAt layout 0 expr with
          | none =>
              simp [hIndex, hExprCode] at hCompile
          | some code =>
              simp [hIndex, hExprCode] at hCompile
              cases hCompile
              simp [ConcreteYul.evalStmtFuel] at hEval
              cases hExprEval : ConcreteYul.evalExpr hash expr source with
              | none =>
                  simp [hExprEval] at hEval
              | some exprResult =>
                  cases exprResult with
                  | mk value exprSource =>
                      simp [hExprEval] at hEval
                      cases hAssign :
                          ConcreteYul.assign? exprSource.env name value with
                      | none =>
                          simp [hAssign] at hEval
                      | some assignedEnv =>
                          simp [hAssign, ConcreteYul.normalResult] at hEval
                          cases hEval
                          have hExprSourceEq :
                              exprSource = source :=
                            compileExprAt_eval_config_eq hExprCode hExprEval
                          rcases
                            compileExprAt_execList_correct
                              hExprCode hExprEval hRel with
                            ⟨exprTarget, hExec, hExprRel⟩
                          have hFrameReplace :
                              replaceAt?
                                  (frameOf layout exprSource.env)
                                  index (Atom.word (norm value)) =
                                some (frameOf layout assignedEnv) :=
                            replaceAt?_frameOfSlots_assign
                              (slots := layout.slots)
                              (env := exprSource.env)
                              (env' := assignedEnv)
                              (name := name)
                              (index := index)
                              (value := value)
                              hLayout hIndex hAssign
                          have hStackReplace :
                              replaceAt?
                                  (frameOf layout exprSource.env ++ tail)
                                  index (Atom.word (norm value)) =
                                some (frameOf layout assignedEnv ++ tail) :=
                            replaceAt?_append_of_left hFrameReplace
                          let assignedTarget : TargetState :=
                            { exprTarget with
                              stack := frameOf layout assignedEnv ++ tail }
                          refine
                            ⟨assignedTarget, ?_, ?_, rfl, ?_, hLayout⟩
                          · rw [execList_append]
                            simp [hExec, execList, execInstr,
                              hExprRel.stack_eq, hStackReplace,
                              assignedTarget]
                          · exact
                              { state_eq := by
                                  simpa using hExprRel.state_eq
                                stack_eq := by
                                  simp [assignedTarget]
                                bound :=
                                  slotsBound_assign? hExprRel.bound
                                    hAssign }
                          · simpa [hExprSourceEq] using hNoHalt
  | assignMany names exprs =>
      simp [compileStmtFrom, compileAssignManyFrom] at hCompile
      by_cases hLen : names.length = exprs.length
      · simp [hLen] at hCompile
        cases hExprCode : compileExprsSourceAt layout 0 exprs with
        | none =>
            simp [hExprCode] at hCompile
        | some exprCode =>
            cases hStoreCode :
                compileStoresSourceFromTop? layout names with
            | none =>
                simp [hExprCode, hStoreCode] at hCompile
            | some storeCode =>
                simp [hExprCode, hStoreCode] at hCompile
                cases hCompile
                simp [ConcreteYul.evalStmtFuel] at hEval
                cases hExprEval :
                    ConcreteYul.evalExprsAsYulValues hash exprs source with
                | none =>
                    simp [hExprEval] at hEval
                | some exprResult =>
                    cases exprResult with
                    | mk values exprSource =>
                        simp [hExprEval] at hEval
                        have hExprEvalPlain :
                            ConcreteYul.evalExprs hash exprs source =
                              some (values, exprSource) := by
                          rw [
                            ← evalExprsAsYulValues_eq_evalExprs_of_compileExprsSourceAt
                              hExprCode]
                          exact hExprEval
                        cases hAssign :
                            ConcreteYul.assignMany? exprSource.env names
                              values with
                        | none =>
                            simp [hAssign] at hEval
                        | some assignedEnv =>
                            simp [hAssign, ConcreteYul.normalResult] at hEval
                            cases hEval
                            rcases
                              compileExprsSourceAt_execList_correct hExprCode
                                hExprEvalPlain hRel with
                            ⟨exprTarget, hExprExec, hExprRel⟩
                            have hExprRelNoNil :
                                StackRel layout exprSource
                                  (values.map
                                    (fun value => Atom.word (norm value)))
                                  tail exprTarget := by
                              simpa using hExprRel
                            rcases
                              compileStoresSourceFromTop?_execList_correct
                                hLayout hStoreCode hAssign hExprRelNoNil with
                            ⟨target', hStoreExec, hRel'⟩
                            have hExprSourceEq : exprSource = source :=
                              compileExprsSourceAt_eval_config_eq hExprCode
                                hExprEvalPlain
                            refine
                              ⟨target', ?_, hRel', rfl, ?_, hLayout⟩
                            · rw [execList_append]
                              simp [hExprExec]
                              exact hStoreExec
                            · simpa [hExprSourceEq] using hNoHalt
      · simp [hLen] at hCompile
  | letCall names fnName args =>
      simp [compileStmtFrom] at hCompile
  | assignCall names fnName args =>
      simp [compileStmtFrom] at hCompile
  | seq first second =>
      simp [compileStmtFrom] at hCompile
  | block stmts =>
      simp [compileStmtFrom] at hCompile
  | ifThen cond body =>
      simp [compileStmtFrom] at hCompile
  | switch discr cases defaultBranch =>
      simp [compileStmtFrom] at hCompile
  | forLoop pre cond post body =>
      simp [compileStmtFrom] at hCompile
  | «break» =>
      simp [compileStmtFrom] at hCompile
  | «continue» =>
      simp [compileStmtFrom] at hCompile
  | «leave» =>
      simp [compileStmtFrom] at hCompile

theorem compileStmtFrom_cfg_correct
    {layout : Layout} {stmt : ConcreteYul.Stmt} {gen : Codegen}
    {hash : ConcreteYul.HashOracle} {fuel : Nat}
    {source : ConcreteYul.Config} {result : ConcreteYul.Result}
    {tail : Stack} {target : TargetState}
    (hLayout : layout.WellFormed)
    (hCompile : compileStmtFrom layout stmt = some gen)
    (hEval :
      ConcreteYul.evalStmtFuel hash fuel.succ source stmt = some result)
    (hNoHalt : source.state.halt? = none)
    (hRel : StackRel layout source [] tail target) :
    ∃ target',
      Reaches (exprProgram gen.code) (Config.at 0 target)
        (Config.halted target') ∧
        StackRel gen.outLayout result.config [] tail target' ∧
        result.flow = ConcreteYul.Flow.normal := by
  rcases compileStmtFrom_execList_correct hLayout hCompile hEval hNoHalt hRel with
    ⟨target', hExec, hRel', hFlow, _hNoHalt', _hLayout'⟩
  refine ⟨target', ?_, hRel', hFlow⟩
  apply reaches_one
  simp [step, exprProgram, lookupBlock?, hExec, execTerm]

theorem evalProgramStmtFuel_eq_evalStmtFuel_of_compileStmtFrom
    {layout : Layout} {stmt : ConcreteYul.Stmt} {gen : Codegen}
    {hash : ConcreteYul.HashOracle} {funcs : ConcreteYul.FunctionEnv}
    {fuel : Nat} {source : ConcreteYul.Config}
    (hCompile : compileStmtFrom layout stmt = some gen) :
    ConcreteYul.evalProgramStmtFuel hash funcs fuel source stmt =
      ConcreteYul.evalStmtFuel hash fuel source stmt := by
  cases fuel with
  | zero =>
      simp [ConcreteYul.evalProgramStmtFuel, ConcreteYul.evalStmtFuel]
  | succ fuel =>
      cases stmt with
      | skip =>
          simp [ConcreteYul.evalProgramStmtFuel,
            ConcreteYul.evalStmtFuel]
      | expr expr =>
          simp [ConcreteYul.evalProgramStmtFuel,
            ConcreteYul.evalStmtFuel]
      | let1 name init =>
          simp [ConcreteYul.evalProgramStmtFuel,
            ConcreteYul.evalStmtFuel]
      | letMany names init =>
          simp [ConcreteYul.evalProgramStmtFuel,
            ConcreteYul.evalStmtFuel]
      | funDef name params returns body =>
          simp [ConcreteYul.evalProgramStmtFuel,
            ConcreteYul.evalStmtFuel]
      | assign name expr =>
          simp [ConcreteYul.evalProgramStmtFuel,
            ConcreteYul.evalStmtFuel]
      | assignMany names exprs =>
          simp [ConcreteYul.evalProgramStmtFuel,
            ConcreteYul.evalStmtFuel]
      | letCall names fnName args =>
          simp [compileStmtFrom] at hCompile
      | assignCall names fnName args =>
          simp [compileStmtFrom] at hCompile
      | seq first second =>
          simp [compileStmtFrom] at hCompile
      | block stmts =>
          simp [compileStmtFrom] at hCompile
      | ifThen cond body =>
          simp [compileStmtFrom] at hCompile
      | switch discr cases defaultBranch =>
          simp [compileStmtFrom] at hCompile
      | forLoop pre cond post body =>
          simp [compileStmtFrom] at hCompile
      | «break» =>
          simp [compileStmtFrom] at hCompile
      | «continue» =>
          simp [compileStmtFrom] at hCompile
      | «leave» =>
          simp [compileStmtFrom] at hCompile

theorem compileStmtFrom_program_execList_correct
    {layout : Layout} {stmt : ConcreteYul.Stmt} {gen : Codegen}
    {hash : ConcreteYul.HashOracle} {funcs : ConcreteYul.FunctionEnv}
    {fuel : Nat} {source : ConcreteYul.Config}
    {result : ConcreteYul.Result} {tail : Stack} {target : TargetState}
    (hLayout : layout.WellFormed)
    (hCompile : compileStmtFrom layout stmt = some gen)
    (hEval :
      ConcreteYul.evalProgramStmtFuel hash funcs fuel.succ source stmt =
        some result)
    (hNoHalt : source.state.halt? = none)
    (hRel : StackRel layout source [] tail target) :
    ∃ target',
      execList gen.code target = some target' ∧
        StackRel gen.outLayout result.config [] tail target' ∧
        result.flow = ConcreteYul.Flow.normal ∧
        result.config.state.halt? = none ∧
        gen.outLayout.WellFormed := by
  have hEvalPlain := hEval
  rw [evalProgramStmtFuel_eq_evalStmtFuel_of_compileStmtFrom hCompile]
    at hEvalPlain
  exact
    compileStmtFrom_execList_correct hLayout hCompile hEvalPlain
      hNoHalt hRel

theorem compileSeqFrom_execList_correct
    {layout : Layout} {first second : ConcreteYul.Stmt} {gen : Codegen}
    {hash : ConcreteYul.HashOracle} {fuel : Nat}
    {source : ConcreteYul.Config} {result : ConcreteYul.Result}
    {tail : Stack} {target : TargetState}
    (hLayout : layout.WellFormed)
    (hCompile : compileSeqFrom layout first second = some gen)
    (hEval :
      ConcreteYul.evalStmtFuel hash fuel.succ.succ source
        (ConcreteYul.Stmt.seq first second) = some result)
    (hNoHalt : source.state.halt? = none)
    (hRel : StackRel layout source [] tail target) :
    ∃ target',
      execList gen.code target = some target' ∧
        StackRel gen.outLayout result.config [] tail target' ∧
        result.flow = ConcreteYul.Flow.normal ∧
        result.config.state.halt? = none ∧
        gen.outLayout.WellFormed := by
  simp [compileSeqFrom] at hCompile
  cases hFirstCompile : compileStmtFrom layout first with
  | none =>
      simp [hFirstCompile] at hCompile
  | some firstGen =>
      cases hSecondCompile :
          compileStmtFrom firstGen.outLayout second with
      | none =>
          simp [hFirstCompile, hSecondCompile] at hCompile
      | some secondGen =>
          simp [hFirstCompile, hSecondCompile] at hCompile
          cases hCompile
          simp [ConcreteYul.evalStmtFuel] at hEval
          cases hFirstEval :
              ConcreteYul.evalStmtFuel hash fuel.succ source first with
          | none =>
              simp [hFirstEval] at hEval
          | some firstResult =>
              rcases
                compileStmtFrom_execList_correct
                  hLayout hFirstCompile hFirstEval hNoHalt hRel with
                ⟨firstTarget, hFirstExec, hFirstRel, hFirstFlow,
                  hFirstNoHalt, hFirstLayout⟩
              cases firstResult with
              | mk firstFlow firstConfig =>
                  cases firstFlow <;>
                    simp [hFirstEval] at hEval hFirstFlow
                  rcases
                    compileStmtFrom_execList_correct
                      hFirstLayout hSecondCompile hEval hFirstNoHalt
                      hFirstRel with
                    ⟨secondTarget, hSecondExec, hSecondRel,
                      hSecondFlow, hSecondNoHalt, hSecondLayout⟩
                  refine
                    ⟨secondTarget, ?_, hSecondRel, hSecondFlow,
                      hSecondNoHalt, hSecondLayout⟩
                  rw [execList_append]
                  simp [hFirstExec, hSecondExec]

theorem compileSeqFrom_program_execList_correct
    {layout : Layout} {first second : ConcreteYul.Stmt} {gen : Codegen}
    {hash : ConcreteYul.HashOracle} {funcs : ConcreteYul.FunctionEnv}
    {fuel : Nat} {source : ConcreteYul.Config}
    {result : ConcreteYul.Result} {tail : Stack} {target : TargetState}
    (hLayout : layout.WellFormed)
    (hCompile : compileSeqFrom layout first second = some gen)
    (hEval :
      ConcreteYul.evalProgramStmtFuel hash funcs fuel.succ.succ source
        (ConcreteYul.Stmt.seq first second) = some result)
    (hNoHalt : source.state.halt? = none)
    (hRel : StackRel layout source [] tail target) :
    ∃ target',
      execList gen.code target = some target' ∧
        StackRel gen.outLayout result.config [] tail target' ∧
        result.flow = ConcreteYul.Flow.normal ∧
        result.config.state.halt? = none ∧
        gen.outLayout.WellFormed := by
  simp [compileSeqFrom] at hCompile
  cases hFirstCompile : compileStmtFrom layout first with
  | none =>
      simp [hFirstCompile] at hCompile
  | some firstGen =>
      cases hSecondCompile :
          compileStmtFrom firstGen.outLayout second with
      | none =>
          simp [hFirstCompile, hSecondCompile] at hCompile
      | some secondGen =>
          simp [hFirstCompile, hSecondCompile] at hCompile
          cases hCompile
          simp [ConcreteYul.evalProgramStmtFuel] at hEval
          cases hFirstEval :
              ConcreteYul.evalProgramStmtFuel hash funcs fuel.succ source
                first with
          | none =>
              simp [hFirstEval] at hEval
          | some firstResult =>
              rcases
                compileStmtFrom_program_execList_correct
                  hLayout hFirstCompile hFirstEval hNoHalt hRel with
                ⟨firstTarget, hFirstExec, hFirstRel, hFirstFlow,
                  hFirstNoHalt, hFirstLayout⟩
              cases firstResult with
              | mk firstFlow firstConfig =>
                  cases firstFlow <;>
                    simp [hFirstEval] at hEval hFirstFlow
                  rcases
                    compileStmtFrom_program_execList_correct
                      hFirstLayout hSecondCompile hEval hFirstNoHalt
                      hFirstRel with
                    ⟨secondTarget, hSecondExec, hSecondRel,
                      hSecondFlow, hSecondNoHalt, hSecondLayout⟩
                  refine
                    ⟨secondTarget, ?_, hSecondRel, hSecondFlow,
                      hSecondNoHalt, hSecondLayout⟩
                  rw [execList_append]
                  simp [hFirstExec, hSecondExec]

theorem compileSeqFrom_cfg_correct
    {layout : Layout} {first second : ConcreteYul.Stmt} {gen : Codegen}
    {hash : ConcreteYul.HashOracle} {fuel : Nat}
    {source : ConcreteYul.Config} {result : ConcreteYul.Result}
    {tail : Stack} {target : TargetState}
    (hLayout : layout.WellFormed)
    (hCompile : compileSeqFrom layout first second = some gen)
    (hEval :
      ConcreteYul.evalStmtFuel hash fuel.succ.succ source
        (ConcreteYul.Stmt.seq first second) = some result)
    (hNoHalt : source.state.halt? = none)
    (hRel : StackRel layout source [] tail target) :
    ∃ target',
      Reaches (exprProgram gen.code) (Config.at 0 target)
        (Config.halted target') ∧
        StackRel gen.outLayout result.config [] tail target' ∧
        result.flow = ConcreteYul.Flow.normal := by
  rcases
    compileSeqFrom_execList_correct hLayout hCompile hEval hNoHalt hRel with
    ⟨target', hExec, hRel', hFlow, _hNoHalt', _hLayout'⟩
  refine ⟨target', ?_, hRel', hFlow⟩
  apply reaches_one
  simp [step, exprProgram, lookupBlock?, hExec, execTerm]

theorem compileStmtFrom_extends
    {layout : Layout} {stmt : ConcreteYul.Stmt} {gen : Codegen}
    (hCompile : compileStmtFrom layout stmt = some gen) :
    ∃ pref, gen.outLayout.slots = pref ++ layout.slots := by
  cases stmt with
  | skip =>
      simp [compileStmtFrom] at hCompile
      cases hCompile
      exact ⟨[], rfl⟩
  | expr expr =>
      simp [compileStmtFrom] at hCompile
      cases hCode : compileExprStmtAt layout expr with
      | none =>
          simp [hCode] at hCompile
      | some code =>
          simp [hCode] at hCompile
          cases hCompile
          exact ⟨[], rfl⟩
  | let1 name init =>
      simp [compileStmtFrom, compileLet1From] at hCompile
      cases hFresh : layout.index? name with
      | some index =>
          simp [hFresh] at hCompile
      | none =>
          cases init with
          | none =>
              simp [hFresh] at hCompile
              cases hCompile
              exact ⟨[name], rfl⟩
          | some expr =>
              cases hCode : compileExprAt layout 0 expr with
              | none =>
                  simp [hFresh, hCode] at hCompile
              | some code =>
                  simp [hFresh, hCode] at hCompile
                  cases hCompile
                  exact ⟨[name], rfl⟩
  | letMany names init =>
      simp [compileStmtFrom, compileLetManyFrom] at hCompile
      cases init with
      | some exprs =>
          by_cases hLen : names.length = exprs.length
          · simp [hLen] at hCompile
            cases hExprs : compileExprsAt layout 0 exprs with
            | none =>
                simp [hExprs] at hCompile
            | some code =>
                cases hExtend : extendLayoutMany? layout names with
                | none =>
                    simp [hExprs, hExtend] at hCompile
                | some outLayout =>
                    simp [hExprs, hExtend] at hCompile
                    cases hCompile
                    exact extendLayoutMany?_extends hExtend
          · simp [hLen] at hCompile
      | none =>
          cases hExtend : extendLayoutMany? layout names with
          | none =>
              simp [hExtend] at hCompile
          | some outLayout =>
              simp [hExtend] at hCompile
              cases hCompile
              exact extendLayoutMany?_extends hExtend
  | funDef name params returns body =>
      simp [compileStmtFrom] at hCompile
      cases hCompile
      exact ⟨[], rfl⟩
  | assign name expr =>
      simp [compileStmtFrom, compileAssignFrom] at hCompile
      cases hIndex : layout.index? name with
      | none =>
          simp [hIndex] at hCompile
      | some index =>
          cases hCode : compileExprAt layout 0 expr with
          | none =>
              simp [hIndex, hCode] at hCompile
          | some code =>
              simp [hIndex, hCode] at hCompile
              cases hCompile
              exact ⟨[], rfl⟩
  | assignMany names exprs =>
      simp [compileStmtFrom, compileAssignManyFrom] at hCompile
      by_cases hLen : names.length = exprs.length
      · simp [hLen] at hCompile
        cases hExprs : compileExprsSourceAt layout 0 exprs with
        | none =>
            simp [hExprs] at hCompile
        | some exprCode =>
            cases hStores : compileStoresSourceFromTop? layout names with
            | none =>
                simp [hExprs, hStores] at hCompile
            | some storeCode =>
                simp [hExprs, hStores] at hCompile
                cases hCompile
                exact ⟨[], rfl⟩
      · simp [hLen] at hCompile
  | letCall names fnName args =>
      simp [compileStmtFrom] at hCompile
  | assignCall names fnName args =>
      simp [compileStmtFrom] at hCompile
  | seq first second =>
      simp [compileStmtFrom] at hCompile
  | block stmts =>
      simp [compileStmtFrom] at hCompile
  | ifThen cond body =>
      simp [compileStmtFrom] at hCompile
  | switch discr cases defaultBranch =>
      simp [compileStmtFrom] at hCompile
  | forLoop pre cond post body =>
      simp [compileStmtFrom] at hCompile
  | «break» =>
      simp [compileStmtFrom] at hCompile
  | «continue» =>
      simp [compileStmtFrom] at hCompile
  | «leave» =>
      simp [compileStmtFrom] at hCompile

theorem compileStmtFuelFrom_extends
    {compileFuel : Nat} {layout : Layout} {stmt : ConcreteYul.Stmt}
    {gen : Codegen}
    (hCompile : compileStmtFuelFrom compileFuel layout stmt = some gen) :
    ∃ pref, gen.outLayout.slots = pref ++ layout.slots := by
  induction compileFuel generalizing layout stmt gen with
  | zero =>
      simp [compileStmtFuelFrom] at hCompile
  | succ compileFuel ih =>
      cases stmt with
      | seq first second =>
          simp [compileStmtFuelFrom] at hCompile
          cases hFirst :
              compileStmtFuelFrom compileFuel layout first with
          | none =>
              simp [hFirst] at hCompile
          | some firstGen =>
              cases hSecond :
                  compileStmtFuelFrom compileFuel firstGen.outLayout
                    second with
              | none =>
                  simp [hFirst, hSecond] at hCompile
              | some secondGen =>
                  simp [hFirst, hSecond] at hCompile
                  cases hCompile
                  rcases ih hFirst with ⟨firstPrefix, hFirstSlots⟩
                  rcases ih hSecond with ⟨secondPrefix, hSecondSlots⟩
                  refine ⟨secondPrefix ++ firstPrefix, ?_⟩
                  rw [hSecondSlots, hFirstSlots]
                  simp [List.append_assoc]
      | block stmts =>
          simp [compileStmtFuelFrom] at hCompile
          cases hBody :
              compileBlockFuelBodyFrom compileFuel layout stmts with
          | none =>
              simp [hBody] at hCompile
          | some bodyGen =>
              simp [hBody] at hCompile
              cases hCompile
              exact ⟨[], rfl⟩
      | skip =>
          exact compileStmtFrom_extends hCompile
      | expr expr =>
          exact compileStmtFrom_extends hCompile
      | let1 name init =>
          exact compileStmtFrom_extends hCompile
      | letMany names init =>
          exact compileStmtFrom_extends hCompile
      | funDef name params returns body =>
          exact compileStmtFrom_extends hCompile
      | assign name expr =>
          exact compileStmtFrom_extends hCompile
      | assignMany names exprs =>
          exact compileStmtFrom_extends hCompile
      | letCall names fnName args =>
          exact compileStmtFrom_extends hCompile
      | assignCall names fnName args =>
          exact compileStmtFrom_extends hCompile
      | ifThen cond body =>
          exact compileStmtFrom_extends hCompile
      | switch discr cases defaultBranch =>
          exact compileStmtFrom_extends hCompile
      | forLoop pre cond post body =>
          exact compileStmtFrom_extends hCompile
      | «break» =>
          exact compileStmtFrom_extends hCompile
      | «continue» =>
          exact compileStmtFrom_extends hCompile
      | «leave» =>
          exact compileStmtFrom_extends hCompile

theorem compileBlockFuelBodyFrom_extends
    {compileFuel : Nat} {layout : Layout} {stmts : List ConcreteYul.Stmt}
    {gen : Codegen}
    (hCompile :
      compileBlockFuelBodyFrom compileFuel layout stmts = some gen) :
    ∃ pref, gen.outLayout.slots = pref ++ layout.slots := by
  induction compileFuel generalizing layout stmts gen with
  | zero =>
      simp [compileBlockFuelBodyFrom] at hCompile
  | succ compileFuel ih =>
      cases stmts with
      | nil =>
          simp [compileBlockFuelBodyFrom] at hCompile
          cases hCompile
          exact ⟨[], rfl⟩
      | cons stmt rest =>
          simp [compileBlockFuelBodyFrom] at hCompile
          cases hStmt :
              compileStmtFuelFrom compileFuel layout stmt with
          | none =>
              simp [hStmt] at hCompile
          | some stmtGen =>
              cases hRest :
                  compileBlockFuelBodyFrom compileFuel stmtGen.outLayout
                    rest with
              | none =>
                  simp [hStmt, hRest] at hCompile
              | some restGen =>
                  simp [hStmt, hRest] at hCompile
                  cases hCompile
                  rcases compileStmtFuelFrom_extends hStmt with
                    ⟨stmtPrefix, hStmtSlots⟩
                  rcases ih hRest with ⟨restPrefix, hRestSlots⟩
                  refine ⟨restPrefix ++ stmtPrefix, ?_⟩
                  rw [hRestSlots, hStmtSlots]
                  simp [List.append_assoc]

theorem compileFuelFrom_codeDepthAfter_pair (compileFuel : Nat) :
    (∀ {layout : Layout} {stmt : ConcreteYul.Stmt} {gen : Codegen}
        {tailDepth : Nat},
      compileStmtFuelFrom compileFuel layout stmt = some gen ->
      codeDepthAfter? gen.code (layout.slots.length + tailDepth) =
        some (gen.outLayout.slots.length + tailDepth)) ∧
    (∀ {layout : Layout} {stmts : List ConcreteYul.Stmt} {gen : Codegen}
        {tailDepth : Nat},
      compileBlockFuelBodyFrom compileFuel layout stmts = some gen ->
      codeDepthAfter? gen.code (layout.slots.length + tailDepth) =
        some (gen.outLayout.slots.length + tailDepth)) := by
  induction compileFuel with
  | zero =>
      constructor
      · intro layout stmt gen tailDepth hCompile
        simp [compileStmtFuelFrom] at hCompile
      · intro layout stmts gen tailDepth hCompile
        simp [compileBlockFuelBodyFrom] at hCompile
  | succ compileFuel ih =>
      constructor
      · intro layout stmt gen tailDepth hCompile
        cases stmt with
        | seq first second =>
            simp [compileStmtFuelFrom] at hCompile
            cases hFirst :
                compileStmtFuelFrom compileFuel layout first with
            | none =>
                simp [hFirst] at hCompile
            | some firstGen =>
                cases hSecond :
                    compileStmtFuelFrom compileFuel firstGen.outLayout
                      second with
                | none =>
                    simp [hFirst, hSecond] at hCompile
                | some secondGen =>
                    simp [hFirst, hSecond] at hCompile
                    cases hCompile
                    have hFirstDepth :=
                      ih.1 (layout := layout) (stmt := first)
                        (gen := firstGen) (tailDepth := tailDepth) hFirst
                    have hSecondDepth :=
                      ih.1 (layout := firstGen.outLayout)
                        (stmt := second) (gen := secondGen)
                        (tailDepth := tailDepth) hSecond
                    exact codeDepthAfter?_append hFirstDepth hSecondDepth
        | block stmts =>
            simp [compileStmtFuelFrom] at hCompile
            cases hBody :
                compileBlockFuelBodyFrom compileFuel layout stmts with
            | none =>
                simp [hBody] at hCompile
            | some bodyGen =>
                simp [hBody] at hCompile
                cases hCompile
                have hBodyDepth :=
                  ih.2 (layout := layout) (stmts := stmts)
                    (gen := bodyGen) (tailDepth := tailDepth) hBody
                have hSlotsLe :
                    layout.slots.length ≤ bodyGen.outLayout.slots.length := by
                  rcases compileBlockFuelBodyFrom_extends hBody with
                    ⟨pref, hSlots⟩
                  rw [hSlots]
                  simp
                have hPopLe :
                    bodyGen.outLayout.slots.length - layout.slots.length ≤
                      bodyGen.outLayout.slots.length + tailDepth := by
                  omega
                have hPopBase :=
                  codeDepthAfter?_popN
                    (count :=
                      bodyGen.outLayout.slots.length -
                        layout.slots.length)
                    (depth :=
                      bodyGen.outLayout.slots.length + tailDepth)
                    hPopLe
                have hPopSub :
                    (bodyGen.outLayout.slots.length + tailDepth) -
                        (bodyGen.outLayout.slots.length -
                          layout.slots.length) =
                      layout.slots.length + tailDepth := by
                  omega
                have hPop :
                    codeDepthAfter?
                        (popN (bodyGen.outLayout.slots.length -
                          layout.slots.length))
                        (bodyGen.outLayout.slots.length + tailDepth) =
                      some (layout.slots.length + tailDepth) := by
                  simpa [hPopSub] using hPopBase
                exact codeDepthAfter?_append hBodyDepth hPop
        | skip =>
            exact compileStmtFrom_codeDepthAfter hCompile
        | expr expr =>
            exact compileStmtFrom_codeDepthAfter hCompile
        | let1 name init =>
            exact compileStmtFrom_codeDepthAfter hCompile
        | letMany names init =>
            exact compileStmtFrom_codeDepthAfter hCompile
        | funDef name params returns body =>
            exact compileStmtFrom_codeDepthAfter hCompile
        | assign name expr =>
            exact compileStmtFrom_codeDepthAfter hCompile
        | assignMany names exprs =>
            exact compileStmtFrom_codeDepthAfter hCompile
        | letCall names fnName args =>
            exact compileStmtFrom_codeDepthAfter hCompile
        | assignCall names fnName args =>
            exact compileStmtFrom_codeDepthAfter hCompile
        | ifThen cond body =>
            exact compileStmtFrom_codeDepthAfter hCompile
        | switch discr cases defaultBranch =>
            exact compileStmtFrom_codeDepthAfter hCompile
        | forLoop pre cond post body =>
            exact compileStmtFrom_codeDepthAfter hCompile
        | «break» =>
            exact compileStmtFrom_codeDepthAfter hCompile
        | «continue» =>
            exact compileStmtFrom_codeDepthAfter hCompile
        | «leave» =>
            exact compileStmtFrom_codeDepthAfter hCompile
      · intro layout stmts gen tailDepth hCompile
        cases stmts with
        | nil =>
            simp [compileBlockFuelBodyFrom] at hCompile
            cases hCompile
            simp [codeDepthAfter?]
        | cons stmt rest =>
            simp [compileBlockFuelBodyFrom] at hCompile
            cases hStmt :
                compileStmtFuelFrom compileFuel layout stmt with
            | none =>
                simp [hStmt] at hCompile
            | some stmtGen =>
                cases hRest :
                    compileBlockFuelBodyFrom compileFuel
                      stmtGen.outLayout rest with
                | none =>
                    simp [hStmt, hRest] at hCompile
                | some restGen =>
                    simp [hStmt, hRest] at hCompile
                    cases hCompile
                    have hStmtDepth :=
                      ih.1 (layout := layout) (stmt := stmt)
                        (gen := stmtGen) (tailDepth := tailDepth) hStmt
                    have hRestDepth :=
                      ih.2 (layout := stmtGen.outLayout)
                        (stmts := rest) (gen := restGen)
                        (tailDepth := tailDepth) hRest
                    exact codeDepthAfter?_append hStmtDepth hRestDepth

theorem compileStmtFuelFrom_codeDepthAfter
    {compileFuel : Nat} {layout : Layout} {stmt : ConcreteYul.Stmt}
    {gen : Codegen} {tailDepth : Nat}
    (hCompile : compileStmtFuelFrom compileFuel layout stmt = some gen) :
    codeDepthAfter? gen.code (layout.slots.length + tailDepth) =
      some (gen.outLayout.slots.length + tailDepth) :=
  (compileFuelFrom_codeDepthAfter_pair compileFuel).1 hCompile

theorem compileBlockFuelBodyFrom_codeDepthAfter
    {compileFuel : Nat} {layout : Layout} {stmts : List ConcreteYul.Stmt}
    {gen : Codegen} {tailDepth : Nat}
    (hCompile :
      compileBlockFuelBodyFrom compileFuel layout stmts = some gen) :
    codeDepthAfter? gen.code (layout.slots.length + tailDepth) =
      some (gen.outLayout.slots.length + tailDepth) :=
  (compileFuelFrom_codeDepthAfter_pair compileFuel).2 hCompile

theorem exprProgram_depthChecked
    {depthOf : DepthEnv} {code : List Instr}
    {start finish : Nat}
    (hEntry : depthOf 0 = some start)
    (hCode : codeDepthAfter? code start = some finish) :
    Program.DepthChecked depthOf (exprProgram code) := by
  unfold exprProgram
  exact
    Program.DepthChecked.cons
      (entry := 0)
      (block := { body := code, term := Term.halt })
      (rest := [])
      (depth := start) (outDepth := finish)
      hEntry
      (blockDepthAfterWithTargets?_halt_of_codeDepthAfter hCode)
      Program.DepthChecked.nil

theorem compileLinearCfgStmtFrom_programDepthChecked
    {depthOf : DepthEnv} {fuel : Nat} {layout : Layout}
    {stmt : ConcreteYul.Stmt} {cfg : CfgCodegen}
    {tailDepth : Nat}
    (hCompile : compileLinearCfgStmtFrom fuel layout stmt = some cfg)
    (hEntry : depthOf 0 = some (layout.slots.length + tailDepth)) :
    Program.DepthChecked depthOf cfg.program := by
  simp [compileLinearCfgStmtFrom] at hCompile
  cases hStmt : compileStmtFuelFrom fuel layout stmt with
  | none =>
      simp [hStmt] at hCompile
  | some gen =>
      simp [hStmt] at hCompile
      cases hCompile
      exact
        exprProgram_depthChecked
          (depthOf := depthOf) (code := gen.code)
          (start := layout.slots.length + tailDepth)
          (finish := gen.outLayout.slots.length + tailDepth)
          hEntry
          (compileStmtFuelFrom_codeDepthAfter
            (compileFuel := fuel) (layout := layout) (stmt := stmt)
            (gen := gen) (tailDepth := tailDepth) hStmt)

theorem ifThenProgram_depthChecked
    {depthOf : DepthEnv} {layout : Layout}
    {condCode bodyCode : List Instr} {tailDepth : Nat}
    (hCond :
      codeDepthAfter? condCode (layout.slots.length + tailDepth) =
        some (layout.slots.length + tailDepth + 1))
    (hBody :
      codeDepthAfter? bodyCode (layout.slots.length + tailDepth) =
        some (layout.slots.length + tailDepth))
    (h0 : depthOf 0 = some (layout.slots.length + tailDepth))
    (h1 : depthOf 1 = some (layout.slots.length + tailDepth))
    (h2 : depthOf 2 = some (layout.slots.length + tailDepth)) :
    Program.DepthChecked depthOf (ifThenProgram condCode bodyCode) := by
  have hPos : 0 < layout.slots.length + tailDepth + 1 := by
    omega
  have hBranchDepth :
      (layout.slots.length + tailDepth + 1) - 1 =
        layout.slots.length + tailDepth := by
    omega
  have hHalt :
      codeDepthAfter? [] (layout.slots.length + tailDepth) =
        some (layout.slots.length + tailDepth) := by
    simp [codeDepthAfter?]
  unfold ifThenProgram
  have hChecked :
      Program.DepthChecked depthOf
        [ (0, { body := condCode, term := Term.branchNZ 1 2 })
        , (1, { body := bodyCode, term := Term.jump 2 })
        , (2, { body := [], term := Term.halt }) ] :=
    Program.DepthChecked.cons
        (entry := 0)
        (block := { body := condCode, term := Term.branchNZ 1 2 })
        (rest :=
          [ (1, { body := bodyCode, term := Term.jump 2 })
          , (2, { body := [], term := Term.halt }) ])
        (depth := layout.slots.length + tailDepth)
        (outDepth := layout.slots.length + tailDepth)
        h0
        (blockDepthAfterWithTargets?_branchNZ_of_codeDepthAfter
          (depthOf := depthOf) (body := condCode)
          (thenLabel := 1) (elseLabel := 2)
          (start := layout.slots.length + tailDepth)
          (branchInput := layout.slots.length + tailDepth + 1)
          (branchDepth := layout.slots.length + tailDepth)
          hCond hPos hBranchDepth h1 h2)
        (Program.DepthChecked.cons
          (entry := 1)
          (block := { body := bodyCode, term := Term.jump 2 })
          (rest := [(2, { body := [], term := Term.halt })])
          (depth := layout.slots.length + tailDepth)
          (outDepth := layout.slots.length + tailDepth)
          h1
          (blockDepthAfterWithTargets?_jump_of_codeDepthAfter
            (depthOf := depthOf) (body := bodyCode) (target := 2)
            (start := layout.slots.length + tailDepth)
            (finish := layout.slots.length + tailDepth)
            hBody h2)
          (Program.DepthChecked.cons
            (entry := 2)
            (block := { body := [], term := Term.halt })
            (rest := [])
            (depth := layout.slots.length + tailDepth)
            (outDepth := layout.slots.length + tailDepth)
            h2
            (blockDepthAfterWithTargets?_halt_of_codeDepthAfter hHalt)
            Program.DepthChecked.nil))
  intro label block hLookup
  exact hChecked hLookup

theorem compileIfThenFrom_programDepthChecked
    {depthOf : DepthEnv} {fuel : Nat} {layout : Layout}
    {cond : ConcreteYul.Expr} {body : ConcreteYul.Stmt}
    {cfg : CfgCodegen} {tailDepth : Nat}
    (hCompile : compileIfThenFrom fuel layout cond body = some cfg)
    (h0 : depthOf 0 = some (layout.slots.length + tailDepth))
    (h1 : depthOf 1 = some (layout.slots.length + tailDepth))
    (h2 : depthOf 2 = some (layout.slots.length + tailDepth)) :
    Program.DepthChecked depthOf cfg.program := by
  simp [compileIfThenFrom] at hCompile
  cases hCond : compileExprAt layout 0 cond with
  | none =>
      simp [hCond] at hCompile
  | some condCode =>
      cases hBody : compileStmtFuelFrom fuel layout body with
      | none =>
          simp [hCond, hBody] at hCompile
      | some bodyGen =>
          by_cases hOut : bodyGen.outLayout = layout
          · simp [hCond, hBody, hOut] at hCompile
            cases hCompile
            have hCondDepth :=
              compileExprAt_codeDepthAfter
                (layout := layout) (tempDepth := 0)
                (expr := cond) (code := condCode)
                (tailDepth := tailDepth) hCond
            have hCondDepth' :
                codeDepthAfter? condCode
                    (layout.slots.length + tailDepth) =
                  some (layout.slots.length + tailDepth + 1) := by
              simpa using hCondDepth
            have hBodyDepth :=
              compileStmtFuelFrom_codeDepthAfter
                (compileFuel := fuel) (layout := layout) (stmt := body)
                (gen := bodyGen) (tailDepth := tailDepth) hBody
            have hBodyDepth' :
                codeDepthAfter? bodyGen.code
                    (layout.slots.length + tailDepth) =
                  some (layout.slots.length + tailDepth) := by
              simpa [hOut] using hBodyDepth
            exact
              ifThenProgram_depthChecked
                (depthOf := depthOf) (layout := layout)
                (condCode := condCode) (bodyCode := bodyGen.code)
                (tailDepth := tailDepth)
                hCondDepth' hBodyDepth' h0 h1 h2
          · simp [hCond, hBody, hOut] at hCompile

theorem assignCallWithCallsProgram_depthChecked
    {depthOf : DepthEnv} {layout : Layout}
    {names : List ConcreteYul.Name} {fnName : ConcreteYul.Name}
    {args : List ConcreteYul.Expr} {argCode storeCode : List Instr}
    {tailDepth : Nat}
    (hArgs : compileExprsAt layout 0 args = some argCode)
    (hStores : compileStoresSourceFromTop? layout names = some storeCode)
    (h0 : depthOf 0 = some (layout.slots.length + tailDepth))
    (h1 : depthOf 1 =
      some (layout.slots.length + tailDepth + names.length)) :
    Program.DepthChecked depthOf
      (assignCallWithCallsProgram argCode storeCode fnName args.length
        names.length) := by
  unfold assignCallWithCallsProgram
  exact
    Program.DepthChecked.cons
      (entry := 0)
      (block :=
        { body := argCode
          term := Term.call fnName args.length names.length 1 })
      (rest := [(1, { body := storeCode, term := Term.halt })])
      (depth := layout.slots.length + tailDepth)
      (outDepth := layout.slots.length + tailDepth + names.length)
      h0
      (callEntryBlockDepthAfterWithTargets
        (depthOf := depthOf) (layout := layout)
        (args := args) (argCode := argCode) (fnName := fnName)
        (retCount := names.length) (returnLabel := 1)
