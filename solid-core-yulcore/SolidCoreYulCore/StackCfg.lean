      simp [hArgs] at hCompile
  | some argCode =>
      cases hStores : compileStoresSourceFromTop? layout names with
      | none =>
          simp [hArgs, hStores] at hCompile
      | some storeCode =>
          simp [hArgs, hStores] at hCompile
          cases hCompile
