theorem ifThenEntryBlockDepthAfterWithTargets
    {depthOf : DepthEnv} {layout : Layout}
    {cond : ConcreteYul.Expr} {condCode : List Instr}
    {thenLabel exit : Label} {tailDepth : Nat}
    (hCond : compileExprAt layout 0 cond = some condCode)
    (hThen : depthOf thenLabel = some (layout.slots.length + tailDepth))
    (hExit : depthOf exit = some (layout.slots.length + tailDepth)) :
    blockDepthAfterWithTargets? depthOf
        { body := condCode
          term := Term.branchNZ thenLabel exit }
        (layout.slots.length + tailDepth) =
      some (layout.slots.length + tailDepth) := by
  have hCondDepth :=
    compileExprAt_codeDepthAfter
      (layout := layout) (tempDepth := 0)
      (expr := cond) (code := condCode) (tailDepth := tailDepth)
      hCond
  have hCondDepth' :
      codeDepthAfter? condCode (layout.slots.length + tailDepth) =
        some (layout.slots.length + tailDepth + 1) := by
    simpa using hCondDepth
  have hPos : 0 < layout.slots.length + tailDepth + 1 := by
    omega
  have hBranchDepth :
      (layout.slots.length + tailDepth + 1) - 1 =
        layout.slots.length + tailDepth := by
    omega
  exact
    blockDepthAfterWithTargets?_branchNZ_of_codeDepthAfter
      (depthOf := depthOf) (body := condCode)
      (thenLabel := thenLabel) (elseLabel := exit)
      (start := layout.slots.length + tailDepth)
      (branchInput := layout.slots.length + tailDepth + 1)
      (branchDepth := layout.slots.length + tailDepth)
      hCondDepth' hPos hBranchDepth hThen hExit

