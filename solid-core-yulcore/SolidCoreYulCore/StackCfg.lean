def CompiledCallSemRealizesRunsBelowAtObject
    (hash : ConcreteYul.HashOracle)
    (sourceFns : ConcreteYul.FunctionEnv)
    (compiledFns : CompiledFunctionEnv) (callSem : CallSem)
    (object : ConcreteYul.Object) (fuel : Nat) : Prop :=
