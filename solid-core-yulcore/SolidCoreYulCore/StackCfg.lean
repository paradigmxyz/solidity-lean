def jumpOnlyToProgram (entry label : Label) : Program :=
  [(entry, { body := [], term := Term.jump label })]

def jumpOnlyProgram (label : Label) : Program :=
  [(0, { body := [], term := Term.jump label })]

def cleanupJumpToProgram (entry label : Label) (dropCount : Nat) :
    Program :=
  [(entry, { body := popN dropCount, term := Term.jump label })]

theorem cleanupJumpToProgram_zero (entry label : Label) :
    cleanupJumpToProgram entry label 0 = jumpOnlyToProgram entry label := by
  rfl

theorem jumpOnlyToProgram_callFree (entry label : Label) :
    Program.CallFree (jumpOnlyToProgram entry label) := by
  unfold jumpOnlyToProgram
  exact Program.callFree_cons (by simp [Term.CallFree])
    Program.callFree_nil

theorem jumpOnlyProgram_callFree (label : Label) :
    Program.CallFree (jumpOnlyProgram label) := by
  unfold jumpOnlyProgram
  exact Program.callFree_cons (by simp [Term.CallFree])
    Program.callFree_nil

theorem cleanupJumpToProgram_callFree
    (entry label : Label) (dropCount : Nat) :
    Program.CallFree (cleanupJumpToProgram entry label dropCount) := by
  unfold cleanupJumpToProgram
  exact Program.callFree_cons (by simp [Term.CallFree])
    Program.callFree_nil

def controlExitLabel? (dest : ControlDest) :
    ConcreteYul.Stmt -> Option Label
  | ConcreteYul.Stmt.break => some dest.breakLabel
  | ConcreteYul.Stmt.continue => some dest.continueLabel
  | ConcreteYul.Stmt.leave => some dest.leaveLabel
  | _ => none

def controlExitTarget? (ctx : ControlCtx) :
    ConcreteYul.Stmt -> Option ExitTarget
  | ConcreteYul.Stmt.break => ctx.breakTarget?
  | ConcreteYul.Stmt.continue => ctx.continueTarget?
  | ConcreteYul.Stmt.leave => ctx.leaveTarget?
  | _ => none

@[simp] theorem controlExitTarget?_functionReturn_break
    (returnLabel : Label) (layout : Layout) :
    controlExitTarget?
        (ControlCtx.functionReturn returnLabel layout)
        ConcreteYul.Stmt.break =
      none := by
  rfl

@[simp] theorem controlExitTarget?_functionReturn_continue
    (returnLabel : Label) (layout : Layout) :
    controlExitTarget?
        (ControlCtx.functionReturn returnLabel layout)
        ConcreteYul.Stmt.continue =
      none := by
  rfl

@[simp] theorem controlExitTarget?_functionReturn_leave
    (returnLabel : Label) (layout : Layout) :
    controlExitTarget?
        (ControlCtx.functionReturn returnLabel layout)
        ConcreteYul.Stmt.leave =
      some { label := returnLabel, layout := layout } := by
  rfl

@[simp] theorem controlExitTarget?_withLoopTargets_break
    (ctx : ControlCtx) (breakTarget continueTarget : ExitTarget) :
    controlExitTarget?
        (ctx.withLoopTargets breakTarget continueTarget)
        ConcreteYul.Stmt.break =
      some breakTarget := by
  rfl

@[simp] theorem controlExitTarget?_withLoopTargets_continue
    (ctx : ControlCtx) (breakTarget continueTarget : ExitTarget) :
    controlExitTarget?
        (ctx.withLoopTargets breakTarget continueTarget)
        ConcreteYul.Stmt.continue =
      some continueTarget := by
  rfl

@[simp] theorem controlExitTarget?_withLoopTargets_leave
    (ctx : ControlCtx) (breakTarget continueTarget : ExitTarget) :
    controlExitTarget?
        (ctx.withLoopTargets breakTarget continueTarget)
        ConcreteYul.Stmt.leave =
      ctx.leaveTarget? := by
  rfl

theorem controlExitTarget?_fromDest
    (dest : ControlDest) (layout : Layout) (stmt : ConcreteYul.Stmt) :
    controlExitTarget? (ControlCtx.fromDest dest layout) stmt =
      match controlExitLabel? dest stmt with
      | some label => some { label := label, layout := layout }
      | none => none := by
  cases stmt <;> rfl

def compileControlExitTargetCleanupTo
    (ctx : ControlCtx) (layout : Layout) (entry : Label)
    (stmt : ConcreteYul.Stmt) (localSlots : List ConcreteYul.Name) :
    Option CfgCodegen :=
  match controlExitTarget? ctx stmt with
  | none => none
  | some exitTarget =>
      if layout.slots = localSlots ++ exitTarget.layout.slots then
        some
          { program :=
              cleanupJumpToProgram entry exitTarget.label localSlots.length
            outLayout := exitTarget.layout }
      else none

theorem compileControlExitTargetCleanupTo_some
    {ctx : ControlCtx} {layout : Layout} {entry : Label}
    {stmt : ConcreteYul.Stmt} {localSlots : List ConcreteYul.Name}
    {cfg : CfgCodegen}
    (hCompile :
      compileControlExitTargetCleanupTo ctx layout entry stmt localSlots =
        some cfg) :
    ∃ exitTarget,
      controlExitTarget? ctx stmt = some exitTarget ∧
        layout.slots = localSlots ++ exitTarget.layout.slots ∧
        cfg.program =
          cleanupJumpToProgram entry exitTarget.label localSlots.length ∧
        cfg.outLayout = exitTarget.layout := by
  simp [compileControlExitTargetCleanupTo] at hCompile
  cases hTarget : controlExitTarget? ctx stmt with
  | none =>
      simp [hTarget] at hCompile
  | some exitTarget =>
      simp [hTarget] at hCompile
      by_cases hSlots :
          layout.slots = localSlots ++ exitTarget.layout.slots
      · simp [hSlots] at hCompile
        cases hCompile
        exact ⟨exitTarget, by simp, hSlots, rfl, rfl⟩
      · simp [hSlots] at hCompile

theorem compileControlExitTargetCleanupTo_lookup_none_of_ne
    {ctx : ControlCtx} {layout : Layout} {entry query : Label}
    {stmt : ConcreteYul.Stmt} {localSlots : List ConcreteYul.Name}
    {cfg : CfgCodegen}
    (hNe : entry ≠ query)
    (hCompile :
      compileControlExitTargetCleanupTo ctx layout entry stmt localSlots =
        some cfg) :
    lookupBlock? cfg.program query = none := by
  rcases compileControlExitTargetCleanupTo_some hCompile with
    ⟨exitTarget, _hTarget, _hSlots, hProgram, _hOut⟩
  rw [hProgram]
  simp [cleanupJumpToProgram, lookupBlock?, hNe]

theorem compileControlExitTargetCleanupTo_lookup_none_lt_entry
    {ctx : ControlCtx} {layout : Layout} {entry query : Label}
    {stmt : ConcreteYul.Stmt} {localSlots : List ConcreteYul.Name}
    {cfg : CfgCodegen}
    (hCompile :
      compileControlExitTargetCleanupTo ctx layout entry stmt localSlots =
        some cfg)
    (hBefore : query < entry) :
    lookupBlock? cfg.program query = none :=
  compileControlExitTargetCleanupTo_lookup_none_of_ne
    (Nat.ne_of_gt hBefore) hCompile

def cleanupLocalSlots? (layout targetLayout : Layout) :
    Option (List ConcreteYul.Name) :=
  let localCount := layout.slots.length - targetLayout.slots.length
  let localSlots := layout.slots.take localCount
  if layout.slots.drop localCount = targetLayout.slots then
    some localSlots
  else
    none

theorem cleanupLocalSlots?_some
    {layout targetLayout : Layout} {localSlots : List ConcreteYul.Name}
    (hSlots :
      cleanupLocalSlots? layout targetLayout = some localSlots) :
    layout.slots = localSlots ++ targetLayout.slots := by
  unfold cleanupLocalSlots? at hSlots
  by_cases hSuffix :
      layout.slots.drop
          (layout.slots.length - targetLayout.slots.length) =
        targetLayout.slots
  · simp [hSuffix] at hSlots
    cases hSlots
    calc
      layout.slots =
          layout.slots.take
              (layout.slots.length - targetLayout.slots.length) ++
            layout.slots.drop
              (layout.slots.length - targetLayout.slots.length) :=
        (List.take_append_drop
          (layout.slots.length - targetLayout.slots.length)
          layout.slots).symm
      _ =
          layout.slots.take
              (layout.slots.length - targetLayout.slots.length) ++
            targetLayout.slots := by rw [hSuffix]
  · simp [hSuffix] at hSlots

theorem cleanupLocalSlots?_self (layout : Layout) :
    cleanupLocalSlots? layout layout = some [] := by
  simp [cleanupLocalSlots?]

def compileControlExitTargetCleanupAutoTo
    (ctx : ControlCtx) (layout : Layout) (entry : Label)
    (stmt : ConcreteYul.Stmt) : Option CfgCodegen :=
  match controlExitTarget? ctx stmt with
  | none => none
  | some exitTarget =>
      match cleanupLocalSlots? layout exitTarget.layout with
      | none => none
      | some localSlots =>
          some
            { program :=
                cleanupJumpToProgram entry exitTarget.label
                  localSlots.length
              outLayout := exitTarget.layout }

theorem compileControlExitTargetCleanupAutoTo_some
    {ctx : ControlCtx} {layout : Layout} {entry : Label}
    {stmt : ConcreteYul.Stmt} {cfg : CfgCodegen}
    (hCompile :
      compileControlExitTargetCleanupAutoTo ctx layout entry stmt =
        some cfg) :
    ∃ exitTarget localSlots,
      controlExitTarget? ctx stmt = some exitTarget ∧
        cleanupLocalSlots? layout exitTarget.layout = some localSlots ∧
        layout.slots = localSlots ++ exitTarget.layout.slots ∧
        cfg.program =
          cleanupJumpToProgram entry exitTarget.label localSlots.length ∧
        cfg.outLayout = exitTarget.layout := by
  simp [compileControlExitTargetCleanupAutoTo] at hCompile
  cases hTarget : controlExitTarget? ctx stmt with
  | none =>
      simp [hTarget] at hCompile
  | some exitTarget =>
      simp [hTarget] at hCompile
      cases hSlots :
          cleanupLocalSlots? layout exitTarget.layout with
      | none =>
          simp [hSlots] at hCompile
      | some localSlots =>
          simp [hSlots] at hCompile
          cases hCompile
          exact
            ⟨exitTarget, localSlots, by simp, by simp [hSlots],
              cleanupLocalSlots?_some hSlots, rfl, rfl⟩

theorem compileControlExitTargetCleanupAutoTo_callFree
    {ctx : ControlCtx} {layout : Layout} {entry : Label}
    {stmt : ConcreteYul.Stmt} {cfg : CfgCodegen}
    (hCompile :
      compileControlExitTargetCleanupAutoTo ctx layout entry stmt =
        some cfg) :
    Program.CallFree cfg.program := by
  rcases compileControlExitTargetCleanupAutoTo_some hCompile with
    ⟨exitTarget, localSlots, _hTarget, _hSlotsAuto, _hSlots,
      hProgram, _hOut⟩
  rw [hProgram]
  exact cleanupJumpToProgram_callFree entry exitTarget.label localSlots.length

theorem compileControlExitTargetCleanupAutoTo_lookup_none_of_ne
    {ctx : ControlCtx} {layout : Layout} {entry query : Label}
    {stmt : ConcreteYul.Stmt} {cfg : CfgCodegen}
    (hNe : entry ≠ query)
    (hCompile :
      compileControlExitTargetCleanupAutoTo ctx layout entry stmt =
        some cfg) :
    lookupBlock? cfg.program query = none := by
  rcases compileControlExitTargetCleanupAutoTo_some hCompile with
    ⟨exitTarget, localSlots, _hTarget, _hSlotsAuto, _hSlots,
      hProgram, _hOut⟩
  rw [hProgram]
  simp [cleanupJumpToProgram, lookupBlock?, hNe]

theorem compileControlExitTargetCleanupAutoTo_lookup_none_lt_entry
    {ctx : ControlCtx} {layout : Layout} {entry query : Label}
    {stmt : ConcreteYul.Stmt} {cfg : CfgCodegen}
    (hCompile :
      compileControlExitTargetCleanupAutoTo ctx layout entry stmt =
        some cfg)
    (hBefore : query < entry) :
    lookupBlock? cfg.program query = none :=
  compileControlExitTargetCleanupAutoTo_lookup_none_of_ne
    (Nat.ne_of_gt hBefore) hCompile

theorem compileControlExitTargetCleanupAutoTo_outLayout_wf
    {ctx : ControlCtx} {layout : Layout} {entry : Label}
    {stmt : ConcreteYul.Stmt} {cfg : CfgCodegen}
    (hLayout : layout.WellFormed)
    (hCompile :
      compileControlExitTargetCleanupAutoTo ctx layout entry stmt =
        some cfg) :
    cfg.outLayout.WellFormed := by
  rcases compileControlExitTargetCleanupAutoTo_some hCompile with
    ⟨exitTarget, localSlots, _hTarget, _hSlotsAuto, hSlots,
      _hProgram, hOut⟩
  rw [hOut]
  have hDistinct :
      SlotsDistinct (localSlots ++ exitTarget.layout.slots) := by
    rw [← hSlots]
    exact hLayout
  exact SlotsDistinct.of_append_right hDistinct

theorem compileControlExitTargetCleanupAutoTo_fromDest
    (dest : ControlDest) (layout : Layout) (entry : Label)
    (stmt : ConcreteYul.Stmt) :
    compileControlExitTargetCleanupAutoTo
        (ControlCtx.fromDest dest layout) layout entry stmt =
      match controlExitLabel? dest stmt with
      | some label =>
          some
            { program := jumpOnlyToProgram entry label
              outLayout := layout }
      | none => none := by
  cases stmt <;>
    simp [compileControlExitTargetCleanupAutoTo,
      controlExitTarget?_fromDest, controlExitLabel?,
      cleanupLocalSlots?_self, cleanupJumpToProgram_zero]

theorem compileControlExitTargetCleanupTo_fromDest_nil
    (dest : ControlDest) (layout : Layout) (entry : Label)
    (stmt : ConcreteYul.Stmt) :
    compileControlExitTargetCleanupTo
        (ControlCtx.fromDest dest layout) layout entry stmt [] =
      match controlExitLabel? dest stmt with
      | some label =>
          some
            { program := jumpOnlyToProgram entry label
              outLayout := layout }
      | none => none := by
  cases stmt <;>
    simp [compileControlExitTargetCleanupTo, controlExitTarget?_fromDest,
      controlExitLabel?, cleanupJumpToProgram_zero]

theorem compileControlExitTargetCleanupTo_fromDest_nil_some
    {dest : ControlDest} {layout : Layout} {entry label : Label}
    {stmt : ConcreteYul.Stmt}
    (hControl : controlExitLabel? dest stmt = some label) :
    compileControlExitTargetCleanupTo
        (ControlCtx.fromDest dest layout) layout entry stmt [] =
      some
        { program := jumpOnlyToProgram entry label
          outLayout := layout } := by
  rw [compileControlExitTargetCleanupTo_fromDest_nil, hControl]

theorem compileControlExitTargetCleanupTo_fromDest_nil_none
    {dest : ControlDest} {layout : Layout} {entry : Label}
    {stmt : ConcreteYul.Stmt}
    (hControl : controlExitLabel? dest stmt = none) :
    compileControlExitTargetCleanupTo
        (ControlCtx.fromDest dest layout) layout entry stmt [] =
      none := by
  rw [compileControlExitTargetCleanupTo_fromDest_nil, hControl]

theorem compileControlExitTargetCleanupTo_callFree
    {ctx : ControlCtx} {layout : Layout} {entry : Label}
    {stmt : ConcreteYul.Stmt} {localSlots : List ConcreteYul.Name}
    {cfg : CfgCodegen}
    (hCompile :
      compileControlExitTargetCleanupTo ctx layout entry stmt localSlots =
        some cfg) :
    Program.CallFree cfg.program := by
  simp [compileControlExitTargetCleanupTo] at hCompile
  cases hTarget : controlExitTarget? ctx stmt with
  | none =>
      simp [hTarget] at hCompile
  | some exitTarget =>
      simp [hTarget] at hCompile
      by_cases hSlots :
          layout.slots = localSlots ++ exitTarget.layout.slots
      · simp [hSlots] at hCompile
        cases hCompile
        exact
          cleanupJumpToProgram_callFree entry exitTarget.label
            localSlots.length
      · simp [hSlots] at hCompile

def flowLabel? (dest : ControlDest) : ConcreteYul.Flow -> Option Label
  | ConcreteYul.Flow.broke => some dest.breakLabel
  | ConcreteYul.Flow.continued => some dest.continueLabel
  | ConcreteYul.Flow.left => some dest.leaveLabel
  | _ => none

def flowOrExitLabel? (dest : ControlDest) (exit : Label) :
    ConcreteYul.Flow -> Option Label
  | ConcreteYul.Flow.normal => some exit
  | ConcreteYul.Flow.broke => some dest.breakLabel
  | ConcreteYul.Flow.continued => some dest.continueLabel
  | ConcreteYul.Flow.left => some dest.leaveLabel
  | ConcreteYul.Flow.halted => none

def flowOrExitTarget? (normalLabel : Label) (normalLayout : Layout)
    (ctx : ControlCtx) : ConcreteYul.Flow -> Option ExitTarget
  | ConcreteYul.Flow.normal =>
      some { label := normalLabel, layout := normalLayout }
  | ConcreteYul.Flow.broke => ctx.breakTarget?
  | ConcreteYul.Flow.continued => ctx.continueTarget?
  | ConcreteYul.Flow.left => ctx.leaveTarget?
  | ConcreteYul.Flow.halted => none

def seqFlow : ConcreteYul.Flow -> ConcreteYul.Flow -> ConcreteYul.Flow
  | ConcreteYul.Flow.normal, second => second
  | first, _ => first

def seqExitTarget (firstFlow : ConcreteYul.Flow)
    (firstTarget secondTarget : ExitTarget) : ExitTarget :=
  match firstFlow with
  | ConcreteYul.Flow.normal => secondTarget
  | _ => firstTarget

theorem seqFlow_of_ne_normal {firstFlow secondFlow : ConcreteYul.Flow}
    (hFirstFlow : firstFlow ≠ ConcreteYul.Flow.normal) :
    seqFlow firstFlow secondFlow = firstFlow := by
  cases firstFlow <;> simp [seqFlow] at hFirstFlow ⊢

theorem ExitsTo.change_normal_of_abnormal
    {normalLabel₁ normalLabel₂ : Label}
    {normalLayout₁ normalLayout₂ : Layout} {ctx : ControlCtx}
    {flow : ConcreteYul.Flow} {target : ExitTarget}
    (hFlow : flow ≠ ConcreteYul.Flow.normal)
    (hExit : ExitsTo normalLabel₁ normalLayout₁ ctx flow target) :
    ExitsTo normalLabel₂ normalLayout₂ ctx flow target := by
  cases hExit with
  | normal =>
      exact (hFlow rfl).elim
  | broke hBreak =>
      exact ExitsTo.broke hBreak
  | continued hContinue =>
      exact ExitsTo.continued hContinue
  | left hLeave =>
      exact ExitsTo.left hLeave

theorem ExitsTo.empty_forces_normal
    {normalLabel : Label} {normalLayout : Layout}
    {flow : ConcreteYul.Flow} {target : ExitTarget}
    (hExit : ExitsTo normalLabel normalLayout ControlCtx.empty flow target) :
    flow = ConcreteYul.Flow.normal := by
  cases hExit with
  | normal =>
      rfl
  | broke hBreak =>
      simp [ControlCtx.empty] at hBreak
  | continued hContinue =>
      simp [ControlCtx.empty] at hContinue
  | left hLeave =>
      simp [ControlCtx.empty] at hLeave

theorem ExitsTo.of_flowOrExitTarget?
    {normalLabel : Label} {normalLayout : Layout} {ctx : ControlCtx}
    {flow : ConcreteYul.Flow} {target : ExitTarget}
    (hTarget :
      flowOrExitTarget? normalLabel normalLayout ctx flow = some target) :
    ExitsTo normalLabel normalLayout ctx flow target := by
  cases flow <;> simp [flowOrExitTarget?] at hTarget ⊢
  · cases hTarget
    exact ExitsTo.normal
  · exact ExitsTo.broke hTarget
  · exact ExitsTo.continued hTarget
  · exact ExitsTo.left hTarget

theorem ExitsTo.to_flowOrExitTarget?
    {normalLabel : Label} {normalLayout : Layout} {ctx : ControlCtx}
    {flow : ConcreteYul.Flow} {target : ExitTarget}
    (hExit : ExitsTo normalLabel normalLayout ctx flow target) :
    flowOrExitTarget? normalLabel normalLayout ctx flow = some target := by
  cases hExit with
  | normal =>
      simp [flowOrExitTarget?]
  | broke hBreak =>
      simp [flowOrExitTarget?, hBreak]
  | continued hContinue =>
      simp [flowOrExitTarget?, hContinue]
  | left hLeave =>
      simp [flowOrExitTarget?, hLeave]

theorem flowOrExitTarget?_fromDest_of_flowOrExitLabel?
    {dest : ControlDest} {normalLabel label : Label}
    {layout : Layout} {flow : ConcreteYul.Flow}
    (hFlow : flowOrExitLabel? dest normalLabel flow = some label) :
    flowOrExitTarget? normalLabel layout (ControlCtx.fromDest dest layout)
        flow =
      some { label := label, layout := layout } := by
  cases flow <;>
    simp [flowOrExitLabel?, flowOrExitTarget?, ControlCtx.fromDest]
      at hFlow ⊢
  · cases hFlow
    rfl
  · cases hFlow
    rfl
  · cases hFlow
    rfl
  · cases hFlow
    rfl

theorem ExitsTo.of_flowOrExitLabel?_fromDest
    {dest : ControlDest} {normalLabel label : Label} {layout : Layout}
    {flow : ConcreteYul.Flow}
    (hFlow : flowOrExitLabel? dest normalLabel flow = some label) :
    ExitsTo normalLabel layout (ControlCtx.fromDest dest layout) flow
      { label := label, layout := layout } :=
  ExitsTo.of_flowOrExitTarget?
    (flowOrExitTarget?_fromDest_of_flowOrExitLabel? hFlow)

theorem ExitsTo.seq
    {midLabel finalLabel : Label}
    {midLayout finalLayout : Layout} {ctx : ControlCtx}
    {firstFlow secondFlow : ConcreteYul.Flow}
    {firstTarget secondTarget : ExitTarget}
    (hFirst : ExitsTo midLabel midLayout ctx firstFlow firstTarget)
    (hSecond :
      ExitsTo finalLabel finalLayout ctx secondFlow secondTarget) :
    ExitsTo finalLabel finalLayout ctx (seqFlow firstFlow secondFlow)
      (seqExitTarget firstFlow firstTarget secondTarget) := by
  cases firstFlow <;> simp [seqFlow, seqExitTarget]
  · exact hSecond
  · exact
      ExitsTo.change_normal_of_abnormal
        (by intro h; cases h) hFirst
  · exact
      ExitsTo.change_normal_of_abnormal
        (by intro h; cases h) hFirst
  · exact
      ExitsTo.change_normal_of_abnormal
        (by intro h; cases h) hFirst
  · exact
      ExitsTo.change_normal_of_abnormal
        (by intro h; cases h) hFirst

theorem flowOrExitTarget?_seq
    {midLabel finalLabel : Label}
    {midLayout finalLayout : Layout} {ctx : ControlCtx}
    {firstFlow secondFlow : ConcreteYul.Flow}
    {firstTarget secondTarget : ExitTarget}
    (hFirst :
      flowOrExitTarget? midLabel midLayout ctx firstFlow =
        some firstTarget)
    (hSecond :
      flowOrExitTarget? finalLabel finalLayout ctx secondFlow =
        some secondTarget) :
    flowOrExitTarget? finalLabel finalLayout ctx
        (seqFlow firstFlow secondFlow) =
      some (seqExitTarget firstFlow firstTarget secondTarget) := by
  cases firstFlow <;>
    simp [seqFlow, seqExitTarget, flowOrExitTarget?] at hFirst ⊢
  · exact hSecond
  · exact hFirst
  · exact hFirst
  · exact hFirst

theorem evalStmtFuel_seq_first_normal
    {hash : ConcreteYul.HashOracle} {fuel : Nat}
    {source firstConfig : ConcreteYul.Config}
    {first second : ConcreteYul.Stmt} {result : ConcreteYul.Result}
    (hFirst :
      ConcreteYul.evalStmtFuel hash fuel source first =
        some
          { flow := ConcreteYul.Flow.normal
            config := firstConfig })
    (hEval :
      ConcreteYul.evalStmtFuel hash fuel.succ source
        (ConcreteYul.Stmt.seq first second) =
        some result) :
    ConcreteYul.evalStmtFuel hash fuel firstConfig second = some result := by
  simp [ConcreteYul.evalStmtFuel, hFirst] at hEval
  exact hEval

theorem evalStmtFuel_seq_first_abnormal
    {hash : ConcreteYul.HashOracle} {fuel : Nat}
    {source : ConcreteYul.Config}
    {first second : ConcreteYul.Stmt}
    {firstResult result : ConcreteYul.Result}
    (hFirst :
      ConcreteYul.evalStmtFuel hash fuel source first = some firstResult)
    (hFlow : firstResult.flow ≠ ConcreteYul.Flow.normal)
    (hEval :
      ConcreteYul.evalStmtFuel hash fuel.succ source
        (ConcreteYul.Stmt.seq first second) =
        some result) :
    result = firstResult := by
  cases firstResult with
  | mk flow config =>
      cases flow
      · exact (hFlow rfl).elim
      · simp [ConcreteYul.evalStmtFuel, hFirst] at hEval
        exact hEval.symm
      · simp [ConcreteYul.evalStmtFuel, hFirst] at hEval
        exact hEval.symm
      · simp [ConcreteYul.evalStmtFuel, hFirst] at hEval
        exact hEval.symm
      · simp [ConcreteYul.evalStmtFuel, hFirst] at hEval
        exact hEval.symm

def compileIfThenFrom (fuel : Nat) (layout : Layout)
    (cond : ConcreteYul.Expr) (body : ConcreteYul.Stmt) :
    Option CfgCodegen :=
  match compileExprAt layout 0 cond,
      compileStmtFuelFrom fuel layout body with
  | some condCode, some bodyGen =>
      if bodyGen.outLayout = layout then
        some
          { program := ifThenProgram condCode bodyGen.code
            outLayout := layout }
      else none
  | _, _ => none

def compileLinearCfgStmtFrom (fuel : Nat) (layout : Layout)
    (stmt : ConcreteYul.Stmt) : Option CfgCodegen :=
  match compileStmtFuelFrom fuel layout stmt with
  | some gen =>
      some
        { program := exprProgram gen.code
          outLayout := gen.outLayout }
  | none => none

