    (hAfterCall :
      depthOf afterCall =
        some (layout.slots.length + tailDepth + names.length))
    (hExit : depthOf exit = some (layout.slots.length + tailDepth)) :
    Program.DepthChecked depthOf
      (assignCallToProgram entry afterCall exit argCode storeCode
        fnName args.length names.length) := by
  intro label block hLookup
  change
    (if entry = label then
      some
        ({ body := argCode
           term := Term.call fnName args.length names.length afterCall } :
          Block)
    else
      if afterCall = label then
        some ({ body := storeCode, term := Term.jump exit } : Block)
      else none) = some block at hLookup
