def compileCfgStmtOpenCtxRecFrom : Nat -> Layout -> ControlCtx ->
    Label -> Label -> Label -> ConcreteYul.Stmt -> Option OpenCfgCodegen
  | 0, _, _, _, _, _, _ => none
  | fuel + 1, layout, ctx, entry, normalLabel, next,
      ConcreteYul.Stmt.ifThen cond body =>
      match compileExprAt layout 0 cond,
          compileCfgStmtOpenCtxRecFrom fuel layout ctx next normalLabel
            (next + 1) body with
      | some condCode, some bodyOpen =>
          if bodyOpen.outLayout = layout then
            some
              { program :=
                  [ (entry,
                    { body := condCode
                      term := Term.branchNZ next normalLabel }) ] ++
                    bodyOpen.program
                outLayout := layout
                nextLabel := bodyOpen.nextLabel }
          else none
      | _, _ => none
  | fuel + 1, layout, ctx, entry, normalLabel, next,
      ConcreteYul.Stmt.seq first second =>
      match
        compileCfgStmtOpenCtxRecFrom fuel layout ctx entry next (next + 1)
          first
      with
      | none => none
      | some firstOpen =>
          match
            compileCfgStmtOpenCtxRecFrom fuel firstOpen.outLayout ctx next
              normalLabel firstOpen.nextLabel second
          with
          | none => none
          | some secondOpen =>
              some
                { program := firstOpen.program ++ secondOpen.program
                  outLayout := secondOpen.outLayout
                  nextLabel := secondOpen.nextLabel }
  | fuel + 1, layout, ctx, entry, normalLabel, next, stmt =>
      match
        compileCfgStmtOpenCtxAutoFrom (fuel + 1) layout ctx entry
          normalLabel stmt
      with
      | none => none
      | some cfg =>
          some
            { program := cfg.program
              outLayout := cfg.outLayout
              nextLabel := next }

