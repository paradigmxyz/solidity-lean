theorem compileIfThenTo_cfg_correct
    {compileFuel : Nat} {layout : Layout}
    {cond : ConcreteYul.Expr} {body : ConcreteYul.Stmt}
    {condCode : List Instr} {bodyGen : Codegen}
    {hash : ConcreteYul.HashOracle} {evalFuel : Nat}
    {source : ConcreteYul.Config} {result : ConcreteYul.Result}
    {tail : Stack} {target : TargetState}
    {entry thenLabel joinLabel : Label}
    (hEntryThen : entry ≠ thenLabel)
    (_hEntryJoin : entry ≠ joinLabel)
    (_hThenJoin : thenLabel ≠ joinLabel)
    (hLayout : layout.WellFormed)
    (hCond : compileExprAt layout 0 cond = some condCode)
    (hBody : compileStmtFuelFrom compileFuel layout body = some bodyGen)
    (hOut : bodyGen.outLayout = layout)
    (hEval :
      ConcreteYul.evalStmtFuel hash evalFuel.succ.succ source
        (ConcreteYul.Stmt.ifThen cond body) = some result)
    (hNoHalt : source.state.halt? = none)
    (hRel : StackRel layout source [] tail target) :
    ∃ target',
      Reaches
        (ifThenToProgram entry thenLabel joinLabel condCode bodyGen.code)
        (Config.at entry target) (Config.at joinLabel target') ∧
        StackRel layout result.config [] tail target' ∧
        result.flow = ConcreteYul.Flow.normal := by
  simp [ConcreteYul.evalStmtFuel] at hEval
  cases hCondEval : ConcreteYul.evalExpr hash cond source with
  | none =>
      simp [hCondEval] at hEval
  | some condResult =>
      cases condResult with
      | mk condValue condConfig =>
          simp [hCondEval] at hEval
          have hCondConfigEq : condConfig = source :=
            compileExprAt_eval_config_eq hCond hCondEval
          have hCondNoHalt :
              condConfig.state.halt? = none := by
            simpa [hCondConfigEq] using hNoHalt
          rcases
            compileExprAt_execList_correct hCond hCondEval hRel with
            ⟨condTarget, hCondExec, hCondRel⟩
          let branchTarget : TargetState :=
            { condTarget with
              stack := frameOf layout condConfig.env ++ tail }
          have hBranchRel :
              StackRel layout condConfig [] tail branchTarget :=
            stackRel_drop_word_temp hCondRel
          by_cases hZero : norm condValue = 0
          · simp [hZero, ConcreteYul.normalResult] at hEval
            cases hEval
            refine ⟨branchTarget, ?_, hBranchRel, rfl⟩
            apply reaches_one
            simp [step, ifThenToProgram, lookupBlock?, hCondExec,
              execTerm, hCondRel.stack_eq, branchTarget, hZero]
          · simp [hZero] at hEval
            rcases
              compileStmtFuelFrom_execList_correct hLayout hBody hEval
                hCondNoHalt hBranchRel with
              ⟨bodyTarget, hBodyExec, hBodyRel, hBodyFlow,
                _hBodyNoHalt, _hBodyLayout⟩
            have hBodyRelLayout :
                StackRel layout result.config [] tail bodyTarget := by
              simpa [hOut] using hBodyRel
            refine ⟨bodyTarget, ?_, hBodyRelLayout, hBodyFlow⟩
            refine
              Reaches.step
                (next := Config.at thenLabel branchTarget) ?_ ?_
            · simp [step, ifThenToProgram, lookupBlock?, hCondExec,
                execTerm, hCondRel.stack_eq, branchTarget, hZero]
            · apply reaches_one
              simp [step, ifThenToProgram, lookupBlock?, hEntryThen,
                hBodyExec, execTerm]

theorem compileIfThenTo_extends_cfg_correct
    {compileFuel : Nat} {layout : Layout}
    {cond : ConcreteYul.Expr} {body : ConcreteYul.Stmt}
    {condCode : List Instr} {bodyGen : Codegen}
    {hash : ConcreteYul.HashOracle} {evalFuel : Nat}
    {source : ConcreteYul.Config} {result : ConcreteYul.Result}
    {tail : Stack} {target : TargetState}
    {entry thenLabel joinLabel : Label} {program : Program}
    (hExtends :
      Program.Extends
        (ifThenToProgram entry thenLabel joinLabel condCode bodyGen.code)
        program)
    (hEntryThen : entry ≠ thenLabel)
    (_hEntryJoin : entry ≠ joinLabel)
    (_hThenJoin : thenLabel ≠ joinLabel)
    (hLayout : layout.WellFormed)
    (hCond : compileExprAt layout 0 cond = some condCode)
    (hBody : compileStmtFuelFrom compileFuel layout body = some bodyGen)
    (hOut : bodyGen.outLayout = layout)
    (hEval :
      ConcreteYul.evalStmtFuel hash evalFuel.succ.succ source
        (ConcreteYul.Stmt.ifThen cond body) = some result)
    (hNoHalt : source.state.halt? = none)
    (hRel : StackRel layout source [] tail target) :
    ∃ target',
      Reaches program (Config.at entry target)
        (Config.at joinLabel target') ∧
        StackRel layout result.config [] tail target' ∧
        result.flow = ConcreteYul.Flow.normal := by
  simp [ConcreteYul.evalStmtFuel] at hEval
  cases hCondEval : ConcreteYul.evalExpr hash cond source with
  | none =>
      simp [hCondEval] at hEval
  | some condResult =>
      cases condResult with
      | mk condValue condConfig =>
          simp [hCondEval] at hEval
          have hCondConfigEq : condConfig = source :=
            compileExprAt_eval_config_eq hCond hCondEval
          have hCondNoHalt :
              condConfig.state.halt? = none := by
            simpa [hCondConfigEq] using hNoHalt
          rcases
            compileExprAt_execList_correct hCond hCondEval hRel with
            ⟨condTarget, hCondExec, hCondRel⟩
          let branchTarget : TargetState :=
            { condTarget with
              stack := frameOf layout condConfig.env ++ tail }
          have hBranchRel :
              StackRel layout condConfig [] tail branchTarget :=
            stackRel_drop_word_temp hCondRel
          have hEntryLookup :
              lookupBlock?
                  (ifThenToProgram entry thenLabel joinLabel condCode
                    bodyGen.code)
                  entry =
                some
                  ({ body := condCode
                     term := Term.branchNZ thenLabel joinLabel } : Block) := by
            simp [ifThenToProgram, lookupBlock?]
          by_cases hZero : norm condValue = 0
          · simp [hZero, ConcreteYul.normalResult] at hEval
            cases hEval
            have hStep :
                step
                    (ifThenToProgram entry thenLabel joinLabel condCode
                      bodyGen.code)
                    (Config.at entry target) =
                  Config.at joinLabel branchTarget := by
              simp [step, ifThenToProgram, lookupBlock?, hCondExec,
                execTerm, hCondRel.stack_eq, branchTarget, hZero]
            refine ⟨branchTarget, ?_, hBranchRel, rfl⟩
            exact reaches_one_of_extends_at hExtends hEntryLookup hStep
          · simp [hZero] at hEval
            rcases
              compileStmtFuelFrom_execList_correct hLayout hBody hEval
                hCondNoHalt hBranchRel with
              ⟨bodyTarget, hBodyExec, hBodyRel, hBodyFlow,
                _hBodyNoHalt, _hBodyLayout⟩
            have hBodyRelLayout :
                StackRel layout result.config [] tail bodyTarget := by
              simpa [hOut] using hBodyRel
            have hEntryStep :
                step
                    (ifThenToProgram entry thenLabel joinLabel condCode
                      bodyGen.code)
                    (Config.at entry target) =
                  Config.at thenLabel branchTarget := by
              simp [step, ifThenToProgram, lookupBlock?, hCondExec,
                execTerm, hCondRel.stack_eq, branchTarget, hZero]
            have hThenLookup :
                lookupBlock?
                    (ifThenToProgram entry thenLabel joinLabel condCode
                      bodyGen.code)
                    thenLabel =
                  some
                    ({ body := bodyGen.code
                       term := Term.jump joinLabel } : Block) := by
              simp [ifThenToProgram, lookupBlock?, hEntryThen]
            have hThenStep :
                step
                    (ifThenToProgram entry thenLabel joinLabel condCode
                      bodyGen.code)
                    (Config.at thenLabel branchTarget) =
                  Config.at joinLabel bodyTarget := by
              simp [step, ifThenToProgram, lookupBlock?, hEntryThen,
                hBodyExec, execTerm]
            refine ⟨bodyTarget, ?_, hBodyRelLayout, hBodyFlow⟩
            refine
              Reaches.step (next := Config.at thenLabel branchTarget) ?_ ?_
            · rw [step_of_extends_at hExtends hEntryLookup]
              exact hEntryStep
            · exact
                reaches_one_of_extends_at hExtends hThenLookup hThenStep

