    (hExit :
      ∀ {gen},
        compileStmtFuelFrom fuel layout stmt = some gen ->
          depthOf exit =
            some (gen.outLayout.slots.length + tailDepth))
    (hControl :
      ∀ {label},
        controlExitLabel? dest stmt = some label ->
          depthOf label = some (layout.slots.length + tailDepth))
    (hThen :
      ∀ {cond body},
        stmt = ConcreteYul.Stmt.ifThen cond body ->
          depthOf (entry + 1) =
            some (layout.slots.length + tailDepth))
    (hIfExit :
      ∀ {cond body},
        stmt = ConcreteYul.Stmt.ifThen cond body ->
          depthOf exit = some (layout.slots.length + tailDepth))
    (hIfBodyChecked :
      ∀ {cond body condCode bodyCfg},
        stmt = ConcreteYul.Stmt.ifThen cond body ->
        compileExprAt layout 0 cond = some condCode ->
        compileCfgStmtOpenFrom fuel layout dest (entry + 1) exit body =
          some bodyCfg ->
        bodyCfg.outLayout = layout ->
        Program.DepthChecked depthOf bodyCfg.program) :
