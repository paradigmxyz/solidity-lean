theorem compileFunctionEnvFrom_covers
    {compileFuel start : Nat} {sourceFns : ConcreteYul.FunctionEnv}
    {compiledFns : CompiledFunctionEnv}
    (hCompile :
      compileFunctionEnvFrom compileFuel start sourceFns =
        some compiledFns) :
    CompiledFunctionEnvCovers compileFuel sourceFns compiledFns := by
  induction sourceFns generalizing start compiledFns with
  | nil =>
      simp [compileFunctionEnvFrom] at hCompile
      cases hCompile
      intro name fn hLookup
      simp [ConcreteYul.lookupFunction?] at hLookup
  | cons entry rest ih =>
      cases entry with
      | mk fnName fn =>
          simp [compileFunctionEnvFrom] at hCompile
          cases hHead :
              compileFunctionDefFrom compileFuel start
                (start + compileFuel + 2) fn with
          | none =>
              simp [hHead] at hCompile
          | some compiled =>
              cases hRest :
                  compileFunctionEnvFrom compileFuel
                    (start + functionLabelStride compileFuel) rest with
              | none =>
                  simp [hHead, hRest] at hCompile
              | some compiledRest =>
                  simp [hHead, hRest] at hCompile
                  cases hCompile
                  have hRestCovers :
                      CompiledFunctionEnvCovers compileFuel rest
                        compiledRest :=
                    ih hRest
                  intro name queryFn hLookup
                  by_cases hName : fnName = name
                  · subst name
                    simp [ConcreteYul.lookupFunction?] at hLookup
                    cases hLookup
                    refine ⟨compiled, ?_, ?_⟩
                    · simp [lookupCompiledFunction?]
                    · exact compileFunctionDefFrom_matches hHead
                  · simp [ConcreteYul.lookupFunction?, hName] at hLookup
                    rcases hRestCovers hLookup with
                      ⟨compiledQuery, hCompiledLookup, hMatches⟩
                    refine ⟨compiledQuery, ?_, hMatches⟩
                    simp [lookupCompiledFunction?, hName, hCompiledLookup]

