            compileExprAt_execList_correct hDiscr hDiscrEval hRel with
            ⟨discrTarget, hDiscrExec, hDiscrRel⟩
          let poppedTarget : TargetState :=
            { discrTarget with
              stack := frameOf layout discrConfig.env ++ tail }
          have hStack :
              discrTarget.stack =
                Atom.word discrValue :: frameOf layout discrConfig.env ++
                  tail := by
            simpa using hDiscrRel.stack_eq
          have hFallbackExec :
              execList (switchFallbackBody none) discrTarget =
                some poppedTarget := by
            simpa [poppedTarget] using
              execList_switchFallbackBody_none
                (target := discrTarget) (discrValue := discrValue)
                (stackRest := frameOf layout discrConfig.env ++ tail)
                hStack
          have hPoppedRel :
              StackRel layout discrConfig [] tail poppedTarget :=
            stackRel_drop_word_temp hDiscrRel
          have hEntryStep :
              step
                  (switchChainAutoToProgram entry caseLabelStart joinLabel
                    discrCode [] none)
                  (Config.at entry target) =
                Config.at (switchChainFallbackLabel caseLabelStart [])
                  discrTarget := by
            rw [switchChainAutoToProgram]
            exact
              switchChainToProgram_entry_empty_step
                (entry := entry) (caseLabelStart := caseLabelStart)
                (testLabelStart :=
                  switchChainTestLabelStart caseLabelStart [])
                (fallbackLabel := switchChainFallbackLabel caseLabelStart [])
                (joinLabel := joinLabel) (discrCode := discrCode)
                (defaultCode? := none) hDiscrExec
          have hFallbackStep :
              step
                  (switchChainAutoToProgram entry caseLabelStart joinLabel
                    discrCode [] none)
                  (Config.at (switchChainFallbackLabel caseLabelStart [])
                    discrTarget) =
                Config.at joinLabel poppedTarget :=
            switchChainAutoToProgram_fallback_step
              (entry := entry) (caseLabelStart := caseLabelStart)
              (joinLabel := joinLabel) (discrCode := discrCode)
              (cases := []) (defaultCode? := none)
              (target := discrTarget) (fallbackTarget := poppedTarget)
              hEntryBefore hFallbackExec
          refine ⟨poppedTarget, ?_, hPoppedRel, rfl⟩
          refine
            Reaches.step
              (next :=
                Config.at (switchChainFallbackLabel caseLabelStart [])
                  discrTarget)
