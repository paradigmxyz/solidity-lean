    (hThen : depthOf thenLabel = some (layout.slots.length + tailDepth))
    (hExit : depthOf exit = some (layout.slots.length + tailDepth)) :
    ∃ condCode bodyCfg,
      compileExprAt layout 0 cond = some condCode ∧
        compileCfgStmtOpenFrom fuel layout dest thenLabel exit body =
