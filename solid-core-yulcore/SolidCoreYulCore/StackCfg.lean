  | nil =>
      simp [ConcreteYul.switchTarget?] at hTarget
  | cons entry rest ih =>
      cases entry with
      | mk value stmt =>
          rcases compileSwitchCasesFrom_cons hCompile with
            ⟨gen, restCodes, hStmtCompile, hOut, hRestCompile,
              hCaseCodes⟩
          subst caseCodes
          by_cases hMatch : norm value = norm discrValue
          · have hSelected : stmt = selectedBody := by
              simpa [ConcreteYul.switchTarget?, hMatch] using hTarget
            subst selectedBody
            rcases
              compileStmtFuelFrom_execList_correct hLayout hStmtCompile
                hEval hNoHalt hRel with
              ⟨caseTarget, hExec, hCaseRel, hFlow,
                _hCaseNoHalt, _hCaseLayout⟩
            have hCaseRelLayout :
                StackRel layout result.config [] tail caseTarget := by
              simpa [hOut] using hCaseRel
            exact
              ⟨caseTarget,
                SwitchCaseCodesExec.head hMatch.symm hExec,
                hCaseRelLayout, hFlow⟩
          · have hMiss : norm discrValue ≠ norm value := by
              intro h
              exact hMatch h.symm
            have hRestTarget :
                ConcreteYul.switchTarget? discrValue rest none =
                  some selectedBody := by
              simpa [ConcreteYul.switchTarget?, hMatch] using hTarget
            rcases
              ih hRestCompile hRestTarget with
              ⟨caseTarget, hSelected, hCaseRel, hFlow⟩
            cases restCodes with
            | nil =>
                cases hSelected
            | cons nextCode restCodes =>
                exact
                  ⟨caseTarget,
                    SwitchCaseCodesExec.tail hMiss hSelected,
                    hCaseRel, hFlow⟩

