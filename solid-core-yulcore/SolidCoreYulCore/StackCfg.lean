          cases hBody :
              compileFunctionBodyWithReturnFrom compileFuel entryLayout
                fn.returns entry returnLabel fn.body with
          | none =>
              simp [hBody] at hMatches
          | some bodyCfg =>
              simp [hBody] at hMatches
              cases hMatches
              cases hInit :
                  ConcreteYul.initFunctionEnv fn.params args fn.returns with
              | none =>
                  simp_all [compiledFunctionInitialSource?]
              | some callEnv =>
                  simp_all [compiledFunctionInitialSource?,
                    compiledFunctionInitialTarget?]
                  cases hSource
                  cases hTarget
                  exact
                    { state_eq := rfl
                      stack_eq := by simp
                      bound :=
                        functionEntryLayout?_bound_initFunctionEnv hEntry
                          hInit }

