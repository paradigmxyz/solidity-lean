                  step
                      (switchTwoNoDefaultToProgram entry firstLabel testLabel
                        secondLabel missLabel joinLabel discrCode firstValue
                        secondValue firstGen.code secondGen.code)
                      (Config.at entry target) =
                    Config.at testLabel discrTarget := by
                simp [step, switchTwoNoDefaultToProgram, lookupBlock?,
                  hDiscrExec, execTerm, hDiscrRel.stack_eq,
                  hFirstBranchNo]
              have hTestLookup :
                  lookupBlock?
                      (switchTwoNoDefaultToProgram entry firstLabel testLabel
                        secondLabel missLabel joinLabel discrCode firstValue
                        secondValue firstGen.code secondGen.code)
                      testLabel =
                    some
                      ({ body := []
                         term := Term.branchEq secondValue secondLabel
                           missLabel } : Block) := by
                simp [switchTwoNoDefaultToProgram, lookupBlock?,
                  hEntryTest, hFirstTest]
              have hTestStep :
                  step
                      (switchTwoNoDefaultToProgram entry firstLabel testLabel
                        secondLabel missLabel joinLabel discrCode firstValue
                        secondValue firstGen.code secondGen.code)
                      (Config.at testLabel discrTarget) =
                    Config.at missLabel discrTarget := by
                simp [step, switchTwoNoDefaultToProgram, lookupBlock?,
                  hEntryTest, hFirstTest, execList, execTerm,
                  hDiscrRel.stack_eq, hSecondBranchNo]
              have hMissLookup :
                  lookupBlock?
                      (switchTwoNoDefaultToProgram entry firstLabel testLabel
                        secondLabel missLabel joinLabel discrCode firstValue
                        secondValue firstGen.code secondGen.code)
                      missLabel =
                    some
                      ({ body := [Instr.pop]
                         term := Term.jump joinLabel } : Block) := by
                simp [switchTwoNoDefaultToProgram, lookupBlock?,
                  hEntryMiss, hFirstMiss, hTestMiss, hSecondMiss]
              have hMissStep :
                  step
                      (switchTwoNoDefaultToProgram entry firstLabel testLabel
                        secondLabel missLabel joinLabel discrCode firstValue
                        secondValue firstGen.code secondGen.code)
                      (Config.at missLabel discrTarget) =
                    Config.at joinLabel poppedTarget := by
                simp [step, switchTwoNoDefaultToProgram, lookupBlock?,
                  hEntryMiss, hFirstMiss, hTestMiss, hSecondMiss,
                  execList, execInstr, hDiscrRel.stack_eq, poppedTarget,
                  execTerm]
              refine ⟨poppedTarget, ?_, hPoppedRel, rfl⟩
              refine
                Reaches.step (next := Config.at testLabel discrTarget)
                  ?_ ?_
              · rw [step_of_extends_at hExtends hEntryLookup]
                exact hEntryStep
              · refine
                  Reaches.step (next := Config.at missLabel discrTarget)
                    ?_ ?_
                · rw [step_of_extends_at hExtends hTestLookup]
                  exact hTestStep
                · exact
                    reaches_one_of_extends_at hExtends hMissLookup
