    {fn : ConcreteYul.FunctionDef} {compiled : CompiledFunction}
    {tailDepth : Nat}
    (hCompile :
      compileFunctionDefFrom (fuel + 1) entry returnLabel fn =
        some compiled)
    (hEntryDepth :
      ∀ {entryLayout},
        functionEntryLayout? fn.params fn.returns = some entryLayout ->
          depthOf entry =
            some (entryLayout.slots.length + tailDepth))
    (hReturnLabel :
      ∀ {entryLayout openCfg},
        functionEntryLayout? fn.params fn.returns = some entryLayout ->
        compileCfgStmtOpenRecAutoFrom (fuel + 1) entryLayout
            (functionReturnDest returnLabel) entry returnLabel fn.body =
          some openCfg ->
        depthOf returnLabel =
          some (openCfg.outLayout.slots.length + tailDepth))
    (hExit :
      ∀ {entryLayout gen},
        functionEntryLayout? fn.params fn.returns = some entryLayout ->
        compileStmtFuelFrom (fuel + 1) entryLayout fn.body = some gen ->
          depthOf returnLabel =
            some (gen.outLayout.slots.length + tailDepth))
    (hControl :
      ∀ {entryLayout label},
        functionEntryLayout? fn.params fn.returns = some entryLayout ->
        controlExitLabel? (functionReturnDest returnLabel) fn.body =
          some label ->
          depthOf label = some (entryLayout.slots.length + tailDepth))
    (hIfNext :
      ∀ {entryLayout cond body},
        functionEntryLayout? fn.params fn.returns = some entryLayout ->
        fn.body = ConcreteYul.Stmt.ifThen cond body ->
          depthOf (entry + 1) =
            some (entryLayout.slots.length + tailDepth))
    (hIfExit :
      ∀ {entryLayout cond body},
        functionEntryLayout? fn.params fn.returns = some entryLayout ->
        fn.body = ConcreteYul.Stmt.ifThen cond body ->
          depthOf returnLabel =
            some (entryLayout.slots.length + tailDepth))
    (hIfBodyChecked :
      ∀ {entryLayout cond body condCode bodyOpen},
        functionEntryLayout? fn.params fn.returns = some entryLayout ->
        fn.body = ConcreteYul.Stmt.ifThen cond body ->
        compileExprAt entryLayout 0 cond = some condCode ->
        compileCfgStmtOpenRecFrom fuel entryLayout
            (functionReturnDest returnLabel) (entry + 1) returnLabel
            (entry + 1 + 1) body =
          some bodyOpen ->
        bodyOpen.outLayout = entryLayout ->
        Program.DepthChecked depthOf bodyOpen.program)
    (hSeqNext :
      ∀ {entryLayout first second firstGen},
        functionEntryLayout? fn.params fn.returns = some entryLayout ->
        fn.body = ConcreteYul.Stmt.seq first second ->
        compileCfgStmtOpenFrom (fuel + 1) entryLayout
            (functionReturnDest returnLabel) entry returnLabel
            (ConcreteYul.Stmt.seq first second) =
          none ->
        compileStmtFuelFrom fuel entryLayout first = some firstGen ->
          depthOf (entry + 1) =
            some (firstGen.outLayout.slots.length + tailDepth))
    (hSeqSecondChecked :
      ∀ {entryLayout first second firstGen secondOpen},
        functionEntryLayout? fn.params fn.returns = some entryLayout ->
        fn.body = ConcreteYul.Stmt.seq first second ->
        compileCfgStmtOpenFrom (fuel + 1) entryLayout
            (functionReturnDest returnLabel) entry returnLabel
            (ConcreteYul.Stmt.seq first second) =
          none ->
        compileStmtFuelFrom fuel entryLayout first = some firstGen ->
        compileCfgStmtOpenRecFrom fuel firstGen.outLayout
            (functionReturnDest returnLabel) (entry + 1) returnLabel
            (entry + 1 + 1) second =
          some secondOpen ->
        Program.DepthChecked depthOf secondOpen.program) :
    Program.DepthChecked depthOf compiled.program :=
  compileFunctionDefFrom_programDepthChecked_of_obligations
    (depthOf := depthOf) (fuel := fuel) (entry := entry)
    (returnLabel := returnLabel) (fn := fn) (compiled := compiled)
    (tailDepth := tailDepth)
    hCompile
    { body := fun hEntryLayout =>
        { openRec :=
            { entryDepth := hEntryDepth hEntryLayout
              exitDepth := hExit hEntryLayout
              controlDepth := hControl hEntryLayout
              ifNextDepth := fun hBody =>
                hIfNext hEntryLayout hBody
              ifExitDepth := fun hBody =>
                hIfExit hEntryLayout hBody
              ifBodyChecked := fun hBody hCond hRec hOut =>
                hIfBodyChecked hEntryLayout hBody hCond hRec hOut
              seqNextDepth := fun hBody hDirect hFirst =>
                hSeqNext hEntryLayout hBody hDirect hFirst
              seqSecondChecked := fun hBody hDirect hFirst hSecond =>
                hSeqSecondChecked hEntryLayout hBody hDirect hFirst
                  hSecond }
          returnLabelDepth := fun hOpen =>
            hReturnLabel hEntryLayout hOpen } }

structure FunctionEnvDepthObligations
    (depthOf : ConcreteYul.Name -> DepthEnv) (fuel start : Nat)
    (sourceFns : ConcreteYul.FunctionEnv) (tailDepth : Nat) : Prop where
  function :
    ∀ {name : ConcreteYul.Name} {fn : ConcreteYul.FunctionDef}
      {entry returnLabel : Nat},
      FunctionDefDepthObligations (depthOf name) fuel entry returnLabel fn
        tailDepth

theorem compileFunctionEnvFrom_depthChecked_of_obligations
    {depthOf : ConcreteYul.Name -> DepthEnv}
    {fuel start : Nat} {sourceFns : ConcreteYul.FunctionEnv}
    {compiledFns : CompiledFunctionEnv} {tailDepth : Nat}
    (hCompile :
      compileFunctionEnvFrom (fuel + 1) start sourceFns =
        some compiledFns)
    (hObligations :
      FunctionEnvDepthObligations depthOf fuel start sourceFns
        tailDepth) :
    CompiledFunctionEnv.DepthChecked depthOf compiledFns :=
  compileFunctionEnvFrom_depthChecked
    (depthOf := depthOf) (fuel := fuel + 1) (start := start)
    (sourceFns := sourceFns) (compiledFns := compiledFns)
    hCompile
    (fun {name fn entry returnLabel compiled} hDef =>
      compileFunctionDefFrom_programDepthChecked_of_obligations
        (depthOf := depthOf name) (fuel := fuel) (entry := entry)
        (returnLabel := returnLabel) (fn := fn) (compiled := compiled)
        (tailDepth := tailDepth)
        hDef (hObligations.function (name := name) (fn := fn)
          (entry := entry) (returnLabel := returnLabel)))

theorem compileFunctionEnvFrom_depthChecked_of_openRec
    {depthOf : ConcreteYul.Name -> DepthEnv}
    {fuel start : Nat} {sourceFns : ConcreteYul.FunctionEnv}
    {compiledFns : CompiledFunctionEnv} {tailDepth : Nat}
    (hCompile :
      compileFunctionEnvFrom (fuel + 1) start sourceFns =
        some compiledFns)
    (hEntryDepth :
      ∀ {name : ConcreteYul.Name} {fn : ConcreteYul.FunctionDef}
        {entry : Nat} {entryLayout : Layout},
        functionEntryLayout? fn.params fn.returns = some entryLayout ->
          depthOf name entry =
            some (entryLayout.slots.length + tailDepth))
    (hReturnLabel :
      ∀ {name : ConcreteYul.Name} {fn : ConcreteYul.FunctionDef}
        {entry returnLabel : Nat} {entryLayout : Layout}
        {openCfg : OpenCfgCodegen},
        functionEntryLayout? fn.params fn.returns = some entryLayout ->
        compileCfgStmtOpenRecAutoFrom (fuel + 1) entryLayout
            (functionReturnDest returnLabel) entry returnLabel fn.body =
          some openCfg ->
        depthOf name returnLabel =
          some (openCfg.outLayout.slots.length + tailDepth))
    (hExit :
      ∀ {name : ConcreteYul.Name} {fn : ConcreteYul.FunctionDef}
        {returnLabel : Nat} {entryLayout : Layout} {gen : Codegen},
        functionEntryLayout? fn.params fn.returns = some entryLayout ->
        compileStmtFuelFrom (fuel + 1) entryLayout fn.body = some gen ->
          depthOf name returnLabel =
            some (gen.outLayout.slots.length + tailDepth))
    (hControl :
      ∀ {name : ConcreteYul.Name} {fn : ConcreteYul.FunctionDef}
        {returnLabel : Nat} {entryLayout : Layout} {label : Label},
        functionEntryLayout? fn.params fn.returns = some entryLayout ->
        controlExitLabel? (functionReturnDest returnLabel) fn.body =
          some label ->
          depthOf name label =
            some (entryLayout.slots.length + tailDepth))
    (hIfNext :
      ∀ {name : ConcreteYul.Name} {fn : ConcreteYul.FunctionDef}
        {entry : Nat} {entryLayout : Layout}
        {cond : ConcreteYul.Expr} {body : ConcreteYul.Stmt},
        functionEntryLayout? fn.params fn.returns = some entryLayout ->
        fn.body = ConcreteYul.Stmt.ifThen cond body ->
          depthOf name (entry + 1) =
            some (entryLayout.slots.length + tailDepth))
    (hIfExit :
      ∀ {name : ConcreteYul.Name} {fn : ConcreteYul.FunctionDef}
        {returnLabel : Nat} {entryLayout : Layout}
        {cond : ConcreteYul.Expr} {body : ConcreteYul.Stmt},
        functionEntryLayout? fn.params fn.returns = some entryLayout ->
        fn.body = ConcreteYul.Stmt.ifThen cond body ->
          depthOf name returnLabel =
            some (entryLayout.slots.length + tailDepth))
    (hIfBodyChecked :
      ∀ {name : ConcreteYul.Name} {fn : ConcreteYul.FunctionDef}
        {entry returnLabel : Nat} {entryLayout : Layout}
        {cond : ConcreteYul.Expr} {body : ConcreteYul.Stmt}
        {condCode : List Instr} {bodyOpen : OpenCfgCodegen},
        functionEntryLayout? fn.params fn.returns = some entryLayout ->
        fn.body = ConcreteYul.Stmt.ifThen cond body ->
        compileExprAt entryLayout 0 cond = some condCode ->
        compileCfgStmtOpenRecFrom fuel entryLayout
            (functionReturnDest returnLabel) (entry + 1) returnLabel
            (entry + 1 + 1) body =
          some bodyOpen ->
        bodyOpen.outLayout = entryLayout ->
        Program.DepthChecked (depthOf name) bodyOpen.program)
    (hSeqNext :
      ∀ {name : ConcreteYul.Name} {fn : ConcreteYul.FunctionDef}
        {entry returnLabel : Nat} {entryLayout : Layout}
        {first second : ConcreteYul.Stmt} {firstGen : Codegen},
        functionEntryLayout? fn.params fn.returns = some entryLayout ->
        fn.body = ConcreteYul.Stmt.seq first second ->
        compileCfgStmtOpenFrom (fuel + 1) entryLayout
            (functionReturnDest returnLabel) entry returnLabel
            (ConcreteYul.Stmt.seq first second) =
          none ->
        compileStmtFuelFrom fuel entryLayout first = some firstGen ->
          depthOf name (entry + 1) =
            some (firstGen.outLayout.slots.length + tailDepth))
    (hSeqSecondChecked :
      ∀ {name : ConcreteYul.Name} {fn : ConcreteYul.FunctionDef}
        {entry returnLabel : Nat} {entryLayout : Layout}
        {first second : ConcreteYul.Stmt} {firstGen : Codegen}
        {secondOpen : OpenCfgCodegen},
        functionEntryLayout? fn.params fn.returns = some entryLayout ->
        fn.body = ConcreteYul.Stmt.seq first second ->
        compileCfgStmtOpenFrom (fuel + 1) entryLayout
            (functionReturnDest returnLabel) entry returnLabel
            (ConcreteYul.Stmt.seq first second) =
          none ->
        compileStmtFuelFrom fuel entryLayout first = some firstGen ->
        compileCfgStmtOpenRecFrom fuel firstGen.outLayout
            (functionReturnDest returnLabel) (entry + 1) returnLabel
            (entry + 1 + 1) second =
          some secondOpen ->
        Program.DepthChecked (depthOf name) secondOpen.program) :
    CompiledFunctionEnv.DepthChecked depthOf compiledFns :=
  compileFunctionEnvFrom_depthChecked_of_obligations
    (depthOf := depthOf) (fuel := fuel) (start := start)
    (sourceFns := sourceFns) (compiledFns := compiledFns)
    hCompile
    { function := fun {name fn entry returnLabel} =>
        { body := fun hEntryLayout =>
            { openRec :=
                { entryDepth :=
                    hEntryDepth (name := name) (fn := fn)
                      (entry := entry) hEntryLayout
                  exitDepth := fun hGen =>
                    hExit (name := name) (fn := fn)
                      (returnLabel := returnLabel) hEntryLayout hGen
                  controlDepth := fun hControlLabel =>
                    hControl (name := name) (fn := fn)
                      (returnLabel := returnLabel) hEntryLayout
                      hControlLabel
                  ifNextDepth := fun hBody =>
                    hIfNext (name := name) (fn := fn) (entry := entry)
                      hEntryLayout hBody
                  ifExitDepth := fun hBody =>
                    hIfExit (name := name) (fn := fn)
                      (returnLabel := returnLabel) hEntryLayout hBody
                  ifBodyChecked := fun hBody hCond hRec hOut =>
                    hIfBodyChecked (name := name) (fn := fn)
                      (entry := entry) (returnLabel := returnLabel)
                      hEntryLayout hBody hCond hRec hOut
                  seqNextDepth := fun hBody hDirect hFirst =>
                    hSeqNext (name := name) (fn := fn)
                      (entry := entry) (returnLabel := returnLabel)
                      hEntryLayout hBody hDirect hFirst
                  seqSecondChecked := fun hBody hDirect hFirst hSecond =>
                    hSeqSecondChecked (name := name) (fn := fn)
                      (entry := entry) (returnLabel := returnLabel)
                      hEntryLayout hBody hDirect hFirst hSecond }
              returnLabelDepth := fun hOpen =>
                hReturnLabel (name := name) (fn := fn)
                  (entry := entry) (returnLabel := returnLabel)
                  hEntryLayout hOpen } } }

theorem switchDiscrBlockDepthAfterWithTargets
    {depthOf : DepthEnv} {layout : Layout}
    {discr : ConcreteYul.Expr} {discrCode : List Instr}
    {caseValue : Word} {caseLabel missLabel : Label}
    {tailDepth : Nat}
    (hDiscr : compileExprAt layout 0 discr = some discrCode)
    (hCase :
      depthOf caseLabel =
        some (layout.slots.length + tailDepth + 1))
    (hMiss :
      depthOf missLabel =
        some (layout.slots.length + tailDepth + 1)) :
    blockDepthAfterWithTargets? depthOf
        { body := discrCode
          term := Term.branchEq caseValue caseLabel missLabel }
        (layout.slots.length + tailDepth) =
      some (layout.slots.length + tailDepth + 1) := by
  have hDiscrDepth :=
    compileExprAt_codeDepthAfter
      (layout := layout) (tempDepth := 0)
      (expr := discr) (code := discrCode) (tailDepth := tailDepth)
      hDiscr
  have hDiscrDepth' :
      codeDepthAfter? discrCode (layout.slots.length + tailDepth) =
        some (layout.slots.length + tailDepth + 1) := by
    simpa using hDiscrDepth
  have hPos : 0 < layout.slots.length + tailDepth + 1 := by
    omega
  exact
    blockDepthAfterWithTargets?_branchEq_of_codeDepthAfter
      (depthOf := depthOf) (body := discrCode)
      (expected := caseValue) (thenLabel := caseLabel)
      (elseLabel := missLabel)
      (start := layout.slots.length + tailDepth)
      (branchDepth := layout.slots.length + tailDepth + 1)
      hDiscrDepth' hPos hCase hMiss

theorem switchMissBlockDepthAfterWithTargets
    {depthOf : DepthEnv} {layout : Layout}
    {joinLabel : Label} {tailDepth : Nat}
    (hJoin : depthOf joinLabel = some (layout.slots.length + tailDepth)) :
    blockDepthAfterWithTargets? depthOf
        { body := [Instr.pop], term := Term.jump joinLabel }
        (layout.slots.length + tailDepth + 1) =
      some (layout.slots.length + tailDepth) := by
  have hPop :
      codeDepthAfter? [Instr.pop]
          (layout.slots.length + tailDepth + 1) =
        some (layout.slots.length + tailDepth) := by
    simp [codeDepthAfter?, instrDepthAfter?]
  exact blockDepthAfterWithTargets?_jump_of_codeDepthAfter hPop hJoin

theorem switchFallbackBody_codeDepthAfter
    {layout : Layout} {defaultCode? : Option (List Instr)}
    {tailDepth : Nat}
    (hDefaultDepth :
      ∀ {code},
        defaultCode? = some code ->
          codeDepthAfter? code (layout.slots.length + tailDepth) =
            some (layout.slots.length + tailDepth)) :
    codeDepthAfter? (switchFallbackBody defaultCode?)
        (layout.slots.length + tailDepth + 1) =
      some (layout.slots.length + tailDepth) := by
  cases defaultCode? with
  | none =>
      simp [switchFallbackBody, codeDepthAfter?, instrDepthAfter?]
  | some code =>
      have hPop :
          codeDepthAfter? [Instr.pop]
              (layout.slots.length + tailDepth + 1) =
            some (layout.slots.length + tailDepth) := by
        simp [codeDepthAfter?, instrDepthAfter?]
      have hCode :
          codeDepthAfter? code (layout.slots.length + tailDepth) =
            some (layout.slots.length + tailDepth) :=
        hDefaultDepth rfl
      have hAll := codeDepthAfter?_append hPop hCode
      simpa [switchFallbackBody] using hAll

theorem switchFallbackBlockDepthAfterWithTargets
    {depthOf : DepthEnv} {layout : Layout}
    {defaultCode? : Option (List Instr)}
    {joinLabel : Label} {tailDepth : Nat}
    (hDefaultDepth :
      ∀ {code},
        defaultCode? = some code ->
          codeDepthAfter? code (layout.slots.length + tailDepth) =
            some (layout.slots.length + tailDepth))
    (hJoin : depthOf joinLabel = some (layout.slots.length + tailDepth)) :
    blockDepthAfterWithTargets? depthOf
        { body := switchFallbackBody defaultCode?
          term := Term.jump joinLabel }
        (layout.slots.length + tailDepth + 1) =
      some (layout.slots.length + tailDepth) :=
  blockDepthAfterWithTargets?_jump_of_codeDepthAfter
    (switchFallbackBody_codeDepthAfter
      (layout := layout) (defaultCode? := defaultCode?)
      (tailDepth := tailDepth) hDefaultDepth)
    hJoin

theorem compileSwitchDefaultFrom_codeDepthAfter
    {fuel : Nat} {layout : Layout}
    {defaultBranch : Option ConcreteYul.Stmt}
    {defaultCode? : Option (List Instr)} {tailDepth : Nat}
    (hCompile :
      compileSwitchDefaultFrom fuel layout defaultBranch =
        some defaultCode?) :
    ∀ {code},
      defaultCode? = some code ->
        codeDepthAfter? code (layout.slots.length + tailDepth) =
          some (layout.slots.length + tailDepth) := by
  cases defaultBranch with
  | none =>
      have hNone := compileSwitchDefaultFrom_none hCompile
      intro code hCode
      simp [hNone] at hCode
  | some stmt =>
      cases defaultCode? with
      | none =>
          simp [compileSwitchDefaultFrom] at hCompile
          cases hStmt : compileStmtFuelFrom fuel layout stmt with
          | none =>
              simp [hStmt] at hCompile
          | some gen =>
              by_cases hOut : gen.outLayout = layout
              · simp [hStmt, hOut] at hCompile
              · simp [hStmt, hOut] at hCompile
      | some code =>
          rcases compileSwitchDefaultFrom_some hCompile with
            ⟨gen, hStmt, hOut, hCode⟩
          intro foundCode hFound
          simp at hFound
          cases hFound
          have hDepth :=
            compileStmtFuelFrom_codeDepthAfter
              (compileFuel := fuel) (layout := layout) (stmt := stmt)
              (gen := gen) (tailDepth := tailDepth) hStmt
          simpa [hOut, hCode] using hDepth

theorem switchCaseBlockDepthAfterWithTargets
    {depthOf : DepthEnv} {compileFuel : Nat}
    {layout : Layout} {stmt : ConcreteYul.Stmt}
    {gen : Codegen} {joinLabel : Label} {tailDepth : Nat}
    (hCompile : compileStmtFuelFrom compileFuel layout stmt = some gen)
    (hOut : gen.outLayout = layout)
    (hJoin : depthOf joinLabel = some (layout.slots.length + tailDepth)) :
    blockDepthAfterWithTargets? depthOf
        { body := Instr.pop :: gen.code, term := Term.jump joinLabel }
        (layout.slots.length + tailDepth + 1) =
      some (layout.slots.length + tailDepth) := by
  have hPop :
      codeDepthAfter? [Instr.pop]
          (layout.slots.length + tailDepth + 1) =
        some (layout.slots.length + tailDepth) := by
    simp [codeDepthAfter?, instrDepthAfter?]
  have hBody :=
    compileStmtFuelFrom_codeDepthAfter
      (compileFuel := compileFuel) (layout := layout) (stmt := stmt)
      (gen := gen) (tailDepth := tailDepth) hCompile
  have hBody' :
      codeDepthAfter? gen.code (layout.slots.length + tailDepth) =
        some (layout.slots.length + tailDepth) := by
    simpa [hOut] using hBody
  have hCode := codeDepthAfter?_append hPop hBody'
  exact
    blockDepthAfterWithTargets?_jump_of_codeDepthAfter
      (body := Instr.pop :: gen.code)
      hCode hJoin

theorem compileSwitchCasesFrom_caseBlocksDepthChecked
    {depthOf : DepthEnv} {fuel : Nat} {layout : Layout}
    {cases : List (Word × ConcreteYul.Stmt)}
    {caseCodes : List SwitchCaseCode}
    {caseLabelStart joinLabel : Label} {tailDepth : Nat}
    (hCompile :
      compileSwitchCasesFrom fuel layout cases = some caseCodes)
    (hCaseDepth :
      ∀ {label},
        caseLabelStart ≤ label ->
          label < caseLabelStart + caseCodes.length ->
            depthOf label =
              some (layout.slots.length + tailDepth + 1))
    (hJoin : depthOf joinLabel = some (layout.slots.length + tailDepth)) :
    Program.DepthChecked depthOf
      (switchCaseBlocksFrom caseLabelStart joinLabel caseCodes) := by
  induction cases generalizing caseCodes caseLabelStart with
  | nil =>
      have hCodes := compileSwitchCasesFrom_nil hCompile
      subst caseCodes
      simp [switchCaseBlocksFrom, Program.DepthChecked.nil]
  | cons entry rest ih =>
      cases entry with
      | mk value stmt =>
          rcases compileSwitchCasesFrom_cons hCompile with
            ⟨gen, restCodes, hStmt, hOut, hRest, hCodes⟩
          subst caseCodes
          have hHeadDepth :
              depthOf caseLabelStart =
                some (layout.slots.length + tailDepth + 1) := by
            apply hCaseDepth
            · exact Nat.le_refl caseLabelStart
            · simp
          have hTailDepth :
              ∀ {label},
                caseLabelStart + 1 ≤ label ->
                  label < caseLabelStart + 1 + restCodes.length ->
                    depthOf label =
                      some (layout.slots.length + tailDepth + 1) := by
            intro label hLe hLt
            apply hCaseDepth
            · exact Nat.le_trans (Nat.le_succ caseLabelStart) hLe
            · simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hLt
          change
            Program.DepthChecked depthOf
              ((caseLabelStart,
                  { body := Instr.pop :: gen.code
                    term := Term.jump joinLabel }) ::
                switchCaseBlocksFrom (caseLabelStart + 1) joinLabel
                  restCodes)
          exact
            Program.DepthChecked.cons
              (entry := caseLabelStart)
              (block := { body := Instr.pop :: gen.code
                          term := Term.jump joinLabel })
              (rest :=
                switchCaseBlocksFrom (caseLabelStart + 1) joinLabel
                  restCodes)
              (depth := layout.slots.length + tailDepth + 1)
              (outDepth := layout.slots.length + tailDepth)
              hHeadDepth
              (switchCaseBlockDepthAfterWithTargets
                (depthOf := depthOf) (compileFuel := fuel)
                (layout := layout) (stmt := stmt) (gen := gen)
                (joinLabel := joinLabel) (tailDepth := tailDepth)
                hStmt hOut hJoin)
              (ih
                (caseCodes := restCodes)
                (caseLabelStart := caseLabelStart + 1)
                hRest hTailDepth)

theorem switchTestBlockDepthAfterWithTargets
    {depthOf : DepthEnv} {layout : Layout}
    {caseValue : Word} {caseLabel missLabel : Label}
    {tailDepth : Nat}
    (hCase :
      depthOf caseLabel =
        some (layout.slots.length + tailDepth + 1))
    (hMiss :
      depthOf missLabel =
        some (layout.slots.length + tailDepth + 1)) :
    blockDepthAfterWithTargets? depthOf
        { body := []
          term := Term.branchEq caseValue caseLabel missLabel }
        (layout.slots.length + tailDepth + 1) =
      some (layout.slots.length + tailDepth + 1) := by
  have hBody :
      codeDepthAfter? [] (layout.slots.length + tailDepth + 1) =
        some (layout.slots.length + tailDepth + 1) := by
    simp [codeDepthAfter?]
  have hPos : 0 < layout.slots.length + tailDepth + 1 := by
    omega
  exact
    blockDepthAfterWithTargets?_branchEq_of_codeDepthAfter
      (depthOf := depthOf) (body := [])
      (expected := caseValue) (thenLabel := caseLabel)
      (elseLabel := missLabel)
      (start := layout.slots.length + tailDepth + 1)
      (branchDepth := layout.slots.length + tailDepth + 1)
      hBody hPos hCase hMiss

theorem switchTailTestBlocksFrom_depthChecked
    {depthOf : DepthEnv} {layout : Layout}
    {cases : List SwitchCaseCode}
    {testLabel caseLabel fallbackLabel : Label} {tailDepth : Nat}
    (hTestDepth :
      ∀ {label},
        testLabel ≤ label ->
          label < testLabel + cases.length ->
            depthOf label =
              some (layout.slots.length + tailDepth + 1))
    (hCaseDepth :
      ∀ {label},
        caseLabel ≤ label ->
          label < caseLabel + cases.length ->
            depthOf label =
              some (layout.slots.length + tailDepth + 1))
    (hFallback :
      depthOf fallbackLabel =
        some (layout.slots.length + tailDepth + 1)) :
    Program.DepthChecked depthOf
      (switchTailTestBlocksFrom testLabel caseLabel fallbackLabel cases) := by
  induction cases generalizing testLabel caseLabel with
  | nil =>
      simp [switchTailTestBlocksFrom, Program.DepthChecked.nil]
  | cons caseCode rest ih =>
      have hHeadTest :
          depthOf testLabel =
            some (layout.slots.length + tailDepth + 1) := by
        apply hTestDepth
        · exact Nat.le_refl testLabel
        · simp
      have hHeadCase :
          depthOf caseLabel =
            some (layout.slots.length + tailDepth + 1) := by
        apply hCaseDepth
        · exact Nat.le_refl caseLabel
        · simp
      let nextLabel : Label :=
        match rest with
        | [] => fallbackLabel
        | _ :: _ => testLabel + 1
      have hNext :
          depthOf nextLabel =
            some (layout.slots.length + tailDepth + 1) := by
        dsimp [nextLabel]
        cases rest with
        | nil =>
            exact hFallback
        | cons nextCase more =>
            apply hTestDepth
            · exact Nat.le_succ testLabel
            · simp
      have hTailTestDepth :
          ∀ {label},
            testLabel + 1 ≤ label ->
              label < testLabel + 1 + rest.length ->
                depthOf label =
                  some (layout.slots.length + tailDepth + 1) := by
        intro label hLe hLt
        apply hTestDepth
        · exact Nat.le_trans (Nat.le_succ testLabel) hLe
        · simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hLt
      have hTailCaseDepth :
          ∀ {label},
            caseLabel + 1 ≤ label ->
              label < caseLabel + 1 + rest.length ->
                depthOf label =
                  some (layout.slots.length + tailDepth + 1) := by
