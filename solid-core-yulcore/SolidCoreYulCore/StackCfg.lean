theorem evalProgramFuel_eq_evalFuel_of_compile_pair (compileFuel : Nat) :
    (∀ {layout : Layout} {stmt : ConcreteYul.Stmt} {gen : Codegen}
        {hash : ConcreteYul.HashOracle} {funcs : ConcreteYul.FunctionEnv}
        {evalFuel : Nat} {source : ConcreteYul.Config},
      compileStmtFuelFrom compileFuel layout stmt = some gen ->
      ConcreteYul.evalProgramStmtFuel hash funcs evalFuel source stmt =
        ConcreteYul.evalStmtFuel hash evalFuel source stmt) ∧
    (∀ {layout : Layout} {stmts : List ConcreteYul.Stmt} {gen : Codegen}
        {hash : ConcreteYul.HashOracle} {funcs : ConcreteYul.FunctionEnv}
        {evalFuel : Nat} {source : ConcreteYul.Config},
      compileBlockFuelBodyFrom compileFuel layout stmts = some gen ->
      ConcreteYul.evalProgramBlockFuel hash funcs evalFuel source stmts =
        ConcreteYul.evalBlockFuel hash evalFuel source stmts) := by
  induction compileFuel with
  | zero =>
      constructor
      · intro layout stmt gen hash funcs evalFuel source hCompile
        simp [compileStmtFuelFrom] at hCompile
      · intro layout stmts gen hash funcs evalFuel source hCompile
        simp [compileBlockFuelBodyFrom] at hCompile
  | succ compileFuel ih =>
      constructor
      · intro layout stmt gen hash funcs evalFuel source hCompile
        cases stmt with
        | seq first second =>
            simp [compileStmtFuelFrom] at hCompile
            cases hFirst :
                compileStmtFuelFrom compileFuel layout first with
            | none =>
                simp [hFirst] at hCompile
            | some firstGen =>
                cases hSecond :
                    compileStmtFuelFrom compileFuel firstGen.outLayout
                      second with
                | none =>
                    simp [hFirst, hSecond] at hCompile
                | some secondGen =>
                    simp [hFirst, hSecond] at hCompile
                    cases hCompile
                    cases evalFuel with
                    | zero =>
                        simp [ConcreteYul.evalProgramStmtFuel,
                          ConcreteYul.evalStmtFuel]
                    | succ evalFuel =>
                        simp [ConcreteYul.evalProgramStmtFuel,
                          ConcreteYul.evalStmtFuel]
                        rw [ih.1 hFirst]
                        cases hFirstEval :
                            ConcreteYul.evalStmtFuel hash evalFuel source
                              first with
                        | none =>
                            rfl
                        | some firstResult =>
                            cases firstResult with
                            | mk firstFlow firstConfig =>
                                cases firstFlow <;> simp
                                exact ih.1 hSecond
        | block stmts =>
            simp [compileStmtFuelFrom] at hCompile
            cases hBody :
                compileBlockFuelBodyFrom compileFuel layout stmts with
            | none =>
                simp [hBody] at hCompile
            | some bodyGen =>
                simp [hBody] at hCompile
                cases hCompile
                cases evalFuel with
                | zero =>
                    simp [ConcreteYul.evalProgramStmtFuel,
                      ConcreteYul.evalStmtFuel]
                | succ evalFuel =>
                    simp [ConcreteYul.evalProgramStmtFuel,
                      ConcreteYul.evalStmtFuel]
                    rw [ih.2 hBody]
        | skip =>
            exact
              evalProgramStmtFuel_eq_evalStmtFuel_of_compileStmtFrom
                (by simpa [compileStmtFuelFrom] using hCompile)
        | expr expr =>
            exact
              evalProgramStmtFuel_eq_evalStmtFuel_of_compileStmtFrom
                (by simpa [compileStmtFuelFrom] using hCompile)
        | let1 name init =>
            exact
              evalProgramStmtFuel_eq_evalStmtFuel_of_compileStmtFrom
                (by simpa [compileStmtFuelFrom] using hCompile)
        | letMany names init =>
            exact
              evalProgramStmtFuel_eq_evalStmtFuel_of_compileStmtFrom
                (by simpa [compileStmtFuelFrom] using hCompile)
        | funDef name params returns body =>
            exact
              evalProgramStmtFuel_eq_evalStmtFuel_of_compileStmtFrom
                (by simpa [compileStmtFuelFrom] using hCompile)
        | assign name expr =>
            exact
              evalProgramStmtFuel_eq_evalStmtFuel_of_compileStmtFrom
                (by simpa [compileStmtFuelFrom] using hCompile)
        | assignMany names exprs =>
            exact
              evalProgramStmtFuel_eq_evalStmtFuel_of_compileStmtFrom
                (by simpa [compileStmtFuelFrom] using hCompile)
        | letCall names fnName args =>
            exact
              evalProgramStmtFuel_eq_evalStmtFuel_of_compileStmtFrom
                (by simpa [compileStmtFuelFrom] using hCompile)
        | assignCall names fnName args =>
            exact
              evalProgramStmtFuel_eq_evalStmtFuel_of_compileStmtFrom
                (by simpa [compileStmtFuelFrom] using hCompile)
        | ifThen cond body =>
            exact
              evalProgramStmtFuel_eq_evalStmtFuel_of_compileStmtFrom
                (by simpa [compileStmtFuelFrom] using hCompile)
        | switch discr cases defaultBranch =>
            exact
              evalProgramStmtFuel_eq_evalStmtFuel_of_compileStmtFrom
                (by simpa [compileStmtFuelFrom] using hCompile)
        | forLoop pre cond post body =>
            exact
              evalProgramStmtFuel_eq_evalStmtFuel_of_compileStmtFrom
