    (ctx : ControlCtx) (entry normalLabel : Label)
    (stmt : ConcreteYul.Stmt) : Option OpenCfgCodegen :=
  compileCfgStmtOpenCtxRecFrom fuel layout ctx entry normalLabel (entry + 1)
    stmt

def forLoopOpenCtxProgram
    (condLabel bodyLabel cleanupLabel normalLabel : Label)
    (preProgram postProgram bodyProgram : Program)
    (condCode : List Instr) (dropCount : Nat) : Program :=
  preProgram ++
    [ (condLabel,
        { body := condCode
          term := Term.branchNZ bodyLabel cleanupLabel }) ] ++
    postProgram ++
    [ (cleanupLabel,
        { body := popN dropCount
          term := Term.jump normalLabel }) ] ++
    bodyProgram

def compileForLoopOpenCtxRecFrom (fuel : Nat) (layout : Layout)
    (ctx : ControlCtx) (entry normalLabel next : Label)
    (pre : ConcreteYul.Stmt) (cond : ConcreteYul.Expr)
    (post body : ConcreteYul.Stmt) : Option OpenCfgCodegen :=
  let condLabel := next
  let postLabel := next + 1
  let bodyLabel := next + 2
  let cleanupLabel := next + 3
  match
    compileCfgStmtOpenCtxRecFrom fuel layout ctx entry condLabel
      (next + 4) pre
  with
  | none => none
  | some preOpen =>
      let loopLayout := preOpen.outLayout
      let breakTarget : ExitTarget :=
        { label := cleanupLabel, layout := loopLayout }
      let bodyCtx : ControlCtx :=
        ctx.withLoopTargets breakTarget
          { label := postLabel, layout := loopLayout }
      let postCtx : ControlCtx :=
        ctx.withLoopTargets breakTarget
          { label := condLabel, layout := loopLayout }
      match compileExprAt loopLayout 0 cond,
          compileCfgStmtOpenCtxRecFrom fuel loopLayout bodyCtx bodyLabel
            postLabel preOpen.nextLabel body with
      | some condCode, some bodyOpen =>
          if bodyOpen.outLayout = loopLayout then
            match
              compileCfgStmtOpenCtxRecFrom fuel loopLayout postCtx postLabel
                condLabel bodyOpen.nextLabel post
            with
            | some postOpen =>
                if postOpen.outLayout = loopLayout then
                  some
                    { program :=
                        forLoopOpenCtxProgram condLabel bodyLabel cleanupLabel
                          normalLabel preOpen.program
                          postOpen.program bodyOpen.program condCode
                          (loopLayout.slots.length - layout.slots.length)
                      outLayout := layout
                      nextLabel := postOpen.nextLabel }
                else none
            | none => none
          else none
      | _, _ => none

theorem compileForLoopOpenCtxRecFrom_some
    {fuel : Nat} {layout : Layout} {ctx : ControlCtx}
    {entry normalLabel next : Label}
    {pre post body : ConcreteYul.Stmt} {cond : ConcreteYul.Expr}
    {openCfg : OpenCfgCodegen}
    (hCompile :
      compileForLoopOpenCtxRecFrom fuel layout ctx entry normalLabel next
        pre cond post body =
        some openCfg) :
    ∃ preOpen condCode bodyOpen postOpen,
      compileCfgStmtOpenCtxRecFrom fuel layout ctx entry next (next + 4)
        pre =
        some preOpen ∧
      compileExprAt preOpen.outLayout 0 cond = some condCode ∧
      compileCfgStmtOpenCtxRecFrom fuel preOpen.outLayout
          (ctx.withLoopTargets
            { label := next + 3, layout := preOpen.outLayout }
            { label := next + 1, layout := preOpen.outLayout })
          (next + 2) (next + 1) preOpen.nextLabel body =
        some bodyOpen ∧
      bodyOpen.outLayout = preOpen.outLayout ∧
      compileCfgStmtOpenCtxRecFrom fuel preOpen.outLayout
          (ctx.withLoopTargets
            { label := next + 3, layout := preOpen.outLayout }
            { label := next, layout := preOpen.outLayout })
          (next + 1) next bodyOpen.nextLabel post =
        some postOpen ∧
      postOpen.outLayout = preOpen.outLayout ∧
      openCfg.program =
        forLoopOpenCtxProgram next (next + 2) (next + 3) normalLabel
          preOpen.program postOpen.program bodyOpen.program
          condCode (preOpen.outLayout.slots.length - layout.slots.length) ∧
      openCfg.outLayout = layout ∧
      openCfg.nextLabel = postOpen.nextLabel := by
  simp [compileForLoopOpenCtxRecFrom] at hCompile
  cases hPre :
      compileCfgStmtOpenCtxRecFrom fuel layout ctx entry next (next + 4)
        pre with
  | none =>
      simp [hPre] at hCompile
  | some preOpen =>
      cases hCond : compileExprAt preOpen.outLayout 0 cond with
      | none =>
          simp [hPre, hCond] at hCompile
      | some condCode =>
          cases hBody :
              compileCfgStmtOpenCtxRecFrom fuel preOpen.outLayout
                (ctx.withLoopTargets
                  { label := next + 3, layout := preOpen.outLayout }
                  { label := next + 1, layout := preOpen.outLayout })
                (next + 2) (next + 1) preOpen.nextLabel body with
          | none =>
              simp [hPre, hCond, hBody] at hCompile
          | some bodyOpen =>
              by_cases hBodyOut : bodyOpen.outLayout = preOpen.outLayout
              · cases hPost :
                  compileCfgStmtOpenCtxRecFrom fuel preOpen.outLayout
                    (ctx.withLoopTargets
                      { label := next + 3, layout := preOpen.outLayout }
                      { label := next, layout := preOpen.outLayout })
                    (next + 1) next bodyOpen.nextLabel post with
                | none =>
                    simp [hPre, hCond, hBody, hBodyOut, hPost] at hCompile
                | some postOpen =>
                    by_cases hPostOut :
                        postOpen.outLayout = preOpen.outLayout
                    · simp [hPre, hCond, hBody, hBodyOut, hPost,
                        hPostOut] at hCompile
                      cases hCompile
                      exact
                        ⟨preOpen, condCode, bodyOpen, postOpen,
                          by rfl,
                          hCond,
                          hBody,
                          hBodyOut,
                          hPost,
                          hPostOut, rfl, rfl, rfl⟩
                    · simp [hPre, hCond, hBody, hBodyOut, hPost,
                        hPostOut] at hCompile
              · simp [hPre, hCond, hBody, hBodyOut] at hCompile

theorem compileCfgStmtOpenCtxRecFrom_callFree
    {compileFuel : Nat} {layout : Layout} {stmt : ConcreteYul.Stmt}
    {ctx : ControlCtx} {entry normalLabel next : Label}
    {openCfg : OpenCfgCodegen}
    (hCompile :
      compileCfgStmtOpenCtxRecFrom compileFuel layout ctx entry normalLabel
        next stmt =
        some openCfg) :
    Program.CallFree openCfg.program := by
  induction compileFuel generalizing layout ctx entry normalLabel next stmt
      openCfg with
  | zero =>
      simp [compileCfgStmtOpenCtxRecFrom] at hCompile
  | succ compileFuel ih =>
      cases stmt
      case ifThen cond body =>
        simp [compileCfgStmtOpenCtxRecFrom] at hCompile
        cases hCond : compileExprAt layout 0 cond with
        | none =>
            simp [hCond] at hCompile
        | some condCode =>
            cases hBody :
                compileCfgStmtOpenCtxRecFrom compileFuel layout ctx next
                  normalLabel (next + 1) body with
            | none =>
                simp [hCond, hBody] at hCompile
            | some bodyOpen =>
                by_cases hOut : bodyOpen.outLayout = layout
                · simp [hCond, hBody, hOut] at hCompile
                  cases hCompile
                  exact
                    Program.callFree_cons (by simp [Term.CallFree])
                      (ih hBody)
                · simp [hCond, hBody, hOut] at hCompile
      case seq first second =>
        simp [compileCfgStmtOpenCtxRecFrom] at hCompile
        cases hFirst :
            compileCfgStmtOpenCtxRecFrom compileFuel layout ctx entry next
              (next + 1) first with
        | none =>
            simp [hFirst] at hCompile
        | some firstOpen =>
            cases hSecond :
                compileCfgStmtOpenCtxRecFrom compileFuel firstOpen.outLayout
                  ctx next normalLabel firstOpen.nextLabel second with
            | none =>
                simp [hFirst, hSecond] at hCompile
            | some secondOpen =>
                simp [hFirst, hSecond] at hCompile
                cases hCompile
                exact
                  Program.callFree_append (ih hFirst) (ih hSecond)
      all_goals
        simp [compileCfgStmtOpenCtxRecFrom] at hCompile
        split at hCompile
        · simp at hCompile
        · rename_i cfg hCfg
          injection hCompile with hOpenCfg
          cases hOpenCfg
          exact
            compileCfgStmtOpenCtxAutoFrom_callFree
              (cfg := cfg) hCfg

theorem compileCfgStmtOpenCtxRecAutoFrom_callFree
    {compileFuel : Nat} {layout : Layout} {stmt : ConcreteYul.Stmt}
    {ctx : ControlCtx} {entry normalLabel : Label}
    {openCfg : OpenCfgCodegen}
    (hCompile :
      compileCfgStmtOpenCtxRecAutoFrom compileFuel layout ctx entry
        normalLabel stmt =
    some openCfg) :
    Program.CallFree openCfg.program :=
  compileCfgStmtOpenCtxRecFrom_callFree hCompile

theorem forLoopOpenCtxProgram_callFree
    {condLabel bodyLabel cleanupLabel normalLabel : Label}
    {preProgram postProgram bodyProgram : Program}
    {condCode : List Instr} {dropCount : Nat}
    (hPre : Program.CallFree preProgram)
    (hPost : Program.CallFree postProgram)
    (hBody : Program.CallFree bodyProgram) :
    Program.CallFree
      (forLoopOpenCtxProgram condLabel bodyLabel cleanupLabel normalLabel
        preProgram postProgram bodyProgram condCode dropCount) := by
  have hCond :
      Program.CallFree
        [(condLabel,
          { body := condCode
            term := Term.branchNZ bodyLabel cleanupLabel })] := by
    exact Program.callFree_cons (by simp [Term.CallFree])
      Program.callFree_nil
  have hCleanup :
      Program.CallFree
        [(cleanupLabel,
          { body := popN dropCount
            term := Term.jump normalLabel })] := by
    exact Program.callFree_cons (by simp [Term.CallFree])
      Program.callFree_nil
  unfold forLoopOpenCtxProgram
  unfold Program.CallFree
  intro label block hLookup
  repeat rw [List.append_assoc] at hLookup
  cases
      lookupBlock?_append_some preProgram
        ([(condLabel,
          { body := condCode
            term := Term.branchNZ bodyLabel cleanupLabel })] ++
          (postProgram ++
