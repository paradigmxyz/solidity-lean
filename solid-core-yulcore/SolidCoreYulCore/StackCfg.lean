theorem callEntryBlockDepthAfter
    {layout : Layout} {args : List ConcreteYul.Expr}
    {argCode : List Instr} {fnName : ConcreteYul.Name}
    {retCount returnLabel tailDepth : Nat}
    (hArgs : compileExprsAt layout 0 args = some argCode) :
    blockDepthAfter?
        { body := argCode
          term := Term.call fnName args.length retCount returnLabel }
        (layout.slots.length + tailDepth) =
      some (layout.slots.length + tailDepth + retCount) := by
  have hArgDepth :=
    compileExprsAt_codeDepthAfter
      (layout := layout) (tempDepth := 0)
      (exprs := args) (code := argCode) (tailDepth := tailDepth)
      hArgs
  have hArgDepth' :
      codeDepthAfter? argCode (layout.slots.length + tailDepth) =
        some (layout.slots.length + tailDepth + args.length) := by
    simpa using hArgDepth
  have hCallLe :
      args.length ≤ layout.slots.length + tailDepth + args.length := by
    omega
  have hTerm :
      termDepthAfter? (Term.call fnName args.length retCount returnLabel)
          (layout.slots.length + tailDepth + args.length) =
        some (layout.slots.length + tailDepth + retCount) := by
    simp [termDepthAfter?, hCallLe]
  simp [blockDepthAfter?, hArgDepth', hTerm]

theorem assignCallStoreBlockDepthAfter
    {layout : Layout} {names : List ConcreteYul.Name}
    {storeCode : List Instr} {exit : Label} {tailDepth : Nat}
    (hStores :
      compileStoresSourceFromTop? layout names = some storeCode) :
    blockDepthAfter?
        { body := storeCode
          term := Term.jump exit }
        (names.length + layout.slots.length + tailDepth) =
      some (layout.slots.length + tailDepth) :=
  blockDepthAfter?_jump_of_codeDepthAfter
    (compileStoresSourceFromTop?_codeDepthAfter
      (layout := layout) (names := names) (code := storeCode)
      (tailDepth := tailDepth) hStores)

theorem letCallReturnBlockDepthAfter
    {layout : Layout} {names : List ConcreteYul.Name}
    {exit : Label} {tailDepth : Nat} :
    blockDepthAfter?
        { body := reverseTopValuesCode names.length
          term := Term.jump exit }
        (names.length + layout.slots.length + tailDepth) =
      some (names.length + layout.slots.length + tailDepth) := by
  have hLe :
      names.length ≤ names.length + layout.slots.length + tailDepth := by
    omega
  exact
    blockDepthAfter?_jump_of_codeDepthAfter
      (codeDepthAfter?_reverseTopValuesCode
        (count := names.length)
        (depth := names.length + layout.slots.length + tailDepth)
        hLe)

theorem compileAssignCallOpenFrom_blockDepthAfter
    {layout : Layout} {entry afterCall exit : Label}
    {names : List ConcreteYul.Name} {fnName : ConcreteYul.Name}
    {args : List ConcreteYul.Expr} {cfg : CfgCodegen}
    {tailDepth : Nat}
    (hCompile :
      compileAssignCallOpenFrom layout entry afterCall exit names fnName
        args = some cfg) :
    ∃ argCode storeCode,
      compileExprsAt layout 0 args = some argCode ∧
        compileStoresSourceFromTop? layout names = some storeCode ∧
        cfg.program =
          assignCallToProgram entry afterCall exit argCode storeCode
            fnName args.length names.length ∧
        blockDepthAfter?
            { body := argCode
              term := Term.call fnName args.length names.length afterCall }
            (layout.slots.length + tailDepth) =
          some (layout.slots.length + tailDepth + names.length) ∧
        blockDepthAfter?
            { body := storeCode
