                    Config.at testLabel discrTarget := by
                simp [step, switchTwoNoDefaultToProgram, lookupBlock?,
                  hDiscrExec, execTerm, hDiscrRel.stack_eq,
                  hFirstBranchNo]
              have hTestLookup :
                  lookupBlock?
                      (switchTwoNoDefaultToProgram entry firstLabel testLabel
                        secondLabel missLabel joinLabel discrCode firstValue
                        secondValue firstGen.code secondGen.code)
                      testLabel =
                    some
                      ({ body := []
                         term := Term.branchEq secondValue secondLabel
                           missLabel } : Block) := by
                simp [switchTwoNoDefaultToProgram, lookupBlock?,
                  hEntryTest, hFirstTest]
              have hTestStep :
                  step
                      (switchTwoNoDefaultToProgram entry firstLabel testLabel
                        secondLabel missLabel joinLabel discrCode firstValue
                        secondValue firstGen.code secondGen.code)
                      (Config.at testLabel discrTarget) =
                    Config.at secondLabel discrTarget := by
                simp [step, switchTwoNoDefaultToProgram, lookupBlock?,
                  hEntryTest, hFirstTest, execList, execTerm,
                  hDiscrRel.stack_eq, hSecondBranch]
              have hSecondLookup :
                  lookupBlock?
                      (switchTwoNoDefaultToProgram entry firstLabel testLabel
                        secondLabel missLabel joinLabel discrCode firstValue
                        secondValue firstGen.code secondGen.code)
                      secondLabel =
                    some
                      ({ body := Instr.pop :: secondGen.code
                         term := Term.jump joinLabel } : Block) := by
                simp [switchTwoNoDefaultToProgram, lookupBlock?,
                  hEntrySecond, hFirstSecond, hTestSecond]
              have hSecondStep :
                  step
                      (switchTwoNoDefaultToProgram entry firstLabel testLabel
                        secondLabel missLabel joinLabel discrCode firstValue
                        secondValue firstGen.code secondGen.code)
                      (Config.at secondLabel discrTarget) =
                    Config.at joinLabel secondTarget := by
                simp [step, switchTwoNoDefaultToProgram, lookupBlock?,
                  hEntrySecond, hFirstSecond, hTestSecond, execList,
                  execInstr, hDiscrRel.stack_eq, poppedTarget,
                  hSecondExec, execTerm]
              refine ⟨secondTarget, ?_, hSecondRelLayout, hSecondFlow⟩
              refine
                Reaches.step (next := Config.at testLabel discrTarget)
                  ?_ ?_
              · rw [step_of_extends_at hExtends hEntryLookup]
                exact hEntryStep
              · refine
                  Reaches.step
                    (next := Config.at secondLabel discrTarget) ?_ ?_
                · rw [step_of_extends_at hExtends hTestLookup]
                  exact hTestStep
                · exact
                    reaches_one_of_extends_at hExtends hSecondLookup
                      hSecondStep
            · have hSecondBranchNo :
                  ¬ norm discrValue = norm secondValue := by
                intro h
                exact hSecondMatch h.symm
              simp [ConcreteYul.switchTarget?, hFirstMatch,
                hSecondMatch, ConcreteYul.normalResult] at hEval
              cases hEval
