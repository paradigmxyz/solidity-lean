theorem CompiledFunctionEnvCovers_evalFunction_body_program_correct_withCalls
    {compileFuel callFuel : Nat}
    {sourceFns : ConcreteYul.FunctionEnv}
    {compiledFns : CompiledFunctionEnv}
    {fnName : ConcreteYul.Name} {fn : ConcreteYul.FunctionDef}
    {args returnValues : List Word}
    {callerConfig resultConfig : ConcreteYul.Config}
    {callEnv : ConcreteYul.Env}
    {callSem : CallSem}
    {hash : ConcreteYul.HashOracle} {evalFuel : Nat}
    {tail : Stack} {target : TargetState}
    (hCovers :
      CompiledFunctionEnvCovers compileFuel sourceFns compiledFns)
    (hLookup :
      ConcreteYul.lookupFunction? sourceFns fnName = some fn)
    (hInit :
      ConcreteYul.initFunctionEnv fn.params args fn.returns =
        some callEnv)
    (hEval :
      ConcreteYul.evalFunctionFuel hash sourceFns evalFuel.succ fnName args
        callerConfig =
        some (returnValues, resultConfig))
    (hNoHalt : callerConfig.state.halt? = none)
    (hRel :
      ∀ compiled,
        lookupCompiledFunction? compiledFns fnName = some compiled ->
          StackRel compiled.entryLayout
            ({ callerConfig with env := callEnv } : ConcreteYul.Config) []
            tail target) :
    ∃ compiled bodyResult target',
      lookupCompiledFunction? compiledFns fnName = some compiled ∧
        ConcreteYul.evalProgramStmtFuel hash sourceFns evalFuel
          ({ callerConfig with env := callEnv } : ConcreteYul.Config)
          fn.body =
          some bodyResult ∧
        (bodyResult.flow = ConcreteYul.Flow.normal ∨
          bodyResult.flow = ConcreteYul.Flow.left) ∧
        ConcreteYul.valuesForNames? bodyResult.config.env fn.returns =
          some returnValues ∧
        { bodyResult.config with env := callerConfig.env } = resultConfig ∧
        ReachesWithCalls callSem callFuel compiled.program
          (Config.at compiled.entry target) (Config.halted target') ∧
        StackRel compiled.outLayout bodyResult.config
          (returnValues.map (fun value => Atom.word (norm value))) tail
          target' := by
  simp [ConcreteYul.evalFunctionFuel, hLookup, hInit] at hEval
  cases evalFuel with
  | zero =>
      simp [ConcreteYul.evalProgramStmtFuel] at hEval
  | succ bodyFuel =>
      cases hBody :
          ConcreteYul.evalProgramStmtFuel hash sourceFns bodyFuel.succ
            ({ callerConfig with env := callEnv } : ConcreteYul.Config)
            fn.body with
      | none =>
          simp [hBody] at hEval
      | some bodyResult =>
          cases bodyResult with
          | mk bodyFlow bodyConfig =>
              cases bodyFlow
              · simp [hBody] at hEval
                cases hValues :
                    ConcreteYul.valuesForNames? bodyConfig.env
                      fn.returns with
                | none =>
                    simp [hValues] at hEval
                | some values =>
                    simp [hValues] at hEval
                    rcases hEval with ⟨hReturnValues, hResultConfig⟩
                    cases hReturnValues
                    have hFlow :
                        ({ flow := ConcreteYul.Flow.normal
                           config := bodyConfig } :
                            ConcreteYul.Result).flow =
                            ConcreteYul.Flow.normal ∨
                          ({ flow := ConcreteYul.Flow.normal
                             config := bodyConfig } :
                              ConcreteYul.Result).flow =
                            ConcreteYul.Flow.left :=
                      Or.inl rfl
                    have hNoHaltCall :
                        ({ callerConfig with env := callEnv } :
                            ConcreteYul.Config).state.halt? = none := by
                      simpa using hNoHalt
                    rcases
                      CompiledFunctionEnvCovers_body_program_correct_withCalls
                        (callFuel := callFuel) (evalFuel := bodyFuel)
                        hCovers hLookup hBody hFlow hValues hNoHaltCall
                        hRel with
                    ⟨compiled, target', hCompiledLookup, hReach, hRel'⟩
                    exact
                      ⟨ compiled
                      , { flow := ConcreteYul.Flow.normal
                          config := bodyConfig }
                      , target'
                      , hCompiledLookup
                      , rfl
                      , hFlow
                      , hValues
                      , hResultConfig
                      , hReach
                      , hRel' ⟩
              · simp [hBody] at hEval
              · simp [hBody] at hEval
              · simp [hBody] at hEval
                cases hValues :
                    ConcreteYul.valuesForNames? bodyConfig.env
                      fn.returns with
                | none =>
                    simp [hValues] at hEval
                | some values =>
                    simp [hValues] at hEval
                    rcases hEval with ⟨hReturnValues, hResultConfig⟩
                    cases hReturnValues
                    have hFlow :
                        ({ flow := ConcreteYul.Flow.left
                           config := bodyConfig } :
                            ConcreteYul.Result).flow =
                            ConcreteYul.Flow.normal ∨
                          ({ flow := ConcreteYul.Flow.left
                             config := bodyConfig } :
                              ConcreteYul.Result).flow =
                            ConcreteYul.Flow.left :=
                      Or.inr rfl
                    have hNoHaltCall :
                        ({ callerConfig with env := callEnv } :
                            ConcreteYul.Config).state.halt? = none := by
                      simpa using hNoHalt
                    rcases
                      CompiledFunctionEnvCovers_body_program_correct_withCalls
                        (callFuel := callFuel) (evalFuel := bodyFuel)
                        hCovers hLookup hBody hFlow hValues hNoHaltCall
                        hRel with
                    ⟨compiled, target', hCompiledLookup, hReach, hRel'⟩
                    exact
                      ⟨ compiled
                      , { flow := ConcreteYul.Flow.left
                          config := bodyConfig }
                      , target'
                      , hCompiledLookup
                      , rfl
                      , hFlow
                      , hValues
                      , hResultConfig
                      , hReach
                      , hRel' ⟩
              · simp [hBody] at hEval

theorem CompiledFunctionEnvCovers_evalFunction_run_withCalls
    {compileFuel callFuel : Nat}
    {sourceFns : ConcreteYul.FunctionEnv}
    {compiledFns : CompiledFunctionEnv}
    {fnName : ConcreteYul.Name} {fn : ConcreteYul.FunctionDef}
    {args returnValues : List Word}
    {callerConfig resultConfig : ConcreteYul.Config}
    {callEnv : ConcreteYul.Env}
    {callSem : CallSem}
    {hash : ConcreteYul.HashOracle} {evalFuel : Nat}
    (hCovers :
      CompiledFunctionEnvCovers compileFuel sourceFns compiledFns)
    (hLookup :
      ConcreteYul.lookupFunction? sourceFns fnName = some fn)
    (hInit :
      ConcreteYul.initFunctionEnv fn.params args fn.returns =
        some callEnv)
    (hEval :
      ConcreteYul.evalFunctionFuel hash sourceFns evalFuel.succ fnName args
        callerConfig =
        some (returnValues, resultConfig))
    (hNoHalt : callerConfig.state.halt? = none) :
    FunctionRunWithCalls (CallContext.ofConfig callerConfig) compiledFns
      callSem callFuel fnName args callerConfig.state returnValues
      resultConfig.state := by
  rcases hCovers hLookup with ⟨compiled, hCompiledLookup, hMatches⟩
  let source : ConcreteYul.Config := { callerConfig with env := callEnv }
  let target₀ : TargetState :=
    { stack := frameOf compiled.entryLayout callEnv
      state := callerConfig.state }
  have hSource :
      compiledFunctionInitialSource? (CallContext.ofConfig callerConfig)
          compiled args callerConfig.state =
        some source := by
    simpa [source] using
      CompiledFunctionMatches_initialSource_of_init hMatches hInit
  have hTarget :
      compiledFunctionInitialTarget? (CallContext.ofConfig callerConfig)
          compiled args callerConfig.state =
        some target₀ := by
    simpa [target₀] using
      CompiledFunctionMatches_initialTarget_of_init hMatches hInit
  have hInitialRel : StackRel compiled.entryLayout source [] [] target₀ :=
    CompiledFunctionMatches_initial_stackRel hMatches hSource hTarget
  have hRelAll :
      ∀ compiledCandidate,
        lookupCompiledFunction? compiledFns fnName = some compiledCandidate ->
          StackRel compiledCandidate.entryLayout
            ({ callerConfig with env := callEnv } : ConcreteYul.Config) []
            [] target₀ := by
    intro compiledCandidate hCandidateLookup
    have hEq : compiledCandidate = compiled := by
      rw [hCompiledLookup] at hCandidateLookup
      cases hCandidateLookup
      rfl
    subst compiledCandidate
    simpa [source] using hInitialRel
  rcases
    CompiledFunctionEnvCovers_evalFunction_body_program_correct_withCalls
      (callFuel := callFuel) (tail := []) (target := target₀)
      hCovers hLookup hInit hEval hNoHalt hRelAll with
  ⟨compiledRun, bodyResult, target₁, hRunLookup, _hBodyEval, _hFlow,
    hValues, hResultConfig, hReach, hBodyRel⟩
  have hRunEq : compiledRun = compiled := by
    rw [hCompiledLookup] at hRunLookup
    cases hRunLookup
    rfl
  subst compiledRun
  have hLen : returnValues.length = compiled.returns.length :=
    CompiledFunctionMatches_valuesForNames?_length hMatches hValues
  have hExtractBody :
      extractFunctionResult? compiled target₁ =
        some (returnValues.map norm, bodyResult.config.state) :=
    extractFunctionResult?_of_stackRel hLen hBodyRel
  have hState : bodyResult.config.state = resultConfig.state := by
    simpa using congrArg ConcreteYul.Config.state hResultConfig
  have hExtract :
      extractFunctionResult? compiled target₁ =
        some (returnValues.map norm, resultConfig.state) := by
    simpa [hState] using hExtractBody
  exact
    ⟨compiled, source, target₀, target₁, hCompiledLookup, hSource,
      hTarget, hReach, hExtract⟩

