  · simp [hEntryLabel] at hLookup
    by_cases hAfterLabel : afterCall = label
    · simp [hAfterLabel] at hLookup
      cases hLookup
      have hDepth :
          depthOf label =
            some (layout.slots.length + tailDepth + names.length) := by
        simpa [← hAfterLabel] using hAfterCall
      exact
        ⟨names.length + layout.slots.length + tailDepth,
          layout.slots.length + tailDepth,
          by
            simpa [Nat.add_comm, Nat.add_left_comm, Nat.add_assoc]
              using hDepth,
          assignCallStoreBlockDepthAfterWithTargets
            (depthOf := depthOf) (layout := layout)
            (names := names) (storeCode := storeCode)
            (exit := exit) (tailDepth := tailDepth) hStores hExit⟩
    · simp [hAfterLabel] at hLookup

