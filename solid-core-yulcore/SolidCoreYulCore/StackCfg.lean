theorem compileCfgStmtWithCallsFrom_program_cfg_correct
    {compileFuel : Nat} {layout : Layout} {stmt : ConcreteYul.Stmt}
    {cfg : CfgCodegen} {callSem : CallSem}
    {hash : ConcreteYul.HashOracle} {funcs : ConcreteYul.FunctionEnv}
    {evalFuel : Nat}
    {source : ConcreteYul.Config} {result : ConcreteYul.Result}
    {tail : Stack} {target : TargetState}
    (hLayout : layout.WellFormed)
    (hCompile :
      compileCfgStmtWithCallsFrom compileFuel layout stmt = some cfg)
    (hCall : CallSemCorrectForConfig hash funcs callSem source
      evalFuel.succ.succ)
    (hEval :
      ConcreteYul.evalProgramStmtFuel hash funcs evalFuel.succ.succ source
        stmt = some result)
    (hNoHalt : source.state.halt? = none)
    (hRel : StackRel layout source [] tail target) :
    ∃ target',
      ReachesWithCalls callSem evalFuel.succ cfg.program
        (Config.at 0 target) (Config.halted target') ∧
        StackRel cfg.outLayout result.config [] tail target' ∧
        result.flow = ConcreteYul.Flow.normal := by
  cases stmt with
  | assignCall names fnName args =>
      exact
        compileAssignCallFrom_callSem_cfg_correct
          (evalFuel := evalFuel.succ) hLayout
          (by simpa [compileCfgStmtWithCallsFrom] using hCompile)
          hCall hEval hRel
  | ifThen cond body =>
      exact
        compileCfgStmtFrom_program_cfg_correct_withCalls
          (callFuel := evalFuel.succ) hLayout
          (by simpa [compileCfgStmtWithCallsFrom] using hCompile)
          hEval hNoHalt hRel
  | switch discr cases defaultBranch =>
      exact
        compileCfgStmtFrom_program_cfg_correct_withCalls
          (callFuel := evalFuel.succ) hLayout
          (by simpa [compileCfgStmtWithCallsFrom] using hCompile)
          hEval hNoHalt hRel
  | forLoop pre cond post body =>
      exact
        compileCfgStmtFrom_program_cfg_correct_withCalls
          (callFuel := evalFuel.succ) hLayout
          (by simpa [compileCfgStmtWithCallsFrom] using hCompile)
          hEval hNoHalt hRel
  | skip =>
      exact
        compileCfgStmtFrom_program_cfg_correct_withCalls
          (callFuel := evalFuel.succ) hLayout
          (by simpa [compileCfgStmtWithCallsFrom] using hCompile)
          hEval hNoHalt hRel
  | expr expr =>
      exact
        compileCfgStmtFrom_program_cfg_correct_withCalls
          (callFuel := evalFuel.succ) hLayout
          (by simpa [compileCfgStmtWithCallsFrom] using hCompile)
          hEval hNoHalt hRel
  | let1 name init =>
      exact
        compileCfgStmtFrom_program_cfg_correct_withCalls
          (callFuel := evalFuel.succ) hLayout
          (by simpa [compileCfgStmtWithCallsFrom] using hCompile)
          hEval hNoHalt hRel
  | letMany names init =>
      exact
        compileCfgStmtFrom_program_cfg_correct_withCalls
          (callFuel := evalFuel.succ) hLayout
          (by simpa [compileCfgStmtWithCallsFrom] using hCompile)
          hEval hNoHalt hRel
  | funDef name params returns body =>
      exact
        compileCfgStmtFrom_program_cfg_correct_withCalls
          (callFuel := evalFuel.succ) hLayout
          (by simpa [compileCfgStmtWithCallsFrom] using hCompile)
          hEval hNoHalt hRel
  | assign name expr =>
      exact
        compileCfgStmtFrom_program_cfg_correct_withCalls
          (callFuel := evalFuel.succ) hLayout
          (by simpa [compileCfgStmtWithCallsFrom] using hCompile)
          hEval hNoHalt hRel
  | assignMany names exprs =>
      exact
        compileCfgStmtFrom_program_cfg_correct_withCalls
          (callFuel := evalFuel.succ) hLayout
          (by simpa [compileCfgStmtWithCallsFrom] using hCompile)
          hEval hNoHalt hRel
  | letCall names fnName args =>
      exact
        compileLetCallFrom_callSem_cfg_correct
          (evalFuel := evalFuel.succ)
          (by simpa [compileCfgStmtWithCallsFrom] using hCompile)
          hCall hEval hRel
  | seq first second =>
      exact
        compileCfgStmtFrom_program_cfg_correct_withCalls
          (callFuel := evalFuel.succ) hLayout
          (by simpa [compileCfgStmtWithCallsFrom] using hCompile)
          hEval hNoHalt hRel
  | block stmts =>
      exact
        compileCfgStmtFrom_program_cfg_correct_withCalls
          (callFuel := evalFuel.succ) hLayout
          (by simpa [compileCfgStmtWithCallsFrom] using hCompile)
          hEval hNoHalt hRel
  | «break» =>
      exact
        compileCfgStmtFrom_program_cfg_correct_withCalls
          (callFuel := evalFuel.succ) hLayout
          (by simpa [compileCfgStmtWithCallsFrom] using hCompile)
          hEval hNoHalt hRel
  | «continue» =>
      exact
        compileCfgStmtFrom_program_cfg_correct_withCalls
          (callFuel := evalFuel.succ) hLayout
