theorem compileCfgStmtOpenRecFrom_next_le_aux
    {compileFuel : Nat} {layout : Layout} {stmt : ConcreteYul.Stmt}
    {dest : ControlDest} {entry exit next : Label}
    {openCfg : OpenCfgCodegen}
    (hEntryNext : entry < next)
    (hCompile :
      compileCfgStmtOpenRecFrom compileFuel layout dest entry exit next stmt =
        some openCfg) :
    next ≤ openCfg.nextLabel := by
  induction compileFuel generalizing layout dest entry exit next stmt openCfg
      with
  | zero =>
      simp [compileCfgStmtOpenRecFrom] at hCompile
  | succ compileFuel ih =>
      cases stmt
      case ifThen cond body =>
        simp [compileCfgStmtOpenRecFrom] at hCompile
        cases hCond : compileExprAt layout 0 cond with
        | none =>
            simp [hCond] at hCompile
        | some condCode =>
            cases hBody :
                compileCfgStmtOpenRecFrom compileFuel layout dest next exit
                  (next + 1) body with
            | none =>
                simp [hCond, hBody] at hCompile
            | some bodyOpen =>
                by_cases hBodyOut : bodyOpen.outLayout = layout
                · simp [hCond, hBody, hBodyOut] at hCompile
                  cases hCompile
                  exact
                    Nat.le_trans (Nat.le_succ next)
                      (ih (layout := layout) (dest := dest)
                        (entry := next) (exit := exit)
                        (next := next + 1) (stmt := body)
                        (openCfg := bodyOpen)
                        (hEntryNext := Nat.lt_succ_self next) hBody)
                · simp [hCond, hBody, hBodyOut] at hCompile
      case seq first second =>
        simp [compileCfgStmtOpenRecFrom] at hCompile
        cases hFallback :
            compileCfgStmtOpenFrom (compileFuel + 1) layout dest entry exit
              (ConcreteYul.Stmt.seq first second) with
        | some cfg =>
            simp [hFallback] at hCompile
            cases hCompile
            exact Nat.le_refl next
        | none =>
            simp [hFallback] at hCompile
            cases hFirst : compileStmtFuelFrom compileFuel layout first with
            | none =>
                simp [hFirst] at hCompile
            | some firstGen =>
                cases hSecond :
                    compileCfgStmtOpenRecFrom compileFuel firstGen.outLayout
                      dest next exit (next + 1) second with
                | none =>
                    simp [hFirst, hSecond] at hCompile
                | some secondOpen =>
                    simp [hFirst, hSecond] at hCompile
                    cases hCompile
                    exact
                      Nat.le_trans (Nat.le_succ next)
                        (ih (layout := firstGen.outLayout) (dest := dest)
                          (entry := next) (exit := exit)
                          (next := next + 1) (stmt := second)
                          (openCfg := secondOpen)
                          (hEntryNext := Nat.lt_succ_self next) hSecond)
      all_goals
        simp [compileCfgStmtOpenRecFrom] at hCompile
        split at hCompile
        · simp at hCompile
          cases hCompile
          exact Nat.le_refl next
        · simp at hCompile

theorem compileCfgStmtOpenFrom_to_extends_cfg_correct_for_rec
    {compileFuel : Nat} {layout : Layout} {stmt : ConcreteYul.Stmt}
    {dest : ControlDest} {entry exit : Label} {cfg : CfgCodegen}
    {program : Program} {hash : ConcreteYul.HashOracle} {evalFuel : Nat}
