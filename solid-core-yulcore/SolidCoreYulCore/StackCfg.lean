        blockDepthAfterWithTargets?_jump_of_codeDepthAfter
          (depthOf := depthOf) (body := discrCode)
          (target := fallbackLabel)
          (start := layout.slots.length + tailDepth)
          (finish := layout.slots.length + tailDepth + 1)
          hDiscrDepth' hFallback
  | cons firstCase restCases =>
      cases restCases with
      | nil =>
          exact
            switchDiscrBlockDepthAfterWithTargets
              (depthOf := depthOf) (layout := layout)
              (discr := discr) (discrCode := discrCode)
              (caseValue := firstCase.value)
              (caseLabel := caseLabelStart)
              (missLabel := fallbackLabel) (tailDepth := tailDepth)
              hDiscr (hFirstCase rfl) hFallback
      | cons secondCase moreCases =>
          exact
            switchDiscrBlockDepthAfterWithTargets
              (depthOf := depthOf) (layout := layout)
              (discr := discr) (discrCode := discrCode)
              (caseValue := firstCase.value)
              (caseLabel := caseLabelStart)
              (missLabel := testLabelStart) (tailDepth := tailDepth)
