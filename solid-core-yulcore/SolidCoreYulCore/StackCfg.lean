theorem evalRuntimeFunctionFuel_restores_caller_frame
    {hash : ConcreteYul.HashOracle}
    {fuel : Nat} {fnName : ConcreteYul.Name}
    {args returnValues : List Word}
    {callerConfig resultConfig : ConcreteYul.RuntimeConfig}
    (hEval :
      ConcreteYul.evalRuntimeFunctionFuel hash fuel fnName args
        callerConfig =
        some (returnValues, resultConfig)) :
    resultConfig.env = callerConfig.env ∧
      resultConfig.funcs = callerConfig.funcs := by
  cases fuel with
  | zero =>
      simp [ConcreteYul.evalRuntimeFunctionFuel] at hEval
  | succ fuel =>
      simp [ConcreteYul.evalRuntimeFunctionFuel] at hEval
      cases hLookup :
          ConcreteYul.lookupFunction? callerConfig.funcs fnName with
      | none =>
          simp [hLookup] at hEval
      | some fn =>
          cases hInit :
              ConcreteYul.initFunctionEnv fn.params args fn.returns with
          | none =>
              simp [hLookup, hInit] at hEval
          | some callEnv =>
              cases hBody :
                  ConcreteYul.evalRuntimeStmtFuel hash fuel
                    { callerConfig with
                      env := callEnv
                      funcs :=
                        ConcreteYul.collectStmtFunctionDefs fn.body
                          callerConfig.funcs } fn.body with
              | none =>
                  simp [hLookup, hInit, hBody] at hEval
              | some bodyResult =>
                  cases bodyResult with
                  | mk flow bodyConfig =>
                      cases flow <;>
                        simp [hLookup, hInit, hBody] at hEval
                      · cases hValues :
                            ConcreteYul.valuesForNames? bodyConfig.env
                              fn.returns with
                        | none =>
                            simp [hValues] at hEval
                        | some values =>
                            simp [hValues] at hEval
                            rcases hEval with ⟨_hReturns, hConfig⟩
                            rw [← hConfig]
                            simp
                      · cases hValues :
                            ConcreteYul.valuesForNames? bodyConfig.env
                              fn.returns with
                        | none =>
                            simp [hValues] at hEval
                        | some values =>
                            simp [hValues] at hEval
                            rcases hEval with ⟨_hReturns, hConfig⟩
                            rw [← hConfig]
                            simp

