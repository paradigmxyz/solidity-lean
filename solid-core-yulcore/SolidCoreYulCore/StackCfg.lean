        StackRel cfg.outLayout result.config [] tail target' := by
  cases stmt with
  | skip =>
      simp [compileControlExitFrom, controlExitLabel?] at hCompile
  | expr expr =>
      simp [compileControlExitFrom, controlExitLabel?] at hCompile
  | let1 name init =>
      simp [compileControlExitFrom, controlExitLabel?] at hCompile
  | letMany names init =>
      simp [compileControlExitFrom, controlExitLabel?] at hCompile
