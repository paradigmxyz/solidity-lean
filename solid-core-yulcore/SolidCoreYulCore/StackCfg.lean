theorem forLoopCleanupBlockDepthAfterWithTargets
    {depthOf : DepthEnv} {layout loopLayout : Layout}
    {exitLabel : Label} {tailDepth : Nat}
    (hSlotsLe : layout.slots.length ≤ loopLayout.slots.length)
    (hExit :
      depthOf exitLabel = some (layout.slots.length + tailDepth)) :
    blockDepthAfterWithTargets? depthOf
        { body := popN (loopLayout.slots.length - layout.slots.length)
          term := Term.jump exitLabel }
