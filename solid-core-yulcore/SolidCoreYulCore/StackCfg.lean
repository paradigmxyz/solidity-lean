theorem compileCfgStmtOpenCtxOneFrom_lookup_ge_entry
    {fuel : Nat} {layout : Layout} {ctx : ControlCtx}
    {entry normalLabel query : Label} {stmt : ConcreteYul.Stmt}
    {cfg : CfgCodegen} {block : Block}
    (hCompile :
      compileCfgStmtOpenCtxOneFrom fuel layout ctx entry normalLabel stmt =
        some cfg)
    (hLookup : lookupBlock? cfg.program query = some block) :
    entry ≤ query := by
  cases stmt <;> simp [compileCfgStmtOpenCtxOneFrom] at hCompile
  case ifThen cond body =>
    rcases compileIfThenOpenCtxAutoFrom_some hCompile with
      ⟨_condCode, _bodyCfg, _hCond, hBody, _hOk, hProgram, _hOut⟩
    rw [hProgram] at hLookup
    by_cases hEntry : entry = query
    · subst query
      exact Nat.le_refl entry
    · simp [lookupBlock?, hEntry] at hLookup
      by_cases hThen : entry + 1 = query
      · subst query
        exact Nat.le_succ entry
      · have hBodyFresh :
            lookupBlock? _ query = none :=
          compileCfgStmtOpenCtxAutoFrom_lookup_none_of_ne
            (fuel := fuel) (layout := layout) (ctx := ctx)
            (entry := entry + 1) (normalLabel := normalLabel)
            (query := query) (stmt := body) hThen hBody
        rw [hBodyFresh] at hLookup
        cases hLookup
  all_goals
    by_cases hEntry : entry = query
    · subst query
      exact Nat.le_refl entry
    · have hFresh :
          lookupBlock? cfg.program query = none :=
        compileCfgStmtOpenCtxAutoFrom_lookup_none_of_ne
          (fuel := fuel) (layout := layout) (ctx := ctx)
          (entry := entry) (normalLabel := normalLabel)
          (query := query) (stmt := _) hEntry hCompile
      rw [hFresh] at hLookup
      cases hLookup

theorem compileCfgStmtOpenCtxOneFrom_lookup_none_ge_entry_two
    {fuel : Nat} {layout : Layout} {ctx : ControlCtx}
    {entry normalLabel query : Label} {stmt : ConcreteYul.Stmt}
    {cfg : CfgCodegen}
    (hCompile :
      compileCfgStmtOpenCtxOneFrom fuel layout ctx entry normalLabel stmt =
        some cfg)
    (hAfter : entry + 2 ≤ query) :
    lookupBlock? cfg.program query = none := by
  cases stmt <;> simp [compileCfgStmtOpenCtxOneFrom] at hCompile
  case ifThen cond body =>
    rcases compileIfThenOpenCtxAutoFrom_some hCompile with
      ⟨_condCode, _bodyCfg, _hCond, hBody, _hOk, hProgram, _hOut⟩
    have hEntryLtTwo : entry < entry + 2 :=
      Nat.lt_add_of_pos_right (by decide : 0 < 2)
    have hEntry : entry ≠ query :=
      Nat.ne_of_lt (Nat.lt_of_lt_of_le hEntryLtTwo hAfter)
    have hThenLtTwo : entry + 1 < entry + 2 := by
      simp
    have hThen : entry + 1 ≠ query :=
      Nat.ne_of_lt (Nat.lt_of_lt_of_le hThenLtTwo hAfter)
    have hBodyFresh :
        lookupBlock? _ query = none :=
      compileCfgStmtOpenCtxAutoFrom_lookup_none_of_ne
        (fuel := fuel) (layout := layout) (ctx := ctx)
        (entry := entry + 1) (normalLabel := normalLabel)
        (query := query) (stmt := body) hThen hBody
    rw [hProgram]
    simp [lookupBlock?, hEntry, hBodyFresh]
  all_goals
    have hEntryLtTwo : entry < entry + 2 :=
      Nat.lt_add_of_pos_right (by decide : 0 < 2)
    have hEntry : entry ≠ query :=
      Nat.ne_of_lt (Nat.lt_of_lt_of_le hEntryLtTwo hAfter)
    exact
      compileCfgStmtOpenCtxAutoFrom_lookup_none_of_ne
        (fuel := fuel) (layout := layout) (ctx := ctx)
        (entry := entry) (normalLabel := normalLabel)
        (query := query) (stmt := _) hEntry hCompile

