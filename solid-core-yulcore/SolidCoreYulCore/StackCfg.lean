theorem compileForLoopCondFalseTo_cfg_correct
    {compileFuel : Nat} {layout : Layout}
    {pre post body : ConcreteYul.Stmt} {cond : ConcreteYul.Expr}
    {preGen : Codegen} {condCode : List Instr}
    {hash : ConcreteYul.HashOracle} {evalFuel : Nat}
    {source loopConfig condConfig restoredConfig : ConcreteYul.Config}
    {condValue : Word} {tail : Stack} {target : TargetState}
    {entry condLabel bodyLabel cleanupLabel exitLabel : Label}
    (hEntryCond : entry ≠ condLabel)
    (hEntryCleanup : entry ≠ cleanupLabel)
    (hCondCleanup : condLabel ≠ cleanupLabel)
    (hLayout : layout.WellFormed)
    (hPreCompile :
      compileStmtFuelFrom compileFuel layout pre = some preGen)
    (hCond : compileExprAt preGen.outLayout 0 cond = some condCode)
    (hPreEval :
      ConcreteYul.evalStmtFuel hash evalFuel.succ source pre =
        some { flow := ConcreteYul.Flow.normal, config := loopConfig })
    (hCondEval :
      ConcreteYul.evalExpr hash cond loopConfig =
        some (condValue, condConfig))
    (hCondZero : norm condValue = 0)
    (hRestore :
      ConcreteYul.restoreBlockConfig source condConfig =
        some restoredConfig)
    (hNoHalt : source.state.halt? = none)
    (hRel : StackRel layout source [] tail target) :
    ConcreteYul.evalStmtFuel hash evalFuel.succ.succ source
        (ConcreteYul.Stmt.forLoop pre cond post body) =
      some (ConcreteYul.normalResult restoredConfig) ∧
      ∃ target',
        Reaches
          (forLoopCondFalseToProgram entry condLabel bodyLabel cleanupLabel
            exitLabel preGen.code condCode
            (preGen.outLayout.slots.length - layout.slots.length))
          (Config.at entry target) (Config.at exitLabel target') ∧
          StackRel layout restoredConfig [] tail target' := by
  have hLoopEval :
      ConcreteYul.evalStmtFuel hash evalFuel.succ.succ source
          (ConcreteYul.Stmt.forLoop pre cond post body) =
        some (ConcreteYul.normalResult restoredConfig) := by
    simp [ConcreteYul.evalStmtFuel, ConcreteYul.evalForFuel,
      hPreEval, hCondEval, hCondZero, hRestore]
  rcases
    compileStmtFuelFrom_execList_correct hLayout hPreCompile hPreEval
      hNoHalt hRel with
    ⟨preTarget, hPreExec, hPreRel, _hPreFlow, _hPreNoHalt,
      _hPreLayout⟩
  rcases
    compileExprAt_execList_correct hCond hCondEval hPreRel with
    ⟨condTarget, hCondExec, hCondRel⟩
  let branchTarget : TargetState :=
    { condTarget with
      stack := frameOf preGen.outLayout condConfig.env ++ tail }
  have hBranchRel :
      StackRel preGen.outLayout condConfig [] tail branchTarget :=
    stackRel_drop_word_temp hCondRel
  rcases compileStmtFuelFrom_extends hPreCompile with
    ⟨localSlots, hSlots⟩
  rcases
    stackRel_restoreBlockConfig_after_pop hLayout hRel.bound hBranchRel
      hSlots hRestore with
    ⟨exitTarget, hPop, hExitRel⟩
  refine ⟨hLoopEval, exitTarget, ?_, hExitRel⟩
  refine
    Reaches.step (next := Config.at condLabel preTarget) ?_ ?_
  · simp [forLoopCondFalseToProgram, step, lookupBlock?, hPreExec,
      execTerm]
  · refine
      Reaches.step (next := Config.at cleanupLabel branchTarget) ?_ ?_
    · simp [forLoopCondFalseToProgram, step, lookupBlock?, hEntryCond,
        hCondExec, execTerm, hCondRel.stack_eq, branchTarget, hCondZero]
    · apply reaches_one
      simp [forLoopCondFalseToProgram, step, lookupBlock?, hEntryCleanup,
        hCondCleanup, hPop, execTerm]

theorem compileForLoopLinearEval_reaches
    {compileFuel evalFuel : Nat} {layout loopLayout : Layout}
    {cond : ConcreteYul.Expr} {post body : ConcreteYul.Stmt}
    {preCode condCode : List Instr} {bodyGen postGen : Codegen}
    {localSlots : List ConcreteYul.Name}
    {hash : ConcreteYul.HashOracle}
    {outer loopConfig : ConcreteYul.Config}
    {result : ConcreteYul.Result}
    {tail : Stack} {target : TargetState}
    (hLayout : layout.WellFormed)
    (hLoopLayout : loopLayout.WellFormed)
    (hCond : compileExprAt loopLayout 0 cond = some condCode)
    (hBody : compileStmtFuelFrom compileFuel loopLayout body = some bodyGen)
    (hPost : compileStmtFuelFrom compileFuel loopLayout post = some postGen)
    (hBodyOut : bodyGen.outLayout = loopLayout)
    (hPostOut : postGen.outLayout = loopLayout)
    (hSlots : loopLayout.slots = localSlots ++ layout.slots)
    (hEval :
      ConcreteYul.evalForFuel hash evalFuel outer loopConfig cond post body =
        some result)
    (hNoHalt : loopConfig.state.halt? = none)
    (hOuterBound : layout.Bound outer.env)
    (hRel : StackRel loopLayout loopConfig [] tail target) :
    ∃ target',
      Reaches
        (forLoopLinearProgram preCode condCode bodyGen.code postGen.code
          localSlots.length)
        (Config.at 1 target) (Config.halted target') ∧
        StackRel layout result.config [] tail target' ∧
        result.flow = ConcreteYul.Flow.normal := by
  induction evalFuel generalizing loopConfig target result with
  | zero =>
      simp [ConcreteYul.evalForFuel] at hEval
  | succ evalFuel ih =>
      simp [ConcreteYul.evalForFuel] at hEval
      cases hCondEval : ConcreteYul.evalExpr hash cond loopConfig with
      | none =>
          simp [hCondEval] at hEval
      | some condResult =>
          cases condResult with
          | mk condValue condConfig =>
              simp [hCondEval] at hEval
              have hCondConfigEq : condConfig = loopConfig :=
                compileExprAt_eval_config_eq hCond hCondEval
              have hCondNoHalt :
                  condConfig.state.halt? = none := by
                simpa [hCondConfigEq] using hNoHalt
              rcases
                compileExprAt_execList_correct hCond hCondEval hRel with
                ⟨condTarget, hCondExec, hCondRel⟩
              let branchTarget : TargetState :=
                { condTarget with
                  stack := frameOf loopLayout condConfig.env ++ tail }
              have hBranchRel :
                  StackRel loopLayout condConfig [] tail branchTarget :=
                stackRel_drop_word_temp hCondRel
              by_cases hZero : norm condValue = 0
              · simp [hZero] at hEval
                cases hRestore :
                    ConcreteYul.restoreBlockConfig outer condConfig with
                | none =>
                    simp [hRestore] at hEval
                | some restoredConfig =>
                    simp [hRestore, ConcreteYul.normalResult] at hEval
                    cases hEval
                    rcases
                      stackRel_restoreBlockConfig_after_pop hLayout
                        hOuterBound hBranchRel hSlots hRestore with
                    ⟨exitTarget, hPop, hExitRel⟩
                    have hDropCount :
                        loopLayout.slots.length - layout.slots.length =
                          localSlots.length := by
                      rw [hSlots]
                      simp
                    have hPopLocal :
                        execList (popN localSlots.length) branchTarget =
                          some exitTarget := by
                      simpa [hDropCount] using hPop
                    refine ⟨exitTarget, ?_, hExitRel, rfl⟩
                    refine
                      Reaches.step (next := Config.at 4 branchTarget) ?_ ?_
                    · simp [forLoopLinearProgram, step, lookupBlock?,
                        hCondExec, execTerm, hCondRel.stack_eq,
                        branchTarget, hZero]
                    · refine
                        Reaches.step (next := Config.at 5 exitTarget) ?_ ?_
                      · simp [forLoopLinearProgram, step, lookupBlock?,
                          hPopLocal, execTerm]
                      · exact
                          reaches_one
                            (program :=
                              forLoopLinearProgram preCode condCode
                                bodyGen.code postGen.code
                                localSlots.length)
                            (by
                              simp [forLoopLinearProgram, step,
                                lookupBlock?, execList, execTerm])
              · simp [hZero] at hEval
                cases hBodyEval :
                    ConcreteYul.evalStmtFuel hash evalFuel
                      condConfig body with
                | none =>
                    simp [hBodyEval] at hEval
                | some bodyResult =>
                    cases evalFuel with
                    | zero =>
                        simp [ConcreteYul.evalStmtFuel] at hBodyEval
                    | succ bodyEvalFuel =>
                        rcases
                          compileStmtFuelFrom_execList_correct hLoopLayout
                            hBody hBodyEval hCondNoHalt hBranchRel with
                        ⟨bodyTarget, hBodyExec, hBodyRel, hBodyFlow,
                          hBodyNoHalt, hBodyLayout⟩
                        cases bodyResult with
                        | mk bodyFlow bodyConfig =>
                            cases bodyFlow <;>
                              simp [hBodyEval] at hEval hBodyFlow
                            rcases hBodyFlow
                            have hBodyRelLayout :
                                StackRel loopLayout bodyConfig [] tail
                                  bodyTarget := by
                              simpa [hBodyOut] using hBodyRel
                            cases hPostEval :
                                ConcreteYul.evalStmtFuel hash
                                  bodyEvalFuel.succ bodyConfig post with
                            | none =>
                                simp [hPostEval] at hEval
                            | some postResult =>
                                rcases
                                  compileStmtFuelFrom_execList_correct
                                    hLoopLayout hPost hPostEval hBodyNoHalt
                                    hBodyRelLayout with
                                ⟨postTarget, hPostExec, hPostRel, hPostFlow,
                                  hPostNoHalt, hPostLayout⟩
                                cases postResult with
                                | mk postFlow postConfig =>
                                    cases postFlow <;>
                                      simp [hPostEval] at hEval hPostFlow
                                    rcases hPostFlow
                                    have hPostRelLayout :
                                        StackRel loopLayout postConfig [] tail
                                          postTarget := by
                                      simpa [hPostOut] using hPostRel
                                    have hLoopEval :
                                        ConcreteYul.evalForFuel hash
                                            bodyEvalFuel.succ outer postConfig
                                            cond post body =
                                          some result := by
                                      simpa [hBodyEval, hPostEval] using hEval
                                    rcases
                                      ih (loopConfig := postConfig)
                                        (result := result)
                                        (target := postTarget)
                                        hLoopEval hPostNoHalt
                                        hPostRelLayout with
                                    ⟨target', hLoopReach, hResultRel,
                                      hResultFlow⟩
                                    refine ⟨target', ?_, hResultRel,
                                      hResultFlow⟩
                                    refine
                                      Reaches.step
                                        (next := Config.at 2 branchTarget)
                                        ?_ ?_
                                    · simp [forLoopLinearProgram, step,
                                        lookupBlock?, hCondExec, execTerm,
                                        hCondRel.stack_eq, branchTarget,
                                        hZero]
                                    · refine
                                        Reaches.step
                                          (next := Config.at 3 bodyTarget)
                                          ?_ ?_
                                      · simp [forLoopLinearProgram, step,
                                          lookupBlock?, hBodyExec, execTerm]
                                      · refine
                                          Reaches.step
                                            (next := Config.at 1 postTarget)
                                            ?_ ?_
                                        · simp [forLoopLinearProgram, step,
                                            lookupBlock?, hPostExec, execTerm]
                                        · exact hLoopReach

theorem compileForLoopLinearFrom_cfg_correct
    {compileFuel : Nat} {layout : Layout}
    {pre post body : ConcreteYul.Stmt} {cond : ConcreteYul.Expr}
    {cfg : CfgCodegen} {hash : ConcreteYul.HashOracle} {evalFuel : Nat}
    {source : ConcreteYul.Config} {result : ConcreteYul.Result}
    {tail : Stack} {target : TargetState}
    (hLayout : layout.WellFormed)
    (hCompile :
      compileForLoopLinearFrom compileFuel layout pre cond post body =
        some cfg)
    (hEval :
      ConcreteYul.evalStmtFuel hash evalFuel.succ.succ source
        (ConcreteYul.Stmt.forLoop pre cond post body) =
        some result)
    (hNoHalt : source.state.halt? = none)
    (hRel : StackRel layout source [] tail target) :
    ∃ target',
      Reaches cfg.program (Config.at 0 target)
        (Config.halted target') ∧
        StackRel cfg.outLayout result.config [] tail target' ∧
        result.flow = ConcreteYul.Flow.normal := by
  simp [compileForLoopLinearFrom] at hCompile
  cases hPreCompile : compileStmtFuelFrom compileFuel layout pre with
  | none =>
      simp [hPreCompile] at hCompile
  | some preGen =>
      cases hCondCode : compileExprAt preGen.outLayout 0 cond with
      | none =>
          simp [hPreCompile, hCondCode] at hCompile
      | some condCode =>
          cases hBodyCompile :
              compileStmtFuelFrom compileFuel preGen.outLayout body with
          | none =>
              simp [hPreCompile, hCondCode, hBodyCompile] at hCompile
          | some bodyGen =>
              cases hPostCompile :
                  compileStmtFuelFrom compileFuel preGen.outLayout post with
              | none =>
                  simp [hPreCompile, hCondCode, hBodyCompile,
                    hPostCompile] at hCompile
              | some postGen =>
                  by_cases hBodyOut :
                      bodyGen.outLayout = preGen.outLayout
                  · by_cases hPostOut :
                        postGen.outLayout = preGen.outLayout
                    · simp [hPreCompile, hCondCode, hBodyCompile,
                        hPostCompile, hBodyOut, hPostOut] at hCompile
                      cases hCompile
                      simp [ConcreteYul.evalStmtFuel] at hEval
                      cases hPreEval :
                          ConcreteYul.evalStmtFuel hash evalFuel.succ
                            source pre with
                      | none =>
                          simp [hPreEval] at hEval
                      | some preResult =>
                          rcases
                            compileStmtFuelFrom_execList_correct hLayout
                              hPreCompile hPreEval hNoHalt hRel with
                          ⟨preTarget, hPreExec, hPreRel, hPreFlow,
                            hPreNoHalt, hPreLayout⟩
                          cases preResult with
                          | mk preFlow loopConfig =>
                              cases preFlow <;>
                                simp [hPreEval] at hEval hPreFlow
                              rcases hPreFlow
                              rcases compileStmtFuelFrom_extends
                                  hPreCompile with
                              ⟨localSlots, hSlots⟩
                              have hDropCount :
                                  preGen.outLayout.slots.length -
                                      layout.slots.length =
                                    localSlots.length := by
                                rw [hSlots]
                                simp
                              rcases
                                compileForLoopLinearEval_reaches
                                  (compileFuel := compileFuel)
                                  (evalFuel := evalFuel.succ)
                                  (layout := layout)
                                  (loopLayout := preGen.outLayout)
                                  (cond := cond) (post := post)
                                  (body := body) (preCode := preGen.code)
                                  (condCode := condCode)
                                  (bodyGen := bodyGen)
                                  (postGen := postGen)
                                  (localSlots := localSlots)
                                  (hash := hash) (outer := source)
                                  (loopConfig := loopConfig)
                                  (result := result) (tail := tail)
                                  (target := preTarget)
                                  hLayout hPreLayout hCondCode
                                  hBodyCompile hPostCompile hBodyOut
                                  hPostOut hSlots hEval hPreNoHalt
                                  hRel.bound hPreRel with
                              ⟨target', hLoopReach, hResultRel,
                                hResultFlow⟩
                              refine ⟨target', ?_, ?_, hResultFlow⟩
                              · refine
                                  Reaches.step
                                    (next := Config.at 1 preTarget) ?_
                                    ?_
                                · simp [forLoopLinearProgram, step,
                                    lookupBlock?, hPreExec, execTerm]
                                · simpa [hDropCount] using hLoopReach
                              · exact hResultRel
                    · simp [hPreCompile, hCondCode, hBodyCompile,
                        hPostCompile, hBodyOut, hPostOut] at hCompile
                  · simp [hPreCompile, hCondCode, hBodyCompile,
                      hPostCompile, hBodyOut] at hCompile

theorem evalProgramForFuel_eq_evalForFuel_of_compileStmtFuelFrom
    {compileFuel : Nat} {layout : Layout}
    {post body : ConcreteYul.Stmt} {bodyGen postGen : Codegen}
    {hash : ConcreteYul.HashOracle} {funcs : ConcreteYul.FunctionEnv}
    {evalFuel : Nat} {outer loopConfig : ConcreteYul.Config}
    {cond : ConcreteYul.Expr}
    (hBody :
      compileStmtFuelFrom compileFuel layout body = some bodyGen)
    (hPost :
      compileStmtFuelFrom compileFuel layout post = some postGen) :
    ConcreteYul.evalProgramForFuel hash funcs evalFuel outer loopConfig
        cond post body =
      ConcreteYul.evalForFuel hash evalFuel outer loopConfig cond post body := by
  induction evalFuel generalizing loopConfig with
  | zero =>
      simp [ConcreteYul.evalProgramForFuel, ConcreteYul.evalForFuel]
  | succ evalFuel ih =>
      simp [ConcreteYul.evalProgramForFuel, ConcreteYul.evalForFuel]
      cases hCondEval :
          ConcreteYul.evalExpr hash cond loopConfig with
      | none =>
          simp
      | some condResult =>
          cases condResult with
          | mk condValue condConfig =>
              simp
              by_cases hZero : norm condValue = 0
              · simp [hZero]
              · simp [hZero]
                rw [
                  evalProgramStmtFuel_eq_evalStmtFuel_of_compileStmtFuelFrom
                    hBody]
                cases hBodyEval :
                    ConcreteYul.evalStmtFuel hash evalFuel condConfig
                      body with
                | none =>
                    rfl
                | some bodyResult =>
                    cases bodyResult with
                    | mk bodyFlow bodyConfig =>
                        cases bodyFlow with
                        | normal =>
                            simp
                            rw [
                              evalProgramStmtFuel_eq_evalStmtFuel_of_compileStmtFuelFrom
                                hPost]
                            cases hPostEval :
                                ConcreteYul.evalStmtFuel hash evalFuel
                                  bodyConfig post with
                            | none =>
                                rfl
                            | some postResult =>
                                cases postResult with
                                | mk postFlow postConfig =>
                                    cases postFlow with
                                    | normal =>
