theorem compileForLoopOpenCtxRecFrom_lookup_none_ge_nextLabel
    {compileFuel : Nat} {layout : Layout} {ctx : ControlCtx}
    {entry normalLabel next label : Label}
    {pre post body : ConcreteYul.Stmt} {cond : ConcreteYul.Expr}
    {openCfg : OpenCfgCodegen}
    (hEntryNext : entry < next)
    (hCompile :
      compileForLoopOpenCtxRecFrom compileFuel layout ctx entry normalLabel
        next pre cond post body =
        some openCfg)
    (hAfter : openCfg.nextLabel ≤ label) :
    lookupBlock? openCfg.program label = none := by
  rcases compileForLoopOpenCtxRecFrom_some hCompile with
    ⟨preOpen, condCode, bodyOpen, postOpen, hPre, _hCond, hBody,
      _hBodyOut, hPost, _hPostOut, hProgram, _hOut, hNext⟩
  have hPreEntryNext : entry < next + 4 := by
    exact Nat.lt_trans hEntryNext
      (Nat.lt_add_of_pos_right (by decide : 0 < 4))
  have hPreNext : next + 4 ≤ preOpen.nextLabel :=
    compileCfgStmtOpenCtxRecFrom_next_le hPreEntryNext hPre
  have hBodyEntryNext : next + 2 < preOpen.nextLabel := by
    exact Nat.lt_of_lt_of_le
      (Nat.add_lt_add_left (by decide : 2 < 4) next) hPreNext
  have hBodyNext : preOpen.nextLabel ≤ bodyOpen.nextLabel :=
    compileCfgStmtOpenCtxRecFrom_next_le hBodyEntryNext hBody
  have hPostEntryNext : next + 1 < bodyOpen.nextLabel := by
    exact Nat.lt_of_lt_of_le
      (Nat.add_lt_add_left (by decide : 1 < 4) next)
      (Nat.le_trans hPreNext hBodyNext)
  have hPostNext : bodyOpen.nextLabel ≤ postOpen.nextLabel :=
    compileCfgStmtOpenCtxRecFrom_next_le hPostEntryNext hPost
  have hAfterPost : postOpen.nextLabel ≤ label := by
    simpa [hNext] using hAfter
  have hPreFresh :
      lookupBlock? preOpen.program label = none :=
    compileCfgStmtOpenCtxRecFrom_lookup_none_ge_nextLabel
      hPreEntryNext hPre
      (Nat.le_trans hBodyNext (Nat.le_trans hPostNext hAfterPost))
  have hBodyFresh :
      lookupBlock? bodyOpen.program label = none :=
    compileCfgStmtOpenCtxRecFrom_lookup_none_ge_nextLabel
      hBodyEntryNext hBody (Nat.le_trans hPostNext hAfterPost)
  have hPostFresh :
      lookupBlock? postOpen.program label = none :=
    compileCfgStmtOpenCtxRecFrom_lookup_none_ge_nextLabel
      hPostEntryNext hPost hAfterPost
  have hCondNe : next ≠ label := by
    exact Nat.ne_of_lt
      (Nat.lt_of_lt_of_le
        (Nat.lt_add_of_pos_right (by decide : 0 < 4))
        (Nat.le_trans hPreNext
          (Nat.le_trans hBodyNext (Nat.le_trans hPostNext hAfterPost))))
  have hCleanupNe : next + 3 ≠ label := by
    exact Nat.ne_of_lt
      (Nat.lt_of_lt_of_le
        (Nat.add_lt_add_left (by decide : 3 < 4) next)
        (Nat.le_trans hPreNext
          (Nat.le_trans hBodyNext (Nat.le_trans hPostNext hAfterPost))))
  rw [hProgram, forLoopOpenCtxProgram]
  repeat rw [List.append_assoc]
  rw [lookupBlock?_append_of_none _ _ hPreFresh]
  simp [lookupBlock?, hCondNe]
  rw [lookupBlock?_append_of_none _ _ hPostFresh]
  simp [lookupBlock?, hCleanupNe, hBodyFresh]

def compileCfgStmtOpenWithCallsFrom (fuel : Nat) (layout : Layout)
    (dest : ControlDest) (entry exit next : Label) :
    ConcreteYul.Stmt -> Option OpenCfgCodegen
  | ConcreteYul.Stmt.letCall names fnName args =>
      match
        compileLetCallOpenFrom layout entry next exit names fnName args with
      | some cfg =>
          some
            { program := cfg.program
              outLayout := cfg.outLayout
              nextLabel := next + 1 }
      | none => none
  | ConcreteYul.Stmt.assignCall names fnName args =>
      match
        compileAssignCallOpenFrom layout entry next exit names fnName args with
      | some cfg =>
          some
            { program := cfg.program
              outLayout := cfg.outLayout
              nextLabel := next + 1 }
      | none => none
  | stmt =>
      match compileCfgStmtOpenFrom fuel layout dest entry exit stmt with
      | some cfg =>
          some
            { program := cfg.program
              outLayout := cfg.outLayout
              nextLabel := next }
      | none => none

theorem compileCfgStmtOpenWithCallsFrom_assignCall_programDepthChecked
    {depthOf : DepthEnv} {fuel : Nat} {layout : Layout}
    {dest : ControlDest} {entry exit next : Label}
    {names : List ConcreteYul.Name} {fnName : ConcreteYul.Name}
    {args : List ConcreteYul.Expr} {openCfg : OpenCfgCodegen}
    {tailDepth : Nat}
    (hCompile :
      compileCfgStmtOpenWithCallsFrom fuel layout dest entry exit next
        (ConcreteYul.Stmt.assignCall names fnName args) =
          some openCfg)
    (hEntry : depthOf entry = some (layout.slots.length + tailDepth))
    (hNext :
      depthOf next =
        some (layout.slots.length + tailDepth + names.length))
    (hExit : depthOf exit = some (layout.slots.length + tailDepth)) :
    Program.DepthChecked depthOf openCfg.program := by
  simp [compileCfgStmtOpenWithCallsFrom] at hCompile
  cases hCall :
      compileAssignCallOpenFrom layout entry next exit names fnName args with
  | none =>
      simp [hCall] at hCompile
  | some cfg =>
      simp [hCall] at hCompile
      cases hCompile
      exact
        compileAssignCallOpenFrom_programDepthChecked
          (depthOf := depthOf) (layout := layout)
          (entry := entry) (afterCall := next) (exit := exit)
          (names := names) (fnName := fnName) (args := args)
          (cfg := cfg) (tailDepth := tailDepth)
          hCall hEntry hNext hExit

theorem compileCfgStmtOpenWithCallsFrom_letCall_programDepthChecked
    {depthOf : DepthEnv} {fuel : Nat} {layout : Layout}
    {dest : ControlDest} {entry exit next : Label}
    {names : List ConcreteYul.Name} {fnName : ConcreteYul.Name}
    {args : List ConcreteYul.Expr} {openCfg : OpenCfgCodegen}
    {tailDepth : Nat}
    (hCompile :
      compileCfgStmtOpenWithCallsFrom fuel layout dest entry exit next
        (ConcreteYul.Stmt.letCall names fnName args) =
          some openCfg)
    (hEntry : depthOf entry = some (layout.slots.length + tailDepth))
    (hNext :
      depthOf next =
        some (layout.slots.length + tailDepth + names.length))
    (hExit :
      depthOf exit =
        some (names.length + layout.slots.length + tailDepth)) :
    Program.DepthChecked depthOf openCfg.program := by
  simp [compileCfgStmtOpenWithCallsFrom] at hCompile
  cases hCall :
      compileLetCallOpenFrom layout entry next exit names fnName args with
  | none =>
      simp [hCall] at hCompile
  | some cfg =>
      simp [hCall] at hCompile
      cases hCompile
      exact
        compileLetCallOpenFrom_programDepthChecked
          (depthOf := depthOf) (layout := layout)
          (entry := entry) (afterCall := next) (exit := exit)
          (names := names) (fnName := fnName) (args := args)
          (cfg := cfg) (tailDepth := tailDepth)
          hCall hEntry hNext hExit

def compileCfgStmtOpenOneFrom (fuel : Nat) (layout : Layout)
    (dest : ControlDest) (entry exit : Label) :
    ConcreteYul.Stmt -> Option CfgCodegen
  | ConcreteYul.Stmt.ifThen cond body =>
      compileIfThenOpenAutoFrom fuel layout dest entry exit cond body
  | stmt =>
      compileCfgStmtOpenFrom fuel layout dest entry exit stmt

def compileCfgStmtOpenRecFrom : Nat -> Layout -> ControlDest ->
    Label -> Label -> Label -> ConcreteYul.Stmt -> Option OpenCfgCodegen
  | 0, _, _, _, _, _, _ => none
  | fuel + 1, layout, dest, entry, exit, next, ConcreteYul.Stmt.ifThen cond body =>
      match compileExprAt layout 0 cond,
          compileCfgStmtOpenRecFrom fuel layout dest next exit (next + 1) body with
      | some condCode, some bodyOpen =>
          if bodyOpen.outLayout = layout then
            some
              { program :=
                  [ (entry,
                    { body := condCode
                      term := Term.branchNZ next exit }) ] ++
                    bodyOpen.program
                outLayout := layout
                nextLabel := bodyOpen.nextLabel }
          else none
      | _, _ => none
  | fuel + 1, layout, dest, entry, exit, next,
      ConcreteYul.Stmt.seq first second =>
      match
        compileCfgStmtOpenFrom (fuel + 1) layout dest entry exit
          (ConcreteYul.Stmt.seq first second) with
      | some cfg =>
          some
            { program := cfg.program
              outLayout := cfg.outLayout
              nextLabel := next }
      | none =>
          match compileStmtFuelFrom fuel layout first with
          | none => none
          | some firstGen =>
              match
                compileCfgStmtOpenRecFrom fuel firstGen.outLayout dest next
                  exit (next + 1) second with
              | none => none
              | some secondOpen =>
                  some
                    { program :=
                        linearToProgram entry next firstGen.code ++
                          secondOpen.program
                      outLayout := secondOpen.outLayout
                      nextLabel := secondOpen.nextLabel }
  | fuel + 1, layout, dest, entry, exit, next, stmt =>
      match compileCfgStmtOpenFrom (fuel + 1) layout dest entry exit stmt with
      | some cfg =>
          some
            { program := cfg.program
              outLayout := cfg.outLayout
              nextLabel := next }
      | none => none

def compileCfgStmtOpenRecAutoFrom (fuel : Nat) (layout : Layout)
    (dest : ControlDest) (entry exit : Label)
    (stmt : ConcreteYul.Stmt) : Option OpenCfgCodegen :=
  compileCfgStmtOpenRecFrom fuel layout dest entry exit (entry + 1) stmt

def functionReturnDest (returnLabel : Label) : ControlDest :=
  { breakLabel := returnLabel
    continueLabel := returnLabel
    leaveLabel := returnLabel }

def functionBodyWithReturnProgram (bodyProgram : Program)
    (returnLabel : Label) (returnCode : List Instr) : Program :=
  bodyProgram ++ [(returnLabel, { body := returnCode, term := Term.halt })]

def compileFunctionBodyWithReturnFrom (fuel : Nat) (layout : Layout)
    (returns : List ConcreteYul.Name) (entry returnLabel : Label)
    (body : ConcreteYul.Stmt) : Option CfgCodegen :=
  match
      compileCfgStmtOpenRecAutoFrom fuel layout
        (functionReturnDest returnLabel) entry returnLabel body with
  | none => none
  | some openCfg =>
      match compileReturnValuesFrom openCfg.outLayout returns with
      | none => none
      | some returnCode =>
          match lookupBlock? openCfg.program returnLabel with
          | none =>
              some
                { program :=
                    functionBodyWithReturnProgram openCfg.program
                      returnLabel returnCode
                  outLayout := openCfg.outLayout }
          | some _ => none

def compileFunctionBodyWithReturnCtxSameLayoutFrom (fuel : Nat)
    (layout : Layout) (returns : List ConcreteYul.Name)
    (entry returnLabel : Label) (body : ConcreteYul.Stmt) :
    Option CfgCodegen :=
  match
      compileCfgStmtOpenCtxRecAutoFrom fuel layout
        (ControlCtx.functionReturn returnLabel layout) entry returnLabel body
  with
  | none => none
  | some openCfg =>
      if openCfg.outLayout = layout then
        match compileReturnValuesFrom layout returns with
        | none => none
        | some returnCode =>
            match lookupBlock? openCfg.program returnLabel with
            | none =>
                some
                  { program :=
                      functionBodyWithReturnProgram openCfg.program
                        returnLabel returnCode
                    outLayout := layout }
            | some _ => none
      else none

structure CompiledFunction where
  params : List ConcreteYul.Name
  returns : List ConcreteYul.Name
  entryLayout : Layout
  outLayout : Layout
  entry : Label
  returnLabel : Label
  program : Program
  deriving DecidableEq, Repr

def compileFunctionDefFrom (fuel : Nat) (entry returnLabel : Label)
    (fn : ConcreteYul.FunctionDef) : Option CompiledFunction :=
  match functionEntryLayout? fn.params fn.returns with
  | none => none
  | some entryLayout =>
      match
          compileFunctionBodyWithReturnFrom fuel entryLayout fn.returns
            entry returnLabel fn.body with
      | none => none
      | some bodyCfg =>
          some
            { params := fn.params
              returns := fn.returns
              entryLayout := entryLayout
              outLayout := bodyCfg.outLayout
              entry := entry
              returnLabel := returnLabel
              program := bodyCfg.program }

def compileFunctionDefCtxSameLayoutFrom (fuel : Nat)
    (entry returnLabel : Label) (fn : ConcreteYul.FunctionDef) :
    Option CompiledFunction :=
  match functionEntryLayout? fn.params fn.returns with
  | none => none
  | some entryLayout =>
      match
          compileFunctionBodyWithReturnCtxSameLayoutFrom fuel entryLayout
            fn.returns entry returnLabel fn.body with
      | none => none
      | some bodyCfg =>
          some
            { params := fn.params
              returns := fn.returns
              entryLayout := entryLayout
              outLayout := bodyCfg.outLayout
              entry := entry
              returnLabel := returnLabel
              program := bodyCfg.program }

theorem functionReturnBlockDepthAfter
    {layout : Layout} {returns : List ConcreteYul.Name}
    {returnCode : List Instr} {tailDepth : Nat}
    (hReturnCode :
      compileReturnValuesFrom layout returns = some returnCode) :
    blockDepthAfter?
        { body := returnCode
          term := Term.halt }
        (layout.slots.length + tailDepth) =
      some (layout.slots.length + tailDepth + returns.length) :=
  blockDepthAfter?_halt_of_codeDepthAfter
    (compileReturnValuesFrom_codeDepthAfter
      (layout := layout) (names := returns) (code := returnCode)
      (tailDepth := tailDepth) hReturnCode)

theorem functionReturnBlockDepthAfterWithTargets
    {depthOf : DepthEnv} {layout : Layout}
    {returns : List ConcreteYul.Name}
    {returnCode : List Instr} {tailDepth : Nat}
    (hReturnCode :
      compileReturnValuesFrom layout returns = some returnCode) :
    blockDepthAfterWithTargets? depthOf
        { body := returnCode
          term := Term.halt }
        (layout.slots.length + tailDepth) =
      some (layout.slots.length + tailDepth + returns.length) :=
  blockDepthAfterWithTargets?_halt_of_codeDepthAfter
    (compileReturnValuesFrom_codeDepthAfter
      (layout := layout) (names := returns) (code := returnCode)
      (tailDepth := tailDepth) hReturnCode)

theorem functionBodyWithReturnProgram_depthChecked
    {depthOf : DepthEnv} {bodyProgram : Program}
    {returnLabel : Label} {returnCode : List Instr}
    {layout : Layout} {returns : List ConcreteYul.Name}
    {tailDepth : Nat}
    (hBody : Program.DepthChecked depthOf bodyProgram)
    (hReturnLabel :
      depthOf returnLabel = some (layout.slots.length + tailDepth))
    (hReturnCode :
      compileReturnValuesFrom layout returns = some returnCode) :
    Program.DepthChecked depthOf
      (functionBodyWithReturnProgram bodyProgram returnLabel returnCode) := by
  unfold functionBodyWithReturnProgram
  exact
    Program.DepthChecked.append hBody
      (Program.DepthChecked.cons
        (entry := returnLabel)
        (block := { body := returnCode, term := Term.halt })
        (rest := [])
        (depth := layout.slots.length + tailDepth)
        (outDepth := layout.slots.length + tailDepth + returns.length)
        hReturnLabel
        (functionReturnBlockDepthAfterWithTargets
          (depthOf := depthOf) (layout := layout) (returns := returns)
          (returnCode := returnCode) (tailDepth := tailDepth)
          hReturnCode)
        Program.DepthChecked.nil)

theorem compileFunctionBodyWithReturnFrom_returnBlockDepthAfter
    {fuel : Nat} {layout : Layout} {returns : List ConcreteYul.Name}
    {entry returnLabel : Label} {body : ConcreteYul.Stmt}
    {cfg : CfgCodegen} {tailDepth : Nat}
    (hCompile :
      compileFunctionBodyWithReturnFrom fuel layout returns entry
        returnLabel body = some cfg) :
    ∃ openCfg returnCode,
      compileCfgStmtOpenRecAutoFrom fuel layout
          (functionReturnDest returnLabel) entry returnLabel body =
        some openCfg ∧
        compileReturnValuesFrom openCfg.outLayout returns =
          some returnCode ∧
        lookupBlock? openCfg.program returnLabel = none ∧
        cfg.program =
          functionBodyWithReturnProgram openCfg.program returnLabel
            returnCode ∧
        cfg.outLayout = openCfg.outLayout ∧
        blockDepthAfter?
            { body := returnCode
              term := Term.halt }
            (openCfg.outLayout.slots.length + tailDepth) =
          some
            (openCfg.outLayout.slots.length + tailDepth +
              returns.length) := by
  simp [compileFunctionBodyWithReturnFrom] at hCompile
  cases hOpen :
      compileCfgStmtOpenRecAutoFrom fuel layout
        (functionReturnDest returnLabel) entry returnLabel body with
  | none =>
      simp [hOpen] at hCompile
  | some openCfg =>
      cases hReturnCode :
          compileReturnValuesFrom openCfg.outLayout returns with
      | none =>
          simp [hOpen, hReturnCode] at hCompile
      | some returnCode =>
          cases hFresh : lookupBlock? openCfg.program returnLabel with
          | some existing =>
              simp [hOpen, hReturnCode, hFresh] at hCompile
          | none =>
              simp [hOpen, hReturnCode, hFresh] at hCompile
              cases hCompile
              exact
                ⟨openCfg, returnCode, rfl, hReturnCode, hFresh, rfl, rfl,
                  functionReturnBlockDepthAfter
                    (layout := openCfg.outLayout) (returns := returns)
                    (returnCode := returnCode) (tailDepth := tailDepth)
                    hReturnCode⟩

theorem compileFunctionDefFrom_returnBlockDepthAfter
    {fuel entry returnLabel : Nat} {fn : ConcreteYul.FunctionDef}
    {compiled : CompiledFunction} {tailDepth : Nat}
    (hCompile :
      compileFunctionDefFrom fuel entry returnLabel fn = some compiled) :
    ∃ openCfg returnCode,
      compileCfgStmtOpenRecAutoFrom fuel compiled.entryLayout
          (functionReturnDest compiled.returnLabel)
          compiled.entry compiled.returnLabel fn.body =
        some openCfg ∧
        compileReturnValuesFrom openCfg.outLayout compiled.returns =
          some returnCode ∧
        lookupBlock? openCfg.program compiled.returnLabel = none ∧
        compiled.program =
          functionBodyWithReturnProgram openCfg.program
            compiled.returnLabel returnCode ∧
        blockDepthAfter?
            { body := returnCode
              term := Term.halt }
            (openCfg.outLayout.slots.length + tailDepth) =
          some
            (openCfg.outLayout.slots.length + tailDepth +
              compiled.returns.length) := by
  simp [compileFunctionDefFrom] at hCompile
  cases hEntry : functionEntryLayout? fn.params fn.returns with
  | none =>
      simp [hEntry] at hCompile
  | some entryLayout =>
      cases hBody :
          compileFunctionBodyWithReturnFrom fuel entryLayout fn.returns
            entry returnLabel fn.body with
      | none =>
          simp [hEntry, hBody] at hCompile
      | some bodyCfg =>
          simp [hEntry, hBody] at hCompile
          cases hCompile
          rcases
            compileFunctionBodyWithReturnFrom_returnBlockDepthAfter
              (tailDepth := tailDepth) hBody with
          ⟨openCfg, returnCode, hOpen, hReturnCode, hFresh, hProgram,
            _hOut, hDepth⟩
          exact
            ⟨openCfg, returnCode,
              by simpa using hOpen,
              by simpa using hReturnCode,
              by simpa using hFresh,
              by simpa using hProgram,
              by simpa using hDepth⟩

theorem compileFunctionBodyWithReturnFrom_programDepthChecked
    {depthOf : DepthEnv} {fuel : Nat} {layout : Layout}
    {returns : List ConcreteYul.Name} {entry returnLabel : Label}
    {body : ConcreteYul.Stmt} {cfg : CfgCodegen}
    {tailDepth : Nat}
    (hCompile :
      compileFunctionBodyWithReturnFrom fuel layout returns entry
        returnLabel body = some cfg)
    (hBodyChecked :
      ∀ {openCfg},
        compileCfgStmtOpenRecAutoFrom fuel layout
            (functionReturnDest returnLabel) entry returnLabel body =
          some openCfg ->
        Program.DepthChecked depthOf openCfg.program)
    (hReturnLabel :
      ∀ {openCfg},
        compileCfgStmtOpenRecAutoFrom fuel layout
            (functionReturnDest returnLabel) entry returnLabel body =
          some openCfg ->
        depthOf returnLabel =
          some (openCfg.outLayout.slots.length + tailDepth)) :
    Program.DepthChecked depthOf cfg.program := by
  simp [compileFunctionBodyWithReturnFrom] at hCompile
  cases hOpen :
      compileCfgStmtOpenRecAutoFrom fuel layout
        (functionReturnDest returnLabel) entry returnLabel body with
  | none =>
      simp [hOpen] at hCompile
  | some openCfg =>
      cases hReturnCode :
          compileReturnValuesFrom openCfg.outLayout returns with
      | none =>
          simp [hOpen, hReturnCode] at hCompile
      | some returnCode =>
          cases hFresh : lookupBlock? openCfg.program returnLabel with
          | some existing =>
              simp [hOpen, hReturnCode, hFresh] at hCompile
          | none =>
              simp [hOpen, hReturnCode, hFresh] at hCompile
              cases hCompile
              exact
                functionBodyWithReturnProgram_depthChecked
                  (depthOf := depthOf) (bodyProgram := openCfg.program)
                  (returnLabel := returnLabel) (returnCode := returnCode)
                  (layout := openCfg.outLayout) (returns := returns)
                  (tailDepth := tailDepth)
                  (hBodyChecked hOpen) (hReturnLabel hOpen)
                  hReturnCode

theorem compileFunctionDefFrom_programDepthChecked
    {depthOf : DepthEnv} {fuel entry returnLabel : Nat}
    {fn : ConcreteYul.FunctionDef} {compiled : CompiledFunction}
    {tailDepth : Nat}
    (hCompile :
      compileFunctionDefFrom fuel entry returnLabel fn = some compiled)
    (hBodyChecked :
      ∀ {entryLayout openCfg},
        functionEntryLayout? fn.params fn.returns = some entryLayout ->
        compileCfgStmtOpenRecAutoFrom fuel entryLayout
            (functionReturnDest returnLabel) entry returnLabel fn.body =
          some openCfg ->
        Program.DepthChecked depthOf openCfg.program)
    (hReturnLabel :
      ∀ {entryLayout openCfg},
        functionEntryLayout? fn.params fn.returns = some entryLayout ->
        compileCfgStmtOpenRecAutoFrom fuel entryLayout
            (functionReturnDest returnLabel) entry returnLabel fn.body =
          some openCfg ->
        depthOf returnLabel =
          some (openCfg.outLayout.slots.length + tailDepth)) :
    Program.DepthChecked depthOf compiled.program := by
  simp [compileFunctionDefFrom] at hCompile
  cases hEntry : functionEntryLayout? fn.params fn.returns with
  | none =>
      simp [hEntry] at hCompile
  | some entryLayout =>
      cases hBody :
          compileFunctionBodyWithReturnFrom fuel entryLayout fn.returns
            entry returnLabel fn.body with
      | none =>
          simp [hEntry, hBody] at hCompile
      | some bodyCfg =>
          simp [hEntry, hBody] at hCompile
          cases hCompile
          exact
            compileFunctionBodyWithReturnFrom_programDepthChecked
              (depthOf := depthOf) (fuel := fuel)
              (layout := entryLayout) (returns := fn.returns)
              (entry := entry) (returnLabel := returnLabel)
              (body := fn.body) (cfg := bodyCfg)
              (tailDepth := tailDepth) hBody
              (fun hOpen => hBodyChecked hEntry hOpen)
              (fun hOpen => hReturnLabel hEntry hOpen)

abbrev CompiledFunctionEnv := List (ConcreteYul.Name × CompiledFunction)

def lookupCompiledFunction? : CompiledFunctionEnv -> ConcreteYul.Name ->
    Option CompiledFunction
  | [], _ => none
  | (candidate, fn) :: rest, name =>
      if candidate = name then some fn else lookupCompiledFunction? rest name

def CompiledFunctionEnv.DepthChecked
    (depthOf : ConcreteYul.Name -> DepthEnv)
    (compiledFns : CompiledFunctionEnv) : Prop :=
  ∀ {name compiled},
    lookupCompiledFunction? compiledFns name = some compiled ->
      Program.DepthChecked (depthOf name) compiled.program

theorem CompiledFunctionEnv.DepthChecked.nil
    {depthOf : ConcreteYul.Name -> DepthEnv} :
    CompiledFunctionEnv.DepthChecked depthOf [] := by
  intro name compiled hLookup
  simp [lookupCompiledFunction?] at hLookup

theorem CompiledFunctionEnv.DepthChecked.cons
    {depthOf : ConcreteYul.Name -> DepthEnv}
    {name : ConcreteYul.Name} {compiled : CompiledFunction}
    {rest : CompiledFunctionEnv}
    (hHead : Program.DepthChecked (depthOf name) compiled.program)
    (hRest : CompiledFunctionEnv.DepthChecked depthOf rest) :
    CompiledFunctionEnv.DepthChecked depthOf ((name, compiled) :: rest) := by
  intro query found hLookup
  change
    (if name = query then some compiled
      else lookupCompiledFunction? rest query) =
      some found at hLookup
  by_cases hName : name = query
  · subst query
    simp at hLookup
    cases hLookup
    exact hHead
  · simp [hName] at hLookup
    exact hRest hLookup

def CompiledFunctionMatches (compileFuel : Nat)
    (fn : ConcreteYul.FunctionDef) (compiled : CompiledFunction) : Prop :=
  compileFunctionDefFrom compileFuel compiled.entry compiled.returnLabel fn =
    some compiled

def CompiledFunctionMatchesCtxSameLayout (compileFuel : Nat)
    (fn : ConcreteYul.FunctionDef) (compiled : CompiledFunction) : Prop :=
  compileFunctionDefCtxSameLayoutFrom compileFuel compiled.entry
    compiled.returnLabel fn =
    some compiled

def CompiledFunctionEnvCovers (compileFuel : Nat)
    (sourceFns : ConcreteYul.FunctionEnv)
    (compiledFns : CompiledFunctionEnv) : Prop :=
  ∀ {name fn},
    ConcreteYul.lookupFunction? sourceFns name = some fn ->
      ∃ compiled,
        lookupCompiledFunction? compiledFns name = some compiled ∧
          CompiledFunctionMatches compileFuel fn compiled

def CompiledFunctionEnvCoversCtxSameLayout (compileFuel : Nat)
    (sourceFns : ConcreteYul.FunctionEnv)
    (compiledFns : CompiledFunctionEnv) : Prop :=
  ∀ {name fn},
    ConcreteYul.lookupFunction? sourceFns name = some fn ->
      ∃ compiled,
        lookupCompiledFunction? compiledFns name = some compiled ∧
          CompiledFunctionMatchesCtxSameLayout compileFuel fn compiled

def functionLabelStride (fuel : Nat) : Nat :=
  fuel + 3

def compileFunctionEnvFrom (fuel start : Nat) :
    ConcreteYul.FunctionEnv -> Option CompiledFunctionEnv
  | [] => some []
  | (name, fn) :: rest =>
      match
        compileFunctionDefFrom fuel start (start + fuel + 2) fn,
        compileFunctionEnvFrom fuel (start + functionLabelStride fuel) rest with
      | some compiled, some compiledRest =>
          some ((name, compiled) :: compiledRest)
      | _, _ => none

def compileFunctionEnvCtxSameLayoutFrom (fuel start : Nat) :
    ConcreteYul.FunctionEnv -> Option CompiledFunctionEnv
  | [] => some []
  | (name, fn) :: rest =>
      match
        compileFunctionDefCtxSameLayoutFrom fuel start (start + fuel + 2)
          fn,
        compileFunctionEnvCtxSameLayoutFrom fuel
          (start + functionLabelStride fuel) rest with
      | some compiled, some compiledRest =>
          some ((name, compiled) :: compiledRest)
      | _, _ => none

theorem compileFunctionEnvFrom_depthChecked
    {depthOf : ConcreteYul.Name -> DepthEnv}
    {fuel start : Nat} {sourceFns : ConcreteYul.FunctionEnv}
    {compiledFns : CompiledFunctionEnv}
    (hCompile :
      compileFunctionEnvFrom fuel start sourceFns = some compiledFns)
    (hFunction :
      ∀ {name fn entry returnLabel compiled},
        compileFunctionDefFrom fuel entry returnLabel fn = some compiled ->
          Program.DepthChecked (depthOf name) compiled.program) :
    CompiledFunctionEnv.DepthChecked depthOf compiledFns := by
  induction sourceFns generalizing start compiledFns with
  | nil =>
      simp [compileFunctionEnvFrom] at hCompile
      cases hCompile
      exact CompiledFunctionEnv.DepthChecked.nil
  | cons entry rest ih =>
      cases entry with
      | mk name fn =>
          simp [compileFunctionEnvFrom] at hCompile
          cases hHead :
              compileFunctionDefFrom fuel start (start + fuel + 2) fn with
          | none =>
              simp [hHead] at hCompile
          | some compiled =>
              cases hRest :
                  compileFunctionEnvFrom fuel
                    (start + functionLabelStride fuel) rest with
              | none =>
                  simp [hHead, hRest] at hCompile
              | some compiledRest =>
                  simp [hHead, hRest] at hCompile
                  cases hCompile
                  exact
                    CompiledFunctionEnv.DepthChecked.cons
                      (hFunction (name := name) hHead)
                      (ih
                        (start := start + functionLabelStride fuel)
                        (compiledFns := compiledRest)
                        hRest)

def compiledFunctionInitialSource? (ctx : CallContext)
    (compiled : CompiledFunction) (args : List Word)
    (state : ConcreteYul.State) : Option ConcreteYul.Config :=
  match
      ConcreteYul.initFunctionEnv compiled.params args
        compiled.returns with
  | some env =>
      some { env := env, state := state, object := ctx.object }
  | none => none

def compiledFunctionInitialTarget? (ctx : CallContext)
    (compiled : CompiledFunction) (args : List Word)
    (state : ConcreteYul.State) : Option TargetState :=
  match compiledFunctionInitialSource? ctx compiled args state with
  | some source =>
      some
        { stack := frameOf compiled.entryLayout source.env
          state := state }
  | none => none

def takeWordPrefix : Nat -> Stack -> Option (List Word × Stack)
  | 0, stack => some ([], stack)
  | count + 1, Atom.word value :: rest =>
      match takeWordPrefix count rest with
      | some (values, stack) => some (norm value :: values, stack)
      | none => none
  | _ + 1, _ => none

theorem takeWordPrefix_word_atoms (values : List Word) (tail : Stack) :
    takeWordPrefix values.length
        (values.map (fun value => Atom.word (norm value)) ++ tail) =
      some (values.map norm, tail) := by
  induction values with
  | nil =>
      rfl
  | cons value rest ih =>
      simp [takeWordPrefix, ih, ConcreteYul.norm_norm]

def extractFunctionResult? (compiled : CompiledFunction)
    (target : TargetState) : Option (List Word × ConcreteYul.State) :=
  match takeWordPrefix compiled.returns.length target.stack with
  | some (values, _) => some (values, target.state)
  | none => none

def FunctionRunWithCalls (ctx : CallContext)
    (compiledFns : CompiledFunctionEnv) (callSem : CallSem)
    (callFuel : Nat) (fnName : ConcreteYul.Name)
    (args : List Word) (state : ConcreteYul.State)
    (returnValues : List Word) (resultState : ConcreteYul.State) : Prop :=
  ∃ compiled source target₀ target₁,
    lookupCompiledFunction? compiledFns fnName = some compiled ∧
      compiledFunctionInitialSource? ctx compiled args state = some source ∧
      compiledFunctionInitialTarget? ctx compiled args state =
        some target₀ ∧
      ReachesWithCalls callSem callFuel compiled.program
        (Config.at compiled.entry target₀) (Config.halted target₁) ∧
      extractFunctionResult? compiled target₁ =
        some (returnValues.map norm, resultState)

def CompiledCallSemRealizesBelow (hash : ConcreteYul.HashOracle)
    (sourceFns : ConcreteYul.FunctionEnv)
    (compiledFns : CompiledFunctionEnv) (callSem : CallSem)
    (fuel : Nat) : Prop :=
  ∀ {m callFuel fnName args callerConfig returnValues resultConfig fn
      callEnv tail target},
    m < fuel ->
    callerConfig.state.halt? = none ->
    ConcreteYul.lookupFunction? sourceFns fnName = some fn ->
    ConcreteYul.initFunctionEnv fn.params args fn.returns = some callEnv ->
    ConcreteYul.evalFunctionFuel hash sourceFns m fnName args callerConfig =
      some (returnValues, resultConfig) ->
    (∀ compiled,
      lookupCompiledFunction? compiledFns fnName = some compiled ->
        StackRel compiled.entryLayout
          ({ callerConfig with env := callEnv } : ConcreteYul.Config) []
          tail target) ->
    callSem m fnName (args.map norm) callerConfig.state =
      some (returnValues, resultConfig.state) ∧
    ∃ compiled bodyResult target',
      lookupCompiledFunction? compiledFns fnName = some compiled ∧
        ConcreteYul.evalProgramStmtFuel hash sourceFns (m - 1)
          ({ callerConfig with env := callEnv } : ConcreteYul.Config)
          fn.body =
          some bodyResult ∧
        (bodyResult.flow = ConcreteYul.Flow.normal ∨
          bodyResult.flow = ConcreteYul.Flow.left) ∧
        ConcreteYul.valuesForNames? bodyResult.config.env fn.returns =
          some returnValues ∧
        { bodyResult.config with env := callerConfig.env } =
          resultConfig ∧
        ReachesWithCalls callSem callFuel compiled.program
          (Config.at compiled.entry target) (Config.halted target') ∧
        StackRel compiled.outLayout bodyResult.config
          (returnValues.map (fun value => Atom.word (norm value))) tail
          target'

def CompiledCallSemRealizesRunsBelow (hash : ConcreteYul.HashOracle)
    (sourceFns : ConcreteYul.FunctionEnv)
    (compiledFns : CompiledFunctionEnv) (callSem : CallSem)
    (fuel : Nat) : Prop :=
  ∀ {m callFuel fnName args callerConfig returnValues resultConfig fn
      callEnv},
    m < fuel ->
    callerConfig.state.halt? = none ->
    ConcreteYul.lookupFunction? sourceFns fnName = some fn ->
    ConcreteYul.initFunctionEnv fn.params args fn.returns = some callEnv ->
    ConcreteYul.evalFunctionFuel hash sourceFns m fnName args callerConfig =
      some (returnValues, resultConfig) ->
    callSem m fnName (args.map norm) callerConfig.state =
        some (returnValues, resultConfig.state) ∧
      FunctionRunWithCalls (CallContext.ofConfig callerConfig) compiledFns
        callSem callFuel fnName (args.map norm) callerConfig.state
        returnValues resultConfig.state

