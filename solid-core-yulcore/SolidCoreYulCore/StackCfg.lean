      simp [CompiledFunctionMatches, compileFunctionDefFrom] at hMatches
      cases hEntry : functionEntryLayout? fn.params fn.returns with
      | none =>
          simp [hEntry] at hMatches
      | some entryLayout =>
          simp [hEntry] at hMatches
          cases hBody :
              compileFunctionBodyWithReturnFrom compileFuel entryLayout
                fn.returns entry returnLabel fn.body with
          | none =>
              simp [hBody] at hMatches
          | some bodyCfg =>
              simp [hBody] at hMatches
              cases hMatches
              simp_all

