                                    Config.at afterCall afterTarget := by
                                simp [stepWithCalls, letCallToProgram,
                                  lookupBlock?, hArgExec]
                                exact
                                  execTermWithCalls_call_success hPop
                                    hCallResult hRetLen
                              have hReverseExec :
                                  execList (reverseTopValuesCode names.length)
                                      afterTarget =
                                    some finalTarget := by
                                have hReverse :=
                                  execList_reverseTopValuesCode
                                    (returnValues.map
                                      (fun value =>
                                        Atom.word (norm value)))
                                    (frameOf layout source.env ++ tail)
                                    afterTarget
                                rw [← hRetLen]
                                simpa [afterTarget, finalTarget,
                                  pushReturnWords, List.append_assoc]
                                  using hReverse
                              have hStoreStep :
                                  stepWithCalls callSem evalFuel
                                      (letCallToProgram entry afterCall exit
                                        argCode fnName args.length
                                        names.length)
                                      (Config.at afterCall afterTarget) =
                                    Config.at exit finalTarget := by
                                simp [stepWithCalls, letCallToProgram,
                                  lookupBlock?, hEntryAfter, hReverseExec,
                                  execTermWithCalls, execTerm]
                              have hFrame :
                                  frameOf outLayout declaredEnv =
                                    (returnValues.map
                                      (fun value =>
                                        Atom.word (norm value))).reverse ++
                                      frameOf layout source.env := by
                                have hFrameSource :
                                    frameOf outLayout declaredEnv =
                                      (returnValues.reverse.map
                                        (fun value =>
                                          Atom.word (norm value))) ++
                                        frameOf layout funConfig.env :=
                                  frameOf_extendLayoutMany?_declareMany
                                    hExtend hDecl
                                simpa [hFunEnv, List.map_reverse]
                                  using hFrameSource
                              have hFinalRel :
                                  StackRel outLayout
                                    { funConfig with env := declaredEnv } []
                                    tail finalTarget := by
                                exact
                                  { state_eq := by
                                      simp [finalTarget, afterTarget]
                                    stack_eq := by
                                      simp [finalTarget, hFrame,
                                        List.append_assoc]
                                    bound :=
                                      extendLayoutMany?_bound_declaredMany
                                        (by
                                          intro name index hIndex
                                          rw [hFunEnv]
                                          exact hArgRel.bound hIndex)
                                        hExtend hDecl }
                              refine ⟨finalTarget, ?_, ?_, rfl⟩
                              · exact
                                  ReachesWithCalls.step hCallStep
                                    (reachesWithCalls_one hStoreStep)
                              · simpa using hFinalRel

