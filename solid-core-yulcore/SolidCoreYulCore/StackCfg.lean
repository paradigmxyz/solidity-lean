theorem compileIfThenOpenFrom_programDepthChecked
    {depthOf : DepthEnv} {fuel : Nat} {layout : Layout}
    {dest : ControlDest} {entry thenLabel exit : Label}
    {cond : ConcreteYul.Expr} {body : ConcreteYul.Stmt}
    {cfg : CfgCodegen} {tailDepth : Nat}
    (hCompile :
