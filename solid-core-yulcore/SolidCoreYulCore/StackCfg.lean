              refine
                Reaches.step
                  (next := Config.at testLabel discrTarget) ?_ ?_
              · simp [step, switchTwoDefaultToProgram, lookupBlock?,
                  hDiscrExec, execTerm, hDiscrRel.stack_eq,
                  hFirstBranchNo]
              · refine
                  Reaches.step
                    (next := Config.at defaultLabel discrTarget) ?_ ?_
                · simp [step, switchTwoDefaultToProgram, lookupBlock?,
                    hEntryTest, hFirstTest, execList, execTerm,
