                            cases hPostEval :
                                ConcreteYul.evalStmtFuel hash evalFuel
                                  bodyConfig post with
                            | none =>
                                rfl
                            | some postResult =>
                                cases postResult with
                                | mk postFlow postConfig =>
                                    cases postFlow with
                                    | normal =>
                                        simp
                                        exact ih
                                    | broke =>
                                        simp
                                    | continued =>
                                        simp
                                        exact ih
                                    | left =>
                                        simp
                                    | halted =>
                                        simp
                        | left =>
