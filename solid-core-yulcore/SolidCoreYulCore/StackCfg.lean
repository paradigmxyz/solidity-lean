                                  | some restoredEnv =>
                                      simp [hRestoreOuter] at hRestore
                                      cases hRestore
                                      simpa [frameOf] using
                                        frameOfSlots_restoreOuter hLayout
                                          hRel.bound hRestoreOuter
                                have hRestoreBound :
                                    layout.Bound restoredConfig.env := by
                                  unfold ConcreteYul.restoreBlockConfig at hRestore
                                  cases hRestoreOuter :
                                      ConcreteYul.restoreOuter source.env
                                        bodyConfig.env with
                                  | none =>
                                      simp [hRestoreOuter] at hRestore
                                  | some restoredEnv =>
                                      simp [hRestoreOuter] at hRestore
                                      cases hRestore
                                      exact
                                        slotsBound_restoreOuter hRel.bound
                                          hRestoreOuter
                                refine
                                  ⟨poppedTarget, ?_, ?_, rfl, ?_,
                                    hLayout⟩
                                · rw [execList_append]
                                  simp [hBodyExec, hPop]
                                · exact
                                    { state_eq := by
                                        rw [
                                          ConcreteYul.restoreBlockConfig_preserves_state
                                            hRestore]
                                        exact hBodyRel.state_eq
                                      stack_eq := by
                                        simp [poppedTarget, hFrameRestore]
                                      bound := hRestoreBound }
                                · rw [
                                    ConcreteYul.restoreBlockConfig_preserves_state
                                      hRestore]
                                  exact hBodyNoHalt
        | skip =>
            exact
              compileStmtFrom_execList_correct hLayout hCompile hEval
                hNoHalt hRel
        | expr expr =>
            exact
              compileStmtFrom_execList_correct hLayout hCompile hEval
                hNoHalt hRel
        | let1 name init =>
            exact
              compileStmtFrom_execList_correct hLayout hCompile hEval
                hNoHalt hRel
        | letMany names init =>
            exact
              compileStmtFrom_execList_correct hLayout hCompile hEval
                hNoHalt hRel
        | funDef name params returns body =>
