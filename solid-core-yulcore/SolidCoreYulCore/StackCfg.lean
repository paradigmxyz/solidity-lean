      some (layout.slots.length + tailDepth) := by
  have hPopLe :
      loopLayout.slots.length - layout.slots.length ≤
        loopLayout.slots.length + tailDepth := by
    omega
  have hPopBase :=
    codeDepthAfter?_popN
      (count := loopLayout.slots.length - layout.slots.length)
      (depth := loopLayout.slots.length + tailDepth)
      hPopLe
  have hPopSub :
      (loopLayout.slots.length + tailDepth) -
          (loopLayout.slots.length - layout.slots.length) =
        layout.slots.length + tailDepth := by
    omega
  have hPop :
      codeDepthAfter? (popN
          (loopLayout.slots.length - layout.slots.length))
          (loopLayout.slots.length + tailDepth) =
        some (layout.slots.length + tailDepth) := by
    simpa [hPopSub] using hPopBase
  exact blockDepthAfterWithTargets?_jump_of_codeDepthAfter hPop hExit

