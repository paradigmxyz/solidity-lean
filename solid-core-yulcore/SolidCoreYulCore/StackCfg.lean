              exact hLabelDefault h.symm
            simp [switchTwoDefaultToProgram, lookupBlock?, hEntryLabel,
              hFirstLabel, hTestLabel, hSecondLabel, hDefaultLabel] at hLookup

theorem switchTailTestBlocksFrom_head_lookup
    (testLabel caseLabel fallbackLabel : Label)
    (caseCode : SwitchCaseCode) (restCases : List SwitchCaseCode) :
    lookupBlock?
        (switchTailTestBlocksFrom testLabel caseLabel fallbackLabel
          (caseCode :: restCases))
        testLabel =
      some
        ({ body := []
           term :=
            Term.branchEq caseCode.value caseLabel
              (match restCases with
               | [] => fallbackLabel
               | _ :: _ => testLabel + 1) } : Block) := by
  simp [switchTailTestBlocksFrom, lookupBlock?]

theorem switchTailTestBlocksFrom_head_match_step
    {testLabel caseLabel fallbackLabel : Label}
    {caseCode : SwitchCaseCode} {restCases : List SwitchCaseCode}
    {target : TargetState} {discrValue : Word} {stackRest : Stack}
    (hStack : target.stack = Atom.word discrValue :: stackRest)
    (hMatch : norm discrValue = norm caseCode.value) :
    step
        (switchTailTestBlocksFrom testLabel caseLabel fallbackLabel
          (caseCode :: restCases))
        (Config.at testLabel target) =
      Config.at caseLabel target := by
  simp [step, switchTailTestBlocksFrom_head_lookup, execList, execTerm,
    hStack, hMatch]

theorem switchTailTestBlocksFrom_head_miss_step
    {testLabel caseLabel fallbackLabel : Label}
    {caseCode : SwitchCaseCode} {restCases : List SwitchCaseCode}
    {target : TargetState} {discrValue : Word} {stackRest : Stack}
    (hStack : target.stack = Atom.word discrValue :: stackRest)
    (hMiss : norm discrValue ≠ norm caseCode.value) :
    step
        (switchTailTestBlocksFrom testLabel caseLabel fallbackLabel
          (caseCode :: restCases))
        (Config.at testLabel target) =
      Config.at
        (match restCases with
         | [] => fallbackLabel
         | _ :: _ => testLabel + 1)
        target := by
  simp [step, switchTailTestBlocksFrom_head_lookup, execList, execTerm,
    hStack, hMiss]

def switchCaseCodesMiss (discrValue : Word) :
    List SwitchCaseCode -> Prop
  | [] => True
  | caseCode :: rest =>
      norm discrValue ≠ norm caseCode.value ∧
        switchCaseCodesMiss discrValue rest

inductive SwitchCaseCodesExec
    (discrValue : Word) (discrTarget : TargetState)
    (stackRest : Stack) : List SwitchCaseCode -> TargetState -> Prop where
  | head {caseCode : SwitchCaseCode} {restCases : List SwitchCaseCode}
      {caseTarget : TargetState} :
      norm discrValue = norm caseCode.value ->
      execList caseCode.code { discrTarget with stack := stackRest } =
        some caseTarget ->
      SwitchCaseCodesExec discrValue discrTarget stackRest
        (caseCode :: restCases) caseTarget
  | tail {caseCode nextCase : SwitchCaseCode}
      {restCases : List SwitchCaseCode} {caseTarget : TargetState} :
      norm discrValue ≠ norm caseCode.value ->
      SwitchCaseCodesExec discrValue discrTarget stackRest
        (nextCase :: restCases) caseTarget ->
      SwitchCaseCodesExec discrValue discrTarget stackRest
        (caseCode :: nextCase :: restCases) caseTarget

theorem compileSwitchCasesFrom_target_none_misses
    {fuel : Nat} {layout : Layout}
    {cases : List (Word × ConcreteYul.Stmt)}
    {caseCodes : List SwitchCaseCode} {discrValue : Word}
    (hCompile : compileSwitchCasesFrom fuel layout cases = some caseCodes)
    (hTarget :
      ConcreteYul.switchTarget? discrValue cases none = none) :
    switchCaseCodesMiss discrValue caseCodes := by
  induction cases generalizing caseCodes with
  | nil =>
      simp [compileSwitchCasesFrom] at hCompile
      cases hCompile
      trivial
  | cons entry rest ih =>
      cases entry with
      | mk value stmt =>
          rcases compileSwitchCasesFrom_cons hCompile with
            ⟨gen, restCodes, hStmt, hOut, hRestCompile, hCaseCodes⟩
          subst caseCodes
          by_cases hMatch : norm value = norm discrValue
          · simp [ConcreteYul.switchTarget?, hMatch] at hTarget
          · have hMiss : norm discrValue ≠ norm value := by
              intro h
              exact hMatch h.symm
            have hRestTarget :
                ConcreteYul.switchTarget? discrValue rest none = none := by
              simpa [ConcreteYul.switchTarget?, hMatch] using hTarget
            exact ⟨hMiss, ih hRestCompile hRestTarget⟩

theorem switchTailTestBlocksFrom_tail_extends
    (testLabel caseLabel fallbackLabel : Label)
    (caseCode : SwitchCaseCode) (restCases : List SwitchCaseCode) :
    Program.Extends
      (switchTailTestBlocksFrom (testLabel + 1) (caseLabel + 1)
        fallbackLabel restCases)
      (switchTailTestBlocksFrom testLabel caseLabel fallbackLabel
        (caseCode :: restCases)) := by
  intro label block hLookup
  have hBefore :
      lookupBlock?
          (switchTailTestBlocksFrom (testLabel + 1) (caseLabel + 1)
            fallbackLabel restCases)
          testLabel =
        none :=
    lookupBlock?_switchTailTestBlocksFrom_none_before
      (label := testLabel) (testLabel := testLabel + 1)
      (caseLabel := caseLabel + 1) (fallbackLabel := fallbackLabel)
      (cases := restCases) (Nat.lt_succ_self testLabel)
  by_cases hLabel : testLabel = label
  · subst label
    simp [hBefore] at hLookup
  · simpa [switchTailTestBlocksFrom, lookupBlock?, hLabel] using hLookup

theorem switchTailTestBlocksFrom_all_miss_extends_reaches
    {program : Program}
    {testLabel caseLabel fallbackLabel : Label}
    {caseCode : SwitchCaseCode} {restCases : List SwitchCaseCode}
    {target : TargetState} {discrValue : Word} {stackRest : Stack}
    (hExtends :
      Program.Extends
        (switchTailTestBlocksFrom testLabel caseLabel fallbackLabel
          (caseCode :: restCases))
        program)
    (hStack : target.stack = Atom.word discrValue :: stackRest)
    (hMisses : switchCaseCodesMiss discrValue (caseCode :: restCases)) :
    Reaches program (Config.at testLabel target)
      (Config.at fallbackLabel target) := by
  induction restCases generalizing testLabel caseLabel caseCode with
  | nil =>
      rcases hMisses with ⟨hMiss, _hRestMisses⟩
      have hLookup :
          lookupBlock?
              (switchTailTestBlocksFrom testLabel caseLabel fallbackLabel
                [caseCode])
              testLabel =
            some
              ({ body := []
                 term := Term.branchEq caseCode.value caseLabel
                   fallbackLabel } : Block) :=
        switchTailTestBlocksFrom_head_lookup testLabel caseLabel
          fallbackLabel caseCode []
      have hBaseStep :
          step
              (switchTailTestBlocksFrom testLabel caseLabel fallbackLabel
                [caseCode])
              (Config.at testLabel target) =
            Config.at fallbackLabel target :=
        switchTailTestBlocksFrom_head_miss_step
          (testLabel := testLabel) (caseLabel := caseLabel)
          (fallbackLabel := fallbackLabel) (caseCode := caseCode)
          (restCases := []) hStack hMiss
      have hStep :
          step program (Config.at testLabel target) =
            Config.at fallbackLabel target := by
        rw [step_of_extends_at hExtends hLookup]
        exact hBaseStep
      exact reaches_one hStep
  | cons nextCase rest ih =>
      rcases hMisses with ⟨hMiss, hRestMisses⟩
      have hLookup :
          lookupBlock?
              (switchTailTestBlocksFrom testLabel caseLabel fallbackLabel
                (caseCode :: nextCase :: rest))
              testLabel =
            some
              ({ body := []
                 term := Term.branchEq caseCode.value caseLabel
                   (testLabel + 1) } : Block) :=
        switchTailTestBlocksFrom_head_lookup testLabel caseLabel
          fallbackLabel caseCode (nextCase :: rest)
      have hBaseStep :
          step
              (switchTailTestBlocksFrom testLabel caseLabel fallbackLabel
                (caseCode :: nextCase :: rest))
              (Config.at testLabel target) =
            Config.at (testLabel + 1) target :=
        switchTailTestBlocksFrom_head_miss_step
          (testLabel := testLabel) (caseLabel := caseLabel)
          (fallbackLabel := fallbackLabel) (caseCode := caseCode)
          (restCases := nextCase :: rest) hStack hMiss
      have hStep :
          step program (Config.at testLabel target) =
            Config.at (testLabel + 1) target := by
        rw [step_of_extends_at hExtends hLookup]
        exact hBaseStep
      have hTailExtendsHead :
          Program.Extends
            (switchTailTestBlocksFrom (testLabel + 1) (caseLabel + 1)
              fallbackLabel (nextCase :: rest))
            (switchTailTestBlocksFrom testLabel caseLabel fallbackLabel
              (caseCode :: nextCase :: rest)) :=
        switchTailTestBlocksFrom_tail_extends testLabel caseLabel
          fallbackLabel caseCode (nextCase :: rest)
      have hTailExtendsProgram :
          Program.Extends
            (switchTailTestBlocksFrom (testLabel + 1) (caseLabel + 1)
              fallbackLabel (nextCase :: rest))
            program :=
        Program.extends_trans hTailExtendsHead hExtends
      refine Reaches.step hStep ?_
      exact
        ih (testLabel := testLabel + 1) (caseLabel := caseLabel + 1)
          (caseCode := nextCase) hTailExtendsProgram hRestMisses

theorem switchTailTestBlocksFrom_selected_extends_reaches
    {program : Program}
    {testLabel caseLabel fallbackLabel joinLabel : Label}
    {cases : List SwitchCaseCode}
    {discrTarget caseTarget : TargetState}
    {discrValue : Word} {stackRest : Stack}
    (hTestExtends :
      Program.Extends
        (switchTailTestBlocksFrom testLabel caseLabel fallbackLabel
          cases)
        program)
    (hCaseExtends :
      Program.Extends
        (switchCaseBlocksFrom caseLabel joinLabel cases)
        program)
    (hStack : discrTarget.stack = Atom.word discrValue :: stackRest)
    (hSelected :
      SwitchCaseCodesExec discrValue discrTarget stackRest
        cases caseTarget) :
    Reaches program (Config.at testLabel discrTarget)
      (Config.at joinLabel caseTarget) := by
  induction cases generalizing testLabel caseLabel with
  | nil =>
      cases hSelected
  | cons caseCode rest ih =>
      cases rest with
      | nil =>
          cases hSelected with
          | head hMatch hCaseExec =>
              have hTestLookup :=
                switchTailTestBlocksFrom_head_lookup testLabel caseLabel
                  fallbackLabel caseCode []
              have hTestStep :
                  step
                      (switchTailTestBlocksFrom testLabel caseLabel
                        fallbackLabel [caseCode])
                      (Config.at testLabel discrTarget) =
                    Config.at caseLabel discrTarget :=
                switchTailTestBlocksFrom_head_match_step
                  (testLabel := testLabel) (caseLabel := caseLabel)
                  (fallbackLabel := fallbackLabel) (caseCode := caseCode)
                  (restCases := []) hStack hMatch
              have hCaseLookup :=
                switchCaseBlocksFrom_head_lookup caseLabel joinLabel
                  caseCode []
              have hCaseStep :
                  step
                      (switchCaseBlocksFrom caseLabel joinLabel [caseCode])
                      (Config.at caseLabel discrTarget) =
                    Config.at joinLabel caseTarget :=
                switchCaseBlocksFrom_head_step
                  (caseLabel := caseLabel) (joinLabel := joinLabel)
                  (caseCode := caseCode) (restCases := [])
                  hStack hCaseExec
              refine
                Reaches.step (next := Config.at caseLabel discrTarget)
                  ?_ ?_
              · rw [step_of_extends_at hTestExtends hTestLookup]
                exact hTestStep
              · exact
                  reaches_one_of_extends_at hCaseExtends hCaseLookup
                    hCaseStep
      | cons nextCase restCases =>
          cases hSelected with
          | head hMatch hCaseExec =>
              have hTestLookup :=
                switchTailTestBlocksFrom_head_lookup testLabel caseLabel
                  fallbackLabel caseCode (nextCase :: restCases)
              have hTestStep :
                  step
                      (switchTailTestBlocksFrom testLabel caseLabel
                        fallbackLabel
                        (caseCode :: nextCase :: restCases))
                      (Config.at testLabel discrTarget) =
                    Config.at caseLabel discrTarget :=
                switchTailTestBlocksFrom_head_match_step
                  (testLabel := testLabel) (caseLabel := caseLabel)
                  (fallbackLabel := fallbackLabel) (caseCode := caseCode)
                  (restCases := nextCase :: restCases) hStack hMatch
              have hCaseLookup :=
                switchCaseBlocksFrom_head_lookup caseLabel joinLabel
                  caseCode (nextCase :: restCases)
              have hCaseStep :
                  step
                      (switchCaseBlocksFrom caseLabel joinLabel
                        (caseCode :: nextCase :: restCases))
                      (Config.at caseLabel discrTarget) =
                    Config.at joinLabel caseTarget :=
                switchCaseBlocksFrom_head_step
                  (caseLabel := caseLabel) (joinLabel := joinLabel)
                  (caseCode := caseCode)
                  (restCases := nextCase :: restCases)
                  hStack hCaseExec
              refine
                Reaches.step (next := Config.at caseLabel discrTarget)
                  ?_ ?_
              · rw [step_of_extends_at hTestExtends hTestLookup]
                exact hTestStep
              · exact
                  reaches_one_of_extends_at hCaseExtends hCaseLookup
                    hCaseStep
          | tail hMiss hRestSelected =>
              have hTestLookup :=
                switchTailTestBlocksFrom_head_lookup testLabel caseLabel
                  fallbackLabel caseCode (nextCase :: restCases)
              have hTestStep :
                  step
                      (switchTailTestBlocksFrom testLabel caseLabel
                        fallbackLabel
                        (caseCode :: nextCase :: restCases))
                      (Config.at testLabel discrTarget) =
                    Config.at (testLabel + 1) discrTarget :=
                switchTailTestBlocksFrom_head_miss_step
                  (testLabel := testLabel) (caseLabel := caseLabel)
                  (fallbackLabel := fallbackLabel) (caseCode := caseCode)
                  (restCases := nextCase :: restCases) hStack hMiss
              have hTailTestExtendsHead :
                  Program.Extends
                    (switchTailTestBlocksFrom (testLabel + 1)
                      (caseLabel + 1) fallbackLabel
                      (nextCase :: restCases))
                    (switchTailTestBlocksFrom testLabel caseLabel
                      fallbackLabel
                      (caseCode :: nextCase :: restCases)) :=
                switchTailTestBlocksFrom_tail_extends testLabel caseLabel
                  fallbackLabel caseCode (nextCase :: restCases)
              have hTailTestExtendsProgram :
                  Program.Extends
                    (switchTailTestBlocksFrom (testLabel + 1)
                      (caseLabel + 1) fallbackLabel
                      (nextCase :: restCases))
                    program :=
                Program.extends_trans hTailTestExtendsHead hTestExtends
              have hTailCaseExtendsHead :
                  Program.Extends
                    (switchCaseBlocksFrom (caseLabel + 1) joinLabel
                      (nextCase :: restCases))
                    (switchCaseBlocksFrom caseLabel joinLabel
                      (caseCode :: nextCase :: restCases)) :=
                switchCaseBlocksFrom_tail_extends caseLabel joinLabel
                  caseCode (nextCase :: restCases)
              have hTailCaseExtendsProgram :
                  Program.Extends
                    (switchCaseBlocksFrom (caseLabel + 1) joinLabel
                      (nextCase :: restCases))
                    program :=
                Program.extends_trans hTailCaseExtendsHead hCaseExtends
              refine
                Reaches.step
                  (next := Config.at (testLabel + 1) discrTarget)
                  ?_ ?_
              · rw [step_of_extends_at hTestExtends hTestLookup]
                exact hTestStep
              · exact
                  ih (testLabel := testLabel + 1)
                    (caseLabel := caseLabel + 1)
                    hTailTestExtendsProgram hTailCaseExtendsProgram
                    hRestSelected

theorem switchChainAutoToProgram_all_miss_extends_reaches_fallback
    {program : Program}
    {entry caseLabelStart joinLabel : Label}
    {discrCode : List Instr} {cases : List SwitchCaseCode}
    {defaultCode? : Option (List Instr)}
    {target discrTarget : TargetState} {discrValue : Word}
    {stackRest : Stack}
    (hExtends :
      Program.Extends
        (switchChainAutoToProgram entry caseLabelStart joinLabel discrCode
          cases defaultCode?)
        program)
    (hEntryBefore : entry < caseLabelStart)
    (hDiscrExec : execList discrCode target = some discrTarget)
    (hStack : discrTarget.stack = Atom.word discrValue :: stackRest)
    (hMisses : switchCaseCodesMiss discrValue cases) :
    Reaches program (Config.at entry target)
      (Config.at (switchChainFallbackLabel caseLabelStart cases)
        discrTarget) := by
  cases cases with
  | nil =>
      have hEntryLookup :
          lookupBlock?
              (switchChainAutoToProgram entry caseLabelStart joinLabel
                discrCode [] defaultCode?)
              entry =
            some
              ({ body := discrCode
                 term :=
                  switchEntryTerm caseLabelStart
                    (switchChainTestLabelStart caseLabelStart [])
                    (switchChainFallbackLabel caseLabelStart []) [] } :
                Block) := by
        rw [switchChainAutoToProgram]
        exact
          switchChainToProgram_entry_lookup entry caseLabelStart
            (switchChainTestLabelStart caseLabelStart [])
            (switchChainFallbackLabel caseLabelStart []) joinLabel
            discrCode [] defaultCode?
      have hBaseStep :
          step
              (switchChainAutoToProgram entry caseLabelStart joinLabel
                discrCode [] defaultCode?)
              (Config.at entry target) =
            Config.at (switchChainFallbackLabel caseLabelStart [])
              discrTarget := by
        rw [switchChainAutoToProgram]
        exact
          switchChainToProgram_entry_empty_step
            (entry := entry) (caseLabelStart := caseLabelStart)
            (testLabelStart := switchChainTestLabelStart caseLabelStart [])
            (fallbackLabel := switchChainFallbackLabel caseLabelStart [])
            (joinLabel := joinLabel) (discrCode := discrCode)
            (defaultCode? := defaultCode?) hDiscrExec
      have hStep :
          step program (Config.at entry target) =
            Config.at (switchChainFallbackLabel caseLabelStart [])
              discrTarget := by
        rw [step_of_extends_at hExtends hEntryLookup]
        exact hBaseStep
      exact reaches_one hStep
  | cons firstCase restCases =>
      cases restCases with
      | nil =>
          rcases hMisses with ⟨hFirstMiss, _hRestMisses⟩
          have hEntryLookup :
              lookupBlock?
                  (switchChainAutoToProgram entry caseLabelStart joinLabel
                    discrCode [firstCase] defaultCode?)
                  entry =
                some
                  ({ body := discrCode
                     term :=
                      switchEntryTerm caseLabelStart
                        (switchChainTestLabelStart caseLabelStart
                          [firstCase])
                        (switchChainFallbackLabel caseLabelStart [firstCase])
                        [firstCase] } : Block) := by
            rw [switchChainAutoToProgram]
            exact
              switchChainToProgram_entry_lookup entry caseLabelStart
                (switchChainTestLabelStart caseLabelStart [firstCase])
                (switchChainFallbackLabel caseLabelStart [firstCase])
                joinLabel discrCode [firstCase] defaultCode?
          have hBaseStep :
              step
                  (switchChainAutoToProgram entry caseLabelStart joinLabel
                    discrCode [firstCase] defaultCode?)
                  (Config.at entry target) =
                Config.at (switchChainFallbackLabel caseLabelStart
                  [firstCase]) discrTarget := by
            rw [switchChainAutoToProgram]
            exact
              switchChainToProgram_entry_one_miss_step
                (entry := entry) (caseLabelStart := caseLabelStart)
                (testLabelStart :=
                  switchChainTestLabelStart caseLabelStart [firstCase])
                (fallbackLabel :=
                  switchChainFallbackLabel caseLabelStart [firstCase])
                (joinLabel := joinLabel) (discrCode := discrCode)
                (firstCase := firstCase) (defaultCode? := defaultCode?)
                (target := target) (discrTarget := discrTarget)
                (discrValue := discrValue) (stackRest := stackRest)
                hDiscrExec hStack hFirstMiss
          have hStep :
              step program (Config.at entry target) =
                Config.at (switchChainFallbackLabel caseLabelStart
                  [firstCase]) discrTarget := by
            rw [step_of_extends_at hExtends hEntryLookup]
            exact hBaseStep
          exact reaches_one hStep
      | cons secondCase restCases =>
          rcases hMisses with ⟨hFirstMiss, hRestMisses⟩
          have hEntryLookup :
              lookupBlock?
                  (switchChainAutoToProgram entry caseLabelStart joinLabel
                    discrCode (firstCase :: secondCase :: restCases)
                    defaultCode?)
                  entry =
                some
                  ({ body := discrCode
                     term :=
                      switchEntryTerm caseLabelStart
                        (switchChainTestLabelStart caseLabelStart
                          (firstCase :: secondCase :: restCases))
                        (switchChainFallbackLabel caseLabelStart
                          (firstCase :: secondCase :: restCases))
                        (firstCase :: secondCase :: restCases) } : Block) := by
            rw [switchChainAutoToProgram]
            exact
              switchChainToProgram_entry_lookup entry caseLabelStart
                (switchChainTestLabelStart caseLabelStart
                  (firstCase :: secondCase :: restCases))
                (switchChainFallbackLabel caseLabelStart
                  (firstCase :: secondCase :: restCases))
                joinLabel discrCode (firstCase :: secondCase :: restCases)
                defaultCode?
          have hBaseStep :
              step
                  (switchChainAutoToProgram entry caseLabelStart joinLabel
                    discrCode (firstCase :: secondCase :: restCases)
                    defaultCode?)
                  (Config.at entry target) =
                Config.at
                  (switchChainTestLabelStart caseLabelStart
                    (firstCase :: secondCase :: restCases))
                  discrTarget := by
            rw [switchChainAutoToProgram]
            exact
              switchChainToProgram_entry_many_miss_step
                (entry := entry) (caseLabelStart := caseLabelStart)
                (testLabelStart :=
                  switchChainTestLabelStart caseLabelStart
                    (firstCase :: secondCase :: restCases))
                (fallbackLabel :=
                  switchChainFallbackLabel caseLabelStart
                    (firstCase :: secondCase :: restCases))
                (joinLabel := joinLabel) (discrCode := discrCode)
                (firstCase := firstCase) (secondCase := secondCase)
                (restCases := restCases) (defaultCode? := defaultCode?)
                (target := target) (discrTarget := discrTarget)
                (discrValue := discrValue) (stackRest := stackRest)
                hDiscrExec hStack hFirstMiss
          have hStep :
              step program (Config.at entry target) =
                Config.at
                  (switchChainTestLabelStart caseLabelStart
                    (firstCase :: secondCase :: restCases))
                  discrTarget := by
            rw [step_of_extends_at hExtends hEntryLookup]
            exact hBaseStep
          have hTestBlocksExtendsAuto :
              Program.Extends
                (switchChainTestBlocksFrom
                  (switchChainTestLabelStart caseLabelStart
                    (firstCase :: secondCase :: restCases))
                  caseLabelStart
                  (switchChainFallbackLabel caseLabelStart
                    (firstCase :: secondCase :: restCases))
                  (firstCase :: secondCase :: restCases))
                (switchChainAutoToProgram entry caseLabelStart joinLabel
                  discrCode (firstCase :: secondCase :: restCases)
                  defaultCode?) :=
            switchChainAutoToProgram_testBlocks_extends
              (entry := entry) (caseLabelStart := caseLabelStart)
              (joinLabel := joinLabel) (discrCode := discrCode)
              (cases := firstCase :: secondCase :: restCases)
              (defaultCode? := defaultCode?)
              hEntryBefore
          have hTailExtendsAuto :
              Program.Extends
                (switchTailTestBlocksFrom
                  (switchChainTestLabelStart caseLabelStart
                    (firstCase :: secondCase :: restCases))
                  (caseLabelStart + 1)
                  (switchChainFallbackLabel caseLabelStart
                    (firstCase :: secondCase :: restCases))
                  (secondCase :: restCases))
                (switchChainAutoToProgram entry caseLabelStart joinLabel
                  discrCode (firstCase :: secondCase :: restCases)
                  defaultCode?) := by
            intro label block hLookup
            exact
              hTestBlocksExtendsAuto
                (by simpa [switchChainTestBlocksFrom] using hLookup)
          have hTailExtendsProgram :
              Program.Extends
                (switchTailTestBlocksFrom
                  (switchChainTestLabelStart caseLabelStart
                    (firstCase :: secondCase :: restCases))
                  (caseLabelStart + 1)
                  (switchChainFallbackLabel caseLabelStart
                    (firstCase :: secondCase :: restCases))
                  (secondCase :: restCases))
                program :=
            Program.extends_trans hTailExtendsAuto hExtends
          refine Reaches.step hStep ?_
          exact
            switchTailTestBlocksFrom_all_miss_extends_reaches
              (program := program)
              (testLabel :=
                switchChainTestLabelStart caseLabelStart
                  (firstCase :: secondCase :: restCases))
              (caseLabel := caseLabelStart + 1)
              (fallbackLabel :=
                switchChainFallbackLabel caseLabelStart
                  (firstCase :: secondCase :: restCases))
              (caseCode := secondCase) (restCases := restCases)
              hTailExtendsProgram hStack hRestMisses

theorem switchChainAutoToProgram_selected_extends_reaches
    {program : Program}
    {entry caseLabelStart joinLabel : Label}
    {discrCode : List Instr} {cases : List SwitchCaseCode}
    {defaultCode? : Option (List Instr)}
    {target discrTarget caseTarget : TargetState}
    {discrValue : Word} {stackRest : Stack}
    (hExtends :
      Program.Extends
        (switchChainAutoToProgram entry caseLabelStart joinLabel discrCode
          cases defaultCode?)
        program)
    (hEntryBefore : entry < caseLabelStart)
    (hDiscrExec : execList discrCode target = some discrTarget)
    (hStack : discrTarget.stack = Atom.word discrValue :: stackRest)
    (hSelected :
      SwitchCaseCodesExec discrValue discrTarget stackRest cases
        caseTarget) :
    Reaches program (Config.at entry target)
      (Config.at joinLabel caseTarget) := by
  cases cases with
  | nil =>
      cases hSelected
  | cons caseCode rest =>
      cases rest with
      | nil =>
          cases hSelected with
          | head hMatch hCaseExec =>
              have hEntryLookup :=
                switchChainToProgram_entry_lookup entry caseLabelStart
                  (switchChainTestLabelStart caseLabelStart [caseCode])
                  (switchChainFallbackLabel caseLabelStart [caseCode])
                  joinLabel discrCode [caseCode] defaultCode?
              have hEntryLookupAuto :
                  lookupBlock?
                      (switchChainAutoToProgram entry caseLabelStart
                        joinLabel discrCode [caseCode] defaultCode?)
                      entry =
                    some
                      ({ body := discrCode
                         term :=
                          switchEntryTerm caseLabelStart
                            (switchChainTestLabelStart caseLabelStart
                              [caseCode])
                            (switchChainFallbackLabel caseLabelStart
                              [caseCode])
                            [caseCode] } : Block) := by
                simpa [switchChainAutoToProgram] using hEntryLookup
              have hEntryStep :
                  step
                      (switchChainAutoToProgram entry caseLabelStart
                        joinLabel discrCode [caseCode] defaultCode?)
                      (Config.at entry target) =
                    Config.at caseLabelStart discrTarget := by
                rw [switchChainAutoToProgram]
                exact
                  switchChainToProgram_entry_first_match_step
                    (entry := entry) (caseLabelStart := caseLabelStart)
                    (testLabelStart :=
                      switchChainTestLabelStart caseLabelStart [caseCode])
                    (fallbackLabel :=
                      switchChainFallbackLabel caseLabelStart [caseCode])
                    (joinLabel := joinLabel) (discrCode := discrCode)
                    (firstCase := caseCode) (restCases := [])
                    (defaultCode? := defaultCode?) (target := target)
