        bodyCfg.outLayout = layout ∧
        cfg.program =
          [ (entry,
              { body := condCode
                term := Term.branchNZ thenLabel exit }) ] ++
            bodyCfg.program ∧
        blockDepthAfterWithTargets? depthOf
            { body := condCode
              term := Term.branchNZ thenLabel exit }
            (layout.slots.length + tailDepth) =
          some (layout.slots.length + tailDepth) := by
  simp [compileIfThenOpenFrom] at hCompile
  cases hCond : compileExprAt layout 0 cond with
  | none =>
      simp [hCond] at hCompile
  | some condCode =>
      cases hBody :
          compileCfgStmtOpenFrom fuel layout dest thenLabel exit body with
      | none =>
          simp [hCond, hBody] at hCompile
      | some bodyCfg =>
          by_cases hOut : bodyCfg.outLayout = layout
          · simp [hCond, hBody, hOut] at hCompile
            cases hCompile
            exact
              ⟨condCode, bodyCfg, rfl, rfl, hOut, rfl,
                ifThenEntryBlockDepthAfterWithTargets
                  (depthOf := depthOf) (layout := layout)
                  (cond := cond) (condCode := condCode)
                  (thenLabel := thenLabel) (exit := exit)
                  (tailDepth := tailDepth)
