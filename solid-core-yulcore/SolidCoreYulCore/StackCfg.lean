    ∃ target',
      Reaches cfg.program (Config.at 0 target)
        (Config.halted target') ∧
        StackRel cfg.outLayout result.config [] tail target' ∧
        result.flow = ConcreteYul.Flow.normal := by
  cases stmt with
  | ifThen cond body =>
      exact
        compileIfThenFrom_cfg_correct hLayout hCompile hEval
          hNoHalt hRel
  | switch discr cases defaultBranch =>
      exact
        compileSwitchChainClosedFrom_cfg_correct hLayout hCompile hEval
          hNoHalt hRel
  | skip =>
      exact
        compileLinearCfgStmtFrom_cfg_correct hLayout hCompile hEval
          hNoHalt hRel
  | expr expr =>
      exact
        compileLinearCfgStmtFrom_cfg_correct hLayout hCompile hEval
          hNoHalt hRel
  | let1 name init =>
      exact
        compileLinearCfgStmtFrom_cfg_correct hLayout hCompile hEval
          hNoHalt hRel
  | letMany names init =>
      exact
        compileLinearCfgStmtFrom_cfg_correct hLayout hCompile hEval
          hNoHalt hRel
  | funDef name params returns body =>
      exact
        compileLinearCfgStmtFrom_cfg_correct hLayout hCompile hEval
          hNoHalt hRel
  | assign name expr =>
      exact
        compileLinearCfgStmtFrom_cfg_correct hLayout hCompile hEval
          hNoHalt hRel
  | assignMany names exprs =>
      exact
        compileLinearCfgStmtFrom_cfg_correct hLayout hCompile hEval
          hNoHalt hRel
  | letCall names fnName args =>
      exact
        compileLinearCfgStmtFrom_cfg_correct hLayout hCompile hEval
          hNoHalt hRel
  | assignCall names fnName args =>
      exact
        compileLinearCfgStmtFrom_cfg_correct hLayout hCompile hEval
          hNoHalt hRel
  | seq first second =>
      exact
        compileLinearCfgStmtFrom_cfg_correct hLayout hCompile hEval
          hNoHalt hRel
  | block stmts =>
      exact
        compileLinearCfgStmtFrom_cfg_correct hLayout hCompile hEval
          hNoHalt hRel
  | forLoop pre cond post body =>
      exact
        compileForLoopLinearFrom_cfg_correct hLayout hCompile hEval
          hNoHalt hRel
  | «break» =>
      exact
        compileLinearCfgStmtFrom_cfg_correct hLayout hCompile hEval
          hNoHalt hRel
  | «continue» =>
      exact
        compileLinearCfgStmtFrom_cfg_correct hLayout hCompile hEval
          hNoHalt hRel
  | «leave» =>
      exact
        compileLinearCfgStmtFrom_cfg_correct hLayout hCompile hEval
          hNoHalt hRel

