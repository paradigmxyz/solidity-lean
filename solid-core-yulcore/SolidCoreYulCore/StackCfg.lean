    ∃ caseTarget,
      SwitchCaseCodesExec discrValue discrTarget stackRest caseCodes
        caseTarget ∧
        StackRel layout result.config [] tail caseTarget ∧
        result.flow = ConcreteYul.Flow.normal := by
