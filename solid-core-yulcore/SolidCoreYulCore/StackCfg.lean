                                    some
                                      (argValues.map norm,
                                        frameOf layout source.env ++ tail) := by
                                rw [hArgRel.stack_eq]
                                rw [← hArgLen]
                                simpa [List.append_assoc]
                                  using
                                    popArgWords_expr_values argValues
                                      (frameOf layout source.env ++ tail)
