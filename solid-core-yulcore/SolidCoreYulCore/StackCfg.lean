theorem CompiledCallSemRealizesBelow.mono
    {hash : ConcreteYul.HashOracle}
    {sourceFns : ConcreteYul.FunctionEnv}
    {compiledFns : CompiledFunctionEnv} {callSem : CallSem}
    {low high : Nat}
    (hRealizes :
      CompiledCallSemRealizesBelow hash sourceFns compiledFns callSem high)
    (hLe : low ≤ high) :
    CompiledCallSemRealizesBelow hash sourceFns compiledFns callSem low := by
  intro m callFuel fnName args callerConfig returnValues resultConfig fn
    callEnv tail target hLt hNoHalt hLookup hInit hEval hRel
  exact hRealizes (Nat.lt_of_lt_of_le hLt hLe) hNoHalt hLookup hInit hEval
    hRel

theorem CompiledCallSemRealizesRunsBelow.mono
    {hash : ConcreteYul.HashOracle}
