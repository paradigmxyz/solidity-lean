def TupleItem.inlineInternalFunctionAliasesFuel :
    Nat -> InternalFunctionAliasEnv -> TupleItem -> TupleItem
  | 0, _, item => item
  | _ + 1, _, TupleItem.hole => TupleItem.hole
  | fuel + 1, aliasEnv, TupleItem.value expr =>
