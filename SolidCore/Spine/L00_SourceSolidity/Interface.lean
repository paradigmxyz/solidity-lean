      Stmt.ifElse
        (Expr.inlineInternalFunctionAliasesFuel fuel aliasEnv cond)
        (Stmt.inlineInternalFunctionAliasesFuel
          functions freeFunctions fuel aliasEnv thenBranch)
        (elseBranch.map
          (Stmt.inlineInternalFunctionAliasesFuel
