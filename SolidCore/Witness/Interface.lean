    (stmt : Stmt) : Bool :=
  match stmt with
  | Stmt.varDecl
      [{ name := some actualName
         ty := some (Ty.uint width)
         location := none }]
      (some (Expr.ident actualTemp)) =>
      actualName == expectedName && width == 256 &&
        actualTemp == modifierArgTempName expectedIndex
