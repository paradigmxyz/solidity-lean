              | some interfaceId => interfaceIdLiteralExpr interfaceId
              | none => expr
          | none => expr
      | Expr.literal literal => Expr.literal literal
      | Expr.ident name => Expr.ident name
      | Expr.typeName ty => Expr.typeName ty
