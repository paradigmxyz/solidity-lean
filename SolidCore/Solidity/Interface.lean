    (StructDecl.resolveEnums enumEnv
      (StructDecl.resolveUserTypes userEnv decl))

def UserValueTypeDecl.resolveSourceTypesWith
    (userEnv : UserTypeEnv) (decl : UserValueTypeDecl) :
    UserValueTypeDecl :=
