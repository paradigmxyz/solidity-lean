              | BinaryOp.boolAnd =>
                  useResult (SolidCore.Solidity.Source.Expr.word 0)
              | _ =>
                  useResult (SolidCore.Solidity.Source.Expr.word 1)
              let branchCore :=
                match op with
                | BinaryOp.boolAnd =>
                    SolidCore.Solidity.Source.Stmt.ifElse
                      (SolidCore.Solidity.Source.Expr.var lhsTmp)
                      rhsCallCore skipCore
                | _ =>
                    SolidCore.Solidity.Source.Stmt.ifElse
                      (SolidCore.Solidity.Source.Expr.var lhsTmp)
