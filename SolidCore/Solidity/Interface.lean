                    FunctionDecl.internalSingleReturnCallCore?
                      fuel storageRefEnv envWithArgTmp externalCallKindEnv
                      storageNames modifiers functions freeFunctions name
                      replacedArgs
                      (fun retExpr =>
                        useResult (convert (innerConvert retExpr)))
