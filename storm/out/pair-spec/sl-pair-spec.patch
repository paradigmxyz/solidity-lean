+/-! ## The environment of the runs -/
+
+/-- Token code: `transfer(...)` returns `true`, every other call the word `bal` (`bal < 2^16`). -/
+def tokenCode (bal : Nat) : ByteArray :=
+  ⟨(([0x60, 0, 0x35, 0x60, 0xe0, 0x1c, 0x63, 0xa9, 0x05, 0x9c, 0xbb, 0x14, 0x60, 0x1a, 0x57,
+      0x61, bal / 256, bal % 256, 0x60, 0, 0x52, 0x60, 0x20, 0x60, 0, 0xf3,
+      0x5b, 0x60, 1, 0x60, 0, 0x52, 0x60, 0x20, 0x60, 0, 0xf3] : List Nat).map UInt8.ofNat).toArray⟩
+
+/-- token0 at `0x4000` holding `b0` for the pair, token1 at `0x5000` holding `b1`. -/
+def env (b0 b1 : Nat) : TargetEnv :=
+  [{ addr := 0x4000, code := tokenCode b0, storage := [], balance := 0, nonce := 1 },
+   { addr := 0x5000, code := tokenCode b1, storage := [], balance := 0, nonce := 1 }]
+
+/-- A word as return data. -/
+def wordBA (n : Nat) : ByteArray := ⟨((word n).map UInt8.ofNat).toArray⟩
+
+/-- The same answers on the source side: `transfer` answers `true`, every other call the balance
+of the token called; no answer changes the pair's storage. -/
+def ans (b0 b1 : Nat) : Ans := fun _ q =>
+  match q with
+  | .resource r => some (Query.defaultAnswer (.resource r))
+  | .external w0 (.call req) =>
+    let v := if (req.calldata.data.toList.take 4).map (·.toNat) = [0xa9, 0x05, 0x9c, 0xbb] then 1
+      else if req.recipient.val = 0x4000 then b0 else b1
+    some (CallResponse.mk true (wordBA v) w0 (EvmYul.UInt256.ofNat 0))
+  | .external w0 (.create r) => some (Query.defaultAnswer (.external w0 (.create r)))
+
+/-- The source world of the runs: the tokens' answers and code at both addresses. -/
+def W (b0 b1 : Nat) : World := { ans := ans b0 b1, codes := some [(0x4000, [0x60]), (0x5000, [0x60])] }
+
+/-- The mutant bytes (swap without `_update`) and the altered bytes. -/
+def codeNoUpdate : ByteArray := ⟨(runtimeNoUpdate.map UInt8.ofNat).toArray⟩
+def codeAltered : ByteArray := ⟨((alterJump runtimeBytes).map UInt8.ofNat).toArray⟩
+
+/-- SolidCore's checked mutant. -/
+def contractNoUpdate? : Except TypeCheck.TypeError TypeCheck.CheckedContract :=
+  TypeCheck.CheckedInput.contract SolidCore.Verify.VC.Source.UniswapV2PairNoUpdate.importedSourceUnit
+    "UniswapV2Pair"
+
+/-- The features of a run the controls check: success, reserve0, reserve1, the lock word. -/
+def feat : Option Observable → Option (Bool × Nat × Nat × Nat)
+  | some o => some (o.success, o.storage 8 % 2 ^ 112, o.storage 8 / 2 ^ 112 % 2 ^ 112, o.storage 12)
+  | none => none
+
+def srcRun (c? : Except TypeCheck.TypeError TypeCheck.CheckedContract) (w : World) (call : Call) :
+    Option Observable :=
+  match c? with
+  | .ok c => Source.runIn w SolidCore.Verify.VC.UniswapV2Pair.fuel c call
+  | .error _ => none
+
+/-! ## The runs (evaluated) -/
+
+-- The exact bytes: the swap succeeds, reserves 11000/9094, unlocked.
+#guard feat (Target.runWithIn (env 11000 9094) 10000000 code swapCall) = some (true, 11000, 9094, 1)
+-- The checked source in the matching world: the same features.
+#guard feat (srcRun SolidCore.Verify.VC.UniswapV2Pair.contract? (W 11000 9094) swapCall) =
+  some (true, 11000, 9094, 1)
+-- Mutant bytes: the swap succeeds and leaves the reserves at 10000/10000.
+#guard feat (Target.runWithIn (env 11000 9094) 10000000 codeNoUpdate swapCall) = some (true, 10000, 10000, 1)
+-- Mutant source: the same.
+#guard feat (srcRun contractNoUpdate? (W 11000 9094) swapCall) = some (true, 10000, 10000, 1)
+-- Altered bytes: the swap the real bytes perform fails.
+#guard ((Target.runWithIn (env 11000 9094) 10000000 codeAltered swapCall).map (·.success)) = some false
+-- Mismatched environment: the source in a world answering 11000/9000 does not show the bytes'
+-- observable among tokens answering 11000/9094.
+#guard feat (srcRun SolidCore.Verify.VC.UniswapV2Pair.contract? (W 11000 9000) swapCall) ≠
+  feat (Target.runWithIn (env 11000 9094) 10000000 code swapCall)
+-- Closed world: without token accounts the swap reverts.
+#guard ((Target.runWithIn [] 10000000 code swapCall).map (·.success)) = some false
 
