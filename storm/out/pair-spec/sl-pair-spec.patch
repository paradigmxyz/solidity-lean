diff --git a/Contracts/UniswapV2/PairSpec/Negative.lean b/Contracts/UniswapV2/PairSpec/Negative.lean
new file mode 100644
index 0000000..ea385e0
--- /dev/null
+++ b/Contracts/UniswapV2/PairSpec/Negative.lean
@@ -0,0 +1,122 @@
+import Contracts.UniswapV2.PairSpec.Published
+import Contracts.UniswapV2.PairSpec.SpecWrongK
+
+/-!
+# UniswapV2Pair: the binding and the negative controls
+
+* `bound`: the export is the bytes of solar's plain compile, decided by the kernel.
+* **Altered jump** (`altered_not_bound`): the bytes with the first `PUSH2 t; JUMP`/`JUMPI`
+  target moved by one are not the export, so a statement over them fails at its binding, by
+  mismatch (the kernel decides the inequality), never by a timeout.
+* **Wrong K** (`wrongK_rejects`): the specification with swap's fee-adjusted constant-product
+  clause at a fee of 4/1000 instead of 3/1000 (SpecWrongK.lean, the same export with one
+  constant mutated) rejects the observable of a swap the pair performs (reserves 10000/10000,
+  1000 of token0 in, 906 of token1 out: `swap(0, 906, to, "")`), which the published
+  specification accepts (`swap_k_holds`).
+* **Missing reserve update** (`noUpdate_rejected`): the published specification rejects the
+  observable of a swap that pays 906 of token1 out but leaves the reserves as they were.
+
+The last two are about the specification's formulas on concrete states (the one clause each
+control changes or breaks); that the pair's bytecode produces the first observable, and a pair
+without `_update` the second, is not proved here (the stage theorems would say so of every run).
+The driver's own controls (tools/certify/final_neg.sh: a proof of the published statement does
+not check against a statement with a wrong postcondition, a substituted bytecode or a dropped
+premise) apply to this statement unchanged.
+-/
+
+namespace SolidCore.Spec.UniswapV2.PairSpec.Negative
+
+open SolarTV SolidCore.Refinement SolidCore.Spec SolidCore.Spec.UniswapV2.PairSpec
+
+/-! ## The binding and an altered jump -/
+
+set_option maxRecDepth 100000 in
+/-- The export is the bytes of the plain compile. -/
+theorem bound : Bound :=
+  @of_decide_eq_true _ (instDecidableEqList _ _) (by decide +kernel)
+
+/-- The bytes with the first `PUSH2 t; JUMP` or `PUSH2 t; JUMPI` target moved by one. -/
+def alterJump : List Nat → List Nat
+  | 0x61 :: hi :: lo :: 0x56 :: rest => 0x61 :: hi :: ((lo + 1) % 256) :: 0x56 :: rest
+  | 0x61 :: hi :: lo :: 0x57 :: rest => 0x61 :: hi :: ((lo + 1) % 256) :: 0x57 :: rest
+  | b :: rest => b :: alterJump rest
+  | [] => []
+
+set_option maxRecDepth 100000 in
+/-- The alteration changes the bytes. -/
+theorem alterJump_changes : alterJump runtimeBytes ≠ runtimeBytes := by decide +kernel
+
+set_option maxRecDepth 100000 in
+/-- **Altered jump**: the export is not the altered bytes. -/
+theorem altered_not_bound : ¬ (code.data.toList.map (·.toNat) = alterJump runtimeBytes) := by
+  rw [bound]
+  exact alterJump_changes.symm
+
+/-! ## Wrong K and a missing reserve update -/
+
+/-- swap's spec in a bundle. -/
+def swapSpec (b : Bundle) : FnSpec :=
+  (b.spec.specs.find? fun fs => fs.name == "UniswapV2Pair.swap").getD default
+
+/-- Its first ensures clause: the fee-adjusted constant product. -/
+def kClause (b : Bundle) : Term := (swapSpec b).ensures.headD (.lit 0)
+
+/-- The reserves word of slot 8: `reserve0` in the low 14 bytes, `reserve1` in the next 14. -/
+def reserves (r0 r1 : Nat) : Nat := r0 + r1 * 2 ^ 112
+
+/-- A state with reserves `r0`, `r1` and nothing else in storage. -/
+def st (r0 r1 : Nat) : State :=
+  { storage := fun s => if s = 8 then reserves r0 r1 else 0, ghost := Ghost.zero, time := 0 }
+
+/-- The environment of `swap(0, out1, 0x3000, "")` from reserves 10000/10000 to `post`. -/
+def envOf (out1 : Nat) (post : State) : Env :=
+  mkEnv { sender := 0x2000, value := 0, timestamp := 1, self := 0x1000 } [0, out1, 0x3000, 0x80] []
+    (st 10000 10000) post
+
+/-- **The published K clause holds of the swap the pair performs**: 1000 of token0 in, 906 of
+token1 out, from reserves 10000/10000 to 11000/9094. -/
+theorem swap_k_holds :
+    SolidCore.Spec.Export.UniswapV2Pair.UniswapV2Pair.sat
+      (kClause SolidCore.Spec.Export.UniswapV2Pair.UniswapV2Pair) (envOf 906 (st 11000 9094)) := by
+  have hk : kClause SolidCore.Spec.Export.UniswapV2Pair.UniswapV2Pair = (SolidCore.Spec.Export.UniswapV2Pair.UniswapV2Pair.spec.specs[8]'(by decide)).ensures[0]'(by decide) := rfl
+  rw [hk]
+  simp [Bundle.sat, SolidCore.Spec.Export.UniswapV2Pair.UniswapV2Pair, eval, BinOp.apply, envOf, st, mkEnv, Env.cur, slotOf, reserves,
+    Ty.ofBits, toWord]
+
+/-- **Wrong K**: the mutant clause (fee 4/1000) rejects that swap. -/
+theorem wrongK_rejects :
+    ¬ SolidCore.Spec.Export.UniswapV2PairWrongK.UniswapV2Pair.sat
+      (kClause SolidCore.Spec.Export.UniswapV2PairWrongK.UniswapV2Pair) (envOf 906 (st 11000 9094)) := by
+  have hk : kClause SolidCore.Spec.Export.UniswapV2PairWrongK.UniswapV2Pair = (SolidCore.Spec.Export.UniswapV2PairWrongK.UniswapV2Pair.spec.specs[8]'(by decide)).ensures[0]'(by decide) := rfl
+  rw [hk]
+  simp [Bundle.sat, SolidCore.Spec.Export.UniswapV2PairWrongK.UniswapV2Pair, eval, BinOp.apply, envOf, st, mkEnv, Env.cur, slotOf, reserves,
+    Ty.ofBits, toWord]
+
+/-- **Missing reserve update**: the published K clause rejects a swap that pays 906 of token1 out
+and leaves the reserves at 10000/10000. -/
+theorem noUpdate_rejected :
+    ¬ SolidCore.Spec.Export.UniswapV2Pair.UniswapV2Pair.sat
+      (kClause SolidCore.Spec.Export.UniswapV2Pair.UniswapV2Pair) (envOf 906 (st 10000 10000)) := by
+  have hk : kClause SolidCore.Spec.Export.UniswapV2Pair.UniswapV2Pair = (SolidCore.Spec.Export.UniswapV2Pair.UniswapV2Pair.spec.specs[8]'(by decide)).ensures[0]'(by decide) := rfl
+  rw [hk]
+  simp [Bundle.sat, SolidCore.Spec.Export.UniswapV2Pair.UniswapV2Pair, eval, BinOp.apply, envOf, st, mkEnv, Env.cur, slotOf, reserves,
+    Ty.ofBits, toWord]
+
+/-- info: 'SolidCore.Spec.UniswapV2.PairSpec.Negative.altered_not_bound' depends on axioms: [propext] -/
+#guard_msgs (whitespace := lax) in
+#print axioms altered_not_bound
+
+/-- info: 'SolidCore.Spec.UniswapV2.PairSpec.Negative.swap_k_holds' depends on axioms: [propext, Classical.choice, Quot.sound] -/
+#guard_msgs (whitespace := lax) in
+#print axioms swap_k_holds
+
+/-- info: 'SolidCore.Spec.UniswapV2.PairSpec.Negative.wrongK_rejects' depends on axioms: [propext, Classical.choice, Quot.sound] -/
+#guard_msgs (whitespace := lax) in
+#print axioms wrongK_rejects
+
+/-- info: 'SolidCore.Spec.UniswapV2.PairSpec.Negative.noUpdate_rejected' depends on axioms: [propext, Classical.choice, Quot.sound] -/
+#guard_msgs (whitespace := lax) in
+#print axioms noUpdate_rejected
+
+end SolidCore.Spec.UniswapV2.PairSpec.Negative
+
diff --git a/Contracts/UniswapV2/PairSpec/NonVacuous.lean b/Contracts/UniswapV2/PairSpec/NonVacuous.lean
new file mode 100644
index 0000000..d2127a9
--- /dev/null
+++ b/Contracts/UniswapV2/PairSpec/NonVacuous.lean
@@ -0,0 +1,36 @@
+import Contracts.UniswapV2.PairSpec.Published
+
+namespace SolidCore.Spec.UniswapV2.PairSpec
+
+open SolarTV SolidCore.Refinement SolidCore.Spec
+
+/-- sync() from the empty storage. -/
+def syncCall : Call := mkCall ((EthLib.Base.natToBytes 4 syncSel).map (·.toNat)) []
+
+/-- A success that changes the total supply (slot 0) from 0 to 1. -/
+def badObs : Observable :=
+  { success := true, output := [], logs := [], storage := fun s => if s = 0 then 1 else 0 }
+
+theorem nonVacuous : NonVacuous := by
+  refine ⟨syncCall, badObs, Or.inr (Or.inr ⟨[], rfl⟩), fun W h => ?_⟩
+  have hmem : (SolidCore.Spec.Export.UniswapV2Pair.UniswapV2Pair.spec.specs[10]'(by decide)) ∈
+      SolidCore.Spec.Export.UniswapV2Pair.UniswapV2Pair.spec.specs := List.getElem_mem _
+  have hpre : SolidCore.Spec.Pre SolidCore.Spec.Export.UniswapV2Pair.UniswapV2Pair
+      (SolidCore.Spec.Export.UniswapV2Pair.UniswapV2Pair.spec.specs[10]'(by decide)) (ctxOf syncCall)
+      { storage := slotValue [], ghost := Ghost.zero, time := 0 } syncCall [] := by
+    refine ⟨⟨by decide, by decide, by decide⟩, rfl, by decide, ?_, ?_⟩
+    · simp [Bundle.satAll, SolidCore.Spec.Export.UniswapV2Pair.UniswapV2Pair]
+    · simp [Bundle.satAll, Bundle.sat, SolidCore.Spec.Export.UniswapV2Pair.UniswapV2Pair, eval,
+        BinOp.apply, mkEnv, Env.cur, slotOf, slotValue, Ty.ofBits, toWord, Ghost.zero, Env.bind]
+  have hp := (h _ hmem [] _ hpre).1 rfl
+  obtain ⟨rets, -, hens, -⟩ := hp
+  have h0 := hens _ (List.getElem_mem (by decide : 0 < (SolidCore.Spec.Export.UniswapV2Pair.UniswapV2Pair.spec.specs[10]'(by decide)).ensures.length))
+  simp [Bundle.sat, SolidCore.Spec.Export.UniswapV2Pair.UniswapV2Pair, eval, BinOp.apply, mkEnv,
+    Env.cur, slotOf, slotValue, Ty.ofBits, toWord, badObs, idStep] at h0
+
+/-- info: 'SolidCore.Spec.UniswapV2.PairSpec.nonVacuous' depends on axioms: [propext, Classical.choice, Quot.sound] -/
+#guard_msgs (whitespace := lax) in
+#print axioms nonVacuous
+
+end SolidCore.Spec.UniswapV2.PairSpec
+
diff --git a/Contracts/UniswapV2/PairSpec/Published.lean b/Contracts/UniswapV2/PairSpec/Published.lean
new file mode 100644
index 0000000..82c9345
--- /dev/null
+++ b/Contracts/UniswapV2/PairSpec/Published.lean
@@ -0,0 +1,54 @@
+import Contracts.UniswapV2.PairSpec.Stages
+
+/-!
+# UniswapV2Pair: the composition wrapper
+
+`published_of_stages` proves the published `Statement` from the binding, the checked source and
+the nine stage theorems (Stages.lean), by `OpenFunctional.of_parts` alone. Every input is a named
+hypothesis of the theorem: nothing is assumed, and the theorem says exactly what is still owed.
+When the lanes' theorems land, `published := published_of_stages bound contract_ok ...` is the
+published theorem, checked against `Statement` by the driver (tools/certify/check_final.lean).
+-/
+
+namespace SolidCore.Spec.UniswapV2.PairSpec
+
+open SolarTV SolidCore.Refinement SolidCore.Refinement.Shapes SolidCore.Spec.UniswapV2.PairSpec.Stages
+
+/-- A valid call exists: `sync()` from the empty storage. -/
+theorem inhabited : ∃ call, Valid call :=
+  ⟨_, Or.inr (Or.inr ⟨[], rfl⟩)⟩
+
+/-- **The composition**: the statement from the binding, the checked source and the stages. -/
+theorem published_of_stages (hbound : Bound)
+    (hc : ∃ c, SolidCore.Verify.VC.UniswapV2Pair.contract? = .ok c)
+    (heq : ∀ c, SolidCore.Verify.VC.UniswapV2Pair.contract? = .ok c →
+      EquivSwap c ∧ EquivSkim c ∧ EquivSync c)
+    (hterm : ∀ c, SolidCore.Verify.VC.UniswapV2Pair.contract? = .ok c →
+      TermSwap c ∧ TermSkim c ∧ TermSync c)
+    (hmeets : ∀ c, SolidCore.Verify.VC.UniswapV2Pair.contract? = .ok c →
+      MeetsSwap c ∧ MeetsSkim c ∧ MeetsSync c) :
+    Statement := by
+  refine ⟨hbound, fun hk => ?_⟩
+  obtain ⟨c, hc⟩ := hc
+  obtain ⟨e1, e2, e3⟩ := heq c hc
+  obtain ⟨t1, t2, t3⟩ := hterm c hc
+  obtain ⟨m1, m2, m3⟩ := hmeets c hc
+  refine ⟨c, hc, OpenFunctional.of_parts inhabited (e1.or (e2.or e3)) (t1.or (t2.or t3)) ?_⟩
+  exact fun W hW => (m1.or (m2.or m3)) hk W hW
+
+/-- info: 'SolidCore.Spec.UniswapV2.PairSpec.published_of_stages' depends on axioms: [propext, Classical.choice, Quot.sound] -/
+#guard_msgs (whitespace := lax) in
+#print axioms published_of_stages
+
+/-- **What the statement gives of the bytes**: in every admitted environment, every result of the
+exact bytecode on a valid call, at any gas below `2 ^ 256`, is allowed and meets the exported
+specification (for some admitted world), or changes nothing. -/
+theorem bytecode_of_statement (h : Statement) (hk : KeccakModel) (env : TargetEnv) (he : EnvOk env)
+    (gas : Nat) (hg : gas < 2 ^ 256) (call : Call) (hv : Valid call) (obs : Observable)
+    (hrun : Target.runWithIn env gas code call = some obs) :
+    (∃ W, Admit W ∧ Allowed W call obs ∧ Post W call obs) ∨ Inert call obs := by
+  obtain ⟨c, -, hf⟩ := h.2 hk
+  exact hf.bytecode_any env he gas hg call hv obs hrun
+
+end SolidCore.Spec.UniswapV2.PairSpec
+
diff --git a/Contracts/UniswapV2/PairSpec/Stages.lean b/Contracts/UniswapV2/PairSpec/Stages.lean
new file mode 100644
index 0000000..a6d218e
--- /dev/null
+++ b/Contracts/UniswapV2/PairSpec/Stages.lean
@@ -0,0 +1,76 @@
+import Contracts.UniswapV2.PairSpec.Statement
+
+/-!
+# UniswapV2Pair: the stage theorems the published statement composes
+
+These are the statements of the theorems the backend lanes produce, as `Prop`s, so that the
+composition (Published.lean) is kernel-checked now and becomes the published theorem by applying
+it to the lanes' theorems once they land. None is assumed anywhere: each is a hypothesis of
+`published_of_stages`, visible in its statement. Names (RESULT.md lists them):
+
+| Prop | the theorem that will prove it | lane |
+|---|---|---|
+| `EquivSwap`, `EquivSkim`, `EquivSync` | `SolarTV.Export.UniswapV2Pair.Ctx.equiv_swap` / `_skim` / `_sync` | pair-stages-b |
+| `TermSwap`, `TermSkim`, `TermSync` | `SolidCore.Spec.UniswapV2.Pair.terminates_swap` / `_skim` / `_sync` | pair-stages-b |
+| `MeetsSwap`, `MeetsSkim`, `MeetsSync` | `SolidCore.Spec.UniswapV2.Pair.swap_holds` / `skim_holds` / `sync_holds` | pair-spec (spec connection) |
+
+pair-stages-a's mint and burn enter the same way (`EquivMint`, ...) once their ghost step is
+written; the statement does not cover them yet.
+-/
+
+namespace SolidCore.Spec.UniswapV2.PairSpec.Stages
+
+open SolarTV SolidCore.Refinement SolidCore.Refinement.Shapes SolidCore.Spec.UniswapV2.PairSpec
+
+/-- Equivalence on the calls `V` of one function: every result of the exact bytes in every admitted
+environment, at every gas below `2 ^ 256`, is the checked source's in some admitted world, or an
+inert failure. -/
+def EquivOn (c : SolidCore.Solidity.TypeCheck.CheckedContract) (V : Call → Prop) : Prop :=
+  ∀ env, EnvOk env → ∀ gas, gas < 2 ^ 256 → ∀ call, V call → ∀ obs,
+    Target.runWithIn env gas code call = some obs →
+      (∃ W, Admit W ∧ Source.runIn W SolidCore.Verify.VC.UniswapV2Pair.fuel c call = some obs) ∨
+        Inert call obs
+
+/-- Termination on the calls `V` of one function, with an allowed status, in every admitted world. -/
+def TermOn (c : SolidCore.Solidity.TypeCheck.CheckedContract) (V : Call → Prop) : Prop :=
+  ∀ W, Admit W → ∀ call, V call →
+    ∃ obs, Source.runIn W SolidCore.Verify.VC.UniswapV2Pair.fuel c call = some obs ∧ Allowed W call obs
+
+/-- The specification on the calls `V` of one function, in every admitted world, under the named
+premise. -/
+def MeetsOn (c : SolidCore.Solidity.TypeCheck.CheckedContract) (V : Call → Prop) : Prop :=
+  KeccakModel → ∀ W, Admit W → Meets (solidCoreIn W SolidCore.Verify.VC.UniswapV2Pair.fuel) c V (Post W)
+
+def EquivSwap (c : SolidCore.Solidity.TypeCheck.CheckedContract) : Prop := EquivOn c ValidSwap
+def EquivSkim (c : SolidCore.Solidity.TypeCheck.CheckedContract) : Prop := EquivOn c ValidSkim
+def EquivSync (c : SolidCore.Solidity.TypeCheck.CheckedContract) : Prop := EquivOn c ValidSync
+def TermSwap (c : SolidCore.Solidity.TypeCheck.CheckedContract) : Prop := TermOn c ValidSwap
+def TermSkim (c : SolidCore.Solidity.TypeCheck.CheckedContract) : Prop := TermOn c ValidSkim
+def TermSync (c : SolidCore.Solidity.TypeCheck.CheckedContract) : Prop := TermOn c ValidSync
+def MeetsSwap (c : SolidCore.Solidity.TypeCheck.CheckedContract) : Prop := MeetsOn c ValidSwap
+def MeetsSkim (c : SolidCore.Solidity.TypeCheck.CheckedContract) : Prop := MeetsOn c ValidSkim
+def MeetsSync (c : SolidCore.Solidity.TypeCheck.CheckedContract) : Prop := MeetsOn c ValidSync
+
+theorem EquivOn.or {c : SolidCore.Solidity.TypeCheck.CheckedContract} {V V' : Call → Prop}
+    (h : EquivOn c V) (h' : EquivOn c V') : EquivOn c (fun call => V call ∨ V' call) := by
+  intro env he gas hg call hc obs hr
+  rcases hc with hc | hc
+  · exact h env he gas hg call hc obs hr
+  · exact h' env he gas hg call hc obs hr
+
+theorem TermOn.or {c : SolidCore.Solidity.TypeCheck.CheckedContract} {V V' : Call → Prop}
+    (h : TermOn c V) (h' : TermOn c V') : TermOn c (fun call => V call ∨ V' call) := by
+  intro W hW call hc
+  rcases hc with hc | hc
+  · exact h W hW call hc
+  · exact h' W hW call hc
+
+theorem MeetsOn.or {c : SolidCore.Solidity.TypeCheck.CheckedContract} {V V' : Call → Prop}
+    (h : MeetsOn c V) (h' : MeetsOn c V') : MeetsOn c (fun call => V call ∨ V' call) := by
+  intro hk W hW call hc obs hr
+  rcases hc with hc | hc
+  · exact h hk W hW call hc obs hr
+  · exact h' hk W hW call hc obs hr
+
+end SolidCore.Spec.UniswapV2.PairSpec.Stages
+
diff --git a/Contracts/UniswapV2/PairSpec/Statement.lean b/Contracts/UniswapV2/PairSpec/Statement.lean
