index 0000000..6cf74fe
--- /dev/null
+++ b/Contracts/UniswapV2/PairSpec/Statement.lean
@@ -0,0 +1,147 @@
+import Verify.ShapeOpen
+import Verify.ShapeBundle
+import Verify.Spec.TreeMapNested
+import Contracts.UniswapV2.Pair.Core
+import Contracts.UniswapV2.PairSpec.Spec
+import Contracts.UniswapV2.PairSpec.Bytecode
+import Contracts.UniswapV2.PairSpec.Runtime
+
+/-!
+# UniswapV2Pair: the published statement of swap, skim and sync
+
+The statement is fixed here, from reviewed inputs only (never from a proof module):
+
+* the source: SolidCore's checked `UniswapV2Pair` (`SolidCore.Verify.VC.UniswapV2Pair.contract?`,
+  scripts/verify/uniswap_v2_core.py; not committed, the port is GPL-3.0);
+* the bytes: `SolarTV.Export.UniswapV2Pair.bytecode`, the runtime bytecode solar emitted
+  (`-Ogas --evm-version osaka`), bound to `runtimeBytes` by exact equality (`Bound`);
+* the valid calls (`Valid`): `swap(amount0Out, amount1Out, to, data)` with its `bytes` argument
+  ABI-encoded at offset `0x80` (any data below `2 ^ 32` bytes), `skim(to)` and `sync()`, clean
+  argument words, no value, from any storage;
+* the environment: every list of other accounts (`TargetEnv.WF`: the tokens, the factory, a
+  callee, with any code and storage) on the bytecode side, and every admitted open world on the
+  source side (`Admit`: answers every call; return data below `2 ^ 64` bytes; account code at
+  addresses below `2 ^ 160`);
+* the allowed statuses (`Allowed`): every status, since a callee's revert data is bubbled
+  verbatim (declared vacuity of the allowed statuses; the specification constrains successes);
+* the specification (`Post`): solar-verify's export of crates/verify/uniswap-v2/uniswap-v2.spec
+  for `UniswapV2Pair` (`SolidCore.Spec.Export.UniswapV2Pair.UniswapV2Pair`, generated by
+  scripts/verify/uniswap_v2_pair_spec.sh), read by `Shapes.bundlePost` with the identity ghost
+  step: swap, skim and sync update no ghost, and the inherited ERC20 invariants
+  (`totalSupply == sumBalances`, `allowance[0][s] == 0`, `balanceOf[0] >= zeroMinted`) are
+  assumed before the call and required after it;
+* one named premise, `KeccakModel`: keccak256 injective with large images on the mapping slots
+  of `balanceOf`, `nonces` and `allowance` (currently `SolidCore.Spec.NestedSlotsSeparated`,
+  until the keccak-model lane's definition lands; it is a premise, never an axiom).
+
+Not in the statement: mint and burn (their exported ensures read statement-level ghosts,
+`mintAmount0 = amount0` and the like, whose values depend on the tokens' answers: the ghost step
+that computes them from the world is not written, see RESULT.md), the ERC20 functions, permit,
+initialize, the getters, the constructor (the statement starts from any storage), resources (no
+gas bound: callees spend gas), the source model (SolidCore's checked contract is the meaning of
+the source: frontend trust boundary).
+-/
+
+namespace SolidCore.Spec.UniswapV2.PairSpec
+
+open SolarTV SolidCore.Refinement SolidCore.Refinement.Shapes
+
+/-! ## The bytes -/
+
+/-- The runtime bytecode the statement speaks of: the fresh export. -/
+def code : ByteArray := ⟨(SolarTV.Export.UniswapV2Pair.bytecode.map UInt8.ofNat).toArray⟩
+
+/-- The binding of the export to the bytes this run compiled (`runtimeBytes`, generated beside
+the export from solar's own output). -/
+def Bound : Prop := code.data.toList.map (·.toNat) = runtimeBytes
+
+/-! ## The calls -/
+
+/-- `swap(uint256,uint256,address,bytes)`. -/
+abbrev swapSel : Nat := 0x022c0d9f
+/-- `skim(address)`. -/
+abbrev skimSel : Nat := 0xbc25cf77
+/-- `sync()`. -/
+abbrev syncSel : Nat := 0xfff6cae9
+
+/-- `n` as a 32-byte big-endian word. -/
+def word (n : Nat) : List Nat := (EthLib.Base.natToBytes 32 n).map (·.toNat)
+
+/-- The call data of `swap(a0, a1, to, data)` as solc's encoder writes it: the head, the offset
+`0x80`, the length and the data padded to whole words. -/
+def swapData (a0 a1 dst : Nat) (data : List Nat) : List Nat :=
+  (EthLib.Base.natToBytes 4 swapSel).map (·.toNat) ++ word a0 ++ word a1 ++ word dst ++ word 0x80 ++
+    word data.length ++ data ++ List.replicate ((32 - data.length % 32) % 32) 0
+
+/-- A call with call data `d` from the storage `σ`, without value. -/
+def mkCall (d : List Nat) (σ : List (Nat × Nat)) : Call :=
+  { calldata := ⟨(d.map UInt8.ofNat).toArray⟩, callvalue := 0, storage := σ }
+
+/-- The valid calls of `swap`. -/
+def ValidSwap (call : Call) : Prop :=
+  ∃ σ a0 a1 dst data, a0 < 2 ^ 256 ∧ a1 < 2 ^ 256 ∧ dst < 2 ^ 160 ∧ data.length < 2 ^ 32 ∧
+    (∀ b ∈ data, b < 256) ∧ call = mkCall (swapData a0 a1 dst data) σ
+
+/-- The valid calls of `skim`. -/
+def ValidSkim (call : Call) : Prop :=
+  ∃ σ dst, dst < 2 ^ 160 ∧ call = mkCall ((EthLib.Base.natToBytes 4 skimSel).map (·.toNat) ++ word dst) σ
+
+/-- The valid calls of `sync`. -/
+def ValidSync (call : Call) : Prop :=
+  ∃ σ, call = mkCall ((EthLib.Base.natToBytes 4 syncSel).map (·.toNat)) σ
+
+/-- The statement's valid calls. -/
+def Valid (call : Call) : Prop := ValidSwap call ∨ ValidSkim call ∨ ValidSync call
+
+/-! ## The environment -/
+
+/-- The admitted bytecode environments. -/
+def EnvOk (env : TargetEnv) : Prop := env.WF
+
+/-- The admitted source worlds. -/
+def Admit (W : World) : Prop :=
+  W.Open ∧ (∀ p ∈ W.codes.getD [], p.1 < 2 ^ 160) ∧
+    (∀ h world request a, W.ans h (.external world (.call request)) = some a →
+      a.returnData.size < 2 ^ 64)
+
+/-- **The named premise**: keccak256 is injective with images of at least `2 ^ 128` on the
+mapping slots the specification and the code read (`balanceOf` at slot 1, `nonces` at 4,
+`allowance` at 2). The keccak-model lane's `KeccakModel` replaces this definition when it lands. -/
+def KeccakModel : Prop := SolidCore.Spec.NestedSlotsSeparated [1, 4] [2]
+
+/-! ## Allowed statuses and the specification -/
+
+/-- **The allowed statuses: every status.** swap, skim and sync bubble a callee's revert data
+verbatim (the tokens' `balanceOf` and the `uniswapV2Call` callback are high-level calls), and an
+admitted world may revert with any data, so no revert data can be excluded: termination is stated
+with any status, and an arbitrary revert is not counted as functional success (`Post` constrains
+successes only). Recorded as the statement's declared vacuity of the allowed statuses. -/
+def Allowed (_W : World) (_call : Call) (_obs : Observable) : Prop := True
+
+/-- The call context of the specification: the statement's caller and contract, its block. -/
+def ctxOf (call : Call) : SolidCore.Spec.Ctx :=
+  { sender := callerAddress, value := call.callvalue, timestamp := 1, self := selfAddress }
+
+/-- swap, skim and sync update no ghost. -/
+def idStep : SolidCore.Spec.GhostStep := fun _ g => g
+
+/-- **The specification**: solar-verify's export, as a postcondition of one call. -/
+def Post (_W : World) : Call → Observable → Prop :=
+  bundlePost SolidCore.Spec.Export.UniswapV2Pair.UniswapV2Pair ctxOf idStep
+
+/-! ## The statement -/
+
+/-- **The published statement**: the binding, and, under the named premise, equivalence,
+termination and the exported specification of swap, skim and sync on the exact bytes, in every
+admitted environment. -/
+def Statement : Prop :=
+  Bound ∧ (KeccakModel →
+    ∃ c, SolidCore.Verify.VC.UniswapV2Pair.contract? = .ok c ∧
+      OpenFunctional SolidCore.Verify.VC.UniswapV2Pair.fuel c code EnvOk Admit Valid Allowed Post)
+
+/-- The specification rejects something: a valid call with a result the specification rejects in
+every world. (The allowed statuses reject nothing; see `Allowed`.) -/
+def NonVacuous : Prop := ∃ call obs, Valid call ∧ ∀ W, ¬ Post W call obs
+
+end SolidCore.Spec.UniswapV2.PairSpec
+
diff --git a/Verify/ShapeOpen.lean b/Verify/ShapeOpen.lean
new file mode 100644
index 0000000..3cf4cbb
--- /dev/null
+++ b/Verify/ShapeOpen.lean
@@ -0,0 +1,157 @@
+import Verify.Shapes
+import SolidCore.Refinement.SourceOracle
+
+/-!
+# The shape of a certified compilation in an open world
+
+`Shapes.Functional` runs the bytecode in EthLib's state with only the contract and its caller
+(`Target.preState`), so every external call reaches an account without code. For a contract
+whose functions call other contracts (a pair reading its tokens' balances and paying them), that
+closed world makes every such function revert, and a specification of their successes holds
+vacuously. This file states the same three obligations with the environment quantified, as
+requirement E asks:
+
+* `TargetEnv`: the other accounts of the target's state (address, code, storage, balance), any
+  list the statement admits (`EnvOk`); `Target.runWithIn env gas code call` is
+  `Final.Target.runWith` with those accounts added, observing the contract's own logs only.
+* `OpenFunctional`: equivalence (every result of the exact bytecode in every admitted environment,
+  at every gas below `2 ^ 256`, is SolidCore's result in some admitted open world `W`, or an
+  inert failure), termination with an allowed status in **every** admitted world (never by choosing
+  a terminating oracle), and the specification of every source result in every admitted world.
+  The allowed statuses and the specification may read the world (a ghost step that depends on the
+  answers of the calls).
+
+`OpenFunctional.bytecode_any` is what it says of the bytes: every result in every admitted
+environment is allowed and meets the specification for some admitted world, or changes nothing.
+No resources obligation: a gas bound for code whose callees spend gas is not stated here.
+
+The world the equivalence picks is existential per run: the statement does not say it is the one
+the environment's code computes (causal consistency is the stage's business; the specification
+holds in every admitted world, so the conclusion does not depend on which).
+-/
+
+namespace SolidCore.Refinement.Shapes
+
+open SolarTV SolidCore.Refinement SolidCore.Refinement.Final
+open EthLib.Base EthLib.Execution EthLib.Execution.Evm EthLib.Execution.State
+
+/-- One other account of the target's state. -/
+structure EnvAccount where
+  addr : Nat
+  code : ByteArray
+  storage : List (Nat × Nat)
+  balance : Nat
+  nonce : Nat
+
+/-- The other accounts of the target's state. -/
+abbrev TargetEnv := List EnvAccount
+
+/-- The environment's accounts are distinct addresses below `2 ^ 160`, neither the contract nor
+its caller. -/
+def TargetEnv.WF (env : TargetEnv) : Prop :=
+  (env.map (·.addr)).Nodup ∧ ∀ a ∈ env, a.addr < 2 ^ 160 ∧ a.addr ≠ selfAddress ∧ a.addr ≠ callerAddress
+
+namespace Target
+
+/-- `Target.preState` with the environment's accounts, storage and code added. -/
+def preStateIn (env : TargetEnv) (code : ByteArray) (call : Call) : TransactionState :=
+  let hash := EthLib.Cryptography.Hash.Keccak.keccak256 code
+  let storage : Std.ExtTreeMap Bytes32 U256 :=
+    call.storage.foldl (fun m kv => m.insert (Refinement.Target.storageKey kv.1) (BitVec.ofNat 256 kv.2)) ∅
+  let accounts0 : Std.ExtTreeMap Address Account :=
+    ((∅ : Std.ExtTreeMap Address Account).insert (Refinement.Target.address selfAddress)
+        { nonce := 1, balance := 0, codeHash := hash }).insert (Refinement.Target.address callerAddress)
+        { nonce := 0, balance := BitVec.ofNat 256 call.callvalue,
+          codeHash := EthLib.Cryptography.Hash.Keccak.keccak256 .empty }
+  let storage0 : Std.ExtTreeMap Address (Std.ExtTreeMap Bytes32 U256) :=
+    (∅ : Std.ExtTreeMap Address (Std.ExtTreeMap Bytes32 U256)).insert
+      (Refinement.Target.address selfAddress) storage
+  let code0 : Std.ExtTreeMap Hash32 ByteArray := (∅ : Std.ExtTreeMap Hash32 ByteArray).insert hash code
+  let pre : State := env.foldl (fun (s : State) a =>
+      let h := EthLib.Cryptography.Hash.Keccak.keccak256 a.code
+      { accounts := s.accounts.insert (Refinement.Target.address a.addr)
+          { nonce := a.nonce, balance := BitVec.ofNat 256 a.balance, codeHash := h },
+        storage := s.storage.insert (Refinement.Target.address a.addr)
+          (a.storage.foldl (fun m kv =>
+            m.insert (Refinement.Target.storageKey kv.1) (BitVec.ofNat 256 kv.2)) ∅),
+        code := s.code.insert h a.code })
+    { accounts := accounts0, storage := storage0, code := code0 }
+  TransactionState.ofBlock
+    { preState := pre, accountWrites := ∅, storageWrites := ∅, codeWrites := ∅,
+      storageClears := ∅ }
+
+/-- `Final.Target.runWith` in the environment `env`: the contract's own logs, storage and
+output. -/
+def runWithIn (env : TargetEnv) (gas : Nat) (code : ByteArray) (call : Call) : Option Observable :=
+  match processMessage (Meter := Nat) .fusaka (Final.Target.messageWith gas code call)
+      (preStateIn env code call) Substate.empty with
+  | .error _ => none
+  | .ok ⟨evm, _⟩ =>
+    let success := evm.error.isNone
+    some
+      { success
+        output := evm.output.toList.map (·.toNat)
+        logs :=
+          if success then
+            (evm.substate.logs.toList.filter fun log =>
+                log.address == Refinement.Target.address selfAddress).map fun log =>
+              (log.topics.map fun topic => bytesToNat topic.toList,
+                log.data.toList.map (·.toNat))
+          else []
+        storage := fun slot =>
+          if success then
+            (evm.state.getStorage (Refinement.Target.address selfAddress)
+              (Refinement.Target.storageKey slot)).toNat
+          else slotValue call.storage slot }
+
+end Target
+
+/-- **Equivalence, termination and the specification in an open world.** -/
+structure OpenFunctional (fuel : Nat) (c : SolidCore.Solidity.TypeCheck.CheckedContract)
+    (code : ByteArray) (EnvOk : TargetEnv → Prop) (Admit : World → Prop) (Valid : Call → Prop)
+    (Allowed Post : World → Call → Observable → Prop) : Prop where
+  inhabited : ∃ call, Valid call
+  equiv : ∀ env, EnvOk env → ∀ gas, gas < 2 ^ 256 → ∀ call, Valid call → ∀ obs,
+    Target.runWithIn env gas code call = some obs →
+      (∃ W, Admit W ∧ Source.runIn W fuel c call = some obs) ∨ Inert call obs
+  terminates : ∀ W, Admit W → ∀ call, Valid call →
+    ∃ obs, Source.runIn W fuel c call = some obs ∧ Allowed W call obs
+  meets : ∀ W, Admit W → ∀ call, Valid call → ∀ obs,
+    Source.runIn W fuel c call = some obs → Post W call obs
+
+/-- **What the bytecode does in every admitted environment**: every result, at any gas below
+`2 ^ 256`, is allowed and meets the specification in some admitted world, or changes nothing. -/
+theorem OpenFunctional.bytecode_any {fuel : Nat} {c : SolidCore.Solidity.TypeCheck.CheckedContract}
+    {code : ByteArray} {EnvOk : TargetEnv → Prop} {Admit : World → Prop} {Valid : Call → Prop}
+    {Allowed Post : World → Call → Observable → Prop}
+    (h : OpenFunctional fuel c code EnvOk Admit Valid Allowed Post) (env : TargetEnv)
+    (he : EnvOk env) (gas : Nat) (hg : gas < 2 ^ 256) (call : Call) (hc : Valid call)
+    (obs : Observable) (hrun : Target.runWithIn env gas code call = some obs) :
+    (∃ W, Admit W ∧ Allowed W call obs ∧ Post W call obs) ∨ Inert call obs := by
+  rcases h.equiv env he gas hg call hc obs hrun with ⟨W, hW, hs⟩ | e
+  · obtain ⟨obs', hs', ha⟩ := h.terminates W hW call hc
+    obtain rfl : obs' = obs := Option.some.inj (hs'.symm.trans hs)
+    exact Or.inl ⟨W, hW, ha, h.meets W hW call hc obs' hs'⟩
+  · exact Or.inr e
+
+/-- The obligations compose from their parts: a source total in every admitted world, its
+specification in every admitted world, and the per-run equivalence of the bytecode. -/
+theorem OpenFunctional.of_parts {fuel : Nat} {c : SolidCore.Solidity.TypeCheck.CheckedContract}
+    {code : ByteArray} {EnvOk : TargetEnv → Prop} {Admit : World → Prop} {Valid : Call → Prop}
+    {Allowed Post : World → Call → Observable → Prop}
+    (hin : ∃ call, Valid call)
+    (heq : ∀ env, EnvOk env → ∀ gas, gas < 2 ^ 256 → ∀ call, Valid call → ∀ obs,
+      Target.runWithIn env gas code call = some obs →
+        (∃ W, Admit W ∧ Source.runIn W fuel c call = some obs) ∨ Inert call obs)
+    (hterm : ∀ W, Admit W → ∀ call, Valid call →
+      ∃ obs, Source.runIn W fuel c call = some obs ∧ Allowed W call obs)
+    (hspec : ∀ W, Admit W → Meets (solidCoreIn W fuel) c Valid (Post W)) :
+    OpenFunctional fuel c code EnvOk Admit Valid Allowed Post :=
+  ⟨hin, heq, hterm, fun W hW => hspec W hW⟩
+
+/-- info: 'SolidCore.Refinement.Shapes.OpenFunctional.bytecode_any' depends on axioms: [propext, Classical.choice, Quot.sound] -/
+#guard_msgs (whitespace := lax) in
+#print axioms OpenFunctional.bytecode_any
+
+end SolidCore.Refinement.Shapes
+
