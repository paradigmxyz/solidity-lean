 # tools/certify/sandbox.sh, output to LOG. SPEC names the modules the step may rebuild, as
@@ -102,11 +108,38 @@ run() { "${wrap[@]}" "$@"; }
 # lean process of a sandboxed step in a further sandbox that may write only its own outputs), put
 # first on PATH for every sandboxed step, so that no module's code can write another's olean.
 iso_bin=
+# resolve_toolchain: the toolchain directory, found once per run (from the lean lake runs), which
+# must be the toolchain tools/certify/toolchain.sha256 records (a digest of every file's SHA-256).
+# The driver runs lean and leanchecker by absolute path from it, never as lake env finds them:
+# lake env puts each workspace package's .lake/build/bin first on PATH, and a lakefile runs code
+# when lake evaluates it, so a binary planted there could stand in for either.
+toolchain=
+resolve_toolchain() {
+    [[ -z "$toolchain" ]] || return 0
+    local dir tc
+    dir="$(cd "$(dirname "$(readlink -f "$(cd "$lean_dir" && lake env which lean)")")/.." && pwd)" ||
+        die "cannot find the toolchain"
+    tc="$(cd "$dir" && find . -type f | sort | xargs -d '\n' sha256sum | sha256sum | cut -c1-64)" ||
+        die "cannot digest the toolchain at $dir"
+    [[ "$tc" == "$(tr -d '[:space:]' < "$here/toolchain.sha256")" ]] ||
+        die "the toolchain at $dir is not the one tools/certify/toolchain.sha256 records"
+    [[ -x "$dir/bin/lean" && -x "$dir/bin/leanchecker" ]] || die "the toolchain at $dir has no bin/lean and bin/leanchecker"
+    toolchain=$dir
+}
+# no_planted_bins: a build bin directory in the checkout or its path dependencies (outside the
+# upstream packages) holds executables lake env would run before the toolchain's; the driver runs
+# lean and leanchecker by absolute path anyway, and such a directory fails the run.
+no_planted_bins() {
+    local found
+    found="$(find "$lean_dir" -path "$lean_dir/.lake/packages" -prune -o -type d -path '*/.lake/build/bin' -print)" ||
+        die "cannot search $lean_dir for build bin directories"
+    [[ -z "$found" ]] || die "the checkout has executables lake env would run before the toolchain's: $(head -3 <<<"$found" | tr '\n' ' ')"
+}
 iso_setup() {
     [[ -n "$iso_bin" ]] && return
     local tcroot
-    tcroot="$(cd "$(dirname "$(readlink -f "$(cd "$lean_dir" && lake env which lean)")")/.." && pwd)" ||
-        die "cannot find the toolchain"
+    resolve_toolchain
+    tcroot=$toolchain
     export CERTIFY_REAL_LEAN="$tcroot/bin/lean" CERTIFY_ISO_DIR="$lean_dir/.lake/build/.iso" CERTIFY_ISO_RO="$lean_dir/.lake/build"
     iso_bin="$(bash "$here/sysroot.sh" "$tcroot" "$lean_dir/.lake/certify-sysroot")" || die "cannot set up the isolated lean"
 }
@@ -190,13 +223,21 @@ mkdir -p "$dir"
 source="$dir/$name.sol"
 [[ "$file" == "$(realpath -m "$source")" ]] || cp "$file" "$source"
 if [[ ${#options[@]} -eq 0 ]]; then
-    if [[ -f "$dir/options" ]]; then mapfile -t options < "$dir/options"; else options=(-Ogas --evm-version osaka); fi
+    if [[ -f "$dir/options" ]]; then
+        mapfile -t options < "$dir/options"
+        check_options "$dir/options" "${options[@]}"
+    else
+        options=(-Ogas --evm-version osaka)
+    fi
 fi
+# Checked before anything is written or compiled: one option per line, each a flag or its value.
+check_options "the solar options" "${options[@]}"
 printf '%s\n' "${options[@]}" > "$dir/options"
 if [[ -n "$loops" ]]; then
     if [[ "$loops" -eq 0 ]]; then rm -f "$dir/loops"; else echo "$loops" > "$dir/loops"; fi
 fi
-loops="$(cat "$dir/loops" 2>/dev/null || echo 0)"
+if [[ -e "$dir/loops" ]]; then loops="$(cat "$dir/loops")" || die "cannot read $dir/loops"; else loops=0; fi
+check_number "$dir/loops" "$loops"
 # CERTIFIED/NAME/heartbeats, when present, is the run proofs' maxHeartbeats (certify.py's
 # --heartbeats), for a contract whose symbolic runs need more than the default: a larger budget
 # can only let a proof pass, never change what it states.
@@ -217,7 +258,8 @@ if [[ -n "${SOLAR:-}" ]]; then
     solar="$(realpath "$SOLAR")"
 else
     if [[ -z "${CERTIFY_SKIP_BUILD:-}" ]]; then
-        (cd "$root" && run cargo build --locked -j "$CARGO_BUILD_JOBS" --bin solar 2>&1 | tail -n 1)
+        (cd "$root" && run cargo build --locked -j "$CARGO_BUILD_JOBS" --bin solar 2>&1 | tail -n 1) ||
+            die "cargo cannot build solar"
     fi
     solar="${CARGO_TARGET_DIR:-$root/target}/debug/solar"
 fi
@@ -225,8 +267,9 @@ fi
 # The compiler must be an executable the toolchain linked, never a script that could forward
 # --version to one binary and compile with another.
 [[ "$(head -c 4 "$solar" | od -An -tx1 | tr -d ' \n')" == 7f454c46 ]] || die "$solar is not an ELF executable"
-version="$("$solar" --version | sed -n 's/^Commit SHA: //p')"
-[[ "$version" =~ ^[0-9a-f]{40}$ ]] || version="$("$solar" --version | sed -n 's/.*+commit\.\([0-9a-f]\{8\}\).*/\1/p' | head -1)"
+version_out="$("$solar" --version)" || die "$solar --version fails"
+version="$(sed -n 's/^Commit SHA: //p' <<<"$version_out")"
+[[ "$version" =~ ^[0-9a-f]{40}$ ]] || version="$(sed -n 's/.*+commit\.\([0-9a-f]\{8\}\).*/\1/p' <<<"$version_out" | sed -n 1p)"
 [[ -n "$version" ]] || die "cannot read the compiler commit from $solar --version"
 if ! { git -C "$root" diff --quiet HEAD -- crates Cargo.toml Cargo.lock &&
     git -C "$root" cat-file -e "$version^{commit}" 2>/dev/null &&
@@ -248,14 +291,15 @@ echo "solar $version"
 # file hashed from disk, untracked and ignored files counted), except for the outputs the driver
 # writes under Certified/*/; final's closure is checked again below against this contract's own.
 generated='^Certified/[a-z][a-z0-9_]*/(Statement\.lean|Final\.lean|record\.json|options|loops|\.compile\.log|Shape\.lean|VC\.lean|VC/.*|Discharge\.lean|Discharge/.*|SpecConnect\.lean|gen/.*|Proofs/.*)$'
-dirty="$(python3 "$here/clean_tree.py" "$lean_dir" --allow "$generated")" || true
+tree_diff dirty "clean_tree.py on the solidity-lean checkout" python3 "$here/clean_tree.py" "$lean_dir" --allow "$generated"
 [[ -z "$dirty" ]] ||
     caveats+=("provenance: the solidity-lean checkout is not its commit: $(head -5 <<<"$dirty" | tr '\n' ';')")
 # The driver and the compiler sources of this checkout, the same way.
-driver_dirty="$(python3 "$here/clean_tree.py" "$root" --prefix scripts --prefix tools/certify --prefix crates --prefix Cargo.toml --prefix Cargo.lock)" || true
+tree_diff driver_dirty "clean_tree.py on the solar checkout" \
+    python3 "$here/clean_tree.py" "$root" --prefix scripts --prefix tools/certify --prefix crates --prefix Cargo.toml --prefix Cargo.lock
 [[ -z "$driver_dirty" ]] ||
     caveats+=("provenance: the solar checkout (driver or compiler sources) is not its commit $(git -C "$root" rev-parse HEAD): $(head -5 <<<"$driver_dirty" | tr '\n' ';')")
-solar_sha="$(sha256sum "$solar" | cut -c1-64)"
+solar_sha="$(sha256sum "$solar" | cut -c1-64)" || die "cannot digest $solar"
 # Only a compiler this run built counts: a binary named by SOLAR or kept by CERTIFY_SKIP_BUILD is a
 # caveat whatever digest the runner records for it (CERTIFY_SOLAR_SHA256 is the runner's word).
 if [[ -n "${SOLAR:-}" || -n "${CERTIFY_SKIP_BUILD:-}" ]]; then
@@ -272,9 +316,13 @@ if [[ "${CERTIFY_CLEAN_BUILD:-}" == 1 ]]; then
     # build directories, lake's configuration cache, and every file the driver kept (the replay
     # cache among them), so that every module is compiled and replayed again from its source; the
     # upstream git-pinned packages under .lake/packages stay trusted by directory.
-    while IFS= read -r -d '' b; do rm -rf "$b"; done < <(find "$lean_dir" -path "$lean_dir/.lake/packages" -prune -o -type d -path '*/.lake/build' -print0 -prune)
+    find "$lean_dir" -path "$lean_dir/.lake/packages" -prune -o -type d -path '*/.lake/build' -prune -exec rm -rf {} + ||
+        die "cannot remove the build directories of $lean_dir"
     rm -rf "$lean_dir/.lake/build" "$lean_dir/.lake/config"
-    find "$lean_dir/.lake" -maxdepth 1 -name 'certify*' -exec rm -rf {} +
+    # A fresh checkout has no .lake yet: nothing of the driver's to remove.
+    if [[ -d "$lean_dir/.lake" ]]; then
+        find "$lean_dir/.lake" -maxdepth 1 -name 'certify*' -exec rm -rf {} + || die "cannot remove the driver's files in $lean_dir/.lake"
+    fi
     mkdir -p "$lean_dir/.lake/build"
     # The path dependencies (vendor/, committed and checked above) build here, before any module of
     # the run's own proofs exists, since the sandboxed steps may write the package's build only.
@@ -287,32 +335,61 @@ echo "solar sha256 $solar_sha"
 
 echo "== 3. compile $source and export its stages (${options[*]})"
 compile() { "$solar" "$source" "${options[@]}" --emit=bin-runtime "$@"; }
-json="$(compile 2>"$dir/.compile.log")" || { cat "$dir/.compile.log" >&2; die "solar does not compile $source"; }
+# solar's status is checked on its own, never through a pipe: output it printed before failing
+# counts for nothing.
+status=0
+json="$(compile 2>"$dir/.compile.log")" || status=$?
+if [[ $status -ne 0 ]]; then cat "$dir/.compile.log" >&2; die "solar does not compile $source (exit $status)"; fi
 rm -f "$dir/.compile.log"
 if [[ -z "$contract" ]]; then
     contract="$(python3 -c '
 import json, sys
 c = [k.rsplit(":", 1)[1] for k, v in json.loads(sys.argv[1])["contracts"].items() if v.get("bin-runtime")]
 print(c[0] if len(c) == 1 else "")
-' "$json")"
+' "$json")" || die "cannot read solar's output for $source as its JSON"
     [[ -n "$contract" ]] || die "$source has no single contract with runtime code; name one with --contract"
 fi
+# bin_runtime WHAT: the runtime bytecode of the contract in solar's JSON on stdin, failing with
+# WHAT when the output is not JSON, has no such contract, or has no bin-runtime string for it.
 bin_runtime() {
-    python3 -c 'import json, sys; print(json.loads(sys.stdin.read())["contracts"][sys.argv[1]]["bin-runtime"])' \
-        "$source:$contract"
+    python3 -c '
+import json, sys
+what, key = sys.argv[1], sys.argv[2]
+try:
+    out = json.loads(sys.stdin.read())
+except ValueError as e:
+    sys.exit(f"certify: error: {what} is not JSON: {e}")
+contracts = out.get("contracts") if isinstance(out, dict) else None
+if not isinstance(contracts, dict) or key not in contracts:
+    sys.exit(f"certify: error: {what} has no contract {key}")
+v = contracts[key].get("bin-runtime") if isinstance(contracts[key], dict) else None
+if v is None:
+    sys.exit(f"certify: error: {what} has no runtime bytecode (bin-runtime) for {key}")
+if not isinstance(v, str):
+    sys.exit(f"certify: error: {what} has a bin-runtime for {key} that is not a string")
+print(v)
+' "$1" "$source:$contract"
 }
-plain="$(bin_runtime <<<"$json")" || die "$source has no contract $contract"
-[[ -n "$plain" ]] || die "$contract has no runtime code"
+plain="$(bin_runtime "solar's output" <<<"$json")" || die "$source has no contract $contract with runtime bytecode (above)"
+check_hex "the runtime bytecode solar emits for $contract" "$plain"
 rm -rf "$dir/gen"
-if ! exported="$(compile "-Zemit-lean-stages=$dir/gen" 2>"$dir/.export.log" | bin_runtime 2>/dev/null)"; then
+status=0
+exported_json="$(compile "-Zemit-lean-stages=$dir/gen" 2>"$dir/.export.log")" || status=$?
+if [[ $status -ne 0 ]]; then
     grep -E '^error' -A3 "$dir/.export.log" >&2 || cat "$dir/.export.log" >&2
     rm -f "$dir/.export.log"
-    die "the exporter rejects $contract (above): outside the fragment the stages have Lean semantics for"
+    die "the exporter rejects $contract (exit $status, above): outside the fragment the stages have Lean semantics for"
 fi
 rm -f "$dir/.export.log"
+exported="$(bin_runtime "solar's output with -Zemit-lean-stages" <<<"$exported_json")" ||
+    die "the export of $contract has no runtime bytecode (above)"
+check_hex "the runtime bytecode solar emits for $contract with -Zemit-lean-stages" "$exported"
 [[ "$plain" == "$exported" ]] || die "-Zemit-lean-stages changed the bytecode"
-if [[ -f "$dir/bytecode.hex" ]]; then
-    [[ "$plain" == "$(tr -d '[:space:]' < "$dir/bytecode.hex")" ]] ||
+if [[ -e "$dir/bytecode.hex" ]]; then
+    [[ -f "$dir/bytecode.hex" ]] || die "$dir/bytecode.hex is not a file"
+    pinned="$(tr -d '[:space:]' < "$dir/bytecode.hex")" || die "cannot read $dir/bytecode.hex"
+    check_hex "the pinned $dir/bytecode.hex" "$pinned"
+    [[ "$plain" == "$pinned" ]] ||
         die "the bytecode is not the pinned $dir/bytecode.hex: $plain"
 else
     echo "$plain" > "$dir/bytecode.hex"
@@ -340,7 +417,10 @@ rm -rf "$dir/Proofs" "$dir/Proofs.lean"
 info="$(python3 "$here/certify.py" "$gen" --gen-module "$name.gen.$contract" \
     --proof-dir "$dir/Proofs" --proof-module "$name.Proofs" --namespace "SolarTV.Milestone.$cap" \
     --label "$name" --loops "$loops" --heartbeats "$heartbeats" "${joins[@]}" ${recdepth:+--recdepth "$recdepth"})" || die "certify.py cannot write the proofs"
-final="$(python3 -c 'import json, sys; print(json.loads(sys.argv[1])["final"])' "$info")"
+final="$(python3 -c 'import json, sys; print(json.loads(sys.argv[1])["final"])' "$info")" ||
+    die "certify.py's output names no final theorem"
+ident_re="^[A-Za-z_][A-Za-z0-9_.']*$"
+[[ "$final" =~ $ident_re ]] || die "certify.py names the final theorem '$final', which is not a Lean name"
 echo "$info"
 
 echo "== 5. build and audit the proofs"
@@ -378,8 +458,20 @@ bash "$here/audit.sh" scan "$dir" || die "the generated files of $name fail the
 mkdir -p .lake
 log="$lean_dir/.lake/certify-$name.log"
 rm -f "$lean_dir/.lake/certify-vacuous-$name" "$lean_dir/.lake/certify-$name.json.binding"
-mapfile -t stages < <(cd "$examples" && ls "$name/gen/$contract"/*.lean | sed 's|\.lean$||; s|/|.|g')
-mapfile -t runs < <(cd "$examples" && ls "$name"/Proofs/Runs/*.lean | sed 's|\.lean$||; s|/|.|g')
+# lean_modules DIR: the module of each .lean file directly in $examples/DIR, sorted; fails when
+# DIR is missing.
+lean_modules() {
+    local f
+    [[ -d "$examples/$1" ]] || { echo "certify: error: no directory $examples/$1" >&2; return 1; }
+    for f in "$examples/$1"/*.lean; do
+        [[ -f "$f" ]] || continue
+        f="${f#"$examples/"}"
+        f="${f%.lean}"
+        printf '%s\n' "${f//\//.}"
+    done
+}
+capture_nonempty stages "the list of $contract's exported stages ($dir/gen/$contract)" lean_modules "$name/gen/$contract"
+capture_nonempty runs "the list of the run proofs ($dir/Proofs/Runs)" lean_modules "$name/Proofs/Runs"
 # One module at a time, so that one Lean process runs at a time: the exported stages, which the
 # proofs import, then the proofs.
 # The execution proof, when certify.py writes one (the final EVM IR inside the assembly checker's
@@ -395,8 +487,16 @@ for module in "${stages[@]}" "${runs[@]}" "$name.Proofs.Stages" "$name.Proofs.As
     tail -n 1 "$log"
 done
 
-mapfile -t thms < <(grep -rhoE '^theorem [A-Za-z0-9_'"'"']+' "$dir/Proofs" | awk '{print $2}' | sort -u |
-    sed "s/^/SolarTV.Milestone.$cap./")
+# proof_theorems: the theorems $dir/Proofs declares, qualified; none is an empty list (grep's 1),
+# and grep failing otherwise fails the run.
+proof_theorems() {
+    local hits status=0
+    hits="$(grep -rhoE '^theorem [A-Za-z0-9_'"'"']+' "$dir/Proofs")" || status=$?
+    [[ $status -le 1 ]] || return "$status"
+    [[ -n "$hits" ]] || return 0
+    awk '{print $2}' <<<"$hits" | sort -u | sed "s/^/SolarTV.Milestone.$cap./"
