@@ -87,9 +87,15 @@ if [[ "${CI:-}" == true || -n "${GITHUB_ACTIONS:-}" ]]; then
     done
 fi
 hthms=()
+# CERTIFY_WRAP prefixes the builds (a job slot limiter); the checker and the kernel replay never run
+# through it, and a run with one set says so.
+[[ -z "${CERTIFY_WRAP:-}" ]] || caveats+=("provenance: the builds ran through CERTIFY_WRAP=${CERTIFY_WRAP}")
 
 die() { echo "certify: error: $*" >&2; exit 1; }
 run() { "${wrap[@]}" "$@"; }
+# capture, tree_diff and the checks of the run's inputs: every producer's exit status is checked.
+# shellcheck source=tools/certify/inputs.sh
