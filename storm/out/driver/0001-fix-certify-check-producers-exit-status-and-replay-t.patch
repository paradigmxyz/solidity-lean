new file mode 100755
index 00000000..5de8e0cd
--- /dev/null
+++ b/tools/certify/export_check.py
@@ -0,0 +1,84 @@
+#!/usr/bin/env python3
+"""Checks that a Lean export of solar-verify is whole before the driver builds or reads it.
+
+    export_check.py vc FILE NAMESPACE
+        --dump-lean's verification conditions: the generator's comment, import Verify.VC.Term,
+        namespace NAMESPACE once, the script and transcript definitions, and end NAMESPACE as the
+        last line, ended by a newline
+    export_check.py spec FILE MODULE --source SOURCE [--contract CONTRACT]
+        --emit-lean-spec's specification: import Verify.Spec.Contract first, namespace MODULE once,
+        its manifest with SOURCE's SHA-256, the contract's Bundle (CONTRACT's, when named), the
+        trusted list, and end MODULE as the last line, ended by a newline
+
+A truncated file (a producer killed halfway, a full disk, a stale partial file) lacks the end line
+or the definitions after the cut, and fails with what is missing. Exit 0 whole, 1 not.
+"""
+import hashlib
+import re
+import sys
+
+
+def fail(msg):
+    print(f"certify: error: {msg}", file=sys.stderr)
+    sys.exit(1)
+
+
+def main():
+    a = sys.argv[1:]
+    if len(a) < 3 or a[0] not in ("vc", "spec") or len(a) % 2 == 0:
+        fail("usage: export_check.py vc FILE NAMESPACE | spec FILE MODULE --source SOURCE [--contract C]")
+    kind, path, ns = a[0], a[1], a[2]
+    opts = dict(zip(a[3::2], a[4::2]))
+    try:
+        data = open(path, "rb").read()
+    except OSError as e:
+        fail(f"the {kind} export is missing: {e}")
+    if not data.strip():
+        fail(f"the {kind} export {path} is empty")
+    try:
+        text = data.decode("utf-8")
+    except UnicodeDecodeError as e:
+        fail(f"the {kind} export {path} is not UTF-8 (cut inside a character?): {e}")
+    if not text.endswith("\n"):
+        fail(f"the {kind} export {path} does not end with a newline: it is truncated")
+    lines = text.split("\n")[:-1]
+    last = next((l for l in reversed(lines) if l.strip()), "")
+    if last != f"end {ns}":
+        fail(f"the {kind} export {path} does not end with 'end {ns}' (its last line is {last[:80]!r}): it is truncated")
+    opens = [l for l in lines if l == f"namespace {ns}"]
+    if len(opens) != 1:
+        fail(f"the {kind} export {path} opens namespace {ns} {len(opens)} times, not once")
+    ends = [l for l in lines if l == f"end {ns}"]
+    if len(ends) != 1:
+        fail(f"the {kind} export {path} closes namespace {ns} {len(ends)} times, not once")
+    if kind == "vc":
+        if not lines[0].startswith("-- Generated by solar-verify --dump-lean"):
+            fail(f"the vc export {path} does not start with solar-verify's comment")
+        for need in ("import Verify.VC.Term", "def script : List Cmd := [", "def transcript : String := "):
+            if not any(l.startswith(need) for l in lines):
+                fail(f"the vc export {path} has no '{need.strip()}'")
+    else:
+        if lines[0] != "import Verify.Spec.Contract":
+            fail(f"the spec export {path} does not start with import Verify.Spec.Contract")
+        for need in ("def manifest : Manifest :=", "def trusted : List String :="):
+            if not any(l.startswith(need) for l in lines):
+                fail(f"the spec export {path} has no '{need}'")
+        bundles = [m.group(1) for l in lines if (m := re.match(r"^def (\S+) : Bundle where$", l))]
+        if not bundles:
+            fail(f"the spec export {path} defines no Bundle")
+        c = opts.get("--contract")
+        if c and c not in bundles:
+            fail(f"the spec export {path} has no Bundle {c} (it has {', '.join(bundles)})")
+        src = opts.get("--source")
+        if not src:
+            fail("export_check.py spec needs --source")
+        sha = hashlib.sha256(open(src, "rb").read()).hexdigest()
+        m = re.search(r'sourceSha256 := "([0-9a-f]{64})"', text)
+        if not m:
+            fail(f"the spec export {path} records no sourceSha256")
+        if m.group(1) != sha:
+            fail(f"the spec export {path} is of a source with SHA-256 {m.group(1)}, not {src} ({sha})")
+    print(f"export: {path} is whole ({len(lines)} lines, ends with end {ns})")
+
+
+main()
