 audit "$lean_dir/.lake/certify-audit-$name.out" "$name.Proofs" -- "${thms[@]}"
@@ -413,7 +513,40 @@ fi
 e2e_thms=()
 e2e_kind=""
 
+# prebuild_packages TARGET...: the modules of the lake packages (the manifest's, at its pinned
+# revisions) that the package modules reachable from the TARGETs import, built now, before any
+# module of the run's own statement or proofs is built, and outside the sandbox, which may write
+# only the package's own build directory. The packages' modules are not trusted for being built
+# here: every module of the published closure is replayed through the kernel below.
+prebuild_packages() {
+    local mods
+    capture mods "the list of the package modules $* import" python3 "$here/guard_build.py" packages "$lean_dir" "$@"
+    [[ ${#mods[@]} -gt 0 ]] || return 0
+    printf 'lake packages (%s modules imported): ' "${#mods[@]}"
