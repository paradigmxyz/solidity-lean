From 0d089b13876335c3498277c7a60db25393a76092 Mon Sep 17 00:00:00 2001
From: Troy Sargent <noreply@pyramid.tehq.net>
Date: Sat, 14 Nov 2026 18:44:26 +0000
Subject: [PATCH] fix(certify): add the helpers the driver sources

The driver sources tools/certify/inputs.sh and runs replay.py and
export_check.py, but the commit that started using them did not add
them, so every run stopped at its first line. Add the three files as
they were written for that change.
---
 tools/certify/export_check.py |  84 ++++++++++++++++
 tools/certify/inputs.sh       | 142 ++++++++++++++++++++++++++
 tools/certify/replay.py       | 183 ++++++++++++++++++++++++++++++++++
 3 files changed, 409 insertions(+)
 create mode 100755 tools/certify/export_check.py
 create mode 100755 tools/certify/inputs.sh
 create mode 100755 tools/certify/replay.py

diff --git a/tools/certify/export_check.py b/tools/certify/export_check.py
new file mode 100755
index 00000000..5de8e0cd
--- /dev/null
+++ b/tools/certify/export_check.py
@@ -0,0 +1,84 @@
+#!/usr/bin/env python3
+"""Checks that a Lean export of solar-verify is whole before the driver builds or reads it.
+
+    export_check.py vc FILE NAMESPACE
+        --dump-lean's verification conditions: the generator's comment, import Verify.VC.Term,
+        namespace NAMESPACE once, the script and transcript definitions, and end NAMESPACE as the
+        last line, ended by a newline
+    export_check.py spec FILE MODULE --source SOURCE [--contract CONTRACT]
+        --emit-lean-spec's specification: import Verify.Spec.Contract first, namespace MODULE once,
+        its manifest with SOURCE's SHA-256, the contract's Bundle (CONTRACT's, when named), the
+        trusted list, and end MODULE as the last line, ended by a newline
+
+A truncated file (a producer killed halfway, a full disk, a stale partial file) lacks the end line
+or the definitions after the cut, and fails with what is missing. Exit 0 whole, 1 not.
+"""
+import hashlib
+import re
+import sys
+
+
+def fail(msg):
+    print(f"certify: error: {msg}", file=sys.stderr)
+    sys.exit(1)
+
+
+def main():
+    a = sys.argv[1:]
+    if len(a) < 3 or a[0] not in ("vc", "spec") or len(a) % 2 == 0:
+        fail("usage: export_check.py vc FILE NAMESPACE | spec FILE MODULE --source SOURCE [--contract C]")
+    kind, path, ns = a[0], a[1], a[2]
+    opts = dict(zip(a[3::2], a[4::2]))
+    try:
+        data = open(path, "rb").read()
+    except OSError as e:
+        fail(f"the {kind} export is missing: {e}")
+    if not data.strip():
+        fail(f"the {kind} export {path} is empty")
+    try:
+        text = data.decode("utf-8")
+    except UnicodeDecodeError as e:
+        fail(f"the {kind} export {path} is not UTF-8 (cut inside a character?): {e}")
+    if not text.endswith("\n"):
+        fail(f"the {kind} export {path} does not end with a newline: it is truncated")
+    lines = text.split("\n")[:-1]
+    last = next((l for l in reversed(lines) if l.strip()), "")
+    if last != f"end {ns}":
+        fail(f"the {kind} export {path} does not end with 'end {ns}' (its last line is {last[:80]!r}): it is truncated")
+    opens = [l for l in lines if l == f"namespace {ns}"]
+    if len(opens) != 1:
+        fail(f"the {kind} export {path} opens namespace {ns} {len(opens)} times, not once")
+    ends = [l for l in lines if l == f"end {ns}"]
+    if len(ends) != 1:
+        fail(f"the {kind} export {path} closes namespace {ns} {len(ends)} times, not once")
+    if kind == "vc":
+        if not lines[0].startswith("-- Generated by solar-verify --dump-lean"):
+            fail(f"the vc export {path} does not start with solar-verify's comment")
+        for need in ("import Verify.VC.Term", "def script : List Cmd := [", "def transcript : String := "):
+            if not any(l.startswith(need) for l in lines):
+                fail(f"the vc export {path} has no '{need.strip()}'")
+    else:
+        if lines[0] != "import Verify.Spec.Contract":
+            fail(f"the spec export {path} does not start with import Verify.Spec.Contract")
+        for need in ("def manifest : Manifest :=", "def trusted : List String :="):
+            if not any(l.startswith(need) for l in lines):
+                fail(f"the spec export {path} has no '{need}'")
+        bundles = [m.group(1) for l in lines if (m := re.match(r"^def (\S+) : Bundle where$", l))]
+        if not bundles:
+            fail(f"the spec export {path} defines no Bundle")
+        c = opts.get("--contract")
+        if c and c not in bundles:
+            fail(f"the spec export {path} has no Bundle {c} (it has {', '.join(bundles)})")
+        src = opts.get("--source")
+        if not src:
+            fail("export_check.py spec needs --source")
+        sha = hashlib.sha256(open(src, "rb").read()).hexdigest()
+        m = re.search(r'sourceSha256 := "([0-9a-f]{64})"', text)
+        if not m:
+            fail(f"the spec export {path} records no sourceSha256")
+        if m.group(1) != sha:
+            fail(f"the spec export {path} is of a source with SHA-256 {m.group(1)}, not {src} ({sha})")
+    print(f"export: {path} is whole ({len(lines)} lines, ends with end {ns})")
+
+
+main()
diff --git a/tools/certify/inputs.sh b/tools/certify/inputs.sh
new file mode 100755
index 00000000..af549beb
--- /dev/null
+++ b/tools/certify/inputs.sh
@@ -0,0 +1,142 @@
+#!/usr/bin/env bash
+# Helpers scripts/certify sources (and tools/certify/test.sh tests directly): reading what a
+# producer prints without losing its exit status, and the checks of the run's inputs. Each fails
+# the run through the caller's die with an error that names what is wrong.
+#
+#   source tools/certify/inputs.sh
+
+declare -F die > /dev/null || die() { echo "certify: error: $*" >&2; exit 1; }
+
+# capture ARRAY WHAT CMD...: runs CMD (a command or a function) with its output to a file, as a
+# job of its own that is waited for, so that set -e holds inside it and its exit status is its own
+# (mapfile < <(CMD) and a pipe into while read both discard it), fails the run with WHAT unless it
+# exits 0, and only then reads its lines into ARRAY.
+capture() {
+    local -n capture_into=$1
+    local what=$2 out status=0
+    shift 2
+    out="$(mktemp "${TMPDIR:-/tmp}/certify-capture.XXXXXX")" || die "cannot make a temporary file for $what"
+    "$@" > "$out" &
+    wait "$!" || status=$?
+    if [[ $status -ne 0 ]]; then
+        rm -f "$out"
+        die "$what fails (exit $status)"
+    fi
+    mapfile -t capture_into < "$out"
+    rm -f "$out"
+}
+
+# capture_nonempty ARRAY WHAT CMD...: capture, and fail the run when CMD prints nothing.
+capture_nonempty() {
+    capture "$@"
+    local -n capture_seen=$1
+    [[ ${#capture_seen[@]} -gt 0 ]] || die "$2 prints nothing"
+}
+
+# entries FILE...: the lines of the FILEs that are neither blank nor comments (# ...); none is an
+# empty list, an unreadable file fails.
+entries() {
+    local status=0
+    [[ $# -gt 0 ]] || { echo "certify: error: entries: no file" >&2; return 2; }
+    grep -hvE '^\s*(#|$)' "$@" || status=$?
+    [[ $status -le 1 ]] || return "$status"
+}
+
+# tree_diff VAR WHAT CMD...: runs tools/certify/clean_tree.py (CMD), which exits 0 with nothing
+# printed for a clean tree and 1 with one line per difference; any other outcome (another status,
+# or 1 with nothing printed, as an uncaught exception gives) fails the run, never reads as clean.
+tree_diff() {
+    local -n tree_into=$1
+    local what=$2 out status=0
+    shift 2
+    out="$(mktemp "${TMPDIR:-/tmp}/certify-tree.XXXXXX")" || die "cannot make a temporary file for $what"
+    "$@" > "$out" &
+    wait "$!" || status=$?
+    tree_into="$(cat "$out")"
+    rm -f "$out"
+    case "$status" in
+        0) [[ -z "$tree_into" ]] || die "$what exits 0 but lists differences" ;;
+        1) [[ -n "$tree_into" ]] || die "$what fails (exit 1 with no difference listed)" ;;
+        *) die "$what fails (exit $status)" ;;
+    esac
+}
+
+# check_options WHAT OPTION...: the solar options of a run: at least one, each one word of visible
+# characters (no empty line, space, tab or carriage return), none of those the driver sets itself
+# (what solar emits and where), and no word that is not a flag or the value of the flag before it
+# (such as a second source file).
+check_options() {
+    local what=$1 o prev=
+    shift
+    [[ $# -gt 0 ]] || die "$what: no solar options (the defaults are -Ogas --evm-version osaka)"
+    for o in "$@"; do
+        [[ "$o" =~ ^[[:graph:]]+$ ]] || die "$what: '$(printf '%q' "$o")' is not one word of visible characters"
+        case "$o" in
+            --emit|--emit=*|-Zemit-lean-stages|-Zemit-lean-stages=*|-o|--out-dir|--out-dir=*|-|--stdin)
+                die "$what: $o is set by the driver, not an option of the run" ;;
+        esac
+        if [[ "$o" != -* ]]; then
+            [[ -n "$prev" && "$prev" != *=* ]] || die "$what: $o is neither a flag nor the value of one"
+            [[ "$o" != *.sol && "$o" != *.yul && "$o" != *.json && "$o" != */* ]] ||
+                die "$what: $o names a file, not an option value"
+            prev=
+        else
+            prev=$o
+        fi
+    done
+}
+
+# check_number WHAT VALUE: a decimal number.
+check_number() {
+    [[ "$2" =~ ^[0-9]+$ ]] || die "$1 is not a number: '$(printf '%q' "$2")'"
+}
+
+# check_hex WHAT VALUE: bytecode as solar prints it: a non-empty, even-length run of lowercase hex
+# digits.
+check_hex() {
+    [[ -n "$2" ]] || die "$1 is empty"
+    [[ "$2" =~ ^([0-9a-f]{2})+$ ]] || die "$1 is not hex bytes: '$(head -c 80 <<<"$2")'"
+}
+
+# check_final_record FILE: the record tools/certify/final.py writes of the published statement: a
+# JSON object with the theorem, the statement's kind and text, each status as text and strongest
+# as a boolean. A missing, empty, truncated or incomplete record fails the run; the statuses are
+# never taken from anything else.
+check_final_record() {
+    python3 - "$1" <<'PYEOF' || die "the record of the published statement $1 is missing or malformed (above)"
+import json, sys
+path = sys.argv[1]
+try:
+    text = open(path).read()
+except OSError as e:
+    sys.exit(f"certify: error: no record: {e}")
+if not text.strip():
+    sys.exit(f"certify: error: {path} is empty")
+try:
+    d = json.loads(text)
+except ValueError as e:
+    sys.exit(f"certify: error: {path} is not JSON: {e}")
+if not isinstance(d, dict):
+    sys.exit(f"certify: error: {path} is not a JSON object")
+need = {"module": str, "statement_module": str, "theorem": str, "kind": str, "statement": str,
+        "statuses": dict, "strongest": bool, "excluded": list}
+bad = [k for k, t in need.items() if not isinstance(d.get(k), t) or (t is str and not d[k].strip())]
+if bad:
+    sys.exit(f"certify: error: {path} lacks {', '.join(bad)}")
+for k in ("equivalence", "termination", "spec", "resources"):
+    if not isinstance(d["statuses"].get(k), str) or not d["statuses"][k]:
+        sys.exit(f"certify: error: {path} has no status {k}")
+if "assumptions" not in d:
+    sys.exit(f"certify: error: {path} lacks assumptions")
+PYEOF
+}
+
+# check_run_record FILE: the run's record: a JSON object whose statuses say strongest as a boolean.
+check_run_record() {
+    python3 -c '
+import json, sys
+d = json.load(open(sys.argv[1]))
+assert isinstance(d, dict) and isinstance(d.get("statuses"), dict), "no statuses"
+assert isinstance(d["statuses"].get("strongest"), bool), "strongest is not a boolean"
+' "$1" || die "the run's record $1 is missing or malformed"
+}
diff --git a/tools/certify/replay.py b/tools/certify/replay.py
new file mode 100755
index 00000000..4aac9c48
--- /dev/null
+++ b/tools/certify/replay.py
@@ -0,0 +1,183 @@
+#!/usr/bin/env python3
+"""The accounting of the kernel replay of a published statement's closure (scripts/certify 6b).
+
+    replay.py plan CHECK_LOG OUT --syslib DIR [--require MODULE]... [--include-trusted]
+        reads the "MODULE NAME PATH replay|trusted IMPORTS..." lines tools/certify/check_final.lean
+        printed for the closure and writes OUT, one line per module: "replay NAME SHA256 PATH" for
+        each module leanchecker must replay in this run, "trusted NAME SHA256 PATH WHY" for each it
+        trusts by directory (WHY: toolchain, or package:DIR). It decides trust again itself, from
+        DIR (the toolchain's lib/lean) and CERTIFY_TRUSTED_ROOTS: a module the checker marks
+        trusted but that is under none of those directories with one of their roots is refused,
+        never trusted. Fails on no closure, a malformed or duplicated line, a REQUIRED module
+        missing or trusted, and no module to replay. With --include-trusted every module is
+        replayed.
+    replay.py account PLAN CHECKER_OUT STATUS RECEIPT [--checker PATH --toolchain DIR]
+        STATUS is leanchecker --verbose's exit status and CHECKER_OUT its output, which prints
+        "replaying NAME" for each module it replays and stops with a non-zero status at the first
+        failure. Fails unless STATUS is 0, every module of PLAN to replay has its "replaying" line,
+        and every olean of PLAN still has the digest it had when planned; then writes RECEIPT (JSON:
+        the closure's size, each module replayed with its olean's digest, the trusted ones by
+        directory, those leanchecker replayed beyond the plan, and none unaccounted for) and prints
+        the count and the list. With --checker, the leanchecker that ran must be DIR's bin/leanchecker
+        (by real path), and the receipt records it with its digest.
+"""
+import hashlib
+import json
+import os
+import re
+import sys
+
+
+def fail(msg):
+    print(f"certify: error: {msg}", file=sys.stderr)
+    sys.exit(1)
+
+
+def sha(path):
+    with open(path, "rb") as f:
+        return hashlib.sha256(f.read()).hexdigest()
+
+
+def under(d, f):
+    return f.startswith(d.rstrip("/") + "/")
+
+
+def plan(argv):
+    if len(argv) < 2:
+        fail("usage: replay.py plan CHECK_LOG OUT --syslib DIR [--require MODULE]... [--include-trusted]")
+    log, out, rest = argv[0], argv[1], argv[2:]
+    syslib, required, include = None, [], False
+    i = 0
+    while i < len(rest):
+        if rest[i] == "--syslib" and i + 1 < len(rest):
+            syslib = os.path.realpath(rest[i + 1]); i += 2
+        elif rest[i] == "--require" and i + 1 < len(rest):
+            required.append(rest[i + 1]); i += 2
+        elif rest[i] == "--include-trusted":
+            include = True; i += 1
+        else:
+            fail(f"replay.py plan: unknown argument {rest[i]}")
+    if not syslib:
+        fail("replay.py plan needs --syslib")
+    pkgs = []
+    for e in os.environ.get("CERTIFY_TRUSTED_ROOTS", "").split(";"):
+        if not e:
+            continue
+        d, sep, roots = e.partition("=")
+        if not sep or not d:
+            fail(f"CERTIFY_TRUSTED_ROOTS has a malformed entry {e!r}")
+        pkgs.append((os.path.realpath(d), roots.split(",")))
+    try:
+        lines = [l for l in open(log).read().splitlines() if l.startswith("MODULE ")]
+    except OSError as e:
+        fail(f"no closure to account for: {e}")
+    if not lines:
+        fail(f"{log} lists no module of the closure")
+    seen, rows, bad = set(), [], []
+    for n, line in enumerate(lines, 1):
+        parts = line.split()
+        if len(parts) < 4 or parts[3] not in ("replay", "trusted") or not re.fullmatch(r"[^\s/]+", parts[1]):
+            fail(f"{log}: malformed closure line {n}: {line[:160]!r}")
+        _, mod, path, kind = parts[:4]
+        if mod in seen:
+            fail(f"{log}: module {mod} is listed twice")
+        seen.add(mod)
+        real = os.path.realpath(path)
+        if not os.path.isfile(real):
+            fail(f"{log}: the olean of {mod} at {path} does not exist")
+        root = mod.split(".", 1)[0]
+        why = "toolchain" if under(syslib, real) else next(
+            (f"package:{d}" for d, roots in pkgs if under(d, real) and root in roots), None)
+        if kind == "trusted" and why is None:
+            bad.append(f"{mod} ({path}) is marked trusted but is under no trusted directory")
+        if kind == "replay" or include:
+            rows.append(("replay", mod, sha(real), real, ""))
+        else:
+            rows.append(("trusted", mod, sha(real), real, why))
+    if bad:
+        fail("modules of the closure are unaccounted for: " + "; ".join(bad[:20]))
+    kinds = {mod: k for k, mod, *_ in rows}
+    for m in required:
+        if m not in kinds:
+            fail(f"the closure has no module {m}")
+        if kinds[m] != "replay":
+            fail(f"{m} is in the closure but would not be replayed")
+    if not any(k == "replay" for k, *_ in rows):
+        fail("the closure has no module to replay")
+    with open(out, "w") as f:
+        for k, mod, h, p, why in rows:
+            f.write(" ".join(x for x in (k, mod, h, p, why) if x) + "\n")
+    n_replay = sum(1 for r in rows if r[0] == "replay")
+    print(f"closure: {len(rows)} modules, {n_replay} to replay, {len(rows) - n_replay} trusted by directory")
+
+
+def account(argv):
+    if len(argv) not in (4, 8):
+        fail("usage: replay.py account PLAN CHECKER_OUT STATUS RECEIPT [--checker PATH --toolchain DIR]")
+    plan_file, checker_out, status, receipt = argv[:4]
+    opts = dict(zip(argv[4::2], argv[5::2]))
+    if len(argv) == 8 and set(opts) != {"--checker", "--toolchain"}:
+        fail("replay.py account: --checker and --toolchain go together")
+    checker = None
+    if opts:
+        want = os.path.realpath(os.path.join(opts["--toolchain"], "bin", "leanchecker"))
+        got = os.path.realpath(opts["--checker"])
+        if got != want or not os.path.isfile(got):
+            fail(f"the replay ran {opts['--checker']} ({got}), not the toolchain's leanchecker {want}")
+        checker = {"path": got, "sha256": sha(got)}
+    if not re.fullmatch(r"[0-9]+", status):
+        fail(f"leanchecker's exit status {status!r} is not a number")
+    try:
+        rows = [l.split() for l in open(plan_file).read().splitlines() if l]
+    except OSError as e:
+        fail(f"no replay plan: {e}")
+    if not rows:
+        fail(f"the replay plan {plan_file} is empty")
+    try:
+        out = open(checker_out, errors="replace").read()
+    except OSError as e:
+        fail(f"no leanchecker output: {e}")
+    if status != "0":
+        tail = "\n".join(out.splitlines()[-20:])
+        fail(f"leanchecker exits {status}: the kernel replay of the closure fails\n{tail}")
+    replayed = set(re.findall(r"^replaying (\S+)$", out, re.M))
+    planned = [r for r in rows if r[0] == "replay"]
+    trusted = [r for r in rows if r[0] == "trusted"]
+    if not planned:
+        fail(f"the replay plan {plan_file} names no module to replay")
+    missing = [r[1] for r in planned if r[1] not in replayed]
+    if missing:
+        fail(f"{len(missing)} of {len(planned)} modules of the closure were not replayed by leanchecker in this run: "
+             + ", ".join(missing[:20]) + (" ..." if len(missing) > 20 else ""))
+    changed = [r[1] for r in rows if not os.path.isfile(r[3]) or sha(r[3]) != r[2]]
+    if changed:
+        fail("oleans of the closure changed since they were planned: " + ", ".join(changed[:20]))
+    by_dir = {}
+    for r in trusted:
+        by_dir.setdefault(r[4], []).append(r[1])
+    planned_names = {r[1] for r in planned}
+    rec = {
+        "closure": len(rows),
+        "replayed_count": len(planned),
+        "replayed": [{"module": r[1], "olean_sha256": r[2]} for r in planned],
+        "trusted_count": len(trusted),
+        "trusted": {k: sorted(v) for k, v in sorted(by_dir.items())},
+        "replayed_beyond_plan": sorted(replayed - planned_names - {r[1] for r in trusted}),
+        "unaccounted": [],
+        "checker": dict(checker or {}, run="leanchecker --verbose", exit=0),
+    }
+    with open(receipt, "w") as f:
+        json.dump(rec, f, indent=2)
+        f.write("\n")
+    print(f"kernel replay: {len(planned)} of {len(planned)} modules of the closure outside the trusted directories "
+          f"replayed by leanchecker in this run; {len(trusted)} trusted by directory "
+          f"({', '.join(f'{k}: {len(v)}' for k, v in sorted(by_dir.items())) or 'none'}); 0 unaccounted; "
+          f"closure {len(rows)} = {len(planned)} + {len(trusted)}")
+    for r in planned:
+        print(f"replayed {r[1]} {r[2]}")
+
+
+if __name__ == "__main__":
+    if len(sys.argv) < 2 or sys.argv[1] not in ("plan", "account"):
+        fail("usage: replay.py plan ... | replay.py account ...")
+    (plan if sys.argv[1] == "plan" else account)(sys.argv[2:])
-- 
