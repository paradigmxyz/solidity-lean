+/-! ## Hash premises
+
+A published statement may rest on a keccak256 premise. The checker reports every one it finds in
+the statement, unfolding the statement's definitions (outside the toolchain and the upstream
+packages, never through theorems) down to the premise constants below, one line each:
+
+  PREMISE <class> <definition> <constant> <term>
+
+with <class> one of
+* scoped: `SolidCore.Spec.ScopedSep L`, keccak256 separated on the finite footprint `L` of a call
+  (docs/CERTIFICATION_TARGET.md, "Hash premises"), or `TrustedBase.KeccakSeparated (· ∈ L)` written
+  out;
+* global: a premise over every key (`MapSlotsSeparated`, `UniversalTransferSep`, `HashInj`, the
+  Factory's `KeccakModel`, or `KeccakSeparated` of any other predicate), a named computational
+  assumption;
+* refuted: a premise Lean proves false (`NestedSlotsSeparated` with a nested map, by pigeonhole,
+  `not_nestedSlotsSeparated`; `KeccakSeparated (fun _ => True)`, `not_keccakSeparated_univ`): the
+  statement is vacuous, and the checker refuses it.
+
+<definition> is the declaration whose value holds the occurrence and <term> the premise's argument,
+fully qualified, implicit arguments dropped, numerals as decimals and a variable the definition
+binds as `#name`: the driver's footprint check (tools/certify/footprint.py) substitutes concrete
+values for those and has the kernel decide the premise. The search is syntactic: a premise reached
+only through a theorem, or hidden behind an opaque constant, is not reported. -/
+
+def scopedPremise : Name := `SolidCore.Spec.ScopedSep
+def keccakSeparated : Name := `SolidCore.Spec.TrustedBase.KeccakSeparated
+def globalPremises : List Name :=
+  [`SolidCore.Spec.MapSlotsSeparated, `SolidCore.Spec.UniversalTransferSep,
+   `SolidCore.Verify.VC.Token.HashInj, `Contracts.UniswapV2.Factory.Create2.KeccakModel]
+def refutedPremises : List Name := [`SolidCore.Spec.NestedSlotsSeparated]
+def premiseConsts : List Name := scopedPremise :: keccakSeparated :: globalPremises ++ refutedPremises
+
+/-- Modules whose definitions are not unfolded: the toolchain's and the upstream packages'. -/
+def upstreamRoots : List Name :=
+  [`Init, `Std, `Lean, `Lake, `Mathlib, `Batteries, `Aesop, `Qq, `Plausible, `ProofWidgets,
+   `ImportGraph, `LeanSearchClient]
+
+/-- The explicit-argument mask of a constant's type (true: explicit). -/
+def explicitMask (env : Environment) (c : Name) : List Bool :=
+  match env.find? c with
+  | none => []
+  | some ci =>
+    let rec go : Expr → List Bool
+      | .forallE _ _ b bi => (bi == .default) :: go b
+      | .mdata _ e => go e
+      | _ => []
+    go ci.type
+
+/-- A term as Lean source: fully qualified constants, implicit arguments dropped, numerals as
+decimals, a bound variable as `#name` (`ns`: the binder names, innermost first). -/
+partial def showExpr (env : Environment) (ns : List Name) (e : Expr) : String :=
+  match e with
+  | .bvar i => "#" ++ (ns.getD i .anonymous).toString
+  | .const n _ => n.toString
+  | .lit (.natVal n) => toString n
+  | .lit (.strVal s) => s.quote
+  | .mdata _ e => showExpr env ns e
+  | .lam n _ b _ => s!"(fun {n} => {showExpr env (n :: ns) b})"
+  | .forallE n t b _ => s!"(∀ ({n} : {showExpr env ns t}), {showExpr env (n :: ns) b})"
+  | .letE n _ v b _ => s!"(let {n} := {showExpr env ns v}; {showExpr env (n :: ns) b})"
+  | .proj _ i s => s!"({showExpr env ns s}).{i + 1}"
+  | .app .. =>
+    let fn := e.getAppFn
+    let args := e.getAppArgs
+    if fn.isConstOf ``OfNat.ofNat && args.size == 3 then
+      match args[1]! with
+      | .lit (.natVal n) => toString n
+      | a => showExpr env ns a
+    else
+      let mask := match fn with
+        | .const c _ => explicitMask env c
+        | _ => []
+      let shown := (args.toList.zip (List.range args.size)).filterMap fun (a, i) =>
+        if mask.getD i true then some (showExpr env ns a) else none
+      "(" ++ " ".intercalate (showExpr env ns fn :: shown) ++ ")"
+  | _ => "_"
+
+/-- `fun x => x ∈ L` (either argument order of `Membership.mem`) with `L` not mentioning `x`. -/
+def memPred? (e : Expr) : Option Expr :=
+  match e.consumeMData with
+  | .lam _ _ b _ =>
+    let b := b.consumeMData
+    if b.isAppOfArity ``Membership.mem 5 then
+      let a3 := b.getArg! 3
+      let a4 := b.getArg! 4
+      if a4 == .bvar 0 && !a3.hasLooseBVar 0 then some (a3.lowerLooseBVars 1 1)
+      else if a3 == .bvar 0 && !a4.hasLooseBVar 0 then some (a4.lowerLooseBVars 1 1)
+      else none
+    else none
+  | _ => none
+
+/-- `fun _ => True`. -/
+def isUniv (e : Expr) : Bool :=
+  match e.consumeMData with
+  | .lam _ _ b _ => b.consumeMData.isConstOf ``True
+  | _ => false
+
+structure Premise where
+  cls : String
+  defn : Name
+  const : Name
+  term : String
+
+/-- The premise occurrences in `e`, the value of `d` (`ns`: binder names, innermost first). -/
+partial def findPremises (env : Environment) (d : Name) (ns : List Name) (e : Expr) :
+    Array Premise :=
+  let here : Option Premise :=
+    match e.getAppFn with
+    | .const c _ =>
+      let args := e.getAppArgs
+      let arg := fun i => (args[i]?).getD (.const .anonymous [])
+      if c == scopedPremise then
+        some ⟨"scoped", d, c, showExpr env ns (arg 0)⟩
+      else if c == keccakSeparated then
+        match memPred? (arg 0) with
+        | some l => some ⟨"scoped", d, c, showExpr env ns l⟩
+        | none => some ⟨if isUniv (arg 0) then "refuted" else "global", d, c, showExpr env ns (arg 0)⟩
+      else if refutedPremises.contains c then
+        -- NestedSlotsSeparated ms ns is false exactly when ns has a mapping slot below 2 ^ 256;
+        -- reported refuted unless its second argument is the empty list.
+        let nested := args[1]?.map (·.consumeMData.isAppOf ``List.nil) |>.getD false
+        some ⟨if nested then "global" else "refuted", d, c,
+          " ".intercalate (args.toList.map (showExpr env ns))⟩
+      else if globalPremises.contains c then
+        some ⟨"global", d, c, " ".intercalate ((args.toList.zip (List.range args.size)).filterMap
+          fun (a, i) => if (explicitMask env c).getD i true then some (showExpr env ns a) else none)⟩
+      else none
+    | _ => none
+  match here with
+  | some p => #[p]
+  | none =>
+    match e with
+    | .app f a => findPremises env d ns f ++ findPremises env d ns a
+    | .lam n t b _ => findPremises env d ns t ++ findPremises env d (n :: ns) b
+    | .forallE n t b _ => findPremises env d ns t ++ findPremises env d (n :: ns) b
+    | .letE n t v b _ => findPremises env d ns t ++ findPremises env d ns v ++ findPremises env d (n :: ns) b
+    | .mdata _ e => findPremises env d ns e
+    | .proj _ _ s => findPremises env d ns s
+    | _ => #[]
+
+/-- Every hash premise the statement `stmt` rests on, through the definitions it unfolds to. -/
+def hashPremises (env : Environment) (stmt : Name) : Array Premise := Id.run do
+  let upstream := fun (c : Name) =>
+    match env.getModuleIdxFor? c with
+    | some i => upstreamRoots.contains (env.header.moduleNames[i.toNat]!).getRoot
+    | none => false
+  let mut seen : NameSet := {}
+  let mut todo : Array Name := #[stmt]
+  let mut out : Array Premise := #[]
+  while h : todo.size > 0 do
+    let c := todo.back
+    todo := todo.pop
+    if seen.contains c then continue
+    seen := seen.insert c
+    if premiseConsts.contains c || upstream c then continue
+    let some (.defnInfo v) := env.find? c | continue
+    let used := v.value.getUsedConstants
+    if used.any premiseConsts.contains then
+      out := out ++ findPremises env c [] v.value
+    for u in used do
+      unless seen.contains u do todo := todo.push u
+  return out
+
 def main (args : List String) : IO UInt32 := do
   initSearchPath (← findSysroot)
   if let ["--closure", m] := args then
@@ -100,6 +266,14 @@ def main (args : List String) : IO UInt32 := do
