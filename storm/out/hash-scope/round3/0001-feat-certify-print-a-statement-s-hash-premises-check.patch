   if axs.isEmpty then
     return ← fail s!"{finalThm} depends on no axiom at all: a published statement's proof uses propext, Classical.choice or Quot.sound"
+  -- The hash premises the statement rests on, each printed; a refuted one makes it vacuous.
+  let prems := hashPremises senv stmt
+  for p in prems do
+    IO.println s!"PREMISE {p.cls} {p.defn} {p.const} {p.term}"
+  if prems.isEmpty then
+    IO.println "PREMISE none"
+  if let some p := prems.find? (·.cls == "refuted") then
+    return ← fail s!"{stmt} rests on {p.const} {p.term} (in {p.defn}), which Lean proves false: the statement is vacuous"
