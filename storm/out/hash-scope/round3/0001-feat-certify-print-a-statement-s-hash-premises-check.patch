   -- replay through the kernel (leanchecker): an olean records declarations without the kernel
   -- having to have checked them, so the types and axioms read here are only as good as that replay.
diff --git a/tools/certify/footprint.py b/tools/certify/footprint.py
new file mode 100755
index 00000000..b240ff38
--- /dev/null
+++ b/tools/certify/footprint.py
@@ -0,0 +1,246 @@
+#!/usr/bin/env python3
+"""The decidable footprint check of a published statement's scoped hash premises.
+
+    footprint.py CHECK_LOG --lean-dir DIR --name NAME --out JSON [--witness ADDR ...] [--lean CMD]
+
+CHECK_LOG is the output of tools/certify/check_final.lean, whose "PREMISE CLASS DEFINITION CONSTANT
+TERM" lines name every keccak256 premise the statement rests on. For each scoped premise
+(SolidCore.Spec.ScopedSep of a call's footprint), this writes one Lean file importing NAME.Statement
+and Verify.Spec.HashScopeCheck that proves the premise for the real keccak256 at concrete calls,
+
+    theorem fp_i : SolidCore.Spec.ScopedSep (FOOTPRINT) :=
+      SolidCore.Spec.scopedSep_of_check (by decide +kernel)
+
+(scopedSep_of_check: the Boolean check sepCheckBy keccakWord L = true implies ScopedSep L), and has
+the toolchain's lean elaborate it; the kernel evaluates the sponge. A footprint the statement
+quantifies over (a variable #x the checker printed, such as the recipient of transfer) is checked at
+concrete witnesses: the other addresses of the same footprint (the self-call), 1, 2^160 - 1 and
+every --witness. This is a check at those calls, not a proof for every call: the record says so.
+Global premises are listed as not checkable; a refused one never reaches here (check_final fails).
+
+Exits 0 when every instance is accepted with axioms among propext, Classical.choice and Quot.sound,
+1 when one is refused (the premise is false at a call the statement covers, or the axiom audit
+fails), 2 on malformed input.
+"""
+
+import argparse
+import itertools
+import json
+import os
+import re
+import subprocess
+import sys
+import tempfile
+
+ALLOWED = {"propext", "Classical.choice", "Quot.sound"}
+# Footprint constructors and the argument positions (from 0) that hold addresses; the others are
+# mapping slots, which must be closed.
+SHAPES = {
+    "SolidCore.Spec.transferFootprint": (1, 2),
+    "SolidCore.Spec.approveFootprint": (1, 2),
+    "SolidCore.Spec.transferFromFootprint": (2, 3, 4),
+}
+VAR = re.compile(r"#([^\s()]+)")
+MAX_INSTANCES = 32
+
+
+def fail(msg, code=2):
+    print(f"footprint.py: {msg}", file=sys.stderr)
+    sys.exit(code)
+
+
+def split_app(term):
+    """'(f a (g b) c)' -> ['f', 'a', '(g b)', 'c']; None when term is not one application."""
+    t = term.strip()
+    if not (t.startswith("(") and t.endswith(")")):
+        return None
+    inner, out, depth, cur = t[1:-1], [], 0, ""
+    for ch in inner:
+        if ch == "(":
+            depth += 1
+        elif ch == ")":
+            depth -= 1
+            if depth < 0:
+                return None
+        if ch == " " and depth == 0:
+            if cur:
+                out.append(cur)
+            cur = ""
+        else:
+            cur += ch
+    if depth != 0:
+        return None
+    if cur:
+        out.append(cur)
+    return out
+
+
+def premises(log):
+    out = []
+    with open(log, encoding="utf-8") as fh:
+        log_lines = fh.read().splitlines()
+    for line in log_lines:
+        if not line.startswith("PREMISE "):
+            continue
+        parts = line.rstrip("\n").split(" ", 4)
+        if parts[1:] == ["none"]:
+            continue
+        if len(parts) != 5 or parts[1] not in ("scoped", "global", "refuted"):
+            fail(f"malformed PREMISE line: {line.strip()!r}")
+        out.append(
+            {
+                "class": parts[1],
+                "definition": parts[2],
+                "constant": parts[3],
+                "term": parts[4],
+            }
+        )
+    return out
+
+
+def instances(term, witnesses):
+    """The closed footprints to check for TERM, or (None, reason)."""
+    vars_ = sorted(set(VAR.findall(term)))
+    if not vars_:
+        return [term], None
+    app = split_app(term)
+    if not app or app[0] not in SHAPES:
+        return None, "open footprint of a shape the driver does not know"
+    addr_pos = SHAPES[app[0]]
+    args = app[1:]
+    for i, a in enumerate(args):
+        if i not in addr_pos and VAR.search(a):
+            return None, f"open mapping slot (argument {i + 1})"
+    values = list(
+        dict.fromkeys(
+            [a for i, a in enumerate(args) if i in addr_pos and not VAR.search(a)]
+            + witnesses
+        )
+    )
+    out = []
+    for combo in itertools.product(values, repeat=len(vars_)):
+        sub = dict(zip(vars_, combo))
+        out.append(VAR.sub(lambda m, sub=sub: sub[m.group(1)], term))
+        if len(out) >= MAX_INSTANCES:
+            break
+    return out, None
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("log")
+    ap.add_argument("--lean-dir", required=True)
+    ap.add_argument("--name", required=True)
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--witness", action="append", default=[])
+    ap.add_argument("--lean", default="lake env lean")
+    a = ap.parse_args()
+    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", a.name):
+        fail("--name is not a Lean name")
+    witnesses = ["1", str(2**160 - 1)]
+    for w in a.witness:
+        try:
+            v = int(w, 16) if w.lower().startswith("0x") else int(w)
+        except ValueError:
+            fail(f"--witness is not a number: {w}")
+        if not 0 <= v < 2**160:
+            fail(f"--witness is not an address (below 2^160): {w}")
+        witnesses.append(str(v))
+    prems = premises(a.log)
+    if any(p["class"] == "refuted" for p in prems):
+        fail(
+            "the statement rests on a refuted premise (check_final should have refused it)",
+            1,
+        )
+    todo = []
+    for p in prems:
+        p["checked"], p["unchecked"] = [], None
+        if p["class"] != "scoped":
+            p["unchecked"] = (
+                "global premise: a claim about every key, not decidable per call"
+            )
+            continue
+        if "_" in p["term"].split() or re.search(r"[\s(]_[\s)]", p["term"]):
+            p["unchecked"] = "the checker could not print the footprint"
+            continue
+        inst, why = instances(p["term"], witnesses)
+        if inst is None:
+            p["unchecked"] = why
+            continue
+        for t in inst:
+            todo.append((p, t))
+    if todo:
+        lines = [f"import {a.name}.Statement", "import Verify.Spec.HashScopeCheck", ""]
+        for i, (_, t) in enumerate(todo):
+            lines += [
+                "set_option maxRecDepth 100000 in",
+                f"theorem fp_{i} : SolidCore.Spec.ScopedSep {t} :=",
+                "  SolidCore.Spec.scopedSep_of_check (by decide +kernel)",
+                f"#print axioms fp_{i}",
+                "",
+            ]
+        with tempfile.TemporaryDirectory() as d:
+            f = os.path.join(d, "FootprintCheck.lean")
+            with open(f, "w", encoding="utf-8") as fh:
+                fh.write("\n".join(lines))
+            r = subprocess.run(
+                a.lean.split() + [f],
+                cwd=a.lean_dir,
+                capture_output=True,
+                text=True,
+                check=False,
+            )
+        out = r.stdout + r.stderr
+        axs = {
+            int(m.group(1)): m.group(2)
+            for m in re.finditer(r"'fp_(\d+)' depends on axioms: \[([^\]]*)\]", out)
+        }
+        errors = re.findall(r"FootprintCheck\.lean:(\d+):\d+: error", out)
+        bad_lines = {int(x) for x in errors}
+        for i, (p, t) in enumerate(todo):
+            start = 4 + 5 * i  # the theorem's line in the file (1-based)
+            refused = (
+                any(start - 1 <= ln <= start + 3 for ln in bad_lines) or i not in axs
+            )
+            ax = [x.strip() for x in axs.get(i, "").split(",") if x.strip()]
+            if not refused and not set(ax) <= ALLOWED:
+                refused = True
+            p["checked"].append(
+                {
+                    "footprint": t,
+                    "result": "refused" if refused else "kernel accepted",
+                    "axioms": ax,
+                }
+            )
+        if r.returncode != 0 and not bad_lines:
+            sys.stderr.write(out)
+            fail("lean failed on the footprint check", 1)
+    for p in prems:
+        n = len(p["checked"])
+        for c in p["checked"]:
+            print(
+                f"FOOTPRINT {c['result']} ScopedSep {c['footprint']} (premise in {p['definition']}) axioms {c['axioms']}"
+            )
+        if p["unchecked"]:
+            print(
+                f"FOOTPRINT not checked: {p['constant']} {p['term']} ({p['unchecked']})"
+            )
+        elif p["class"] == "scoped" and n:
+            ok = sum(c["result"] == "kernel accepted" for c in p["checked"])
+            print(
+                f"FOOTPRINT {p['definition']}: real keccak256 decided by the kernel at {n} concrete call(s): "
+                f"{ok} accepted, {n - ok} refused; not claimed for every call"
+            )
+    with open(a.out, "w", encoding="utf-8") as fh:
+        json.dump(
+            {"premises": prems, "witnesses": witnesses},
+            fh,
+            indent=2,
+            ensure_ascii=False,
+        )
+    if any(c["result"] != "kernel accepted" for p in prems for c in p["checked"]):
+        sys.exit(1)
+
+
+if __name__ == "__main__":
+    main()
