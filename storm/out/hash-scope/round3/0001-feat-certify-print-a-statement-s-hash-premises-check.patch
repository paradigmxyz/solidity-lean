+fp_case "$tmp/fp-global.log" "PREMISE global D SolidCore.Spec.MapSlotsSeparated (List.cons 0 List.nil)"
+unit_ok footprint-global "not checked: SolidCore.Spec.MapSlotsSeparated .*global premise" \
