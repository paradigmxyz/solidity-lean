@@ -0,0 +1,313 @@
+import Verify.Spec.TreeMap
+import Mathlib.Data.Fintype.Prod
+
+/-!
+# The keccak256 model: an uninterpreted hash with named assumptions
+
+The proofs about mappings never compute keccak256 on a symbolic slot: after
+`generalize solHash = H` they reason about an arbitrary function `H` from facts about it.
+`KeccakModel S` collects those facts in one named premise, in the style of hevm and Certora
+(see docs/KECCAK_MODEL.md):
+
+* **injectivity** on `S` (hevm adds pairwise injectivity of keccak256 for the hashes of a query;
+  derived here from the gap);
+* **large gaps**: two distinct preimages of `S` hash at least `2 ^ 64` apart (Certora's
+  "injective with large gaps");
+* **reserved low slots**: every image is at least `2 ^ 128`, above every small constant slot
+  (Certora reserves slots 0 to 10000; `2 ^ 128` covers that and every slot a contract numbers
+  by declaration);
+* **room above**: every image is at most `2 ^ 256 - 2 ^ 64`, so `H x + i` for an offset
+  `i < 2 ^ 64` (a struct field, an array element) does not wrap around.
+
+From these, the base-plus-offset slots of different hashes never collide, and no offset slot is a
+small constant slot (`offset_ne`, `offset_ne_small`).
+
+`KeccakModel S` is a premise, never an axiom. It is about the real keccak256 (the kernel's
+EvmYul sponge), so a theorem under it speaks about the real EVM. For which `S` it is sound:
+
+* every `S` is not allowed: `not_keccakModel_univ` refutes it for all inputs;
+* nested mappings over all pairs of addresses are not allowed either: that set has `2 ^ 320`
+  preimages and only `2 ^ 256` words, so `not_nestedSlotsSeparated` refutes the earlier
+  premise `NestedSlotsSeparated ms ns` (any `ns ≠ []`) by counting alone, and with it every
+  theorem stated under it was vacuous;
+* `nestedSlots ms ns K` keeps one of the two keys of a nested slot in a finite list `K` (the
+  fixed caller, `address(0)`), so it has about `2 ^ 163` preimages, which fit, and the counting
+  argument does not apply; `keccakModel_mapping` checks the model on concrete preimages in the kernel.
+-/
+
+namespace SolidCore.Spec
+
+open SolidCore.Refinement SolidCore.Refinement.Generic TrustedBase
+
+/-- **The keccak256 model on the preimages `S`, apart from `T`**: images of `S` at least
+`2 ^ 128` (above the reserved small slots), at most `2 ^ 256 - 2 ^ 64` (room for offsets), at least
+`2 ^ 64` apart for distinct preimages of `S` (large gaps, hence injective), and as far from the
+image of every other preimage of the background `T` (none by default). `T` may be too large for a
+model of its own (all nested slots of all pairs of addresses): nothing is asked of two preimages of
+`T`, only that `S`'s images stay clear of it. -/
+structure KeccakModel (S : Preimages) (T : Preimages := fun _ => False) : Prop where
+  reserved : ∀ x, S x → 2 ^ 128 ≤ keccakWord x
+  room : ∀ x, S x → keccakWord x + 2 ^ 64 ≤ 2 ^ 256
+  gap : ∀ x y, S x → S y → x ≠ y →
+    keccakWord x + 2 ^ 64 ≤ keccakWord y ∨ keccakWord y + 2 ^ 64 ≤ keccakWord x
+  apart : ∀ x y, S x → T y → x ≠ y →
+    keccakWord x + 2 ^ 64 ≤ keccakWord y ∨ keccakWord y + 2 ^ 64 ≤ keccakWord x
+
+namespace KeccakModel
+
+variable {S T S' T' : Preimages}
+
+theorem mono (h : KeccakModel S' T') (hS : ∀ x, S x → S' x) (hT : ∀ x, T x → T' x) :
+    KeccakModel S T :=
+  ⟨fun x hx => h.reserved x (hS x hx), fun x hx => h.room x (hS x hx),
+    fun x y hx hy hne => h.gap x y (hS x hx) (hS y hy) hne,
+    fun x y hx hy hne => h.apart x y (hS x hx) (hT y hy) hne⟩
+
+/-- **Injectivity** (hevm's pairwise injectivity), from the gap. -/
+theorem inj (h : KeccakModel S T) : ∀ x y, S x → S y → keccakWord x = keccakWord y → x = y := by
+  intro x y hx hy he
+  by_contra hne
+  rcases h.gap x y hx hy hne with h1 | h1 <;> omega
+
+/-- No preimage of the background shares an image of `S` but its own. -/
+theorem injT (h : KeccakModel S T) : ∀ x y, S x → T y → keccakWord x = keccakWord y → x = y := by
+  intro x y hx hy he
+  by_contra hne
+  rcases h.apart x y hx hy hne with h1 | h1 <;> omega
+
+/-- The model gives the separation the tree tactics use (`TrustedBase.KeccakSeparated`). -/
+theorem separated (h : KeccakModel S T) : KeccakSeparated S :=
+  ⟨h.inj, h.reserved⟩
+
+/-- **Offsets of distinct hashes never collide**: `H x + i` and `H y + j` (as words) for
+distinct preimages and offsets below `2 ^ 64`. -/
+theorem offset_ne (h : KeccakModel S T) {x y : List Nat} (hx : S x) (hy : S y) (hne : x ≠ y)
+    {i j : Nat} (hi : i < 2 ^ 64) (hj : j < 2 ^ 64) :
+    (keccakWord x + i) % 2 ^ 256 ≠ (keccakWord y + j) % 2 ^ 256 := by
+  have rx := h.room x hx
+  have ry := h.room y hy
+  rw [Nat.mod_eq_of_lt (by omega), Nat.mod_eq_of_lt (by omega)]
+  rcases h.gap x y hx hy hne with h1 | h1 <;> omega
+
+/-- Two offsets of one hash are equal only when the offsets are. -/
+theorem offset_inj (h : KeccakModel S T) {x : List Nat} (hx : S x) {i j : Nat} (hi : i < 2 ^ 64)
+    (hj : j < 2 ^ 64) (he : (keccakWord x + i) % 2 ^ 256 = (keccakWord x + j) % 2 ^ 256) : i = j := by
+  have rx := h.room x hx
+  rw [Nat.mod_eq_of_lt (by omega), Nat.mod_eq_of_lt (by omega)] at he
+  omega
+
+/-- **No offset slot is a reserved small slot**: `H x + i ≠ c` for `c < 2 ^ 128` (Certora's
+reserved slots 0 to 10000 among them). -/
+theorem offset_ne_small (h : KeccakModel S T) {x : List Nat} (hx : S x) {i c : Nat}
+    (hi : i < 2 ^ 64) (hc : c < 2 ^ 128) : (keccakWord x + i) % 2 ^ 256 ≠ c := by
+  have rx := h.room x hx
+  have lx := h.reserved x hx
+  rw [Nat.mod_eq_of_lt (by omega)]
+  omega
+
+/-- Certora's reserved range, as such. -/
+theorem not_reserved (h : KeccakModel S T) {x : List Nat} (hx : S x) : 10000 < keccakWord x := by
+  have := h.reserved x hx
+  omega
+
+end KeccakModel
+
+/-- A model on nothing holds: a call that hashes nothing assumes nothing. -/
+theorem keccakModel_empty : KeccakModel (fun _ => False) :=
+  ⟨fun _ h => h.elim, fun _ h => h.elim, fun _ _ h => h.elim, fun _ _ h => h.elim⟩
+
+/-- Pairwise gaps of a list of words: each at least `2 ^ 64` from every later one. -/
+def GapsOk : List Nat → Prop
+  | [] => True
+  | v :: vs => (∀ w ∈ vs, v + 2 ^ 64 ≤ w ∨ w + 2 ^ 64 ≤ v) ∧ GapsOk vs
+
+instance : DecidablePred GapsOk := fun l => by
+  induction l with
+  | nil => exact isTrue trivial
+  | cons v vs ih => unfold GapsOk; exact instDecidableAnd
+
+theorem gapsOk_map {α : Type} {f : α → Nat} :
+    ∀ {l : List α}, GapsOk (l.map f) → ∀ x ∈ l, ∀ y ∈ l, x ≠ y →
+      f x + 2 ^ 64 ≤ f y ∨ f y + 2 ^ 64 ≤ f x
+  | [], _, _, hx, _, _, _ => by simp at hx
+  | a :: l, h, x, hx, y, hy, hne => by
+    simp only [List.map_cons, GapsOk, List.mem_map] at h
+    simp only [List.mem_cons] at hx hy
+    rcases hx with rfl | hx <;> rcases hy with rfl | hy
+    · exact absurd rfl hne
+    · exact h.1 _ ⟨y, hy, rfl⟩
+    · exact (h.1 _ ⟨x, hx, rfl⟩).symm
+    · exact gapsOk_map h.2 x hx y hy hne
+
+/-- The model on a list of preimages, from their images: each in range, pairwise far apart. The
+kernel checks the side conditions on concrete images. -/
+theorem keccakModel_of_images {L : List (List Nat)} {H : List Nat}
+    (hH : L.map keccakWord = H) (hgap : GapsOk H) (hlo : ∀ v ∈ H, 2 ^ 128 ≤ v)
+    (hhi : ∀ v ∈ H, v + 2 ^ 64 ≤ 2 ^ 256) : KeccakModel (· ∈ L) :=
+  ⟨fun _ hx => hlo _ (hH ▸ List.mem_map_of_mem hx), fun _ hx => hhi _ (hH ▸ List.mem_map_of_mem hx),
+    fun x y hx hy hne => gapsOk_map (hH ▸ hgap) x hx y hy hne, fun _ _ _ h => h.elim⟩
+
+/-- **Satisfiable on real preimages**: the model holds of keccak256 on the slots of `m[0]`,
+`m[1]` and `m[0x2000]` for mappings at slots 0 and 1, by the kernel's evaluation of the sponge
+(`TrustedBase.mappingPreimages_images`). -/
+theorem keccakModel_mapping : KeccakModel (· ∈ mappingPreimages) :=
+  keccakModel_of_images mappingPreimages_images (by decide) (by decide) (by decide)
+
+/-- **Not every input**: the model fails on all byte lists (it would make keccak256 injective). -/
+theorem not_keccakModel_univ : ¬ KeccakModel (fun _ => True) :=
+  fun h => not_keccakSeparated_univ h.separated
+
+/-! ## Slot sets -/
+
+/-- Equal preimages of two mapping slots have equal keys and equal mapping slots. -/
+theorem mappingPreimage_inj {a b m n : Nat} (ha : a < 2 ^ 256) (hb : b < 2 ^ 256)
+    (hm : m < 2 ^ 256) (hn : n < 2 ^ 256)
+    (h : TrustedBase.mappingPreimage a m = TrustedBase.mappingPreimage b n) : a = b ∧ m = n := by
+  unfold TrustedBase.mappingPreimage at h
+  obtain ⟨h1, h2⟩ := List.append_inj h (by simp [length_wordBytes])
+  have e1 := congrArg bytesWord h1
+  have e2 := congrArg bytesWord h2
+  rw [bytesWord_wordBytes, bytesWord_wordBytes] at e1 e2
+  omega
+
+/-- The preimages of the slots `m[a]` of mappings at the slots `ms`, for every address `a`. -/
+def mapSlots (ms : List Nat) : Preimages :=
+  fun x => ∃ a < 2 ^ 160, ∃ m ∈ ms, x = mappingPreimage a m
+
+/-- The preimages of `m[a]` for `m ∈ ms ++ ns` and of the nested slots `n[b][a]`
+(`solHash a (solHash b n)`) for `n ∈ ns`, for all addresses `a` and `b` of which at least one is
+in `K`. -/
+def nestedSlots (ms ns K : List Nat) : Preimages :=
+  fun x => (∃ a < 2 ^ 160, ∃ m ∈ ms ++ ns, x = mappingPreimage a m) ∨
+    ∃ a < 2 ^ 160, ∃ b < 2 ^ 160, (a ∈ K ∨ b ∈ K) ∧ ∃ n ∈ ns, x = mappingPreimage a (solHash b n)
+
+/-- The preimages of every nested slot `n[b][a]` for `n ∈ ns` and all addresses `a` and `b`: the
+background a model on `nestedSlots ms ns K` keeps clear of. -/
+def allNested (ns : List Nat) : Preimages :=
+  fun x => ∃ a < 2 ^ 160, ∃ b < 2 ^ 160, ∃ n ∈ ns, x = mappingPreimage a (solHash b n)
+
+/-- **Derived: `MapSlotsSeparated`** (the premise of `tree_meets_map`). -/
+theorem KeccakModel.mapSlotsSeparated {ms : List Nat} {T : Preimages} (h : KeccakModel (mapSlots ms) T) :
+    MapSlotsSeparated ms :=
+  h.separated
+
+/-- **Derived: `SlotsSeparated m`** for each mapping slot. -/
+theorem KeccakModel.slotsSeparated {ms : List Nat} {T : Preimages} (h : KeccakModel (mapSlots ms) T) {m : Nat}
+    (hm : m ∈ ms) : SlotsSeparated m :=
+  h.mapSlotsSeparated.slots hm
+
+/-- The first level of the nested set. -/
+theorem KeccakModel.nestedFlat {ms ns K : List Nat} {T : Preimages}
+    (h : KeccakModel (nestedSlots ms ns K) T) : KeccakModel (mapSlots (ms ++ ns)) :=
+  h.mono (fun _ hx => .inl hx) (fun _ h => h.elim)
+
+/-- **Address keys name distinct slots** (Token's `HashInj` for `m = 0`). -/
+theorem KeccakModel.slot_inj {ms : List Nat} {T : Preimages} (h : KeccakModel (mapSlots ms) T) {m : Nat} (hm : m ∈ ms)
+    {a b : Nat} (ha : a < 2 ^ 160) (hb : b < 2 ^ 160) (he : solHash a m = solHash b m) : a = b :=
+  SolidCore.Spec.slot_inj (h.slotsSeparated hm) ha hb he
+
+/-- A nested slot is at least `2 ^ 128`. -/
+theorem nmapK_ge_n {ms ns K : List Nat} {T : Preimages} (h : KeccakModel (nestedSlots ms ns K) T) (n : Nat)
+    (hn : n ∈ ns) (a c : Nat) (hK : a ∈ K ∨ c ∈ K) :
+    a < 2 ^ 160 → c < 2 ^ 160 → 2 ^ 128 ≤ solHash a (solHash c n) := by
+  intro ha hc
+  rw [solHash_eq a]
+  exact h.reserved _ (.inr ⟨a, ha, c, hc, hK, n, hn, rfl⟩)
+
+/-- A first-level slot of a small mapping slot is no nested slot, whatever its keys. -/
+theorem nmapK_inj_ln {ms ns K : List Nat} (h : KeccakModel (nestedSlots ms ns K) (allNested ns))
+    (m n : Nat) (hm : m ∈ ms ++ ns) (hn : n ∈ ns) (hmw : m < 2 ^ 128) (a b c : Nat) :
+    a < 2 ^ 160 → b < 2 ^ 160 → c < 2 ^ 160 → solHash a m = solHash b (solHash c n) → False := by
+  intro ha hb hc he
+  rw [solHash_eq a, solHash_eq b] at he
+  have := h.injT _ _ (.inl ⟨a, ha, m, hm, rfl⟩) ⟨b, hb, c, hc, n, hn, rfl⟩ he
+  obtain ⟨-, e⟩ := mappingPreimage_inj (by omega) (by omega) (by omega) (solHash_lt _ _) this
+  have hge := map_ge' h.nestedFlat.mapSlotsSeparated n (List.mem_append_right ms hn) c hc
+  omega
+
+/-- Two nested slots, one of them with a key in `K`, are equal only for the same keys and mapping. -/
+theorem nmapK_inj_nn {ms ns K : List Nat} (h : KeccakModel (nestedSlots ms ns K) (allNested ns))
+    (n n' : Nat) (hn : n ∈ ns) (hn' : n' ∈ ns) (hnw : n < 2 ^ 256) (hnw' : n' < 2 ^ 256)
+    (a b c d : Nat) (hK : (a ∈ K ∨ c ∈ K) ∨ (b ∈ K ∨ d ∈ K)) :
+    a < 2 ^ 160 → b < 2 ^ 160 → c < 2 ^ 160 → d < 2 ^ 160 →
+      solHash a (solHash c n) = solHash b (solHash d n') → a = b ∧ c = d ∧ n = n' := by
+  intro ha hb hc hd he
+  rw [solHash_eq a, solHash_eq b] at he
+  have hp : mappingPreimage a (solHash c n) = mappingPreimage b (solHash d n') := by
+    rcases hK with hK | hK
+    · exact h.injT _ _ (.inr ⟨a, ha, c, hc, hK, n, hn, rfl⟩) ⟨b, hb, d, hd, n', hn', rfl⟩ he
+    · exact (h.injT _ _ (.inr ⟨b, hb, d, hd, hK, n', hn', rfl⟩) ⟨a, ha, c, hc, n, hn, rfl⟩ he.symm).symm
+  obtain ⟨e1, e2⟩ := mappingPreimage_inj (by omega) (by omega) (solHash_lt _ _) (solHash_lt _ _) hp
+  obtain ⟨e3, e4⟩ := map_inj' h.nestedFlat.mapSlotsSeparated n n' (List.mem_append_right ms hn)
+    (List.mem_append_right ms hn') hnw hnw' c d hc hd e2
+  exact ⟨e1, e3, e4⟩
+
+/-! ## Negative controls -/
+
+/-- **The earlier nested premise** (kept only as a negative control): keccak256 separated on the
+slots of `m[a]` for `m ∈ ms ++ ns` and of `n[b][a]` for `n ∈ ns`, for all addresses `a` and `b`. -/
+def NestedSlotsSeparated (ms ns : List Nat) : Prop :=
+  TrustedBase.KeccakSeparated (fun x => ∃ a < 2 ^ 160,
+    (∃ m ∈ ms ++ ns, x = TrustedBase.mappingPreimage a m) ∨
+    ∃ b < 2 ^ 160, ∃ n ∈ ns, x = TrustedBase.mappingPreimage a (solHash b n))
+
+/-- **The earlier nested premise is refutable by counting**: `NestedSlotsSeparated ms ns` with a
+nested mapping `n ∈ ns` makes `(a, c) ↦ solHash a (solHash c n)` injective on `2 ^ 320` pairs of
+addresses, into words below `2 ^ 256`. Every theorem with it as a premise was vacuous. -/
+theorem not_nestedSlotsSeparated {ms ns : List Nat} {n : Nat} (hn : n ∈ ns) (hnw : n < 2 ^ 256) :
+    ¬ NestedSlotsSeparated ms ns := by
+  intro h
+  have hflat : MapSlotsSeparated (ms ++ ns) :=
+    h.mono fun _ ⟨a, ha, m, hm, hx⟩ => ⟨a, ha, .inl ⟨m, hm, hx⟩⟩
+  let g : Fin (2 ^ 160) × Fin (2 ^ 160) → Fin (2 ^ 256) :=
+    fun p => ⟨solHash p.1 (solHash p.2 n), solHash_lt _ _⟩
+  have hg : Function.Injective g := by
+    rintro ⟨a, c⟩ ⟨b, d⟩ he
+    have he' : solHash a (solHash c n) = solHash b (solHash d n) := congrArg Fin.val he
+    rw [solHash_eq a, solHash_eq b] at he'
+    have hp := h.1 _ _ ⟨a, a.isLt, .inr ⟨c, c.isLt, n, hn, rfl⟩⟩
+      ⟨b, b.isLt, .inr ⟨d, d.isLt, n, hn, rfl⟩⟩ he'
+    have hal : (a : Nat) < 2 ^ 256 := by have := a.isLt; omega
+    have hbl : (b : Nat) < 2 ^ 256 := by have := b.isLt; omega
+    obtain ⟨e1, e2⟩ := mappingPreimage_inj hal hbl (solHash_lt _ _) (solHash_lt _ _) hp
+    obtain ⟨e3, -⟩ := map_inj' hflat n n (List.mem_append_right ms hn) (List.mem_append_right ms hn)
+      hnw hnw c d c.isLt d.isLt e2
+    exact Prod.ext (Fin.ext e1) (Fin.ext e3)
+  have := Fintype.card_le_of_injective g hg
+  simp only [Fintype.card_prod, Fintype.card_fin] at this
+  exact absurd this (by decide)
+
+/-- The ERC20 instance: `NestedSlotsSeparated [1, 4] [2]` (UniswapV2ERC20's earlier premise) is
+false. -/
+theorem not_nestedSlotsSeparated_erc20 : ¬ NestedSlotsSeparated [1, 4] [2] :=
+  not_nestedSlotsSeparated (n := 2) (by decide) (by decide)
+
+/-- The same count refutes the model on nested slots over all pairs of addresses: `K` must
+restrict one key. -/
+theorem not_keccakModel_nested_all {ms ns : List Nat} {n : Nat} (hn : n ∈ ns) (hnw : n < 2 ^ 256) :
+    ¬ KeccakModel (fun x => ∃ a < 2 ^ 160,
+      (∃ m ∈ ms ++ ns, x = mappingPreimage a m) ∨
+      ∃ b < 2 ^ 160, ∃ n ∈ ns, x = mappingPreimage a (solHash b n)) :=
+  fun h => not_nestedSlotsSeparated hn hnw h.separated
+
+/-- **A specification that needs a collision is not provable under the model**: no two distinct
+addresses share a slot of a modeled mapping. -/
+theorem no_slot_collision {ms : List Nat} {T : Preimages} (h : KeccakModel (mapSlots ms) T) {m : Nat} (hm : m ∈ ms) :
+    ¬ ∃ a b, a < 2 ^ 160 ∧ b < 2 ^ 160 ∧ a ≠ b ∧ solHash a m = solHash b m :=
+  fun ⟨_, _, ha, hb, hne, he⟩ => hne (h.slot_inj hm ha hb he)
+
+/-- Nor do a balance slot and any nested slot coincide. -/
+theorem no_nested_collision {ms ns K : List Nat} (h : KeccakModel (nestedSlots ms ns K) (allNested ns))
+    {m n : Nat} (hm : m ∈ ms ++ ns) (hn : n ∈ ns) (hmw : m < 2 ^ 128) :
+    ¬ ∃ a b c, a < 2 ^ 160 ∧ b < 2 ^ 160 ∧ c < 2 ^ 160 ∧ solHash a m = solHash b (solHash c n) :=
+  fun ⟨a, b, c, ha, hb, hc, he⟩ => nmapK_inj_ln h m n hm hn hmw a b c ha hb hc he
+
+/-- info: 'SolidCore.Spec.not_nestedSlotsSeparated_erc20' depends on axioms: [propext, Classical.choice, Quot.sound] -/
