 -- ContractsUniswapV2TransferSlice (scripts/verify/uniswap_v2_stages.sh, uniswap_v2_transfer_slice.sh).
 lean_lib ContractsUniswapV2ERC20Certified where
   roots := #[`Contracts.UniswapV2.ERC20.Certified.Transfer]
+
+-- UniswapV2Pair's backend stages on the calls of one external function, from solar's first lowered
+-- MIR to the final EVM IR, and the decoding of the exact runtime bytecode (not its execution).
+-- scripts/verify/uniswap_v2_pair_stages.sh generates Certified/uv2_*/ from the GPL-3.0 port (not
+-- committed) and builds them one module at a time; uv2_gr is getReserves(). Its peak is 2.5 GB.
+lean_lib «uv2_gr» where
+  srcDir := "Certified"
+  roots := #[`uv2_gr.Proofs.Stages, `uv2_gr.Proofs.Assembly]
+  globs := #[.submodules `uv2_gr]
+  leanOptions := solarTVOptions
+
+-- Negative controls of uv2_gr that the same script writes (scripts/verify/uniswap_v2_pair_mutants.py):
+-- getReserves' timestamp mask altered in mir1 and evm26 (uv2_grneg), and in the bytecode's PUSH4
+-- (uv2_grnegb). Each mutated proof must fail with a mismatch; never part of a passing build.
+lean_lib «uv2_grneg» where
+  srcDir := "Certified"
+  roots := #[`uv2_grneg.Proofs.Stages]
+  globs := #[.submodules `uv2_grneg]
+  leanOptions := solarTVOptions
+
+lean_lib «uv2_grnegb» where
+  srcDir := "Certified"
+  roots := #[`uv2_grnegb.Proofs.Assembly]
+  globs := #[.submodules `uv2_grnegb]
+  leanOptions := solarTVOptions
diff --git a/scripts/verify/uniswap_v2_pair_mutants.py b/scripts/verify/uniswap_v2_pair_mutants.py
new file mode 100755
index 0000000..160bd2b
--- /dev/null
+++ b/scripts/verify/uniswap_v2_pair_mutants.py
@@ -0,0 +1,53 @@
+#!/usr/bin/env python3
+"""Mutants of a UniswapV2Pair stage set (scripts/verify/uniswap_v2_pair_stages.sh NEGATIVES=1).
+
+    scripts/verify/uniswap_v2_pair_mutants.py NAME
+
+From Certified/NAME/gen writes Certified/NAMEneg/gen (getReserves' 32-bit timestamp mask 0xffffffff
+made 0xfffffff in the first MIR pass's output, mir1, and in the final EVM IR, evm26) and
+Certified/NAMEnegb/gen (the same mask's PUSH4 immediate in the runtime bytecode made 0x0fffffff,
+the stages unchanged). Each edit must apply exactly once. Generated, never committed.
+"""
+import pathlib, re, shutil, sys
+
+name = sys.argv[1]
+root = pathlib.Path(__file__).resolve().parents[2] / "Certified"
+src = root / name / "gen" / "UniswapV2Pair"
+neg, negb = root / f"{name}neg", root / f"{name}negb"
+for d in (neg, negb):
+    shutil.rmtree(d, ignore_errors=True)
+    (d / "gen").mkdir(parents=True)
+    shutil.copytree(src, d / "gen" / "UniswapV2Pair")
+
+
+def edit_between(path, start, stop, old, new):
+    t = path.read_text()
+    i = t.index(start)
+    j = t.index(stop, i + len(start))
+    body = t[i:j]
+    assert body.count(old) == 1, (path, old)
+    path.write_text(t[:i] + body.replace(old, new) + t[j:])
+
+
+g = neg / "gen" / "UniswapV2Pair"
+edit_between(g / "Mir1.lean", "-- @getReserves\n", "-- @", ".const 0xffffffff]", ".const 0xfffffff]")
+edit_between(g / "Evm26.lean", "    -- bb41\n", "    -- bb", "(.push 0xffffffff)", "(.push 0xfffffff)")
+
+p = negb / "gen" / "UniswapV2Pair" / "Bytecode.lean"
+t = p.read_text()
+hx = re.search(r'def bytecodeHex : String :=\n  "([0-9a-f]+)"', t).group(1)
+# PUSH1 0x90 SHL PUSH1 0x90 SHR SWAPn PUSH4 0xffffffff: the block's prefix, at an instruction boundary.
+hits = [m.start() for m in re.finditer(r"(?=60901b60901c9[0-9a-f]63ffffffff)", hx) if m.start() % 2 == 0]
+assert len(hits) == 1, hits
+k = hits[0] + 14
+hx2 = hx[:k] + "630fffffff" + hx[k + 10:]
+byte = k // 2 + 1
+head = "def bytecode : List Nat :=\n  ["
+i = t.index(head) + len(head)
+j = t.index("]", i)
+items = [x.strip() for x in t[i:j].split(",")]
+assert int(items[byte], 16) == 0xFF
+items[byte] = "0x0f"
+body = ",\n   ".join(", ".join(items[n:n + 16]) for n in range(0, len(items), 16))
+p.write_text((t[:i] + body + t[j:]).replace(hx, hx2))
+print(f"mutants: {neg.name} (mir1, evm26), {negb.name} (bytecode byte {byte})")
diff --git a/scripts/verify/uniswap_v2_pair_stages.sh b/scripts/verify/uniswap_v2_pair_stages.sh
new file mode 100755
index 0000000..43d8b21
--- /dev/null
+++ b/scripts/verify/uniswap_v2_pair_stages.sh
@@ -0,0 +1,110 @@
+#!/usr/bin/env bash
+# UniswapV2Pair's backend stages (first lowered MIR to the final EVM IR, and the bytecode's decoding)
+# on the calls of one external function each, checked by the kernel, with the negative controls.
+#
+#   SOLAR_CERTIFY_DIR=... scripts/verify/uniswap_v2_pair_stages.sh [NAME=SELECTOR=SIGNATURE=FUEL ...]
+#
+# SOLAR_CERTIFY_DIR is a solar checkout whose tools/certify/certify.py has --only and --fuel, with
+# target/debug/solar built from it. Default scope: uv2_gr=0902f1ac=getReserves()=300.
+# Nothing it writes is committed (the stages derive from the GPL-3.0 port): it generates the port
+# (uniswap_v2_gen.sh), compiles the flat UniswapV2Pair with -Ogas --evm-version osaka, checks that
+# -Zemit-lean-stages leaves the runtime bytecode as it is and the manifest's hashes, writes
+# Certified/NAME/{gen,Proofs} with certify.py --only SELECTOR=SIGNATURE --fuel FUEL, removes NAME's
+# compiled modules, builds one module at a time (-KleanMemory=6000), scans the generated files and
+# requires every theorem's axioms within propext, Classical.choice and Quot.sound. Receipts (command,
+# exit code, wall time, peak RSS) go to .lake/pair-stages/receipts.log.
+# NEGATIVES=1 also builds the mutants of the first scope (Certified/<NAME>neg, <NAME>negb) and requires
+# each mutated proof to fail with a mismatch, not a timeout.
+set -euo pipefail
+cd "$(dirname "${BASH_SOURCE[0]}")/../.."
+: "${SOLAR_CERTIFY_DIR:?a solar checkout with certify.py --only/--fuel}"
+solar="${SOLAR:-$SOLAR_CERTIFY_DIR/target/debug/solar}"
+certify="$SOLAR_CERTIFY_DIR/tools/certify/certify.py"
+scopes=("$@"); [[ ${#scopes[@]} -gt 0 ]] || scopes=("uv2_gr=0902f1ac=getReserves()=300")
+out=.lake/pair-stages; mkdir -p "$out"; rec="$out/receipts.log"
+export LEAN_NUM_THREADS=1
+receipt() { # receipt CMD...: run, log the receipt, return its exit code
+  local t0=$(date +%s) rc=0 peak
+  /usr/bin/env python3 - "$rec" "$@" <<'PY' || rc=$?
+import resource, subprocess, sys, time, shlex
+log, cmd = sys.argv[1], sys.argv[2:]
+t = time.time(); p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+rss = resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss // 1024
+out = p.stdout.decode(errors="replace")
+open(log + ".out", "a").write(f"===== {shlex.join(cmd)}\n{out}\n")
+line = f"{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())} | {shlex.join(cmd)} | exit {p.returncode} | {time.time()-t:.0f} s | peak {rss} MB"
+open(log, "a").write(line + "\n"); print(line)
+for l in [l for l in out.splitlines() if 'error' in l][:3]: print("   ", l[:240])
+sys.exit(p.returncode)
+PY
+  return $rc
+}
+cap() { python3 -c 'import sys; print("".join(p[:1].upper() + p[1:] for p in sys.argv[1].split("_")))' "$1"; }
+
+env -u SOLAR_CERTIFY_DIR scripts/verify/uniswap_v2_gen.sh > /dev/null
+work="$out/compile"; rm -rf "$work"; mkdir -p "$work"
+cp scripts/verify/uniswap-v2/UniswapV2Pair.sol "$work/uv2pb.sol"
+( cd "$work"
+  "$solar" uv2pb.sol -Ogas --evm-version osaka --emit=bin-runtime > plain.json 2>/dev/null
+  "$solar" uv2pb.sol -Ogas --evm-version osaka --emit=bin-runtime -Zemit-lean-stages=gen > out.json 2>/dev/null
+  python3 - <<'PY'
+import hashlib, json, pathlib
+k = "uv2pb.sol:UniswapV2Pair"
+a = json.load(open("plain.json"))["contracts"][k]["bin-runtime"]
+b = json.load(open("out.json"))["contracts"][k]["bin-runtime"]
+d = pathlib.Path("gen/UniswapV2Pair"); m = json.loads((d / "manifest.json").read_text())
+assert a == b, "-Zemit-lean-stages changed the bytecode"
+assert m["bytecode"] == a and m["bytecode_sha256"] == hashlib.sha256(bytes.fromhex(a)).hexdigest()
+for s in m["stages"]:
+    assert s["sha256"] == hashlib.sha256((d / s["file"]).read_bytes()).hexdigest(), s["file"]
+print(f"runtime bytecode {len(a)//2} bytes, sha256 {m['bytecode_sha256']}, {len(m['stages'])} stages, compiler {m['compiler']}")
+PY
+)
+first=${scopes[0]%%=*}
+gen="Certified/$first/gen/UniswapV2Pair"
+rm -rf "Certified/$first/gen"; mkdir -p "Certified/$first/gen"; cp -r "$work/gen/UniswapV2Pair" "Certified/$first/gen/"
+for spec in "${scopes[@]}"; do
+  IFS='=' read -r name sel sig fuel <<<"$spec"
+  ns="SolarTV.Milestone.$(cap "$name")"
+  rm -rf "Certified/$name/Proofs" ".lake/build/lib/lean/$name" ".lake/build/ir/$name"
+  python3 "$certify" "$gen" --gen-module "$first.gen.UniswapV2Pair" --proof-dir "Certified/$name/Proofs" \
+    --proof-module "$name.Proofs" --namespace "$ns" --label "$name" --only "$sel=$sig" --fuel "$fuel" > /dev/null
+  bash "$SOLAR_CERTIFY_DIR/tools/certify/audit.sh" scan "Certified/$name"
+  if [[ "$name" == "$first" ]]; then
+    mapfile -t gm < <(cd Certified && ls "$name"/gen/UniswapV2Pair/*.lean | sed 's|\.lean$||; s|/|.|g')
+    receipt lake build -KleanMemory=3000 "${gm[@]}"
+  fi
+  for m in Stage0 Mir1 Mir2 Mir3 Mir4 Mir5 Sched $(seq -f 'Evm%g' 1 26); do
+    receipt lake build -KleanMemory=6000 "$name.Proofs.Runs.$m"
+  done
+  receipt lake build -KleanMemory=6000 "$name.Proofs.Stages"
+  [[ "$name" != "$first" ]] || receipt lake build -KleanMemory=6000 "$name.Proofs.Assembly"
+  audit="Certified/$name/Audit.lean"
+  { echo "import $name.Proofs.Stages"; [[ "$name" != "$first" ]] || echo "import $name.Proofs.Assembly"
+    grep -rhoE '^theorem [A-Za-z0-9_]+' "Certified/$name/Proofs" | awk '{print $2}' | sort -u | sed "s/^/#print axioms $ns./"
+    echo "#check @$ns.${name}_mir_to_evmir"; } > "$audit"
+  report="$(lake env lean -M 6000 "$audit" 2>&1)"
+  joined="$(awk '/^ /{printf "%s", $0; next} NR > 1 {print ""} {printf "%s", $0} END {print ""}' <<<"$report")"
+  echo "$joined" > "$out/audit-$name.txt"
+  bad="$(grep 'depends on axioms' <<<"$joined" | sed -E 's/.*depends on axioms: \[(.*)\]/\1/' | tr ',' '\n' | tr -d ' ' | grep -v -x -E 'propext|Classical\.choice|Quot\.sound' || true)"
+  n="$(grep -c 'depends on axioms' <<<"$joined")"; want="$(grep -c '^#print' "$audit")"
+  [[ -z "$bad" && "$n" -eq "$want" ]] || { echo "error: $name audit: $n of $want, beyond the three: $bad" >&2; exit 1; }
+  echo "$name: $n theorems audited, axioms within propext, Classical.choice, Quot.sound"
+done
+if [[ -n "${NEGATIVES:-}" ]]; then
+  IFS='=' read -r name sel sig fuel <<<"${scopes[0]}"
+  python3 scripts/verify/uniswap_v2_pair_mutants.py "$name"
+  for d in "${name}neg" "${name}negb"; do
+    mapfile -t gm < <(cd Certified && ls "$d"/gen/UniswapV2Pair/*.lean | sed 's|\.lean$||; s|/|.|g')
+    rm -rf ".lake/build/lib/lean/$d" ".lake/build/ir/$d" "Certified/$d/Proofs"
+    python3 "$certify" "Certified/$d/gen/UniswapV2Pair" --gen-module "$d.gen.UniswapV2Pair" --proof-dir "Certified/$d/Proofs" \
+      --proof-module "$d.Proofs" --namespace "SolarTV.Milestone.$(cap "$d")" --label "$d" --only "$sel=$sig" --fuel "$fuel" > /dev/null
+    receipt lake build -KleanMemory=3000 "${gm[@]}"
+  done
+  for m in "${name}neg.Proofs.Runs.Mir1" "${name}neg.Proofs.Runs.Evm26" "${name}negb.Proofs.Assembly"; do
+    if receipt lake build -KleanMemory=6000 "$m"; then echo "error: the mutant $m checks" >&2; exit 1; fi
+    tail -c 20000 "$rec.out" | grep -q -E "runs end in different results|Tactic .decide. proved that the proposition" ||
+      { echo "error: $m failed without a mismatch" >&2; exit 1; }
+    echo "$m: refused by mismatch"
+  done
+fi
