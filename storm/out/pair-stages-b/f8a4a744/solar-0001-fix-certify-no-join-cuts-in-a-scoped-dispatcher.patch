         nodes = sorted(edges, key=lambda s: (s[0], len(s[1]), str(s[1])))
         ix = {s: n for n, s in enumerate(nodes)}
         succ = {ix[s]: sorted({ix[t] for t in edges[s]}) for s in nodes}
@@ -507,7 +511,7 @@ def evm_call_cuts(pass_name, a_blocks, b_blocks):
                 preds[t] = preds.get(t, 0) + 1
         for n, k in preds.items():
             ident = node_ids[n]
-            if k >= 2 and ident in common and ident not in chosen:
+            if k >= 2 and ident in common and ident not in chosen and ident not in dispatch:
                 if same_entry(ident):
                     chosen.add(ident)
     a_nodes, a_succ_n, a_node_ids, _ = sides[0]
@@ -530,7 +534,7 @@ def evm_call_cuts(pass_name, a_blocks, b_blocks):
         return found
 
     if JOINS:
-        bound_segments(sides[0], chosen, same_entry, common)
+        bound_segments(sides[0], chosen, same_entry, common - dispatch)
     rels, tests_a, tests_b = [], [], []
     for ident in sorted(chosen):
         ia, ib = a_ids.index(ident), b_ids.index(ident)
@@ -931,6 +935,34 @@ def scoped_states(blocks, edges):
             for st in edges if st in seen}
 
 
+def dispatch_closure(blocks, edges):
+    """The block indices of the configurations in edges (scoped_states') from which a dispatcher
+    compare against an excluded selector (push SEL; eq; jumpi T) is reachable. A segment that
+    starts at such a configuration starts with an arbitrary stack, where the selector word is no
+    longer the call's, so the scope's hypotheses cannot prune the excluded cases: these blocks are
+    never cut by joins or by bound_segments, only by loops."""
+    if not EXCLUDED_SELECTORS:
+        return set()
+    hits = set()
+    for idx, (_, instrs) in enumerate(blocks):
+        for k in range(len(instrs) - 2):
+            m = re.fullmatch(r"\.op \(\.stack \(\.push (0x[0-9a-f]+|\d+)\)\)", instrs[k])
+            if m and int(m[1], 0) in EXCLUDED_SELECTORS and instrs[k + 1] == ".op (.stack .eq)":
+                hits.add(idx)
+    preds = {}
+    for st, ts in edges.items():
+        for t in ts:
+            preds.setdefault(t, set()).add(st)
+    work = [st for st in edges if st[0] in hits]
+    seen = set(work)
+    while work:
+        for p in preds.get(work.pop(), ()):
+            if p not in seen:
+                seen.add(p)
+                work.append(p)
+    return {st[0] for st in seen}
+
+
 def scope_parts():
     if SCOPE is None:
         return "", "", "", (lambda h: ""), "anyCall"
