From: solar-tv <solar-tv@users.noreply.github.com>
Date: Sun, 15 Nov 2026 05:57:43 +0000
Subject: [PATCH 3/4] feat(certify): call-constant values at schedule cuts

A value read by ADDRESS, CALLDATASIZE or CALLVALUE is the same word on
every read of a call, and the stack scheduler recomputes it where it is
used instead of keeping it on the stack. A MIR-to-schedule cut point
where such a value is live but not held now relates it by a condition,
env v = its word (and c_n v for a caller's frame), so the block can be
cut. UniswapV2Pair.skim reads ADDRESS once and uses it after both
balance calls: its blocks were never cut and the stack scheduling stage
ran as one segment past 9 GB.

Block cuts are also kept out of functions an internal call enters: with
a cut inside a callee the MIR segment runs past the callee's cut block
while the scheduled one stops there. Why is not yet understood; until
then callees stay inside their callers' segments.
---
 solar-tv/milestone/cutpoints.py | 47 ++++++++++++++++++++++++++++++++-
 1 file changed, 46 insertions(+), 1 deletion(-)

diff --git a/solar-tv/milestone/cutpoints.py b/solar-tv/milestone/cutpoints.py
index b18ac57a..6caf9834 100644
--- a/solar-tv/milestone/cutpoints.py
+++ b/solar-tv/milestone/cutpoints.py
@@ -1241,6 +1241,29 @@ def live_after_call(func, site):
     return out
 
 
+# Effects whose word is the same on every read of a call: the frame's own address, and the
+# calldata's size and value. The scheduler recomputes them where they are used rather than keep
+# them on the stack, so a cut point relates them by an equation to that word instead of a stack
+# word. (CALLER and constant calldata loads read the oracle or need the call's operand, kept
+# out: the relations see only the call.)
+CALL_CONSTANTS = {
+    "address": "BitVec.ofNat 256 SolarTV.environment.callee",
+    "calldatasize": "BitVec.ofNat 256 call.calldata.size",
+    "callvalue": "BitVec.ofNat 256 call.callvalue",
+}
+
+
+def call_constants(func):
+    """A function's values defined by a call-constant effect, with the word each holds."""
+    out = {}
+    for _, insts, _ in func["blocks"].values():
+        for ins in insts:
+            m = re.fullmatch(r"\.effect \(some (\d+)\) \.(\w+) \[\]", ins)
+            if m and m[2] in CALL_CONSTANTS:
+                out[int(m[1])] = CALL_CONSTANTS[m[2]]
+    return out
+
+
 def frame_rel(fa_list, fb_list, ctx):
     """The stacks of returns of a call string in both modules, the caller values' variables and
     the conditions that relate them: every value the caller reads after the call the same."""
@@ -1848,13 +1871,27 @@ def mir_evm_rels(pass_name, funcs, sched_blocks, schedule, cuts, ctxs=None):
             for _ in range(below):
                 junk.append(f"j{len(junk)}")
                 words.append(junk[-1])
+            # A call-constant value live at the cut that the stack does not hold, here and in each
+            # caller's frame, as the word every read of it gives.
+            conds = []
+            held = {int(x[1:]) for x in layout if x.startswith("v")}
+            live_f, _ = mir_liveness(funcs[f])
+            for v, w in sorted(call_constants(funcs[f]).items()):
+                if v in live_f[h] and v not in held and v not in dsts:
+                    conds.append(f"env {v} = {w}")
+            for n, (site, below_n) in enumerate(zip(ctx, belows)):
+                kept = {int(x[1:]) for x in below_n if x.startswith("v")}
+                after = live_after_call(funcs[site[0]], site)
+                for v, w in sorted(call_constants(funcs[site[0]]).items()):
+                    if v in after and v not in kept:
+                        conds.append(f"c{n} {v} = {w}")
             rels.append(
                 {
                     "src_vars": [("env", "MIR.Lowered.Env")] + fvars + [("s", "State")],
                     "tgt_vars": [(j, "EvmRules.Word") for j in junk],
                     "src": f"({frames}, MIR.Lowered.Pos.enter {f} {pa} {h}, env, s)",
                     "tgt": f"({e}, [{', '.join(words)}], s)",
-                    "conds": [],
+                    "conds": conds,
                 }
             )
     if tests_b and dynamic:
@@ -1961,10 +1998,17 @@ def stage_body(gen, a, b, heartbeats=2000000, recdepth=None):
             # scheduler recomputes there instead (a CALLER read, a constant) is related by
             # nothing at the cut, so the block stays inside its segments.
             f, h = j[0], j[1]
+            # Only in a function no internal call enters: with a cut inside a callee, the MIR
+            # segment runs on past the callee's cut block where the scheduled one stops there.
+            # NOTE: why the two part is not understood yet; until it is, callees stay inside
+            # their callers' segments.
+            if ctxs.get(f, {()}) != {()}:
+                return False
             bm = next((x for x in fmaps.get(f, {}).get("blocks", []) if x["block"] == h), None)
             if bm is None:
                 return False
             held = {int(x[1:]) for x in bm["layout"] if x.startswith("v")}
+            held |= set(call_constants(fa[f]))
             live, _ = mir_liveness(fa[f])
             dsts = {d for d, _ in fa[f]["blocks"][h][0]}
             if not (live[h] | dsts) <= held:
@@ -1979,6 +2023,7 @@ def stage_body(gen, a, b, heartbeats=2000000, recdepth=None):
                     except Unsupported:
                         return False
                     kept = {int(x[1:]) for x in below if x.startswith("v")}
+                    kept |= set(call_constants(fa[site[0]]))
                     if not live_after_call(fa[site[0]], site) <= kept:
                         return False
             return True
