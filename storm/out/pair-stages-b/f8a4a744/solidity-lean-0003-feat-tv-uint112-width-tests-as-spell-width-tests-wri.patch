From 1d19f419d971f019e5926e4d13f0a34804fd4989 Mon Sep 17 00:00:00 2001
From: solar-tv <solar-tv@users.noreply.github.com>
Date: Sun, 15 Nov 2026 00:28:19 +0000
Subject: [PATCH 3/5] feat(tv): uint112 width tests as spell-width-tests writes
 them

spell-width-tests respells UniswapV2Pair._update's range check
balance <= uint112(-1) on both balances, lt(x, 2^112) and lt(y, 2^112)
combined with and, as (shr(112, x) | shr(112, y)) == 0. The procedure
now reads both as one proposition: cond_and_lt turns the and of two lt
words into their conjunction, zero_eq_or reads cond_eq's zero-first test
of a disjunction, and shr112_eq_zero reads the shift as the bound, as
shr160_eq_zero does for addresses. sync()'s spell-width-tests stage
then checks in 33 s, where it timed out at 12M heartbeats before.

The Pair stage script passes --heartbeats (HEARTBEATS, default 100M) to
certify.py and caps each module's memory at LEAN_MEMORY (default 8000
MB): sync()'s stack scheduling stage is one segment that checks at 100M
heartbeats in 6.2 GB.
---
 scripts/verify/uniswap_v2_pair_stages.sh | 20 ++++++++------
 tv/W1Proofs/Tactic.lean                  | 35 ++++++++++++++++++++++--
 2 files changed, 45 insertions(+), 10 deletions(-)

diff --git a/scripts/verify/uniswap_v2_pair_stages.sh b/scripts/verify/uniswap_v2_pair_stages.sh
index c8fc7e6..73e94e9 100755
--- a/scripts/verify/uniswap_v2_pair_stages.sh
+++ b/scripts/verify/uniswap_v2_pair_stages.sh
@@ -13,7 +13,7 @@
 # (uniswap_v2_gen.sh), compiles the flat UniswapV2Pair with -Ogas --evm-version osaka, checks that
 # -Zemit-lean-stages leaves the runtime bytecode as it is and the manifest's hashes, writes
 # Certified/NAME/{gen,Proofs} with certify.py, removes NAME's compiled modules, builds one module at a
-# time (-KleanMemory=6000), scans the generated files and
+# time (lake -KleanMemory, LEAN_MEMORY MB, default 8000), scans the generated files and
 # requires every theorem's axioms within propext, Classical.choice and Quot.sound. Receipts (command,
 # exit code, wall time, peak RSS) go to .lake/pair-stages/receipts.log.
 # NEGATIVES=1 also builds the mutants of the first scope (Certified/<NAME>neg, <NAME>negb) and requires
@@ -24,6 +24,10 @@ cd "$(dirname "${BASH_SOURCE[0]}")/../.."
 solar="${SOLAR:-$SOLAR_CERTIFY_DIR/target/release/solar}"
 certify="$SOLAR_CERTIFY_DIR/tools/certify/certify.py"
 scopes=("$@"); [[ ${#scopes[@]} -gt 0 ]] || scopes=("uv2_gr=getReserves()")
+# Each segment proof's heartbeat cap and each module's memory cap: sync()'s stack scheduling
+# stage is one segment that checks at 100M heartbeats in 6.2 GB.
+heartbeats="${HEARTBEATS:-100000000}"
+leanmem="${LEAN_MEMORY:-8000}"
 out=.lake/pair-stages; mkdir -p "$out"; rec="$out/receipts.log"
 export LEAN_NUM_THREADS=1
 receipt() { # receipt CMD...: run, log the receipt, return its exit code
@@ -100,7 +104,7 @@ for spec in "${scopes[@]}"; do
   ns="SolarTV.Milestone.$(cap "$name")"
   rm -rf "Certified/$name/Proofs" ".lake/build/lib/lean/$name" ".lake/build/ir/$name"
   python3 "$certify" "$gen" --gen-module "$first.gen.UniswapV2Pair" --proof-dir "Certified/$name/Proofs" \
-    --proof-module "$name.Proofs" --namespace "$ns" --label "$name" --cut --joins --no-mir-joins --segment 8 "${ex[@]}" > /dev/null
+    --proof-module "$name.Proofs" --namespace "$ns" --label "$name" --cut --joins --no-mir-joins --segment 8 --heartbeats "$heartbeats" "${ex[@]}" > /dev/null
   bash "$SOLAR_CERTIFY_DIR/tools/certify/audit.sh" scan "Certified/$name"
   if [[ "$name" == "$first" ]]; then
     mapfile -t gm < <(cd Certified && ls "$name"/gen/UniswapV2Pair/*.lean | sed 's|\.lean$||; s|/|.|g')
@@ -109,15 +113,15 @@ for spec in "${scopes[@]}"; do
   mapfile -t pm < <(proof_modules "$name")
   [[ ${#pm[@]} -gt 1 ]] || { echo "error: no run proofs under Certified/$name/Proofs/Runs" >&2; exit 1; }
   for m in "${pm[@]}"; do
-    receipt lake build -KleanMemory=6000 "$m"
+    receipt lake build -KleanMemory="$leanmem" "$m"
   done
-  receipt lake build -KleanMemory=6000 "$name.Proofs.Stages"
-  [[ "$name" != "$first" ]] || receipt lake build -KleanMemory=6000 "$name.Proofs.Assembly"
+  receipt lake build -KleanMemory="$leanmem" "$name.Proofs.Stages"
+  [[ "$name" != "$first" ]] || receipt lake build -KleanMemory="$leanmem" "$name.Proofs.Assembly"
   audit="Certified/$name/Audit.lean"
   { echo "import $name.Proofs.Stages"; [[ "$name" != "$first" ]] || echo "import $name.Proofs.Assembly"
     grep -rhoE '^theorem [A-Za-z0-9_]+' "Certified/$name/Proofs" | awk '{print $2}' | sort -u | sed "s/^/#print axioms $ns./"
     echo "#check @$ns.${name}_mir_to_evmir"; } > "$audit"
-  report="$(lake env lean -M 6000 "$audit" 2>&1)"
+  report="$(lake env lean -M "$leanmem" "$audit" 2>&1)"
   joined="$(awk '/^ /{printf "%s", $0; next} NR > 1 {print ""} {printf "%s", $0} END {print ""}' <<<"$report")"
   echo "$joined" > "$out/audit-$name.txt"
   bad="$(grep 'depends on axioms' <<<"$joined" | sed -E 's/.*depends on axioms: \[(.*)\]/\1/' | tr ',' '\n' | tr -d ' ' | grep -v -x -E 'propext|Classical\.choice|Quot\.sound' || true)"
@@ -134,12 +138,12 @@ if [[ -n "${NEGATIVES:-}" ]]; then
     mapfile -t gm < <(cd Certified && ls "$d"/gen/UniswapV2Pair/*.lean | sed 's|\.lean$||; s|/|.|g')
     rm -rf ".lake/build/lib/lean/$d" ".lake/build/ir/$d" "Certified/$d/Proofs"
     python3 "$certify" "Certified/$d/gen/UniswapV2Pair" --gen-module "$d.gen.UniswapV2Pair" --proof-dir "Certified/$d/Proofs" \
-      --proof-module "$d.Proofs" --namespace "SolarTV.Milestone.$(cap "$d")" --label "$d" --cut --joins --no-mir-joins --segment 8 "${ex[@]}" > /dev/null
+      --proof-module "$d.Proofs" --namespace "SolarTV.Milestone.$(cap "$d")" --label "$d" --cut --joins --no-mir-joins --segment 8 --heartbeats "$heartbeats" "${ex[@]}" > /dev/null
     receipt lake build -KleanMemory=3000 "${gm[@]}"
   done
   last="$(stages | awk '{print $NF}')"
   for m in "${name}neg.Proofs.Runs.Mir1" "${name}neg.Proofs.Runs.$last" "${name}negb.Proofs.Assembly"; do
-    if receipt lake build -KleanMemory=6000 "$m"; then echo "error: the mutant $m checks" >&2; exit 1; fi
+    if receipt lake build -KleanMemory="$leanmem" "$m"; then echo "error: the mutant $m checks" >&2; exit 1; fi
     tail -c 20000 "$rec.out" | grep -q -E "runs end in different results|Tactic .decide. proved that the proposition" ||
       { echo "error: $m failed without a mismatch" >&2; exit 1; }
     echo "$m: refused by mismatch"
diff --git a/tv/W1Proofs/Tactic.lean b/tv/W1Proofs/Tactic.lean
index 23fb12a..da68f78 100644
--- a/tv/W1Proofs/Tactic.lean
+++ b/tv/W1Proofs/Tactic.lean
@@ -105,6 +105,16 @@ theorem cond_or (a b : Word) : (Evm.or a b = 0) = (a = 0 ∧ b = 0) := by
   unfold Evm.or
   exact propext BitVec.or_eq_zero_iff
 
+/-- Two range tests both passing, as a word: `and` of two `lt` results, zero unless both hold. -/
+theorem cond_and_lt (a b c d : Word) :
+    (Evm.and (Evm.lt a b) (Evm.lt c d) = 0) = ¬(a < b ∧ c < d) := by
+  unfold Evm.and Evm.lt
+  by_cases h1 : a < b <;> by_cases h2 : c < d <;> simp [h1, h2, BitVec.ult_iff_lt]
+
+/-- `cond_or` with the zero first, as `cond_eq` leaves a test that a disjunction is zero. -/
+theorem zero_eq_or (a b : Word) : ((0 : Word) = Evm.or a b) = (a = 0 ∧ b = 0) := by
+  rw [← cond_or]; exact propext ⟨Eq.symm, Eq.symm⟩
+
 /-! An address is a word of at most 160 bits, the mask's own: masking it keeps it, so a test
 that a word equals its masked self holds once a test that it fits passed. The caller is the
 oracle's, any address, which fits. -/
@@ -164,6 +174,27 @@ theorem zero_eq_shr160 (x : Word) :
   rw [← shr160_eq_zero]
   exact propext eq_comm
 
+/-- The 112-bit width test as solar spells it (`shr(112, x) == 0`), as the bound test
+`x < 2^112` that a `uint112` range check reads before `spell-width-tests`. -/
+theorem shr112_eq_zero (x : Word) :
+    (Evm.shr 112 x = 0) = ((x : Word) < 5192296858534827628530496329220096) := by
+  have hm : (5192296858534827628530496329220096 : Word).toNat = 2 ^ 112 := rfl
+  have hs : Evm.shr 112 x = x >>> 112 := by
+    unfold Evm.shr
+    rw [show (112 : Word).ult 256 = true from rfl, Bool.cond_true, BitVec.ushiftRight_eq']
+    rfl
+  rw [hs, BitVec.lt_def, hm]
+  apply propext
+  rw [BitVec.toNat_eq, BitVec.toNat_ushiftRight, Nat.shiftRight_eq_div_pow]
+  show x.toNat / 2 ^ 112 = 0 ↔ x.toNat < 2 ^ 112
+  rw [Nat.div_eq_zero_iff]
+  omega
+
+theorem zero_eq_shr112 (x : Word) :
+    (0 = Evm.shr 112 x) = ((x : Word) < 5192296858534827628530496329220096) := by
+  rw [← shr112_eq_zero]
+  exact propext eq_comm
+
 /-- The address mask as `late-word` spells it, shifting the high 96 bits out and back
 (`shr(96, shl(96, x))`), as the mask: so a test on a masked word reads the same in both programs. -/
 theorem shr_shl96 (x : Word) :
@@ -1051,10 +1082,10 @@ macro "sym_cond" : tactic => `(tactic|
   simp only [*, apply_calldataload _ _ _ hcd, Mem.load_expand, Mem.load_write_of_disjoint,
     Mem.expand_store, Mem.load_store_same, Mem.load_store_of_disjoint, Mem.load_initial,
     State.initial_memory, BitVec.reduceEq,
-    cond_ne, cond_eq, cond_sub, cond_lt, cond_gt, cond_iszero, cond_or,
+    cond_ne, cond_eq, cond_sub, cond_lt, cond_gt, cond_iszero, cond_or, cond_and_lt, zero_eq_or,
     cond_zero_lt, cond_zero_gt, cond_zero_eq, cond_zero_ne, cond_zero_iszero,
     wordAddComm, wordMulComm, wordAndComm, wordOrComm, wordXorComm, and_mask,
-    mask_and, caller_le_mask, immutable20_le_mask, shr160_eq_zero, zero_eq_shr160, shr_shl96,
+    mask_and, caller_le_mask, immutable20_le_mask, shr160_eq_zero, zero_eq_shr160, shr112_eq_zero, zero_eq_shr112, shr_shl96,
     and_self, and_true, true_and, and_false, false_and,
     ite_true, ite_false,
     not_false_eq_true, not_true_eq_false, Classical.not_not, ↓reduceIte, Nat.reduceGT, Nat.reduceLT,
