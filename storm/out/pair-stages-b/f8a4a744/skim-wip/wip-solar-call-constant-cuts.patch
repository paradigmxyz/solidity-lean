+# Effects whose word is the same on every read of a call: the frame's own address, and the
+# calldata's size and value. The scheduler recomputes them where they are used rather than keep
+# them on the stack, so a cut point relates them by an equation to that word instead of a stack
+# word. (CALLER and constant calldata loads read the oracle or need the call's operand, kept
+# out: the relations see only the call.)
+CALL_CONSTANTS = {
+    "address": "BitVec.ofNat 256 SolarTV.environment.callee",
+    "calldatasize": "BitVec.ofNat 256 call.calldata.size",
+    "callvalue": "BitVec.ofNat 256 call.callvalue",
+}
+
+
+def call_constants(func):
+    """A function's values defined by a call-constant effect, with the word each holds."""
+    out = {}
+    for _, insts, _ in func["blocks"].values():
+        for ins in insts:
+            m = re.fullmatch(r"\.effect \(some (\d+)\) \.(\w+) \[\]", ins)
+            if m and m[2] in CALL_CONSTANTS:
+                out[int(m[1])] = CALL_CONSTANTS[m[2]]
+    return out
+
