+/-- Signed comparisons, as the ABI decoder bounds a return data size with `slt` and the scheduled
+code may test it with `sgt` the other way round: both read as one proposition. -/
+theorem cond_slt (a b : Word) : (Evm.slt a b = 0) = ¬(a.slt b = true) := by
+  unfold Evm.slt
+  cases h : a.slt b <;> simp
+
+theorem cond_sgt (a b : Word) : (Evm.sgt a b = 0) = ¬(b.slt a = true) := by
+  unfold Evm.sgt
+  cases h : b.slt a <;> simp
+
+theorem cond_zero_slt (a b : Word) : ((0 : Word) = Evm.slt a b) = ¬(a.slt b = true) := by
+  rw [← cond_slt]; exact propext ⟨Eq.symm, Eq.symm⟩
+
+theorem cond_zero_sgt (a b : Word) : ((0 : Word) = Evm.sgt a b) = ¬(b.slt a = true) := by
+  rw [← cond_sgt]; exact propext ⟨Eq.symm, Eq.symm⟩
+
