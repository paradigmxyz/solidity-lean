+/-- The 112-bit width test as solar spells it (`shr(112, x) == 0`), as the bound test
+`x < 2^112` that a `uint112` range check reads before `spell-width-tests`. -/
+theorem shr112_eq_zero (x : Word) :
+    (Evm.shr 112 x = 0) = ((x : Word) < 5192296858534827628530496329220096) := by
+  have hm : (5192296858534827628530496329220096 : Word).toNat = 2 ^ 112 := rfl
+  have hs : Evm.shr 112 x = x >>> 112 := by
+    unfold Evm.shr
+    rw [show (112 : Word).ult 256 = true from rfl, Bool.cond_true, BitVec.ushiftRight_eq']
+    rfl
+  rw [hs, BitVec.lt_def, hm]
+  apply propext
+  rw [BitVec.toNat_eq, BitVec.toNat_ushiftRight, Nat.shiftRight_eq_div_pow]
+  show x.toNat / 2 ^ 112 = 0 ↔ x.toNat < 2 ^ 112
+  rw [Nat.div_eq_zero_iff]
+  omega
+
+theorem zero_eq_shr112 (x : Word) :
+    (0 = Evm.shr 112 x) = ((x : Word) < 5192296858534827628530496329220096) := by
+  rw [← shr112_eq_zero]
+  exact propext eq_comm
+
