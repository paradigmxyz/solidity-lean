+
+import re as _re
+
+def mir_reach(funcs, tests, f, ctx, h):
+    """The cut points (function, predecessor, block, call string) a segment of the module that
+    starts by entering block h of function f under the call string ctx can stop at: an abstract
+    run of the blocks, entering callees at their block 0 and returning to the call site's rest
+    the call string names, up to the first cut test it enters. Untrusted: a segment whose leaf
+    reaches a cut point outside this set fails its proof."""
+    tests = set(tests)
+    out, seen = set(), set()
+    work = [(f, ctx, h, 0)]
+
+    def enter(g, c, pred, t):
+        if (g, t) in tests:
+            out.add((g, pred, t, c))
+        else:
+            work.append((g, c, t, 0))
+
+    while work:
+        st = work.pop()
+        if st in seen:
+            continue
+        seen.add(st)
+        g, c, b, i = st
+        if g >= len(funcs) or b not in funcs[g]["blocks"]:
+            continue
+        _, insts, term = funcs[g]["blocks"][b]
+        k = sum(1 for ins in insts[:i] if ins.startswith(".call "))
+        called = False
+        for j in range(i, len(insts)):
+            ins = insts[j]
+            if ins.startswith(".call "):
+                callee = int(tokens(ins)[2])
+                enter(callee, ((g, b, k),) + c, 0, 0)
+                called = True
+                break
+        if called:
+            continue
+        m = _re.match(r"\.tailCall (\d+)", term)
+        if m:
+            enter(int(m[1]), c, 0, 0)
+            continue
+        succ = mir_succ(term)
+        if succ:
+            for t in succ:
+                enter(g, c, b, t)
+            continue
+        if term.startswith(".ret") and c:
+            (cf, cb, ck), rest = c[0], c[1:]
+            ci, _ = call_site(funcs[cf], cb, ck)
+            work.append((cf, rest, cb, ci + 1))
+    return out
