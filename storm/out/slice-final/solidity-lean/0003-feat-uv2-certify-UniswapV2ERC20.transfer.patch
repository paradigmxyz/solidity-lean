index 0000000..1a03d70
--- /dev/null
+++ b/Contracts/UniswapV2/ERC20/Transfer/Source.lean
@@ -0,0 +1,59 @@
+import Contracts.UniswapV2.ERC20.Core
+import Contracts.UniswapV2.ERC20.SpecTreeKeccak
+import Verify.VC.KernelIdx
+import SolidCore.Refinement.KernelRfl
+import SolidCore.Refinement.Generic.Stage
+import uv2_erc20.gen.UniswapV2ERC20.Stage0
+import Contracts.UniswapV2.ERC20.Transfer.Spec
+
+/-!
+# UniswapV2ERC20.transfer: the source to the first lowered MIR (E3)
+
+`check_ok`: the generic source checker (`Generic.check`, the caller and the hash of two words)
+accepts solar's first lowered MIR `SolarTV.Export.UniswapV2ERC20.stage0` of the run's export for
+the one function `transfer(address,uint256)` against SolidCore's checked contract, by the kernel's
+evaluation from the source text up. `deploy_eq`: the constructor leaves `deployed`.
+`erase_eq`: the generic stage's erased tree of transfer, `tree`, which the specification is
+proved of.
+-/
+
+namespace SolidCore.Spec.UniswapV2.ERC20.Transfer
+
+open SolidCore.Refinement SolidCore.Refinement.Generic
+
+/-- `transfer(address,uint256)` as the stage's ABI sees it (two words). -/
+def fn_transfer : SolidCore.Refinement.Abi.Fn := ⟨0xa9059cbb, List.replicate 2 (.uint 256)⟩
+
+def fnsT : List SolidCore.Refinement.Abi.Fn := [fn_transfer]
+
+/-- The steps along each path of the symbolic run of the module. -/
+def mirFuel : Nat := 200
+
+def deploy? : Bool :=
+  match SolidCore.Verify.VC.UniswapV2ERC20.contract? with
+  | .ok c => Wide.deployedAt SolidCore.Verify.VC.UniswapV2ERC20.fuel c deployed
+  | .error _ => false
+
+kernel_rfl deploy_eq deploy? true using SolidCore.Verify.VC.UniswapV2ERC20.selector_eq SolidCore.Verify.VC.mkIdx_eq SolidCore.Verify.VC.UniswapV2ERC20.digest_eq SolidCore.Spec.UniswapV2.ERC20.Keccak.keccakWord_eq
+
+def check? : Bool :=
+  match SolidCore.Verify.VC.UniswapV2ERC20.contract? with
+  | .ok c => Generic.check SolidCore.Verify.VC.UniswapV2ERC20.fuel mirFuel c.core
+      SolarTV.Export.UniswapV2ERC20.stage0 fnsT .all
+  | .error _ => false
+
+kernel_rfl check_eq check? true using SolidCore.Verify.VC.UniswapV2ERC20.selector_eq SolidCore.Verify.VC.mkIdx_eq SolidCore.Verify.VC.UniswapV2ERC20.digest_eq SolidCore.Spec.UniswapV2.ERC20.Keccak.keccakWord_eq
+
+theorem check_ok {c : SolidCore.Solidity.TypeCheck.CheckedContract}
+    (hc : SolidCore.Verify.VC.UniswapV2ERC20.contract? = .ok c) :
+    Generic.check SolidCore.Verify.VC.UniswapV2ERC20.fuel mirFuel c.core
