+section
+variable (s : Nat → Nat) (hs : ∀ k, s k < 2 ^ 256) (t a : Nat) (ht : t < 2 ^ 160) (ha : a < 2 ^ 256)
+
+/-- The caller's balance before the call. -/
+abbrev S0 : Nat := s (solHash 8192 1)
+
+/-- The recipient's balance after the debit. -/
+def mid : Nat := if solHash t 1 = solHash 8192 1 then S0 s - a else s (solHash t 1)
+
+include hs ht ha in
+theorem eval_cases :
+    let R := tree.eval ⟨[t, a], s, solHash⟩
+    (S0 s < a → R.success = false ∧ R.output = subUnderflow ∧ R.logs = [] ∧ R.store = s) ∧
+    (a ≤ S0 s → 2 ^ 256 ≤ mid s t a + a →
+      R.success = false ∧ R.output = addOverflow ∧ R.logs = [] ∧ R.store = s) ∧
+    (a ≤ S0 s → mid s t a + a < 2 ^ 256 →
+      R.success = true ∧ R.output = word 1 ∧ R.logs = [([transferTopic, 8192, t], word a)] ∧
+      ∀ n < 2 ^ 256, R.store n =
+        if n = solHash t 1 then mid s t a + a else if n = solHash 8192 1 then S0 s - a else s n) := by
+  intro R
+  have hsm : ∀ k, s k % 2 ^ 256 = s k := fun k => Nat.mod_eq_of_lt (hs k)
+  have ham : a % 2 ^ 256 = a := Nat.mod_eq_of_lt ha
+  have htm : t % 2 ^ 256 = t := Nat.mod_eq_of_lt (by omega)
+  have hbm : ∀ x y, solHash x y % 2 ^ 256 = solHash x y := fun x y => Nat.mod_eq_of_lt (solHash_lt x y)
+  have h8 : 8192 % 2 ^ 256 = 8192 := by decide
+  have h1 : 1 % 2 ^ 256 = 1 := by decide
+  have hA : 1461501637330902918203684832716283019655932542975 % 2 ^ 256 =
+      1461501637330902918203684832716283019655932542975 := by decide
+  have hz : ∀ (p : Prop) [Decidable p], ((if p then 1 else 0) % 2 ^ 256 = 0) = ¬ p := by
+    intro p _; by_cases hp : p <;> simp [hp]
+  have hS := hs (solHash 8192 1)
+  have hT := hs (solHash t 1)
+  have hnt : ¬ 1461501637330902918203684832716283019655932542975 < t := by omega
+  simp only [S0, mid]
+  have hXm : (if ¬solHash t 1 = solHash 8192 1 then s (solHash t 1) else s (solHash 8192 1) - a) =
+      (if solHash t 1 = solHash 8192 1 then s (solHash 8192 1) - a else s (solHash t 1)) := by
+    by_cases h : solHash t 1 = solHash 8192 1 <;> simp [h]
+  have hXlt : (if solHash t 1 = solHash 8192 1 then s (solHash 8192 1) - a else s (solHash t 1)) <
+      2 ^ 256 := by split <;> omega
+  refine ⟨fun hlt => ?_, fun hle hov => ?_, fun hle hov => ?_⟩
+  all_goals
+    simp only [R, tree, Tree.eval, WExpr.eval, BinOp.eval, UnOp.eval, Generic.wordSize,
+      List.getD_cons_zero, List.getD_cons_succ, htm, ham, hsm, hbm, h8, h1, hA, hz, Nat.mod_mod, ↓reduceIte,
+      hnt, not_false_eq_true, ite_true, Bool.false_eq_true, ite_false, not_not]
+  · have hu : s (solHash 8192 1) < (s (solHash 8192 1) + (2 ^ 256 - a)) % 2 ^ 256 := by omega
+    simp only [hu, ite_true]
+    refine ⟨?_, ?_, ?_, ?_⟩ <;> first | trivial | (simp only [List.map_cons, List.map_nil, OByte.eval]; decide +kernel) | rfl
+
+  · have hsub : (s (solHash 8192 1) + (2 ^ 256 - a)) % 2 ^ 256 = s (solHash 8192 1) - a := by omega
+    have hu : ¬ s (solHash 8192 1) < s (solHash 8192 1) - a := by omega
+    simp only [hsub, hu, ite_false]
+    rw [hXm]
+    generalize hX : (if solHash t 1 = solHash 8192 1 then s (solHash 8192 1) - a else s (solHash t 1)) = X at hov hXlt ⊢
+    have ho : (X + a) % 2 ^ 256 < X := by omega
+    simp only [ho, ite_true]
+    refine ⟨trivial, ?_, trivial, trivial⟩
+    simp only [List.map_cons, List.map_nil, OByte.eval]
+    decide +kernel
+  · have hsub : (s (solHash 8192 1) + (2 ^ 256 - a)) % 2 ^ 256 = s (solHash 8192 1) - a := by omega
+    have hu : ¬ s (solHash 8192 1) < s (solHash 8192 1) - a := by omega
+    simp only [hsub, hu, ite_false]
+    rw [hXm]
+    generalize hX : (if solHash t 1 = solHash 8192 1 then s (solHash 8192 1) - a else s (solHash t 1)) = X at hov hXlt ⊢
+    have ho : ¬ (X + a) % 2 ^ 256 < X := by omega
+    simp only [ho, ite_false]
+    refine ⟨trivial, ?_, ?_, ?_⟩
+    · simp only [List.map_cons, List.map_nil, OByte.eval, WExpr.eval]; decide +kernel
+    · simp only [Log.eval, List.map, WExpr.eval, OByte.eval, List.getD_cons_zero, List.getD_cons_succ,
+        htm, ham, Generic.wordSize]
+      first | rfl | decide
+    · intro n hn
+      subst hX
+      have hSa : (s (solHash 8192 1) - a) % 2 ^ 256 = s (solHash 8192 1) - a := Nat.mod_eq_of_lt (by omega)
+      simp only [Writes.store, WExpr.eval, BinOp.eval, Generic.wordSize, List.getD_cons_zero,
+        List.getD_cons_succ, htm, ham, hsm, hbm, h8, h1, hz, Nat.mod_mod, ↓reduceIte, hsub,
+        Nat.mod_eq_of_lt hn, hXm, hSa]
+      split_ifs at hov hXlt ⊢ <;> omega
+end
+
+
+/-- **The tree meets the sequential post** on every call's words with a clean recipient. -/
+theorem tree_post (s : Nat → Nat) (hs : ∀ k, s k < 2 ^ 256) (t a : Nat) (ht : t < 2 ^ 160)
+    (ha : a < 2 ^ 256) : PostOf s t a (tree.eval ⟨[t, a], s, solHash⟩).obs := by
+  obtain ⟨h1, h2, h3⟩ := eval_cases s hs t a ht ha
+  have hC : balSlot C = solHash 8192 1 := rfl
+  have hm : debited s a (balSlot t) = mid s t a := by
+    unfold debited mid; rw [hC]; rfl
+  simp only [PostOf, Succeeds, Res.obs, hm, hC]
+  refine ⟨fun ⟨hle, hov⟩ => ?_, fun hn => ?_⟩
+  · obtain ⟨e1, e2, e3, e4⟩ := h3 hle hov
+    refine ⟨e1, e2, by rw [e3]; rfl, fun n hn => ?_⟩
+    rw [e4 n hn]
+    rfl
+  · by_cases hlt : S0 s < a
+    · obtain ⟨e1, e2, e3, e4⟩ := h1 hlt
+      exact ⟨e1, e3, e4, by rw [e2, if_pos hlt]⟩
+    · have hle : a ≤ S0 s := by omega
+      have hov : 2 ^ 256 ≤ mid s t a + a := by
+        by_contra h; exact hn ⟨hle, by omega⟩
+      obtain ⟨e1, e2, e3, e4⟩ := h2 hle hov
+      exact ⟨e1, e3, e4, by rw [e2, if_neg hlt]⟩
+
+/-- The post's statuses are the allowed ones. -/
+theorem allowed_of_postOf {s : Nat → Nat} {t a : Nat} {obs : Observable} (h : PostOf s t a obs) :
+    obs.success = true ∨ (obs.output = subUnderflow ∧ s (balSlot C) < a) ∨
+      (obs.output = addOverflow ∧ a ≤ s (balSlot C) ∧ 2 ^ 256 ≤ debited s a (balSlot t) + a) := by
+  by_cases hs : Succeeds s t a
+  · exact Or.inl (h.1 hs).1
+  · obtain ⟨-, -, -, ho⟩ := h.2 hs
+    by_cases hlt : s (balSlot C) < a
+    · exact Or.inr (Or.inl ⟨by rw [ho, if_pos hlt], hlt⟩)
+    · refine Or.inr (Or.inr ⟨by rw [ho, if_neg hlt], by omega, ?_⟩)
+      by_contra hc; exact hs ⟨by omega, by omega⟩
+
+/-- info: 'SolidCore.Spec.UniswapV2.ERC20.Transfer.tree_post' depends on axioms: [propext, Classical.choice, Quot.sound] -/
+#guard_msgs (whitespace := lax) in
+#print axioms tree_post
+
+end SolidCore.Spec.UniswapV2.ERC20.Transfer
