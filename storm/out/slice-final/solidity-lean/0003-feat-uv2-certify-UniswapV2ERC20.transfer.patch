+import uv2_erc20.CtxGas
+
+/-!
+# UniswapV2ERC20.transfer: the bytecode checker refuses altered bytes (kernel negatives)
+
+The checker that proves the exact bytes against the final EVM IR (`CtxGas.check_ok`) is not
+vacuous on transfer's code: with the same final EVM IR and certificate, the kernel evaluates it to
+`false` on two one-site alterations of the runtime bytes.
+
+* `missing_debit`: the caller's debit store (SWAP1 SSTORE at 0x426) replaced by POP POP;
+* `altered_jump`: the target of the PUSH2 at 0x437 (0x0466, the add-overflow check's jump)
+  changed to 0x0405.
+-/
+
+namespace SolidCore.Spec.UniswapV2.ERC20.Transfer.Neg
+
+open SolidCore.Refinement.Solar SolidCore.Refinement.Solar.AssembleCtx
+open SolarTV.Export.UniswapV2ERC20.CtxGas
+
+def ofBytes (bs : List Nat) : ByteArray := ⟨(bs.map UInt8.ofNat).toArray⟩
+
+/-- The runtime bytes without the caller's debit. -/
+def missingDebit : ByteArray := ofBytes ((bytes.set 0x426 0x50).set 0x427 0x50)
+
+/-- The runtime bytes with one jump target changed. -/
+def alteredJump : ByteArray := ofBytes (bytes.set 0x439 0x05)
+
+theorem missing_debit_sites : bytes.getD 0x426 0 = 0x90 ∧ bytes.getD 0x427 0 = 0x55 := by decide +kernel
+
+theorem altered_jump_sites : bytes.getD 0x437 0 = 0x61 ∧ bytes.getD 0x438 0 = 0x04 ∧
+    bytes.getD 0x439 0 = 0x66 := by decide +kernel
+
+theorem missing_debit : AssembleCtxGas.checkXL F (norm prog) missingDebit cx = false := by decide +kernel
+
+theorem altered_jump : AssembleCtxGas.checkXL F (norm prog) alteredJump cx = false := by decide +kernel
+
+end SolidCore.Spec.UniswapV2.ERC20.Transfer.Neg
diff --git a/Contracts/UniswapV2/ERC20/Transfer/Source.lean b/Contracts/UniswapV2/ERC20/Transfer/Source.lean
