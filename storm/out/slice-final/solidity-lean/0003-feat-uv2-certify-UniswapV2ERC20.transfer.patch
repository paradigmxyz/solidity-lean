diff --git a/Contracts/UniswapV2/ERC20/Transfer/Certified.lean b/Contracts/UniswapV2/ERC20/Transfer/Certified.lean
new file mode 100644
index 0000000..feb5dcc
--- /dev/null
+++ b/Contracts/UniswapV2/ERC20/Transfer/Certified.lean
@@ -0,0 +1,144 @@
+import Contracts.UniswapV2.ERC20.Transfer.Compiled
+import Contracts.UniswapV2.ERC20.Transfer.Tree
+import Verify.Spec.TreeOn
+
+/-!
+# UniswapV2ERC20.transfer: certified
+
+`shape_eq`: SolidCore's checked contract dispatches transfer's selector to a function of two
+parameters whose erased tree is `tree`, by the kernel's evaluation from the source text up.
+`meets`: every result of SolidCore's source on a valid call meets `Post` (from `tree_post` through
+`allowed_of_tree`); `allowed`: and its status is allowed. `certified`: with `compiled_valid`, all
+four obligations of `Certified` for the exact runtime bytes, on `Valid`, with the proved gas bound.
+-/
+
+namespace SolidCore.Spec.UniswapV2.ERC20.Transfer
+
+open SolarTV SolidCore.Refinement SolidCore.Refinement.Generic SolidCore.Refinement.Shapes
+
+/-- How SolidCore dispatches transfer and the generic source stage erases it. -/
+def shape? : Option (Option (Nat × Option Tree)) :=
+  match SolidCore.Verify.VC.UniswapV2ERC20.contract? with
+  | .ok c => some ((c.core.findFunctionBySelector? transferSel).map fun f =>
+      (f.params.length, eraseFn (envOf c.core) SolidCore.Verify.VC.UniswapV2ERC20.fuel f))
+  | .error _ => none
+
+kernel_rfl shape_eq shape? (some (some (2, some tree))) using SolidCore.Verify.VC.UniswapV2ERC20.selector_eq SolidCore.Verify.VC.mkIdx_eq SolidCore.Verify.VC.UniswapV2ERC20.digest_eq SolidCore.Spec.UniswapV2.ERC20.Keccak.keccakWord_eq
+
+/-- What the tree shows at a call's words, for the post. -/
+def Q (ρ : Generic.Val) (obs : Observable) : Prop :=
+  (∀ k, ρ.store k < 2 ^ 256) → ∀ t a, ρ.args = [t, a] → t < 2 ^ 160 → PostOf ρ.store t a obs
+
+theorem tree_on : SolidCore.Spec.TreeOn (SolidCore.Spec.StageVal 2) Q tree := by
+  rintro ⟨args, st, h⟩ ⟨-, hb, hh⟩ hs t a hargs ht
+  simp only at hargs hh hs hb ⊢
+  subst hargs hh
+  exact tree_post st hs t a ht (hb a (by simp))
+
+/-- **The specification**: every result of SolidCore's source on a valid call meets `Post`. -/
+theorem meets {c : SolidCore.Solidity.TypeCheck.CheckedContract}
+    (hc : SolidCore.Verify.VC.UniswapV2ERC20.contract? = .ok c) :
+    Meets (solidCore SolidCore.Verify.VC.UniswapV2ERC20.fuel) c Valid Post := by
+  intro call hv obs hrun
+  have hdep := deploy_eq
+  simp only [deploy?, hc] at hdep
+  obtain ⟨d, hd⟩ := Wide.deployedAt_of hdep
+  have hshape := shape_eq
+  simp only [shape?, hc, Option.some.injEq, Option.map_eq_some_iff, Prod.mk.injEq] at hshape
+  obtain ⟨f, hf, hlen, hT⟩ := hshape
+  have hq := SolidCore.Spec.allowed_of_tree (fn := fn_transfer) hd (by decide) hf hlen hT tree_on
+    call (valid_sub call hv) obs hrun
+  intro t a hcd ht ha
+  have hargs : ∀ x ∈ [t, a], x < 2 ^ 256 := by
+    intro x hx; simp at hx; rcases hx with rfl | rfl <;> omega
+  have hv' : SolidCore.Spec.valOf call = ⟨[t, a], slotValue call.storage, solHash⟩ := by
+    simp only [SolidCore.Spec.valOf, hcd]
+    rw [SolidCore.Spec.words_calldata _ hargs]
+  rw [hv'] at hq
+  exact hq (fun k => Generic.slotValue_lt _ k) t a rfl ht
+
+/-- **The allowed statuses** of every result of SolidCore's source on a valid call. -/
+theorem allowed {c : SolidCore.Solidity.TypeCheck.CheckedContract}
+    (hc : SolidCore.Verify.VC.UniswapV2ERC20.contract? = .ok c) :
+    ∀ call, Valid call → ∀ obs,
+      (solidCore SolidCore.Verify.VC.UniswapV2ERC20.fuel).run c call = some obs → Allowed call obs := by
+  intro call hv obs hrun
+  have hp := meets hc call hv obs hrun
+  by_cases hs : obs.success = true
+  · exact Or.inl hs
+  · refine Or.inr fun t a hcd ht ha => ?_
+    rcases allowed_of_postOf (hp t a hcd ht ha) with h | h | h
+    · exact absurd h hs
+    · exact Or.inl h
+    · exact Or.inr h
+
+/-- **UniswapV2ERC20.transfer is certified**: SolidCore's checked contract of the pinned source,
+on the statement's valid calls, is equivalent to the exact runtime bytes `code` from `gasBound` gas on,
+terminates with an allowed status, and meets the sequential post. -/
+theorem certified : ∃ c, SolidCore.Verify.VC.UniswapV2ERC20.contract? = .ok c ∧
+    Certified (solidCore SolidCore.Verify.VC.UniswapV2ERC20.fuel) c code Valid Allowed Post gasBound := by
+  obtain ⟨c, hc, h⟩ := compiled_valid
+  exact ⟨c, hc, Compiled.certified h (allowed hc) (meets hc)⟩
+
+/-- info: 'SolidCore.Spec.UniswapV2.ERC20.Transfer.certified' depends on axioms: [propext, Classical.choice, Quot.sound] -/
+#guard_msgs (whitespace := lax) in
+#print axioms certified
+
+/-! ## The statement's required cases, as facts of the post -/
+
+/-- A self-transfer of 1 at the maximal balance succeeds and leaves the balance unchanged (no
+recipient overflow: the credit reads the debited slot). -/
+theorem self_max_succeeds (s : Nat → Nat) (h : s (balSlot C) = 2 ^ 256 - 1) :
+    Succeeds s C 1 ∧ credited (debited s 1) C 1 (balSlot C) = 2 ^ 256 - 1 := by
+  simp only [Succeeds, credited, debited, if_pos, h]
+  omega
+
+/-- A self-transfer above the balance reverts with the subtraction's data. -/
+theorem self_insufficient (s : Nat → Nat) (v : Nat) (h : s (balSlot C) < v) (obs : Observable)
+    (hp : PostOf s C v obs) : obs.success = false ∧ obs.storage = s ∧ obs.output = subUnderflow := by
+  have hn : ¬ Succeeds s C v := fun hs => by have := hs.1; omega
+  obtain ⟨e1, -, e3, e4⟩ := hp.2 hn
+  exact ⟨e1, e3, by rw [e4, if_pos h]⟩
+
+
+/-! ## The published statement's inputs -/
+
+/-- The proved gas bound, as its number. -/
+theorem certified_lit : ∃ c, SolidCore.Verify.VC.UniswapV2ERC20.contract? = .ok c ∧
+    Certified (solidCore SolidCore.Verify.VC.UniswapV2ERC20.fuel) c code Valid Allowed Post
+      (fun _ => 6401574412) := by
+  obtain ⟨c, hc, h⟩ := certified
+  have hg : gasBound = fun _ => 6401574412 := funext fun _ => gasBound_eq
+  rw [hg] at h
+  exact ⟨c, hc, h⟩
+
+/-- The valid call of recipient 0 and value 0 from the constructor's storage. -/
+def call0 : Call := { calldata := Abi.calldata transferSel [0, 0], callvalue := 0, storage := deployed }
+
+theorem valid0 : Valid call0 := ⟨deployed, 0, 0, fun kv hkv => ⟨kv, hkv, rfl⟩, by decide, by decide, rfl⟩
+
+/-- **Non-vacuity**: the post rejects a revert of a transfer that succeeds, and the allowed
+statuses reject a revert without the source's data. -/
+theorem nonvacuous :
+    (∃ (call : Call) (obs : Observable), Valid call ∧ ¬ Post call obs) ∧
+    (∃ (call : Call) (obs : Observable), Valid call ∧ obs.success = false ∧ ¬ Allowed call obs) := by
+  refine ⟨⟨call0, ⟨false, [], [], fun _ => 0⟩, valid0, fun h => ?_⟩,
+    ⟨call0, ⟨false, [], [], fun _ => 0⟩, valid0, rfl, fun h => ?_⟩⟩
+  · have hs : Succeeds (slotValue call0.storage) 0 0 := by
+      refine ⟨Nat.zero_le _, ?_⟩
+      have := Generic.slotValue_lt call0.storage (balSlot C)
+      have := Generic.slotValue_lt call0.storage (balSlot 0)
+      simp only [debited]
+      split <;> simp only [Generic.wordSize] at * <;> omega
+    exact absurd ((h 0 0 rfl (by decide) (by decide)).1 hs).1 (by decide)
+  · rcases h with h | h
+    · exact absurd h (by decide)
+    · rcases h 0 0 rfl (by decide) (by decide) with ⟨ho, -⟩ | ⟨ho, -⟩
+      · exact absurd ho (by decide)
+      · exact absurd ho (by decide)
+
+/-- info: 'SolidCore.Spec.UniswapV2.ERC20.Transfer.nonvacuous' depends on axioms: [propext, Classical.choice, Quot.sound] -/
+#guard_msgs (whitespace := lax) in
+#print axioms nonvacuous
+
+end SolidCore.Spec.UniswapV2.ERC20.Transfer
