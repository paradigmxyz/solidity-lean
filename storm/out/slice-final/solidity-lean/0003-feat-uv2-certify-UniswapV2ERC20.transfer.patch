+++ b/Contracts/UniswapV2/ERC20/Transfer/Compiled.lean
@@ -0,0 +1,92 @@
+import Contracts.UniswapV2.ERC20.Transfer.Source
+import Verify.ShapeCtxGas
+import uv2_erc20.GuardT
+
+/-!
+# UniswapV2ERC20.transfer: source to the exact runtime bytes, with a proved gas bound
+
+`compiled` is `Shapes.Compiled` (equivalence at every gas below `2 ^ 256` with failures only
+below the bound, termination, resources from `gasBound` on) of SolidCore's checked
+`UniswapV2ERC20` and the exact runtime bytes solar emitted in this run, on transfer's calls. It
+composes, by `Shapes.compiled0XL` alone:
+
+* E3: `Transfer.check_ok`, the generic source checker on stage0 for transfer;
+* E4: `SolarTV.Milestone.Uv2Erc20T.uv2_erc20_t_mir_to_evmir`, the backend stages stage0 to evm11 on
+  every call whose selector is not one of the twelve other external functions;
+* the guard stage `SolarTV.Milestone.Uv2Erc20T.guard_run` / `guard_ends`: those calls never reach
+  the permit blocks (STATICCALL to ECRECOVER, GAS, return data);
+* E5 and E8: `CtxGas.check_ok`, the checker with contexts and gas on the exact bytes, through
+  `AssembleCtxGas.within_of_checkXL` and `forward_of_checkXL`. No hypothesis on the runner of
+  messages: neither `StaticRunner` (false, `AssembleNoCall.not_forall_staticRunner`) nor
+  `CalleesRun` appears.
+
+`compiled_valid` restricts it to the statement's `Valid` (a clean recipient address).
+-/
+
+namespace SolidCore.Spec.UniswapV2.ERC20.Transfer
+
+open SolidCore.Refinement SolidCore.Refinement.Shapes SolidCore.Refinement.Solar
+
+/-- The exact runtime bytes. -/
+abbrev code : ByteArray := SolarTV.Export.UniswapV2ERC20.CtxGas.code
+
+/-- **The gas bound**: from this gas on, every valid call ends with the source's result. -/
+def gasBound : SolarTV.Call → Nat :=
+  fun _ => AssembleLoop.gasBoundL SolarTV.Export.UniswapV2ERC20.CtxGas.cx.base 1984
+
+theorem gasBound_lt : AssembleLoop.gasBoundL SolarTV.Export.UniswapV2ERC20.CtxGas.cx.base 1984 < 2 ^ 64 := by
+  decide +kernel
+
+theorem gasBound_eq : AssembleLoop.gasBoundL SolarTV.Export.UniswapV2ERC20.CtxGas.cx.base 1984 = 6401574412 := by
+  decide +kernel
+
+theorem hscopeT : ∀ call, genericValid0 fnsT deployed call → SolarTV.Milestone.Uv2Erc20T.scope call := by
+  rintro _ ⟨σ, -, f, hf, args, hlen, hargs, rfl⟩
+  simp only [fnsT, List.mem_cons, List.not_mem_nil, or_false] at hf
+  subst hf
+  have h := (Generic.callFacts fn_transfer.sel (by decide) args hargs σ).selector
+  simp only [SolarTV.Milestone.Uv2Erc20T.scope]
+  rw [h]
+  decide
+
+/-- **transfer, from SolidCore's source to the exact bytes, with the gas bound.** -/
+theorem compiled : ∃ c, SolidCore.Verify.VC.UniswapV2ERC20.contract? = .ok c ∧
+    Compiled (solidCore SolidCore.Verify.VC.UniswapV2ERC20.fuel) c code (genericValid0 fnsT deployed) gasBound := by
+  obtain ⟨c, hc⟩ := SolidCore.Verify.VC.UniswapV2ERC20.contract_ok
+  have hdep := deploy_eq
+  simp only [deploy?, hc] at hdep
+  obtain ⟨dd, hdd⟩ := Wide.deployedAt_of hdep
+  exact ⟨c, hc, compiled0XL hdd (check_ok hc) (genericValid0_inhabited fn_transfer [] deployed)
+    (SolarTV.Milestone.Uv2Erc20T.uv2_erc20_t_mir_to_evmir oracle) hscopeT
+    (fun call h => SolarTV.Milestone.Uv2Erc20T.guard_ends oracle call (hscopeT call h))
+    (fun call h => SolarTV.Milestone.Uv2Erc20T.guard_run oracle call (hscopeT call h))
+    SolarTV.Export.UniswapV2ERC20.CtxGas.check_ok gasBound_lt⟩
+
+/-- A narrower inhabited precondition keeps the shape. -/
+theorem Compiled.restrict {S : Sem} {p : S.Prog} {code : ByteArray} {V V' : SolarTV.Call → Prop}
+    {G : SolarTV.Call → Nat} (h : Compiled S p code V G) (hsub : ∀ call, V' call → V call)
+    (inh : ∃ call, V' call) : Compiled S p code V' G where
+  inhabited := inh
+  equiv := fun gas hg call hc => h.equiv gas hg call (hsub call hc)
+  terminates := fun call hc => h.terminates call (hsub call hc)
+  resources := fun call hc => h.resources call (hsub call hc)
+
+theorem valid_sub : ∀ call, Valid call → genericValid0 fnsT deployed call := by
+  rintro _ ⟨σ, dst, v, hcov, hto, hv, rfl⟩
+  exact ⟨σ, hcov, fn_transfer, List.mem_singleton_self _, [dst, v], rfl,
+    by intro a ha; simp at ha; rcases ha with rfl | rfl <;> omega, rfl⟩
+
+theorem valid_inhabited : ∃ call, Valid call :=
+  ⟨_, deployed, 0, 0, fun kv hkv => ⟨kv, hkv, rfl⟩, by decide, by decide, rfl⟩
+
+/-- **The compiled shape on the statement's valid calls.** -/
+theorem compiled_valid : ∃ c, SolidCore.Verify.VC.UniswapV2ERC20.contract? = .ok c ∧
+    Compiled (solidCore SolidCore.Verify.VC.UniswapV2ERC20.fuel) c code Valid gasBound := by
+  obtain ⟨c, hc, h⟩ := compiled
+  exact ⟨c, hc, Compiled.restrict h valid_sub valid_inhabited⟩
+
+/-- info: 'SolidCore.Spec.UniswapV2.ERC20.Transfer.compiled_valid' depends on axioms: [propext, Classical.choice, Quot.sound] -/
+#guard_msgs (whitespace := lax) in
+#print axioms compiled_valid
+
+end SolidCore.Spec.UniswapV2.ERC20.Transfer
