@@ -0,0 +1,103 @@
+import Verify.ShapeGeneric
+import Verify.Spec.HashScope
+
+/-!
+# UniswapV2ERC20.transfer: the statement's inputs (reviewed specification, not proof)
+
+The scope is the one function `transfer(address,uint256)` of the pinned port's `UniswapV2ERC20`.
+
+* `Valid`: transfer's ABI-encoded calls with a clean recipient (`dst < 2 ^ 160`), any value word, no
+  call value, any storage (as a list that names the constructor's slot 3, whatever its value), from
+  the framework's caller `callerAddress` (0x2000; see RESULT.md: any caller is a named missing bridge).
+* `Post`: the sequential post of docs/CERTIFICATION_TARGET.md (a1c3143) over physical slots: debit the
+  caller's slot `balSlot C`, then credit the recipient's slot `balSlot dst` reading the debited state.
+  Success iff `value ≤ σ (balSlot C)` and the credit fits; then exactly those writes (every other
+  slot keeps its value), the Transfer log, and the word `true`; otherwise the source's revert data
+  (`ds-math-sub-underflow` or `ds-math-add-overflow`), no log, the storage as it was. When
+  `dst = C` the two slots are one, the credit reads the debited slot, so there is no overflow case
+  and the slot ends unchanged. The frame speaks of slots, never of keys, so it needs no hash premise.
+* `PostKeys`: the same in terms of keys, under the footprint-scoped premise
+  `ScopedSep (transferFootprint 1 C dst)` (hash-scope): for `C ≠ dst` the two slots differ.
+* `Allowed`: success, or a revert whose data is the source's and whose condition holds.
+* `gasBound`: the proved bound of the checker with contexts and gas.
+-/
+
+namespace SolidCore.Spec.UniswapV2.ERC20.Transfer
+
+open SolarTV SolidCore.Refinement SolidCore.Refinement.Generic
+
+/-- `transfer(address,uint256)`'s selector. -/
+def transferSel : Nat := 0xa9059cbb
+
+/-- The storage the constructor leaves (only its slot's presence matters to `Valid`). -/
+def deployed : List (Nat × Nat) := [(3, 78390027508550153555773896992835392567232765649225488394068785439274740276969)]
+
+/-- The caller every call of the framework comes from. -/
+abbrev C : Nat := callerAddress
+
+/-- The valid calls. -/
+def Valid (call : Call) : Prop :=
+  ∃ σ dst v, Covers deployed σ ∧ dst < 2 ^ 160 ∧ v < 2 ^ 256 ∧
+    call = { calldata := Abi.calldata transferSel [dst, v], callvalue := 0, storage := σ }
+
+/-- The slot of `balanceOf[a]` (mapping at slot 1). -/
+def balSlot (a : Nat) : Nat := solHash a 1
+
+/-- The storage after the debit of `v` at the caller's slot. -/
+def debited (σ : Nat → Nat) (v : Nat) : Nat → Nat :=
+  fun k => if k = balSlot C then σ (balSlot C) - v else σ k
+
+/-- The storage after the credit of `v` at `dst`'s slot, reading `σ'`. -/
+def credited (σ' : Nat → Nat) (dst v : Nat) : Nat → Nat :=
+  fun k => if k = balSlot dst then σ' (balSlot dst) + v else σ' k
+
+/-- The 32 bytes of a word, big-endian. -/
+def word (n : Nat) : List Nat := (List.range 32).map fun i => n / 256 ^ (31 - i) % 256
+
+/-- The data of `Error(msg)` for a message of at most 32 bytes. -/
+def errorData (msg : List Nat) : List Nat :=
+  [0x08, 0xc3, 0x79, 0xa0] ++ word 32 ++ word msg.length ++ msg ++ List.replicate (32 - msg.length) 0
+
+def subUnderflow : List Nat := errorData ("ds-math-sub-underflow".toList.map Char.toNat)
+def addOverflow : List Nat := errorData ("ds-math-add-overflow".toList.map Char.toNat)
+
+/-- `Transfer(address,address,uint256)`'s topic. -/
+def transferTopic : Nat := 0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef
+
+/-- Whether the transfer succeeds: the debit does not underflow and the credit, reading the
+debited state, does not overflow. -/
+def Succeeds (σ : Nat → Nat) (dst v : Nat) : Prop :=
+  v ≤ σ (balSlot C) ∧ debited σ v (balSlot dst) + v < 2 ^ 256
+
+/-- The post of one call with recipient `dst` and value `v` from storage `σ`. -/
+def PostOf (σ : Nat → Nat) (dst v : Nat) (obs : Observable) : Prop :=
+  (Succeeds σ dst v →
+    obs.success = true ∧ obs.output = word 1 ∧ obs.logs = [([transferTopic, C, dst], word v)] ∧
+      ∀ n < 2 ^ 256, obs.storage n = credited (debited σ v) dst v n) ∧
+  (¬ Succeeds σ dst v →
+    obs.success = false ∧ obs.logs = [] ∧ obs.storage = σ ∧
+      obs.output = if σ (balSlot C) < v then subUnderflow else addOverflow)
+
+/-- **The specification**: on a valid call, the post of its recipient and value. -/
+def Post (call : Call) (obs : Observable) : Prop :=
+  ∀ dst v, call.calldata = Abi.calldata transferSel [dst, v] → dst < 2 ^ 160 → v < 2 ^ 256 →
+    PostOf (slotValue call.storage) dst v obs
+
+/-- **The allowed statuses**: success, or the source's revert for its reason. -/
+def Allowed (call : Call) (obs : Observable) : Prop :=
+  obs.success = true ∨
+    ∀ dst v, call.calldata = Abi.calldata transferSel [dst, v] → dst < 2 ^ 160 → v < 2 ^ 256 →
+      (obs.output = subUnderflow ∧ slotValue call.storage (balSlot C) < v) ∨
+      (obs.output = addOverflow ∧ v ≤ slotValue call.storage (balSlot C) ∧
+        2 ^ 256 ≤ debited (slotValue call.storage) v (balSlot dst) + v)
+
+/-- The same post over keys, under the footprint-scoped premise of the call's two keys: for
+`C ≠ dst` the caller's balance is debited and the recipient's credited, each from its own value. -/
+def PostKeys (call : Call) (obs : Observable) : Prop :=
+  ∀ dst v, call.calldata = Abi.calldata transferSel [dst, v] → dst < 2 ^ 160 → v < 2 ^ 256 →
+    SolidCore.Spec.ScopedSep (SolidCore.Spec.transferFootprint 1 C dst) → C ≠ dst →
+    let σ := slotValue call.storage
+    v ≤ σ (balSlot C) → σ (balSlot dst) + v < 2 ^ 256 →
+      obs.storage (balSlot C) = σ (balSlot C) - v ∧ obs.storage (balSlot dst) = σ (balSlot dst) + v
+
+end SolidCore.Spec.UniswapV2.ERC20.Transfer
