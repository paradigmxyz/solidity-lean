diff --git a/tools/certify/gen_guard.py b/tools/certify/gen_guard.py
new file mode 100644
index 000000000..0a762332e
--- /dev/null
+++ b/tools/certify/gen_guard.py
@@ -0,0 +1,83 @@
+#!/usr/bin/env python3
+"""Write the guard stage of a contract's final EVM IR (untrusted text, kernel-checked by sym_exec).
+
+gen_guard.py PROOF_DIR --proof-module P --namespace N --final evmN --prev evmM --ctxgas-module M --out OUT.lean
+
+Reads the stage proof PROOF_DIR/Runs/<Final>.lean that certify.py wrote (its selector hypotheses and
+fuel) and writes the module proving, on every call of the stages' scope, that the final EVM IR and
+CtxGas.guarded (the blocks outside the checker's fragment a jump to themselves) end in the same
+result at the final fuel: guard_run, guard_ends.
+"""
+import argparse, pathlib, re
+ap = argparse.ArgumentParser()
+ap.add_argument("proof_dir", type=pathlib.Path)
+ap.add_argument("--proof-module", required=True)
+ap.add_argument("--namespace", required=True)
+ap.add_argument("--final", required=True)
+ap.add_argument("--prev", required=True)
+ap.add_argument("--ctxgas-module", required=True)
+ap.add_argument("--export-namespace", required=True)
+ap.add_argument("--out", required=True, type=pathlib.Path)
+a = ap.parse_args()
+F = a.final[0].upper() + a.final[1:]
+run = (a.proof_dir / "Runs" / f"{F}.lean").read_text()
+m = re.search(r"theorem " + a.final + r"_run \(o : Oracle\) \(call : Call\)(.*?) :\n\s*EVM\.Program\.run o " + a.prev + r" call (\d+) = ", run, re.S)
+if not m:
+    raise SystemExit("error: no run theorem of the final stage")
+hyps, fuel = m.group(1).strip(), m.group(2)
+names = re.findall(r"\((hsel\d+) :", hyps)
+syms = "\n".join(f"  have {h}s := Ne.symm {h}" for h in names)
+def proj(n):
+    if n == 0: return ""
+    if n == 1: return "h"
+    return " ".join("h" + ".2" * i + ".1" for i in range(n - 1)) + " h" + ".2" * (n - 1)
+P = proj(len(names))
+q = "\x60"
+out = f"""-- Generated by solar's tools/certify/gen_guard.py; do not edit.
+import W1Proofs.Tactic
+import W1Proofs.Axioms
+import {a.proof_module}.Stages
+import {a.ctxgas_module}
+
+/-! The guard stage: on every call of the stages' scope, the final EVM IR {q}{a.final}{q} and
+{q}CtxGas.guarded{q} (the blocks outside the checker's fragment a jump to themselves) end in the same
+result at the final fuel {fuel}, so no such call reaches those blocks. -/
+
+namespace {a.namespace}
+
+open Machine {a.export_namespace} SolarTV.Milestone.W1
+
+set_option maxHeartbeats 8000000 in
+set_option maxRecDepth 200000 in
+theorem guarded_run (o : Oracle) (call : Call) {hyps} :
+    EVM.Program.run o {a.final} call {fuel} = EVM.Program.run o CtxGas.guarded call {fuel} := by
+{syms}
+  sym_exec
+
+theorem guard_run (o : Oracle) : ∀ call, scope call →
+    EVM.Program.run o {a.final} call {fuel} =
+      EVM.Program.run o (SolidCore.Refinement.Solar.AssembleCtxGas.guard CtxGas.F (SolidCore.Refinement.Solar.AssembleCtx.norm CtxGas.prog)) call {fuel} :=
+  fun call h => by
+    rw [CtxGas.guarded_eq]
+    exact guarded_run o call {P}
+
+theorem {a.final}_ends (o : Oracle) : ∀ call, scope call →
+    (EVM.Program.run o {a.final} call {fuel}).isSome = true :=
+  fun call h => by
+    rw [← {a.final}_run o call {P}]
+    exact {a.prev}_ends o call h
+
+theorem guard_ends (o : Oracle) : ∀ call, scope call →
+    (EVM.Program.run o (SolidCore.Refinement.Solar.AssembleCtxGas.guard CtxGas.F (SolidCore.Refinement.Solar.AssembleCtx.norm CtxGas.prog)) call {fuel}).isSome = true :=
+  fun call h => by
+    rw [← guard_run o call h]
+    exact {a.final}_ends o call h
+
+/-- info: '{a.namespace}.guard_ends' depends on axioms within [propext, Classical.choice, Quot.sound] -/
+#guard_msgs in
+#axioms_within guard_ends
+
+end {a.namespace}
+"""
+a.out.write_text(out)
+print(f"{a.namespace}.guard_ends fuel={fuel} selectors={len(names)}")
