@@ -0,0 +1,78 @@
+import Verify.Spec.Tree
+
+/-!
+# What a function's erased tree shows on every call: allowed statuses from the tree
+
+`TreeOn P Q T`: on every valuation of the call's words meeting `P`, the tree's observable meets
+`Q`. `TreeOn.ite` splits a branch, adding its condition to `P`, so a property of every leaf
+under its path condition is a property of the tree. `allowed_of_tree` turns it into a statement
+about SolidCore's checked contract on the stage's calls of the function: every result of such a
+call meets `Q` at the call's own words (`valOf`: its argument words, its storage, SolidCore's
+hash). Used for the statuses a specification allows (which reverts, with which data, when).
+-/
+
+namespace SolidCore.Spec
+
+open SolarTV SolidCore.Refinement SolidCore.Refinement.Abi SolidCore.Refinement.Generic
+open SolidCore.Solidity
+
+/-- The words a call of the generic stage reads: the words after its selector, its storage and
+SolidCore's hash. -/
+def valOf (call : Call) : Val :=
+  ⟨words ((call.calldata.data.toList.map (·.toNat)).drop 4), slotValue call.storage, solHash⟩
+
+/-- The valuations of the stage's calls of a function of `n` parameters. -/
+def StageVal (n : Nat) (ρ : Val) : Prop :=
+  ρ.args.length = n ∧ (∀ a ∈ ρ.args, a < 2 ^ 256) ∧ ρ.hash = solHash
+
+/-- `Q` of the tree's observable on every valuation meeting `P`. -/
+def TreeOn (P : Val → Prop) (Q : Val → Observable → Prop) (T : Tree) : Prop :=
+  ∀ ρ, P ρ → Q ρ (T.eval ρ).obs
+
+theorem TreeOn.ite {P : Val → Prop} {Q : Val → Observable → Prop} {c : WExpr} {t e : Tree}
+    (ht : TreeOn (fun ρ => P ρ ∧ c.eval ρ ≠ 0) Q t) (he : TreeOn (fun ρ => P ρ ∧ c.eval ρ = 0) Q e) :
+    TreeOn P Q (.ite c t e) := by
+  intro ρ hp
+  simp only [Tree.eval]
+  split
+  · exact he ρ ⟨hp, by assumption⟩
+  · exact ht ρ ⟨hp, by assumption⟩
+
+/-- A leaf that succeeds meets every `Q` that allows success. -/
+theorem TreeOn.success {P : Val → Prop} {Q : Val → Observable → Prop} {out : List OByte}
+    {ws : Writes} {ls : List Log} (h : ∀ ρ obs, obs.success = true → Q ρ obs) :
+    TreeOn P Q (.halt true out ws ls) :=
+  fun ρ _ => h ρ _ rfl
+
+theorem TreeOn.mono {P P' : Val → Prop} {Q : Val → Observable → Prop} {T : Tree}
+    (h : TreeOn P Q T) (hP : ∀ ρ, P' ρ → P ρ) : TreeOn P' Q T :=
+  fun ρ hp => h ρ (hP ρ hp)
+
+/-- **A property of the tree is a property of SolidCore's contract** on the stage's calls of the
+function, at the call's own words. -/
+theorem allowed_of_tree {fuel : Nat} {c : TypeCheck.CheckedContract} {d : Source.State}
+    {s : List (Nat × Nat)} (hd : Wide.DeployedAt fuel c d s) {fn : Fn} {f : Source.FunctionDef}
+    (hsel : fn.sel < 2 ^ 32) (hfind : c.core.findFunctionBySelector? fn.sel = some f)
+    (hlen : f.params.length = fn.params.length) {T : Tree}
+    (hT : eraseFn (envOf c.core) fuel f = some T) {Q : Val → Observable → Prop}
+    (hm : TreeOn (StageVal fn.params.length) Q T) :
+    ∀ call, SolidCore.Verify.VC.stageScope fn s call → ∀ obs,
+      (solidCore fuel).run c call = some obs → Q (valOf call) obs := by
+  rintro _ ⟨σ, hcov, fn', hfn', args, hl, hargs, rfl⟩ obs hrun
+  simp only [List.mem_singleton] at hfn'
+  subst hfn'
+  have h := source_run hd hcov hsel hfind hT args (hl.trans hlen.symm) hargs
+  have hobs : obs = (T.eval ⟨args, slotValue σ, solHash⟩).obs :=
+    Option.some.inj (hrun.symm.trans h)
+  subst hobs
+  have hv : valOf { calldata := calldata fn'.sel args, callvalue := 0, storage := σ } =
+      ⟨args, slotValue σ, solHash⟩ := by
+    simp only [valOf, words_calldata _ hargs]
+  rw [hv]
+  exact hm _ ⟨hl, hargs, rfl⟩
+
+/-- info: 'SolidCore.Spec.allowed_of_tree' depends on axioms: [propext, Classical.choice, Quot.sound] -/
+#guard_msgs (whitespace := lax) in
+#print axioms allowed_of_tree
+
+end SolidCore.Spec
