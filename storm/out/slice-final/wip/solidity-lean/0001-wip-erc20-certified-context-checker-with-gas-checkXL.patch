+import Verify.ShapeCtx
+import SolidCore.Refinement.Solar.AssembleCtxGas
+
+/-!
+# The certified shape through the checker with contexts and gas
+
+For contracts whose final EVM IR the loop checker rejects only because of blocks no valid call
+reaches (a permit path's STATICCALL and GAS, say), and whose internal functions are called in
+several contexts. Inputs, all generated by the certify driver:
+
+* the source stage and its definedness (from `Generic.check`);
+* `backend`: solar-tv's stages from the module to the final EVM IR `q`;
+* `ends` / `guard_run`: on each valid call, the run of `guard F q` (each block of `F` replaced by
+  a jump to itself) ends within `N` blocks and equals `q`'s run at that fuel: so no valid call
+  enters `F`;
+* `asm`: `AssembleCtxGas.checkXL F q code cx`.
+
+`compiled_ofXL` proves `Compiled` at the one oracle `oracle`, with the gas bound
+`gasBoundL cx.base N`. Unlike `functional_ctx` it has no hypothesis on the runner of messages
+(no `StaticRunner`, no `CalleesRun`): EthLib's run of the bytes never reaches a STATICCALL or a GAS
+on a valid call, which `within_of_checkXL` and `forward_of_checkXL` prove from the same block bound.
+-/
+
+namespace SolidCore.Refinement.Shapes
+
+open SolarTV SolidCore.Refinement SolidCore.Refinement.Final SolidCore.Refinement.Abi
+open SolidCore.Refinement.Solar SolidCore.Solidity
+
+theorem evmir_run_of_iterate {o : Machine.Oracle} {q : Assemble.Program} {call : Call} {N : Nat}
+    {r : Machine.Halt × Machine.State}
+    (h : EVM.Program.run o q call N = some r) :
+    (evmirSem o).run q call = some (Machine.observe call r.2 r.1) := by
+  change (SolarTV.EVM.Program.layer.result o q call).map _ = _
+  rw [SolarTV.EVM.Program.layer.result_of_ends ⟨N, h⟩]
+  rfl
+
+/-- **The shape from a total source stage, the backend stages and the checker with contexts and
+gas.** -/
+theorem compiled_ofXL {S : Sem} {p : S.Prog} {m : MIR.Lowered.moduleLayer.Prog}
+    {q : Assemble.Program} {code : ByteArray} {Valid scope : Call → Prop} {F : List Nat}
+    {cx : AssembleCtx.CtxCert} {N : Nat}
+    (inhabited : ∃ call, Valid call)
+    (src : Stage S (mirSem oracle) p m Valid) (defined : Defined S p Valid)
+    (backend : Stage (mirSem oracle) (evmirSem oracle) m q scope)
+    (hscope : ∀ call, Valid call → scope call)
+    (ends : ∀ call, Valid call →
+      (EVM.Program.run oracle (AssembleCtxGas.guard F q) call N).isSome = true)
+    (guard_run : ∀ call, Valid call →
+      EVM.Program.run oracle q call N = EVM.Program.run oracle (AssembleCtxGas.guard F q) call N)
+    (asm : AssembleCtxGas.checkXL F q code cx = true)
+    (hG : AssembleLoop.gasBoundL cx.base N < 2 ^ 64) :
+    Compiled S p code Valid (fun _ => AssembleLoop.gasBoundL cx.base N) := by
+  have total : ∀ call, Valid call → ∃ obs, S.run p call = some obs := fun call hc =>
+    Option.isSome_iff_exists.mp (defined call hc)
+  have stage : Stage S (evmirSem oracle) p q Valid :=
+    src.trans (backend.mono hscope)
+  -- On a valid call: the guarded run's result, and the source's result is its observable.
+  have key : ∀ call, Valid call → ∃ r,
+      Machine.iterate (EVM.Program.block oracle call (AssembleCtxGas.guard F q)) N
+        (0, [], Machine.State.initial call) = some r ∧
+      S.run p call = some (Machine.observe call r.2 r.1) ∧
+      (evmirSem oracle).run q call = some (Machine.observe call r.2 r.1) := by
+    intro call hc
+    obtain ⟨r, hr⟩ := Option.isSome_iff_exists.mp (ends call hc)
+    have hq : (evmirSem oracle).run q call = some (Machine.observe call r.2 r.1) :=
+      evmir_run_of_iterate ((guard_run call hc).trans hr)
+    obtain ⟨obs0, h0⟩ := total call hc
+    have := stage call hc obs0 h0
+    rw [hq] at this
+    cases this
+    exact ⟨r, hr, h0, hq⟩
+  have hequiv : Equiv S p code Valid := by
+    intro gas _ call hc obs hrun
+    obtain ⟨r, hit, hs, -⟩ := key call hc
+    rcases AssembleCtxGas.within_of_checkXL asm oracle (fun _ => oracle_ok.1) (fun _ => oracle_ok.2)
+      call N r hit gas obs hrun with e | e
+    · exact Or.inl (e ▸ hs)
+    · exact Or.inr e
+  have hres : Resources S p code Valid (fun _ => AssembleLoop.gasBoundL cx.base N) :=
+    resources_of_forward (B := evmirSem oracle) (q := q) total stage fun call hc =>
+      ⟨hG, fun _ h1 _ obs hrun => by
+        obtain ⟨r, hit, -, hq⟩ := key call hc
+        rw [hq] at hrun
+        cases hrun
+        exact AssembleCtxGas.forward_of_checkXL asm oracle (fun _ => oracle_ok.1)
+          (fun _ => oracle_ok.2) call N r hit h1⟩
+  exact ⟨inhabited, equivG_of hequiv hres, fun call hc => by
+    obtain ⟨obs, hs⟩ := total call hc
+    exact ⟨obs, hs, trivial⟩, hres⟩
+
+/-- **The shape of a generic-stage contract on calls without a value, through the checker with
+contexts and gas.** -/
+theorem compiled0XL {fuel mirFuel : Nat} {c : TypeCheck.CheckedContract} {d : Source.State}
+    {s : List (Nat × Nat)} (hd : Wide.DeployedAt fuel c d s) {m : MIR.Lowered.Module}
+    {fns : List Fn} {env : Generic.EnvFlags}
+    (hchk : Generic.check fuel mirFuel c.core m fns env = true)
+    {q : Assemble.Program} {code : ByteArray} {scope : Call → Prop} {F : List Nat}
+    {cx : AssembleCtx.CtxCert} {N : Nat}
+    (inhabited : ∃ call, genericValid0 fns s call)
+    (backend : Stage (mirSem oracle) (evmirSem oracle) m q scope)
+    (hscope : ∀ call, genericValid0 fns s call → scope call)
+    (ends : ∀ call, genericValid0 fns s call →
+      (EVM.Program.run oracle (AssembleCtxGas.guard F q) call N).isSome = true)
+    (guard_run : ∀ call, genericValid0 fns s call →
+      EVM.Program.run oracle q call N = EVM.Program.run oracle (AssembleCtxGas.guard F q) call N)
+    (asm : AssembleCtxGas.checkXL F q code cx = true)
+    (hG : AssembleLoop.gasBoundL cx.base N < 2 ^ 64) :
+    Compiled (solidCore fuel) c code (genericValid0 fns s)
+      (fun _ => AssembleLoop.gasBoundL cx.base N) :=
+  compiled_ofXL inhabited (Generic.stageAtWith oracle hd oracle_sourceEnvOk.ask hchk)
+    (Generic.definedAt hd hchk) backend hscope ends guard_run asm hG
+
+/-- info: 'SolidCore.Refinement.Shapes.compiled0XL' depends on axioms: [propext, Classical.choice, Quot.sound] -/
+#guard_msgs (whitespace := lax) in
+#print axioms compiled0XL
+
+end SolidCore.Refinement.Shapes
