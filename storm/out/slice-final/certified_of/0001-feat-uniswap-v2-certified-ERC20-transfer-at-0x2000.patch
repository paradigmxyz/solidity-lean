+-- ContractsUniswapV2TransferSlice (scripts/verify/uniswap_v2_stages.sh, uniswap_v2_transfer_slice.sh).
+lean_lib ContractsUniswapV2ERC20Certified where
+  roots := #[`Contracts.UniswapV2.ERC20.Certified.Transfer]
