diff --git a/scripts/verify/uniswap_v2_stages_nested.sh b/scripts/verify/uniswap_v2_stages_nested.sh
new file mode 100755
index 0000000..47f80b5
--- /dev/null
+++ b/scripts/verify/uniswap_v2_stages_nested.sh
@@ -0,0 +1,92 @@
+#!/usr/bin/env bash
+# Generate the approve and transferFrom slices of UniswapV2ERC20 before the build of the uv2_erc20
+# library, after scripts/verify/uniswap_v2_stages.sh (which exports the stages into
+# Certified/uv2_erc20/gen and builds or checks the pinned solar). None is committed: each is
+# compiled from the GPL-3.0 v2-core port.
+#
+#   scripts/verify/uniswap_v2_gen.sh
+#   scripts/verify/uniswap_v2_stages.sh
+#   scripts/verify/uniswap_v2_stages_nested.sh
+#   lake build -KleanMemory=6000 uv2_erc20 ContractsUniswapV2ERC20Certified
+#
+# Writes, under Certified/uv2_erc20/ (ignored by git), for approve(address,uint256) (A, selector
+# 0x095ea7b3) and transferFrom(address,address,uint256) (TF, selector 0x23b872dd):
+#   CtxGasA.lean, CtxGasTF.lean  gen_ctxgas.py's certificate on the exact bytes against the final
+#                                EVM IR, every block outside the function's slice unchecked, in the
+#                                namespaces SolarTV.Export.UniswapV2ERC20.CtxGasA / CtxGasTF;
+#   ProofsA/, ProofsTF/          certify.py: each backend stage's refinement for the calls of that
+#                                function (every other selector excluded), and their composition
+#                                (Stages.lean), namespaces SolarTV.Milestone.Uv2Erc20A / Uv2Erc20TF.
+# Uses SOLAR_DIR as uniswap_v2_stages.sh does (default .cache/solar-stages).
+set -euo pipefail
+cd "$(dirname "${BASH_SOURCE[0]}")/../.."
+
+SOLAR_DIR="$(realpath "${SOLAR_DIR:-.cache/solar-stages}")"
+rev="$(tr -d '[:space:]' < scripts/verify/uniswap_v2_stages-solar-rev)"
+[[ "$(git -C "$SOLAR_DIR" rev-parse HEAD)" == "$rev" ]] || {
+  echo "error: $SOLAR_DIR is not at $rev; run scripts/verify/uniswap_v2_stages.sh first" >&2; exit 1; }
+out=Certified/uv2_erc20
+gen="$out/gen/UniswapV2ERC20"
+[[ -s "$gen/manifest.json" ]] || { echo "error: $gen missing; run scripts/verify/uniswap_v2_stages.sh" >&2; exit 1; }
+
+all=(
+  '06fdde03=name()'
+  '95d89b41=symbol()'
+  '313ce567=decimals()'
+  '18160ddd=totalSupply()'
+  '70a08231=balanceOf(address)'
+  'dd62ed3e=allowance(address,address)'
+  '3644e515=DOMAIN_SEPARATOR()'
+  '30adf81f=PERMIT_TYPEHASH()'
+  '7ecebe00=nonces(address)'
+  'd505accf=permit(address,address,uint256,uint256,uint8,bytes32,bytes32)'
+  'a9059cbb=transfer(address,uint256)'
+  '095ea7b3=approve(address,uint256)'
+  '23b872dd=transferFrom(address,address,uint256)'
+)
+
+slice() { # suffix selector label [certify.py options]
+  local suf=$1 sel=$2 label=$3 args=()
+  shift 3
+  for e in "${all[@]}"; do [[ "${e%%=*}" == "$sel" ]] || args+=(--exclude "$e"); done
+  python3 "$SOLAR_DIR/tools/certify/gen_ctxgas.py" "$gen" --module-prefix uv2_erc20.gen.UniswapV2ERC20 \
+    --contract UniswapV2ERC20 --final evm11 --selector "0x$sel" --out "$out/CtxGas$suf.lean"
+  # --selector keeps blocks 0 and 1 as the dispatcher; the selectors below 0x3644e515 are compared
+  # in a second dispatcher block, which the calls of approve and transferFrom run. Check every
+  # block that compares the selector too: regenerate with the slice's skipped blocks less those.
+  local skip
+  skip=$(python3 - "$out/CtxGas$suf.lean" "$gen/Evm11.lean" "$sel" <<'PY'
+import re, sys
+ctx, evm, sel = open(sys.argv[1]).read(), open(sys.argv[2]).read(), int(sys.argv[3], 16)
+F = [int(x) for x in re.search(r"^def F : List Nat := \[([0-9, ]*)\]", ctx, re.M).group(1).split(",") if x.strip()]
+blocks = re.split(r"\n\s*-- bb\d+\n", evm.split("blocks := [", 1)[1])[1:]
+push = re.compile(r"\.push (0x[0-9a-fA-F]+|\d+)\)")
+cmp = {i for i, b in enumerate(blocks) if any(int(m, 0) == sel for m in push.findall(b))}
+if not cmp:
+    sys.exit("error: no block compares the selector")
+print(",".join(str(b) for b in F if b not in cmp))
+PY
+)
+  python3 "$SOLAR_DIR/tools/certify/gen_ctxgas.py" "$gen" --module-prefix uv2_erc20.gen.UniswapV2ERC20 \
+    --contract UniswapV2ERC20 --final evm11 --skip "$skip" --out "$out/CtxGas$suf.lean"
+  sed -i "s/SolarTV\.Export\.UniswapV2ERC20\.CtxGas\b/SolarTV.Export.UniswapV2ERC20.CtxGas$suf/g" "$out/CtxGas$suf.lean"
+  grep -q "^namespace SolarTV.Export.UniswapV2ERC20.CtxGas$suf$" "$out/CtxGas$suf.lean" || {
+    echo "error: CtxGas$suf.lean has no namespace CtxGas$suf" >&2; exit 1; }
+  rm -rf "$out/Proofs$suf" "$out/Proofs$suf.lean"
+  python3 "$SOLAR_DIR/tools/certify/certify.py" "$gen" --gen-module uv2_erc20.gen.UniswapV2ERC20 \
+    --proof-dir "$out/Proofs$suf" --proof-module "uv2_erc20.Proofs$suf" \
+    --namespace "SolarTV.Milestone.Uv2Erc20$suf" --label "$label" \
+    --cut --joins --no-mir-joins --segment 16 "$@" "${args[@]}"
+  [[ -s "$out/Proofs$suf/Stages.lean" ]] || { echo "error: $out/Proofs$suf/Stages.lean missing" >&2; exit 1; }
+  # Segments of 16 configurations (transfer's use 8): with 8, the inline-returns stage (evm10) is
+  # cut at the second dispatcher block, whose relation keeps the selector as an unknown word, so
+  # the segment from there walks the excluded functions too and its proof fails.
+  if grep -l '(3, \[w0\]' "$out/Proofs$suf"/Runs/*.lean; then
+    echo "error: Proofs$suf cuts at the second dispatcher block" >&2; exit 1
+  fi
+}
+
+slice A 095ea7b3 uv2_erc20_approve
+# transferFrom's first segment of evm2 runs past the default 2000000 heartbeats.
+slice TF 23b872dd uv2_erc20_transferFrom --heartbeats 8000000
+echo "wrote $out/CtxGasA.lean $out/CtxGasTF.lean $out/ProofsA $out/ProofsTF"
