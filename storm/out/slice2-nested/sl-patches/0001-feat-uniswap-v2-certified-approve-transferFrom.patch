+  IR `evm11` on the calls of transferFrom's selector, under every oracle;
+* E5 + E8 `CtxGasTF.check_ok` with the guard stage (`GasGuardTF`): the equivalence at every gas and
+  the gas bound `G = 15558412` (`CtxGasTF.G_eq`);
+* E7 `Nested.transferFrom_meets`: every SolidCore run of a valid call gives exactly
+  `transferFromResult` (the allowance step, the checked debit and credit, in the source's order)
+  of the call's storage and argument words.
+
+**Caller.** As for transfer, SolidCore's semantics fix the caller to `0x2000`; the backend holds
+from any caller (`AnyCaller.TransferFrom.backend_any_caller`).
+
+**No premise** in `certified`: the valid calls are `Nested.TransferFromValid`
+(= `genericValid0 [fn_transferFrom] deployed`), and the postcondition is exact over the slot
+function. The key-level readings take the scoped premise
+`Scoped (transferFromFootprint caller frm dst)` at the call they are about.
+
+* `certified`: `∃ c, contract? = .ok c ∧ Certified (solidCore fuel) c code TransferFromValid Allowed
+  TransferFromPost (fun _ => 15558412)`, with `Allowed` = success, or a revert with no data (a
+  dirty address word), `Error("ds-math-sub-underflow")` or `Error("ds-math-add-overflow")`.
+* `transferFrom_bytes`: from the gas bound on, the bytes give exactly `transferFromResult`.
+* `self_max_bytes`, `self_short_bytes`: the required self-transfer cases on the bytes: from a
+  balance of `2 ^ 256 - 1` with an infinite allowance, `transferFrom(frm, frm, 1)` succeeds with
+  the balance unchanged; above the balance it reverts.
+-/
+
+namespace SolidCore.Spec.UniswapV2.ERC20.Certified.TransferFrom
+
+open SolarTV SolidCore.Refinement SolidCore.Refinement.Generic SolidCore.Refinement.Shapes
+open SolidCore.Spec.UniswapV2.ERC20.Nested
+open SolarTV.Export.UniswapV2ERC20.CtxGasTF (G G_eq G_lt check_ok guard_ends guard_run TransferFromCall prog)
+
+/-- The exact runtime bytes. -/
+abbrev code : ByteArray := SolarTV.Export.UniswapV2ERC20.CtxGasTF.code
+
+/-- The allowed statuses: success, or a revert with no data or ds-math's messages. -/
+def Allowed (_call : Call) (obs : Observable) : Prop :=
+  obs.success = true ∨ obs.output = [] ∨ obs.output = subUnderflow ∨ obs.output = addOverflow
+
+/-- A valid call of transferFrom has transferFrom's selector. -/
+theorem selector_of : ∀ call, TransferFromValid call → TransferFromCall call := by
+  rintro _ ⟨σ, -, f, hf, args, -, hargs, rfl⟩
+  simp only [List.mem_singleton] at hf
+  subst hf
+  exact (SolidCore.Refinement.Generic.callFacts fn_transferFrom.sel (by decide) args hargs σ).selector
+
+set_option maxRecDepth 200000 in
+theorem hscope : ∀ call, TransferFromValid call → SolarTV.Milestone.Uv2Erc20TF.scope call := by
+  intro call h
+  simp only [SolarTV.Milestone.Uv2Erc20TF.scope]
+  have hs := selector_of call h
+  simp only [TransferFromCall] at hs
+  rw [hs]
+  decide
+
+/-- E4 onto the final EVM IR's effect form (the same runs, `sem_norm`). -/
+theorem backend : Stage (mirSem oracle) (evmirSem oracle) SolarTV.Export.UniswapV2ERC20.stage0
+    (SolidCore.Refinement.Solar.AssembleCtx.norm prog) SolarTV.Milestone.Uv2Erc20TF.scope :=
+  fun call h obs hr => (SolidCore.Refinement.Solar.AssembleCtx.sem_norm oracle prog call).trans
+    (SolarTV.Milestone.Uv2Erc20TF.uv2_erc20_transferFrom_mir_to_evmir oracle call h obs hr)
+
+set_option maxRecDepth 200000 in
+/-- **E3, E4, E5 and E8 composed** for transferFrom. -/
+theorem compiled {c : SolidCore.Solidity.TypeCheck.CheckedContract}
+    (hc : SolidCore.Verify.VC.UniswapV2ERC20.contract? = .ok c) :
+    Compiled (solidCore SolidCore.Verify.VC.UniswapV2ERC20.fuel) c code TransferFromValid (fun _ => G) := by
+  have hdep := deploy_eq
+  simp only [deploy?, hc] at hdep
+  obtain ⟨_, hdd⟩ := Wide.deployedAt_of hdep
+  exact compiled0XL hdd (check_transferFrom_ok hc) (genericValid0_inhabited fn_transferFrom [] deployed)
+    backend hscope (fun call h => guard_ends oracle call (selector_of call h))
+    (fun call h => guard_run oracle call (selector_of call h)) check_ok G_lt
+
+/-- Every result `transferFromResult` gives has an allowed status. -/
+theorem allowed_result (call : Call) (st : Nat → Nat) (frm dst value : Nat) :
+    Allowed call (transferFromResult st frm dst value) := by
+  unfold Allowed
+  dsimp only [transferFromResult, transferSteps, revertWith]
+  split_ifs <;> simp
+
+/-- Every SolidCore result of a valid call has an allowed status. -/
+theorem allowed {c : SolidCore.Solidity.TypeCheck.CheckedContract}
+    (hc : SolidCore.Verify.VC.UniswapV2ERC20.contract? = .ok c) :
+    ∀ call, TransferFromValid call → ∀ obs,
+      (solidCore SolidCore.Verify.VC.UniswapV2ERC20.fuel).run c call = some obs → Allowed call obs := by
+  intro call hv obs hrun
+  rw [transferFrom_meets hc call hv obs hrun]
+  exact allowed_result _ _ _ _ _
+
+/-- **UniswapV2ERC20.transferFrom is certified at the caller 0x2000**: on every call of
+`transferFrom(frm, dst, value)` from 0x2000 with any argument words, no value and any storage
+listing the deployed slot, the exact runtime bytes behave as SolidCore's checked source (at every
+gas, and exactly from 15558412 gas on), which ends with an allowed status and gives exactly
+`transferFromResult`. -/
+theorem certified : ∃ c, SolidCore.Verify.VC.UniswapV2ERC20.contract? = .ok c ∧
+    Certified (solidCore SolidCore.Verify.VC.UniswapV2ERC20.fuel) c code TransferFromValid Allowed
+      TransferFromPost (fun _ => 15558412) := by
+  obtain ⟨c, hc⟩ := SolidCore.Verify.VC.UniswapV2ERC20.contract_ok
+  have h := (compiled hc).certified (allowed hc) (transferFrom_meets hc)
+  rw [show (fun _ : Call => G) = fun _ => 15558412 from funext fun _ => G_eq] at h
+  exact ⟨c, hc, h⟩
+
+/-! ## On the bytes -/
+
+/-- From the gas bound on, the bytes give SolidCore's result on a valid call. -/
+theorem bytes_eq_source {c : SolidCore.Solidity.TypeCheck.CheckedContract}
+    (hc : SolidCore.Verify.VC.UniswapV2ERC20.contract? = .ok c) {call : Call} (hv : TransferFromValid call)
+    {gas : Nat} (h1 : 15558412 ≤ gas) (h2 : gas < 2 ^ 256) :
+    Final.Target.runWith gas code call = (solidCore SolidCore.Verify.VC.UniswapV2ERC20.fuel).run c call :=
+  ((compiled hc).resources call hv).2 gas (by rw [G_eq]; exact h1) h2
+
+/-- The call `transferFrom(frm, dst, value)` on the storage `σ`. -/
+def transferFromCall (σ : List (Nat × Nat)) (frm dst value : Nat) : Call :=
+  { calldata := SolidCore.Refinement.Abi.calldata fn_transferFrom.sel [frm, dst, value], callvalue := 0,
+    storage := σ }
+
+/-- **transferFrom on the bytes**: from the gas bound on, exactly `transferFromResult`. -/
+theorem transferFrom_bytes (σ : List (Nat × Nat)) (hcov : Covers deployed σ) (frm dst value : Nat)
+    (hf : frm < 2 ^ 256) (hd : dst < 2 ^ 256) (hv : value < 2 ^ 256) (gas : Nat)
+    (h1 : 15558412 ≤ gas) (h2 : gas < 2 ^ 256) :
+    Final.Target.runWith gas code (transferFromCall σ frm dst value) =
+      some (transferFromResult (slotValue σ) frm dst value) := by
+  obtain ⟨c, hc⟩ := SolidCore.Verify.VC.UniswapV2ERC20.contract_ok
+  have hargs : ∀ a ∈ [frm, dst, value], a < 2 ^ 256 := by
+    intro a ha; simp only [List.mem_cons, List.not_mem_nil, or_false] at ha
+    rcases ha with rfl | rfl | rfl <;> assumption
+  have hval : TransferFromValid (transferFromCall σ frm dst value) :=
+    ⟨σ, hcov, fn_transferFrom, List.mem_singleton_self _, [frm, dst, value], rfl, hargs, rfl⟩
+  obtain ⟨obs, hrun, -⟩ := (compiled hc).terminates _ hval
+  rw [bytes_eq_source hc hval h1 h2, hrun, transferFrom_meets hc _ hval obs hrun]
+  simp [transferFromCall, SolidCore.Spec.UniswapV2.ERC20.Nested.callArgs, words_calldata _ hargs]
+
+/-- **Required case, on the bytes**: from a balance of `2 ^ 256 - 1` with an infinite allowance,
+`transferFrom(frm, frm, 1)` succeeds and the balance stays `2 ^ 256 - 1`. -/
+theorem self_max_bytes (σ : List (Nat × Nat)) (hcov : Covers deployed σ) (frm : Nat)
+    (hfa : frm < 2 ^ 160)
+    (h : HashScopeNested.Scoped (HashScopeNested.transferFromFootprint caller frm frm))
+    (hb : slotValue σ (balanceSlot frm) = 2 ^ 256 - 1) (ha : slotValue σ (allowanceSlot frm caller) = umax)
+    (gas : Nat) (h1 : 15558412 ≤ gas) (h2 : gas < 2 ^ 256) :
+    ∃ obs, Final.Target.runWith gas code (transferFromCall σ frm frm 1) = some obs ∧
+      obs.success = true ∧ obs.storage (balanceSlot frm) = 2 ^ 256 - 1 :=
+  ⟨_, transferFrom_bytes σ hcov frm frm 1 (by omega) (by omega) (by decide) gas h1 h2,
+    transferFrom_self_max (slotValue σ) (fun k => slotValue_lt σ k) frm hfa h hb ha⟩
+
+/-- **Required case, on the bytes**: a self-transfer above the balance reverts. -/
+theorem self_short_bytes (σ : List (Nat × Nat)) (hcov : Covers deployed σ) (frm value : Nat)
+    (hfa : frm < 2 ^ 160) (hv : value < 2 ^ 256)
+    (h : HashScopeNested.Scoped (HashScopeNested.transferFromFootprint caller frm frm))
+    (hlt : slotValue σ (balanceSlot frm) < value)
+    (gas : Nat) (h1 : 15558412 ≤ gas) (h2 : gas < 2 ^ 256) :
+    ∃ obs, Final.Target.runWith gas code (transferFromCall σ frm frm value) = some obs ∧
+      obs.success = false :=
+  ⟨_, transferFrom_bytes σ hcov frm frm value (by omega) (by omega) hv gas h1 h2,
+    transferFrom_self_short (slotValue σ) (fun k => slotValue_lt σ k) frm value hfa h hlt⟩
+
+/-- info: 'SolidCore.Spec.UniswapV2.ERC20.Certified.TransferFrom.certified' depends on axioms: [propext, Classical.choice, Quot.sound] -/
+#guard_msgs (whitespace := lax) in
+#print axioms certified
+
+/-- info: 'SolidCore.Spec.UniswapV2.ERC20.Certified.TransferFrom.transferFrom_bytes' depends on axioms: [propext, Classical.choice, Quot.sound] -/
+#guard_msgs (whitespace := lax) in
+#print axioms transferFrom_bytes
+
+/-- info: 'SolidCore.Spec.UniswapV2.ERC20.Certified.TransferFrom.self_max_bytes' depends on axioms: [propext, Classical.choice, Quot.sound] -/
+#guard_msgs (whitespace := lax) in
+#print axioms self_max_bytes
+
+/-- info: 'SolidCore.Spec.UniswapV2.ERC20.Certified.TransferFrom.self_short_bytes' depends on axioms: [propext, Classical.choice, Quot.sound] -/
+#guard_msgs (whitespace := lax) in
+#print axioms self_short_bytes
+
+end SolidCore.Spec.UniswapV2.ERC20.Certified.TransferFrom
