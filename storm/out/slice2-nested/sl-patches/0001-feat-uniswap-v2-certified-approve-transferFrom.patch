@@ -0,0 +1,72 @@
+import W1Proofs.Tactic
+import W1Proofs.Axioms
+import uv2_erc20.CtxGasTF
+
+-- Untrusted proof script: the kernel checks it. The statement speaks only of the generated
+-- program and its guarded copy.
+
+/-!
+# UniswapV2ERC20.transferFrom: the guard stage
+
+On every call whose selector is `transferFrom(address,address,uint256)`'s, under every oracle, the
+final EVM
+IR `evm11` and `CtxGasTF.guarded` (each block of `CtxGasTF.F`, the blocks of the other functions, a
+jump to itself) end within `N` blocks in the same result: no such call enters a block the checker
+with contexts and gas leaves unchecked. Symbolic execution (`sym_exec`) over a symbolic call and
+oracle: the calldata, the storage and the oracle stay opaque.
+-/
+
+namespace SolarTV.Export.UniswapV2ERC20.CtxGasTF
+
+open SolarTV SolarTV.Machine SolarTV.Milestone.W1
+
+/-- The blocks a call of transferFrom runs, at most: the two dispatcher blocks, the entry, the
+allowance step, the debit, the credit, the log and the return; or a revert. -/
+def N : Nat := 11
+
+/-- A call of transferFrom: its first calldata word's top four bytes are the selector `0x23b872dd`.
+-/
+def TransferFromCall (call : Call) : Prop :=
+  EvmRules.Evm.shr 224 (calldataWord call 0) = 0x23b872dd
+
+set_option maxHeartbeats 16000000 in
+theorem guarded_run11 (o : Oracle) (call : Call)
+    (hsel : EvmRules.Evm.shr 224 (calldataWord call 0) = 0x23b872dd) :
+    EVM.Program.run o SolarTV.Export.UniswapV2ERC20.evm11 call 11 = EVM.Program.run o guarded call 11 := by
+  sym_exec
+
+set_option maxHeartbeats 16000000 in
+theorem guarded_ends11 (o : Oracle) (call : Call)
+    (hsel : EvmRules.Evm.shr 224 (calldataWord call 0) = 0x23b872dd) :
+    (EVM.Program.run o guarded call 11).isSome = true := by
+  sym_exec
+
+/-- The run of the final EVM IR (with RETURNDATASIZE in effect form, the same runs) is the guarded
+program's on a call of transferFrom. -/
+theorem guard_run (o : Oracle) (call : Call) (h : TransferFromCall call) :
+    EVM.Program.run o (SolidCore.Refinement.Solar.AssembleCtx.norm prog) call N =
+      EVM.Program.run o
+        (SolidCore.Refinement.Solar.AssembleCtxGas.guard F (SolidCore.Refinement.Solar.AssembleCtx.norm prog))
+        call N := by
+  rw [guarded_eq, SolidCore.Refinement.Solar.AssembleCtx.run_norm]
+  exact guarded_run11 o call h
+
+/-- The guarded program ends within `N` blocks on a call of transferFrom. -/
+theorem guard_ends (o : Oracle) (call : Call) (h : TransferFromCall call) :
+    (EVM.Program.run o
+      (SolidCore.Refinement.Solar.AssembleCtxGas.guard F (SolidCore.Refinement.Solar.AssembleCtx.norm prog))
+      call N).isSome = true := by
+  rw [guarded_eq]
+  exact guarded_ends11 o call h
+
+/-- info: 'SolarTV.Export.UniswapV2ERC20.CtxGasTF.guard_ends' depends on axioms within [propext,
+Classical.choice, Quot.sound] -/
+#guard_msgs in
+#axioms_within guard_ends
+
+/-- info: 'SolarTV.Export.UniswapV2ERC20.CtxGasTF.guard_run' depends on axioms within [propext,
+Classical.choice, Quot.sound] -/
+#guard_msgs in
+#axioms_within guard_run
+
+end SolarTV.Export.UniswapV2ERC20.CtxGasTF
diff --git a/Certified/uv2_erc20/GasTF.lean b/Certified/uv2_erc20/GasTF.lean
new file mode 100644
index 0000000..dda9b8b
--- /dev/null
+++ b/Certified/uv2_erc20/GasTF.lean
@@ -0,0 +1,113 @@
+import Verify.ShapeCtxGasFrom
+import uv2_erc20.GasGuardTF
+import uv2_erc20.CtxGas
+
+-- Untrusted proof script: the kernel checks it. The certificate and the guarded program are
+-- generated data (CtxGasTF.lean); the theorems below state what they give.
+
+/-!
+# UniswapV2ERC20.transferFrom: a proved gas bound on the exact runtime bytes (E8)
+
+`G` = `gasBoundL cx.base N` = 22100 · (11 · 64) + 12 = 15558412: 11 blocks (the most a call of
+`transferFrom` runs, `GasGuardTF.N`), each of at most 64 items of the lowered program (the largest
+block such a call runs), each charged 22100 gas, plus the memory up to 128 bytes. As for
+transfer (`Gas.lean`), 22100 is at least the price of every instruction the checker admits
+under EIP-2929 and EIP-2200, and EthLib meters the accesses the run actually makes.
+
+* `gas_edge`: from every caller `a` (below `2 ^ 160`, not the contract itself), on every call of
+  `transferFrom(address,address,uint256)`'s selector, under every oracle whose CALLER is `a` and whose
+  Keccak-256 is EthLib's, at every gas from `G` on, EthLib runs the exact bytes to exactly the
+  final EVM IR's result (success, return data, revert data, logs, storage). Its only inputs are the
+  kernel's checks of generated programs: `check_ok` (the checker with contexts and gas on the exact
+  bytes against `evm11`) and the guard stage (`guard_ends`, `guard_run`). No premise mentions gas.
+* `resources`: `Shapes.ResourcesFrom` for any valid-call predicate inside `transferFrom`'s selector and
+  any source semantics per caller, from the functional stage from that source to `evm11` (E3∘E4:
+  the hypothesis `stage`) and its totality (`total`). At `callerAddress` it is
+  `Shapes.Resources` (`resources_at`).
+* Negative controls: the checker refuses the bytes with the dispatcher's first jump target moved
+  and with transferFrom's allowance SSTORE dropped.
+-/
+
+namespace SolarTV.Export.UniswapV2ERC20.CtxGasTF
+
+open SolarTV SolidCore.Refinement SolidCore.Refinement.Shapes SolidCore.Refinement.Solar
+
+/-- **The proved gas bound** of a call of `transferFrom`. -/
+def G : Nat := AssembleLoop.gasBoundL cx.base N
+
+theorem G_eq : G = 15558412 := by decide +kernel
+
+theorem G_lt : G < 2 ^ 64 := by rw [G_eq]; decide
+
+theorem reads_false : cx.base.reads = false := rfl
+
+/-- The same exact runtime bytes as the transfer slice's. -/
+theorem code_eq : code = SolarTV.Export.UniswapV2ERC20.CtxGas.code := rfl
+
+/-- **The gas edge of UniswapV2ERC20.transferFrom on its exact runtime bytes, from any caller.** -/
+theorem gas_edge : ∀ a, a < 2 ^ 160 → a ≠ selfAddress → ∀ o, AssembleLoop.OracleOkAt a o →
+    ∀ call, TransferFromCall call → ∀ gas, G ≤ gas →
+      ∃ obs, (evmirSem o).run prog call = some obs ∧
+        Final.Target.runWithFrom a gas code call = some obs := by
+  intro a ha hne o ho call hc gas hg
+  obtain ⟨obs, hq, hb⟩ := gasEdge_ofXL check_ok reads_false (fun o call h => guard_ends o call h)
+    (fun o call h => guard_run o call h) a ha hne o ho call hc gas hg
+  exact ⟨obs, (AssembleCtx.sem_norm o prog call).symm.trans hq, hb⟩
+
+/-- **Resources of UniswapV2ERC20.transferFrom from any caller**, from the functional stage. -/
+theorem resources {Valid : Call → Prop} {run : Nat → Call → Option Observable}
+    (hv : ∀ call, Valid call → TransferFromCall call)
+    (total : ∀ a, a < 2 ^ 160 → a ≠ selfAddress → ∀ call, Valid call → ∃ obs, run a call = some obs)
+    (stage : ∀ a, a < 2 ^ 160 → a ≠ selfAddress → ∀ call, Valid call → ∀ obs, run a call = some obs →
+      (evmirSem (oracleFrom a)).run prog call = some obs) :
+    ResourcesFrom run code Valid (fun _ => G) :=
+  resourcesFrom_ofXL total
+    (fun a ha hne call hc obs h => (AssembleCtx.sem_norm _ prog call).trans (stage a ha hne call hc obs h))
+    check_ok reads_false
+    (fun o call h => guard_ends o call (hv call h)) (fun o call h => guard_run o call (hv call h)) G_lt
+
+/-- At `callerAddress`: `Shapes.Resources` of a source semantics. -/
+theorem resources_at {S : Sem} {p : S.Prog} {Valid : Call → Prop}
+    {run : Nat → Call → Option Observable} (hrun : run callerAddress = S.run p)
+    (hv : ∀ call, Valid call → TransferFromCall call)
+    (total : ∀ a, a < 2 ^ 160 → a ≠ selfAddress → ∀ call, Valid call → ∃ obs, run a call = some obs)
+    (stage : ∀ a, a < 2 ^ 160 → a ≠ selfAddress → ∀ call, Valid call → ∀ obs, run a call = some obs →
+      (evmirSem (oracleFrom a)).run prog call = some obs) :
+    Resources S p code Valid (fun _ => G) :=
+  (resources hv total stage).resources hrun
+
+/-- The bytes with byte `i` replaced by `b`. -/
+def mutant (i b : Nat) : ByteArray := ⟨((bytes.set i b).map UInt8.ofNat).toArray⟩
+
+/-- A checker run whose walk of the bytes against the program fails refuses the bytes. -/
+theorem refuses_of_walk {code' : ByteArray}
+    (h : Assemble.walkS cx.base.offset (Assemble.bytesOf code') 0
+      (Assemble.lower (AssembleCtx.norm prog) cx.base) = false) :
+    AssembleCtxGas.checkXL F (AssembleCtx.norm prog) code' cx = false := by
+  have hw := Assemble.walkS_drop (Assemble.bytesOf code') cx.base.offset
+    (Assemble.lower (AssembleCtx.norm prog) cx.base) 0 (Nat.zero_le _)
+  rw [List.drop_zero, h] at hw
+  simp only [AssembleCtxGas.checkXL, ← hw, Bool.false_and]
+
+set_option maxRecDepth 100000 in
+/-- The checker refuses the bytes with the dispatcher's first jump target moved (byte 7). -/
+theorem rejects_jump : AssembleCtxGas.checkXL F (AssembleCtx.norm prog) (mutant 7 0x64) cx = false :=
+  refuses_of_walk (by decide +kernel)
+
+set_option maxRecDepth 100000 in
+/-- The checker refuses the bytes with transferFrom's allowance SSTORE dropped, as POP (byte 0x2b1).
+-/
+theorem rejects_sstore : AssembleCtxGas.checkXL F (AssembleCtx.norm prog) (mutant 0x2b1 0x50) cx = false :=
+  refuses_of_walk (by decide +kernel)
+
+/-- info: 'SolarTV.Export.UniswapV2ERC20.CtxGasTF.gas_edge' depends on axioms: [propext,
+Classical.choice, Quot.sound] -/
+#guard_msgs (whitespace := lax) in
+#print axioms gas_edge
+
+/-- info: 'SolarTV.Export.UniswapV2ERC20.CtxGasTF.resources' depends on axioms: [propext,
+Classical.choice, Quot.sound] -/
+#guard_msgs (whitespace := lax) in
+#print axioms resources
+
+end SolarTV.Export.UniswapV2ERC20.CtxGasTF
