index 0000000..c1a46e3
--- /dev/null
+++ b/Certified/uv2_erc20/AnyCallerNested.lean
@@ -0,0 +1,126 @@
+import uv2_erc20.AnyCaller
+import uv2_erc20.GasA
+import uv2_erc20.GasTF
+import uv2_erc20.ProofsA.Stages
+import uv2_erc20.ProofsTF.Stages
+
+-- Untrusted proof script: the kernel checks it.
+
+/-!
+# UniswapV2ERC20.approve and transferFrom: backend stages from any caller (E4, E4∘E5)
+
+The same route as transfer's (`AnyCaller.lean`): the backend stages
+(`uv2_erc20_approve_mir_to_evmir`, `uv2_erc20_transferFrom_mir_to_evmir`, E4) hold under every
+oracle, and the machine reads CALLER from the oracle, so their proofs execute `CALLER` as an
+unknown 160-bit word. For each function:
+
+* `stages_from`: E4 under the oracle of a call from any account `a` (`oracleFrom a`).
+* `backend_any_caller`: from every caller `a` (below `2 ^ 160`, not the contract), under every
+  oracle whose CALLER is `a` and whose Keccak-256 is EthLib's, every result the first lowered MIR
+  `stage0` gives on a call of the function is EthLib's result on the exact runtime bytes, at every
+  gas from its `G` on (approve 5856506, transferFrom 15558412).
+* `resources_any_caller`: `Shapes.ResourcesFrom` for any source semantics per caller, from a source
+  stage per caller into `stage0` and its totality.
+
+`AnyCaller.any_caller_inhabited` gives a caller other than `0x2000` meeting the premises.
+-/
+
+namespace SolarTV.Export.UniswapV2ERC20.AnyCaller
+
+open SolarTV SolarTV.Machine SolidCore.Refinement SolidCore.Refinement.Shapes SolidCore.Refinement.Solar
+
+namespace Approve
+
+open SolarTV.Milestone.Uv2Erc20A (scope uv2_erc20_approve_mir_to_evmir)
+open SolarTV.Export.UniswapV2ERC20.CtxGasA (G code prog ApproveCall gas_edge resources)
+
+/-- A call of `approve` is in the stages' scope: its selector is none of the excluded ones. -/
+theorem approve_scope {call : Call} (h : ApproveCall call) : scope call := by
+  unfold ApproveCall at h
+  simp only [scope, h]
+  decide
+
+/-- **E4 from any caller**: the backend stages under the oracle of a call from `a`. -/
+theorem stages_from (a : Nat) :
+    Stage (mirSem (oracleFrom a)) (evmirSem (oracleFrom a)) stage0 evm11 scope :=
+  uv2_erc20_approve_mir_to_evmir (oracleFrom a)
+
+/-- **E4∘E5 from any caller** for approve. -/
+theorem backend_any_caller : ∀ a, a < 2 ^ 160 → a ≠ selfAddress → ∀ o, AssembleLoop.OracleOkAt a o →
+    ∀ call, ApproveCall call → ∀ obs, (mirSem o).run stage0 call = some obs →
+      ∀ gas, G ≤ gas → Final.Target.runWithFrom a gas code call = some obs := by
+  intro a ha hne o ho call hc obs hrun gas hg
+  have h4 := uv2_erc20_approve_mir_to_evmir o call (approve_scope hc) obs hrun
+  obtain ⟨obs', hq, hb⟩ := gas_edge a ha hne o ho call hc gas hg
+  rw [show (evmirSem o).run prog call = (evmirSem o).run evm11 call from rfl, h4] at hq
+  cases hq
+  exact hb
+
+/-- **Resources from any caller** for approve, from a source stage per caller into `stage0`. -/
+theorem resources_any_caller {Valid : Call → Prop} {run : Nat → Call → Option Observable}
+    (hv : ∀ call, Valid call → ApproveCall call)
+    (total : ∀ a, a < 2 ^ 160 → a ≠ selfAddress → ∀ call, Valid call → ∃ obs, run a call = some obs)
+    (source : ∀ a, a < 2 ^ 160 → a ≠ selfAddress → ∀ call, Valid call → ∀ obs, run a call = some obs →
+      (mirSem (oracleFrom a)).run stage0 call = some obs) :
+    ResourcesFrom run code Valid (fun _ => G) :=
+  resources hv total fun a _ _ call hc obs h =>
+    stages_from a call (approve_scope (hv call hc)) obs (source a ‹_› ‹_› call hc obs h)
+
+/-- info: 'SolarTV.Export.UniswapV2ERC20.AnyCaller.Approve.backend_any_caller' depends on axioms: [propext, Classical.choice, Quot.sound] -/
+#guard_msgs (whitespace := lax) in
+#print axioms backend_any_caller
+
+/-- info: 'SolarTV.Export.UniswapV2ERC20.AnyCaller.Approve.resources_any_caller' depends on axioms: [propext, Classical.choice, Quot.sound] -/
+#guard_msgs (whitespace := lax) in
+#print axioms resources_any_caller
+
+end Approve
+
+namespace TransferFrom
+
+open SolarTV.Milestone.Uv2Erc20TF (scope uv2_erc20_transferFrom_mir_to_evmir)
+open SolarTV.Export.UniswapV2ERC20.CtxGasTF (G code prog TransferFromCall gas_edge resources)
+
+/-- A call of `transferFrom` is in the stages' scope. -/
+theorem transferFrom_scope {call : Call} (h : TransferFromCall call) : scope call := by
+  unfold TransferFromCall at h
+  simp only [scope, h]
+  decide
+
+/-- **E4 from any caller**: the backend stages under the oracle of a call from `a`. -/
+theorem stages_from (a : Nat) :
+    Stage (mirSem (oracleFrom a)) (evmirSem (oracleFrom a)) stage0 evm11 scope :=
+  uv2_erc20_transferFrom_mir_to_evmir (oracleFrom a)
+
+/-- **E4∘E5 from any caller** for transferFrom. -/
+theorem backend_any_caller : ∀ a, a < 2 ^ 160 → a ≠ selfAddress → ∀ o, AssembleLoop.OracleOkAt a o →
+    ∀ call, TransferFromCall call → ∀ obs, (mirSem o).run stage0 call = some obs →
+      ∀ gas, G ≤ gas → Final.Target.runWithFrom a gas code call = some obs := by
+  intro a ha hne o ho call hc obs hrun gas hg
+  have h4 := uv2_erc20_transferFrom_mir_to_evmir o call (transferFrom_scope hc) obs hrun
+  obtain ⟨obs', hq, hb⟩ := gas_edge a ha hne o ho call hc gas hg
+  rw [show (evmirSem o).run prog call = (evmirSem o).run evm11 call from rfl, h4] at hq
+  cases hq
+  exact hb
+
+/-- **Resources from any caller** for transferFrom, from a source stage per caller into `stage0`. -/
+theorem resources_any_caller {Valid : Call → Prop} {run : Nat → Call → Option Observable}
+    (hv : ∀ call, Valid call → TransferFromCall call)
+    (total : ∀ a, a < 2 ^ 160 → a ≠ selfAddress → ∀ call, Valid call → ∃ obs, run a call = some obs)
+    (source : ∀ a, a < 2 ^ 160 → a ≠ selfAddress → ∀ call, Valid call → ∀ obs, run a call = some obs →
+      (mirSem (oracleFrom a)).run stage0 call = some obs) :
+    ResourcesFrom run code Valid (fun _ => G) :=
+  resources hv total fun a _ _ call hc obs h =>
+    stages_from a call (transferFrom_scope (hv call hc)) obs (source a ‹_› ‹_› call hc obs h)
+
+/-- info: 'SolarTV.Export.UniswapV2ERC20.AnyCaller.TransferFrom.backend_any_caller' depends on axioms: [propext, Classical.choice, Quot.sound] -/
+#guard_msgs (whitespace := lax) in
+#print axioms backend_any_caller
+
+/-- info: 'SolarTV.Export.UniswapV2ERC20.AnyCaller.TransferFrom.resources_any_caller' depends on axioms: [propext, Classical.choice, Quot.sound] -/
+#guard_msgs (whitespace := lax) in
+#print axioms resources_any_caller
+
+end TransferFrom
+
+end SolarTV.Export.UniswapV2ERC20.AnyCaller
