index 0000000..16a205c
--- /dev/null
+++ b/Contracts/UniswapV2/ERC20/Certified/Approve.lean
@@ -0,0 +1,167 @@
+import Contracts.UniswapV2.ERC20.Nested.All
+import uv2_erc20.GasA
+import uv2_erc20.ProofsA.Stages
+
+/-!
+# UniswapV2ERC20.approve: certified, at the caller 0x2000
+
+The same composition as transfer's (`Certified/Transfer.lean`), for `approve(address,uint256)` on
+the exact runtime bytes `CtxGasA.code` (`CtxGasA.code_eq`: transfer's bytes):
+
+* E3 `Nested.check_approve_ok`: SolidCore's checked source to solar's first lowered MIR `stage0`
+  (through `compiled0XL`);
+* E4 `SolarTV.Milestone.Uv2Erc20A.uv2_erc20_approve_mir_to_evmir`: `stage0` to the final EVM IR
+  `evm11` on the calls of approve's selector, under every oracle;
+* E5 + E8 `CtxGasA.check_ok` with the guard stage (`GasGuardA`): the checker with contexts and gas
+  accepts the exact bytes against `evm11`, which gives the equivalence at every gas and the gas
+  bound `G = 5856506` (`CtxGasA.G_eq`);
+* E7 `Nested.approve_meets`: every SolidCore run of a valid call gives exactly `approveResult` of
+  the call's storage and argument words.
+
+**Caller.** As for transfer, SolidCore's semantics fix the caller to `0x2000`; the backend holds
+from any caller (`AnyCaller.Approve.backend_any_caller`).
+
+**No premise.** The valid calls are `Nested.ApproveValid` (= `genericValid0 [fn_approve] deployed`):
+any argument words, no value, any storage listing the deployed `DOMAIN_SEPARATOR` slot. The
+postcondition is exact over the slot function, so it needs no hash premise; the key-level reading
+(`approve_keys_bytes`) takes the scoped premise `Scoped (approveFootprint caller spender)` at the
+call it is about.
+
+* `certified`: `∃ c, contract? = .ok c ∧ Certified (solidCore fuel) c code ApproveValid Allowed
+  ApprovePost (fun _ => 5856506)`, with `Allowed` = success or a revert with no data (a spender
+  word above `2 ^ 160`).
+* `approve_bytes`: from the gas bound on, the bytes give exactly `approveResult`.
+* `approve_keys_bytes`: on the bytes, a clean call succeeds, sets `allowance[caller][spender]`
+  and leaves every slot below `2 ^ 128` unchanged.
+-/
+
+namespace SolidCore.Spec.UniswapV2.ERC20.Certified.Approve
+
+open SolarTV SolidCore.Refinement SolidCore.Refinement.Generic SolidCore.Refinement.Shapes
+open SolidCore.Spec.UniswapV2.ERC20.Nested
+open SolarTV.Export.UniswapV2ERC20.CtxGasA (G G_eq G_lt check_ok guard_ends guard_run ApproveCall prog)
+
+/-- The exact runtime bytes. -/
+abbrev code : ByteArray := SolarTV.Export.UniswapV2ERC20.CtxGasA.code
+
+/-- The allowed statuses: success, or a revert with no data (a dirty spender word). -/
+def Allowed (_call : Call) (obs : Observable) : Prop :=
+  obs.success = true ∨ obs.output = []
+
+/-- A valid call of approve has approve's selector. -/
+theorem selector_of : ∀ call, ApproveValid call → ApproveCall call := by
+  rintro _ ⟨σ, -, f, hf, args, -, hargs, rfl⟩
+  simp only [List.mem_singleton] at hf
+  subst hf
+  exact (SolidCore.Refinement.Generic.callFacts fn_approve.sel (by decide) args hargs σ).selector
+
+set_option maxRecDepth 200000 in
+theorem hscope : ∀ call, ApproveValid call → SolarTV.Milestone.Uv2Erc20A.scope call := by
+  intro call h
+  simp only [SolarTV.Milestone.Uv2Erc20A.scope]
+  have hs := selector_of call h
+  simp only [ApproveCall] at hs
+  rw [hs]
+  decide
+
+/-- E4 onto the final EVM IR's effect form (the same runs, `sem_norm`). -/
+theorem backend : Stage (mirSem oracle) (evmirSem oracle) SolarTV.Export.UniswapV2ERC20.stage0
+    (SolidCore.Refinement.Solar.AssembleCtx.norm prog) SolarTV.Milestone.Uv2Erc20A.scope :=
+  fun call h obs hr => (SolidCore.Refinement.Solar.AssembleCtx.sem_norm oracle prog call).trans
+    (SolarTV.Milestone.Uv2Erc20A.uv2_erc20_approve_mir_to_evmir oracle call h obs hr)
+
+set_option maxRecDepth 200000 in
+/-- **E3, E4, E5 and E8 composed** for approve. -/
+theorem compiled {c : SolidCore.Solidity.TypeCheck.CheckedContract}
+    (hc : SolidCore.Verify.VC.UniswapV2ERC20.contract? = .ok c) :
+    Compiled (solidCore SolidCore.Verify.VC.UniswapV2ERC20.fuel) c code ApproveValid (fun _ => G) := by
+  have hdep := deploy_eq
+  simp only [deploy?, hc] at hdep
+  obtain ⟨_, hdd⟩ := Wide.deployedAt_of hdep
+  exact compiled0XL hdd (check_approve_ok hc) (genericValid0_inhabited fn_approve [] deployed) backend
+    hscope (fun call h => guard_ends oracle call (selector_of call h))
+    (fun call h => guard_run oracle call (selector_of call h)) check_ok G_lt
+
+/-- Every SolidCore result of a valid call has an allowed status. -/
+theorem allowed {c : SolidCore.Solidity.TypeCheck.CheckedContract}
+    (hc : SolidCore.Verify.VC.UniswapV2ERC20.contract? = .ok c) :
+    ∀ call, ApproveValid call → ∀ obs,
+      (solidCore SolidCore.Verify.VC.UniswapV2ERC20.fuel).run c call = some obs → Allowed call obs := by
+  intro call hv obs hrun
+  have h := approve_meets hc call hv obs hrun
+  unfold ApprovePost approveResult at h
+  subst h
+  unfold Allowed
+  split <;> simp
+
+/-- **UniswapV2ERC20.approve is certified at the caller 0x2000**: on every call of
+`approve(spender, value)` from 0x2000 with any argument words, no value and any storage listing the
+deployed slot, the exact runtime bytes behave as SolidCore's checked source (at every gas, and
+exactly from 5856506 gas on), which ends with an allowed status and gives exactly `approveResult`.
+-/
+theorem certified : ∃ c, SolidCore.Verify.VC.UniswapV2ERC20.contract? = .ok c ∧
+    Certified (solidCore SolidCore.Verify.VC.UniswapV2ERC20.fuel) c code ApproveValid Allowed ApprovePost
+      (fun _ => 5856506) := by
+  obtain ⟨c, hc⟩ := SolidCore.Verify.VC.UniswapV2ERC20.contract_ok
+  have h := (compiled hc).certified (allowed hc) (approve_meets hc)
+  rw [show (fun _ : Call => G) = fun _ => 5856506 from funext fun _ => G_eq] at h
+  exact ⟨c, hc, h⟩
+
+/-! ## On the bytes -/
+
+/-- From the gas bound on, the bytes give SolidCore's result on a valid call. -/
+theorem bytes_eq_source {c : SolidCore.Solidity.TypeCheck.CheckedContract}
+    (hc : SolidCore.Verify.VC.UniswapV2ERC20.contract? = .ok c) {call : Call} (hv : ApproveValid call)
+    {gas : Nat} (h1 : 5856506 ≤ gas) (h2 : gas < 2 ^ 256) :
+    Final.Target.runWith gas code call = (solidCore SolidCore.Verify.VC.UniswapV2ERC20.fuel).run c call :=
+  ((compiled hc).resources call hv).2 gas (by rw [G_eq]; exact h1) h2
+
+/-- The call `approve(spender, value)` on the storage `σ`. -/
+def approveCall (σ : List (Nat × Nat)) (spender value : Nat) : Call :=
+  { calldata := SolidCore.Refinement.Abi.calldata fn_approve.sel [spender, value], callvalue := 0,
+    storage := σ }
+
+/-- **approve on the bytes**: from the gas bound on, exactly `approveResult`. -/
+theorem approve_bytes (σ : List (Nat × Nat)) (hcov : Covers deployed σ) (spender value : Nat)
+    (hs : spender < 2 ^ 256) (hv : value < 2 ^ 256) (gas : Nat) (h1 : 5856506 ≤ gas)
+    (h2 : gas < 2 ^ 256) :
+    Final.Target.runWith gas code (approveCall σ spender value) =
+      some (approveResult (slotValue σ) spender value) := by
+  obtain ⟨c, hc⟩ := SolidCore.Verify.VC.UniswapV2ERC20.contract_ok
+  have hargs : ∀ a ∈ [spender, value], a < 2 ^ 256 := by
+    intro a ha; simp only [List.mem_cons, List.not_mem_nil, or_false] at ha; rcases ha with rfl | rfl <;> assumption
+  have hval : ApproveValid (approveCall σ spender value) :=
+    ⟨σ, hcov, fn_approve, List.mem_singleton_self _, [spender, value], rfl, hargs, rfl⟩
+  obtain ⟨obs, hrun, -⟩ := (compiled hc).terminates _ hval
+  rw [bytes_eq_source hc hval h1 h2, hrun, approve_meets hc _ hval obs hrun]
+  simp [approveCall, SolidCore.Spec.UniswapV2.ERC20.Nested.callArgs, words_calldata _ hargs]
+
+/-- **approve, key by key, on the bytes**: under keccak256's separation on the preimages of
+`allowance[caller][spender]`'s slot, a clean call succeeds, sets that slot to `value` and leaves
+every slot below `2 ^ 128` unchanged. -/
+theorem approve_keys_bytes (σ : List (Nat × Nat)) (hcov : Covers deployed σ) (spender value : Nat)
+    (hs : spender < 2 ^ 160) (hv : value < 2 ^ 256)
+    (h : HashScopeNested.Scoped (HashScopeNested.approveFootprint caller spender))
+    (gas : Nat) (h1 : 5856506 ≤ gas) (h2 : gas < 2 ^ 256) :
+    ∃ obs, Final.Target.runWith gas code (approveCall σ spender value) = some obs ∧
+      obs.success = true ∧ obs.storage (allowanceSlot caller spender) = value ∧
+      ∀ k < 2 ^ 128, obs.storage k = slotValue σ k :=
+  ⟨_, approve_bytes σ hcov spender value (by omega) hv gas h1 h2,
+    approve_keys (slotValue σ) spender value hs h⟩
+
+/-- info: 'SolidCore.Spec.UniswapV2.ERC20.Certified.Approve.certified' depends on axioms: [propext,
+Classical.choice, Quot.sound] -/
+#guard_msgs (whitespace := lax) in
+#print axioms certified
+
+/-- info: 'SolidCore.Spec.UniswapV2.ERC20.Certified.Approve.approve_bytes' depends on axioms:
+[propext, Classical.choice, Quot.sound] -/
+#guard_msgs (whitespace := lax) in
+#print axioms approve_bytes
+
+/-- info: 'SolidCore.Spec.UniswapV2.ERC20.Certified.Approve.approve_keys_bytes' depends on axioms:
+[propext, Classical.choice, Quot.sound] -/
+#guard_msgs (whitespace := lax) in
+#print axioms approve_keys_bytes
+
+end SolidCore.Spec.UniswapV2.ERC20.Certified.Approve
