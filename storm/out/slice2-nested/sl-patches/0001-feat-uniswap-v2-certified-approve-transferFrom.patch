@@ -0,0 +1,68 @@
+import W1Proofs.Tactic
+import W1Proofs.Axioms
+import uv2_erc20.CtxGasA
+
+-- Untrusted proof script: the kernel checks it. The statement speaks only of the generated
+-- program and its guarded copy.
+
+/-!
+# UniswapV2ERC20.approve: the guard stage
+
+On every call whose selector is `approve(address,uint256)`'s, under every oracle, the final EVM
+IR `evm11` and `CtxGasA.guarded` (each block of `CtxGasA.F`, the blocks of the other functions, a
+jump to itself) end within `N` blocks in the same result: no such call enters a block the checker
+with contexts and gas leaves unchecked. Symbolic execution (`sym_exec`) over a symbolic call and
+oracle: the calldata, the storage and the oracle stay opaque.
+-/
+
+namespace SolarTV.Export.UniswapV2ERC20.CtxGasA
+
+open SolarTV SolarTV.Machine SolarTV.Milestone.W1
+
+/-- The blocks a call of approve runs, at most: the two dispatcher blocks, the entry, the store
+with the log, and the return; or the revert. -/
+def N : Nat := 5
+
+/-- A call of approve: its first calldata word's top four bytes are the selector `0x095ea7b3`. -/
+def ApproveCall (call : Call) : Prop :=
+  EvmRules.Evm.shr 224 (calldataWord call 0) = 0x095ea7b3
+
+set_option maxHeartbeats 16000000 in
+theorem guarded_run5 (o : Oracle) (call : Call)
+    (hsel : EvmRules.Evm.shr 224 (calldataWord call 0) = 0x095ea7b3) :
+    EVM.Program.run o SolarTV.Export.UniswapV2ERC20.evm11 call 5 = EVM.Program.run o guarded call 5 := by
+  sym_exec
+
+set_option maxHeartbeats 16000000 in
+theorem guarded_ends5 (o : Oracle) (call : Call)
+    (hsel : EvmRules.Evm.shr 224 (calldataWord call 0) = 0x095ea7b3) :
+    (EVM.Program.run o guarded call 5).isSome = true := by
+  sym_exec
+
+/-- The run of the final EVM IR (with RETURNDATASIZE in effect form, the same runs) is the guarded
+program's on a call of approve. -/
+theorem guard_run (o : Oracle) (call : Call) (h : ApproveCall call) :
+    EVM.Program.run o (SolidCore.Refinement.Solar.AssembleCtx.norm prog) call N =
+      EVM.Program.run o
+        (SolidCore.Refinement.Solar.AssembleCtxGas.guard F (SolidCore.Refinement.Solar.AssembleCtx.norm prog))
+        call N := by
+  rw [guarded_eq, SolidCore.Refinement.Solar.AssembleCtx.run_norm]
+  exact guarded_run5 o call h
+
+/-- The guarded program ends within `N` blocks on a call of approve. -/
+theorem guard_ends (o : Oracle) (call : Call) (h : ApproveCall call) :
+    (EVM.Program.run o
+      (SolidCore.Refinement.Solar.AssembleCtxGas.guard F (SolidCore.Refinement.Solar.AssembleCtx.norm prog))
+      call N).isSome = true := by
+  rw [guarded_eq]
+  exact guarded_ends5 o call h
+
+/-- info: 'SolarTV.Export.UniswapV2ERC20.CtxGasA.guard_ends' depends on axioms within [propext, Classical.choice, Quot.sound] -/
+#guard_msgs in
+#axioms_within guard_ends
+
+/-- info: 'SolarTV.Export.UniswapV2ERC20.CtxGasA.guard_run' depends on axioms within [propext, Classical.choice, Quot.sound] -/
+#guard_msgs in
+#axioms_within guard_run
+
+end SolarTV.Export.UniswapV2ERC20.CtxGasA
