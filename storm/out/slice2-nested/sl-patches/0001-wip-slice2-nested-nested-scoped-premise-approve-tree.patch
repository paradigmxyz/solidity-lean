new file mode 100755
index 0000000..c5eb5ca
--- /dev/null
+++ b/scripts/verify/uniswap_v2_stage0.sh
@@ -0,0 +1,32 @@
+#!/usr/bin/env bash
+# Export solar's first lowered MIR (stage0) of UniswapV2ERC20 for the generic source stage's check of
+# approve and transferFrom (Contracts/UniswapV2/ERC20/Nested/Lowering*.lean). Not committed: it is
+# derived from the GPL-3.0 v2-core port, as Source.lean and Core.lean are.
+#
+#   SOLAR=path/to/solar scripts/verify/uniswap_v2_stage0.sh
+#
+# Needs scripts/verify/uniswap_v2_gen.sh's scripts/verify/uniswap-v2/UniswapV2ERC20.sol. Compiles it
+# with the pinned options (-Ogas --evm-version osaka) twice, with and without -Zemit-lean-stages, fails
+# if the flag changes the runtime bytecode, and writes
+#   Certified/uv2_erc20/gen/UniswapV2ERC20/Stage0.lean   (module uv2_erc20.gen.UniswapV2ERC20.Stage0)
+#   Certified/uv2_erc20/gen/UniswapV2ERC20/runtime.hex   (the runtime bytecode of the same run)
+# and prints solar's version, the source's and the bytecode's sha256.
+set -euo pipefail
+cd "$(dirname "${BASH_SOURCE[0]}")/../.."
+: "${SOLAR:?set SOLAR to a solar binary}"
+sol=scripts/verify/uniswap-v2/UniswapV2ERC20.sol
+[[ -s $sol ]] || { echo "error: $sol missing; run scripts/verify/uniswap_v2_gen.sh" >&2; exit 1; }
+opts=(-Ogas --evm-version osaka)
+tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
+cp "$sol" "$tmp/UniswapV2ERC20.sol"
+rt() { python3 -c 'import json,sys; print(json.load(sys.stdin)["contracts"]["UniswapV2ERC20.sol:UniswapV2ERC20"]["bin-runtime"])'; }
+plain=$(cd "$tmp" && "$SOLAR" UniswapV2ERC20.sol "${opts[@]}" --emit=bin-runtime 2>/dev/null | rt)
+exported=$(cd "$tmp" && "$SOLAR" UniswapV2ERC20.sol "${opts[@]}" --emit=bin-runtime -Zemit-lean-stages="$tmp/gen" 2>/dev/null | rt)
+[[ -n $plain && $plain == "$exported" ]] || { echo "error: -Zemit-lean-stages changed the bytecode" >&2; exit 1; }
+out=Certified/uv2_erc20/gen/UniswapV2ERC20
+mkdir -p "$out"
+cp "$tmp/gen/UniswapV2ERC20/Stage0.lean" "$out/Stage0.lean"
+echo "$plain" > "$out/runtime.hex"
+echo "solar: $("$SOLAR" --version | head -1)"
+echo "source sha256: $(sha256sum "$sol" | cut -d' ' -f1)"
+echo "runtime bytes: $(( ${#plain} / 2 )), sha256: $(python3 -c 'import hashlib,sys; print(hashlib.sha256(bytes.fromhex(sys.argv[1])).hexdigest())' "$plain")"
