@@ -1206,3 +1206,13 @@ pub(crate) fn expr_text(e: &Expr<'_>) -> String {
         _ => "<expr>".into(),
     }
 }
+
+/// A cut parameter is a declared constant: an atom that is not a literal. A value fixed to a
+/// literal (a named return's 0 at function entry, a local set to a constant and only read in the
+/// loop) is that literal in every formula, so it is no parameter of the cut.
+fn is_symbol(t: &str) -> bool {
+    super::is_atom(t)
+        && t != "true"
+        && t != "false"
+        && !t.starts_with(|c: char| c.is_ascii_digit() || c == '-' || c == '#')
+}
