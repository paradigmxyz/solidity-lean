             let Some(e) = entry.get(*n) else { continue };
@@ -520,7 +520,7 @@ impl<'p, 'a> Vc<'p, 'a> {
                 let Some(o) = old.get(*n) else { continue };
                 let sort = o.ty.sort();
                 if (sort != "Int" && sort != "Bool")
