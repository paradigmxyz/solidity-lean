@@ -502,7 +502,7 @@ impl<'p, 'a> Vc<'p, 'a> {
         for n in &names {
             let v = &head[*n];
             let sort = v.ty.sort();
-            if (sort != "Int" && sort != "Bool") || !super::is_atom(&v.t) {
