index 0000000..ba5030c
--- /dev/null
+++ b/Contracts/UniswapV2/ERC20/Slice/MutantsDebit.lean
@@ -0,0 +1,170 @@
+import Contracts.UniswapV2.ERC20.Slice.Bytes
+import Contracts.UniswapV2.ERC20.Slice.Gen.MutDebit.Tree
+
+/-!
+# UniswapV2ERC20.transfer: the missing-debit mutant, refused by execution
+
+See Mutants.lean. The mutant undoes the debit (`balanceOf[from] = balanceOf[from].sub(value).add(value)`):
+`transfer(1, 2)` from a caller balance of 5 succeeds and leaves it at 5, where `TargetPost` asks 3. Its
+own module, so that each module checks within 6 GB.
+-/
+
+namespace SolidCore.Spec.UniswapV2.ERC20.Slice.Mutants
+
+open SolarTV SolidCore.Refinement SolidCore.Refinement.Generic SolidCore.Spec SolidCore.Refinement.Shapes
+open SolidCore.Spec.UniswapV2.ERC20.Slice
+
+/-! ## Debit -/
+
+section Debit
+open SolidCore.Spec.UniswapV2.ERC20.Slice.Gen.MutDebit in
+/-- SolidCore's run of a valid call on the debit mutant is its erased tree's result. -/
+theorem runDebit {c : SolidCore.Solidity.TypeCheck.CheckedContract}
+    (hc : SolidCore.Verify.VC.UniswapV2ERC20MutDebit.contract? = .ok c) {σ : List (Nat × Nat)} {dst v : Nat}
+    (hcov : Generic.Covers deployed σ) (hto : dst < 2 ^ 160) (hv : v < 2 ^ 256) :
+    (solidCore fuel).run c (transferCall σ dst v) =
+      some (transfer_tree.eval ⟨[dst, v], slotValue σ, solHash⟩).obs := by
+  have hdep := deploy_eq
+  simp only [deploy?, hc] at hdep
+  obtain ⟨d, hd⟩ := Wide.deployedAt_of hdep
+  have hmap := transfer_erase_eq
+  simp only [transfer_erase?, hc, Option.map_eq_some_iff, Prod.mk.injEq] at hmap
+  obtain ⟨f, hf, hlen, hT⟩ := hmap
+  exact source_run hd hcov (by decide) hf hT [dst, v] (by simp [hlen]) (by simp; omega)
+end Debit
+
+/-! ## The debit mutant's tree, by parts -/
+
+section DebitParts
+set_option simprocs false
+
+/-- The debited balance credited back: the mutant's caller slot. -/
+abbrev eAddBack : WExpr := .bin .add eSub (.arg 1)
+/-- The recipient's balance in the mutant's state after its caller write. -/
+abbrev eSelD : WExpr := .sel (.bin .eq hT hC) eAddBack (.sinit hT)
+/-- The mutant's credited balance. -/
+abbrev eAddD : WExpr := .bin .add eSelD (.arg 1)
+/-- SafeMath's `add` test of the credit-back. -/
+abbrev c3d : WExpr := .un .iszero (.bin .lt eAddBack eSub)
+/-- SafeMath's `add` test of the credit. -/
+abbrev c4d : WExpr := .un .iszero (.bin .lt eAddD eSelD)
+
+/-- The mutant's success leaf. -/
+def okD : Tree :=
+  .halt true (wordOBytes (.lit 1)) [(hT, eAddD), (hC, eAddBack)]
+    [{ topics := [.lit transferTopic, .lit 8192, .arg 0], data := wordOBytes (.arg 1) }]
+
+-- The mutant's erased tree, by parts: the kernel's conversion check.
+kernel_rfl dtree_eq Gen.MutDebit.transfer_tree
+  (.ite c1 (.halt false [] [] [])
+    (.ite c2 (.ite c3d (.ite c4d okD (.halt false (errBytes addMsg) [] [])) (.halt false (errBytes addMsg) [] []))
+      (.halt false (errBytes subMsg) [] [])))
+
+variable {s : Nat → Nat} {dst v : Nat} (hs : ∀ k, s k < 2 ^ 256) (hto : dst < 2 ^ 160) (hv : v < 2 ^ 256)
+include hs hto hv
+
+theorem ev_addBack (hle : v ≤ s (balKey caller)) : eAddBack.eval (val s dst v) = s (balKey caller) := by
+  simp only [eAddBack, eval_bin, ev_sub hs hto hv, ev_arg1 hv, BinOp.eval, wsub_of_le (hs _) hle,
+    Generic.wordSize, Nat.mod_mod, Nat.sub_add_cancel hle]
+  exact Nat.mod_eq_of_lt (hs _)
+
+theorem ev_c3d (hle : v ≤ s (balKey caller)) : c3d.eval (val s dst v) = 1 := by
+  simp only [c3d, WExpr.eval.eq_4, eval_bin, ev_addBack hs hto hv hle, ev_sub hs hto hv,
+    wsub_of_le (hs _) hle, BinOp.eval, UnOp.eval, ite01_modW, Generic.wordSize]
+  split_ifs <;> omega
+
+theorem ev_selD (hne : balKey dst ≠ balKey caller) : eSelD.eval (val s dst v) = s (balKey dst) := by
+  simp only [eSelD, WExpr.eval.eq_7, eval_bin, ev_hT hto, ev_hC, BinOp.eval, ite01_modW, Generic.wordSize,
+    if_neg hne, ev_b hs hto hv, eq_self_iff_true, if_true]
+
+theorem ev_c4d (hne : balKey dst ≠ balKey caller) (hov : s (balKey dst) + v < 2 ^ 256) :
+    c4d.eval (val s dst v) = 1 := by
+  simp only [c4d, eAddD, WExpr.eval.eq_4, eval_bin, ev_selD hs hto hv hne, ev_arg1 hv, BinOp.eval, UnOp.eval,
+    ite01_modW, Generic.wordSize, Nat.mod_mod, Nat.mod_eq_of_lt hov]
+  split_ifs <;> omega
+
+/-- **The debit mutant on a call that the source accepts, with distinct slots**: success, and the
+caller's slot keeps its balance. -/
+theorem debit_eval (hle : v ≤ s (balKey caller)) (hne : balKey dst ≠ balKey caller)
+    (hov : s (balKey dst) + v < 2 ^ 256) :
+    (Gen.MutDebit.transfer_tree.eval (val s dst v)).success = true ∧
+      (Gen.MutDebit.transfer_tree.eval (val s dst v)).store (balKey caller) = s (balKey caller) := by
+  have e2 : c2.eval (val s dst v) = 1 := by rw [ev_c2 hs hto hv, if_pos hle]
+  rw [dtree_eq]
+  simp only [Tree.eval, ev_c1 hs hto hv, e2, ev_c3d hs hto hv hle, ev_c4d hs hto hv hne hov, if_pos,
+    one_ne_zero, if_false, okD, if_true, eq_self_iff_true, true_and]
+  simp only [Writes.store, Generic.wordSize, ev_hT hto, ev_hC, balKey_mod, if_neg hne, if_true,
+    eq_self_iff_true, ev_addBack hs hto hv hle]
+
+end DebitParts
+
+/-- The caller holds 5, every other slot 0. -/
+def σd : List (Nat × Nat) := [(3, 0), (balKey caller, 5)]
+
+theorem coversDebit : Generic.Covers Gen.MutDebit.deployed σd := by
+  intro kv hkv
+  simp only [Gen.MutDebit.deployed, List.mem_singleton] at hkv
+  subst hkv
+  exact ⟨(3, 0), by simp [σd], rfl⟩
+
+/-- The caller's and address 1's `balanceOf` slots differ (the real keccak256, by the kernel). -/
+theorem slots_ne : solHash 1 1 ≠ solHash 8192 1 := fun h =>
+  (transfer_slots scopedSep_transfer_example (by decide) (by decide) (by decide)).1 (by decide) h.symm
+
+theorem obs_success (R : Res) (h : R.success = true) : R.obs.success = true := h
+
+theorem obs_storage (R : Res) (k : Nat) {n : Nat} (h : R.store k = n) : R.obs.storage k = n := h
+
+set_option simprocs false in
+/-- The debit mutant's result on `transfer(1, 2)` from `σd`: success, with the caller's balance
+still 5. -/
+theorem debit_result :
+    (Gen.MutDebit.transfer_tree.eval ⟨[1, 2], slotValue σd, solHash⟩).obs.success = true ∧
+      (Gen.MutDebit.transfer_tree.eval ⟨[1, 2], slotValue σd, solHash⟩).obs.storage (balKey caller) = 5 := by
+  have hs : ∀ k, slotValue σd k < 2 ^ 256 := fun k => Generic.slotValue_lt σd k
+  have hne : balKey 1 ≠ balKey caller := by
+    rw [show balKey caller = solHash 8192 1 by simp only [balKey, caller, Generic.callerWord]]
+    exact slots_ne
+  have ha : slotValue σd (balKey caller) = 5 := by rw [σd, slotValue_last]; decide
+  have hb : slotValue σd (balKey 1) = 0 := by
+    have h : ¬ (balKey caller % 2 ^ 256 = balKey 1 % 2 ^ 256) := by
+      rw [balKey_mod, balKey_mod]; exact Ne.symm hne
+    simp only [slotValue, σd, List.foldl_cons, List.foldl_nil, if_neg h, Nat.zero_mod, ite_self]
+  have h := debit_eval (s := slotValue σd) (dst := 1) (v := 2) hs (by norm_num) (by norm_num)
+    (by rw [ha]; norm_num) hne (by rw [hb]; norm_num)
+  have e1 : (⟨[1, 2], slotValue σd, solHash⟩ : Val) = val (slotValue σd) 1 2 := rfl
+  rw [← e1] at h
+  exact ⟨obs_success _ h.1, obs_storage _ _ (h.2.trans ha)⟩
+
+theorem validDebit : Valid Gen.MutDebit.deployed (transferCall σd 1 2) :=
+  ⟨σd, 1, 2, coversDebit, by decide, by decide, rfl⟩
+
+theorem scopeDebit : Scope (transferCall σd 1 2) := by
+  intro σ dst v h hto hv
+  obtain ⟨-, rfl, -⟩ := transferCall_inj (by decide) (by decide) (by omega) hv h
+  exact scopedSep_transfer_example
+
+/-- **The debit mutant fails `TargetPost`**: `transfer(1, 2)` from a balance of 5 succeeds and
+leaves the caller's balance at 5, not 3. -/
+theorem debit_refuted_target {c : SolidCore.Solidity.TypeCheck.CheckedContract}
+    (hc : SolidCore.Verify.VC.UniswapV2ERC20MutDebit.contract? = .ok c) :
+    ¬ Meets (solidCore fuel) c (fun call => Valid Gen.MutDebit.deployed call ∧ Scope call) TargetPost := by
+  intro h
+  have hp := h _ ⟨validDebit, scopeDebit⟩ _ (runDebit hc coversDebit (by decide) (by decide))
+    σd 1 2 rfl (by decide) (by decide)
+  have hb : slotValue σd (balKey caller) = 5 := by rw [σd, slotValue_last]; decide
+  have := ((hp.1 (by decide)).2 debit_result.1).1
+  rw [debit_result.2, hb] at this
+  omega
+
+/-- **The debit mutant fails `SeqPost`** (through `targetPost_of_seq`). -/
+theorem debit_refuted_seq {c : SolidCore.Solidity.TypeCheck.CheckedContract}
+    (hc : SolidCore.Verify.VC.UniswapV2ERC20MutDebit.contract? = .ok c) :
+    ¬ Meets (solidCore fuel) c (Valid Gen.MutDebit.deployed) SeqPost := fun h =>
+  debit_refuted_target hc fun call hv obs hrun => targetPost_of_seq (h call hv.1 obs hrun) hv.2
+
+/-- info: 'SolidCore.Spec.UniswapV2.ERC20.Slice.Mutants.debit_refuted_target' depends on axioms: [propext, Classical.choice, Quot.sound] -/
+#guard_msgs (whitespace := lax) in
+#print axioms debit_refuted_target
+
+end SolidCore.Spec.UniswapV2.ERC20.Slice.Mutants
diff --git a/Contracts/UniswapV2/ERC20/Slice/Post.lean b/Contracts/UniswapV2/ERC20/Slice/Post.lean
new file mode 100644
index 0000000..ff28b2e
--- /dev/null
+++ b/Contracts/UniswapV2/ERC20/Slice/Post.lean
@@ -0,0 +1,192 @@
+import Verify.Shapes
+import Verify.Spec.HashScope
+
+/-!
+# UniswapV2ERC20.transfer: the slice's valid calls and postcondition over the observable
+
+The first certified slice of docs/CERTIFICATION_TARGET.md, `transfer(address,uint256)` of the
+pinned 0.8 port's `UniswapV2ERC20`, stated over `SolarTV.Call` and `SolarTV.Observable`, the
+interface both SolidCore and EthLib run on. Nothing here depends on the port's code.
+
+* `Valid s`: the selector `transfer(address,uint256)`, well-formed call data (a clean address
+  `to` and any word `value`), no value, any storage that writes the slots of `s` (the
+  constructor's storage, as every generic-stage scope asks). The caller is the interface's one
+  caller, `0x2000` (`Generic.callerWord`): `SolarTV.Call` has no caller field, so "any caller"
+  is not expressible yet (a missing bridge, named in RESULT.md); `to` ranges over every
+  address, the caller among them.
+* `SeqPost`: what the source does, as sequential storage updates in source order: the debit of
+  the caller, then the credit of the recipient reading the debited state (`seqStore`). It
+  succeeds iff the caller's balance covers `value` and the credit does not overflow, logs
+  `Transfer(caller, to, value)` and returns `true`; otherwise it reverts with the source's
+  revert data (`Error("ds-math-sub-underflow")` or `Error("ds-math-add-overflow")`), no log and
+  the storage it started with. It needs no hash premise: it is stated at the slots the source
+  computes, `solHash k 1`.
+* `TargetPost`: the same in the target's words, split on `caller = to`, reading the recipient's
+  balance in the state before the call, with the frame over the footprint. It follows from
+  `SeqPost` under `Scope` (`targetPost_of_seq`): keccak256 separated on the call's two balance
+  preimages only (`ScopedSep (transferFootprint 1 caller to)`, Verify/Spec/HashScope.lean), never
+  over all keys and with no frame family.
+* `Post`: `SeqPost`, and `TargetPost` and solar-verify's exported spec under the call's
+  `Scope`: the scoped premise is printed in the statement, at the call it is about.
+-/
+
+namespace SolidCore.Spec.UniswapV2.ERC20.Slice
+
+open SolarTV SolidCore.Refinement SolidCore.Refinement.Generic SolidCore.Spec
+
+/-- `balanceOf`'s slot in the port's storage layout. -/
+abbrev balanceSlot : Nat := 1
+
+/-- The caller of every call (the interface's one caller). -/
+abbrev caller : Nat := Generic.callerWord
+
+/-- The slot of `balanceOf[a]`. -/
+abbrev balKey (a : Nat) : Nat := solHash a balanceSlot
+
+/-- The selector of `transfer(address,uint256)`. -/
+abbrev transferSel : Nat := 0xa9059cbb
+
+/-- The call `transfer(to, value)` from the storage `σ`, with no value. -/
+def transferCall (σ : List (Nat × Nat)) (dst v : Nat) : Call :=
+  { calldata := Abi.calldata transferSel [dst, v], callvalue := 0, storage := σ }
+
+/-- **The valid calls**: `transfer(to, value)` on a clean address and any word, no value, from any
+storage that writes every slot of `s`. -/
+def Valid (s : List (Nat × Nat)) (call : Call) : Prop :=
+  ∃ σ dst v, Generic.Covers s σ ∧ dst < 2 ^ 160 ∧ v < 2 ^ 256 ∧ call = transferCall σ dst v
+
+/-- The storage `s` with the slot `k` (a word) set to `x`. -/
+def upd (s : Nat → Nat) (k x : Nat) : Nat → Nat := fun n => if n % 2 ^ 256 = k then x else s n
+
+/-- The debited state: the caller's balance less `v`. -/
+def debit (s : Nat → Nat) (v : Nat) : Nat → Nat := upd s (balKey caller) (s (balKey caller) - v)
+
+/-- **The source's storage updates, in order**: the debit of the caller, then the credit of `to`
+reading the debited state. -/
+def seqStore (s : Nat → Nat) (dst v : Nat) : Nat → Nat :=
+  upd (debit s v) (balKey dst) (debit s v (balKey dst) + v)
+
+/-- A word's 32 bytes, big-endian. -/
+def be32 (w : Nat) : List Nat := (List.range 32).map fun i => w / 256 ^ (31 - i) % 256
+
+/-- The topic of `Transfer(address,address,uint256)`. -/
+abbrev transferTopic : Nat :=
+  0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef
+
+/-- The log `Transfer(from, to, value)`: its topics and data. -/
+def transferLog (f t v : Nat) : List Nat × List Nat := ([transferTopic, f, t], be32 v)
+
+/-- The revert data of `Error(msg)` for a message of at most 32 bytes: the selector, the offset
+`0x20`, the length and the message padded to a word. -/
+def errorData (msg : List Nat) : List Nat :=
+  [0x08, 0xc3, 0x79, 0xa0] ++ be32 0x20 ++ be32 msg.length ++ msg ++
+    List.replicate (32 - msg.length) 0
+
+/-- `"ds-math-sub-underflow"`'s bytes (`subMsg_eq`). -/
+def subMsg : List Nat :=
+  [100, 115, 45, 109, 97, 116, 104, 45, 115, 117, 98, 45, 117, 110, 100, 101, 114, 102, 108, 111, 119]
+/-- `"ds-math-add-overflow"`'s bytes (`addMsg_eq`). -/
+def addMsg : List Nat :=
+  [100, 115, 45, 109, 97, 116, 104, 45, 97, 100, 100, 45, 111, 118, 101, 114, 102, 108, 111, 119]
+
+theorem subMsg_eq : subMsg = "ds-math-sub-underflow".toUTF8.toList.map (·.toNat) := by decide +kernel
+theorem addMsg_eq : addMsg = "ds-math-add-overflow".toUTF8.toList.map (·.toNat) := by decide +kernel
+
+/-- **What the source does** on `transfer(to, v)` from `σ`: see the module comment. -/
+def SeqPost (call : Call) (obs : Observable) : Prop :=
+  ∀ σ dst v, call = transferCall σ dst v → dst < 2 ^ 160 → v < 2 ^ 256 →
+    (obs.success = true ↔
+      (v ≤ slotValue σ (balKey caller) ∧ debit (slotValue σ) v (balKey dst) + v < 2 ^ 256)) ∧
+    (obs.success = true → obs.storage = seqStore (slotValue σ) dst v ∧
+      obs.logs = [transferLog caller dst v] ∧ obs.output = be32 1) ∧
+    (obs.success = false → obs.storage = slotValue σ ∧ obs.logs = [] ∧
+      obs.output = errorData (if v ≤ slotValue σ (balKey caller) then addMsg else subMsg))
+
+/-- **The scoped premise of a call**: keccak256 separated on its footprint, the preimages of the
+caller's and the recipient's `balanceOf` slots, and nothing else. -/
+def Scope (call : Call) : Prop :=
+  ∀ σ dst v, call = transferCall σ dst v → dst < 2 ^ 160 → v < 2 ^ 256 →
+    ScopedSep (transferFootprint balanceSlot caller dst)
+
+/-- **The target's postcondition** (docs/CERTIFICATION_TARGET.md, "First slice"): with `s` the
+storage before the call, `caller ≠ to` succeeds iff `s[caller] ≥ v` and `s[to] + v < 2 ^ 256`,
+then debits and credits; `caller = to` succeeds iff `s[caller] ≥ v` and leaves the storage as it
+was; a success logs `Transfer(caller, to, v)`, returns `true` and changes no slot outside the
+footprint; a failure reverts with the source's revert data, no log, no change. -/
+def TargetPost (call : Call) (obs : Observable) : Prop :=
+  ∀ σ dst v, call = transferCall σ dst v → dst < 2 ^ 160 → v < 2 ^ 256 →
+    (caller ≠ dst →
+      (obs.success = true ↔
+        v ≤ slotValue σ (balKey caller) ∧ slotValue σ (balKey dst) + v < 2 ^ 256) ∧
+      (obs.success = true → obs.storage (balKey caller) = slotValue σ (balKey caller) - v ∧
+        obs.storage (balKey dst) = slotValue σ (balKey dst) + v)) ∧
+    (caller = dst →
+      (obs.success = true ↔ v ≤ slotValue σ (balKey caller)) ∧
+      (obs.success = true → obs.storage = slotValue σ)) ∧
+    (obs.success = true → obs.logs = [transferLog caller dst v] ∧ obs.output = be32 1 ∧
+      ∀ n, n % 2 ^ 256 ≠ balKey caller → n % 2 ^ 256 ≠ balKey dst → obs.storage n = slotValue σ n) ∧
+    (obs.success = false → obs.storage = slotValue σ ∧ obs.logs = [] ∧
+      obs.output = errorData (if v ≤ slotValue σ (balKey caller) then addMsg else subMsg))
+
+theorem balKey_mod (a : Nat) : balKey a % 2 ^ 256 = balKey a := Nat.mod_eq_of_lt (solHash_lt a _)
+
+theorem balKey_mod' (a : Nat) :
+    balKey a % 115792089237316195423570985008687907853269984665640564039457584007913129639936 =
+      balKey a := Nat.mod_eq_of_lt (solHash_lt a _)
+
+theorem slotValue_mod (σ : List (Nat × Nat)) (n : Nat) :
+    slotValue σ (n % 2 ^ 256) = slotValue σ n := by
+  unfold slotValue
+  simp only [Nat.mod_mod]
+
+/-- **The target's postcondition from the source's, under the call's scope.** -/
+theorem targetPost_of_seq {call : Call} {obs : Observable} (h : SeqPost call obs)
+    (hs : Scope call) : TargetPost call obs := by
+  intro σ dst v hc hto hv
+  obtain ⟨hsucc, hok, hfail⟩ := h σ dst v hc hto hv
+  have hsep := hs σ dst v hc hto hv
+  have hlt : ∀ a, balKey a < 2 ^ 256 := fun a => solHash_lt a balanceSlot
+  -- the debited state at the recipient's slot
+  have hdeb_ne : caller ≠ dst → debit (slotValue σ) v (balKey dst) = slotValue σ (balKey dst) := by
+    intro hne
+    have hk : balKey caller ≠ balKey dst :=
+      (transfer_slots hsep (by decide) (by decide) (by omega)).1 hne
+    simp only [debit, upd, Nat.mod_eq_of_lt (hlt dst)]
+    rw [if_neg (Ne.symm hk)]
+  refine ⟨fun hne => ?_, fun heq => ?_, fun hsc => ?_, hfail⟩
+  · have hk : balKey caller ≠ balKey dst :=
+      (transfer_slots hsep (by decide) (by decide) (by omega)).1 hne
+    have hd := hdeb_ne hne
+    refine ⟨by rw [hsucc, hd], fun hsc => ?_⟩
+    obtain ⟨hst, -, -⟩ := hok hsc
+    rw [hst]
+    constructor
+    · simp [seqStore, upd, debit, balKey_mod', hk, Ne.symm hk]
+    · simp only [seqStore, upd, balKey_mod, ↓reduceIte]
+      rw [hd]
+  · subst heq
+    have hlt' : slotValue σ (balKey caller) < 2 ^ 256 := Generic.slotValue_lt σ _
+    have hd : debit (slotValue σ) v (balKey caller) = slotValue σ (balKey caller) - v := by
+      simp [debit, upd, balKey_mod']
+    refine ⟨?_, fun hsc => ?_⟩
+    · rw [hsucc, hd]
+      exact ⟨fun h => h.1, fun h => ⟨h, by omega⟩⟩
+    · obtain ⟨hst, -, -⟩ := hok hsc
+      have hle := (hsucc.mp hsc).1
+      rw [hst]
+      funext n
+      by_cases h1 : n % 2 ^ 256 = balKey caller
+      · simp only [seqStore, upd, h1, ↓reduceIte]
+        rw [hd, ← slotValue_mod σ n, h1]
+        omega
+      · simp only [seqStore, debit, upd, if_neg h1]
+  · obtain ⟨hst, hlog, hout⟩ := hok hsc
+    refine ⟨hlog, hout, fun n h1 h2 => ?_⟩
+    rw [hst]
+    simp only [seqStore, debit, upd, if_neg h1, if_neg h2]
+
+/-- info: 'SolidCore.Spec.UniswapV2.ERC20.Slice.targetPost_of_seq' depends on axioms: [propext, Classical.choice, Quot.sound] -/
+#guard_msgs (whitespace := lax) in
+#print axioms targetPost_of_seq
+
+end SolidCore.Spec.UniswapV2.ERC20.Slice
