index 0000000..96626a7
--- /dev/null
+++ b/Contracts/UniswapV2/ERC20/Slice/BundleNeg.lean
@@ -0,0 +1,61 @@
+import Contracts.UniswapV2.ERC20.Slice.Mutants
+
+/-!
+# UniswapV2ERC20.transfer: the exported spec is not vacuous
+
+solar-verify's exported spec (as `bundlePost`) rejects the return mutant's run of `call0` (success,
+returning `false`): its `ensures` `returns true` fails. So the spec the unmutated contract meets on
+every valid call (`meets_bundle`) rejects an observable a compiled program actually produces
+(`nonVacuous_bundle`, `ret_refuted_bundle`).
+-/
+
+namespace SolidCore.Spec.UniswapV2.ERC20.Slice.Mutants
+
+open SolarTV SolidCore.Refinement SolidCore.Refinement.Generic SolidCore.Spec SolidCore.Refinement.Shapes
+open SolidCore.Spec.UniswapV2.ERC20.Slice SolidCore.Spec.UniswapV2.ERC20.Slice.Gen
+
+/-- The state before `call0`. -/
+def pre0 : State := ⟨slotValue σ0, Ghost.zero, 0⟩
+
+theorem decodes0 : Decodes transfer_spec call0 [1, 0] := by
+  refine ⟨by decide +kernel, by decide +kernel, ?_⟩
+  rw [show call0.calldata = Abi.calldata transferSel [1, 0] from rfl, words_calldata _ (by simp)]
+  decide +kernel
+
+theorem pre_call0 : Pre spec transfer_spec (ctxOf call0) pre0 call0 [1, 0] :=
+  ⟨decodes0, rfl, by decide, by simp [Bundle.satAll, transfer_spec, Gen.spec,
+    SolidCore.Spec.Export.UniswapV2ERC20Slice.UniswapV2ERC20],
+    by simp [Bundle.satAll, Gen.spec, SolidCore.Spec.Export.UniswapV2ERC20Slice.UniswapV2ERC20]⟩
+
+/-- **The exported spec rejects a success returning `false`** on `call0`. -/
+theorem bundle_rejects_false {obs : Observable} (h1 : obs.success = true) (h2 : obs.output = be32 0) :
+    ¬ bundlePost spec ctxOf idStep call0 obs := by
+  intro hb
+  have hp := hb transfer_spec (by rw [specs_eq]; exact List.mem_singleton_self _) [1, 0] pre0 pre_call0
+  obtain ⟨rets, hdec, hens, -⟩ := hp.1 h1
+  rw [h2, show words (be32 0) = [0] by decide +kernel] at hdec
+  have hr : rets = [0] := by
+    simp [transfer_spec, Gen.spec, SolidCore.Spec.Export.UniswapV2ERC20Slice.UniswapV2ERC20, decodeWords,
+      Ty.ofWord] at hdec
+    exact hdec.symm
+  subst hr
+  have := hens (.ret 0) (by simp [transfer_spec, Gen.spec, SolidCore.Spec.Export.UniswapV2ERC20Slice.UniswapV2ERC20])
+  simp [Bundle.sat, eval, mkEnv, Env.cur, Env.bind] at this
+
+/-- **The exported spec is not vacuous** on the valid calls with their premise. -/
+theorem nonVacuous_bundle : ∃ call obs, ValidIn call ∧ ¬ bundlePost spec ctxOf idStep call obs :=
+  ⟨call0, ⟨true, be32 0, [], slotValue σ0⟩, valid_call0, bundle_rejects_false rfl rfl⟩
+
+/-- **The return mutant fails the exported spec**, by its run on `call0`. -/
+theorem ret_refuted_bundle {c : SolidCore.Solidity.TypeCheck.CheckedContract}
+    (hc : SolidCore.Verify.VC.UniswapV2ERC20MutRet.contract? = .ok c) :
+    ¬ Meets (solidCore fuel) c (fun call => Valid Gen.MutRet.deployed call ∧ Scope call)
+      (bundlePost spec ctxOf idStep) := fun h =>
+  bundle_rejects_false ret_result.1 ret_result.2
+    (h call0 ⟨valid0 _ coversRet, scope_call0⟩ _ (runRet hc))
+
+/-- info: 'SolidCore.Spec.UniswapV2.ERC20.Slice.Mutants.ret_refuted_bundle' depends on axioms: [propext, Classical.choice, Quot.sound] -/
+#guard_msgs (whitespace := lax) in
+#print axioms ret_refuted_bundle
+
+end SolidCore.Spec.UniswapV2.ERC20.Slice.Mutants
diff --git a/Contracts/UniswapV2/ERC20/Slice/Bytes.lean b/Contracts/UniswapV2/ERC20/Slice/Bytes.lean
new file mode 100644
index 0000000..6403d45
--- /dev/null
+++ b/Contracts/UniswapV2/ERC20/Slice/Bytes.lean
@@ -0,0 +1,120 @@
+import Contracts.UniswapV2.ERC20.Slice.Statement
+
+/-!
+# UniswapV2ERC20.transfer: the specification carried to the bytes through `Equiv`
+
+E7 of docs/CERTIFICATION_TARGET.md: the slice's specification, proved of SolidCore's runs
+(Statement.lean), transferred to the exact runtime bytes by the behavioural equivalence
+`Shapes.Equiv` the backend stages and the byte binding deliver (E4 to E6, other lanes). Nothing
+here assumes anything of the bytes beyond the hypotheses named in each statement.
+
+* `meets_bytes` (any source, any spec): `Equiv` and `Meets` give, at every gas below `2 ^ 256`,
+  every result of the bytes on a valid call meeting the spec, or an inert failure (`Inert`: no
+  change, no log; running out of gas is one, so no more can be said without a gas bound);
+* `meets_bytes_enough`: with `Resources` (E8) as well, every result of the bytes from the gas bound
+  on meets the spec exactly;
+* for the slice: `terminates` (SolidCore halts on every valid call, succeeding or reverting with
+  one of SafeMath's two errors, `Allowed`), and `functional_of_equiv`, `certified_of`: given
+  `Equiv` (and `Resources`) for some bytes `code` on `ValidIn`, the target's `Functional`
+  (`Certified`) statement with `TargetPost`; `bytes_target`, `bytes_seq`, `bytes_bundle`: the
+  three specifications on the bytes, each with its `Inert` alternative.
+
+The binding of `code` to the bytes solar emits for the pinned port, and `Equiv` itself, are not
+proved here: they are the named premises `heq` (E4 to E6) and `hres` (E8).
+-/
+
+namespace SolidCore.Spec.UniswapV2.ERC20.Slice
+
+open SolarTV SolidCore.Refinement SolidCore.Refinement.Generic SolidCore.Spec SolidCore.Refinement.Shapes
+open SolidCore.Spec.UniswapV2.ERC20.Slice.Gen
+
+/-! ## The transfer lemma -/
+
+/-- **`Meets` from the source to the bytes through `Equiv`.** -/
+theorem meets_bytes {S : Sem} {p : S.Prog} {code : ByteArray} {V : Call → Prop}
+    {P : Call → Observable → Prop} (heq : Equiv S p code V) (hm : Meets S p V P) (gas : Nat)
+    (hg : gas < 2 ^ 256) (call : Call) (hc : V call) (obs : Observable)
+    (hrun : Final.Target.runWith gas code call = some obs) : P call obs ∨ Inert call obs :=
+  (heq gas hg call hc obs hrun).imp (hm call hc obs) id
+
+/-- **With a gas bound, exactly**: from `G call` gas on, every result of the bytes meets `P`. -/
+theorem meets_bytes_enough {S : Sem} {p : S.Prog} {code : ByteArray} {V : Call → Prop}
+    {P : Call → Observable → Prop} {G : Call → Nat} (hres : Resources S p code V G) (hm : Meets S p V P)
+    (call : Call) (hc : V call) (gas : Nat) (h1 : G call ≤ gas) (h2 : gas < 2 ^ 256) (obs : Observable)
+    (hrun : Final.Target.runWith gas code call = some obs) : P call obs := by
+  rw [(hres call hc).2 gas h1 h2] at hrun
+  exact hm call hc obs hrun
+
+/-- A specification no bytes can meet vacuously by an inert failure: `TargetPost` asks a revert for
+SafeMath's revert data, so an inert result with other output does not meet it. -/
+theorem inert_not_target : ¬ TargetPost call0 ⟨false, [], [], slotValue σ0⟩ := by
+  intro h
+  have := ((h σ0 1 0 rfl (by decide) (by decide)).2.2.2 rfl).2.2
+  simp [errorData] at this
+
+/-! ## The slice -/
+
+/-- The statuses `transfer` may end with: success, or a revert with one of SafeMath's errors. -/
+def Allowed (_call : Call) (obs : Observable) : Prop :=
+  obs.success = true ∨ obs.output = errorData subMsg ∨ obs.output = errorData addMsg
+
+/-- **SolidCore halts on every valid call**, with an allowed status. -/
+theorem terminates {c : SolidCore.Solidity.TypeCheck.CheckedContract}
+    (hc : SolidCore.Verify.VC.UniswapV2ERC20.contract? = .ok c) :
+    Terminates (solidCore fuel) c ValidIn Allowed := by
+  rintro _ ⟨⟨σ, dst, v, hcov, hto, hv, rfl⟩, -⟩
+  refine ⟨_, run_tree hc hcov hto hv, ?_⟩
+  have hs := fun k => Generic.slotValue_lt σ k
+  by_cases hle : v ≤ slotValue σ (balKey caller)
+  · by_cases hov : debit (slotValue σ) v (balKey dst) + v < 2 ^ 256
+    · rw [res_ok hs hto hv hle hov]; exact Or.inl rfl
+    · rw [res_add hs hto hv hle hov]; exact Or.inr (Or.inr rfl)
+  · rw [res_sub hs hto hv hle]; exact Or.inr (Or.inl rfl)
+
+/-- **The slice's functional statement, given `Equiv`** for bytes `code` on the valid calls. -/
+theorem functional_of_equiv {c : SolidCore.Solidity.TypeCheck.CheckedContract}
+    (hc : SolidCore.Verify.VC.UniswapV2ERC20.contract? = .ok c) {code : ByteArray}
+    (heq : Equiv (solidCore fuel) c code ValidIn) :
+    Functional (solidCore fuel) c code ValidIn Allowed TargetPost :=
+  ⟨valid_inhabited, heq, terminates hc, meets_target hc⟩
+
+/-- **The slice's certified statement, given `Equiv` and `Resources`.** -/
+theorem certified_of {c : SolidCore.Solidity.TypeCheck.CheckedContract}
+    (hc : SolidCore.Verify.VC.UniswapV2ERC20.contract? = .ok c) {code : ByteArray} {G : Call → Nat}
+    (heq : Equiv (solidCore fuel) c code ValidIn) (hres : Resources (solidCore fuel) c code ValidIn G) :
+    Certified (solidCore fuel) c code ValidIn Allowed TargetPost G :=
+  ⟨valid_inhabited, heq, terminates hc, meets_target hc, hres⟩
+
+/-- **`TargetPost` on the bytes**, at every gas, or an inert failure. -/
+theorem bytes_target {c : SolidCore.Solidity.TypeCheck.CheckedContract}
+    (hc : SolidCore.Verify.VC.UniswapV2ERC20.contract? = .ok c) {code : ByteArray}
+    (heq : Equiv (solidCore fuel) c code ValidIn) (gas : Nat) (hg : gas < 2 ^ 256) (call : Call)
+    (hv : ValidIn call) (obs : Observable) (hrun : Final.Target.runWith gas code call = some obs) :
+    TargetPost call obs ∨ Inert call obs :=
+  meets_bytes heq (meets_target hc) gas hg call hv obs hrun
+
+/-- **`SeqPost` on the bytes**: no hash premise on the calls, only in `Equiv`'s. -/
+theorem bytes_seq {c : SolidCore.Solidity.TypeCheck.CheckedContract}
+    (hc : SolidCore.Verify.VC.UniswapV2ERC20.contract? = .ok c) {code : ByteArray}
+    (heq : Equiv (solidCore fuel) c code (Valid deployed)) (gas : Nat) (hg : gas < 2 ^ 256) (call : Call)
+    (hv : Valid deployed call) (obs : Observable) (hrun : Final.Target.runWith gas code call = some obs) :
+    SeqPost call obs ∨ Inert call obs :=
+  meets_bytes heq (meets_seq hc) gas hg call hv obs hrun
+
+/-- **solar-verify's exported spec on the bytes.** -/
+theorem bytes_bundle {c : SolidCore.Solidity.TypeCheck.CheckedContract}
+    (hc : SolidCore.Verify.VC.UniswapV2ERC20.contract? = .ok c) {code : ByteArray}
+    (heq : Equiv (solidCore fuel) c code ValidIn) (gas : Nat) (hg : gas < 2 ^ 256) (call : Call)
+    (hv : ValidIn call) (obs : Observable) (hrun : Final.Target.runWith gas code call = some obs) :
+    bundlePost spec ctxOf idStep call obs ∨ Inert call obs :=
+  meets_bytes heq (meets_bundle hc) gas hg call hv obs hrun
+
+/-- **With `Resources`, `TargetPost` of the bytes exactly** from the gas bound on. -/
+theorem bytes_target_enough {c : SolidCore.Solidity.TypeCheck.CheckedContract}
+    (hc : SolidCore.Verify.VC.UniswapV2ERC20.contract? = .ok c) {code : ByteArray} {G : Call → Nat}
+    (hres : Resources (solidCore fuel) c code ValidIn G) (call : Call) (hv : ValidIn call) (gas : Nat)
+    (h1 : G call ≤ gas) (h2 : gas < 2 ^ 256) (obs : Observable)
+    (hrun : Final.Target.runWith gas code call = some obs) : TargetPost call obs :=
+  meets_bytes_enough hres (meets_target hc) call hv gas h1 h2 obs hrun
+
+end SolidCore.Spec.UniswapV2.ERC20.Slice
diff --git a/Contracts/UniswapV2/ERC20/Slice/Mutants.lean b/Contracts/UniswapV2/ERC20/Slice/Mutants.lean
new file mode 100644
index 0000000..a32647e
--- /dev/null
+++ b/Contracts/UniswapV2/ERC20/Slice/Mutants.lean
@@ -0,0 +1,141 @@
+import Contracts.UniswapV2.ERC20.Slice.Bytes
+import Contracts.UniswapV2.ERC20.Slice.Gen.MutLog.Tree
+import Contracts.UniswapV2.ERC20.Slice.Gen.MutRet.Tree
+
+/-!
+# UniswapV2ERC20.transfer: semantic mutants of the port, refused by execution
+
+Each mutant is one text edit of the pinned port (scripts/verify/uniswap-v2/transfer-mutants.txt),
+compiled by the same frontend and checked by the kernel (`Gen/Mut<M>/Core.lean`, `contract_ok`),
+its `transfer` erased by the same generic source stage (`Gen/Mut<M>/Tree.lean`,
+`transfer_erase_eq`, `deploy_eq`). The refutations run SolidCore's checked mutant on one valid call
+(`run<M>`, `source_run`) and evaluate the result: no formula is checked on a hand-written state.
+
+* `Log` (`emit Transfer(to, from, value)`): `transfer(1, 0)` from `σ0` succeeds with the log's
+  addresses swapped; `SeqPost` and `TargetPost` refuse it (`log_refuted_seq`,
+  `log_refuted_target`). solar-verify's exported spec says nothing of logs, so it does not.
+* `Ret` (`return false`): the same call returns `false`; refused by `SeqPost`, `TargetPost` and
+  the exported spec (`returns true`; `ret_refuted_bundle`).
+* `Debit` (`balanceOf[from] = balanceOf[from].sub(value).add(value)`: the debit undone):
+  `transfer(1, 2)` from a balance of 5 succeeds and leaves it at 5; `TargetPost` and `SeqPost`
+  refuse it (`debit_refuted_target`, `debit_refuted_seq`, MutantsDebit.lean).
+
+The unmutated contract meets all three on the same call (`meets_seq`, `meets_target`,
+`meets_bundle`), so each refusal is the mutation's.
+-/
+
+namespace SolidCore.Spec.UniswapV2.ERC20.Slice.Mutants
+
+open SolarTV SolidCore.Refinement SolidCore.Refinement.Generic SolidCore.Spec SolidCore.Refinement.Shapes
+open SolidCore.Spec.UniswapV2.ERC20.Slice
+
+theorem slotValue_σ0 : slotValue σ0 = fun _ => 0 := by
+  funext n; simp [slotValue, σ0]
+
+theorem valid0 (s : List (Nat × Nat)) (hs : Generic.Covers s σ0) : Valid s call0 :=
+  ⟨σ0, 1, 0, hs, by decide, by decide, rfl⟩
+
+/-- \`σ0\` writes every slot of a constructor storage that writes only slot 3. -/
+theorem covers_3 {s : List (Nat × Nat)} (h : ∀ kv ∈ s, kv.1 = 3) : Generic.Covers s σ0 := by
+  intro kv hkv
+  exact ⟨(3, 0), by simp [σ0], by rw [h kv hkv]⟩
+
+theorem coversLog : Generic.Covers Gen.MutLog.deployed σ0 := covers_3 (by simp [Gen.MutLog.deployed])
+theorem coversRet : Generic.Covers Gen.MutRet.deployed σ0 := covers_3 (by simp [Gen.MutRet.deployed])
+
+/-! ## Log -/
+
+section Log
+open SolidCore.Spec.UniswapV2.ERC20.Slice.Gen.MutLog in
+/-- SolidCore's run of `call0` on the mutant is its erased tree's result. -/
+theorem runLog {c : SolidCore.Solidity.TypeCheck.CheckedContract}
+    (hc : SolidCore.Verify.VC.UniswapV2ERC20MutLog.contract? = .ok c) :
+    (solidCore fuel).run c call0 = some (transfer_tree.eval ⟨[1, 0], slotValue σ0, solHash⟩).obs := by
+  have hdep := deploy_eq
+  simp only [deploy?, hc] at hdep
+  obtain ⟨d, hd⟩ := Wide.deployedAt_of hdep
+  have hmap := transfer_erase_eq
+  simp only [transfer_erase?, hc, Option.map_eq_some_iff, Prod.mk.injEq] at hmap
+  obtain ⟨f, hf, hlen, hT⟩ := hmap
+  exact source_run hd covers_σ0 (by decide) hf hT [1, 0] (by simp [hlen]) (by simp)
+end Log
+
+/-! ## Ret -/
+
+section Ret
+open SolidCore.Spec.UniswapV2.ERC20.Slice.Gen.MutRet in
+/-- SolidCore's run of `call0` on the mutant is its erased tree's result. -/
+theorem runRet {c : SolidCore.Solidity.TypeCheck.CheckedContract}
+    (hc : SolidCore.Verify.VC.UniswapV2ERC20MutRet.contract? = .ok c) :
+    (solidCore fuel).run c call0 = some (transfer_tree.eval ⟨[1, 0], slotValue σ0, solHash⟩).obs := by
+  have hdep := deploy_eq
+  simp only [deploy?, hc] at hdep
+  obtain ⟨d, hd⟩ := Wide.deployedAt_of hdep
+  have hmap := transfer_erase_eq
+  simp only [transfer_erase?, hc, Option.map_eq_some_iff, Prod.mk.injEq] at hmap
+  obtain ⟨f, hf, hlen, hT⟩ := hmap
+  exact source_run hd covers_σ0 (by decide) hf hT [1, 0] (by simp [hlen]) (by simp)
+end Ret
+
+/-- The log mutant's result on `call0`: success, with `Transfer(1, caller, 0)`. -/
+theorem log_result :
+    (Gen.MutLog.transfer_tree.eval ⟨[1, 0], slotValue σ0, solHash⟩).obs.success = true ∧
+      (Gen.MutLog.transfer_tree.eval ⟨[1, 0], slotValue σ0, solHash⟩).obs.logs ≠ [transferLog caller 1 0] := by
+  simp only [Res.obs, slotValue_σ0]
+  generalize solHash = H
+  simp [Gen.MutLog.transfer_tree, Tree.eval, WExpr.eval, BinOp.eval, UnOp.eval, Log.eval, transferLog,
+    caller, Generic.callerWord, Generic.wordSize]
+
+/-- The return mutant's result on `call0`: success, returning `false`. -/
+theorem ret_result :
+    (Gen.MutRet.transfer_tree.eval ⟨[1, 0], slotValue σ0, solHash⟩).obs.success = true ∧
+      (Gen.MutRet.transfer_tree.eval ⟨[1, 0], slotValue σ0, solHash⟩).obs.output = be32 0 := by
+  simp only [Res.obs, slotValue_σ0]
+  generalize solHash = H
+  simp [Gen.MutRet.transfer_tree, Tree.eval, WExpr.eval, BinOp.eval, UnOp.eval, OByte.eval, be32,
+    Generic.wordSize]
+
+theorem be32_ne : be32 0 ≠ be32 1 := by decide
+
+/-- **The log mutant fails `SeqPost`**, by its run on `call0`. -/
+theorem log_refuted_seq {c : SolidCore.Solidity.TypeCheck.CheckedContract}
+    (hc : SolidCore.Verify.VC.UniswapV2ERC20MutLog.contract? = .ok c) :
+    ¬ Meets (solidCore fuel) c (Valid Gen.MutLog.deployed) SeqPost := by
+  intro h
+  have hp := h call0 (valid0 _ coversLog) _ (runLog hc) σ0 1 0 rfl (by decide) (by decide)
+  exact log_result.2 (hp.2.1 log_result.1).2.1
+
+/-- **The log mutant fails `TargetPost`** on a call whose footprint premise holds. -/
+theorem log_refuted_target {c : SolidCore.Solidity.TypeCheck.CheckedContract}
+    (hc : SolidCore.Verify.VC.UniswapV2ERC20MutLog.contract? = .ok c) :
+    ¬ Meets (solidCore fuel) c (fun call => Valid Gen.MutLog.deployed call ∧ Scope call) TargetPost := by
+  intro h
+  have hp := h call0 ⟨valid0 _ coversLog, scope_call0⟩ _ (runLog hc) σ0 1 0 rfl (by decide) (by decide)
+  exact log_result.2 (hp.2.2.1 log_result.1).1
+
+/-- **The return mutant fails `SeqPost`.** -/
+theorem ret_refuted_seq {c : SolidCore.Solidity.TypeCheck.CheckedContract}
+    (hc : SolidCore.Verify.VC.UniswapV2ERC20MutRet.contract? = .ok c) :
+    ¬ Meets (solidCore fuel) c (Valid Gen.MutRet.deployed) SeqPost := by
+  intro h
+  have hp := h call0 (valid0 _ coversRet) _ (runRet hc) σ0 1 0 rfl (by decide) (by decide)
+  exact be32_ne (ret_result.2.symm.trans (hp.2.1 ret_result.1).2.2)
+
+/-- **The return mutant fails `TargetPost`.** -/
+theorem ret_refuted_target {c : SolidCore.Solidity.TypeCheck.CheckedContract}
+    (hc : SolidCore.Verify.VC.UniswapV2ERC20MutRet.contract? = .ok c) :
+    ¬ Meets (solidCore fuel) c (fun call => Valid Gen.MutRet.deployed call ∧ Scope call) TargetPost := by
+  intro h
+  have hp := h call0 ⟨valid0 _ coversRet, scope_call0⟩ _ (runRet hc) σ0 1 0 rfl (by decide) (by decide)
+  exact be32_ne (ret_result.2.symm.trans (hp.2.2.1 ret_result.1).2.1)
+
+/-- info: 'SolidCore.Spec.UniswapV2.ERC20.Slice.Mutants.log_refuted_target' depends on axioms: [propext, Classical.choice, Quot.sound] -/
+#guard_msgs (whitespace := lax) in
+#print axioms log_refuted_target
+
+/-- info: 'SolidCore.Spec.UniswapV2.ERC20.Slice.Mutants.ret_refuted_target' depends on axioms: [propext, Classical.choice, Quot.sound] -/
+#guard_msgs (whitespace := lax) in
+#print axioms ret_refuted_target
+
+
+end SolidCore.Spec.UniswapV2.ERC20.Slice.Mutants
