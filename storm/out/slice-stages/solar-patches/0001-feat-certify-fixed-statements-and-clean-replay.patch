+                    h.update(chunk)
+            out[p] = h.hexdigest()
+    return out
+
+
+def module_of(lib, path):
+    rel = os.path.relpath(path, lib)
+    d, f = os.path.split(rel)
+    return os.path.join(d, f.split(".", 1)[0]).replace(os.sep, ".")
+
