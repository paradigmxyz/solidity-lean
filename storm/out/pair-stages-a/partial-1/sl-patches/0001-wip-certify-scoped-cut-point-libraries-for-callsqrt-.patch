From 51d0d391297a043f2cb2821bd16610d8928badbb Mon Sep 17 00:00:00 2001
From: Troy Sargent <0xalpharush@protonmail.com>
Date: Sat, 14 Nov 2026 04:47:02 +0000
Subject: [PATCH 1/3] wip(certify): scoped cut-point libraries for callsqrt and
 the pair

---
 lakefile.lean | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/lakefile.lean b/lakefile.lean
index cb2ed92..c9a5083 100644
--- a/lakefile.lean
+++ b/lakefile.lean
@@ -518,3 +518,17 @@ lean_lib «arraymax» where
 lean_lib ContractsUniswapV2PairSpec where
   roots := #[`Contracts.UniswapV2.PairSpec.Published, `Contracts.UniswapV2.PairSpec.Negative]
   globs := #[.submodules `Contracts.UniswapV2.PairSpec]
+
+-- Scoped cut-point stages (storm lane pair-stages-a): callsqrt's stages with g left out, the
+-- generator's check of scoped cut points.
+lean_lib «cs_scope» where
+  srcDir := "Certified"
+  roots := #[`cs_scope.Proofs]
+  globs := #[.submodules `cs_scope]
+
+-- UniswapV2Pair's backend stages on the calls of mint and burn (generated at build time, not
+-- committed: v2-core is GPL-3.0).
+lean_lib «uv2_pair_mb» where
+  srcDir := "Certified"
+  roots := #[`uv2_pair_mb.Proofs]
+  globs := #[.submodules `uv2_pair_mb]
-- 
