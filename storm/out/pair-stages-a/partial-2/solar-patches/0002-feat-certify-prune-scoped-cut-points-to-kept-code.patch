+def read_facts(func, values, env):
+    """For each of values that the function defines by reading calldata at a constant offset,
+    the equation of its word in env with that calldata word: calldata never changes during a
+    call, so the fact holds wherever the value is live."""
+    facts = []
+    for _, insts, _ in func["blocks"].values():
+        for ins in insts:
+            m = re.fullmatch(r"\.effect \(some (\d+)\) \.calldataload \[\.const ([0-9a-fx]+)\]", ins)
+            if m and int(m[1]) in values:
+                facts.append(f"{env} {m[1]} = calldataWord call {int(m[2], 0)}")
+    return facts
+
+
+def split_edges(fb, h, preds_a, preds_b):
+    """The pairs of predecessors of header h along which two programs can enter it together,
+    when a pass split blocks (lower-assumes ends a block at a check and continues in a new one):
+    a predecessor both keep is paired with itself, and one the pass split with the one new
+    predecessor its own block still reaches in the new program without passing h; any other
+    predecessor with every predecessor of the new program."""
+    _, _, succ = mir_headers(fb)
+    common = set(preds_a) & set(preds_b)
+    fresh = [q for q in preds_b if q not in common]
+
+    def reaches(a):
+        seen, work = {a}, [a]
+        while work:
+            for t in succ.get(work.pop(), []):
+                if t != h and t not in seen:
+                    seen.add(t)
+                    work.append(t)
+        return seen
+
+    cands = {
+        pa: {q for q in fresh if q in reaches(pa)} if pa in fb["blocks"] else set()
+        for pa in preds_a
+        if pa not in common
+    }
+    # Pair the predecessors that reach one new block, then drop it from the others', until none
+    # is left to pair.
+    paired = {}
+    while True:
+        one = next((pa for pa, c in cands.items() if pa not in paired and len(c) == 1), None)
+        if one is None:
+            break
+        (q,) = cands[one]
+        paired[one] = q
+        for pa, c in cands.items():
+            if pa not in paired:
+                c.discard(q)
+    edges = []
+    for pa in preds_a:
+        if pa in common:
+            edges.append((pa, pa))
+        elif pa in paired:
+            edges.append((pa, paired[pa]))
+        else:
+            edges += [(pa, pb) for pb in preds_b]
+    return edges
+
+
