+def kept_functions(funcs):
+    """The functions a kept call can run: from the runtime entry, through internal calls, never
+    into an external function EXCLUDED_NAMES leaves out (the entry dispatches to it only on a
+    selector the scope rules out). All of them when nothing is excluded."""
+    if not EXCLUDED_NAMES:
+        return set(range(len(funcs)))
+    entry = next(i for i, f in enumerate(funcs) if f["name"] == "entry")
+    seen, todo = set(), [entry]
+    while todo:
+        f = todo.pop()
+        if f in seen or funcs[f]["name"] in EXCLUDED_NAMES:
+            continue
+        seen.add(f)
+        todo += [c for _, _, c, _ in mir_calls(funcs[f])]
+        todo += [
+            int(m[1])
+            for _, _, term in funcs[f]["blocks"].values()
+            if (m := re.match(r"\.tailCall (\d+)", term))
+        ]
+    return seen
+
