@@ -1503,9 +1643,21 @@ def mir_mir_rels(pass_name, fa_list, fb_list, cuts, ctx_a=None, ctx_b=None, join
         live_b, _ = mir_liveness(fb)
         dsts = sorted(d for d, _ in fa["blocks"][h][0])
         live = sorted((live_a[h] | live_b[h]) - set(dsts))
-        for pa in preds_a:
-            for pb in preds_b:
-                conds = [f"env' {v} = env {v}" for v in live]
+        # A value live on one side only is related through what it reads instead: a pass that
+        # places reads (place-reads) gives the same calldata word a new number.
+        reads = read_facts(fa, live_a[h] - live_b[h], "env") + read_facts(
+            fb, live_b[h] - live_a[h], "env'"
+        )
+        live = sorted((live_a[h] & live_b[h]) - set(dsts)) if reads else live
+        # A pass that keeps the header's predecessors keeps its edges: the two programs enter it
+        # along the same edge, so only those pairs are related. Otherwise every pair.
+        if sorted(preds_a) == sorted(preds_b):
+            edges = [(p, p) for p in preds_a]
+        else:
+            edges = split_edges(fb, h, preds_a, preds_b)
+        for pa, pb in edges:
+            if True:
+                conds = [f"env' {v} = env {v}" for v in live] + reads
                 feasible = True
                 for d in dsts:
                     ia, ib = phi_input(fa, h, pa, d), phi_input(fb, h, pb, d)
