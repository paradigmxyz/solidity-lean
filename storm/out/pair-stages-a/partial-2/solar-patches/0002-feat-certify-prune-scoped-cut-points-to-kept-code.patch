+def excluded_evm_blocks(funcs, sched_blocks, schedule):
+    """The scheduled EVM IR blocks (compiler numbers) that only external functions EXCLUDED_NAMES
+    leaves out reach: those reachable from their entries but from no other function's, where a
+    block reaches its jumps' targets, the next block and the labels it pushes (the places its
+    calls return to). A later pass keeps a block's number, so the set carries over; a block a
+    pass creates is never in it."""
+    if not EXCLUDED_NAMES:
+        return set()
+    ids = [i for i, _ in sched_blocks]
+    pos = {i: n for n, i in enumerate(ids)}
+    succ = {}
+    for n, (_, instrs) in enumerate(sched_blocks):
+        out, end = [], False
+        for ins in instrs:
+            m = re.fullmatch(r"\.pushLabel (\d+)", ins)
+            if m:
+                out.append(int(m[1]))
+                continue
+            _, _, kind, targets = effect(ins)
+            out += targets
+            if kind in ("jump", "dyn", "table", "end"):
+                end = True
+                break
+        if not end:
+            out.append(n + 1)
+        succ[n] = {t for t in out if t < len(sched_blocks)}
+
+    def closure(starts):
+        seen, work = set(starts), list(starts)
+        while work:
+            for t in succ[work.pop()]:
+                if t not in seen:
+                    seen.add(t)
+                    work.append(t)
+        return seen
+
+    entries = {fm["function"]: fm["entry"] for fm in schedule["functions"] if fm.get("entry") is not None}
+    out_f = [pos[e] for f, e in entries.items() if funcs[f]["name"] in EXCLUDED_NAMES and e in pos]
+    in_f = [
+        pos[e]
+        for f, e in entries.items()
+        if funcs[f]["name"] not in EXCLUDED_NAMES and funcs[f]["name"] != "entry" and e in pos
+    ]
+    return {ids[n] for n in closure(out_f) - closure(in_f)}
+
+
