+def scope_term():
+    """The call predicate a stage is proved on: `scope` when functions are excluded."""
+    return "anyCall" if SCOPE is None else "scope"
+
+
+def scope_open(h):
+    """Tactic lines opening `h : scope call` into the selector hypotheses and their symmetric
+    forms, so that the dispatcher's tests of an excluded selector rewrite to false."""
+    names = [f"hsel{i}" for i in range(SCOPE)]
+    opener = (
+        f"  have {names[0]} := {h}\n"
+        if SCOPE == 1
+        else f"  obtain ⟨{', '.join(names)}⟩ := {h}\n"
+    )
+    return (
+        f"  simp only [scope] at {h}\n"
+        + opener
+        + "".join(f"  have {n}s := Ne.symm {n}\n" for n in names)
+    )
+
+
