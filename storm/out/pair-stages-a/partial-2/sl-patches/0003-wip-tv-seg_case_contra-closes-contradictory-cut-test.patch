From: Troy Sargent <0xalpharush@protonmail.com>
Date: Sat, 14 Nov 2026 15:26:13 +0000
Subject: [PATCH 3/3] wip(tv): seg_case_contra closes contradictory cut-test
 cases

---
 lakefile.lean            |  8 ++++++++
 tv/W1Proofs/Segment.lean | 35 +++++++++++++++++++++++++++++++++++
 2 files changed, 43 insertions(+)

diff --git a/lakefile.lean b/lakefile.lean
index afb3f8a..a5a0c52 100644
--- a/lakefile.lean
+++ b/lakefile.lean
@@ -535,3 +535,11 @@ lean_lib «uv2_pair_mb» where
   weakLeanArgs := #["--threads=1"]
   roots := #[`uv2_pair_mb.Proofs]
   globs := #[.submodules `uv2_pair_mb]
+
+-- UniswapV2Pair's backend stages on the calls of mint alone (generated at build time, not
