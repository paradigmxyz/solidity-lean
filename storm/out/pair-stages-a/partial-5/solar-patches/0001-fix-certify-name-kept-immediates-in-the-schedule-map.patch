+                info.layout.iter().map(|l| location(&f.immediates, l)).collect();
             let _ = write!(
                 out,
                 "\n      {{\"block\": {}, \"start\": {start}, \"layout\": [{}], \"floating\": {}, \
@@ -373,7 +379,8 @@ pub(crate) fn schedule_map(gcx: Gcx<'_>, program: &ir::Module, map: &ScheduleMap
         out.push_str("\n    ], \"calls\": [");
         for (n, call) in f.calls.iter().enumerate() {
             let block = call.block.map_or("null".to_string(), |b| b.index().to_string());
-            let below: Vec<String> = call.below.iter().map(location).collect();
