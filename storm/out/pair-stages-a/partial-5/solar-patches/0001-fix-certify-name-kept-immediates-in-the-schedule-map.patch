From 8f74e3fae77582fe5f1a7c477241390c93318884 Mon Sep 17 00:00:00 2001
From: Troy Sargent <0xalpharush@protonmail.com>
Date: Sat, 14 Nov 2026 23:04:39 +0000
Subject: [PATCH 1/3] fix(certify): name kept immediates in the schedule map

Constant retention keeps a repeated immediate on the stack as a live
word, but the exported MIR writes immediates as constant operands, so
a "vN" layout entry for one names no value the export defines and the
MIR-to-schedule relation left that word unconstrained. The schedule map
now records each function's immediates and writes such a word as its
constant ("c0x3e8"), and the cut-point generator relates it as that
literal word. Nothing the scheduler emits changes.
---
 .../src/backend/evm/codegen/stackify/emit.rs        | 10 +++++++++-
 crates/codegen/src/backend/evm/schedule_map.rs      |  4 ++++
 crates/codegen/src/lean_stages.rs                   | 13 ++++++++++---
 solar-tv/milestone/cutpoints.py                     |  6 ++++++
 4 files changed, 29 insertions(+), 4 deletions(-)

diff --git a/crates/codegen/src/backend/evm/codegen/stackify/emit.rs b/crates/codegen/src/backend/evm/codegen/stackify/emit.rs
index 25b94f18d..159927626 100644
--- a/crates/codegen/src/backend/evm/codegen/stackify/emit.rs
+++ b/crates/codegen/src/backend/evm/codegen/stackify/emit.rs
@@ -246,7 +246,7 @@ impl<'gcx> EvmCodegen<'gcx> {
         // The plan may be for a copy that rebuilds values at their uses.
         let rebuilt = plan.rebuilt.take();
         let func = rebuilt.as_deref().unwrap_or(func);
-        self.start_schedule_map(func_id, &rebuilt, &mut plan);
+        self.start_schedule_map(func_id, func, &rebuilt, &mut plan);
         // Spill slots: the spilled values in value order, then the return address.
         self.spill_slots.clear();
         self.spill_slots.extend(plan.spilled.iter().zip(0..));
@@ -827,6 +827,7 @@ impl<'gcx> EvmCodegen<'gcx> {
     fn start_schedule_map(
         &mut self,
         func_id: FunctionId,
+        func: &Function,
         rebuilt: &Option<Box<Function>>,
         plan: &mut FunctionPlan,
     ) {
@@ -863,6 +864,13 @@ impl<'gcx> EvmCodegen<'gcx> {
             placements: Vec::new(),
             clobbers: layouts.clobbers,
             unsupported: None,
+            immediates: (0..func.num_values())
+                .map(ValueId::from_usize)
+                .filter_map(|value| match func.value(value) {
+                    Value::Immediate(imm) => Some((value, imm.as_u256()?)),
+                    _ => None,
+                })
+                .collect(),
         });
     }
 
diff --git a/crates/codegen/src/backend/evm/schedule_map.rs b/crates/codegen/src/backend/evm/schedule_map.rs
index 09ea6d24b..2190c116e 100644
--- a/crates/codegen/src/backend/evm/schedule_map.rs
+++ b/crates/codegen/src/backend/evm/schedule_map.rs
@@ -90,6 +90,10 @@ pub(crate) struct FunctionMap {
     pub(crate) clobbers: FxHashSet<InstId>,
     /// Why the map cannot describe the function, such as code it emits outside the MIR.
     pub(crate) unsupported: Option<&'static str>,
+    /// The function's immediates, by value: a word the plan keeps on the stack may be an
+    /// immediate (constant retention), which the exported MIR writes as a constant operand, so
+    /// the map names it by its word.
+    pub(crate) immediates: Vec<(ValueId, alloy_primitives::U256)>,
 }
 
 /// The maps of the functions of one artifact, in emission order.
