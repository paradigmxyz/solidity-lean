diff --git a/Contracts/UniswapV2/ERC20/NoCall.lean b/Contracts/UniswapV2/ERC20/NoCall.lean
new file mode 100644
index 0000000..f3dcb6d
--- /dev/null
+++ b/Contracts/UniswapV2/ERC20/NoCall.lean
@@ -0,0 +1,43 @@
+import SolidCore.Refinement.Solar.AssembleNoCall
+import Contracts.UniswapV2.ERC20.Runtime
+
+/-!
+# UniswapV2ERC20's exact runtime bytes and the call-free route
+
+`Runtime.code` is the runtime bytecode solar emits for the port (`-Ogas --evm-version osaka`),
+written at build time by `scripts/verify/uniswap_v2_runtime.sh` (not committed). The kernel evaluates
+`AssembleNoCall`'s call-free checks on it, and both **fail**:
+
+* `runtime_not_callFree`: the linear decode has instructions `callFree` refuses
+  (`NoCallAt`: a STATICCALL at 903, permit's call to ECRECOVER, and return-data reads at 1158, 1161 and
+  1162; `NoCallOnly`: no other message-sending instruction). So
+  `AssembleNoCall.holds_of_checkCB_callFree` and `assembly_of_checkXB_norm_callFree` do not apply to
+  UniswapV2ERC20's runtime, and the call-free route cannot remove `StaticRunner`/`CalleesRun` there.
+* `runtime_not_noFaByte`: `calleesRun_of_noFaByte` does not apply either.
+
+Each kernel evaluation of the 1183-byte decode peaks near 4.6 GB, so the checks are split across
+the `NoCall*` modules, one process each under `-M 6000`.
+-/
+
+namespace SolidCore.Spec.UniswapV2.ERC20.NoCall
+
+open SolidCore.Refinement.Solar.AssembleNoCall SolidCore.Refinement.Solar.Assemble
+open SolarTV.Assembly
+
+abbrev code : ByteArray := Runtime.code
+
+/-- The decoded instructions of `c`, as `callFree` reads them. -/
+def decoded (c : ByteArray) : List (Nat × SolarTV.Assembly.Instr) := decodeFrom (bytesOf c) c.size 0
+
+/-- The counters of the instructions `callFree` refuses. -/
+def refusedAt (c : ByteArray) : List Nat :=
+  (decoded c).filterMap fun x => if instrFree x.2 then none else some x.1
+
+/-- **The exact runtime fails the call-free check.** -/
+theorem runtime_not_callFree : callFree code = false := by decide +kernel
+
+/-- info: 'SolidCore.Spec.UniswapV2.ERC20.NoCall.runtime_not_callFree' depends on axioms: [propext] -/
+#guard_msgs (whitespace := lax) in
+#print axioms runtime_not_callFree
+
+end SolidCore.Spec.UniswapV2.ERC20.NoCall
diff --git a/Contracts/UniswapV2/ERC20/NoCallAt.lean b/Contracts/UniswapV2/ERC20/NoCallAt.lean
new file mode 100644
index 0000000..e54884c
--- /dev/null
+++ b/Contracts/UniswapV2/ERC20/NoCallAt.lean
@@ -0,0 +1,21 @@
+import Contracts.UniswapV2.ERC20.NoCall
+
+/-!
+# Where UniswapV2ERC20's runtime fails the call-free check
+
+`refusedAt_eq`: the counters of the instructions `callFree` refuses, the STATICCALL at 903 (permit's call
+to ECRECOVER) and RETURNDATASIZE, RETURNDATACOPY, RETURNDATASIZE at 1158, 1161, 1162. They are of
+solar 38b5232's output (Runtime.lean's header has its digest): bytes from another compiler fail this
+theorem by evaluation, not silently.
+-/
+
+namespace SolidCore.Spec.UniswapV2.ERC20.NoCall
+
+/-- The counters of the refused instructions. -/
+theorem refusedAt_eq : refusedAt code = [903, 1158, 1161, 1162] := by decide +kernel
+
+/-- info: 'SolidCore.Spec.UniswapV2.ERC20.NoCall.refusedAt_eq' depends on axioms: [propext] -/
+#guard_msgs (whitespace := lax) in
+#print axioms refusedAt_eq
+
+end SolidCore.Spec.UniswapV2.ERC20.NoCall
diff --git a/Contracts/UniswapV2/ERC20/NoCallControl.lean b/Contracts/UniswapV2/ERC20/NoCallControl.lean
new file mode 100644
index 0000000..24f879e
--- /dev/null
+++ b/Contracts/UniswapV2/ERC20/NoCallControl.lean
@@ -0,0 +1,60 @@
+import Contracts.UniswapV2.ERC20.NoCallAt
+
+/-!
+# Control: the refusal comes from the refused instructions alone
+
+`scrubWith qs c` is `c` with the byte at each counter of `qs` replaced by INVALID (0xfe), and
+`scrubbed` scrubs exactly `refusedAt code` (`scrubbed_eq`, from `refusedAt_eq`). It has the runtime's size and its bytes off those counters
+(`scrubWith_size`, `scrubWith_get`, by proof, not evaluation), and it **passes** `callFree`
+(`scrubbed_callFree`): the decode stays aligned, and nothing but those instructions fails the check.
+-/
+
+namespace SolidCore.Spec.UniswapV2.ERC20.NoCall
+
+open SolidCore.Refinement.Solar.AssembleNoCall SolidCore.Refinement.Solar.Assemble
+open SolarTV.Assembly
+
+def scrubList (qs : List Nat) : Nat → List UInt8 → List UInt8
+  | _, [] => []
+  | i, b :: bs => (if qs.contains i then 0xfe else b) :: scrubList qs (i + 1) bs
+
+def scrubWith (qs : List Nat) (c : ByteArray) : ByteArray := ⟨(scrubList qs 0 c.data.toList).toArray⟩
+
+theorem scrubList_length (qs : List Nat) : ∀ i (l : List UInt8), (scrubList qs i l).length = l.length
+  | _, [] => rfl
+  | i, _ :: bs => by rw [scrubList, List.length_cons, List.length_cons, scrubList_length qs (i + 1) bs]
+
+theorem scrubList_get (qs : List Nat) : ∀ i (l : List UInt8) k (hk : k < l.length),
+    qs.contains (i + k) = false →
+      (scrubList qs i l)[k]'(by rw [scrubList_length]; exact hk) = l[k]
+  | _, [], _, hk, _ => absurd hk (by simp)
+  | i, b :: bs, 0, _, hq => by
+    simp only [scrubList, List.getElem_cons_zero]
+    rw [Nat.add_zero] at hq
+    rw [hq]; rfl
+  | i, b :: bs, k + 1, hk, hq => by
+    simp only [scrubList, List.getElem_cons_succ]
+    exact scrubList_get qs (i + 1) bs k (Nat.lt_of_succ_lt_succ hk) (by rw [← hq]; congr 1; omega)
+
+theorem scrubWith_size (qs : List Nat) (c : ByteArray) : (scrubWith qs c).size = c.size := by
+  show (scrubList qs 0 c.data.toList).toArray.size = c.data.size
+  rw [List.size_toArray, scrubList_length, Array.length_toList]
+
+theorem scrubWith_get (qs : List Nat) (c : ByteArray) (i : Nat) (hi : i < c.size)
+    (hq : qs.contains i = false) :
+    (scrubWith qs c).data[i]'(by rw [← ByteArray.size, scrubWith_size]; exact hi) = c.data[i] := by
+  have h := scrubList_get qs 0 c.data.toList i (by rw [Array.length_toList]; exact hi)
+    (by rw [Nat.zero_add]; exact hq)
+  exact h.trans (by simp)
+
+def scrubbed : ByteArray := scrubWith [903, 1158, 1161, 1162] code
+
+theorem scrubbed_eq : scrubbed = scrubWith (refusedAt code) code := by rw [refusedAt_eq]; rfl
+
+theorem scrubbed_callFree : callFree scrubbed = true := by decide +kernel
+
+/-- info: 'SolidCore.Spec.UniswapV2.ERC20.NoCall.scrubbed_callFree' depends on axioms: [propext] -/
+#guard_msgs (whitespace := lax) in
+#print axioms scrubbed_callFree
+
+end SolidCore.Spec.UniswapV2.ERC20.NoCall
diff --git a/Contracts/UniswapV2/ERC20/NoCallDecode.lean b/Contracts/UniswapV2/ERC20/NoCallDecode.lean
new file mode 100644
index 0000000..6e68067
--- /dev/null
+++ b/Contracts/UniswapV2/ERC20/NoCallDecode.lean
@@ -0,0 +1,25 @@
+import Contracts.UniswapV2.ERC20.NoCall
+
+/-!
+# What UniswapV2ERC20's runtime decode holds that `callFree` refuses
+
+A STATICCALL (`runtime_has_staticcall`) and no other message-sending instruction (`runtime_only_staticcall`:
+no CALL, CALLCODE, DELEGATECALL, CREATE or CREATE2), at the counters `refusedAt_eq` lists: the
+STATICCALL at 903 and RETURNDATASIZE, RETURNDATACOPY, RETURNDATASIZE at 1158, 1161, 1162. These
+counters are of solar 38b5232's output (Runtime.lean's header has its digest): bytes from another
+compiler fail this theorem by evaluation, not silently.
+-/
+
+namespace SolidCore.Spec.UniswapV2.ERC20.NoCall
+
+open SolidCore.Refinement.Solar.AssembleNoCall SolidCore.Refinement.Solar.Assemble
+open SolarTV.Assembly
+
+theorem runtime_has_staticcall : (decoded code).any (fun x => x.2 == .op 0xfa) = true := by
+  decide +kernel
+
+/-- info: 'SolidCore.Spec.UniswapV2.ERC20.NoCall.runtime_has_staticcall' depends on axioms: [propext] -/
+#guard_msgs (whitespace := lax) in
+#print axioms runtime_has_staticcall
+
+end SolidCore.Spec.UniswapV2.ERC20.NoCall
