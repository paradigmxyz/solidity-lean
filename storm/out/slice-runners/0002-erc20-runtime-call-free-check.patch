--- a/lakefile.lean
+++ b/lakefile.lean
@@ -381,6 +381,15 @@ lean_lib ContractsUniswapV2ERC20Spec where
     .one `Contracts.UniswapV2.ERC20.Connect, .one `Contracts.UniswapV2.ERC20.SpecTreeKeccak,
