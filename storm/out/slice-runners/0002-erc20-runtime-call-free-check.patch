+
+namespace SolidCore.Spec.UniswapV2.ERC20.NoCall
+
+open SolidCore.Refinement.Solar.AssembleNoCall SolidCore.Refinement.Solar.Assemble
+open SolarTV.Assembly
+
+theorem runtime_not_noFaByte : noFaByte code = false := by decide +kernel
+
+/-- info: 'SolidCore.Spec.UniswapV2.ERC20.NoCall.runtime_not_noFaByte' depends on axioms: [propext, Classical.choice, Quot.sound] -/
+#guard_msgs (whitespace := lax) in
+#print axioms runtime_not_noFaByte
+
+end SolidCore.Spec.UniswapV2.ERC20.NoCall
diff --git a/Contracts/UniswapV2/ERC20/NoCallNeg.lean b/Contracts/UniswapV2/ERC20/NoCallNeg.lean
new file mode 100644
index 0000000..669940d
--- /dev/null
+++ b/Contracts/UniswapV2/ERC20/NoCallNeg.lean
@@ -0,0 +1,21 @@
+import Contracts.UniswapV2.ERC20.NoCallControl
+
+/-!
+# Negative control of the scrubbed bytes
+
+Scrubbing the three return-data reads but leaving permit's STATICCALL at 903 fails the call-free
+check: the STATICCALL alone is enough for the refusal.
+-/
+
+namespace SolidCore.Spec.UniswapV2.ERC20.NoCall
+
+open SolidCore.Refinement.Solar.AssembleNoCall
+
+theorem staticcall_kept_not_callFree : callFree (scrubWith [1158, 1161, 1162] code) = false := by
+  decide +kernel
+
+/-- info: 'SolidCore.Spec.UniswapV2.ERC20.NoCall.staticcall_kept_not_callFree' depends on axioms: [propext] -/
+#guard_msgs (whitespace := lax) in
+#print axioms staticcall_kept_not_callFree
+
+end SolidCore.Spec.UniswapV2.ERC20.NoCall
diff --git a/Contracts/UniswapV2/ERC20/NoCallOnly.lean b/Contracts/UniswapV2/ERC20/NoCallOnly.lean
new file mode 100644
index 0000000..6ff74e1
--- /dev/null
+++ b/Contracts/UniswapV2/ERC20/NoCallOnly.lean
@@ -0,0 +1,20 @@
+import Contracts.UniswapV2.ERC20.NoCall
+
+/-!
+# UniswapV2ERC20's runtime sends no message other than by STATICCALL
+-/
+
+namespace SolidCore.Spec.UniswapV2.ERC20.NoCall
+
+open SolidCore.Refinement.Solar.AssembleNoCall SolidCore.Refinement.Solar.Assemble
+open SolarTV.Assembly
+
+theorem runtime_only_staticcall :
+    (decoded code).all (fun x => !([0xf0, 0xf1, 0xf2, 0xf4, 0xf5].map SolarTV.Assembly.Instr.op).contains x.2) = true := by
+  decide +kernel
+
+/-- info: 'SolidCore.Spec.UniswapV2.ERC20.NoCall.runtime_only_staticcall' depends on axioms: [propext] -/
+#guard_msgs (whitespace := lax) in
+#print axioms runtime_only_staticcall
+
+end SolidCore.Spec.UniswapV2.ERC20.NoCall
