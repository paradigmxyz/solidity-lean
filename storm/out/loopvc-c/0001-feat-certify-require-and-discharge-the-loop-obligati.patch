+                        "edge": c.edge.name(),
+                        "class": match c.class {
+                            "body" | "exit" if kind.starts_with("precondition") => "call",
+                            class => class,
+                        },
+                        "merged": c.merged,
+                    })
+                });
                 true
             }
             Role::Split { parent } => {
@@ -918,15 +987,47 @@ fn unit(sess: &Session, dir: &Path, u: &Recorder, module: &str) -> R<serde_json:
     }
     let _ = writeln!(lean, "end {ns}");
     std::fs::write(&file, lean).map_err(|e| e.to_string())?;
+    // The loop heads, in source order, each with its edges: the obligations naming it as their
+    // cut are the ones on its edges.
+    let mut cps: Vec<&CutPoint> = u.cutpoints.iter().collect();
+    cps.sort_by_key(|c| (c.span.lo(), c.span.hi()));
+    cps.dedup_by_key(|c| (c.span.lo(), c.span.hi()));
+    let cutpoints: Vec<_> = cps
+        .iter()
+        .map(|c| {
+            let mut l = location(sess, c.span);
+            l["id"] = loop_id(sess, c.span).into();
+            l["invariants"] = c.invariants.clone().into();
+            l["decreases"] = c.decreases.clone().into();
+            l["inferred"] = c.inferred.clone().into();
+            l["measure"] = c.measure.clone().into();
+            l["back_edges"] = c.back_edges.into();
+            l["exits"] = c.exits.into();
+            l
+        })
+        .collect();
     Ok(serde_json::json!({
         "name": u.unit,
         "module": format!("{path}.lean"),
         "namespace": ns,
         "scripts": scripts,
         "obligations": obligations,
+        "cutpoints": cutpoints,
     }))
 }
 
+/// A loop head's name within its unit: `L<line>:<column>` of the loop statement.
+fn loop_id(sess: &Session, sp: Span) -> String {
+    let l = location(sess, sp);
+    format!("L{}:{}", l["line"], l["column"])
+}
+
+/// The outcome an obligation is about: `revert` for the kinds that say whether a call reverts,
+/// else `normal` (a call that returns). No obligation is about running out of gas.
+fn outcome(kind: &str) -> &'static str {
+    if kind.contains("revert") { "revert" } else { "normal" }
+}
+
 fn sexp_of(text: &str) -> R<Sexp> {
     sexp::parse(text).next().ok_or("empty term")?.map_err(|e| e.to_string())
 }
