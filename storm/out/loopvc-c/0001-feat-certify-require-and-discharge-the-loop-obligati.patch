+/// An edge of a loop's cutpoint: entering the loop at its head, going around the body back to it,
+/// or leaving it.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Edge {
+    Entry,
+    Back,
+    Exit,
+}
+
+impl Edge {
+    fn name(self) -> &'static str {
+        match self {
+            Self::Entry => "entry",
+            Self::Back => "back",
+            Self::Exit => "exit",
+        }
+    }
+}
+
+/// Where an obligation sits in its function's cutpoint graph: the loop head (by the loop
+/// statement's span) whose edge the checked path is on, what the obligation is for on that edge
+/// (`initiation` of an invariant on entry; `preservation` of an invariant, `termination` of a
+/// measure or `body`, met in the body, on the back edge; `exit`, met past the exit, such as the
+/// postconditions; `call`, a callee's precondition met on any of them), and whether a `return`
+/// inside the loop's body joins the exit path (`merged`), so that the exit is not the only way
+/// the path reaches its obligation.
+#[derive(Clone, Debug)]
+pub(crate) struct Cut {
+    pub span: Span,
+    pub edge: Edge,
+    pub class: &'static str,
+    pub merged: bool,
+}
+
+/// A loop head the encoder cut at, with the clauses it was cut with and its edges.
+#[derive(Clone, Debug)]
+pub(crate) struct CutPoint {
+    pub span: Span,
+    pub invariants: Vec<String>,
+    pub decreases: Vec<String>,
+    /// Inferred invariants and measure kept by the real run (none without a solver).
+    pub inferred: Vec<String>,
+    pub measure: Option<String>,
+    /// Paths back to the head: the end of the body and each `continue`.
+    pub back_edges: usize,
+    /// Paths out: the guard failing and each `break`.
+    pub exits: usize,
+}
+
