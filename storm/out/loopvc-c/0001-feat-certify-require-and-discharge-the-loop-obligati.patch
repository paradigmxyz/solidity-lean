index 29498905e..620459ba7 100755
--- a/tools/certify/test.sh
+++ b/tools/certify/test.sh
@@ -591,6 +591,179 @@ else
     echo "skip spec: SOLAR_VERIFY is not set"
 fi
 
+# The loop obligations solidity-lean requires (tools/certify/loopvc.py, step 3b and 6 of the driver)
+# on solar-verify's real export of a loop with two invariants and a decreases clause: the derived
+# registry checks, and a loop obligation dropped, added, no longer required or changed, a stale
+# registry, another bytecode, and a discharge that leaves one inconclusive each fail. Then the
+# driver itself: with a registry in the checkout it binds the export before any Lean runs, and a
+# solar-verify whose export lacks one loop obligation fails the run.
+lv_verify="${SOLAR_VERIFY:-}"
+if [[ -z "$lv_verify" ]]; then
+    (cd "$root" && cargo build --locked -p solar-verify --bin solar-verify 2>&1 | tail -n 1)
+    lv_verify="${CARGO_TARGET_DIR:-$root/target}/debug/solar-verify"
+fi
+lv="$tmp/loopvc"
+mkdir -p "$lv"
+loop_source() { # loop_source FILE BODY_EXTRA DECREASES: the bump loop, with an edit
+    cat > "$1" <<EOF
+contract Loops {
+    uint256 public count;
+
+    /// @custom:ensures count == old(count) + n
+    function bump(uint256 n) external {
+        /// @custom:invariant i <= n
+        /// @custom:invariant count == old(count) + i
+        $3
+        for (uint256 i = 0; i < n; i++) {
+            $2
+            count++;
+        }
+    }
+}
+EOF
+}
+loop_source "$lv/Loops.sol" "" "/// @custom:decreases n - i"
+loop_source "$lv/NoRank.sol" "" ""
+loop_source "$lv/Break.sol" "if (count > 7) break;" "/// @custom:decreases n - i"
+loop_source "$lv/Ret.sol" "if (count > 7) return;" "/// @custom:decreases n - i"
+for f in Loops NoRank Break Ret; do
+    (cd "$lv" && "$lv_verify" --dry-run --emit-lean "out-$f" "$f.sol" > "$f.log" 2>&1) || true
+done
+lvb=6080604052
+lvcheck() { python3 "$root/tools/certify/loopvc.py" check "$@"; }
+# expect_lv CASE PATTERN CMD...: CMD must exit non-zero with PATTERN in its output.
+expect_lv() {
+    local case=$1 pattern=$2 status=0
+    shift 2
+    "$@" > "$tmp/out" 2>&1 || status=$?
+    if [[ $status -ne 0 ]] && grep -Eq -- "$pattern" "$tmp/out"; then
+        echo "ok   $case: $(grep -Eo -- "$pattern" "$tmp/out" | head -1)"
+    else
+        echo "FAIL $case (exit $status, expected /$pattern/):"; sed 's/^/  /' "$tmp/out" | tail -10
+        failures=$((failures + 1))
+    fi
+}
+# lv_edit NAME JQ: a copy of the export whose manifest is JQ of the original.
+lv_edit() {
+    rm -rf "$lv/$1"; cp -r "$lv/out-Loops" "$lv/$1"
+    jq "$2" "$lv/out-Loops/manifest.json" > "$lv/$1/manifest.json"
+}
+if python3 "$root/tools/certify/loopvc.py" derive "$lv/out-Loops" --unit Loops.bump --bytecode "$lvb" > "$lv/reg.json" 2> "$tmp/out" &&
+    lvcheck "$lv/reg.json" "$lv/out-Loops" --bytecode "$lvb" > "$tmp/out" 2>&1 &&
+    grep -q '6 required loop obligations at L[0-9]*:[0-9]* (initiation 2, preservation 2, termination 1, exit 1)' "$tmp/out"; then
+    echo "ok   loopvc-registry: $(cat "$tmp/out")"
+else
+    echo "FAIL loopvc-registry:"; sed 's/^/  /' "$tmp/out" | tail -10; failures=$((failures + 1))
+fi
+sel='.units[] | select(.name == "Loops.bump") | .obligations[] | select(.cut != null)'
+lv_edit drop-preservation "del($sel | select(.cut.class == \"preservation\" and .spec.text == \"i <= n\"))"
+expect_lv loopvc-dropped-preservation "invariant .i <= n. has 0 preservation obligations on the back edge" \
+    lvcheck "$lv/reg.json" "$lv/drop-preservation" --bytecode "$lvb"
+lv_edit drop-exit "del($sel | select(.cut.class == \"exit\"))"
+expect_lv loopvc-dropped-exit "no obligation on the exit edge with a normal outcome" \
+    lvcheck "$lv/reg.json" "$lv/drop-exit" --bytecode "$lvb"
+lv_edit drop-termination "del($sel | select(.cut.class == \"termination\"))"
+expect_lv loopvc-dropped-termination "0 termination obligations on the back edge, not one" \
+    lvcheck "$lv/reg.json" "$lv/drop-termination" --bytecode "$lvb"
+lv_edit not-required "($sel | select(.cut.class == \"termination\") | .required) = false"
+expect_lv loopvc-not-required "is a loop obligation the export does not require" \
+    lvcheck "$lv/reg.json" "$lv/not-required" --bytecode "$lvb"
+lv_edit changed-query "($sel | select(.cut.class == \"exit\") | .smt_sha256) = \"$(printf '0%.0s' {1..64})\""
+expect_lv loopvc-changed-query "differs from the registry in smt_sha256" \
+    lvcheck "$lv/reg.json" "$lv/changed-query" --bytecode "$lvb"
+lv_edit changed-module "."
+echo "-- edited" >> "$lv/changed-module/$(jq -r .module "$lv/reg.json")"
+expect_lv loopvc-changed-module "the registry's module_sha256 is not this run's" \
+    lvcheck "$lv/reg.json" "$lv/changed-module" --bytecode "$lvb"
+jq 'del(.required[] | select(.class == "preservation" and .spec == "i <= n"))' "$lv/reg.json" > "$lv/reg-short.json"
+expect_lv loopvc-registry-lacks-one "which the registry does not require" \
+    lvcheck "$lv/reg-short.json" "$lv/out-Loops" --bytecode "$lvb"
+expect_lv loopvc-other-bytecode "is bound to the bytecode with SHA-256 [0-9a-f]{64}, not this run's" \
+    lvcheck "$lv/reg.json" "$lv/out-Loops" --bytecode 6080
+echo '{"bytecode": "6080", "statuses": {"strongest": false}}' > "$lv/record.json"
+expect_lv loopvc-record-other-bytecode "names another bytecode than this run's" \
+    lvcheck "$lv/reg.json" "$lv/out-Loops" --bytecode "$lvb" --record "$lv/record.json"
+expect_lv loopvc-no-ranking "no decreases clause or inferred measure: termination has no ranking" \
+    python3 "$root/tools/certify/loopvc.py" derive "$lv/out-NoRank" --unit Loops.bump --bytecode "$lvb"
+expect_lv loopvc-break "2 exits: one exit obligation would cover several" \
+    python3 "$root/tools/certify/loopvc.py" derive "$lv/out-Break" --unit Loops.bump --bytecode "$lvb"
+expect_lv loopvc-return-in-body "a return in the body joins the exit path" \
+    python3 "$root/tools/certify/loopvc.py" derive "$lv/out-Ret" --unit Loops.bump --bytecode "$lvb"
+# A discharge of the export (as Verify/Discharge/discharge.sh writes it): every loop obligation
+# proved with clean axioms passes; one failed, timed out, missing, with another axiom, vacuous,
+# or of another export is inconclusive.
+lv_discharge() { # lv_discharge DIR [AWK]: summary, results and inputs, every row proved, then AWK
+    local d="$lv/$1/discharge" id
+    rm -rf "$lv/$1"; cp -r "$lv/out-Loops" "$lv/$1"; mkdir -p "$d"
+    (cd "$lv/$1" && sha256sum manifest.json "$(jq -r .module "$lv/reg.json")") > "$d/inputs.sha256"
+    printf 'id\trole\tanswer\tstatus\tbackends\tvacuous\n' > "$d/summary.tsv"
+    printf 'id\trole\tanswer\tbackend\tstatus\tseconds\tpeak_mb\taxioms\n' > "$d/results.tsv"
+    for id in $(jq -r '.required[].id' "$lv/reg.json"); do
+        printf '%s\tobligation\tnot-run\tproved\tsmt\tno\n' "$id" >> "$d/summary.tsv"
+        printf '%s\tobligation\tnot-run\tsmt\tproved\t2.0\t1800\tpropext Classical.choice Quot.sound\n' "$id" >> "$d/results.tsv"
+    done
+    if [[ -n "${2:-}" ]]; then
+        for f in summary results; do awk -F'\t' -v OFS='\t' "$2" "$d/$f.tsv" > "$d/$f.tmp" && mv "$d/$f.tmp" "$d/$f.tsv"; done
+    fi
+}
+first="$(jq -r '.required[] | select(.class == "termination") | .id' "$lv/reg.json")"
+lv_discharge dis-ok
+if lvcheck "$lv/reg.json" "$lv/dis-ok" --bytecode "$lvb" --summary "$lv/dis-ok/discharge" --receipt "$lv/receipt.json" > "$tmp/out" 2>&1 &&
+    grep -q 'all 6 proved in the kernel' "$tmp/out" && [[ "$(jq '.discharged | length' "$lv/receipt.json")" == 6 ]]; then
+    echo "ok   loopvc-discharged: $(cat "$tmp/out")"
+else
+    echo "FAIL loopvc-discharged:"; sed 's/^/  /' "$tmp/out" | tail -10; failures=$((failures + 1))
+fi
+lv_discharge dis-timeout "\$1 == \"$first\" && FILENAME ~ /summary/ { \$4 = \"failed: timeout after 300s\"; \$5 = \"-\" } { print }"
+expect_lv loopvc-discharge-timeout "inconclusive: loop obligation .* is not proved: failed: timeout after 300s" \
+    lvcheck "$lv/reg.json" "$lv/dis-timeout" --bytecode "$lvb" --summary "$lv/dis-timeout/discharge"
+lv_discharge dis-missing "\$1 != \"$first\" { print }"
+expect_lv loopvc-discharge-missing "inconclusive: loop obligation .* has no row in the discharge summary" \
+    lvcheck "$lv/reg.json" "$lv/dis-missing" --bytecode "$lvb" --summary "$lv/dis-missing/discharge"
+lv_discharge dis-axiom "\$1 == \"$first\" && FILENAME ~ /results/ { \$8 = \$8 \" sorryAx\" } { print }"
+expect_lv loopvc-discharge-axiom "uses axioms \['sorryAx'\]" \
+    lvcheck "$lv/reg.json" "$lv/dis-axiom" --bytecode "$lvb" --summary "$lv/dis-axiom/discharge"
+lv_discharge dis-vacuous "\$1 == \"$first\" && FILENAME ~ /summary/ { \$6 = \"yes\" } { print }"
+expect_lv loopvc-discharge-vacuous "holds vacuously" \
+    lvcheck "$lv/reg.json" "$lv/dis-vacuous" --bytecode "$lvb" --summary "$lv/dis-vacuous/discharge"
+lv_discharge dis-other-export
+echo '{}' > "$lv/dis-other-export/discharge/inputs.sha256"
+expect_lv loopvc-discharge-other-export "inputs.sha256 is not of this export's manifest.json" \
+    lvcheck "$lv/reg.json" "$lv/dis-other-export" --bytecode "$lvb" --summary "$lv/dis-other-export/discharge"
+
+# The driver with a registry in the checkout: the export binds before any Lean runs (the scratch
+# package then fails later, at its proofs), and a solar-verify whose export lacks one loop
+# obligation stops the run at step 3b.
+mkdir -p "$lean/Examples/loops"
+cp "$lv/Loops.sol" "$lean/Examples/loops/loops.sol"
+lvjson="$("$solar" "$lean/Examples/loops/loops.sol" -Ogas --evm-version osaka --emit=bin-runtime)"
+lvplain="$(python3 -c 'import json,sys; print(next(iter(json.loads(sys.argv[1])["contracts"].values()))["bin-runtime"])' "$lvjson")"
+(cd "$lean" && "$lv_verify" --dry-run --emit-lean "$lv/driver-export" Examples/loops/loops.sol > /dev/null 2>&1) || true
+python3 "$root/tools/certify/loopvc.py" derive "$lv/driver-export" --unit Loops.bump --bytecode "$lvplain" > "$lean/Examples/loops/loopvc.json"
+cat > "$lv/drop-verify" <<EOF
+#!/usr/bin/env bash
+# solar-verify, then its --emit-lean export without the first preservation obligation of the loop.
+status=0
+"$lv_verify" "\$@" || status=\$?
+out=\$3
+jq 'del(.units[].obligations[] | select(.cut != null and .cut.class == "preservation") | select(.spec.text == "i <= n"))' \
+    "\$out/manifest.json" > "\$out/manifest.edited" && mv "\$out/manifest.edited" "\$out/manifest.json"
+exit \$status
+EOF
+chmod +x "$lv/drop-verify"
+status=0
+env -u CI -u GITHUB_ACTIONS SOLAR="$solar" SOLAR_VERIFY="$lv_verify" "${allow[@]}" CERTIFY_ALLOW_FOREIGN_SOLAR=1 \
+    "$root/scripts/certify" "$lean/Examples/loops/loops.sol" > "$tmp/out" 2>&1 || status=$?
+if grep -q '^loopvc: Loops.bump: 6 required loop obligations at .*: bound to the export and the bytecode' "$tmp/out" &&
+    ! grep -q '^CERTIFIED' "$tmp/out"; then
+    echo "ok   driver-loopvc-bound: $(grep '^loopvc:' "$tmp/out")"
+else
+    echo "FAIL driver-loopvc-bound (exit $status):"; sed 's/^/  /' "$tmp/out" | tail -20; failures=$((failures + 1))
+fi
+expect driver-loopvc-dropped "the loop obligations of Loops are not the ones Examples/loops/loopvc.json requires" \
+    "${allow[@]}" CERTIFY_ALLOW_FOREIGN_SOLAR=1 SOLAR_VERIFY="$lv/drop-verify" -- "$lean/Examples/loops/loops.sol"
+rm -rf "$lean/Examples/loops"
+
 if [[ $failures -ne 0 ]]; then
     echo "certify driver tests: $failures failed" >&2
     exit 1
