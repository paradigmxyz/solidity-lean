diff --git a/crates/verify/tests/cases.rs b/crates/verify/tests/cases.rs
index 8039414e5..6c1f968ef 100644
--- a/crates/verify/tests/cases.rs
+++ b/crates/verify/tests/cases.rs
@@ -604,6 +604,93 @@ fn emit_lean_examples() {
     let _ = std::fs::remove_dir_all(&dir);
 }
 
+/// `--emit-lean` names each loop head the encoder cut at and, for every obligation past one, the
+/// cutpoint edge it is on: the invariants' initiation on the entry edge, their preservation and
+/// the measure's decrease on the back edge, and the postcondition on the exit edge; obligations
+/// met before any loop name none.
+#[test]
+fn emit_lean_cutpoints() {
+    let dir = scratch("emit-lean-cutpoints");
+    std::fs::create_dir_all(&dir).unwrap();
+    let src = dir.join("Loops.sol");
+    std::fs::write(
+        &src,
+        "contract Loops {
+    uint256 public count;
+
+    /// @custom:ensures count == old(count) + 1
+    function inc() external { count += 1; }
+
+    /// @custom:ensures count == old(count) + n
+    function bump(uint256 n) external {
+        /// @custom:invariant i <= n
+        /// @custom:invariant count == old(count) + i
+        /// @custom:decreases n - i
+        for (uint256 i = 0; i < n; i++) {
+            count++;
+        }
+    }
+}
+",
+    )
+    .unwrap();
+    let out = dir.join("out");
+    // Sources are named relative to the run's directory: run it in the scratch directory.
+    let run = Command::new(env!("CARGO_BIN_EXE_solar-verify"))
+        .args(["--dry-run", "--emit-lean", "out", "Loops.sol"])
+        .current_dir(&dir)
+        .env("NO_COLOR", "1")
+        .output()
+        .expect("run solar-verify");
+    let stderr = String::from_utf8_lossy(&run.stderr);
+    assert!(!stderr.contains("--emit-lean"), "{stderr}");
+    let manifest = read_manifest(&out);
+    let unit = |name: &str| {
+        manifest["units"].as_array().unwrap().iter().find(|u| u["name"] == name).unwrap().clone()
+    };
+    let bump = unit("Loops.bump");
+    let cps = bump["cutpoints"].as_array().unwrap();
+    assert_eq!(cps.len(), 1, "{cps:?}");
+    let cp = &cps[0];
+    assert_eq!(cp["id"], format!("L{}:{}", cp["line"], cp["column"]));
+    assert_eq!(cp["invariants"], serde_json::json!(["i <= n", "count == old(count) + i"]));
+    assert_eq!(cp["decreases"], serde_json::json!(["n - i"]));
+    assert_eq!((cp["back_edges"].as_u64(), cp["exits"].as_u64()), (Some(1), Some(1)));
+    let edges: Vec<_> = bump["obligations"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .filter(|o| o["role"] == "obligation")
+        .map(|o| {
+            assert_eq!(o["cut"]["loop"], cp["id"], "{o}");
+            assert_eq!(o["cut"]["merged"], false, "{o}");
+            assert_eq!(o["outcome"], "normal", "{o}");
+            (
+                o["cut"]["class"].as_str().unwrap(),
+                o["cut"]["edge"].as_str().unwrap(),
+                o["spec"]["text"].as_str().unwrap(),
+            )
+        })
+        .collect();
+    assert_eq!(
+        edges,
+        [
+            ("initiation", "entry", "i <= n"),
+            ("initiation", "entry", "count == old(count) + i"),
+            ("preservation", "back", "i <= n"),
+            ("preservation", "back", "count == old(count) + i"),
+            ("termination", "back", "n - i"),
+            ("exit", "exit", "count == old(count) + n"),
+        ]
+    );
+    let inc = unit("Loops.inc");
+    assert_eq!(inc["cutpoints"], serde_json::json!([]));
+    for o in inc["obligations"].as_array().unwrap().iter().filter(|o| o["role"] == "obligation") {
+        assert!(o["cut"].is_null(), "{o}");
+    }
+    let _ = std::fs::remove_dir_all(&dir);
+}
+
 fn read_manifest(dir: &std::path::Path) -> serde_json::Value {
     serde_json::from_str(&std::fs::read_to_string(dir.join("manifest.json")).unwrap()).unwrap()
 }
