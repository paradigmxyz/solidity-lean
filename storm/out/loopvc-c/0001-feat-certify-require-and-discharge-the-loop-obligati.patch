+++ b/tools/certify/loopvc.py
@@ -0,0 +1,327 @@
+#!/usr/bin/env python3
+"""The required loop obligations of a certified contract: derived from solar-verify's export, pinned
+in solidity-lean as Certified/NAME/loopvc.json, and checked in every run.
+
+    loopvc.py derive EXPORT --unit UNIT --bytecode HEX
+        From solar-verify's `--emit-lean` export EXPORT (EXPORT/manifest.json), the registry of
+        UNIT's loop obligations, as JSON on stdout: every loop head (cutpoint) the encoder cut the
+        function at and, per cutpoint edge, the obligations on it, each with its exported query's
+        hash. HEX is the runtime bytecode the registry is bound to.
+    loopvc.py check REGISTRY EXPORT --bytecode HEX [--record RECORD]
+                    [--summary DIR/discharge] [--receipt OUT.json]
+        REGISTRY (a committed loopvc.json) must be exactly what derive gives for this run's export
+        and bytecode: a loop obligation missing from the export, one the registry does not list,
+        one no longer required, or one whose query changed fails. RECORD (the committed
+        record.json) must name the same bytecode. With --summary (Verify/Discharge/discharge.sh's
+        output for EXPORT), every registry obligation must be proved in the kernel by a backend,
+        with no axiom but propext, Classical.choice and Quot.sound, on exactly this export's
+        inputs, and must not hold vacuously; anything else (failed, timeout, error, skipped,
+        missing, another axiom) is inconclusive and fails. --receipt writes what was checked.
+
+What derive requires of each cutpoint, from its own clauses and edges rather than from the labels
+alone: one initiation obligation per invariant on the entry edge; per back edge one preservation
+obligation per invariant and one termination obligation per decreases clause or inferred measure (a
+loop without one has no ranking, and fails); at least one obligation on the exit edge with a normal
+outcome; one back edge and one exit (a continue or break would put several edges under one merged
+obligation); no return in the body joining the exit path. Outcomes stay apart: normal (the
+obligations past the exit), revert (a kind about whether the call reverts) and out of gas (none: an
+inert failure). Exit 0 checked, 1 not; errors name what is wrong.
+"""
+import csv
+import hashlib
+import json
+import os
+import sys
+
+FORMAT = "certify-loopvc"
+VERSION = 1
+ALLOWED = {"propext", "Classical.choice", "Quot.sound"}
+CLASSES = ("initiation", "preservation", "termination", "body", "call", "exit")
+
+
+def fail(msg):
+    print(f"certify: error: loopvc: {msg}", file=sys.stderr)
+    sys.exit(1)
+
+
+def load(path, what):
+    try:
+        with open(path, "rb") as f:
+            return json.loads(f.read().decode("utf-8"))
+    except OSError as e:
+        fail(f"cannot read {what} {path}: {e}")
+    except (UnicodeDecodeError, ValueError) as e:
+        fail(f"{what} {path} is not JSON: {e}")
+
+
+def hexbytes(text, what):
+    h = text.strip()
+    if not h or len(h) % 2 or any(c not in "0123456789abcdef" for c in h):
+        fail(f"{what} is not lowercase hex bytes")
+    return h
+
+
+def sha_file(path, what):
+    try:
+        with open(path, "rb") as f:
+            return hashlib.sha256(f.read()).hexdigest()
+    except OSError as e:
+        fail(f"cannot read {what} {path}: {e}")
+
+
+def derive(export, unit_name, bytecode):
+    manifest = load(os.path.join(export, "manifest.json"), "the export's manifest")
+    if manifest.get("format") != "solar-verify-lean" or manifest.get("version") != 2:
+        fail("the export is not a solar-verify-lean version 2 manifest")
+    if manifest.get("errors"):
+        fail(f"the export has errors: {manifest['errors']}")
+    units = [u for u in manifest.get("units", []) if u.get("name") == unit_name]
+    if len(units) != 1:
+        fail(f"the export has {len(units)} units named {unit_name}, not one")
+    unit = units[0]
+    if not unit.get("module"):
+        fail(f"{unit_name} was not exported ({unit.get('status')}: {unit.get('error')})")
+    mod = unit["module"]
+    if mod.startswith("/") or ".." in mod.split("/") or not mod.endswith(".lean"):
+        fail(f"{unit_name}'s module {mod!r} is not named relative to the export")
+    if "cutpoints" not in unit:
+        fail(f"{unit_name} lists no cutpoints: the exporter predates loop cutpoints")
+    cps = unit["cutpoints"]
+    if not cps:
+        fail(f"{unit_name} has no loop: nothing to register")
+    ids = [c["id"] for c in cps]
+    if len(set(ids)) != len(ids):
+        fail(f"{unit_name} names a cutpoint twice: {ids}")
+    obs = unit.get("obligations", [])
+    seen = [o["id"] for o in obs]
+    if len(set(seen)) != len(seen):
+        fail(f"{unit_name} lists an obligation id twice")
+    required = []
+    for o in obs:
+        if o.get("role") != "obligation" or o.get("cut") is None:
+            continue
+        cut = o["cut"]
+        if cut.get("loop") not in ids:
+            fail(f"{o['id']} names cutpoint {cut.get('loop')}, which {unit_name} does not list")
+        if cut.get("class") not in CLASSES or cut.get("edge") not in ("entry", "back", "exit"):
+            fail(f"{o['id']} has an unknown cut {cut}")
+        if o.get("required") is not True:
+            fail(f"{o['id']} is a loop obligation the export does not require")
+        if o.get("outcome") not in ("normal", "revert"):
+            fail(f"{o['id']} has an unknown outcome {o.get('outcome')!r}")
+        required.append({
+            "id": o["id"],
+            "lean": o["lean"],
+            "loop": cut["loop"],
+            "edge": cut["edge"],
+            "class": cut["class"],
+            "outcome": o["outcome"],
+            "merged": bool(cut.get("merged")),
+            "kind": o.get("kind"),
+            "spec": (o.get("spec") or {}).get("text"),
+            "smt_sha256": o["smt_sha256"],
+        })
+    for c in cps:
+        mine = [r for r in required if r["loop"] == c["id"]]
+        where = f"{unit_name} cutpoint {c['id']}"
+
+        def count(edge, cls, spec=None):
+            return sum(1 for r in mine if r["edge"] == edge and r["class"] == cls
+                       and (spec is None or r["spec"] == spec))
+
+        invs = c.get("invariants") or []
+        inferred = c.get("inferred") or []
+        if c.get("back_edges") != 1:
+            fail(f"{where}: {c.get('back_edges')} back edges: one preservation obligation would cover several")
+        if c.get("exits") != 1:
+            fail(f"{where}: {c.get('exits')} exits: one exit obligation would cover several")
+        for inv in invs:
+            if count("entry", "initiation", inv) != 1:
+                fail(f"{where}: invariant `{inv}` has {count('entry', 'initiation', inv)} initiation "
+                     "obligations on the entry edge, not one")
+            if count("back", "preservation", inv) != 1:
+                fail(f"{where}: invariant `{inv}` has {count('back', 'preservation', inv)} preservation "
+                     "obligations on the back edge, not one")
+        if count("entry", "initiation") != len(invs) + len(inferred):
+            fail(f"{where}: {count('entry', 'initiation')} initiation obligations for "
+                 f"{len(invs)} invariants and {len(inferred)} inferred ones")
+        if count("back", "preservation") != len(invs) + len(inferred):
+            fail(f"{where}: {count('back', 'preservation')} preservation obligations for "
+                 f"{len(invs)} invariants and {len(inferred)} inferred ones")
+        decs = c.get("decreases") or []
+        measures = len(decs) + (1 if c.get("measure") else 0)
+        if measures == 0:
+            fail(f"{where}: no decreases clause or inferred measure: termination has no ranking")
+        for d in decs:
+            if count("back", "termination", d) != 1:
+                fail(f"{where}: decreases `{d}` has {count('back', 'termination', d)} termination "
+                     "obligations on the back edge, not one")
+        if count("back", "termination") != measures:
+            fail(f"{where}: {count('back', 'termination')} termination obligations for {measures} measures")
+        if not any(r["edge"] == "exit" and r["outcome"] == "normal" for r in mine):
+            fail(f"{where}: no obligation on the exit edge with a normal outcome")
+        merged = [r["id"] for r in mine if r["merged"]]
+        if merged:
+            fail(f"{where}: a return in the body joins the exit path of {', '.join(merged)}")
+    return {
+        "format": FORMAT,
+        "version": VERSION,
+        "unit": unit_name,
+        "module": unit["module"],
+        # The exported Lean module of the unit, byte for byte: every obligation's statement.
+        "module_sha256": sha_file(os.path.join(export, unit["module"]), "the exported module"),
+        "sources": [{"path": s["path"], "sha256": s["sha256"]} for s in manifest.get("sources") or []],
+        "lean": {k: manifest.get("lean", {}).get(k) for k in ("smt_sha256", "vc_sha256")},
+        "bytecode_sha256": hashlib.sha256(bytes.fromhex(bytecode)).hexdigest(),
+        "cutpoints": [
+            {k: c.get(k) for k in ("id", "line", "column", "invariants", "decreases", "inferred",
+                                   "measure", "back_edges", "exits")}
+            for c in cps
+        ],
+        "outcomes": {
+            "normal": [r["id"] for r in required if r["outcome"] == "normal"],
+            "revert": [r["id"] for r in required if r["outcome"] == "revert"],
+            "out_of_gas": [],
+        },
+        "required": required,
+    }
+
+
+def diff(want, have):
+    """The differences between the committed registry and the derived one, entry by entry."""
+    out = []
+    w = {r.get("id"): r for r in want.get("required") or []}
+    h = {r["id"]: r for r in have["required"]}
+    for i, r in w.items():
+        if i not in h:
+            out.append(f"required loop obligation {i} ({r.get('class')} on the {r.get('edge')} edge of "
+                       f"{r.get('loop')}) is missing from this run's export")
+        elif r != h[i]:
+            keys = sorted(k for k in set(r) | set(h[i]) if r.get(k) != h[i].get(k))
+            out.append(f"loop obligation {i} differs from the registry in {', '.join(keys)}")
+    for i, r in h.items():
+        if i not in w:
+            out.append(f"the export has loop obligation {i} ({r['class']} on the {r['edge']} edge of "
+                       f"{r['loop']}), which the registry does not require")
+    for k in sorted(set(want) | set(have)):
+        if k != "required" and want.get(k) != have.get(k):
+            out.append(f"the registry's {k} is not this run's: {json.dumps(want.get(k))[:160]} "
+                       f"vs {json.dumps(have.get(k))[:160]}")
+    return out
+
+
+def tsv(path, what):
+    try:
+        with open(path, newline="") as f:
+            return list(csv.DictReader(f, delimiter="\t"))
+    except OSError as e:
+        fail(f"cannot read {what} {path}: {e}")
+
+
+def check_discharge(reg, export, out):
+    summary = {}
+    for row in tsv(os.path.join(out, "summary.tsv"), "the discharge summary"):
+        if row.get("id") in summary:
+            fail(f"the discharge summary lists {row.get('id')} twice")
+        summary[row.get("id")] = row
+    results = tsv(os.path.join(out, "results.tsv"), "the discharge results")
+    # The discharge ran on exactly this export: its inputs record the manifest's and module's hashes.
+    try:
+        with open(os.path.join(out, "inputs.sha256")) as f:
+            inputs = f.read().split("\n")
+    except OSError as e:
+        fail(f"the discharge has no record of its inputs: {e}")
+    for name in ("manifest.json", reg["module"]):
+        if f"{sha_file(os.path.join(export, name), 'the export')}  {name}" not in inputs:
+            fail(f"the discharge's inputs.sha256 is not of this export's {name}")
+    proved = []
+    for r in reg["required"]:
+        i = r["id"]
+        row = summary.get(i)
+        if row is None:
+            fail(f"inconclusive: loop obligation {i} has no row in the discharge summary")
+        if row.get("status") != "proved" or row.get("backends") in (None, "", "-"):
+            fail(f"inconclusive: loop obligation {i} ({r['class']}, {r['edge']} edge) is not proved: "
+                 f"{row.get('status')}")
+        backends = row["backends"].split(",")
+        rows = [x for x in results if x.get("id") == i and x.get("status") == "proved" and x.get("backend") in backends]
+        if len(rows) != len(backends):
+            fail(f"inconclusive: loop obligation {i}'s proved backends {backends} have {len(rows)} proved rows")
+        for x in rows:
+            axioms = set((x.get("axioms") or "").split())
+            if not axioms or not axioms <= ALLOWED:
+                fail(f"loop obligation {i}'s proof by {x['backend']} uses axioms "
+                     f"{sorted(axioms - ALLOWED) or 'none reported'}")
+        if row.get("vacuous") == "yes":
+            fail(f"loop obligation {i} holds vacuously: its hypotheses are contradictory")
+        proved.append({"id": i, "class": r["class"], "edge": r["edge"], "loop": r["loop"],
+                       "backends": backends, "axioms": sorted(set(rows[0]["axioms"].split())),
+                       "vacuous": row.get("vacuous")})
+    return proved
+
+
+def main():
+    a = sys.argv[1:]
+    if not a or a[0] not in ("derive", "check"):
+        fail("usage: loopvc.py derive EXPORT --unit UNIT --bytecode HEX | check REGISTRY EXPORT --bytecode HEX ...")
+    cmd, opts, pos, i = a[0], {}, [], 1
+    while i < len(a):
+        if a[i].startswith("--"):
+            if i + 1 >= len(a):
+                fail(f"{a[i]} needs a value")
+            opts[a[i]] = a[i + 1]
+            i += 2
+        else:
+            pos.append(a[i])
+            i += 1
+    if "--bytecode" not in opts:
+        fail("--bytecode is required")
+    bytecode = hexbytes(opts["--bytecode"], "--bytecode")
+    if cmd == "derive":
+        if len(pos) != 1 or "--unit" not in opts:
+            fail("usage: loopvc.py derive EXPORT --unit UNIT --bytecode HEX")
+        json.dump(derive(pos[0], opts["--unit"], bytecode), sys.stdout, indent=2, ensure_ascii=False)
+        sys.stdout.write("\n")
+        return
+    if len(pos) != 2:
+        fail("usage: loopvc.py check REGISTRY EXPORT --bytecode HEX [--record R] [--summary D] [--receipt OUT]")
+    registry, export = pos
+    reg = load(registry, "the loop registry")
+    if not isinstance(reg, dict) or reg.get("format") != FORMAT or reg.get("version") != VERSION:
+        fail(f"{registry} is not a {FORMAT} version {VERSION} registry")
+    if not reg.get("required"):
+        fail(f"{registry} requires no loop obligation")
+    if reg.get("bytecode_sha256") != hashlib.sha256(bytes.fromhex(bytecode)).hexdigest():
+        fail(f"{registry} is bound to the bytecode with SHA-256 {reg.get('bytecode_sha256')}, not this run's")
+    if "--record" in opts:
+        rec = load(opts["--record"], "the committed record")
+        if not isinstance(rec, dict) or rec.get("bytecode") != bytecode:
+            fail(f"{opts['--record']} names another bytecode than this run's")
+    have = derive(export, reg.get("unit"), bytecode)
+    problems = diff(reg, have)
+    if problems:
+        fail("the export does not match the registry:\n  " + "\n  ".join(problems))
+    receipt = {
+        "registry_sha256": sha_file(registry, "the loop registry"),
+        "unit": reg["unit"],
+        "bytecode_sha256": reg["bytecode_sha256"],
+        "cutpoints": [c["id"] for c in reg["cutpoints"]],
+        "required": len(reg["required"]),
+        "by_class": {k: sum(1 for r in reg["required"] if r["class"] == k) for k in CLASSES},
+        "outcomes": {k: len(v) for k, v in reg["outcomes"].items()},
+        "discharged": None,
+    }
+    if "--summary" in opts:
+        receipt["discharged"] = check_discharge(reg, export, opts["--summary"])
+    if "--receipt" in opts:
+        with open(opts["--receipt"], "w") as f:
+            json.dump(receipt, f, indent=2, ensure_ascii=False)
+            f.write("\n")
+    edges = ", ".join(f"{k} {v}" for k, v in receipt["by_class"].items() if v)
+    state = (f"all {len(receipt['discharged'])} proved in the kernel" if receipt["discharged"] is not None
+             else "bound to the export and the bytecode")
+    print(f"loopvc: {reg['unit']}: {receipt['required']} required loop obligations at "
+          f"{', '.join(receipt['cutpoints'])} ({edges}): {state}")
+
+
+main()
diff --git a/tools/certify/solidity-lean.rev b/tools/certify/solidity-lean.rev
index 60e8258e2..803655d8c 100644
--- a/tools/certify/solidity-lean.rev
