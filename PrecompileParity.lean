  let bad := parityCases.filter (fun (c : String × Bool) => !c.2)
  if bad.isEmpty then
    IO.println s!"precompile parity: OK ({parityCases.length} cases)"
    return 0
  else
    IO.eprintln s!"precompile parity: MISMATCH {bad.map (fun (c : String × Bool) => c.1)}"
    return 1
