import EvmYul.FFI.ffi
import SolidCore.Solidity.Shared.Precompile

/-!
Byte-parity witness for the in-semantics precompile implementations
(`SolidCore.Solidity.Shared.Crypto` / `Precompile.execute?`) against ground
truth:

  * sha256 — vs the pinned NATIVE `ffi.sha256` on every case (plus NIST-style
    known-answer vectors);
  * blake2f — vs the pinned NATIVE `ffi.BLAKE2Compress` on the EIP-152
    vector-5 input, plus round-count variants, plus malformed-input cases;
  * ripemd160 — published known-answer vectors (Bosselaers test suite);
  * ecrecover — the canonical go-ethereum recovery vector plus
    sign-then-recover vectors and the full invalid-signature matrix
    (bad v, r = 0, r ≥ n, non-residue x, truncated calldata);
  * bnAdd / bnMul (alt_bn128) — vectors anchored at the published 2·G1
    constant, including infinity, zero-padding, off-curve and out-of-range
    error cases;
  * modexp / identity — `Precompile.execute?`-level known-answer vectors.

Native comparisons need the pinned `libleanffi`, hence
`supportInterpreter := true` in the lakefile. Run with
`lake exe precompileParity`; exits 0 iff every case agrees byte-for-byte.
-/

open SolidCore.Solidity.Shared

private def toBA (bs : List Nat) : ByteArray :=
  ByteArray.mk (Array.mk (bs.map (fun n => UInt8.ofNat n)))

private def ofBA (ba : ByteArray) : List Nat :=
  ba.toList.map UInt8.toNat

private def hexOf (bs : List Nat) : String :=
  String.join (bs.map (fun b =>
    let h := "0123456789abcdef".toList
    String.mk [h.getD (b / 16) '?', h.getD (b % 16) '?']))

private def ffiSha256 (bs : List Nat) : List Nat :=
  ofBA (ffi.sha256 (toBA bs) (toBA bs).size.toUSize)

private def hexBytes (s : String) : List Nat := Id.run do
  let cs := s.toList
  let val := fun (c : Char) =>
    if '0' ≤ c && c ≤ '9' then c.toNat - '0'.toNat
    else if 'a' ≤ c && c ≤ 'f' then c.toNat - 'a'.toNat + 10
    else 0
  let mut out : List Nat := []
  let mut i := 0
  while h : i + 1 < cs.length do
    out := out ++ [val cs[i] * 16 + val cs[i+1]]
    i := i + 2
  return out

/-- `[τ]G2` provenance: re-compress the hardcoded affine setup point
    (ZCash G2 encoding: sort flag from the imaginary y coefficient when it
    is nonzero) and compare against the canonical ceremony constant
    `KZG_SETUP_G2_MONOMIAL_1` carried by the pinned evmyul
    execution-specs KZG reference; plus on-twist-curve and r-subgroup
    membership. -/
private def tauG2Provenance : Bool :=
  let (x, y) := Crypto.kzgTauG2
  let aFlag :=
    if y.2 > 0 then 2 * y.2 / Crypto.blsP else 2 * y.1 / Crypto.blsP
  let z1 := x.2 + 2 ^ 383 + aFlag * 2 ^ 381
  Crypto.natToBytesBE 48 z1 ++ Crypto.natToBytesBE 48 x.1 ==
      hexBytes "b5bfd7dd8cdeb128843bc287230af38926187075cbfbefa81009a2ce615ac53d2914e5870cb452d2afaaab24f3499f72185cbfee53492714734429b7b38608e23926c911cceceac9a36851477ba4c60b087041de621000edc98edada20c1def2" &&
    Crypto.f2onCurve Crypto.blsP Crypto.blsTwistB x y &&
    (Crypto.point2Mul Crypto.blsP Crypto.blsR (some (x, y))).isNone

/-- BLS12-381 reduced Tate pairing internal witnesses:
    `e(G1, G2) ≠ 1` (non-degeneracy) and `e(G1, G2)·e(-G1, G2) = 1`. -/
private def blsPairingChecks : Bool × Bool :=
  let (xQ, yQ) := Crypto.blsUntwist Crypto.blsG2
  let m1 :=
    Crypto.millerTate Crypto.blsP Crypto.blsXi Crypto.blsR Crypto.blsG1 xQ yQ
  let negG1 :=
    (Crypto.blsG1.1, (Crypto.blsP - Crypto.blsG1.2) % Crypto.blsP)
  let m2 := Crypto.millerTate Crypto.blsP Crypto.blsXi Crypto.blsR negG1 xQ yQ
  let e1 := Crypto.f12pow Crypto.blsP Crypto.blsXi m1
    Crypto.blsFinalExpExponent
  let prod := Crypto.f12pow Crypto.blsP Crypto.blsXi
    (Crypto.f12mul Crypto.blsP Crypto.blsXi m1 m2) Crypto.blsFinalExpExponent
  (e1 != Crypto.f12one, prod == Crypto.f12one)

