      [some false, some false, some false, some false, some false, some false, some false, some false],
      [some false, some false, some false, some false, some false],
      [some false],
      [some false, some false, some false],
      [some false, some false, some false]] }

/-- The highest stack each block is entered with. -/
def maxs : List Nat := [0, 1, 7, 1, 1, 1, 1, 6, 6, 7, 8, 10, 8, 4, 8, 8, 8, 5, 1, 3, 3]

set_option maxRecDepth 100000 in
/-- The code's linear decoding is the lowered program at the layout, by the kernel's evaluation
of the walk's one-pass form (`Assemble.walkS`). -/
theorem walk_ok : (SolarTV.Assembly.walk (bytesOf code) cert.offset 0
    (lower SolarTV.Export.Counter.evm11 cert)).isSome = true := by
  have hw := walkS_drop (bytesOf code) cert.offset (lower SolarTV.Export.Counter.evm11 cert) 0
    (Nat.zero_le _)
  rw [List.drop_zero] at hw
  rw [← hw]
  decide +kernel

set_option maxRecDepth 100000 in
/-- Every block checks within its budget and stack bounds. -/
theorem blocks_ok : blocksOkL SolarTV.Export.Counter.evm11 cert maxs 0
    SolarTV.Export.Counter.evm11.blocks = true := by
  decide +kernel

/-- Every label is a valid jump destination of the code, which the walk implies. -/
theorem labels_ok : labelsValid SolarTV.Export.Counter.evm11 cert code = true :=
  labelsValid_of_walk walk_ok

theorem size_ok : code.size < 2 ^ 32 := by
  decide +kernel

/-- The checker of code with loops accepts solar's bytecode for the final EVM IR, by the kernel's
evaluation of each of its parts. -/
theorem check_ok : checkL SolarTV.Export.Counter.evm11 code cert maxs = true := by
  simp only [checkL, walk_ok, blocks_ok, labels_ok, decide_eq_true size_ok, Bool.and_true,
    Bool.true_and]
  decide

/-- **The assembly stage of verify_counter at every gas.** -/
theorem assembly (o : SolarTV.Machine.Oracle) (scope : SolarTV.Call → Prop) (gas : Nat) :
    Final.Within (SolarTV.evmirSem o) (Final.ethLibWith gas) SolarTV.Export.Counter.evm11 code
      scope :=
  within_of_checkL check_ok o (fun h => absurd h (by decide)) scope gas

