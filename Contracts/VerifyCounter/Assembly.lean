/-- The bytecode with the loop's back edge to block 7's JUMPDEST (0xaa) in place of block 8's. -/
def loopTargetCode : ByteArray := ⟨(loopTargetBytes.map UInt8.ofNat).toArray⟩

set_option maxRecDepth 100000 in
/-- The checker rejects the wrong loop target: the walk decodes a push of 0xaa where the layout
puts block 8 at 0xdb. -/
theorem loopTarget_check :
    checkL SolarTV.Export.Counter.evm11 loopTargetCode cert maxs = false := by
  have hw := walkS_drop (bytesOf loopTargetCode) cert.offset
    (lower SolarTV.Export.Counter.evm11 cert) 0 (Nat.zero_le _)
  rw [List.drop_zero] at hw
  have hf : (SolarTV.Assembly.walk (bytesOf loopTargetCode) cert.offset 0
      (lower SolarTV.Export.Counter.evm11 cert)).isSome = false := by
    rw [← hw]
    decide +kernel
  simp [checkL, hf]

