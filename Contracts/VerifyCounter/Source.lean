import SolidCore.Refinement.KernelCopies
import SolidCore.Refinement.KernelRfl
import Contracts.VerifyCounter.SourceAst
import Contracts.VerifyCounter.SourceBump
import Verify.Shapes

/-!
# solar-verify's Counter in SolidCore: bump terminates, by its ranking certificate

SolidCore's checked `Counter` is `contract?`, the type checker on the solc AST of
crates/verify/examples/Counter.sol (`SourceAst.lean`, generated by
scripts/solc_ast_to_lean_source.py with solc 0.8.35). The kernel checks (`shape_eq`, `kernel_rfl`,
on copies of the type checker that read the five selectors from `selectorTable`, each selector
checked by Keccak-256 alone) that it type checks, that its storage fields are `vcFields`, that it
declares no events, and that its function of selector `bump(uint256)` is `bumpFn`, whose body is
`SourceBump.bumpBody`.

The source semantics is `solidCoreRuntime` (`LoopRun.lean`): SolidCore's ABI dispatcher from the
call's storage. `solidCore` cannot be used: it first runs the constructor with no arguments, and
`Counter`'s constructor takes `uint256 _limit`, so `solidCore` has no run of `Counter` at all.
Deployment is outside the statement.

* `runs`: every call of `bump(n)` (any argument word, no value, any storage) runs, at fuel
  `2 ^ 256 + 8`, to the observable of the tree `brTree bumpFn [] bumpBr` (`runtime_run_clean` on
  `SourceBump.body_runs`): `Panic(0x11)` when `count + n` wraps, `Error("over")` when it exceeds
  `limit`, else success with slot 0 holding `count + n`.
* `terminates`: `Shapes.Terminates (solidCoreRuntime fuel) c BumpCall _`, the termination
  obligation of the published shape, whose proof is the loop's ranking certificate `n - i`
  (`SourceLoop.cert`) checked by the kernel; no fuel is chosen per call: `2 ^ 256 + 8` bounds
  `rank + 8` for every word `n`.
-/

namespace Contracts.VerifyCounter.Source
open SolidCore.Solidity.Source SolidCore.Refinement SolidCore.Refinement.Generic
open SolidCore.Refinement.Generic.Loop

/-- SolidCore's checked `Counter`. -/
def contract? : Except SolidCore.Solidity.TypeCheck.TypeError SolidCore.Solidity.TypeCheck.CheckedContract :=
  SolidCore.Solidity.TypeCheck.CheckedInput.contract SolidCore.Refinement.Source.VerifyCounter.importedSourceUnit "Counter"

/-- The selector of `bump(uint256)`. -/
def bumpSel : Nat := 0xb20eb4c4

/-- `bump`, as the type checker leaves it. -/
def bumpFn : FunctionDef :=
  { name := "bump", selector? := some 2987308228, payable := false,
    params := [{ name := "n", ty := Ty.uint256, isStorageRef := false }],
    paramAbiCleanups := [AbiCleanup.uint 256], returns := [], body := bumpBody, dispatchId? := none }

def selCount : SolidCore.Solidity.Shared.Word := ABI.selectorFromSignature "count()"
kernel_rfl selCount_eq selCount 107354813
def selLimit : SolidCore.Solidity.Shared.Word := ABI.selectorFromSignature "limit()"
kernel_rfl selLimit_eq selLimit 2765516207
def selIncrement : SolidCore.Solidity.Shared.Word := ABI.selectorFromSignature "increment()"
kernel_rfl selIncrement_eq selIncrement 3500007562
def selBump : SolidCore.Solidity.Shared.Word := ABI.selectorFromSignature "bump(uint256)"
kernel_rfl selBump_eq selBump 2987308228
def selMax : SolidCore.Solidity.Shared.Word := ABI.selectorFromSignature "max(uint256,uint256)"
kernel_rfl selMax_eq selMax 1834234854

/-- `ABI.selectorFromSignature`, with `Counter`'s signatures by table. -/
def selectorTable (s : String) : SolidCore.Solidity.Shared.Word :=
  if s = "count()" then 107354813
  else if s = "limit()" then 2765516207
  else if s = "increment()" then 3500007562
  else if s = "bump(uint256)" then 2987308228
  else if s = "max(uint256,uint256)" then 1834234854
  else ABI.selectorFromSignature s

theorem selector_eq : ABI.selectorFromSignature = selectorTable := by
  funext s
  unfold selectorTable
  by_cases h0 : s = "count()"
  · rw [if_pos h0, h0]; exact selCount_eq
  rw [if_neg h0]
  by_cases h1 : s = "limit()"
  · rw [if_pos h1, h1]; exact selLimit_eq
  rw [if_neg h1]
  by_cases h2 : s = "increment()"
  · rw [if_pos h2, h2]; exact selIncrement_eq
  rw [if_neg h2]
  by_cases h3 : s = "bump(uint256)"
  · rw [if_pos h3, h3]; exact selBump_eq
  rw [if_neg h3]
  by_cases h4 : s = "max(uint256,uint256)"
  · rw [if_pos h4, h4]; exact selMax_eq
  rw [if_neg h4]

/-- What the statement reads of the checked contract. -/
def shape? : Option (List StorageField × List EventDecl × Option FunctionDef) :=
  match contract? with
  | .ok c => some (c.core.storageFields, c.core.eventDecls, c.core.findFunctionBySelector? bumpSel)
  | .error _ => none

-- `Counter` type checks, with the storage fields `vcFields`, no events, and `bumpFn` at bump's
-- selector: one conversion check of the type checker's copies (selectors by `selector_eq`).
kernel_rfl shape_eq shape? (some (vcFields, [], some bumpFn)) using selector_eq

theorem shape_of {c : SolidCore.Solidity.TypeCheck.CheckedContract} (hc : contract? = .ok c) :
    c.core.storageFields = vcFields ∧ c.core.eventDecls = [] ∧
      c.core.findFunctionBySelector? bumpSel = some bumpFn := by
  have h := shape_eq
  unfold shape? at h
  rw [hc] at h
  simp only [Option.some.injEq, Prod.mk.injEq] at h
  exact h

theorem contract_ok : ∃ c, contract? = .ok c := by
  have h := shape_eq
  unfold shape? at h
  cases hc : contract? with
  | ok c => exact ⟨c, rfl⟩
  | error _ => rw [hc] at h; simp at h

/-- The statement's fuel: `rank + 8` for every word `n`. -/
def fuel : Nat := 2 ^ 256 + 8

/-- The valid calls: `bump(n)` with any argument word, no value, from any storage. -/
def BumpCall (call : Call) : Prop :=
  ∃ σ a, a < 2 ^ 256 ∧ call = { calldata := Abi.calldata bumpSel [a], callvalue := 0, storage := σ }

theorem tree_ok : ∃ T, brTree bumpFn (argFacts [256] 0) bumpBr = some T :=
  Option.isSome_iff_exists.mp (by decide +kernel)

/-- **Every call of `bump(n)` runs in SolidCore to its tree's observable.** -/
theorem runs {c : SolidCore.Solidity.TypeCheck.CheckedContract} (hc : contract? = .ok c) {T : Tree}
    (hT : brTree bumpFn (argFacts [256] 0) bumpBr = some T) (σ : List (Nat × Nat)) (a : Nat)
    (ha : a < 2 ^ 256) :
    runtimeRun fuel c { calldata := Abi.calldata bumpSel [a], callvalue := 0, storage := σ } =
      some (T.eval ⟨[a], slotValue σ, solHash⟩).obs := by
  obtain ⟨hf, hev, hfind⟩ := shape_of hc
  have hw : widthsOf bumpFn.params bumpFn.paramAbiCleanups = some [256] := rfl
  have hargs : ∀ x ∈ [a], x < 2 ^ 256 := by simpa using ha
  have hclean : argsClean [256] [a] = true := by
    show (decide (a < 2 ^ 256) && true) = true
    simp only [Bool.and_true, decide_eq_true_eq]
    exact ha
  have hdec := decode_args hw [a] rfl hargs
  rw [if_pos hclean] at hdec
  have hE : ({ envOf c.core with facts := argFacts [256] 0 } : EraseEnv) =
      env c.core.eventDecls c.core.table := by
    simp only [envOf, env, hf]
    rfl
  have hb : BodyRuns { envOf c.core with facts := argFacts [256] 0 } fuel bumpFn bumpBr := by
    rw [hE]
    exact body_runs _ _ bumpFn rfl rfl fuel (by unfold fuel; omega)
  exact runtime_run_clean (by decide) hfind hw rfl hb hT [a] rfl hargs hclean hdec

/-- **bump terminates in SolidCore**, on every valid call: the termination obligation of the
published shape, proved by the loop's ranking certificate. -/
theorem terminates : ∃ c, contract? = .ok c ∧
    Shapes.Terminates (solidCoreRuntime fuel) c BumpCall (fun _ _ => True) := by
  obtain ⟨c, hc⟩ := contract_ok
  obtain ⟨T, hT⟩ := tree_ok
  refine ⟨c, hc, ?_⟩
  rintro _ ⟨σ, a, ha, rfl⟩
  exact ⟨_, runs hc hT σ a ha, trivial⟩

/-- **bump's specification on SolidCore's runs** (solar-verify's `count == old(count) + n`, with
the `require`): a call of `bump(n)` that succeeds leaves slot 0 holding the old `count` plus `n`,
which did not wrap and is at most `limit` (slot 1), and every other slot as it was. -/
theorem success_spec {c : SolidCore.Solidity.TypeCheck.CheckedContract} (hc : contract? = .ok c) {T : Tree}
    (hT : brTree bumpFn (argFacts [256] 0) bumpBr = some T) (σ : List (Nat × Nat)) (a : Nat)
    (ha : a < 2 ^ 256) {obs : Observable}
    (h : runtimeRun fuel c { calldata := Abi.calldata bumpSel [a], callvalue := 0, storage := σ } =
      some obs) (hs : obs.success = true) :
    obs.storage 0 = slotValue σ 0 + a ∧ slotValue σ 0 + a ≤ slotValue σ 1 ∧
      ∀ k, k % Generic.wordSize ≠ 0 → obs.storage k = slotValue σ k := by
  rw [runs hc hT σ a ha] at h
  obtain rfl := Option.some.inj h
  set ρ : Val := ⟨[a], slotValue σ, solHash⟩ with hρ
  have hok : ρ.Ok := slotValue_store σ
  obtain ⟨T', hT', hTe⟩ := brTree_eval bumpFn (argFacts [256] 0) ρ bumpBr T hT
  simp only [Res.obs] at hs ⊢
  rw [← hTe] at hs ⊢
  unfold bumpBr at hT'
  rw [guards_eval] at hT'
  by_cases hg : [ovf].any (fun g => g.eval ρ != 0) = true
  · rw [if_pos hg] at hT'
    simp only [leafTree, Option.some.injEq] at hT'
    subst hT'
    simp [Tree.eval] at hs
  rw [if_neg hg] at hT'
  simp only [Br.eval] at hT'
  by_cases hv : le.eval ρ = 0
  · rw [if_pos hv] at hT'
    simp only [leafTree, Option.map_eq_some_iff] at hT'
    obtain ⟨bs, _, rfl⟩ := hT'
    simp [Tree.eval] at hs
  rw [if_neg hv] at hT'
  have hpre := require_passed ρ hok hg hv
  have hn : nOf ρ = a := by
    simp only [nOf, WExpr.eval, hρ, List.getD_cons_zero]; exact Nat.mod_eq_of_lt ha
  rw [hn] at hpre
  have h1w := hok.word 1
  have h0 := hok.word 0
  have hT2 : T' = .halt true [] [(.lit 0, .bin .add (.init 0) (.arg 0))] [] := by
    simp [leafTree, bumpFn, SF, retsOk] at hT'
    first | exact hT'.symm | exact hT'
  subst hT2
  have h0' : slotValue σ 0 < Generic.wordSize := h0
  have h1' : slotValue σ 1 < Generic.wordSize := h1w
  have ha' : a < Generic.wordSize := ha
  have hpre' : slotValue σ 0 + a ≤ slotValue σ 1 := hpre
  refine ⟨?_, hpre', ?_⟩
  · simp only [Tree.eval, ↓reduceIte, Writes.store, WExpr.eval, BinOp.eval, hρ, List.getD_cons_zero]
    rw [Nat.mod_eq_of_lt h0', Nat.mod_eq_of_lt ha', Nat.mod_mod, Nat.mod_eq_of_lt (by omega)]
  · intro k hk
    simp only [Tree.eval, ↓reduceIte, Writes.store, WExpr.eval]
    by_cases he : 0 % Generic.wordSize = k % Generic.wordSize
    · rw [Nat.zero_mod] at he; exact absurd he.symm hk
    · simp only [he, ↓reduceIte] <;> rfl

/-- info: 'Contracts.VerifyCounter.Source.terminates' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs in
#print axioms terminates

/-- info: 'Contracts.VerifyCounter.Source.success_spec' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs in
#print axioms success_spec

end Contracts.VerifyCounter.Source
