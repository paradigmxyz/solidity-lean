import Contracts.UniswapV2.ERC20.Connect
import Contracts.UniswapV2.ERC20.SpecMut

/-!
# UniswapV2ERC20: the specs of SolidCore's checked contract, and a spec mutant refused

`Connect.lean` (generated by scripts/verify/uniswap_v2_spec.sh with solar's
tools/certify/spec_connect.py; not committed, since it holds the erased trees of the GPL-3.0
v2-core port) proves, for `approve` and `transfer`, solar-verify's exported spec
(`--emit-lean-spec` of crates/verify/uniswap-v2/uniswap-v2.spec) of the generic source stage's
erased tree by `tree_meets_map2` (`_meets`), and of SolidCore's checked UniswapV2ERC20 on the
stage's calls in every world (`_holds_in`). `transfer`'s tree is `_transfer` inlined with its
two SafeMath calls by `eraseFn`.

The hypotheses are named: `NestedSlotsSeparated [1] [2]` (keccak256 separated on the slots of
`balanceOf[a]` and `allowance[o][s]`), and the ghost step (`hstep`): the ghosts `sumBalances` and
`zeroMinted` change only in `_mint` and `_burn`, so on a call of `approve` or `transfer` the
ghost state is unchanged. The specs' invariants (`totalSupply == sumBalances`,
`allowance[address(0)][s] == 0`, `balanceOf[address(0)] >= zeroMinted`) are assumed before the
call and proved after it.

`wrong_not_meets` is the negative control: the spec mutant (`transfer` credits
`old(balanceOf[to]) + value + 1`, SpecMut.lean) does not hold of the same tree, with no
hypothesis: `transfer(1, 0)` from the empty storage succeeds and leaves `balanceOf[1]` at 0.
-/

namespace SolidCore.Spec.UniswapV2.ERC20.Meets

open SolidCore.Spec SolidCore.Refinement SolidCore.Refinement.Generic SolidCore.Spec.UniswapV2.ERC20

/-- The mutant's spec of `transfer`. -/
def mutSpec : FnSpec :=
  SolidCore.Spec.Export.UniswapV2ERC20SpecMut.UniswapV2ERC20.spec.specs[1]'(by decide)

set_option linter.unusedSimpArgs false in
/-- **The spec mutant does not hold of `transfer`'s tree**: `transfer(1, 0)` from the empty storage
succeeds with `balanceOf[1]` still 0, and the mutant asks for 1. -/
theorem wrong_not_meets :
    ¬ TreeMeetsFixed SolidCore.Spec.Export.UniswapV2ERC20SpecMut.UniswapV2ERC20 mutSpec ctx 2
      transfer_tree := by
  intro h
  have hp := h [1, 0] (fun _ => 0) [1, 0] ⟨fun _ => 0, Ghost.zero, 0⟩ rfl (by simp) (by simp)
    (by simp [mutSpec, SolidCore.Spec.Export.UniswapV2ERC20SpecMut.UniswapV2ERC20, decodeWords,
      Ty.ofWord])
    rfl (by simp [ctx])
    (by simp [Bundle.satAll, mutSpec, SolidCore.Spec.Export.UniswapV2ERC20SpecMut.UniswapV2ERC20])
    (by simp [Bundle.satAll, Bundle.sat, SolidCore.Spec.Export.UniswapV2ERC20SpecMut.UniswapV2ERC20,
      eval, slotOf, mkEnv, Env.cur, Env.bind, Ghost.zero, BinOp.apply, Ty.ofBits, forall_int_range,
      Nat.zero_div, Nat.zero_mod])
  have hlt := solHash_lt'
  have hkec := keccak_solHash
  generalize solHash = H at hp hlt hkec
  simp only [transfer_tree, Tree.eval, WExpr.eval, BinOp.eval, UnOp.eval, Generic.wordSize, Res.obs,
    Writes.store, List.getD_cons_zero, List.getD_cons_succ, Nat.reducePow, Nat.reduceMod, Nat.zero_mod,
    Nat.reduceLT, ite_mod_nat, ite_true, ite_false, Nat.lt_irrefl, Nat.not_lt_zero, decide_false,
    Nat.reduceAdd, Nat.reduceSub, Nat.zero_add, Nat.add_zero, ite_self, Nat.one_ne_zero,
    Nat.reduceEqDiff, reduceIte] at hp
  obtain ⟨rets, -, hens, -⟩ := hp.1 rfl
  simp only [Bundle.satAll, Bundle.sat, mutSpec, SolidCore.Spec.Export.UniswapV2ERC20SpecMut.UniswapV2ERC20,
    List.getElem_cons_succ, List.getElem_cons_zero, List.mem_cons, List.not_mem_nil, or_false,
    forall_eq_or_imp, forall_eq, eval, evalList, slotOf, mkEnv, Env.cur, Env.bind, BinOp.apply, Ty.ofBits,
    toWord, ctx, List.getD_cons_zero, List.getD_cons_succ, hkec, ofProp_ne_zero, ite_true, ite_false,
    Nat.zero_div, Nat.zero_mod, Int.reduceMod, Int.reduceToNat] at hens
  have h2 := hens.2.1 (by decide)
  simp at h2

/-- info: 'SolidCore.Spec.UniswapV2.ERC20.Meets.wrong_not_meets' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs in
#print axioms wrong_not_meets

end SolidCore.Spec.UniswapV2.ERC20.Meets
