import Contracts.UniswapV2.PairSpec.Refusal
import Contracts.UniswapV2.PairSpec.SourceNoUpdate
import Contracts.UniswapV2.PairSpec.RuntimeNoUpdate
import Contracts.UniswapV2.PairSpec.SourceSkimUpdate
import Contracts.UniswapV2.PairSpec.RuntimeSkimUpdate

/-!
# UniswapV2Pair: the binding and the negative controls, by execution

One swap is run on the exact bytes in EthLib (`Target.runWithIn`, with two token accounts whose
code answers `balanceOf` with a fixed balance and `transfer` with `true`) and on SolidCore's
checked source in the matching world (`Source.runIn`, answers the same), then on the mutants:

| control | what runs | what refuses it |
|---|---|---|
| altered jump | the bytes with the first `PUSH2 t; JUMPI` target moved by one | the binding (`altered_not_bound`, kernel); the altered bytes revert on the swap the real bytes perform (evaluated) |
| skim that moves the reserves | skim with sync's `_update` first: solar's compile and SolidCore's translation of it | the published specification refuses every successful skim observable with reserve0 moved (`skimUpdate_refused`, kernel) |
| missing reserve update | swap without `_update`: solar's compile of the mutant source, and SolidCore's translation of it | the published specification refuses every observable with the executed features (`noUpdate_refused`, kernel) |
| wrong K | the real bytes and source | the mutated specification (fee 4/1000, SpecWrongK) refuses every observable with the executed features (`wrongK_refused`, kernel); the published clause accepts them (`k_accepts`, kernel) |
| mismatched environment | the real bytes among tokens answering 11000/9094, the source in a world answering 11000/9000 | the observables differ (evaluated): no equivalence claim relates them |
| closed world | the real bytes with no token accounts | swap reverts (evaluated): a closed-world statement would hold vacuously |

**What is kernel-checked and what is evaluated.** The runs are evaluated by Lean's compiled
evaluator (`#guard`), not by the kernel: EthLib's `processMessage` is well-founded recursion that
the kernel does not reduce, and the source run needs the checked contract, which only the 22
staged modules (ContractsUniswapV2Pair) produce in the kernel. Each refusal is a kernel theorem
over **every** observable with the features the evaluation checks (success, the reserves word),
so a refusal does not depend on the evaluator beyond those features. The mutants are generated by
scripts/verify/uniswap_v2_pair_spec.sh (not committed: derived from the GPL-3.0 port).
-/

namespace SolidCore.Spec.UniswapV2.PairSpec.Negative

open SolarTV SolidCore.Refinement SolidCore.Refinement.Shapes SolidCore.Spec
open SolidCore.Spec.UniswapV2.PairSpec EvmCompiler.Simulation SolidCore.Solidity

/-! ## The binding and an altered jump -/

set_option maxRecDepth 100000 in
/-- The export is the bytes of the plain compile. -/
theorem bound : Bound :=
  @of_decide_eq_true _ (instDecidableEqList _ _) (by decide +kernel)

/-- The bytes with the first `PUSH2 t; JUMP` or `PUSH2 t; JUMPI` target moved by one. -/
def alterJump : List Nat → List Nat
  | 0x61 :: hi :: lo :: 0x56 :: rest => 0x61 :: hi :: ((lo + 1) % 256) :: 0x56 :: rest
  | 0x61 :: hi :: lo :: 0x57 :: rest => 0x61 :: hi :: ((lo + 1) % 256) :: 0x57 :: rest
  | b :: rest => b :: alterJump rest
  | [] => []

set_option maxRecDepth 100000 in
/-- The alteration changes the bytes. -/
theorem alterJump_changes : alterJump runtimeBytes ≠ runtimeBytes := by decide +kernel

set_option maxRecDepth 100000 in
/-- **Altered jump**: the export is not the altered bytes. -/
theorem altered_not_bound : ¬ (code.data.toList.map (·.toNat) = alterJump runtimeBytes) := by
  rw [bound]
  exact alterJump_changes.symm

/-! ## The environment of the runs -/

/-- Token code: `transfer(...)` returns `true`, every other call the word `bal` (`bal < 2^16`). -/
def tokenCode (bal : Nat) : ByteArray :=
  ⟨(([0x60, 0, 0x35, 0x60, 0xe0, 0x1c, 0x63, 0xa9, 0x05, 0x9c, 0xbb, 0x14, 0x60, 0x1a, 0x57,
      0x61, bal / 256, bal % 256, 0x60, 0, 0x52, 0x60, 0x20, 0x60, 0, 0xf3,
      0x5b, 0x60, 1, 0x60, 0, 0x52, 0x60, 0x20, 0x60, 0, 0xf3] : List Nat).map UInt8.ofNat).toArray⟩

/-- token0 at `0x4000` holding `b0` for the pair, token1 at `0x5000` holding `b1`. -/
def env (b0 b1 : Nat) : TargetEnv :=
  [{ addr := 0x4000, code := tokenCode b0, storage := [], balance := 0, nonce := 1 },
   { addr := 0x5000, code := tokenCode b1, storage := [], balance := 0, nonce := 1 }]

/-- A word as return data. -/
def wordBA (n : Nat) : ByteArray := ⟨((word n).map UInt8.ofNat).toArray⟩

/-- The same answers on the source side: `transfer` answers `true`, every other call the balance
of the token called; no answer changes the pair's storage. -/
def ans (b0 b1 : Nat) : Ans := fun _ q =>
  match q with
  | .resource r => some (Query.defaultAnswer (.resource r))
  | .external w0 (.call req) =>
    let v := if (req.calldata.data.toList.take 4).map (·.toNat) = [0xa9, 0x05, 0x9c, 0xbb] then 1
      else if req.recipient.val = 0x4000 then b0 else b1
    some (CallResponse.mk true (wordBA v) w0 (EvmYul.UInt256.ofNat 0))
  | .external w0 (.create r) => some (Query.defaultAnswer (.external w0 (.create r)))

/-- The source world of the runs: the tokens' answers and code at both addresses. -/
def W (b0 b1 : Nat) : World := { ans := ans b0 b1, codes := some [(0x4000, [0x60]), (0x5000, [0x60])] }

/-- The mutant bytes (swap without `_update`) and the altered bytes. -/
def codeNoUpdate : ByteArray := ⟨(runtimeNoUpdate.map UInt8.ofNat).toArray⟩
def codeAltered : ByteArray := ⟨((alterJump runtimeBytes).map UInt8.ofNat).toArray⟩

/-- SolidCore's checked mutant. -/
def contractNoUpdate? : Except TypeCheck.TypeError TypeCheck.CheckedContract :=
  TypeCheck.CheckedInput.contract SolidCore.Verify.VC.Source.UniswapV2PairNoUpdate.importedSourceUnit
    "UniswapV2Pair"

/-- The mutant bytes of skim forcing the reserves to the balances. -/
def codeSkimUpdate : ByteArray := ⟨(runtimeSkimUpdate.map UInt8.ofNat).toArray⟩

/-- SolidCore's checked skim mutant. -/
def contractSkimUpdate? : Except TypeCheck.TypeError TypeCheck.CheckedContract :=
  TypeCheck.CheckedInput.contract SolidCore.Verify.VC.Source.UniswapV2PairSkimUpdate.importedSourceUnit
    "UniswapV2Pair"

/-- The features of a run the controls check: success, reserve0, reserve1, the lock word. -/
def feat : Option Observable → Option (Bool × Nat × Nat × Nat)
  | some o => some (o.success, o.storage 8 % 2 ^ 112, o.storage 8 / 2 ^ 112 % 2 ^ 112, o.storage 12)
  | none => none

def srcRun (c? : Except TypeCheck.TypeError TypeCheck.CheckedContract) (w : World) (call : Call) :
    Option Observable :=
  match c? with
  | .ok c => Source.runIn w SolidCore.Verify.VC.UniswapV2Pair.fuel c call
  | .error _ => none

/-! ## The runs (evaluated) -/

-- The exact bytes: the swap succeeds, reserves 11000/9094, unlocked.
#guard feat (Target.runWithIn (env 11000 9094) 10000000 code swapCall) = some (true, 11000, 9094, 1)
-- The checked source in the matching world: the same features.
#guard feat (srcRun SolidCore.Verify.VC.UniswapV2Pair.contract? (W 11000 9094) swapCall) =
  some (true, 11000, 9094, 1)
-- Mutant bytes: the swap succeeds and leaves the reserves at 10000/10000.
#guard feat (Target.runWithIn (env 11000 9094) 10000000 codeNoUpdate swapCall) = some (true, 10000, 10000, 1)
-- Mutant source: the same.
#guard feat (srcRun contractNoUpdate? (W 11000 9094) swapCall) = some (true, 10000, 10000, 1)
-- Altered bytes: the swap the real bytes perform fails.
#guard ((Target.runWithIn (env 11000 9094) 10000000 codeAltered swapCall).map (·.success)) = some false
-- Mismatched environment: the source in a world answering 11000/9000 does not show the bytes'
-- observable among tokens answering 11000/9094.
#guard feat (srcRun SolidCore.Verify.VC.UniswapV2Pair.contract? (W 11000 9000) swapCall) ≠
  feat (Target.runWithIn (env 11000 9094) 10000000 code swapCall)
-- Closed world: without token accounts the swap reverts.
#guard ((Target.runWithIn [] 10000000 code swapCall).map (·.success)) = some false

/-! ## skim (evaluated): token balances 11000/10500 over reserves 10000/10000 -/

-- The exact bytes: skim succeeds and keeps the reserves at 10000/10000.
#guard feat (Target.runWithIn (env 11000 10500) 10000000 code skimCall) = some (true, 10000, 10000, 1)
-- The checked source in the matching world: the same features.
#guard feat (srcRun SolidCore.Verify.VC.UniswapV2Pair.contract? (W 11000 10500) skimCall) =
  some (true, 10000, 10000, 1)
-- Mutant bytes (skim forcing the reserves to the balances): reserves 11000/10500.
#guard feat (Target.runWithIn (env 11000 10500) 10000000 codeSkimUpdate skimCall) = some (true, 11000, 10500, 1)
-- Mutant source: the same.
#guard feat (srcRun contractSkimUpdate? (W 11000 10500) skimCall) = some (true, 11000, 10500, 1)

/-! ## sync (evaluated): the real code moves the reserves, which the spec does not require -/

-- The exact bytes: sync sets the reserves to the balances 11000/9094.
#guard feat (Target.runWithIn (env 11000 9094) 10000000 code syncCallσ) = some (true, 11000, 9094, 1)
-- The checked source: the same.
#guard feat (srcRun SolidCore.Verify.VC.UniswapV2Pair.contract? (W 11000 9094) syncCallσ) =
  some (true, 11000, 9094, 1)
-- The observable syncNoop_accepted proves the spec accepts differs: reserves 10000/10000.
#guard feat (some syncNoop) = some (true, 10000, 10000, 1)

end SolidCore.Spec.UniswapV2.PairSpec.Negative
