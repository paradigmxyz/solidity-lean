import Contracts.ArrayMax.Entry.Loop
import Contracts.ArrayMax.Entry.Start

/-!
# ArrayMaxEntry.max on solar's first lowered MIR, through one cut point

solar inlines `ArrayMax.max` into `ArrayMaxEntry.max(uint256[] calldata)`: function 0 of
`stage0` decodes the array, copies it to memory at 128 (`calldatacopy`) and runs the loop with
its header at block 2. The header invariant is not written here: `Inferred.lean` is generated by
solar's `solar-tv/milestone/inferred.py` from what `solar-verify --show-inferred` inferred for the
loop (the quantified clauses over `xs` included), bound to the header's values, with the frame
the compiler keeps (the copy of the calldata array, the induction pointer) read off the MIR.
The segments below check every conjunct, so a wrong clause fails by mismatch.

* `stage0_post`: every end of stage0 on a call of `max` meets `Post`: on success it returns one
  word `m`, no element of the calldata array is above it, and one element equals it, whatever the
  array's length (the loop runs `xs.length - 1` times).

`CalldataFits`: the calldata is shorter than 2^64 bytes. Without it, offsets past 2^256 wrap in
the word arithmetic of the decoder, and the copy may land elsewhere; every call the EVM can pay
for meets it.
-/

namespace SolarTV.Milestone.ArrayMaxEntry

open Machine SolarTV.Export.ArrayMaxEntry SolarTV.Milestone.W1
open SolarTV.CutPoint (seg SegOk)

/-! ## Every run -/

/-- **ArrayMaxEntry.max's spec of solar's first lowered MIR**: every end of stage0 on a call of
`max` meets `Post`, however many times the loop runs. -/
theorem stage0_post (o : Oracle) (call : Call) (hsel : IsMax call) (fits : CalldataFits call)
    (r : Halt × State) (e : MIR.Lowered.moduleLayer.Ends o stage0 call r) : Post call r := by
  obtain ⟨n, e⟩ := e
  change Machine.iterate _ n _ = some r at e
  rw [CutPoint.iterate_eq] at e
  exact CutPoint.post_of_start (seg0 o call hsel fits) (by
    rintro x (⟨env, s, rfl, h⟩ | ⟨env, s, rfl, h⟩)
    · exact seg5 o call env s h
    · exact seg10 o call env s h) n r e

/-- `Post` is read off what an observer sees. -/
theorem Post.of_agree {call : Call} {r r' : Halt × State} (ag : Agree r r') (h : Post call r) :
    Post call r' := by
  obtain ⟨a, s⟩ := r
  obtain ⟨b, t⟩ := r'
  intro hb
  have ha : a = .stop ∨ ∃ d, a = .ret d := by
    rcases hb with hb | ⟨d, hb⟩ <;> simp only at hb <;> subst hb <;> cases a <;> simp_all [Agree]
  obtain ⟨m, hm, h1, h2⟩ := h ha
  simp only at hm
  subst hm
  refine ⟨m, ?_, h1, h2⟩
  rcases hb with hb | ⟨d, hb⟩ <;> simp only at hb <;> subst hb
  · exact absurd (congrArg List.length ag.1) (by simp)
  · simp only [Agree] at ag
    simp [ag.1]

/-- `Post` carried along any program whose every end is matched by an agreeing end of stage0. -/
theorem post_of_certified {L : Layer} {p : L.Prog} (o : Oracle)
    (cert : Certified L MIR.Lowered.moduleLayer o p stage0 anyCall) (call : Call)
    (hsel : IsMax call) (fits : CalldataFits call) (r : Halt × State) (e : L.Ends o p call r) :
    Post call r := by
  obtain ⟨r0, e0, ag⟩ := cert call trivial r e
  exact (stage0_post o call hsel fits r0 e0).of_agree (CutPoint.Agree.symm ag)

/-- info: 'SolarTV.Milestone.ArrayMaxEntry.stage0_post' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs in
#print axioms stage0_post

/-- info: 'SolarTV.Milestone.ArrayMaxEntry.post_of_certified' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs in
#print axioms post_of_certified

end SolarTV.Milestone.ArrayMaxEntry
