import SolarTV.CutPointHoare
import W1Proofs.Segment
import W1Proofs.Stage
import Contracts.ArrayMax.Inferred

/-!
# ArrayMaxEntry.max on solar's first lowered MIR, through one cut point

solar inlines `ArrayMax.max` into `ArrayMaxEntry.max(uint256[] calldata)`: function 0 of
`stage0` decodes the array, copies it to memory at 128 (`calldatacopy`) and runs the loop with
its header at block 2. The header invariant is not written here: `Inferred.lean` is generated by
solar's `solar-tv/milestone/inferred.py` from what `solar-verify --show-inferred` inferred for the
loop (the quantified clauses over `xs` included), bound to the header's values, with the frame
the compiler keeps (the copy of the calldata array, the induction pointer) read off the MIR.
The segments below check every conjunct, so a wrong clause fails by mismatch.

* `stage0_post`: every end of stage0 on a call of `max` meets `Post`: on success it returns one
  word `m`, no element of the calldata array is above it, and one element equals it, whatever the
  array's length (the loop runs `xs.length - 1` times).

`CalldataFits`: the calldata is shorter than 2^64 bytes. Without it, offsets past 2^256 wrap in
the word arithmetic of the decoder, and the copy may land elsewhere; every call the EVM can pay
for meets it.
-/

namespace SolarTV.Milestone.ArrayMaxEntry

open Machine SolarTV.Export.ArrayMaxEntry SolarTV.Milestone.W1
open SolarTV.CutPoint (seg SegOk)

abbrev W := EvmRules.Word

def cut : MIR.Lowered.Frame → Bool := fun x =>
  match x.2.1 with
  | .enter f _ b => (f == 0 && b == 2)
  | .resume .. => false

theorem cut_enter (rs : List MIR.Lowered.Return) (f p b : Nat) (env : MIR.Lowered.Env) (s : State) :
    cut (rs, .enter f p b, env, s) = ((f == 0 && b == 2)) := rfl

theorem cut_resume (rs : List MIR.Lowered.Return) (f b : Nat) (is : List MIR.Lowered.Inst) (t : MIR.Lowered.Terminator) (env : MIR.Lowered.Env) (s : State) :
    cut (rs, .resume f b is t, env, s) = false := rfl

/-- `max(uint256[])`'s selector. -/
def IsMax (call : Call) : Prop := EvmRules.Evm.shr 224 (calldataWord call 0) = 0x3bf6de96

/-- Calldata shorter than 2^64 bytes. -/
def CalldataFits (call : Call) : Prop := call.calldata.size < 2 ^ 64

/-- The array's length, as the ABI decoder reads it: the word at its offset (the first argument
word) past the selector. -/
def len (call : Call) : W := calldataWord call (calldataWord call 4 + (4 : W))

/-- Element `j` of the array. -/
def elem (call : Call) (j : W) : W :=
  calldataWord call (((calldataWord call 4 + (4 : W)) + (32 : W)) + 32 * j)

/-- `ArrayMaxEntry.max`'s ensures clauses: a successful end returns one word `m`, no element is
above it and some element equals it. -/
def Post (call : Call) (r : Halt × State) : Prop :=
  (r.1 = .stop ∨ ∃ d, r.1 = .ret d) →
    ∃ m, r.1 = .ret (Mem.wordBytes m) ∧ (∀ j, j < len call → elem call j ≤ m) ∧
      ∃ j, j < len call ∧ elem call j = m

/-! ## Words and memory -/

theorem shr5_toNat (x : W) : (EvmRules.Evm.shr 5 x).toNat = x.toNat / 32 := by
  unfold EvmRules.Evm.shr
  simp [BitVec.ult, Nat.shiftRight_eq_div_pow]

theorem shl5_toNat (x : W) : (EvmRules.Evm.shl 5 x).toNat = x.toNat * 32 % 2 ^ 256 := by
  unfold EvmRules.Evm.shl
  simp [BitVec.ult, Nat.shiftLeft_eq]

theorem byte_word (n : Nat) (h : n < 256) : (BitVec.ofNat 8 n).setWidth 256 = BitVec.ofNat 256 n := by
  apply BitVec.eq_of_toNat_eq
  simp only [BitVec.toNat_setWidth, BitVec.toNat_ofNat]
  omega

theorem foldl_ext' {α β : Type} {f g : β → α → β} :
    ∀ (l : List α) (b : β), (∀ b a, a ∈ l → f b a = g b a) → l.foldl f b = l.foldl g b
  | [], _, _ => rfl
  | a :: l, b, h => by
    simp only [List.foldl_cons]
    rw [h b a (List.mem_cons_self ..)]
    exact foldl_ext' l _ (fun b x hx => h b x (List.mem_cons_of_mem _ hx))

/-- A word inside a calldata copy is the calldata word at the same distance. -/
theorem load_calldatacopy (m : Mem) (dst size srcN a : Nat) (call : Call) (w : W)
    (lo : dst ≤ a) (hi : a + 32 ≤ dst + size) (hw : w.toNat = srcN + (a - dst)) :
    (m.write dst size (fun i => calldataByte call (srcN + i))).load a = calldataWord call w := by
  unfold Mem.load calldataWord
  rw [Mem.read_write_inside m dst size _ a 32 lo hi, List.foldl_map]
  apply foldl_ext'
  intro acc i _
  unfold calldataByte
  rw [byte_word _ (UInt8.toNat_lt _), hw]
  congr 4
  omega

theorem load_write_below (m : Mem) (dst size a : Nat) (src : Nat → Memory.Byte) (h : a + 32 ≤ dst) :
    (m.write dst size src).load a = m.load a := by
  unfold Mem.load
  rw [Mem.read_write_disjoint m dst size src a 32 (Or.inl h)]

theorem nums (O L J S : Nat) (hS : S < 2 ^ 64) (hO : O + 36 ≤ S) (hL : L ≤ (S - (O + 36)) / 32)
    (hJ : J < L) : 160 + 32 * J + 32 ≤ 160 + L * 32 ∧ O + 36 + 32 * J < 2 ^ 256 ∧ 160 + 32 * J < 2 ^ 256 ∧
      32 * J < 2 ^ 256 ∧ L * 32 < 2 ^ 256 := by
  have : L * 32 ≤ S - (O + 36) := by
    have := Nat.div_mul_le_self (S - (O + 36)) 32
    exact Nat.le_trans (Nat.mul_le_mul_right 32 hL) this
  omega

theorem facts (call : Call) (fits : call.calldata.size < 2 ^ 64)
    (hA : ¬BitVec.ofNat 256 call.calldata.size < 36)
    (hB : ¬BitVec.ofNat 256 call.calldata.size - 36 < calldataWord call 4)
    (hC : ¬EvmRules.Evm.shr 5 (BitVec.ofNat 256 call.calldata.size - (calldataWord call 4 + 4 + 32)) <
        calldataWord call (calldataWord call 4 + 4)) :
    (calldataWord call 4).toNat + 36 ≤ call.calldata.size ∧
    (calldataWord call 4 + 4 + 32).toNat = (calldataWord call 4).toNat + 36 ∧
    (calldataWord call (calldataWord call 4 + 4)).toNat ≤
      (call.calldata.size - ((calldataWord call 4).toNat + 36)) / 32 := by
  have hS : (BitVec.ofNat 256 call.calldata.size).toNat = call.calldata.size :=
    Nat.mod_eq_of_lt (by omega)
  have n4 : (4 : W).toNat = 4 := rfl
  have n32 : (32 : W).toNat = 32 := rfl
  have n36 : (36 : W).toNat = 36 := rfl
  have hO4 := (calldataWord call 4).isLt
  rw [BitVec.lt_def, hS, n36] at hA
  have h36 : (36 : W) ≤ BitVec.ofNat 256 call.calldata.size := by
    rw [BitVec.le_def, hS, n36]; omega
  rw [BitVec.lt_def, BitVec.toNat_sub_of_le h36, hS, n36] at hB
  have e0 : (calldataWord call 4 + 4).toNat = (calldataWord call 4).toNat + 4 := by
    rw [BitVec.toNat_add_of_lt] <;> rw [n4]; omega
  have e1 : (calldataWord call 4 + 4 + 32).toNat = (calldataWord call 4).toNat + 36 := by
    rw [BitVec.toNat_add_of_lt] <;> rw [e0, n32] <;> omega
  have hle : calldataWord call 4 + 4 + 32 ≤ BitVec.ofNat 256 call.calldata.size := by
    rw [BitVec.le_def, hS, e1]; omega
  rw [BitVec.lt_def, shr5_toNat, BitVec.toNat_sub_of_le hle, hS, e1] at hC
  exact ⟨by omega, e1, by omega⟩

/-- The words the decoder's copy wrote are the calldata array's, on a call whose checks passed. -/
theorem copy_entry (call : Call) (m : Mem) (fits : call.calldata.size < 2 ^ 64)
    (hA : ¬BitVec.ofNat 256 call.calldata.size < 36)
    (hB : ¬BitVec.ofNat 256 call.calldata.size - 36 < calldataWord call 4)
    (hC : ¬EvmRules.Evm.shr 5 (BitVec.ofNat 256 call.calldata.size - (calldataWord call 4 + 4 + 32)) <
        calldataWord call (calldataWord call 4 + 4)) :
    ∀ j : W, j < calldataWord call (calldataWord call 4 + 4) →
      (m.write 160 (EvmRules.Evm.shl 5 (calldataWord call (calldataWord call 4 + 4))).toNat
        (fun i => calldataByte call ((calldataWord call 4 + 4 + 32).toNat + i))).load
          (128 + 32 + 32 * j : W).toNat =
        calldataWord call (calldataWord call 4 + 4 + 32 + 32 * j) := by
  obtain ⟨hO, e1, hL⟩ := facts call fits hA hB hC
  intro j hj
  rw [BitVec.lt_def] at hj
  obtain ⟨n1, n2, n3, n4, n5⟩ := nums _ _ _ _ fits hO hL hj
  have k32 : (32 : W).toNat = 32 := rfl
  have k160 : (128 + 32 : W).toNat = 160 := rfl
  have ea : (128 + 32 + 32 * j : W).toNat = 160 + 32 * j.toNat := by
    rw [BitVec.toNat_add, k160, BitVec.toNat_mul, k32]; omega
  have ew : (calldataWord call 4 + 4 + 32 + 32 * j).toNat =
      (calldataWord call 4).toNat + 36 + 32 * j.toNat := by
    rw [BitVec.toNat_add, e1, BitVec.toNat_mul, k32]; omega
  rw [shl5_toNat, Nat.mod_eq_of_lt n5, e1, ea]
  apply load_calldatacopy <;> omega


/-! ## The loop's steps -/

theorem fa_step (mem : Mem) (P i i' m m' : W)
    (h : ∀ j, j < i → mem.load (P + 32 + 32 * j).toNat ≤ m) (hm : m ≤ m')
    (hx : mem.load (P + 32 + 32 * i).toNat ≤ m') (hi : i' = i + 1) (ho : i + 1 ≠ 0) :
    ∀ j, j < i' → mem.load (P + 32 + 32 * j).toNat ≤ m' := by
  intro j hj
  by_cases hji : j < i
  · exact BitVec.le_trans (h j hji) hm
  · have : j = i := by subst hi; bv_omega
    subst this; exact hx

theorem ex_keep (mem : Mem) (P B B' m : W) (h : ∃ j, j < B ∧ mem.load (P + 32 + 32 * j).toNat = m)
    (hb : B ≤ B') : ∃ j, j < B' ∧ mem.load (P + 32 + 32 * j).toNat = m := by
  obtain ⟨j, hj, e⟩ := h
  exact ⟨j, by bv_omega, e⟩

theorem ex_new (mem : Mem) (P B i q m : W) (hq : P + 32 + 32 * i = q) (hi : i < B)
    (e : mem.load q.toNat = m) : ∃ j, j < B ∧ mem.load (P + 32 + 32 * j).toNat = m :=
  ⟨i, hi, by rw [hq]; exact e⟩

theorem post_exit (call : Call) (mem mem' : Mem) (i m : W) (st : State)
    (hi : ¬ i < len call) (hle : i ≤ len call)
    (hfa : ∀ j, j < i → mem.load (128 + 32 + 32 * j).toNat ≤ m)
    (hex : ∃ j, j < len call ∧ mem.load (128 + 32 + 32 * j).toNat = m)
    (copy : ∀ j, j < len call → mem.load (128 + 32 + 32 * j).toNat = elem call j) :
    Post call (Halt.ret ((mem'.store 0 m).read 0 32), st) := by
  intro _
  refine ⟨m, by rw [Mem.read_store_same], ?_, ?_⟩
  · intro j hj
    rw [← copy j hj]
    exact hfa j (by bv_omega)
  · obtain ⟨j, hj, e⟩ := hex
    exact ⟨j, hj, (copy j hj) ▸ e⟩

/-- One conjunct of the invariant at the back edge. -/
syntax "am_conj" : tactic
set_option hygiene false in
macro_rules
  | `(tactic| am_conj) => `(tactic| first
    | rfl
    | assumption
    | (refine fa_step _ _ _ _ _ _ ‹_› ?_ ?_ ?_ ?_ <;>
        first | bv_omega | (rw [hptr]; first | exact BitVec.le_refl _ | bv_omega))
    | (refine ex_new _ _ _ _ _ _ hptr ?_ ?_ <;> first | bv_omega | rfl)
    | (refine ex_keep _ _ _ _ _ ‹_› ?_; bv_omega)
    | bv_omega)

macro "rev_leaf" : tactic => `(tactic|
  (unfold Post; dsimp only; intro h; rcases h with h | ⟨_, h⟩ <;> exact Halt.noConfusion h))

end SolarTV.Milestone.ArrayMaxEntry
