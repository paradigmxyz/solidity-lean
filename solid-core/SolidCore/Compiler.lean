theorem ArithOp.assignSeqThenLeaveToFullYul_correct_from
    (firstOp : ArithOp) (state : Core.State)
    (firstLhs firstRhs : Core.TypedExpr Core.Ty.uint256)
    (secondOp : ArithOp)
    (secondLhs secondRhs : Core.TypedExpr Core.Ty.uint256) :
    SolidCoreYulCore.SymYul.evalStmtFuel (secondOp.assignThenLeaveFuel + 1)
        state.toConfig
        (ArithOp.assignSeqThenLeaveToFullYul
          firstOp firstLhs firstRhs secondOp secondLhs secondRhs) =
      (ArithOp.evalAssignSeqThenLeaveFrom firstOp state firstLhs firstRhs
        secondOp secondLhs secondRhs).toSymYulResults := by
  cases firstOp
  · exact ArithOp.addAssignSeqThenLeaveToFullYul_correct_from
      state firstLhs firstRhs secondOp secondLhs secondRhs
  · exact ArithOp.subAssignSeqThenLeaveToFullYul_correct_from
      state firstLhs firstRhs secondOp secondLhs secondRhs
  · exact ArithOp.mulAssignSeqThenLeaveToFullYul_correct_from
      state firstLhs firstRhs secondOp secondLhs secondRhs
  · exact ArithOp.divAssignSeqThenLeaveToFullYul_correct_from
      state firstLhs firstRhs secondOp secondLhs secondRhs
  · exact ArithOp.modAssignSeqThenLeaveToFullYul_correct_from
      state firstLhs firstRhs secondOp secondLhs secondRhs

def ArithOp.ifTrueFuel (op : ArithOp) : Nat := op.fuel + 1

theorem ArithOp.ifTrueToFullYul_correct (op : ArithOp)
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) :
    SolidCoreYulCore.SymYul.evalStmtFuel op.ifTrueFuel
        (Core.State.toConfig { returnValue := 0 })
        (op.ifTrueToFullYul lhs rhs) =
      (op.evalReturn lhs rhs).toSymYulResults := by
  have hCond := Core.TypedExpr.toFullYul_correct_env
    (Core.State.toConfig { returnValue := 0 })
    (Core.TypedExpr.boolLit true)
  have hBranch :
      decide (SolidCoreYulCore.wordModulus = 1) = false := by
    simp [SolidCoreYulCore.wordModulus]
  cases op <;>
    simp [ArithOp.ifTrueFuel, ArithOp.ifTrueToFullYul, ArithOp.fuel,
      ArithOp.toFullYul, ArithOp.evalReturn, Core.TypedExpr.eval,
      SolidCoreYulCore.norm, SolidCoreYulCore.SymYul.evalStmtFuel,
      SolidCoreYulCore.SymYul.branchOn,
      SolidCoreYulCore.SymYul.knownZero?, hCond, hBranch,
      checkedAddReturnFullYul_correct, checkedSubReturnFullYul_correct,
      checkedMulReturnFullYul_correct, checkedDivReturnFullYul_correct,
      checkedModReturnFullYul_correct]

def ArithOp.ifBoolThenElseFuel (_cond : Bool) : Nat := 7

theorem ArithOp.ifBoolThenElseToFullYul_correct (cond : Bool)
    (thenOp : ArithOp) (thenLhs thenRhs : Core.TypedExpr Core.Ty.uint256)
    (elseOp : ArithOp) (elseLhs elseRhs : Core.TypedExpr Core.Ty.uint256) :
    SolidCoreYulCore.SymYul.evalStmtFuel (ArithOp.ifBoolThenElseFuel cond)
        (Core.State.toConfig { returnValue := 0 })
        (ArithOp.ifBoolThenElseToFullYul cond
          thenOp thenLhs thenRhs elseOp elseLhs elseRhs) =
      (ArithOp.ifBoolThenElseEval cond
        thenOp thenLhs thenRhs elseOp elseLhs elseRhs).toSymYulResults := by
  cases cond
  · have hCond := Core.TypedExpr.toFullYul_correct_env
      (Core.State.toConfig { returnValue := 0 })
      (Core.TypedExpr.boolLit false)
    simp [ArithOp.ifBoolThenElseFuel, ArithOp.ifBoolThenElseToFullYul,
      ArithOp.ifBoolThenElseEval, SolidCoreYulCore.SymYul.evalStmtFuel,
      SolidCoreYulCore.SymYul.collectStmtFunctionDefs,
      ArithOp.collectStmtFunctionDefs_toFullYul, Core.TypedExpr.eval,
      SolidCoreYulCore.norm, SolidCoreYulCore.SymYul.branchOn,
      SolidCoreYulCore.SymYul.knownZero?, hCond,
      SolidCoreYulCore.SymYul.bindNormal]
    simpa using ArithOp.toFullYul_correct elseOp elseLhs elseRhs
  · simpa [ArithOp.ifBoolThenElseFuel, ArithOp.ifBoolThenElseToFullYul,
      ArithOp.ifBoolThenElseEval, ArithOp.ifTrueFuel] using
      ArithOp.ifTrueToFullYul_correct thenOp thenLhs thenRhs

def ArithOp.ifExprThenElseFuel (cond : Core.TypedExpr Core.Ty.bool) : Nat :=
  if SolidCoreYulCore.norm cond.eval = 0 then 7 else 8

theorem ArithOp.ifExprThenElseToFullYul_correct
    (cond : Core.TypedExpr Core.Ty.bool)
    (thenOp : ArithOp) (thenLhs thenRhs : Core.TypedExpr Core.Ty.uint256)
    (elseOp : ArithOp) (elseLhs elseRhs : Core.TypedExpr Core.Ty.uint256) :
    SolidCoreYulCore.SymYul.evalStmtFuel
        (ArithOp.ifExprThenElseFuel cond)
        (Core.State.toConfig { returnValue := 0 })
        (ArithOp.ifExprThenElseToFullYul cond
          thenOp thenLhs thenRhs elseOp elseLhs elseRhs) =
      (ArithOp.ifExprThenElseEval cond
        thenOp thenLhs thenRhs elseOp elseLhs elseRhs).toSymYulResults := by
  by_cases hCond : SolidCoreYulCore.norm cond.eval = 0
  · have hRaw : cond.eval % SolidCoreYulCore.wordModulus = 0 := by
      simpa [SolidCoreYulCore.norm] using hCond
    have hEval := Core.TypedExpr.toFullYul_correct_env
      (Core.State.toConfig { returnValue := 0 }) cond
    simp [ArithOp.ifExprThenElseFuel, ArithOp.ifExprThenElseToFullYul,
      ArithOp.ifExprThenElseEval, hCond,
      SolidCoreYulCore.SymYul.evalStmtFuel,
      SolidCoreYulCore.SymYul.collectStmtFunctionDefs,
      ArithOp.collectStmtFunctionDefs_toFullYul,
      SolidCoreYulCore.SymYul.branchOn,
      SolidCoreYulCore.SymYul.knownZero?, hEval,
      SolidCoreYulCore.norm, hRaw,
      SolidCoreYulCore.SymYul.bindNormal]
    simpa using ArithOp.toFullYul_correct elseOp elseLhs elseRhs
  · have hRaw : cond.eval % SolidCoreYulCore.wordModulus ≠ 0 := by
      simpa [SolidCoreYulCore.norm] using hCond
    have hEval := Core.TypedExpr.toFullYul_correct_env
      (Core.State.toConfig { returnValue := 0 }) cond
    simp [ArithOp.ifExprThenElseFuel, ArithOp.ifExprThenElseToFullYul,
      ArithOp.ifExprThenElseEval, hCond,
      SolidCoreYulCore.SymYul.evalStmtFuel,
      SolidCoreYulCore.SymYul.collectStmtFunctionDefs,
      ArithOp.collectStmtFunctionDefs_toFullYul,
      SolidCoreYulCore.SymYul.branchOn,
      SolidCoreYulCore.SymYul.knownZero?, hEval,
      SolidCoreYulCore.norm, hRaw,
      SolidCoreYulCore.SymYul.bindNormal]
    have hThen :
        SolidCoreYulCore.SymYul.evalStmtFuel 6
            (Core.State.toConfig { returnValue := 0 })
            (thenOp.toFullYul thenLhs thenRhs) =
          (thenOp.evalReturn thenLhs thenRhs).toSymYulResults := by
      simpa [ArithOp.fuel] using
        ArithOp.toFullYul_correct thenOp thenLhs thenRhs
    rw [hThen]
    cases thenOp.evalReturn thenLhs thenRhs <;> rfl

