structure SourceToCoreArtifact where
  source : String
  program : Solidity.Program
  core : Solidity.Core.AcceptedProgram
  parsed : parse source = some program
  elaborated : program.toCore? = some core
  compiled : compileToCore? source = some core

def compileSourceToCoreArtifact (source : String) :
    Option SourceToCoreArtifact :=
  match hParse : parse source with
  | some program =>
      match hCore : program.toCore? with
      | some core =>
          some
            { source := source
              program := program
              core := core
              parsed := hParse
              elaborated := hCore
              compiled := by
                simp [compileToCore?, hParse, hCore] }
      | none => none
  | none => none

