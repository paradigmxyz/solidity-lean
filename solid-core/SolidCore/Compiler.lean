def Program.toInternalCallCore? : Program -> Option Core.InternalCall.Stmt
  | Program.functionBody Body.internalCallReturn =>
      some Core.InternalCall.Stmt.noArgReturn
  | Program.internalCallArgReturn =>
      some Core.InternalCall.Stmt.argReturn
  | Program.internalCallMultiReturn =>
      some Core.InternalCall.Stmt.multiReturn
  | _ => none

theorem Program.toFullYulStmt_eq_internalCallCore_of_some
    {program : Program} {core : Core.InternalCall.Stmt}
    (h : program.toInternalCallCore? = some core) :
    program.toFullYulStmt = core.toFullYul := by
  cases program <;> simp [Program.toInternalCallCore?] at h
  · rename_i body
    cases body <;> simp [Program.toInternalCallCore?] at h
    cases h
    rfl
  · cases h
    rfl
  · cases h
    rfl

theorem Program.toInternalCallCore?_some_toProgram
    {program : Program} {core : Core.InternalCall.Stmt}
    (h : program.toInternalCallCore? = some core) :
    core.toProgram = program := by
  cases program <;> simp [Program.toInternalCallCore?] at h
  · rename_i body
    cases body <;> simp [Program.toInternalCallCore?] at h
    cases h
    rfl
  · cases h
    rfl
  · cases h
    rfl

theorem Program.toFullYulStmt_correct_via_internalCallCore_of_some
    {program : Program} {core : Core.InternalCall.Stmt}
    (h : program.toInternalCallCore? = some core) :
    SolidCoreYulCore.SymYul.evalStmtFuel
        program.stmtFuel
        Body.initialSymYulConfig
        program.toFullYulStmt =
      [SolidCoreYulCore.SymYul.normalResult program.finalSymYulConfig] := by
  rw [Program.toFullYulStmt_eq_internalCallCore_of_some h]
  have hProgram := Program.toInternalCallCore?_some_toProgram h
  have hFuel : core.fuel = program.stmtFuel := by
    cases core <;> cases hProgram <;> rfl
  rw [← hFuel]
  simpa [hProgram] using Core.InternalCall.Stmt.toFullYul_correct core

theorem Program.internalCallCore_toFullYul_correct_of_some
    {program : Program} {core : Core.InternalCall.Stmt}
    (h : program.toInternalCallCore? = some core) :
    SolidCoreYulCore.SymYul.evalStmtFuel
        program.stmtFuel
        Body.initialSymYulConfig
        core.toFullYul =
      [SolidCoreYulCore.SymYul.normalResult program.finalSymYulConfig] := by
  rw [← Program.toFullYulStmt_eq_internalCallCore_of_some h]
  exact Program.toFullYulStmt_correct_via_internalCallCore_of_some h

