def Body.toFullYul : Body -> SolidCoreYulCore.FullYul.Stmt
  | Body.returnExpr expr =>
      SolidCoreYulCore.FullYul.Stmt.assign returnName expr.toFullYul
  | Body.seqExpr _ rest =>
      SolidCoreYulCore.FullYul.Stmt.seq
        SolidCoreYulCore.FullYul.Stmt.skip
        rest.toFullYul
  | Body.block body =>
      SolidCoreYulCore.FullYul.Stmt.block [body.toFullYul]
  | Body.localValue init =>
      Body.localValueFullYul init
  | Body.localUpdateValue init assigned =>
      Body.localUpdateValueFullYul init assigned
  | Body.localPairAddValue lhs rhs =>
      Body.localPairAddValueFullYul lhs rhs
  | Body.localPairUpdateAddValue initLhs initRhs assignedLhs assignedRhs =>
      Body.localPairUpdateAddValueFullYul initLhs initRhs assignedLhs
        assignedRhs
  | Body.forNeverReturn afterExpr loopExpr =>
      Body.forNeverReturnFullYul afterExpr loopExpr
  | Body.forBreakReturn afterExpr =>
      Body.forBreakReturnFullYul afterExpr
  | Body.forContinueReturn afterExpr =>
      Body.forContinueReturnFullYul afterExpr
  | Body.internalCallReturn =>
      Body.internalCallReturnFullYul
  | Body.ifReturn cond thenExpr elseExpr =>
      Body.ifReturnFullYul cond thenExpr elseExpr
  | Body.ifThenBodyElseReturn cond thenBody elseExpr =>
      SolidCoreYulCore.FullYul.Stmt.seq
        (SolidCoreYulCore.FullYul.Stmt.assign returnName elseExpr.toFullYul)
        (SolidCoreYulCore.FullYul.Stmt.ifThen cond.toFullYul
          thenBody.toFullYul)
  | Body.ifThenReturnElseBody cond thenExpr elseBody =>
      SolidCoreYulCore.FullYul.Stmt.seq
        elseBody.toFullYul
        (SolidCoreYulCore.FullYul.Stmt.ifThen cond.toFullYul
          (SolidCoreYulCore.FullYul.Stmt.assign returnName thenExpr.toFullYul))

theorem Body.toFullYul_compilerEmittable (body : Body) :
    SolidCoreYulCore.FullYul.CompilerEmittableStmt
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      body.toFullYul := by
  induction body with
  | returnExpr expr =>
      simpa [Body.toFullYul] using
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.assign
          (name := returnName)
          (Expr.toFullYul_compilerEmittable expr)
  | seqExpr expr rest rest_ih =>
      simpa [Body.toFullYul] using
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.seq
          SolidCoreYulCore.FullYul.CompilerEmittableStmt.skip
          rest_ih
  | block body body_ih =>
      simpa [Body.toFullYul] using
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.block
          (SolidCoreYulCore.FullYul.CompilerEmittableBlock.cons
            body_ih
            SolidCoreYulCore.FullYul.CompilerEmittableBlock.nil)
  | localValue init =>
      simpa [Body.toFullYul, Body.localValueFullYul] using
        BodyLocalFrame1.toFullYul_compilerEmittable
          (BodyLocalFrame1.returnInit init)
  | localUpdateValue init assigned =>
      simpa [Body.toFullYul, Body.localUpdateValueFullYul] using
        BodyLocalFrame1.toFullYul_compilerEmittable
          (BodyLocalFrame1.updateValue init assigned)
  | localPairAddValue lhs rhs =>
      simpa [Body.toFullYul, Body.localPairAddValueFullYul] using
        BodyLocalFrame2.toFullYul_compilerEmittable
          (BodyLocalFrame2.addReturn lhs rhs)
  | localPairUpdateAddValue initLhs initRhs assignedLhs assignedRhs =>
      simpa [Body.toFullYul, Body.localPairUpdateAddValueFullYul] using
        BodyLocalFrame2.toFullYul_compilerEmittable
          (BodyLocalFrame2.assignAddReturn initLhs initRhs
            assignedLhs assignedRhs)
  | forNeverReturn afterExpr loopExpr =>
      have hAfter := Expr.toFullYul_compilerEmittable afterExpr
      have hLoop := Expr.toFullYul_compilerEmittable loopExpr
      have hAssignAfter :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.assign
          (name := returnName) hAfter
      have hAssignLoop :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.assign
          (name := returnName) hLoop
      have hFor :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.forLoop
          SolidCoreYulCore.FullYul.CompilerEmittableStmt.skip
          (currentSolidCore_value_word_compilerEmittable 0)
          SolidCoreYulCore.FullYul.CompilerEmittableStmt.skip
          hAssignLoop
      simpa [Body.toFullYul, Body.forNeverReturnFullYul] using
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.seq
          hAssignAfter hFor
  | forBreakReturn afterExpr =>
      have hAfter := Expr.toFullYul_compilerEmittable afterExpr
      have hFor :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.forLoop
          SolidCoreYulCore.FullYul.CompilerEmittableStmt.skip
          (currentSolidCore_value_word_compilerEmittable 1)
          SolidCoreYulCore.FullYul.CompilerEmittableStmt.skip
          SolidCoreYulCore.FullYul.CompilerEmittableStmt.break
      have hAssignAfter :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.assign
          (name := returnName) hAfter
      simpa [Body.toFullYul, Body.forBreakReturnFullYul] using
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.seq
          hFor hAssignAfter
  | forContinueReturn afterExpr =>
      have hAfter := Expr.toFullYul_compilerEmittable afterExpr
      have hAssignOne :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.assign
          (name := returnName)
          (currentSolidCore_value_word_compilerEmittable 1)
      have hAssignZero :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.assign
          (name := returnName)
          (currentSolidCore_value_word_compilerEmittable 0)
      have hFor :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.forLoop
          SolidCoreYulCore.FullYul.CompilerEmittableStmt.skip
          (currentSolidCore_var_compilerEmittable returnName)
          hAssignZero
          SolidCoreYulCore.FullYul.CompilerEmittableStmt.continue
      have hAssignAfter :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.assign
          (name := returnName) hAfter
      simpa [Body.toFullYul, Body.forContinueReturnFullYul] using
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.seq hAssignOne
          (SolidCoreYulCore.FullYul.CompilerEmittableStmt.seq hFor
            hAssignAfter)
  | internalCallReturn =>
      have hFunBody :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.assign
          (name := localName)
          (currentSolidCore_value_word_compilerEmittable 7)
      have hFun :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.funDef
          (name := internalFunctionName) (params := [])
          (returns := [localName])
          (body := SolidCoreYulCore.FullYul.Stmt.assign localName
            (SolidCoreYulCore.FullYul.Expr.value
              (SolidCoreYulCore.FullYul.Value.word 7)))
          trivial hFunBody
      have hCall :
          SolidCoreYulCore.FullYul.CompilerEmittableStmt
            SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
            (SolidCoreYulCore.FullYul.Stmt.assignCall [returnName]
              internalFunctionName []) :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.assignCall
          (names := [returnName]) (fnName := internalFunctionName)
          (args := [])
          trivial
          SolidCoreYulCore.FullYul.CompilerEmittableExprs.nil
      simpa [Body.toFullYul, Body.internalCallReturnFullYul] using
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.block
          (SolidCoreYulCore.FullYul.CompilerEmittableBlock.cons hFun
            (SolidCoreYulCore.FullYul.CompilerEmittableBlock.cons hCall
              SolidCoreYulCore.FullYul.CompilerEmittableBlock.nil))
  | ifReturn cond thenExpr elseExpr =>
      have hElse := Expr.toFullYul_compilerEmittable elseExpr
      have hCond := Expr.toFullYul_compilerEmittable cond
      have hThen := Expr.toFullYul_compilerEmittable thenExpr
      have hAssignElse :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.assign
          (name := returnName) hElse
      have hAssignThen :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.assign
          (name := returnName) hThen
      have hIf :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.ifThen
          hCond hAssignThen
      simpa [Body.toFullYul, Body.ifReturnFullYul] using
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.seq
          hAssignElse hIf
  | ifThenBodyElseReturn cond thenBody elseExpr then_ih =>
      have hElse := Expr.toFullYul_compilerEmittable elseExpr
      have hCond := Expr.toFullYul_compilerEmittable cond
      have hAssignElse :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.assign
          (name := returnName) hElse
      have hIf :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.ifThen
          hCond then_ih
      simpa [Body.toFullYul] using
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.seq
          hAssignElse hIf
  | ifThenReturnElseBody cond thenExpr elseBody else_ih =>
      have hCond := Expr.toFullYul_compilerEmittable cond
      have hThen := Expr.toFullYul_compilerEmittable thenExpr
      have hAssignThen :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.assign
          (name := returnName) hThen
      have hIf :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.ifThen
          hCond hAssignThen
      simpa [Body.toFullYul] using
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.seq
          else_ih hIf

def Body.ifThenReturnElseBodyFullYul
    (cond thenExpr : Expr) (elseBody : Body) :
    SolidCoreYulCore.FullYul.Stmt :=
  SolidCoreYulCore.FullYul.Stmt.seq
    elseBody.toFullYul
    (SolidCoreYulCore.FullYul.Stmt.ifThen cond.toFullYul
      (SolidCoreYulCore.FullYul.Stmt.assign returnName thenExpr.toFullYul))

def Body.ifThenBodyElseReturnFullYul
    (cond : Expr) (thenBody : Body) (elseExpr : Expr) :
    SolidCoreYulCore.FullYul.Stmt :=
  SolidCoreYulCore.FullYul.Stmt.seq
    (SolidCoreYulCore.FullYul.Stmt.assign returnName elseExpr.toFullYul)
    (SolidCoreYulCore.FullYul.Stmt.ifThen cond.toFullYul thenBody.toFullYul)

@[simp] theorem collectStmtFunctionDefs_expr
    (expr : SolidCoreYulCore.FullYul.Expr)
    (funcs : SolidCoreYulCore.SymYul.FunctionEnv) :
    SolidCoreYulCore.SymYul.collectStmtFunctionDefs
        (SolidCoreYulCore.FullYul.Stmt.expr expr) funcs =
      funcs := by
  rfl

@[simp] theorem collectStmtFunctionDefs_assign
    (name : SolidCoreYulCore.FullYul.Name)
    (expr : SolidCoreYulCore.FullYul.Expr)
    (funcs : SolidCoreYulCore.SymYul.FunctionEnv) :
    SolidCoreYulCore.SymYul.collectStmtFunctionDefs
        (SolidCoreYulCore.FullYul.Stmt.assign name expr) funcs =
      funcs := by
  rfl

@[simp] theorem collectStmtFunctionDefs_assignMany
    (names : List SolidCoreYulCore.FullYul.Name)
    (exprs : List SolidCoreYulCore.FullYul.Expr)
    (funcs : SolidCoreYulCore.SymYul.FunctionEnv) :
    SolidCoreYulCore.SymYul.collectStmtFunctionDefs
        (SolidCoreYulCore.FullYul.Stmt.assignMany names exprs) funcs =
      funcs := by
  rfl

@[simp] theorem collectStmtFunctionDefs_ifThen
    (cond : SolidCoreYulCore.FullYul.Expr)
    (body : SolidCoreYulCore.FullYul.Stmt)
    (funcs : SolidCoreYulCore.SymYul.FunctionEnv) :
    SolidCoreYulCore.SymYul.collectStmtFunctionDefs
        (SolidCoreYulCore.FullYul.Stmt.ifThen cond body) funcs =
      funcs := by
  rfl

@[simp] theorem collectStmtFunctionDefs_forLoop
    (pre : SolidCoreYulCore.FullYul.Stmt)
    (cond : SolidCoreYulCore.FullYul.Expr)
    (post body : SolidCoreYulCore.FullYul.Stmt)
    (funcs : SolidCoreYulCore.SymYul.FunctionEnv) :
    SolidCoreYulCore.SymYul.collectStmtFunctionDefs
        (SolidCoreYulCore.FullYul.Stmt.forLoop pre cond post body) funcs =
      funcs := by
  rfl

@[simp] theorem collectStmtFunctionDefs_block
    (stmts : List SolidCoreYulCore.FullYul.Stmt)
    (funcs : SolidCoreYulCore.SymYul.FunctionEnv) :
    SolidCoreYulCore.SymYul.collectStmtFunctionDefs
        (SolidCoreYulCore.FullYul.Stmt.block stmts) funcs =
      funcs := by
  rfl

@[simp] theorem collectStmtFunctionDefs_seq
    (first second : SolidCoreYulCore.FullYul.Stmt)
    (funcs : SolidCoreYulCore.SymYul.FunctionEnv) :
    SolidCoreYulCore.SymYul.collectStmtFunctionDefs
        (SolidCoreYulCore.FullYul.Stmt.seq first second) funcs =
      SolidCoreYulCore.SymYul.collectStmtFunctionDefs second
        (SolidCoreYulCore.SymYul.collectStmtFunctionDefs first funcs) := by
  rfl

@[simp] theorem Body.collectStmtFunctionDefs_toFullYul
    (body : Body) (funcs : SolidCoreYulCore.SymYul.FunctionEnv) :
    SolidCoreYulCore.SymYul.collectStmtFunctionDefs body.toFullYul funcs =
      funcs := by
  induction body with
  | returnExpr expr =>
      simp [Body.toFullYul, SolidCoreYulCore.SymYul.collectStmtFunctionDefs]
  | seqExpr expr rest rest_ih =>
      simp [Body.toFullYul, SolidCoreYulCore.SymYul.collectStmtFunctionDefs,
        rest_ih]
  | block body body_ih =>
      simp [Body.toFullYul, SolidCoreYulCore.SymYul.collectStmtFunctionDefs]
  | localValue init =>
      simp [Body.toFullYul, Body.localValueFullYul,
        BodyLocalFrame1.toFullYul,
        SolidCoreYulCore.SymYul.collectStmtFunctionDefs]
  | localUpdateValue init assigned =>
      simp [Body.toFullYul, Body.localUpdateValueFullYul,
        BodyLocalFrame1.toFullYul,
        SolidCoreYulCore.SymYul.collectStmtFunctionDefs]
  | localPairAddValue lhs rhs =>
      simp [Body.toFullYul, Body.localPairAddValueFullYul,
        BodyLocalFrame2.toFullYul,
        SolidCoreYulCore.SymYul.collectStmtFunctionDefs]
  | localPairUpdateAddValue initLhs initRhs assignedLhs assignedRhs =>
      simp [Body.toFullYul, Body.localPairUpdateAddValueFullYul,
        BodyLocalFrame2.toFullYul,
        SolidCoreYulCore.SymYul.collectStmtFunctionDefs]
  | forNeverReturn afterExpr loopExpr =>
      simp [Body.toFullYul, Body.forNeverReturnFullYul,
        SolidCoreYulCore.SymYul.collectStmtFunctionDefs]
  | forBreakReturn afterExpr =>
      simp [Body.toFullYul, Body.forBreakReturnFullYul,
        SolidCoreYulCore.SymYul.collectStmtFunctionDefs]
  | forContinueReturn afterExpr =>
      simp [Body.toFullYul, Body.forContinueReturnFullYul,
        SolidCoreYulCore.SymYul.collectStmtFunctionDefs]
  | internalCallReturn =>
      simp [Body.toFullYul, Body.internalCallReturnFullYul,
        SolidCoreYulCore.SymYul.collectStmtFunctionDefs]
  | ifReturn cond thenExpr elseExpr =>
      simp [Body.toFullYul, Body.ifReturnFullYul,
        SolidCoreYulCore.SymYul.collectStmtFunctionDefs]
  | ifThenBodyElseReturn cond thenBody elseExpr thenBody_ih =>
      simp [Body.toFullYul,
        SolidCoreYulCore.SymYul.collectStmtFunctionDefs, thenBody_ih]
  | ifThenReturnElseBody cond thenExpr elseBody elseBody_ih =>
      simp [Body.toFullYul, Body.ifThenReturnElseBodyFullYul,
        SolidCoreYulCore.SymYul.collectStmtFunctionDefs, elseBody_ih]

@[simp] theorem collectBlockFunctionDefs_single_toFullYul
    (body : Body) (funcs : SolidCoreYulCore.SymYul.FunctionEnv) :
    SolidCoreYulCore.SymYul.collectBlockFunctionDefs [body.toFullYul] funcs =
      funcs := by
  simp [SolidCoreYulCore.SymYul.collectBlockFunctionDefs]

def Body.initialFullYulEnv : SolidCoreYulCore.FullYul.Env :=
  Body.returnEnv 0

def Body.finalFullYulEnv (body : Body) : SolidCoreYulCore.FullYul.Env :=
  Body.returnEnv body.eval

def Body.initialSymYulConfig : SolidCoreYulCore.SymYul.Config :=
  { SolidCoreYulCore.SymYul.Config.empty with env := Body.initialFullYulEnv }

@[simp] theorem Body.returnConfig_halt? (value : Word) :
    (Body.returnConfig value).evm.halt? = none := by
  rfl

def Body.finalSymYulConfig (body : Body) : SolidCoreYulCore.SymYul.Config :=
  Body.returnConfig body.eval

def Body.ifReturnFinalFullYulEnv (cond thenExpr elseExpr : Expr) :
    SolidCoreYulCore.FullYul.Env :=
  Body.returnEnv (Body.ifReturnEval cond thenExpr elseExpr)

theorem Body.ifReturnFullYul_correct_from
    (startValue : Word) (cond thenExpr elseExpr : Expr) :
    SolidCoreYulCore.SymYul.evalStmtFuel 4 (Body.returnConfig startValue)
        (Body.ifReturnFullYul cond thenExpr elseExpr) =
      [SolidCoreYulCore.SymYul.normalResult
        (Body.returnConfig (Body.ifReturnEval cond thenExpr elseExpr))] := by
  by_cases hCond : SolidCoreYulCore.norm cond.eval = 0
  · simp [Body.ifReturnFullYul, Body.ifReturnFinalFullYulEnv,
      Body.ifReturnEval, Body.returnConfig, Body.returnEnv, hCond,
      SolidCoreYulCore.SymYul.evalStmtFuel,
      SolidCoreYulCore.SymYul.evalExpr,
      SolidCoreYulCore.SymYul.evalExprs,
      SolidCoreYulCore.SymYul.branchOn,
      SolidCoreYulCore.SymYul.knownZero?,
      SolidCoreYulCore.SymYul.bindNormal,
      SolidCoreYulCore.SymYul.normalResult,
      SolidCoreYulCore.SymYul.resultAfterExpr,
      SolidCoreYulCore.FullYul.assign?,
      Expr.toFullYul_correct_env]
  · simp [Body.ifReturnFullYul, Body.ifReturnFinalFullYulEnv,
      Body.ifReturnEval, Body.returnConfig, Body.returnEnv, hCond,
      SolidCoreYulCore.SymYul.evalStmtFuel,
      SolidCoreYulCore.SymYul.evalExpr,
      SolidCoreYulCore.SymYul.evalExprs,
      SolidCoreYulCore.SymYul.branchOn,
      SolidCoreYulCore.SymYul.knownZero?,
      SolidCoreYulCore.SymYul.bindNormal,
      SolidCoreYulCore.SymYul.normalResult,
      SolidCoreYulCore.SymYul.resultAfterExpr,
      SolidCoreYulCore.FullYul.assign?,
      Expr.toFullYul_correct_env]

theorem Body.ifReturnFullYul_correct (cond thenExpr elseExpr : Expr) :
    SolidCoreYulCore.SymYul.evalStmtFuel 4 Body.initialSymYulConfig
        (Body.ifReturnFullYul cond thenExpr elseExpr) =
      [SolidCoreYulCore.SymYul.normalResult
        (Body.returnConfig (Body.ifReturnEval cond thenExpr elseExpr))] := by
  simpa [Body.initialSymYulConfig, Body.returnConfig, Body.initialFullYulEnv] using
    Body.ifReturnFullYul_correct_from 0 cond thenExpr elseExpr

theorem Body.toFullYul_correct_from (startValue : Word) (body : Body) :
    SolidCoreYulCore.SymYul.evalStmtFuel body.fuel
        (Body.returnConfig startValue) body.toFullYul =
      [SolidCoreYulCore.SymYul.normalResult body.finalSymYulConfig] := by
  induction body generalizing startValue with
  | returnExpr expr =>
      simp [Body.fuel, Body.returnConfig, Body.returnEnv, Body.finalSymYulConfig,
        Body.toFullYul, Body.eval,
        SolidCoreYulCore.SymYul.evalStmtFuel,
        SolidCoreYulCore.SymYul.evalExpr,
        SolidCoreYulCore.SymYul.evalExprs,
        SolidCoreYulCore.SymYul.normalResult,
        SolidCoreYulCore.FullYul.assign?, Expr.toFullYul_correct_env]
  | seqExpr expr rest rest_ih =>
      cases hFuel : rest.fuel with
      | zero =>
          cases rest <;> simp [Body.fuel] at hFuel
      | succ fuel =>
          simp [Body.fuel, Body.toFullYul, hFuel,
            SolidCoreYulCore.SymYul.evalStmtFuel,
            SolidCoreYulCore.SymYul.bindNormal,
            SolidCoreYulCore.SymYul.normalResult]
          simpa [Body.finalSymYulConfig, hFuel] using rest_ih startValue
  | block body body_ih =>
      cases hFuel : body.fuel with
      | zero =>
          cases body <;> simp [Body.fuel] at hFuel
      | succ fuel =>
          have hBody :
              SolidCoreYulCore.SymYul.evalStmtFuel (fuel + 1)
                  { SolidCoreYulCore.SymYul.Config.empty with
                    env := [(returnName,
                      SolidCoreYulCore.FullYul.Value.word startValue)] }
                  body.toFullYul =
                [SolidCoreYulCore.SymYul.normalResult body.finalSymYulConfig] := by
            simpa [Body.returnConfig, Body.returnEnv, hFuel] using
              body_ih startValue
          simp [Body.fuel, Body.toFullYul, Body.eval, hFuel,
            SolidCoreYulCore.SymYul.evalStmtFuel,
            SolidCoreYulCore.SymYul.evalBlockFuel,
            SolidCoreYulCore.SymYul.bindNormal,
            SolidCoreYulCore.SymYul.withRestoredConfig,
            SolidCoreYulCore.SymYul.restoreBlockConfig,
            SolidCoreYulCore.SymYul.normalResult,
            SolidCoreYulCore.FullYul.restoreOuter,
            SolidCoreYulCore.FullYul.lookup?,
            Body.finalSymYulConfig, Body.returnConfig, Body.returnEnv, hBody]
  | localValue init =>
      simpa [Body.fuel, Body.toFullYul, Body.localValueFullYul,
        Body.eval, Body.finalSymYulConfig, BodyLocalFrame1.fuel,
        BodyLocalFrame1.eval] using
        BodyLocalFrame1.toFullYul_correct_from startValue
          (BodyLocalFrame1.returnInit init)
  | localUpdateValue init assigned =>
      simpa [Body.fuel, Body.toFullYul, Body.localUpdateValueFullYul,
        Body.eval, Body.finalSymYulConfig, BodyLocalFrame1.fuel,
        BodyLocalFrame1.eval] using
        BodyLocalFrame1.toFullYul_correct_from startValue
          (BodyLocalFrame1.updateValue init assigned)
  | localPairAddValue lhs rhs =>
      simpa [Body.fuel, Body.toFullYul, Body.localPairAddValueFullYul,
        Body.eval, Body.finalSymYulConfig, BodyLocalFrame2.fuel,
        BodyLocalFrame2.eval] using
        BodyLocalFrame2.toFullYul_correct_from startValue
          (BodyLocalFrame2.addReturn lhs rhs)
  | localPairUpdateAddValue initLhs initRhs assignedLhs assignedRhs =>
      simpa [Body.fuel, Body.toFullYul, Body.localPairUpdateAddValueFullYul,
        Body.eval, Body.finalSymYulConfig, BodyLocalFrame2.fuel,
        BodyLocalFrame2.eval] using
        BodyLocalFrame2.toFullYul_correct_from startValue
          (BodyLocalFrame2.assignAddReturn initLhs initRhs
            assignedLhs assignedRhs)
  | forNeverReturn afterExpr loopExpr =>
      simp [Body.fuel, Body.toFullYul, Body.forNeverReturnFullYul, Body.eval,
        Body.finalSymYulConfig, Body.returnConfig, Body.returnEnv,
        returnName,
        SolidCoreYulCore.SymYul.evalStmtFuel,
        SolidCoreYulCore.SymYul.evalForFuel,
        SolidCoreYulCore.SymYul.evalExpr,
        SolidCoreYulCore.SymYul.evalExprs,
        SolidCoreYulCore.SymYul.branchOn,
        SolidCoreYulCore.SymYul.knownZero?,
        SolidCoreYulCore.SymYul.bindNormal,
        SolidCoreYulCore.SymYul.withRestoredConfig,
        SolidCoreYulCore.SymYul.restoreBlockConfig,
        SolidCoreYulCore.SymYul.normalResult,
        SolidCoreYulCore.SymYul.Config.empty,
        SolidCoreYulCore.FullYul.assign?,
        SolidCoreYulCore.FullYul.lookup?,
        SolidCoreYulCore.FullYul.restoreOuter,
        SolidCoreYulCore.FullYul.EvmState.empty,
        SolidCoreYulCore.norm,
        SolidCoreYulCore.wordModulus,
        Expr.toFullYul_correct_env]
  | forBreakReturn afterExpr =>
      simp [Body.fuel, Body.toFullYul, Body.forBreakReturnFullYul, Body.eval,
        Body.finalSymYulConfig, Body.returnConfig, Body.returnEnv,
        returnName,
        SolidCoreYulCore.SymYul.evalStmtFuel,
        SolidCoreYulCore.SymYul.evalForFuel,
        SolidCoreYulCore.SymYul.evalExpr,
        SolidCoreYulCore.SymYul.evalExprs,
        SolidCoreYulCore.SymYul.branchOn,
        SolidCoreYulCore.SymYul.knownZero?,
        SolidCoreYulCore.SymYul.bindNormal,
        SolidCoreYulCore.SymYul.withRestoredConfig,
        SolidCoreYulCore.SymYul.restoreBlockConfig,
        SolidCoreYulCore.SymYul.normalResult,
        SolidCoreYulCore.FullYul.assign?,
        SolidCoreYulCore.FullYul.lookup?,
        SolidCoreYulCore.FullYul.restoreOuter,
        SolidCoreYulCore.norm,
        SolidCoreYulCore.wordModulus,
        Expr.toFullYul_correct_env]
  | forContinueReturn afterExpr =>
      simp [Body.fuel, Body.toFullYul, Body.forContinueReturnFullYul,
        Body.eval, Body.finalSymYulConfig, Body.returnConfig, Body.returnEnv,
        returnName,
        SolidCoreYulCore.SymYul.evalStmtFuel,
        SolidCoreYulCore.SymYul.evalForFuel,
        SolidCoreYulCore.SymYul.evalExpr,
        SolidCoreYulCore.SymYul.evalExprs,
        SolidCoreYulCore.SymYul.branchOn,
        SolidCoreYulCore.SymYul.knownZero?,
        SolidCoreYulCore.SymYul.bindNormal,
        SolidCoreYulCore.SymYul.withRestoredConfig,
        SolidCoreYulCore.SymYul.restoreBlockConfig,
        SolidCoreYulCore.SymYul.normalResult,
        SolidCoreYulCore.FullYul.assign?,
        SolidCoreYulCore.FullYul.lookup?,
        SolidCoreYulCore.FullYul.restoreOuter,
        SolidCoreYulCore.norm,
        SolidCoreYulCore.wordModulus,
        Expr.toFullYul_correct_env]
  | internalCallReturn =>
      simp [Body.fuel, Body.toFullYul, Body.internalCallReturnFullYul,
        Body.eval, Body.finalSymYulConfig, Body.returnConfig, Body.returnEnv,
        returnName, localName, internalFunctionName,
        SolidCoreYulCore.SymYul.evalStmtFuel,
        SolidCoreYulCore.SymYul.evalBlockFuel,
        SolidCoreYulCore.SymYul.evalFunctionFuel,
        SolidCoreYulCore.SymYul.evalExprs,
        SolidCoreYulCore.SymYul.evalExprsAsYulValues,
        SolidCoreYulCore.SymYul.evalExpr,
        SolidCoreYulCore.SymYul.bindNormal,
        SolidCoreYulCore.SymYul.withRestoredConfig,
        SolidCoreYulCore.SymYul.restoreBlockConfig,
        SolidCoreYulCore.SymYul.returnValues?,
        SolidCoreYulCore.SymYul.normalResult,
        SolidCoreYulCore.SymYul.Config.empty,
        SolidCoreYulCore.SymYul.collectBlockFunctionDefs,
        SolidCoreYulCore.SymYul.collectStmtFunctionDefs,
        SolidCoreYulCore.SymYul.declareFunction,
        SolidCoreYulCore.FullYul.initFunctionEnv,
        SolidCoreYulCore.FullYul.FunctionDef,
        SolidCoreYulCore.FullYul.declareMany?,
        SolidCoreYulCore.FullYul.declare?,
        SolidCoreYulCore.FullYul.assignMany?,
        SolidCoreYulCore.FullYul.assign?,
        SolidCoreYulCore.FullYul.lookupFunction?,
        SolidCoreYulCore.FullYul.lookup?,
        SolidCoreYulCore.FullYul.valuesForNames?,
        SolidCoreYulCore.FullYul.restoreOuter,
        SolidCoreYulCore.norm, SolidCoreYulCore.wordModulus]
  | ifReturn cond thenExpr elseExpr =>
      simpa [Body.fuel, Body.toFullYul, Body.eval, Body.finalFullYulEnv]
        using Body.ifReturnFullYul_correct_from startValue cond thenExpr elseExpr
  | ifThenBodyElseReturn cond thenBody elseExpr thenBody_ih =>
      by_cases hCond : SolidCoreYulCore.norm cond.eval = 0
      · simp [Body.fuel, Body.toFullYul, Body.ifThenBodyElseReturnFullYul,
          Body.eval, Body.ifThenBodyElseReturnEval, Body.finalSymYulConfig,
          Body.returnConfig, Body.returnEnv, hCond,
          SolidCoreYulCore.SymYul.evalStmtFuel,
          SolidCoreYulCore.SymYul.evalExpr,
          SolidCoreYulCore.SymYul.evalExprs,
          SolidCoreYulCore.SymYul.branchOn,
          SolidCoreYulCore.SymYul.knownZero?,
          SolidCoreYulCore.SymYul.bindNormal,
          SolidCoreYulCore.SymYul.normalResult,
          SolidCoreYulCore.SymYul.resultAfterExpr,
          SolidCoreYulCore.FullYul.assign?,
          Expr.toFullYul_correct_env]
      · have hThen :
            SolidCoreYulCore.SymYul.evalStmtFuel thenBody.fuel
                (Body.returnConfig elseExpr.eval) thenBody.toFullYul =
              [SolidCoreYulCore.SymYul.normalResult
                thenBody.finalSymYulConfig] :=
          thenBody_ih elseExpr.eval
        simp [Body.fuel, Body.toFullYul, Body.ifThenBodyElseReturnFullYul,
          Body.eval, Body.ifThenBodyElseReturnEval, Body.finalSymYulConfig,
          Body.returnConfig, Body.returnEnv, hCond,
          SolidCoreYulCore.SymYul.evalStmtFuel,
          SolidCoreYulCore.SymYul.evalExpr,
          SolidCoreYulCore.SymYul.evalExprs,
          SolidCoreYulCore.SymYul.branchOn,
          SolidCoreYulCore.SymYul.knownZero?,
          SolidCoreYulCore.SymYul.bindNormal,
          SolidCoreYulCore.SymYul.normalResult,
          SolidCoreYulCore.SymYul.resultAfterExpr,
          SolidCoreYulCore.FullYul.assign?,
          Expr.toFullYul_correct_env, hThen]
        simpa [Body.returnConfig, Body.returnEnv, Body.finalSymYulConfig]
          using hThen
  | ifThenReturnElseBody cond thenExpr elseBody elseBody_ih =>
      cases hFuel : elseBody.fuel with
      | zero =>
          cases elseBody <;> simp [Body.fuel] at hFuel
      | succ fuel =>
          have hElse :
              SolidCoreYulCore.SymYul.evalStmtFuel (fuel + 1)
                  (Body.returnConfig startValue) elseBody.toFullYul =
                [SolidCoreYulCore.SymYul.normalResult
                  elseBody.finalSymYulConfig] := by
            simpa [hFuel] using elseBody_ih startValue
          have hElseExpanded :
              SolidCoreYulCore.SymYul.evalStmtFuel (fuel + 1)
                  { SolidCoreYulCore.SymYul.Config.empty with
                    env := [(returnName,
                      SolidCoreYulCore.FullYul.Value.word startValue)] }
                  elseBody.toFullYul =
                [SolidCoreYulCore.SymYul.normalResult
                  { SolidCoreYulCore.SymYul.Config.empty with
                    env := [(returnName,
                      SolidCoreYulCore.FullYul.Value.word elseBody.eval)] }] := by
            simpa [Body.returnConfig, Body.returnEnv, Body.finalSymYulConfig]
              using hElse
          by_cases hCond : SolidCoreYulCore.norm cond.eval = 0
          · simp [Body.fuel, Body.toFullYul,
              Body.ifThenReturnElseBodyFullYul, Body.eval,
              Body.ifThenReturnElseBodyEval, Body.finalSymYulConfig,
              Body.returnConfig, Body.returnEnv, hCond, hFuel,
