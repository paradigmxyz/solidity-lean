def compileCheckedToTypedStmt? (source : String) :
    Option Solidity.Checked.TypedStmt :=
  (parseChecked source).map (fun program => program.toTypedStmt)

def compileCheckedTypedStmtToFullYul
    (stmt : Solidity.Checked.TypedStmt) :
    SolidCoreYulCore.FullYul.Stmt :=
  stmt.toFullYul

def compileCheckedToFullYulViaTypedStmt (source : String) :
    Option SolidCoreYulCore.FullYul.Stmt :=
  (compileCheckedToTypedStmt? source).map compileCheckedTypedStmtToFullYul

def compileCheckedToFullYul (source : String) :
    Option SolidCoreYulCore.FullYul.Stmt :=
  compileCheckedToFullYulViaTypedStmt source

theorem compileCheckedToFullYul_eq_viaTypedStmt (source : String) :
    compileCheckedToFullYul source =
      compileCheckedToFullYulViaTypedStmt source := by
  rfl

theorem compileCheckedToTypedStmt?_sound
    {source : String} {stmt : Solidity.Checked.TypedStmt}
    (hCompile : compileCheckedToTypedStmt? source = some stmt) :
    ∃ program,
      parseChecked source = some program ∧
      stmt = program.toTypedStmt ∧
      compileCheckedToFullYul source = some stmt.toFullYul ∧
      SolidCoreYulCore.SymYul.evalStmtFuel stmt.fuel
          (Solidity.Core.State.toConfig { returnValue := 0 }) stmt.toFullYul =
        stmt.eval.toSymYulResults := by
  unfold compileCheckedToTypedStmt? at hCompile
  cases hParse : parseChecked source with
  | none =>
      simp [hParse] at hCompile
  | some program =>
      simp [hParse] at hCompile
      cases hCompile
      refine ⟨program, rfl, rfl, ?_, Solidity.Checked.TypedStmt.toFullYul_correct _⟩
      simp [compileCheckedToFullYul, compileCheckedToFullYulViaTypedStmt,
        compileCheckedToTypedStmt?, compileCheckedTypedStmtToFullYul,
        hParse]

theorem compileCheckedToTypedStmt?_sound_static
    {source : String} {stmt : Solidity.Checked.TypedStmt}
    (hCompile : compileCheckedToTypedStmt? source = some stmt) :
    ∃ program,
      parseChecked source = some program ∧
      stmt = program.toTypedStmt ∧
      compileCheckedToFullYul source = some stmt.toFullYul ∧
      compileCheckedToFullYulViaTypedStmt source = some stmt.toFullYul ∧
      SolidCoreYulCore.SymYul.evalStmtFuel stmt.fuel
          (Solidity.Core.State.toConfig { returnValue := 0 }) stmt.toFullYul =
        stmt.eval.toSymYulResults ∧
      SolidCoreYulCore.FullYul.checkStmtFuel stmt.fuel.succ
          Solidity.Program.initialStaticContext false true stmt.toFullYul =
        some Solidity.Program.initialStaticContext ∧
      SolidCoreYulCore.FullYul.CompilerEmittableStmt
        SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
        stmt.toFullYul := by
  rcases compileCheckedToTypedStmt?_sound hCompile with
    ⟨program, hParse, hStmt, hDirect, hEval⟩
  exact ⟨program, hParse, hStmt, hDirect,
    by simp [compileCheckedToFullYulViaTypedStmt, hCompile,
      compileCheckedTypedStmtToFullYul],
    hEval,
    Solidity.Checked.TypedStmt.toFullYul_staticChecked stmt,
    Solidity.Checked.TypedStmt.toFullYul_compilerEmittable stmt⟩

theorem compileCheckedToTypedStmt?_accepted_currentSolidCore
    {source : String} {stmt : Solidity.Checked.TypedStmt}
    (hCompile : compileCheckedToTypedStmt? source = some stmt) :
    SolidCoreYulCore.FullYul.CompilerAcceptedStmt
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      stmt.fuel.succ Solidity.Program.initialStaticContext false true
      stmt.toFullYul Solidity.Program.initialStaticContext := by
  rcases compileCheckedToTypedStmt?_sound_static hCompile with
    ⟨_, _, _, _, _, _, hStatic, hEmittable⟩
  exact
    { emittable := hEmittable
      checked := hStatic }

theorem compileCheckedToFullYul_accepted_currentSolidCore
    {source : String} {stmt : SolidCoreYulCore.FullYul.Stmt}
    (hCompile : compileCheckedToFullYul source = some stmt) :
    ∃ program typedStmt,
      parseChecked source = some program ∧
      typedStmt = program.toTypedStmt ∧
      compileCheckedToTypedStmt? source = some typedStmt ∧
      stmt = typedStmt.toFullYul ∧
      SolidCoreYulCore.FullYul.CompilerAcceptedStmt
        SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
        typedStmt.fuel.succ Solidity.Program.initialStaticContext
        false true stmt Solidity.Program.initialStaticContext := by
  unfold compileCheckedToFullYul at hCompile
  unfold compileCheckedToFullYulViaTypedStmt at hCompile
  unfold compileCheckedToTypedStmt? at hCompile
  cases hParse : parseChecked source with
  | none =>
      simp [hParse] at hCompile
  | some program =>
      simp [hParse, compileCheckedTypedStmtToFullYul] at hCompile
      cases hCompile
      have hTyped :
          compileCheckedToTypedStmt? source =
            some program.toTypedStmt := by
        simp [compileCheckedToTypedStmt?, hParse]
      exact ⟨program, program.toTypedStmt, rfl, rfl, hTyped, rfl,
        compileCheckedToTypedStmt?_accepted_currentSolidCore hTyped⟩

structure ArtifactView (Input Output Artifact : Type) where
  build : Input -> Option Artifact
  compile : Input -> Option Output
  output : Artifact -> Output
  map_output : ∀ input, (build input).map output = compile input

namespace ArtifactView

theorem isSome
    {Input Output Artifact : Type}
    (view : ArtifactView Input Output Artifact) (input : Input) :
    (view.build input).isSome = (view.compile input).isSome := by
  rw [← view.map_output input]
  cases view.build input <;> rfl

theorem none_iff
    {Input Output Artifact : Type}
    (view : ArtifactView Input Output Artifact) (input : Input) :
    view.build input = none ↔ view.compile input = none := by
  constructor
  · intro hArtifact
    have hMap := view.map_output input
    simpa [hArtifact] using hMap.symm
  · intro hCompile
    cases hArtifact : view.build input with
    | none => rfl
    | some artifact =>
        have hMap := view.map_output input
        rw [hArtifact, hCompile] at hMap
        cases hMap

theorem some_output_iff
    {Input Output Artifact : Type}
    (view : ArtifactView Input Output Artifact)
    {input : Input} {output : Output} :
    (∃ artifact,
      view.build input = some artifact ∧
      view.output artifact = output) ↔
      view.compile input = some output := by
  constructor
  · intro hArtifact
    rcases hArtifact with ⟨artifact, hArtifact, hOutput⟩
    have hMap := view.map_output input
    rw [hArtifact] at hMap
    simpa [hOutput] using hMap.symm
  · intro hCompile
    cases hArtifact : view.build input with
    | some artifact =>
        have hMap := view.map_output input
        rw [hArtifact, hCompile] at hMap
        cases hMap
        exact ⟨artifact, rfl, rfl⟩
    | none =>
        have hMap := view.map_output input
        rw [hArtifact, hCompile] at hMap
        cases hMap

end ArtifactView

