    (SolidCoreYulCore.FullYul.CompilerEmittableExprs.cons hFirst
      (SolidCoreYulCore.FullYul.CompilerEmittableExprs.cons hSecond
        (SolidCoreYulCore.FullYul.CompilerEmittableExprs.cons hThird
          SolidCoreYulCore.FullYul.CompilerEmittableExprs.nil)))

private theorem currentSolidCore_exprs2_compilerEmittable
    {lhs rhs : SolidCoreYulCore.FullYul.Expr}
    (hLhs :
      SolidCoreYulCore.FullYul.CompilerEmittableExpr
        SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore lhs)
    (hRhs :
      SolidCoreYulCore.FullYul.CompilerEmittableExpr
        SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore rhs) :
    SolidCoreYulCore.FullYul.CompilerEmittableExprs
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      [lhs, rhs] := by
  exact SolidCoreYulCore.FullYul.CompilerEmittableExprs.cons hLhs
    (SolidCoreYulCore.FullYul.CompilerEmittableExprs.cons hRhs
      SolidCoreYulCore.FullYul.CompilerEmittableExprs.nil)

theorem Expr.toFullYul_compilerEmittable (expr : Expr) :
    SolidCoreYulCore.FullYul.CompilerEmittableExpr
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      expr.toFullYul := by
  induction expr with
  | lit value =>
      exact currentSolidCore_value_word_compilerEmittable
        (SolidCoreYulCore.norm value)
  | neg expr expr_ih =>
      simpa [Expr.toFullYul] using
        currentSolidCore_builtin2_compilerEmittable
          SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.sub
          (currentSolidCore_value_word_compilerEmittable 0) expr_ih
  | add lhs rhs lhs_ih rhs_ih =>
      exact currentSolidCore_builtin2_compilerEmittable
        SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.add
        lhs_ih rhs_ih
  | sub lhs rhs lhs_ih rhs_ih =>
      exact currentSolidCore_builtin2_compilerEmittable
        SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.sub
        lhs_ih rhs_ih
  | mul lhs rhs lhs_ih rhs_ih =>
      exact currentSolidCore_builtin2_compilerEmittable
        SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.mul
        lhs_ih rhs_ih
  | exp lhs rhs lhs_ih rhs_ih =>
      exact currentSolidCore_builtin2_compilerEmittable
        SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.expOp
        lhs_ih rhs_ih
  | div lhs rhs lhs_ih rhs_ih =>
      exact currentSolidCore_builtin2_compilerEmittable
        SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.divOp
        lhs_ih rhs_ih
  | mod lhs rhs lhs_ih rhs_ih =>
      exact currentSolidCore_builtin2_compilerEmittable
        SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.modOp
        lhs_ih rhs_ih
  | signedDiv lhs rhs lhs_ih rhs_ih =>
      exact currentSolidCore_builtin2_compilerEmittable
        SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.sdivOp
        lhs_ih rhs_ih
  | signedMod lhs rhs lhs_ih rhs_ih =>
      exact currentSolidCore_builtin2_compilerEmittable
        SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.smodOp
        lhs_ih rhs_ih
  | addmod lhs rhs modulus lhs_ih rhs_ih modulus_ih =>
      exact currentSolidCore_builtin3_compilerEmittable
        SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.addmodOp
        lhs_ih rhs_ih modulus_ih
  | mulmod lhs rhs modulus lhs_ih rhs_ih modulus_ih =>
      exact currentSolidCore_builtin3_compilerEmittable
        SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.mulmodOp
        lhs_ih rhs_ih modulus_ih
  | bitAnd lhs rhs lhs_ih rhs_ih =>
      exact currentSolidCore_builtin2_compilerEmittable
        SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.andOp
        lhs_ih rhs_ih
  | bitOr lhs rhs lhs_ih rhs_ih =>
      exact currentSolidCore_builtin2_compilerEmittable
        SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.orOp
        lhs_ih rhs_ih
  | bitXor lhs rhs lhs_ih rhs_ih =>
      exact currentSolidCore_builtin2_compilerEmittable
        SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.xorOp
        lhs_ih rhs_ih
  | bitNot expr expr_ih =>
      exact currentSolidCore_builtin1_compilerEmittable
        SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.notOp
        expr_ih
  | shl value shift value_ih shift_ih =>
      simpa [Expr.toFullYul] using
        currentSolidCore_builtin2_compilerEmittable
          SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.shlOp
          shift_ih value_ih
  | shr value shift value_ih shift_ih =>
      simpa [Expr.toFullYul] using
        currentSolidCore_builtin2_compilerEmittable
          SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.shrOp
          shift_ih value_ih
  | sar value shift value_ih shift_ih =>
      simpa [Expr.toFullYul] using
        currentSolidCore_builtin2_compilerEmittable
          SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.sarOp
          shift_ih value_ih
  | byteAt index value index_ih value_ih =>
      exact currentSolidCore_builtin2_compilerEmittable
        SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.byteOp
        index_ih value_ih
  | iszero expr expr_ih =>
      exact currentSolidCore_builtin1_compilerEmittable
        SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.iszero
        expr_ih
  | boolAnd lhs rhs lhs_ih rhs_ih =>
      have hLhsZero :=
        currentSolidCore_builtin1_compilerEmittable
          SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.iszero
          lhs_ih
      have hRhsZero :=
        currentSolidCore_builtin1_compilerEmittable
          SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.iszero
          rhs_ih
      have hOr :=
        currentSolidCore_builtin2_compilerEmittable
          SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.orOp
          hLhsZero hRhsZero
      exact currentSolidCore_builtin1_compilerEmittable
        SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.iszero
        hOr
  | boolOr lhs rhs lhs_ih rhs_ih =>
      have hLhsZero :=
        currentSolidCore_builtin1_compilerEmittable
          SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.iszero
          lhs_ih
      have hRhsZero :=
        currentSolidCore_builtin1_compilerEmittable
          SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.iszero
          rhs_ih
      have hAnd :=
        currentSolidCore_builtin2_compilerEmittable
          SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.andOp
          hLhsZero hRhsZero
      exact currentSolidCore_builtin1_compilerEmittable
        SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.iszero
        hAnd
  | eq lhs rhs lhs_ih rhs_ih =>
      exact currentSolidCore_builtin2_compilerEmittable
        SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.eqOp
        lhs_ih rhs_ih
  | ne lhs rhs lhs_ih rhs_ih =>
      have hEq :=
        currentSolidCore_builtin2_compilerEmittable
          SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.eqOp
          lhs_ih rhs_ih
      exact currentSolidCore_builtin1_compilerEmittable
        SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.iszero
        hEq
  | lt lhs rhs lhs_ih rhs_ih =>
      exact currentSolidCore_builtin2_compilerEmittable
        SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.ltOp
        lhs_ih rhs_ih
  | gt lhs rhs lhs_ih rhs_ih =>
      exact currentSolidCore_builtin2_compilerEmittable
        SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.gtOp
        lhs_ih rhs_ih
  | le lhs rhs lhs_ih rhs_ih =>
      have hGt :=
        currentSolidCore_builtin2_compilerEmittable
          SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.gtOp
          lhs_ih rhs_ih
      exact currentSolidCore_builtin1_compilerEmittable
        SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.iszero
        hGt
  | ge lhs rhs lhs_ih rhs_ih =>
      have hLt :=
        currentSolidCore_builtin2_compilerEmittable
          SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.ltOp
          lhs_ih rhs_ih
      exact currentSolidCore_builtin1_compilerEmittable
        SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.iszero
        hLt
  | signedLt lhs rhs lhs_ih rhs_ih =>
      exact currentSolidCore_builtin2_compilerEmittable
        SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.sltOp
        lhs_ih rhs_ih
  | signedGt lhs rhs lhs_ih rhs_ih =>
      exact currentSolidCore_builtin2_compilerEmittable
        SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.sgtOp
        lhs_ih rhs_ih
  | signedLe lhs rhs lhs_ih rhs_ih =>
      have hGt :=
        currentSolidCore_builtin2_compilerEmittable
          SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.sgtOp
          lhs_ih rhs_ih
      exact currentSolidCore_builtin1_compilerEmittable
        SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.iszero
        hGt
  | signedGe lhs rhs lhs_ih rhs_ih =>
      have hLt :=
        currentSolidCore_builtin2_compilerEmittable
          SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.sltOp
          lhs_ih rhs_ih
      exact currentSolidCore_builtin1_compilerEmittable
        SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.iszero
        hLt

