theorem compileSolidityToFullYulStmtCertificate_pass_boundary_sound
    {source : String} {cert : SolidityToFullYulStmtCertificate}
    (_hCompile :
      compileSolidityToFullYulStmtCertificate source = some cert) :
    compileSolidityToFullYulStmt cert.source = some cert.stmt ∧
    compileAnyStaticStmtArtifact cert.source = some cert.artifact ∧
    cert.artifact.stmt = cert.stmt ∧
    AnyStaticFullYulStmtArtifact.PassBoundarySound cert.artifact := by
