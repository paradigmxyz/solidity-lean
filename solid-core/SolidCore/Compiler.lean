                    (returnLiteralSource assignedLhsLiteral) with
              | none =>
                  simp [hStrip, hInitLhs, hInitRhs, hAssignedLhs] at h
              | some assignedLhsExpr =>
                  cases hAssignedRhs :
                      parseGeneratedReturnExpr?
                        (returnLiteralSource assignedRhsLiteral) with
                  | none =>
                      simp [hStrip, hInitLhs, hInitRhs, hAssignedLhs,
                        hAssignedRhs] at h
                  | some assignedRhsExpr =>
                      simp [hStrip, hInitLhs, hInitRhs, hAssignedLhs,
                        hAssignedRhs] at h
                      cases h
                      exact ⟨initLhsExpr, initRhsExpr, assignedLhsExpr,
                        assignedRhsExpr, rfl⟩

