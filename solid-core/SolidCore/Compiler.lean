def TypedStmt.fuel : TypedStmt -> Nat
  | TypedStmt.checkedArithReturn op _ _ => op.fuel
  | TypedStmt.checkedArithAssignThenLeave op _ _ => op.assignThenLeaveFuel
  | TypedStmt.checkedArithAssignSeqThenLeave _ _ _ secondOp _ _ =>
      secondOp.assignThenLeaveFuel + 1
  | TypedStmt.ifTrueCheckedArithReturn op _ _ => op.ifTrueFuel
  | TypedStmt.ifBoolCheckedArithReturn cond _ _ _ _ _ _ =>
      ArithOp.ifBoolThenElseFuel cond
  | TypedStmt.ifCheckedArithReturn cond _ _ _ _ _ _ =>
      ArithOp.ifExprThenElseFuel cond
  | TypedStmt.checkedAddReturn _ _ => 6
  | TypedStmt.checkedSubReturn _ _ => 6
  | TypedStmt.checkedMulReturn _ _ => 6
  | TypedStmt.checkedDivReturn _ _ => 6
  | TypedStmt.checkedModReturn _ _ => 6

