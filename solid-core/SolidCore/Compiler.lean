    {program : Program} {stmt : Core.BodyStmt}
    (h : program.toBodyCore? = some stmt) :
    (Core.AcceptedProgram.body stmt).fuel = program.stmtFuel := by
  cases program <;> simp [Program.toBodyCore?] at h
  · cases h
    simp [Core.AcceptedProgram.fuel, Core.BodyStmt.fuel,
      Core.BodyStmt.toBody, Core.BodyStmt.ofBody, Body.fuel,
      Program.stmtFuel]
  · have hToBody := Core.BodyStmt.ofBodyNoFun?_some_toBody h
    simp [Core.AcceptedProgram.fuel, Program.stmtFuel,
      Core.BodyStmt.fuel, hToBody]

theorem Program.toBodyCore?_some_noFun
    {program : Program} {stmt : Core.BodyStmt}
    (h : program.toBodyCore? = some stmt) :
    stmt.noFun = true := by
  cases program <;> simp [Program.toBodyCore?] at h
  · cases h
    simp [Core.BodyStmt.ofBody, Core.BodyStmt.noFun]
  · exact Core.BodyStmt.ofBodyNoFun?_some_noFun h

theorem Program.bodyAccepted_toFullYul_correct_with_coreFuel_of_some
    {program : Program} {stmt : Core.BodyStmt}
    (h : program.toBodyCore? = some stmt) :
    SolidCoreYulCore.SymYul.evalStmtFuel
        (Core.AcceptedProgram.body stmt).fuel
        Body.initialSymYulConfig
        (Core.AcceptedProgram.body stmt).toFullYul =
      [SolidCoreYulCore.SymYul.normalResult program.finalSymYulConfig] := by
  cases program <;> simp [Program.toBodyCore?] at h
  · cases h
    simpa [Core.AcceptedProgram.fuel, Core.AcceptedProgram.toFullYul,
      Core.BodyStmt.eval, Core.BodyStmt.toBody, Core.BodyStmt.ofBody,
      Program.finalSymYulConfig, Program.eval] using
        Core.AcceptedProgram.body_toFullYul_correct
          (Core.BodyStmt.ofBody (Body.returnExpr _))
  · have hToBody := Core.BodyStmt.ofBodyNoFun?_some_toBody h
    simpa [Core.AcceptedProgram.fuel, Core.AcceptedProgram.toFullYul,
      Core.BodyStmt.eval, Program.finalSymYulConfig, Program.eval,
      hToBody] using
        Core.AcceptedProgram.body_toFullYul_correct stmt

theorem Program.toFullYulStmt_correct_via_bodyCore_of_some
    {program : Program} {stmt : Core.BodyStmt}
    (h : program.toBodyCore? = some stmt) :
    SolidCoreYulCore.SymYul.evalStmtFuel
        program.stmtFuel
        Body.initialSymYulConfig
        program.toFullYulStmt =
      [SolidCoreYulCore.SymYul.normalResult program.finalSymYulConfig] := by
  rw [Program.toFullYulStmt_eq_bodyAccepted_of_some h]
  have hFuel := Program.bodyCore_fuel_eq_stmtFuel_of_some h
  rw [← hFuel]
  exact Program.bodyAccepted_toFullYul_correct_with_coreFuel_of_some h

theorem Program.functionBody_toCore?_some_cases
    {body : Body} {core : Core.AcceptedProgram}
    (h : (Program.functionBody body).toCore? = some core) :
    (body = Body.internalCallReturn ∧
      core =
        Core.AcceptedProgram.internalCall Core.InternalCall.Stmt.noArgReturn) ∨
      ∃ stmt,
        Core.BodyStmt.ofBodyNoFun? body = some stmt ∧
          core = Core.AcceptedProgram.body stmt := by
  cases body <;>
    simp [Program.toCore?, Core.BodyStmt.ofBodyNoFun?] at h
  all_goals
    first
    | rcases h with ⟨hNoFun, hCore⟩
      right
      exact ⟨_, Core.BodyStmt.ofBodyNoFun?_of_body_noFun hNoFun, hCore.symm⟩
    | cases h
      first
      | left
        simp
      | right
        exact ⟨_, Core.BodyStmt.ofBodyNoFun?_of_body_noFun (by rfl), rfl⟩

theorem Program.toCore?_body_some_toBodyCore?
    {program : Program} {stmt : Core.BodyStmt}
    (h : program.toCore? = some (Core.AcceptedProgram.body stmt)) :
    program.toBodyCore? = some stmt := by
  cases program <;> simp [Program.toCore?, Program.toBodyCore?] at h ⊢
  · simpa using h
  · rename_i body
    rcases Program.functionBody_toCore?_some_cases h with
      ⟨_hBody, hCore⟩ | ⟨_stmt, hStmt, hCore⟩
    · cases hCore
    · cases hCore
      exact hStmt

theorem Program.toCore?_body_some_noFun
    {program : Program} {stmt : Core.BodyStmt}
    (h : program.toCore? = some (Core.AcceptedProgram.body stmt)) :
    stmt.noFun = true := by
  exact Program.toBodyCore?_some_noFun
    (Program.toCore?_body_some_toBodyCore? h)

theorem Program.toCore?_typedStmt_impossible
    {program : Program} {stmt : Core.TypedStmt}
    (h : program.toCore? = some (Core.AcceptedProgram.typedStmt stmt)) :
    False := by
  cases program <;> simp [Program.toCore?] at h
  · rename_i body
    cases body <;> simp [Program.toCore?, Core.BodyStmt.ofBodyNoFun?] at h

theorem Program.toFullYulStmt_eq_bodyAccepted_of_core_some
    {program : Program} {stmt : Core.BodyStmt}
    (h : program.toCore? = some (Core.AcceptedProgram.body stmt)) :
    program.toFullYulStmt =
      (Core.AcceptedProgram.body stmt).toFullYul := by
  exact Program.toFullYulStmt_eq_bodyAccepted_of_some
    (Program.toCore?_body_some_toBodyCore? h)

theorem Program.bodyAccepted_toFullYul_correct_with_coreFuel_of_core_some
    {program : Program} {stmt : Core.BodyStmt}
    (h : program.toCore? = some (Core.AcceptedProgram.body stmt)) :
    SolidCoreYulCore.SymYul.evalStmtFuel
        (Core.AcceptedProgram.body stmt).fuel
        Body.initialSymYulConfig
        (Core.AcceptedProgram.body stmt).toFullYul =
      [SolidCoreYulCore.SymYul.normalResult program.finalSymYulConfig] := by
  exact Program.bodyAccepted_toFullYul_correct_with_coreFuel_of_some
    (Program.toCore?_body_some_toBodyCore? h)

theorem Program.toFullYulStmt_correct_via_bodyCore_of_core_some
    {program : Program} {stmt : Core.BodyStmt}
    (h : program.toCore? = some (Core.AcceptedProgram.body stmt)) :
    SolidCoreYulCore.SymYul.evalStmtFuel
        program.stmtFuel
        Body.initialSymYulConfig
        program.toFullYulStmt =
      [SolidCoreYulCore.SymYul.normalResult program.finalSymYulConfig] := by
  exact Program.toFullYulStmt_correct_via_bodyCore_of_some
    (Program.toCore?_body_some_toBodyCore? h)

theorem Program.functionBody_toFullYulStmt_eq_core_of_some
    {body : Body} {core : Core.AcceptedProgram}
    (h : (Program.functionBody body).toCore? = some core) :
    (Program.functionBody body).toFullYulStmt = core.toFullYul := by
  rcases Program.functionBody_toCore?_some_cases h with
    ⟨hBody, hCore⟩ | ⟨stmt, hStmt, hCore⟩
  · cases hBody
    cases hCore
    exact Program.toFullYulStmt_eq_internalCallAccepted_of_core_some
      (program := Program.functionBody Body.internalCallReturn)
      (stmt := Core.InternalCall.Stmt.noArgReturn) rfl
  · cases hCore
    exact Program.toFullYulStmt_eq_bodyAccepted_of_core_some
      (program := Program.functionBody body)
      (stmt := stmt) h

theorem Program.functionBody_bodyCore_fuel_eq_stmtFuel_of_some
    {body : Body} {stmt : Core.BodyStmt}
    (h : Core.BodyStmt.ofBodyNoFun? body = some stmt) :
    (Core.AcceptedProgram.body stmt).fuel =
      (Program.functionBody body).stmtFuel := by
  have hToBody := Core.BodyStmt.ofBodyNoFun?_some_toBody h
  simp [Core.AcceptedProgram.fuel, Program.stmtFuel,
    Core.BodyStmt.fuel, hToBody]

theorem Program.functionBody_bodyAccepted_toFullYul_correct_with_coreFuel_of_some
    {body : Body} {stmt : Core.BodyStmt}
    (h : Core.BodyStmt.ofBodyNoFun? body = some stmt) :
    SolidCoreYulCore.SymYul.evalStmtFuel
        (Core.AcceptedProgram.body stmt).fuel
        Body.initialSymYulConfig
        (Core.AcceptedProgram.body stmt).toFullYul =
      [SolidCoreYulCore.SymYul.normalResult
        (Program.functionBody body).finalSymYulConfig] := by
  have hToBody := Core.BodyStmt.ofBodyNoFun?_some_toBody h
  simpa [Core.AcceptedProgram.fuel, Core.AcceptedProgram.toFullYul,
    Core.BodyStmt.eval, Program.finalSymYulConfig, Program.eval,
    hToBody] using
      Core.AcceptedProgram.body_toFullYul_correct stmt

theorem Program.functionBody_core_fuel_eq_stmtFuel_of_some
    {body : Body} {core : Core.AcceptedProgram}
    (h : (Program.functionBody body).toCore? = some core) :
    core.fuel = (Program.functionBody body).stmtFuel := by
  rcases Program.functionBody_toCore?_some_cases h with
    ⟨hBody, hCore⟩ | ⟨stmt, hStmt, hCore⟩
  · cases hBody
    cases hCore
    rfl
  · cases hCore
    exact Program.functionBody_bodyCore_fuel_eq_stmtFuel_of_some hStmt

theorem Program.functionBody_core_toFullYul_correct_with_coreFuel_of_some
    {body : Body} {core : Core.AcceptedProgram}
    (h : (Program.functionBody body).toCore? = some core) :
    SolidCoreYulCore.SymYul.evalStmtFuel
        core.fuel
        Body.initialSymYulConfig
        core.toFullYul =
      [SolidCoreYulCore.SymYul.normalResult
        (Program.functionBody body).finalSymYulConfig] := by
  rcases Program.functionBody_toCore?_some_cases h with
    ⟨hBody, hCore⟩ | ⟨stmt, hStmt, hCore⟩
  · cases hBody
    cases hCore
    exact Program.internalCallAccepted_toFullYul_correct_with_coreFuel_of_core_some
      (program := Program.functionBody Body.internalCallReturn)
      (stmt := Core.InternalCall.Stmt.noArgReturn) rfl
  · cases hCore
    exact
      Program.bodyAccepted_toFullYul_correct_with_coreFuel_of_core_some
        (program := Program.functionBody body)
        (stmt := stmt) h

theorem Program.functionBody_toFullYulStmt_correct_via_core_of_some
    {body : Body} {core : Core.AcceptedProgram}
    (h : (Program.functionBody body).toCore? = some core) :
    SolidCoreYulCore.SymYul.evalStmtFuel
        (Program.functionBody body).stmtFuel
        Body.initialSymYulConfig
        (Program.functionBody body).toFullYulStmt =
      [SolidCoreYulCore.SymYul.normalResult
        (Program.functionBody body).finalSymYulConfig] := by
  rw [Program.functionBody_toFullYulStmt_eq_core_of_some h]
  have hFuel := Program.functionBody_core_fuel_eq_stmtFuel_of_some h
  rw [← hFuel]
  exact Program.functionBody_core_toFullYul_correct_with_coreFuel_of_some h

theorem Program.functionBody_staticChecked_of_core_some
    {body : Body} {core : Core.AcceptedProgram}
    (h : (Program.functionBody body).toCore? = some core) :
    SolidCoreYulCore.FullYul.checkStmtFuel
        (Program.functionBody body).stmtFuel.succ
        Program.initialStaticContext false false
        (Program.functionBody body).toFullYulStmt =
      some Program.initialStaticContext := by
  rcases Program.functionBody_toCore?_some_cases h with
    ⟨hBody, hCore⟩ | ⟨stmt, hStmt, hCore⟩
  · cases hBody
    cases hCore
    rfl
  · cases hCore
    exact Program.functionBody_bodyCore_staticChecked_of_some hStmt

theorem Program.toFullYulStmt_eq_core_of_some
    {program : Program} {core : Core.AcceptedProgram}
    (h : program.toCore? = some core) :
    program.toFullYulStmt = core.toFullYul := by
  cases core with
  | body stmt =>
      exact Program.toFullYulStmt_eq_bodyAccepted_of_core_some h
  | storage stmt =>
      exact Program.toFullYulStmt_eq_storageAccepted_of_core_some h
  | internalCall stmt =>
      exact Program.toFullYulStmt_eq_internalCallAccepted_of_core_some h
  | internalStorage stmt =>
      exact Program.toFullYulStmt_eq_internalStorageAccepted_of_core_some h
  | typedStmt stmt =>
      exact False.elim (Program.toCore?_typedStmt_impossible h)

theorem Program.toFullYulStmt_correct_via_core_of_some
    {program : Program} {core : Core.AcceptedProgram}
    (h : program.toCore? = some core) :
    SolidCoreYulCore.SymYul.evalStmtFuel
        program.stmtFuel
        Body.initialSymYulConfig
        program.toFullYulStmt =
      [SolidCoreYulCore.SymYul.normalResult program.finalSymYulConfig] := by
  cases core with
  | body stmt =>
      exact Program.toFullYulStmt_correct_via_bodyCore_of_core_some h
  | storage stmt =>
      exact Program.toFullYulStmt_correct_via_storageCore_of_core_some h
  | internalCall stmt =>
      exact Program.toFullYulStmt_correct_via_internalCallCore_of_core_some h
  | internalStorage stmt =>
      exact Program.toFullYulStmt_correct_via_internalStorageCore_of_core_some h
  | typedStmt stmt =>
      exact False.elim (Program.toCore?_typedStmt_impossible h)

theorem Program.toFullYulStmt_correct_of_toCore?_isSome
    (program : Program) (h : program.toCore?.isSome = true) :
    SolidCoreYulCore.SymYul.evalStmtFuel
        program.stmtFuel
        Body.initialSymYulConfig
        program.toFullYulStmt =
      [SolidCoreYulCore.SymYul.normalResult program.finalSymYulConfig] := by
  cases hCore : program.toCore? with
  | none =>
      simp [hCore] at h
  | some core =>
      exact Program.toFullYulStmt_correct_via_core_of_some hCore

theorem Program.core_toFullYul_correct_of_some
    {program : Program} {core : Core.AcceptedProgram}
    (h : program.toCore? = some core) :
    SolidCoreYulCore.SymYul.evalStmtFuel
        program.stmtFuel
        Body.initialSymYulConfig
        core.toFullYul =
      [SolidCoreYulCore.SymYul.normalResult program.finalSymYulConfig] := by
  rw [← Program.toFullYulStmt_eq_core_of_some h]
  exact Program.toFullYulStmt_correct_via_core_of_some h

theorem Program.core_toFullYul_correct_with_coreFuel_of_some
    {program : Program} {core : Core.AcceptedProgram}
    (h : program.toCore? = some core) :
    SolidCoreYulCore.SymYul.evalStmtFuel
        core.fuel
        Body.initialSymYulConfig
        core.toFullYul =
      [SolidCoreYulCore.SymYul.normalResult program.finalSymYulConfig] := by
  cases core with
  | body stmt =>
      exact Program.bodyAccepted_toFullYul_correct_with_coreFuel_of_core_some h
  | storage stmt =>
      exact Program.storageAccepted_toFullYul_correct_with_coreFuel_of_core_some h
  | internalCall stmt =>
      exact
        Program.internalCallAccepted_toFullYul_correct_with_coreFuel_of_core_some
          h
  | internalStorage stmt =>
      exact
        Program.internalStorageAccepted_toFullYul_correct_with_coreFuel_of_core_some
          h
  | typedStmt stmt =>
      exact False.elim (Program.toCore?_typedStmt_impossible h)

namespace Checked

inductive Result where
  | returned : Core.State -> Result
  | reverted : Core.State -> Result
  deriving DecidableEq, Repr

def checkedAddOverflowFlag
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) : Word :=
  SolidCoreYulCore.ltWord
    (SolidCoreYulCore.addWord lhs.eval rhs.eval)
    lhs.eval

def checkedAddResultValue
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) : Word :=
  SolidCoreYulCore.addWord lhs.eval rhs.eval

def checkedAddReturnEval (state : Core.State)
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) : Result :=
  let state' := { state with returnValue := checkedAddResultValue lhs rhs }
  if SolidCoreYulCore.norm (checkedAddOverflowFlag lhs rhs) = 0 then
    Result.returned state'
  else
    Result.reverted state'

def checkedSubUnderflowFlag
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) : Word :=
  SolidCoreYulCore.gtWord rhs.eval lhs.eval

def checkedSubResultValue
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) : Word :=
  SolidCoreYulCore.subWord lhs.eval rhs.eval

def checkedSubReturnEval (state : Core.State)
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) : Result :=
  let state' := { state with returnValue := checkedSubResultValue lhs rhs }
  if SolidCoreYulCore.norm (checkedSubUnderflowFlag lhs rhs) = 0 then
    Result.returned state'
  else
    Result.reverted state'

def checkedMulResultValue
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) : Word :=
  SolidCoreYulCore.mulWord lhs.eval rhs.eval

def checkedMulOkFlag
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) : Word :=
  SolidCoreYulCore.orWord
    (SolidCoreYulCore.iszeroWord lhs.eval)
    (SolidCoreYulCore.eqWord
      (SolidCoreYulCore.divWord (checkedMulResultValue lhs rhs) lhs.eval)
      rhs.eval)

def checkedMulOverflowFlag
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) : Word :=
  SolidCoreYulCore.iszeroWord (checkedMulOkFlag lhs rhs)

def checkedMulReturnEval (state : Core.State)
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) : Result :=
  let state' := { state with returnValue := checkedMulResultValue lhs rhs }
  if SolidCoreYulCore.norm (checkedMulOverflowFlag lhs rhs) = 0 then
    Result.returned state'
  else
    Result.reverted state'

def checkedDivZeroFlag (rhs : Core.TypedExpr Core.Ty.uint256) : Word :=
  SolidCoreYulCore.iszeroWord rhs.eval

def checkedDivResultValue
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) : Word :=
  SolidCoreYulCore.divWord lhs.eval rhs.eval

def checkedDivReturnEval (state : Core.State)
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) : Result :=
  let state' := { state with returnValue := checkedDivResultValue lhs rhs }
  if SolidCoreYulCore.norm (checkedDivZeroFlag rhs) = 0 then
    Result.returned state'
  else
    Result.reverted state'

def checkedModZeroFlag (rhs : Core.TypedExpr Core.Ty.uint256) : Word :=
  SolidCoreYulCore.iszeroWord rhs.eval

def checkedModResultValue
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) : Word :=
  SolidCoreYulCore.modWord lhs.eval rhs.eval

def checkedModReturnEval (state : Core.State)
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) : Result :=
  let state' := { state with returnValue := checkedModResultValue lhs rhs }
  if SolidCoreYulCore.norm (checkedModZeroFlag rhs) = 0 then
    Result.returned state'
  else
    Result.reverted state'

def Result.revertConfig (state : Core.State) :
    SolidCoreYulCore.SymYul.Config :=
  { state.toConfig with
    evm :=
      (SolidCoreYulCore.FullYul.haltWith
        SolidCoreYulCore.Evm.HaltKind.reverted
        (SolidCoreYulCore.FullYul.SymbolicBytes.memorySnapshot 0 0 0)
        (SolidCoreYulCore.FullYul.expandMemory state.toConfig.evm 0 0)) }

def Result.toSymYulResults : Result -> List SolidCoreYulCore.SymYul.Result
  | Result.returned state =>
      [{ flow := SolidCoreYulCore.FullYul.Flow.left,
         config := state.toConfig }]
  | Result.reverted state =>
      [{ flow := SolidCoreYulCore.FullYul.Flow.halted,
         config := Result.revertConfig state }]

inductive StepResult where
  | normal : Core.State -> StepResult
  | reverted : Core.State -> StepResult
  deriving DecidableEq, Repr

def StepResult.toSymYulResults :
    StepResult -> List SolidCoreYulCore.SymYul.Result
  | StepResult.normal state =>
      [{ flow := SolidCoreYulCore.FullYul.Flow.normal,
         config := state.toConfig }]
  | StepResult.reverted state =>
      [{ flow := SolidCoreYulCore.FullYul.Flow.halted,
         config := Result.revertConfig state }]

def StepResult.toReturnResult : StepResult -> Result
  | StepResult.normal state => Result.returned state
  | StepResult.reverted state => Result.reverted state

def StepResult.bind (step : StepResult)
    (next : Core.State -> StepResult) : StepResult :=
  match step with
  | StepResult.normal state => next state
  | StepResult.reverted state => StepResult.reverted state

def StepResult.bindReturn (step : StepResult)
    (next : Core.State -> Result) : Result :=
  match step with
  | StepResult.normal state => next state
  | StepResult.reverted state => Result.reverted state

theorem StepResult.bind_toReturnResult (step : StepResult)
    (next : Core.State -> StepResult) :
    (step.bind next).toReturnResult =
      step.bindReturn (fun state => (next state).toReturnResult) := by
  cases step <;> rfl

theorem StepResult.bindNormal_toSymYulResults (step : StepResult)
    (nextSym : SolidCoreYulCore.SymYul.Config ->
      List SolidCoreYulCore.SymYul.Result)
    (next : Core.State -> StepResult)
    (hNext : ∀ state, nextSym state.toConfig =
      (next state).toSymYulResults) :
    SolidCoreYulCore.SymYul.bindNormal step.toSymYulResults nextSym =
      (step.bind next).toSymYulResults := by
  cases step with
  | normal state =>
      simpa [StepResult.toSymYulResults, StepResult.bind,
        SolidCoreYulCore.SymYul.bindNormal] using hNext state
  | reverted state =>
      rfl

theorem StepResult.bindNormal_toReturnSymYulResults (step : StepResult)
    (nextSym : SolidCoreYulCore.SymYul.Config ->
      List SolidCoreYulCore.SymYul.Result)
    (next : Core.State -> Result)
    (hNext : ∀ state, nextSym state.toConfig =
      (next state).toSymYulResults) :
    SolidCoreYulCore.SymYul.bindNormal step.toSymYulResults nextSym =
      (step.bindReturn next).toSymYulResults := by
  cases step with
  | normal state =>
      simpa [StepResult.toSymYulResults, StepResult.bindReturn,
        SolidCoreYulCore.SymYul.bindNormal] using hNext state
  | reverted state =>
      rfl

theorem StepResult.bindLeave_toSymYulResults (step : StepResult) :
    SolidCoreYulCore.SymYul.bindNormal step.toSymYulResults
        (fun config =>
          SolidCoreYulCore.SymYul.evalStmtFuel 5 config
            SolidCoreYulCore.FullYul.Stmt.leave) =
      step.toReturnResult.toSymYulResults := by
  cases step <;> rfl

def checkedAddAssignEval (state : Core.State)
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) : StepResult :=
  let state' := { state with returnValue := checkedAddResultValue lhs rhs }
  if SolidCoreYulCore.norm (checkedAddOverflowFlag lhs rhs) = 0 then
    StepResult.normal state'
  else
    StepResult.reverted state'

def checkedSubAssignEval (state : Core.State)
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) : StepResult :=
  let state' := { state with returnValue := checkedSubResultValue lhs rhs }
  if SolidCoreYulCore.norm (checkedSubUnderflowFlag lhs rhs) = 0 then
    StepResult.normal state'
  else
    StepResult.reverted state'

def checkedMulAssignEval (state : Core.State)
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) : StepResult :=
  let state' := { state with returnValue := checkedMulResultValue lhs rhs }
  if SolidCoreYulCore.norm (checkedMulOverflowFlag lhs rhs) = 0 then
    StepResult.normal state'
  else
    StepResult.reverted state'

def checkedDivAssignEval (state : Core.State)
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) : StepResult :=
  let state' := { state with returnValue := checkedDivResultValue lhs rhs }
  if SolidCoreYulCore.norm (checkedDivZeroFlag rhs) = 0 then
    StepResult.normal state'
  else
    StepResult.reverted state

def checkedModAssignEval (state : Core.State)
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) : StepResult :=
  let state' := { state with returnValue := checkedModResultValue lhs rhs }
  if SolidCoreYulCore.norm (checkedModZeroFlag rhs) = 0 then
    StepResult.normal state'
  else
    StepResult.reverted state

def revertZero : SolidCoreYulCore.FullYul.Stmt :=
  SolidCoreYulCore.FullYul.Stmt.expr
    (SolidCoreYulCore.FullYul.Expr.builtin
      SolidCoreYulCore.Evm.Builtin.revertOp
      [ SolidCoreYulCore.FullYul.Expr.value
          (SolidCoreYulCore.FullYul.Value.word 0)
      , SolidCoreYulCore.FullYul.Expr.value
          (SolidCoreYulCore.FullYul.Value.word 0) ])

def checkedAddAssignFullYul
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) :
    SolidCoreYulCore.FullYul.Stmt :=
  SolidCoreYulCore.FullYul.Stmt.seq
    (SolidCoreYulCore.FullYul.Stmt.assign returnName
      (SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.add
