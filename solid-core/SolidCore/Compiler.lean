theorem compileSolidityToFullYulStmt_some_iff_verifiedForSource_certificate
    {source : String} {stmt : SolidCoreYulCore.FullYul.Stmt} :
    compileSolidityToFullYulStmt source = some stmt ↔
      ∃ cert,
        compileSolidityToFullYulStmtCertificate source = some cert ∧
        cert.stmt = stmt ∧
        SolidityToFullYulStmtCertificate.VerifiedForSource source cert := by
  constructor
  · intro hCompile
    exact compileSolidityToFullYulStmt_verifiedForSource_certificate hCompile
  · intro hCert
    rcases hCert with ⟨cert, _hCert, hStmt, hVerifiedForSource⟩
    rcases hVerifiedForSource with
      ⟨_hSource, _hArtifactSource, hCompiled, _hVerified⟩
    simpa [hStmt] using hCompiled

