theorem compileSolidityToFullYulStmt_verified_certificate
    {source : String} {stmt : SolidCoreYulCore.FullYul.Stmt}
    (hCompile : compileSolidityToFullYulStmt source = some stmt) :
    ∃ cert,
      compileSolidityToFullYulStmtCertificate source = some cert ∧
      cert.source = source ∧
      cert.stmt = stmt ∧
      SolidityToFullYulStmtCertificate.Verified cert := by
  cases hCert : compileSolidityToFullYulStmtCertificate source with
  | some cert =>
      have hSource :=
        compileSolidityToFullYulStmtCertificate_source hCert
      have hStmt : cert.stmt = stmt := by
        have hCompiled :
            compileSolidityToFullYulStmt source = some cert.stmt := by
          simpa [hSource] using cert.compiled
        rw [hCompile] at hCompiled
        cases hCompiled
        rfl
      exact ⟨cert, rfl, hSource, hStmt, cert.verified⟩
  | none =>
      rcases compileSolidityToFullYulStmt_artifact hCompile with
        ⟨_artifact, hArtifact, _hStmt⟩
      unfold compileSolidityToFullYulStmtCertificate at hCert
      split at hCert
      · cases hCert
      · simp_all

