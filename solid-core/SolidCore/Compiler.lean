theorem InternalCallFrame.toFullYul_compilerEmittable
    (frame : InternalCallFrame) :
    SolidCoreYulCore.FullYul.CompilerEmittableStmt
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      frame.toFullYul := by
  cases frame with
  | noArgReturn =>
      simpa [InternalCallFrame.toFullYul, Body.toFullYul] using
        Body.toFullYul_compilerEmittable Body.internalCallReturn
  | argReturn =>
      have hFunBody :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.assign
          (name := secondLocalName)
          (currentSolidCore_var_compilerEmittable localName)
      have hFun :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.funDef
          (name := internalFunctionName) (params := [localName])
          (returns := [secondLocalName])
          (body := SolidCoreYulCore.FullYul.Stmt.assign secondLocalName
            (SolidCoreYulCore.FullYul.Expr.var localName))
          trivial hFunBody
      have hArgs :
          SolidCoreYulCore.FullYul.CompilerEmittableExprs
            SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
            [SolidCoreYulCore.FullYul.Expr.value
              (SolidCoreYulCore.FullYul.Value.word 11)] :=
        SolidCoreYulCore.FullYul.CompilerEmittableExprs.cons
          (currentSolidCore_value_word_compilerEmittable 11)
          SolidCoreYulCore.FullYul.CompilerEmittableExprs.nil
      have hCall :
          SolidCoreYulCore.FullYul.CompilerEmittableStmt
            SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
            (SolidCoreYulCore.FullYul.Stmt.assignCall [returnName]
              internalFunctionName
              [SolidCoreYulCore.FullYul.Expr.value
                (SolidCoreYulCore.FullYul.Value.word 11)]) :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.assignCall
          (names := [returnName]) (fnName := internalFunctionName)
          (args := [SolidCoreYulCore.FullYul.Expr.value
            (SolidCoreYulCore.FullYul.Value.word 11)])
          trivial hArgs
      simpa [InternalCallFrame.toFullYul,
        Program.internalCallArgReturnFullYul] using
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.block
          (SolidCoreYulCore.FullYul.CompilerEmittableBlock.cons hFun
            (SolidCoreYulCore.FullYul.CompilerEmittableBlock.cons hCall
              SolidCoreYulCore.FullYul.CompilerEmittableBlock.nil))
  | multiReturn =>
      have hReturns :=
        currentSolidCore_exprs2_compilerEmittable
          (currentSolidCore_value_word_compilerEmittable 5)
          (currentSolidCore_value_word_compilerEmittable 7)
      have hFunBody :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.assignMany
          (names := [localName, secondLocalName]) hReturns
      have hFun :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.funDef
          (name := internalFunctionName) (params := [])
          (returns := [localName, secondLocalName])
          (body := SolidCoreYulCore.FullYul.Stmt.assignMany
            [localName, secondLocalName]
            [ SolidCoreYulCore.FullYul.Expr.value
                (SolidCoreYulCore.FullYul.Value.word 5)
            , SolidCoreYulCore.FullYul.Expr.value
                (SolidCoreYulCore.FullYul.Value.word 7) ])
          trivial hFunBody
      have hLet :
          SolidCoreYulCore.FullYul.CompilerEmittableStmt
            SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
            (SolidCoreYulCore.FullYul.Stmt.letMany
              [localName, secondLocalName] none) :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.letManyNone
          (names := [localName, secondLocalName])
      have hCall :
          SolidCoreYulCore.FullYul.CompilerEmittableStmt
            SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
            (SolidCoreYulCore.FullYul.Stmt.assignCall
              [localName, secondLocalName] internalFunctionName []) :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.assignCall
          (names := [localName, secondLocalName])
          (fnName := internalFunctionName) (args := [])
          trivial
          SolidCoreYulCore.FullYul.CompilerEmittableExprs.nil
      have hAdd :=
        currentSolidCore_builtin2_compilerEmittable
          SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.add
          (currentSolidCore_var_compilerEmittable localName)
          (currentSolidCore_var_compilerEmittable secondLocalName)
      have hAssign :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.assign
          (name := returnName) hAdd
      simpa [InternalCallFrame.toFullYul,
        Program.internalCallMultiReturnFullYul] using
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.block
          (SolidCoreYulCore.FullYul.CompilerEmittableBlock.cons hFun
            (SolidCoreYulCore.FullYul.CompilerEmittableBlock.cons hLet
              (SolidCoreYulCore.FullYul.CompilerEmittableBlock.cons hCall
                (SolidCoreYulCore.FullYul.CompilerEmittableBlock.cons
                  hAssign
                  SolidCoreYulCore.FullYul.CompilerEmittableBlock.nil))))

