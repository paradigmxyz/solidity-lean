theorem LocalFrame2.toFullYul_compilerEmittable (frame : LocalFrame2) :
    SolidCoreYulCore.FullYul.CompilerEmittableStmt
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      frame.toFullYul := by
  cases frame with
  | addReturn lhs rhs =>
      have hLhs := PureExpr.toFullYul_compilerEmittable lhs
      have hRhs := PureExpr.toFullYul_compilerEmittable rhs
      have hLet :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.letManySome
          (names := [localName, secondLocalName])
          (currentSolidCore_exprs2_compilerEmittable hLhs hRhs)
      have hAdd :=
        currentSolidCore_builtin2_compilerEmittable
          SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.add
          (currentSolidCore_var_compilerEmittable localName)
          (currentSolidCore_var_compilerEmittable secondLocalName)
      have hAssign :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.assign
          (name := returnName) hAdd
      simpa [LocalFrame2.toFullYul] using
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.block
          (SolidCoreYulCore.FullYul.CompilerEmittableBlock.cons
            (SolidCoreYulCore.FullYul.CompilerEmittableStmt.seq hLet
              (SolidCoreYulCore.FullYul.CompilerEmittableStmt.seq hAssign
                SolidCoreYulCore.FullYul.CompilerEmittableStmt.leave))
            SolidCoreYulCore.FullYul.CompilerEmittableBlock.nil)
  | assignAddReturn initLhs initRhs assignedLhs assignedRhs =>
      have hInitLhs := PureExpr.toFullYul_compilerEmittable initLhs
      have hInitRhs := PureExpr.toFullYul_compilerEmittable initRhs
      have hAssignedLhs := PureExpr.toFullYul_compilerEmittable assignedLhs
      have hAssignedRhs := PureExpr.toFullYul_compilerEmittable assignedRhs
      have hLet :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.letManySome
          (names := [localName, secondLocalName])
          (currentSolidCore_exprs2_compilerEmittable hInitLhs hInitRhs)
      have hAssignMany :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.assignMany
          (names := [localName, secondLocalName])
          (currentSolidCore_exprs2_compilerEmittable
            hAssignedLhs hAssignedRhs)
      have hAdd :=
        currentSolidCore_builtin2_compilerEmittable
          SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.add
          (currentSolidCore_var_compilerEmittable localName)
          (currentSolidCore_var_compilerEmittable secondLocalName)
      have hUpdateValue :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.assign
          (name := returnName) hAdd
      simpa [LocalFrame2.toFullYul] using
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.block
          (SolidCoreYulCore.FullYul.CompilerEmittableBlock.cons
            (SolidCoreYulCore.FullYul.CompilerEmittableStmt.seq hLet
              (SolidCoreYulCore.FullYul.CompilerEmittableStmt.seq hAssignMany
                (SolidCoreYulCore.FullYul.CompilerEmittableStmt.seq
                  hUpdateValue
                  SolidCoreYulCore.FullYul.CompilerEmittableStmt.leave)))
            SolidCoreYulCore.FullYul.CompilerEmittableBlock.nil)

def Stmt.eval (state : State) : Stmt -> Result
  | Stmt.skip => Result.normal state
  | Stmt.expr _ => Result.normal state
  | Stmt.returnExpr e =>
      Result.returned { state with returnValue := e.eval }
  | Stmt.localValue e =>
      Result.returned { state with returnValue := e.eval }
  | Stmt.localUpdateValue _ assigned =>
      Result.returned { state with returnValue := assigned.eval }
  | Stmt.localPairAddValue lhs rhs =>
      Result.returned
        { state with returnValue := SolidCoreYulCore.addWord lhs.eval rhs.eval }
  | Stmt.localPairUpdateAddValue _ _ assignedLhs assignedRhs =>
      Result.returned
        { state with
          returnValue := SolidCoreYulCore.addWord assignedLhs.eval assignedRhs.eval }
  | Stmt.forNeverReturn afterExpr _ =>
      Result.returned { state with returnValue := afterExpr.eval }
  | Stmt.forBreakReturn afterExpr =>
      Result.returned { state with returnValue := afterExpr.eval }
  | Stmt.forContinueReturn afterExpr =>
      Result.returned { state with returnValue := afterExpr.eval }
  | Stmt.ifReturn cond thenExpr elseExpr =>
      if SolidCoreYulCore.norm cond.eval = 0 then
        Result.returned { state with returnValue := elseExpr.eval }
      else
        Result.returned { state with returnValue := thenExpr.eval }
  | Stmt.ifThenStmtElseReturn cond thenBody elseExpr =>
      if SolidCoreYulCore.norm cond.eval = 0 then
        Result.returned { state with returnValue := elseExpr.eval }
      else
        match thenBody.eval state with
        | Result.normal state' =>
            Result.returned { state' with returnValue := elseExpr.eval }
        | Result.returned state' => Result.returned state'
  | Stmt.ifThenReturnElseStmt cond thenExpr elseBody =>
      if SolidCoreYulCore.norm cond.eval = 0 then
        elseBody.eval state
      else
        Result.returned { state with returnValue := thenExpr.eval }
  | Stmt.seq first second =>
      match first.eval state with
      | Result.normal state' => second.eval state'
      | Result.returned state' => Result.returned state'
  | Stmt.block body => body.eval state
  | Stmt.ifThen cond body =>
      if SolidCoreYulCore.norm cond.eval = 0 then
        Result.normal state
      else
        body.eval state
  | Stmt.ifElse cond thenBody elseBody =>
      if SolidCoreYulCore.norm cond.eval = 0 then
        elseBody.eval state
      else
        thenBody.eval state
  | Stmt.forFalse _ => Result.normal state
  | Stmt.forOnce body => body.eval state
  | Stmt.forIf cond body =>
      if SolidCoreYulCore.norm cond.eval = 0 then
        Result.normal state
      else
        body.eval state

def Stmt.toStructured : Stmt -> Structured.Stmt
  | Stmt.skip => Structured.Stmt.skip
  | Stmt.expr e => Structured.Stmt.expr e.toExpr
  | Stmt.returnExpr e => Structured.Stmt.returnExpr e.toExpr
  | Stmt.localValue e => Structured.Stmt.returnExpr e.toExpr
  | Stmt.localUpdateValue _ assigned =>
      Structured.Stmt.returnExpr assigned.toExpr
  | Stmt.localPairAddValue lhs rhs =>
      Structured.Stmt.returnExpr (PureExpr.add lhs rhs).toExpr
  | Stmt.localPairUpdateAddValue _ _ assignedLhs assignedRhs =>
      Structured.Stmt.returnExpr (PureExpr.add assignedLhs assignedRhs).toExpr
  | Stmt.forNeverReturn afterExpr _ =>
      Structured.Stmt.returnExpr afterExpr.toExpr
  | Stmt.forBreakReturn afterExpr =>
      Structured.Stmt.returnExpr afterExpr.toExpr
  | Stmt.forContinueReturn afterExpr =>
      Structured.Stmt.returnExpr afterExpr.toExpr
  | Stmt.ifReturn cond thenExpr elseExpr =>
      Structured.Stmt.seq
        (Structured.Stmt.ifThen cond.toExpr
          (Structured.Stmt.returnExpr thenExpr.toExpr))
        (Structured.Stmt.returnExpr elseExpr.toExpr)
  | Stmt.ifThenStmtElseReturn cond thenBody elseExpr =>
      Structured.Stmt.seq
        (Structured.Stmt.ifThen cond.toExpr thenBody.toStructured)
        (Structured.Stmt.returnExpr elseExpr.toExpr)
  | Stmt.ifThenReturnElseStmt cond thenExpr elseBody =>
      Structured.Stmt.seq
        (Structured.Stmt.ifThen cond.toExpr
          (Structured.Stmt.returnExpr thenExpr.toExpr))
        elseBody.toStructured
  | Stmt.seq first second =>
      Structured.Stmt.seq first.toStructured second.toStructured
  | Stmt.block body => Structured.Stmt.block body.toStructured
  | Stmt.ifThen cond body =>
      Structured.Stmt.ifThen cond.toExpr body.toStructured
  | Stmt.ifElse cond thenBody elseBody =>
      Structured.Stmt.ifElse cond.toExpr thenBody.toStructured
        elseBody.toStructured
  | Stmt.forFalse body =>
      Structured.Stmt.forFalse body.toStructured
  | Stmt.forOnce body =>
      Structured.Stmt.forOnce body.toStructured
  | Stmt.forIf cond body =>
      Structured.Stmt.forIf cond.toExpr body.toStructured

def Stmt.fuel : Stmt -> Nat
  | Stmt.localValue _ => 6
  | Stmt.localUpdateValue _ _ => 7
  | Stmt.localPairAddValue _ _ => 6
  | Stmt.localPairUpdateAddValue _ _ _ _ => 7
  | Stmt.forNeverReturn _ _ => 6
  | Stmt.forBreakReturn _ => 6
  | Stmt.forContinueReturn _ => 8
  | Stmt.ifReturn cond thenExpr elseExpr =>
      (Structured.Stmt.seq
        (Structured.Stmt.ifThen cond.toExpr
          (Structured.Stmt.returnExpr thenExpr.toExpr))
        (Structured.Stmt.returnExpr elseExpr.toExpr)).fuel
  | Stmt.ifThenStmtElseReturn cond thenBody elseExpr =>
      (Structured.Stmt.seq
        (Structured.Stmt.ifThen cond.toExpr thenBody.toStructured)
        (Structured.Stmt.returnExpr elseExpr.toExpr)).fuel
  | Stmt.ifThenReturnElseStmt cond thenExpr elseBody =>
      (Structured.Stmt.seq
        (Structured.Stmt.ifThen cond.toExpr
          (Structured.Stmt.returnExpr thenExpr.toExpr))
        elseBody.toStructured).fuel
  | Stmt.skip => Structured.Stmt.skip.fuel
  | Stmt.expr e => (Structured.Stmt.expr e.toExpr).fuel
  | Stmt.returnExpr e => (Structured.Stmt.returnExpr e.toExpr).fuel
  | Stmt.seq first second =>
      (Structured.Stmt.seq first.toStructured second.toStructured).fuel
  | Stmt.block body => (Structured.Stmt.block body.toStructured).fuel
  | Stmt.ifThen cond body =>
      (Structured.Stmt.ifThen cond.toExpr body.toStructured).fuel
  | Stmt.ifElse cond thenBody elseBody =>
      (Structured.Stmt.ifElse cond.toExpr thenBody.toStructured
        elseBody.toStructured).fuel
  | Stmt.forFalse body =>
      (Structured.Stmt.forFalse body.toStructured).fuel
  | Stmt.forOnce body =>
      (Structured.Stmt.forOnce body.toStructured).fuel
  | Stmt.forIf cond body =>
      (Structured.Stmt.forIf cond.toExpr body.toStructured).fuel

def Stmt.localValueFullYul (init : PureExpr) : SolidCoreYulCore.FullYul.Stmt :=
  (LocalFrame1.returnInit init).toFullYul

def Stmt.localUpdateValueFullYul (init assigned : PureExpr) :
    SolidCoreYulCore.FullYul.Stmt :=
  (LocalFrame1.updateValue init assigned).toFullYul

def Stmt.localPairAddValueFullYul (lhs rhs : PureExpr) :
    SolidCoreYulCore.FullYul.Stmt :=
  (LocalFrame2.addReturn lhs rhs).toFullYul

def Stmt.localPairUpdateAddValueFullYul
    (initLhs initRhs assignedLhs assignedRhs : PureExpr) :
    SolidCoreYulCore.FullYul.Stmt :=
  (LocalFrame2.assignAddReturn initLhs initRhs assignedLhs assignedRhs).toFullYul

def Stmt.forNeverReturnFullYul (afterExpr loopExpr : PureExpr) :
    SolidCoreYulCore.FullYul.Stmt :=
  SolidCoreYulCore.FullYul.Stmt.seq
    (SolidCoreYulCore.FullYul.Stmt.assign returnName afterExpr.toExpr.toFullYul)
    (SolidCoreYulCore.FullYul.Stmt.seq
      (SolidCoreYulCore.FullYul.Stmt.forLoop
        SolidCoreYulCore.FullYul.Stmt.skip
        (SolidCoreYulCore.FullYul.Expr.value
          (SolidCoreYulCore.FullYul.Value.word 0))
        SolidCoreYulCore.FullYul.Stmt.skip
        (SolidCoreYulCore.FullYul.Stmt.assign returnName loopExpr.toExpr.toFullYul))
      SolidCoreYulCore.FullYul.Stmt.leave)

def Stmt.forBreakReturnFullYul (afterExpr : PureExpr) :
    SolidCoreYulCore.FullYul.Stmt :=
  SolidCoreYulCore.FullYul.Stmt.seq
    (SolidCoreYulCore.FullYul.Stmt.forLoop
      SolidCoreYulCore.FullYul.Stmt.skip
      (SolidCoreYulCore.FullYul.Expr.value
        (SolidCoreYulCore.FullYul.Value.word 1))
      SolidCoreYulCore.FullYul.Stmt.skip
      SolidCoreYulCore.FullYul.Stmt.break)
    (SolidCoreYulCore.FullYul.Stmt.seq
      (SolidCoreYulCore.FullYul.Stmt.assign returnName afterExpr.toExpr.toFullYul)
      SolidCoreYulCore.FullYul.Stmt.leave)

def Stmt.forContinueReturnFullYul (afterExpr : PureExpr) :
    SolidCoreYulCore.FullYul.Stmt :=
  SolidCoreYulCore.FullYul.Stmt.seq
    (SolidCoreYulCore.FullYul.Stmt.assign returnName
      (SolidCoreYulCore.FullYul.Expr.value
        (SolidCoreYulCore.FullYul.Value.word 1)))
    (SolidCoreYulCore.FullYul.Stmt.seq
      (SolidCoreYulCore.FullYul.Stmt.forLoop
        SolidCoreYulCore.FullYul.Stmt.skip
        (SolidCoreYulCore.FullYul.Expr.var returnName)
        (SolidCoreYulCore.FullYul.Stmt.assign returnName
          (SolidCoreYulCore.FullYul.Expr.value
            (SolidCoreYulCore.FullYul.Value.word 0)))
        SolidCoreYulCore.FullYul.Stmt.continue)
      (SolidCoreYulCore.FullYul.Stmt.seq
        (SolidCoreYulCore.FullYul.Stmt.assign returnName
          afterExpr.toExpr.toFullYul)
        SolidCoreYulCore.FullYul.Stmt.leave))

def Stmt.toFullYul : Stmt -> SolidCoreYulCore.FullYul.Stmt
  | Stmt.localValue init => Stmt.localValueFullYul init
  | Stmt.localUpdateValue init assigned =>
      Stmt.localUpdateValueFullYul init assigned
  | Stmt.localPairAddValue lhs rhs =>
      Stmt.localPairAddValueFullYul lhs rhs
  | Stmt.localPairUpdateAddValue initLhs initRhs assignedLhs assignedRhs =>
      Stmt.localPairUpdateAddValueFullYul
        initLhs initRhs assignedLhs assignedRhs
  | Stmt.forNeverReturn afterExpr loopExpr =>
      Stmt.forNeverReturnFullYul afterExpr loopExpr
  | Stmt.forBreakReturn afterExpr =>
      Stmt.forBreakReturnFullYul afterExpr
  | Stmt.forContinueReturn afterExpr =>
      Stmt.forContinueReturnFullYul afterExpr
  | Stmt.ifReturn cond thenExpr elseExpr =>
      (Structured.Stmt.seq
        (Structured.Stmt.ifThen cond.toExpr
          (Structured.Stmt.returnExpr thenExpr.toExpr))
        (Structured.Stmt.returnExpr elseExpr.toExpr)).toFullYul
  | Stmt.ifThenStmtElseReturn cond thenBody elseExpr =>
      (Structured.Stmt.seq
        (Structured.Stmt.ifThen cond.toExpr thenBody.toStructured)
        (Structured.Stmt.returnExpr elseExpr.toExpr)).toFullYul
  | Stmt.ifThenReturnElseStmt cond thenExpr elseBody =>
      (Structured.Stmt.seq
        (Structured.Stmt.ifThen cond.toExpr
          (Structured.Stmt.returnExpr thenExpr.toExpr))
        elseBody.toStructured).toFullYul
  | Stmt.skip => Structured.Stmt.skip.toFullYul
  | Stmt.expr e => (Structured.Stmt.expr e.toExpr).toFullYul
  | Stmt.returnExpr e => (Structured.Stmt.returnExpr e.toExpr).toFullYul
  | Stmt.seq first second =>
      (Structured.Stmt.seq first.toStructured second.toStructured).toFullYul
  | Stmt.block body => (Structured.Stmt.block body.toStructured).toFullYul
  | Stmt.ifThen cond body =>
      (Structured.Stmt.ifThen cond.toExpr body.toStructured).toFullYul
  | Stmt.ifElse cond thenBody elseBody =>
      (Structured.Stmt.ifElse cond.toExpr thenBody.toStructured
        elseBody.toStructured).toFullYul
  | Stmt.forFalse body =>
      (Structured.Stmt.forFalse body.toStructured).toFullYul
  | Stmt.forOnce body =>
      (Structured.Stmt.forOnce body.toStructured).toFullYul
  | Stmt.forIf cond body =>
      (Structured.Stmt.forIf cond.toExpr body.toStructured).toFullYul

def Stmt.usesStructuredRoute : Stmt -> Bool
  | Stmt.localValue _ => false
  | Stmt.localUpdateValue _ _ => false
  | Stmt.localPairAddValue _ _ => false
  | Stmt.localPairUpdateAddValue _ _ _ _ => false
  | Stmt.forNeverReturn _ _ => false
  | Stmt.forBreakReturn _ => false
  | Stmt.forContinueReturn _ => false
  | Stmt.ifReturn _ _ _ => true
  | Stmt.ifThenStmtElseReturn _ _ _ => true
  | Stmt.ifThenReturnElseStmt _ _ _ => true
  | Stmt.skip => true
  | Stmt.expr _ => true
  | Stmt.returnExpr _ => true
  | Stmt.seq _ _ => true
  | Stmt.block _ => true
  | Stmt.ifThen _ _ => true
  | Stmt.ifElse _ _ _ => true
  | Stmt.forFalse _ => true
  | Stmt.forOnce _ => true
  | Stmt.forIf _ _ => true

theorem Stmt.toStructured_eval (state : State) (stmt : Stmt) :
    Structured.Stmt.eval state.toStructured stmt.toStructured =
      (stmt.eval state).toStructuredResult := by
  induction stmt generalizing state with
  | skip => rfl
  | expr _ => rfl
  | returnExpr e =>
      simp [Stmt.toStructured, Structured.Stmt.eval, Stmt.eval,
        State.toStructured, Result.toStructuredResult, PureExpr.toExpr_eval]
  | localValue e =>
      simp [Stmt.toStructured, Structured.Stmt.eval, Stmt.eval,
        State.toStructured, Result.toStructuredResult, PureExpr.toExpr_eval]
  | localUpdateValue init assigned =>
      simp [Stmt.toStructured, Structured.Stmt.eval, Stmt.eval,
        State.toStructured, Result.toStructuredResult, PureExpr.toExpr_eval]
  | localPairAddValue lhs rhs =>
      simp [Stmt.toStructured, Structured.Stmt.eval, Stmt.eval,
        State.toStructured, Result.toStructuredResult, PureExpr.toExpr_eval,
        PureExpr.eval]
  | localPairUpdateAddValue initLhs initRhs assignedLhs assignedRhs =>
      simp [Stmt.toStructured, Structured.Stmt.eval, Stmt.eval,
        State.toStructured, Result.toStructuredResult, PureExpr.toExpr_eval,
        PureExpr.eval]
  | forNeverReturn afterExpr loopExpr =>
      simp [Stmt.toStructured, Structured.Stmt.eval, Stmt.eval,
        State.toStructured, Result.toStructuredResult, PureExpr.toExpr_eval]
  | forBreakReturn afterExpr =>
      simp [Stmt.toStructured, Structured.Stmt.eval, Stmt.eval,
        State.toStructured, Result.toStructuredResult, PureExpr.toExpr_eval]
  | forContinueReturn afterExpr =>
      simp [Stmt.toStructured, Structured.Stmt.eval, Stmt.eval,
        State.toStructured, Result.toStructuredResult, PureExpr.toExpr_eval]
  | ifReturn cond thenExpr elseExpr =>
      by_cases hCond : SolidCoreYulCore.norm cond.eval = 0
      · simp [Stmt.toStructured, Structured.Stmt.eval, Stmt.eval, hCond,
          State.toStructured, Result.toStructuredResult, PureExpr.toExpr_eval]
      · simp [Stmt.toStructured, Structured.Stmt.eval, Stmt.eval, hCond,
          State.toStructured, Result.toStructuredResult, PureExpr.toExpr_eval]
  | ifThenStmtElseReturn cond thenBody elseExpr thenBody_ih =>
      by_cases hCond : SolidCoreYulCore.norm cond.eval = 0
      · simp [Stmt.toStructured, Structured.Stmt.eval, Stmt.eval, hCond,
          State.toStructured, Result.toStructuredResult, PureExpr.toExpr_eval]
      · cases hThen : Stmt.eval state thenBody with
        | normal state' =>
            have hStructThen := thenBody_ih state
            simp [Stmt.toStructured, Structured.Stmt.eval, Stmt.eval, hCond,
              State.toStructured, Result.toStructuredResult,
              PureExpr.toExpr_eval, hThen] at hStructThen ⊢
            rw [hStructThen]
        | returned state' =>
            have hStructThen := thenBody_ih state
            simp [Stmt.toStructured, Structured.Stmt.eval, Stmt.eval, hCond,
              State.toStructured, Result.toStructuredResult,
              PureExpr.toExpr_eval, hThen] at hStructThen ⊢
            rw [hStructThen]
  | ifThenReturnElseStmt cond thenExpr elseBody elseBody_ih =>
      by_cases hCond : SolidCoreYulCore.norm cond.eval = 0
      · cases hElse : Stmt.eval state elseBody with
        | normal state' =>
            have hStructElse := elseBody_ih state
            simp [Stmt.toStructured, Structured.Stmt.eval, Stmt.eval, hCond,
              State.toStructured, Result.toStructuredResult,
              PureExpr.toExpr_eval, hElse] at hStructElse ⊢
            rw [hStructElse]
        | returned state' =>
            have hStructElse := elseBody_ih state
            simp [Stmt.toStructured, Structured.Stmt.eval, Stmt.eval, hCond,
              State.toStructured, Result.toStructuredResult,
              PureExpr.toExpr_eval, hElse] at hStructElse ⊢
            rw [hStructElse]
      · simp [Stmt.toStructured, Structured.Stmt.eval, Stmt.eval, hCond,
          State.toStructured, Result.toStructuredResult, PureExpr.toExpr_eval]
  | seq first second first_ih second_ih =>
      cases hFirst : Stmt.eval state first with
      | normal state' =>
          have hStructFirst := first_ih state
          simp [Stmt.toStructured, Structured.Stmt.eval, Stmt.eval, hFirst,
            Result.toStructuredResult] at hStructFirst ⊢
          rw [hStructFirst]
          exact second_ih state'
      | returned state' =>
          have hStructFirst := first_ih state
          simp [Stmt.toStructured, Structured.Stmt.eval, Stmt.eval, hFirst,
            Result.toStructuredResult] at hStructFirst ⊢
          rw [hStructFirst]
  | block body body_ih =>
      simp [Stmt.toStructured, Structured.Stmt.eval, Stmt.eval,
        Result.toStructuredResult, body_ih state]
  | ifThen cond body body_ih =>
      by_cases hCond : SolidCoreYulCore.norm cond.eval = 0
      · simp [Stmt.toStructured, Structured.Stmt.eval, Stmt.eval, hCond,
          Result.toStructuredResult, PureExpr.toExpr_eval]
      · simp [Stmt.toStructured, Structured.Stmt.eval, Stmt.eval, hCond,
          Result.toStructuredResult, PureExpr.toExpr_eval, body_ih state]
  | ifElse cond thenBody elseBody then_ih else_ih =>
      by_cases hCond : SolidCoreYulCore.norm cond.eval = 0
      · have hIszeroNonzero :
            ¬ SolidCoreYulCore.norm (PureExpr.iszero cond).eval = 0 := by
          have hEvalMod : cond.eval % SolidCoreYulCore.wordModulus = 0 := by
            simpa [SolidCoreYulCore.norm] using hCond
          unfold PureExpr.eval SolidCoreYulCore.iszeroWord SolidCoreYulCore.norm
          rw [hEvalMod]
          decide
        have hIszeroNonzeroTarget :
            ¬ SolidCoreYulCore.norm (Expr.iszero cond.toExpr).eval = 0 := by
          have hEvalMod : cond.toExpr.eval % SolidCoreYulCore.wordModulus = 0 := by
            simpa [SolidCoreYulCore.norm, PureExpr.toExpr_eval] using hCond
          unfold Expr.eval SolidCoreYulCore.iszeroWord SolidCoreYulCore.norm
          rw [hEvalMod]
          decide
        simp [Stmt.toStructured, Structured.Stmt.eval, Stmt.eval, hCond,
          hIszeroNonzero, hIszeroNonzeroTarget, Result.toStructuredResult,
          PureExpr.toExpr_eval, else_ih state]
      · have hIszeroZero :
            SolidCoreYulCore.norm (PureExpr.iszero cond).eval = 0 := by
          have hEvalMod : cond.eval % SolidCoreYulCore.wordModulus ≠ 0 := by
            simpa [SolidCoreYulCore.norm] using hCond
          simp [PureExpr.eval, SolidCoreYulCore.iszeroWord, hEvalMod,
            SolidCoreYulCore.norm]
        have hIszeroZeroTarget :
            SolidCoreYulCore.norm (Expr.iszero cond.toExpr).eval = 0 := by
          have hEvalMod : cond.toExpr.eval % SolidCoreYulCore.wordModulus ≠ 0 := by
            simpa [SolidCoreYulCore.norm, PureExpr.toExpr_eval] using hCond
          simp [Expr.eval, SolidCoreYulCore.iszeroWord, hEvalMod,
            SolidCoreYulCore.norm]
        cases hThen : Stmt.eval state thenBody with
        | normal state' =>
            have hStructThen := then_ih state
            simp [Stmt.toStructured, Structured.Stmt.eval, Stmt.eval, hCond,
              hIszeroZero, hIszeroZeroTarget, Result.toStructuredResult,
              PureExpr.toExpr_eval, hThen] at hStructThen ⊢
            rw [hStructThen]
        | returned state' =>
            have hStructThen := then_ih state
            simp [Stmt.toStructured, Structured.Stmt.eval, Stmt.eval, hCond,
              hIszeroZero, hIszeroZeroTarget, Result.toStructuredResult,
              PureExpr.toExpr_eval, hThen] at hStructThen ⊢
            rw [hStructThen]
  | forFalse body body_ih =>
      simp [Stmt.toStructured, Structured.Stmt.eval, Stmt.eval,
        Result.toStructuredResult]
  | forOnce body body_ih =>
      simp [Stmt.toStructured, Structured.Stmt.eval, Stmt.eval,
        Result.toStructuredResult, body_ih state]
  | forIf cond body body_ih =>
      by_cases hCond : SolidCoreYulCore.norm cond.eval = 0
      · simp [Stmt.toStructured, Structured.Stmt.eval, Stmt.eval, hCond,
          Result.toStructuredResult, PureExpr.toExpr_eval]
      · simp [Stmt.toStructured, Structured.Stmt.eval, Stmt.eval, hCond,
          Result.toStructuredResult, PureExpr.toExpr_eval, body_ih state]

theorem Stmt.toFullYul_correct_from_structured
    (extraFuel : Nat) (state : State) (stmt : Stmt)
    (hFuel : stmt.fuel = stmt.toStructured.fuel)
    (hFullYul : stmt.toFullYul = stmt.toStructured.toFullYul) :
    SolidCoreYulCore.SymYul.evalStmtFuel
        (stmt.fuel + extraFuel + 1)
        state.toConfig stmt.toFullYul =
      (stmt.eval state).toStructuredResult.toSymYulResults := by
  have hStructured :=
    Structured.Stmt.toFullYul_correct_from extraFuel
      state.toStructured stmt.toStructured
  simpa [State.toConfig, hFuel, hFullYul, Stmt.toStructured_eval]
    using hStructured

theorem Stmt.toFullYul_staticChecked_structured
    (stmt : Stmt)
    (hFuel : stmt.fuel = stmt.toStructured.fuel)
    (hFullYul : stmt.toFullYul = stmt.toStructured.toFullYul) :
