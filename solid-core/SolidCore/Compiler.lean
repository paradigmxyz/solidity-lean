def Expr.toFullYul : Expr -> SolidCoreYulCore.FullYul.Expr
  | Expr.lit value =>
      SolidCoreYulCore.FullYul.Expr.value
        (SolidCoreYulCore.FullYul.Value.word (SolidCoreYulCore.norm value))
  | Expr.neg expr =>
      SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.sub
        [ SolidCoreYulCore.FullYul.Expr.value
            (SolidCoreYulCore.FullYul.Value.word 0)
        , expr.toFullYul ]
  | Expr.add lhs rhs =>
      SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.add
        [lhs.toFullYul, rhs.toFullYul]
  | Expr.sub lhs rhs =>
      SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.sub
        [lhs.toFullYul, rhs.toFullYul]
  | Expr.mul lhs rhs =>
      SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.mul
        [lhs.toFullYul, rhs.toFullYul]
  | Expr.exp lhs rhs =>
      SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.expOp
        [lhs.toFullYul, rhs.toFullYul]
  | Expr.div lhs rhs =>
      SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.divOp
        [lhs.toFullYul, rhs.toFullYul]
  | Expr.mod lhs rhs =>
      SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.modOp
        [lhs.toFullYul, rhs.toFullYul]
  | Expr.signedDiv lhs rhs =>
      SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.sdivOp
        [lhs.toFullYul, rhs.toFullYul]
  | Expr.signedMod lhs rhs =>
      SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.smodOp
        [lhs.toFullYul, rhs.toFullYul]
  | Expr.addmod lhs rhs modulus =>
      SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.addmodOp
        [lhs.toFullYul, rhs.toFullYul, modulus.toFullYul]
  | Expr.mulmod lhs rhs modulus =>
      SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.mulmodOp
        [lhs.toFullYul, rhs.toFullYul, modulus.toFullYul]
  | Expr.bitAnd lhs rhs =>
      SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.andOp
        [lhs.toFullYul, rhs.toFullYul]
  | Expr.bitOr lhs rhs =>
      SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.orOp
        [lhs.toFullYul, rhs.toFullYul]
  | Expr.bitXor lhs rhs =>
      SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.xorOp
        [lhs.toFullYul, rhs.toFullYul]
  | Expr.bitNot expr =>
      SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.notOp
        [expr.toFullYul]
  | Expr.shl value shift =>
      SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.shlOp
        [shift.toFullYul, value.toFullYul]
  | Expr.shr value shift =>
      SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.shrOp
        [shift.toFullYul, value.toFullYul]
  | Expr.sar value shift =>
      SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.sarOp
        [shift.toFullYul, value.toFullYul]
  | Expr.byteAt index value =>
      SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.byteOp
        [index.toFullYul, value.toFullYul]
  | Expr.iszero expr =>
      SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.iszero
        [expr.toFullYul]
  | Expr.boolAnd lhs rhs =>
      SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.iszero
        [SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.orOp
          [ SolidCoreYulCore.FullYul.Expr.builtin
              SolidCoreYulCore.Evm.Builtin.iszero [lhs.toFullYul]
          , SolidCoreYulCore.FullYul.Expr.builtin
              SolidCoreYulCore.Evm.Builtin.iszero [rhs.toFullYul] ]]
  | Expr.boolOr lhs rhs =>
      SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.iszero
        [SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.andOp
          [ SolidCoreYulCore.FullYul.Expr.builtin
              SolidCoreYulCore.Evm.Builtin.iszero [lhs.toFullYul]
          , SolidCoreYulCore.FullYul.Expr.builtin
              SolidCoreYulCore.Evm.Builtin.iszero [rhs.toFullYul] ]]
  | Expr.eq lhs rhs =>
      SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.eqOp
        [lhs.toFullYul, rhs.toFullYul]
  | Expr.ne lhs rhs =>
      SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.iszero
        [SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.eqOp
          [lhs.toFullYul, rhs.toFullYul]]
  | Expr.lt lhs rhs =>
      SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.ltOp
        [lhs.toFullYul, rhs.toFullYul]
  | Expr.gt lhs rhs =>
      SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.gtOp
        [lhs.toFullYul, rhs.toFullYul]
  | Expr.le lhs rhs =>
      SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.iszero
        [SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.gtOp
          [lhs.toFullYul, rhs.toFullYul]]
  | Expr.ge lhs rhs =>
      SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.iszero
        [SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.ltOp
          [lhs.toFullYul, rhs.toFullYul]]
  | Expr.signedLt lhs rhs =>
      SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.sltOp
        [lhs.toFullYul, rhs.toFullYul]
  | Expr.signedGt lhs rhs =>
      SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.sgtOp
        [lhs.toFullYul, rhs.toFullYul]
  | Expr.signedLe lhs rhs =>
      SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.iszero
        [SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.sgtOp
          [lhs.toFullYul, rhs.toFullYul]]
  | Expr.signedGe lhs rhs =>
      SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.iszero
        [SolidCoreYulCore.FullYul.Expr.builtin SolidCoreYulCore.Evm.Builtin.sltOp
          [lhs.toFullYul, rhs.toFullYul]]

private theorem currentSolidCore_value_word_compilerEmittable (value : Word) :
    SolidCoreYulCore.FullYul.CompilerEmittableExpr
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      (SolidCoreYulCore.FullYul.Expr.value
        (SolidCoreYulCore.FullYul.Value.word value)) := by
  exact SolidCoreYulCore.FullYul.CompilerEmittableExpr.value
    (SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreValue.word value)

private theorem currentSolidCore_var_compilerEmittable
    (name : SolidCoreYulCore.FullYul.Name) :
    SolidCoreYulCore.FullYul.CompilerEmittableExpr
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      (SolidCoreYulCore.FullYul.Expr.var name) := by
  exact SolidCoreYulCore.FullYul.CompilerEmittableExpr.var name

private theorem currentSolidCore_builtin1_compilerEmittable
    {builtin : SolidCoreYulCore.Evm.Builtin}
    (hBuiltin :
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore.builtinOK
        builtin)
    {arg : SolidCoreYulCore.FullYul.Expr}
    (hArg :
      SolidCoreYulCore.FullYul.CompilerEmittableExpr
        SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore arg) :
    SolidCoreYulCore.FullYul.CompilerEmittableExpr
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      (SolidCoreYulCore.FullYul.Expr.builtin builtin [arg]) := by
  exact SolidCoreYulCore.FullYul.CompilerEmittableExpr.builtin hBuiltin
    (SolidCoreYulCore.FullYul.CompilerEmittableExprs.cons hArg
      SolidCoreYulCore.FullYul.CompilerEmittableExprs.nil)

private theorem currentSolidCore_builtin2_compilerEmittable
    {builtin : SolidCoreYulCore.Evm.Builtin}
    (hBuiltin :
