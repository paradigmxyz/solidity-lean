theorem Program.toFullYulStmt_eq_storageCore_of_some
    {program : Program} {core : Core.Storage.Stmt}
    (h : program.toStorageCore? = some core) :
    program.toFullYulStmt = core.toFullYul := by
  cases program <;> simp [Program.toStorageCore?] at h
  · cases h
    simpa [Program.toFullYulStmt] using
      Program.storageWriteReadFullYul_eq_core
  · cases h
    simpa [Program.toFullYulStmt] using
