theorem Expr.toFullYul_correct (expr : Expr) :
    SolidCoreYulCore.SymYul.evalExpr SolidCoreYulCore.SymYul.Config.empty
        expr.toFullYul =
      some (SolidCoreYulCore.FullYul.Value.word expr.eval,
        SolidCoreYulCore.SymYul.Config.empty) := by
  exact Expr.toFullYul_correct_env SolidCoreYulCore.SymYul.Config.empty expr

theorem Expr.toFullYul_staticChecked
    (ctx : SolidCoreYulCore.FullYul.StaticContext) (expr : Expr) :
    SolidCoreYulCore.FullYul.checkExpr ctx expr.toFullYul = true := by
  induction expr <;> simp [Expr.toFullYul,
    SolidCoreYulCore.FullYul.checkExpr,
    SolidCoreYulCore.FullYul.checkExprs,
    SolidCoreYulCore.Evm.Builtin.signature?, *]

def Expr.toFoldedFullYul (expr : Expr) : SolidCoreYulCore.FullYul.Expr :=
  SolidCoreYulCore.FullYul.Expr.value
    (SolidCoreYulCore.FullYul.Value.word expr.eval)

theorem Expr.toFoldedFullYul_correct (expr : Expr) :
    SolidCoreYulCore.FullYul.evalExpr [] expr.toFoldedFullYul =
      some (SolidCoreYulCore.FullYul.Value.word expr.eval) := by
  rfl

theorem Expr.toFoldedFullYul_correct_env
    (env : SolidCoreYulCore.FullYul.Env) (expr : Expr) :
    SolidCoreYulCore.FullYul.evalExpr env expr.toFoldedFullYul =
      some (SolidCoreYulCore.FullYul.Value.word expr.eval) := by
  rfl

@[simp] theorem symYulConfigEmpty_halt? :
    SolidCoreYulCore.SymYul.Config.empty.evm.halt? = none := by
  rfl

inductive Body where
  | returnExpr : Expr -> Body
  | seqExpr : Expr -> Body -> Body
  | block : Body -> Body
  | localValue : Expr -> Body
  | localUpdateValue : Expr -> Expr -> Body
  | localPairAddValue : Expr -> Expr -> Body
  | localPairUpdateAddValue : Expr -> Expr -> Expr -> Expr -> Body
  | forNeverReturn : Expr -> Expr -> Body
  | forBreakReturn : Expr -> Body
  | forContinueReturn : Expr -> Body
  | internalCallReturn : Body
  | ifReturn : Expr -> Expr -> Expr -> Body
  | ifThenBodyElseReturn : Expr -> Body -> Expr -> Body
  | ifThenReturnElseBody : Expr -> Expr -> Body -> Body
  deriving DecidableEq, Repr

def Body.ifReturnEval (cond thenExpr elseExpr : Expr) : Word :=
  if SolidCoreYulCore.norm cond.eval = 0 then elseExpr.eval else thenExpr.eval

def Body.eval : Body -> Word
  | Body.returnExpr expr => expr.eval
  | Body.seqExpr _ rest => rest.eval
  | Body.block body => body.eval
  | Body.localValue init => init.eval
  | Body.localUpdateValue _ assigned => assigned.eval
  | Body.localPairAddValue lhs rhs =>
      SolidCoreYulCore.addWord lhs.eval rhs.eval
  | Body.localPairUpdateAddValue _ _ assignedLhs assignedRhs =>
      SolidCoreYulCore.addWord assignedLhs.eval assignedRhs.eval
  | Body.forNeverReturn afterExpr _ => afterExpr.eval
  | Body.forBreakReturn afterExpr => afterExpr.eval
  | Body.forContinueReturn afterExpr => afterExpr.eval
  | Body.internalCallReturn => SolidCoreYulCore.norm 7
  | Body.ifReturn cond thenExpr elseExpr =>
      Body.ifReturnEval cond thenExpr elseExpr
  | Body.ifThenBodyElseReturn cond thenBody elseExpr =>
      if SolidCoreYulCore.norm cond.eval = 0 then elseExpr.eval else thenBody.eval
  | Body.ifThenReturnElseBody cond thenExpr elseBody =>
      if SolidCoreYulCore.norm cond.eval = 0 then elseBody.eval else thenExpr.eval

def Body.ifThenBodyElseReturnEval
    (cond : Expr) (thenBody : Body) (elseExpr : Expr) : Word :=
  if SolidCoreYulCore.norm cond.eval = 0 then elseExpr.eval else thenBody.eval

def Body.ifThenReturnElseBodyEval
    (cond thenExpr : Expr) (elseBody : Body) : Word :=
  if SolidCoreYulCore.norm cond.eval = 0 then elseBody.eval else thenExpr.eval

def Body.fuel : Body -> Nat
  | Body.returnExpr _ => 2
  | Body.seqExpr _ rest => rest.fuel + 1
  | Body.block body => body.fuel + 2
  | Body.localValue _ => 5
  | Body.localUpdateValue _ _ => 5
  | Body.localPairAddValue _ _ => 5
  | Body.localPairUpdateAddValue _ _ _ _ => 5
  | Body.forNeverReturn _ _ => 4
  | Body.forBreakReturn _ => 5
  | Body.forContinueReturn _ => 8
  | Body.internalCallReturn => 8
  | Body.ifReturn _ _ _ => 4
  | Body.ifThenBodyElseReturn _ thenBody _ => thenBody.fuel + 2
  | Body.ifThenReturnElseBody _ _ elseBody => elseBody.fuel + 1

theorem Body.fuel_atLeastTwo (body : Body) : 2 <= body.fuel := by
  induction body with
  | returnExpr _ => simp [Body.fuel]
  | seqExpr _ rest ih =>
      exact Nat.le_trans ih (Nat.le_succ rest.fuel)
  | block _ ih => simp [Body.fuel]
  | localValue _ => simp [Body.fuel]
  | localUpdateValue _ _ => simp [Body.fuel]
  | localPairAddValue _ _ => simp [Body.fuel]
  | localPairUpdateAddValue _ _ _ _ => simp [Body.fuel]
  | forNeverReturn _ _ => simp [Body.fuel]
  | forBreakReturn _ => simp [Body.fuel]
  | forContinueReturn _ => simp [Body.fuel]
  | internalCallReturn => simp [Body.fuel]
  | ifReturn _ _ _ => simp [Body.fuel]
  | ifThenBodyElseReturn _ _ _ ih => simp [Body.fuel]
  | ifThenReturnElseBody _ _ elseBody ih =>
      exact Nat.le_trans ih (Nat.le_succ elseBody.fuel)

