namespace Core
namespace Storage
namespace InternalCall

inductive Stmt where
  | noArgWriteRead : Stmt
  | argWriteRead : Stmt
  | argReturnWriteRead : Stmt
  | pairArgReturnWriteReadAdd : Stmt
  | readUpdateReturn : Stmt
  | conditionalReturn : Stmt
  | conditionalFalseReturn : Stmt
  | nestedWriteRead : Stmt
  deriving DecidableEq, Repr

def Stmt.toFrame :
    Stmt -> _root_.SolidCore.Solidity.InternalStorageCallFrame
  | Stmt.noArgWriteRead =>
      _root_.SolidCore.Solidity.InternalStorageCallFrame.noArgWriteRead
  | Stmt.argWriteRead =>
      _root_.SolidCore.Solidity.InternalStorageCallFrame.argWriteRead
  | Stmt.argReturnWriteRead =>
      _root_.SolidCore.Solidity.InternalStorageCallFrame.argReturnWriteRead
  | Stmt.pairArgReturnWriteReadAdd =>
      _root_.SolidCore.Solidity.InternalStorageCallFrame.pairArgReturnWriteReadAdd
  | Stmt.readUpdateReturn =>
      _root_.SolidCore.Solidity.InternalStorageCallFrame.readUpdateReturn
  | Stmt.conditionalReturn =>
      _root_.SolidCore.Solidity.InternalStorageCallFrame.conditionalReturn
  | Stmt.conditionalFalseReturn =>
      _root_.SolidCore.Solidity.InternalStorageCallFrame.conditionalFalseReturn
  | Stmt.nestedWriteRead =>
      _root_.SolidCore.Solidity.InternalStorageCallFrame.nestedWriteRead

def Stmt.toProgram (stmt : Stmt) : Program :=
  stmt.toFrame.toProgram

def Stmt.fuel (stmt : Stmt) : Nat :=
  stmt.toFrame.fuel

def Stmt.toFullYul (stmt : Stmt) : SolidCoreYulCore.FullYul.Stmt :=
  stmt.toFrame.toFullYul

theorem Stmt.toFullYul_correct (stmt : Stmt) :
    SolidCoreYulCore.SymYul.evalStmtFuel stmt.fuel
        Body.initialSymYulConfig stmt.toFullYul =
      [SolidCoreYulCore.SymYul.normalResult
        stmt.toProgram.finalSymYulConfig] := by
  simpa [Stmt.fuel, Stmt.toFullYul, Stmt.toProgram] using
    _root_.SolidCore.Solidity.InternalStorageCallFrame.toFullYul_correct
      stmt.toFrame

theorem Stmt.toFullYul_staticChecked (stmt : Stmt) :
    SolidCoreYulCore.FullYul.checkStmtFuel (stmt.fuel + 1)
        Program.initialStaticContext false false stmt.toFullYul =
      some Program.initialStaticContext := by
  simpa [Stmt.fuel, Stmt.toFullYul] using
    _root_.SolidCore.Solidity.InternalStorageCallFrame.toFullYul_staticChecked
      stmt.toFrame

theorem Stmt.toFullYul_compilerEmittable (stmt : Stmt) :
    SolidCoreYulCore.FullYul.CompilerEmittableStmt
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      stmt.toFullYul := by
  simpa [Stmt.toFullYul] using
    _root_.SolidCore.Solidity.InternalStorageCallFrame.toFullYul_compilerEmittable
      stmt.toFrame

end InternalCall
end Storage
end Core

def Program.toInternalStorageCore? :
    Program -> Option Core.Storage.InternalCall.Stmt
  | Program.internalStorageCall =>
      some Core.Storage.InternalCall.Stmt.noArgWriteRead
  | Program.internalStorageArgCall =>
      some Core.Storage.InternalCall.Stmt.argWriteRead
  | Program.internalStorageArgReturnCall =>
      some Core.Storage.InternalCall.Stmt.argReturnWriteRead
  | Program.internalStoragePairArgReturnCall =>
      some Core.Storage.InternalCall.Stmt.pairArgReturnWriteReadAdd
  | Program.internalStorageReadUpdateCall =>
      some Core.Storage.InternalCall.Stmt.readUpdateReturn
  | Program.internalStorageConditionalCall =>
      some Core.Storage.InternalCall.Stmt.conditionalReturn
  | Program.internalStorageConditionalFalseCall =>
      some Core.Storage.InternalCall.Stmt.conditionalFalseReturn
  | Program.nestedInternalStorageCall =>
      some Core.Storage.InternalCall.Stmt.nestedWriteRead
  | _ => none

theorem Program.toInternalStorageCore?_some_toProgram
    {program : Program} {core : Core.Storage.InternalCall.Stmt}
    (h : program.toInternalStorageCore? = some core) :
    core.toProgram = program := by
  cases program <;> simp [Program.toInternalStorageCore?] at h
  all_goals cases h; rfl

theorem Program.toFullYulStmt_eq_internalStorageCore_of_some
    {program : Program} {core : Core.Storage.InternalCall.Stmt}
    (h : program.toInternalStorageCore? = some core) :
    program.toFullYulStmt = core.toFullYul := by
  cases program <;> simp [Program.toInternalStorageCore?] at h
  · cases h
    rfl
  · cases h
    rfl
  · cases h
    rfl
  · cases h
    rfl
  · cases h
    rfl
  · cases h
    rfl
  · cases h
    rfl
  · cases h
    rfl

theorem Program.toFullYulStmt_correct_via_internalStorageCore_of_some
    {program : Program} {core : Core.Storage.InternalCall.Stmt}
    (h : program.toInternalStorageCore? = some core) :
    SolidCoreYulCore.SymYul.evalStmtFuel
        program.stmtFuel
        Body.initialSymYulConfig
        program.toFullYulStmt =
      [SolidCoreYulCore.SymYul.normalResult program.finalSymYulConfig] := by
  rw [Program.toFullYulStmt_eq_internalStorageCore_of_some h]
  have hProgram := Program.toInternalStorageCore?_some_toProgram h
  have hFuel : core.toFrame.fuel = program.stmtFuel := by
    simpa [Core.Storage.InternalCall.Stmt.toProgram,
      InternalStorageCallFrame.fuel] using
        congrArg Program.stmtFuel hProgram
  rw [← hFuel]
  simpa [Core.Storage.InternalCall.Stmt.fuel, hProgram] using
    Core.Storage.InternalCall.Stmt.toFullYul_correct core

theorem Program.internalStorageCore_toFullYul_correct_of_some
    {program : Program} {core : Core.Storage.InternalCall.Stmt}
    (h : program.toInternalStorageCore? = some core) :
    SolidCoreYulCore.SymYul.evalStmtFuel
        program.stmtFuel
        Body.initialSymYulConfig
        core.toFullYul =
      [SolidCoreYulCore.SymYul.normalResult program.finalSymYulConfig] := by
  rw [← Program.toFullYulStmt_eq_internalStorageCore_of_some h]
  exact Program.toFullYulStmt_correct_via_internalStorageCore_of_some h

namespace Core

inductive AcceptedProgram where
  | body : BodyStmt -> AcceptedProgram
  | storage : Storage.Stmt -> AcceptedProgram
  | internalCall : InternalCall.Stmt -> AcceptedProgram
  | internalStorage : Storage.InternalCall.Stmt -> AcceptedProgram
  | typedStmt : TypedStmt -> AcceptedProgram

def AcceptedProgram.toFullYul : AcceptedProgram -> SolidCoreYulCore.FullYul.Stmt
  | AcceptedProgram.body stmt => stmt.toFullYul
  | AcceptedProgram.storage stmt => stmt.toFullYul
  | AcceptedProgram.internalCall stmt => stmt.toFullYul
  | AcceptedProgram.internalStorage stmt => stmt.toFullYul
  | AcceptedProgram.typedStmt stmt => stmt.erase.toFullYul

def AcceptedProgram.fuel : AcceptedProgram -> Nat
  | AcceptedProgram.body stmt => stmt.fuel
  | AcceptedProgram.storage stmt => stmt.fuel
  | AcceptedProgram.internalCall stmt => stmt.fuel
  | AcceptedProgram.internalStorage stmt => stmt.fuel
  | AcceptedProgram.typedStmt stmt => stmt.erase.fuel + 1

theorem AcceptedProgram.body_toFullYul_correct
    (stmt : BodyStmt) :
    SolidCoreYulCore.SymYul.evalStmtFuel
        (AcceptedProgram.body stmt).fuel
        Body.initialSymYulConfig
        (AcceptedProgram.body stmt).toFullYul =
      [SolidCoreYulCore.SymYul.normalResult
        (Body.returnConfig stmt.eval)] := by
  simpa [AcceptedProgram.fuel, AcceptedProgram.toFullYul] using
    BodyStmt.toFullYul_correct stmt

theorem AcceptedProgram.storage_toFullYul_correct_from
    (state : Storage.State) (stmt : Storage.Stmt) :
    SolidCoreYulCore.SymYul.evalStmtFuel
        (AcceptedProgram.storage stmt).fuel
        state.toConfig
        (AcceptedProgram.storage stmt).toFullYul =
      [SolidCoreYulCore.SymYul.normalResult
        (stmt.eval state).toConfig] := by
