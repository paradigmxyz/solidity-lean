      SolidCoreYulCore.FullYul.CompilerAcceptedStmt
        SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
        program.stmtFuel.succ Solidity.Program.initialStaticContext
        false false core.toFullYul
        Solidity.Program.initialStaticContext := by
  rcases parseGeneratedLocalPairAddReturn?_localPairAddValue_some h with
    ⟨lhsExpr, rhsExpr, hProgram⟩
  subst program
  let core :=
    Solidity.Core.AcceptedProgram.body
      (Solidity.Core.BodyStmt.ofBody
        (Solidity.Body.localPairAddValue lhsExpr rhsExpr))
  have hCore :
      (Solidity.Program.functionBody
        (Solidity.Body.localPairAddValue lhsExpr rhsExpr)).toCore? =
          some core := by
