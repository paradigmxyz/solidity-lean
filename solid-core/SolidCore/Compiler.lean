def Body.noFun : Body -> Bool
  | Body.returnExpr _ => true
  | Body.seqExpr _ rest => rest.noFun
  | Body.block body => body.noFun
  | Body.localValue _ => true
  | Body.localUpdateValue _ _ => true
  | Body.localPairAddValue _ _ => true
  | Body.localPairUpdateAddValue _ _ _ _ => true
  | Body.forNeverReturn _ _ => true
  | Body.forBreakReturn _ => true
  | Body.forContinueReturn _ => true
  | Body.internalCallReturn => false
  | Body.ifReturn _ _ _ => true
  | Body.ifThenBodyElseReturn _ thenBody _ => thenBody.noFun
  | Body.ifThenReturnElseBody _ _ elseBody => elseBody.noFun

theorem Body.predeclare_toFullYul_of_noFun
    (ctx : SolidCoreYulCore.FullYul.StaticContext) {body : Body}
    (hNoFun : body.noFun = true) :
    SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?
        ctx body.toFullYul =
      some ctx := by
  induction body generalizing ctx with
  | returnExpr expr =>
      rfl
  | seqExpr expr rest ih =>
      simp [Body.noFun] at hNoFun
      have hRest :
          SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?
              ctx rest.toFullYul =
            some ctx := ih ctx hNoFun
      simp [Body.toFullYul, SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?,
        hRest]
  | block body ih =>
      simp [Body.noFun] at hNoFun
      have hBody :
          SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?
              ctx body.toFullYul =
            some ctx := ih ctx hNoFun
      simp [Body.toFullYul, SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?,
        SolidCoreYulCore.FullYul.predeclareBlockFunctionSigs?, hBody]
  | localValue init =>
      rfl
  | localUpdateValue init assigned =>
      rfl
  | localPairAddValue lhs rhs =>
      rfl
  | localPairUpdateAddValue initLhs initRhs assignedLhs assignedRhs =>
      rfl
  | forNeverReturn afterExpr loopExpr =>
      rfl
  | forBreakReturn afterExpr =>
      rfl
  | forContinueReturn afterExpr =>
      simp [Body.toFullYul, Body.forContinueReturnFullYul,
        SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?]
  | internalCallReturn =>
      simp [Body.noFun] at hNoFun
  | ifReturn cond thenExpr elseExpr =>
      rfl
  | ifThenBodyElseReturn cond thenBody elseExpr ih =>
      simp [Body.noFun] at hNoFun
      simp [Body.toFullYul, SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?]
  | ifThenReturnElseBody cond thenExpr elseBody ih =>
      simp [Body.noFun] at hNoFun
      have hElse :
          SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?
              ctx elseBody.toFullYul =
            some ctx := ih ctx hNoFun
      simp [Body.toFullYul, SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?,
        hElse]

theorem Body.stmtHasNoFunDefs_toFullYul_of_noFun
    {body : Body} (hNoFun : body.noFun = true) :
    SolidCoreYulCore.FullYul.stmtHasNoFunDefs body.toFullYul = true := by
  induction body with
  | returnExpr expr =>
      rfl
  | seqExpr expr rest ih =>
      simp [Body.noFun] at hNoFun
      have hRest :
          SolidCoreYulCore.FullYul.stmtHasNoFunDefs
              rest.toFullYul = true :=
        ih hNoFun
      simp [Body.toFullYul, SolidCoreYulCore.FullYul.stmtHasNoFunDefs,
        hRest]
  | block body ih =>
      simp [Body.noFun] at hNoFun
      have hBody :
          SolidCoreYulCore.FullYul.stmtHasNoFunDefs
              body.toFullYul = true :=
        ih hNoFun
      simp [Body.toFullYul, SolidCoreYulCore.FullYul.stmtHasNoFunDefs,
        SolidCoreYulCore.FullYul.blockHasNoFunDefs, hBody]
  | localValue init =>
      rfl
  | localUpdateValue init assigned =>
      rfl
  | localPairAddValue lhs rhs =>
      rfl
  | localPairUpdateAddValue initLhs initRhs assignedLhs assignedRhs =>
      rfl
  | forNeverReturn afterExpr loopExpr =>
      rfl
  | forBreakReturn afterExpr =>
      rfl
  | forContinueReturn afterExpr =>
      rfl
  | internalCallReturn =>
      simp [Body.noFun] at hNoFun
  | ifReturn cond thenExpr elseExpr =>
      rfl
  | ifThenBodyElseReturn cond thenBody elseExpr ih =>
      simp [Body.noFun] at hNoFun
      have hThen :
          SolidCoreYulCore.FullYul.stmtHasNoFunDefs
              thenBody.toFullYul = true :=
        ih hNoFun
      simp [Body.toFullYul, SolidCoreYulCore.FullYul.stmtHasNoFunDefs,
        hThen]
  | ifThenReturnElseBody cond thenExpr elseBody ih =>
      simp [Body.noFun] at hNoFun
      have hElse :
          SolidCoreYulCore.FullYul.stmtHasNoFunDefs
              elseBody.toFullYul = true :=
        ih hNoFun
      simp [Body.toFullYul, SolidCoreYulCore.FullYul.stmtHasNoFunDefs,
        hElse]

theorem Body.toFullYul_staticChecked_of_noFun
    (body : Body) (hNoFun : body.noFun = true) :
    SolidCoreYulCore.FullYul.checkStmtFuel body.fuel.succ
        Program.initialStaticContext false false body.toFullYul =
      some Program.initialStaticContext := by
  induction body with
  | returnExpr expr =>
      simp [Body.fuel, Body.toFullYul, Program.initialStaticContext,
        returnName, SolidCoreYulCore.FullYul.checkStmtFuel,
        SolidCoreYulCore.FullYul.checkExpr,
        SolidCoreYulCore.FullYul.containsName,
        Expr.toFullYul_staticChecked]
  | seqExpr expr rest ih =>
      simp [Body.noFun] at hNoFun
      have hPre :
          SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?
              Program.initialStaticContext rest.toFullYul =
            some Program.initialStaticContext :=
        Body.predeclare_toFullYul_of_noFun
          Program.initialStaticContext hNoFun
      simpa [Body.fuel, Body.toFullYul,
        SolidCoreYulCore.FullYul.checkStmtFuel,
        SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?,
        hPre] using ih hNoFun
  | block body ih =>
      simp [Body.noFun] at hNoFun
      have hPre :
          SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?
              Program.initialStaticContext body.toFullYul =
            some Program.initialStaticContext :=
        Body.predeclare_toFullYul_of_noFun
          Program.initialStaticContext hNoFun
      have hBody := ih hNoFun
      have hBody' :
          SolidCoreYulCore.FullYul.checkStmtFuel
              (body.fuel + 1)
              Program.initialStaticContext false false
              body.toFullYul =
            some Program.initialStaticContext := by
        simpa using hBody
      simp [Body.fuel, Body.toFullYul,
        SolidCoreYulCore.FullYul.checkStmtFuel,
        SolidCoreYulCore.FullYul.checkBlockFuel,
        SolidCoreYulCore.FullYul.predeclareBlockFunctionSigs?,
        hPre, hBody']
  | localValue init =>
      simpa [Body.fuel, Body.toFullYul, Body.localValueFullYul,
        Program.initialStaticContext, BodyLocalFrame1.fuel] using
        BodyLocalFrame1.toFullYul_staticChecked
          (BodyLocalFrame1.returnInit init)
  | localUpdateValue init assigned =>
      simpa [Body.fuel, Body.toFullYul, Body.localUpdateValueFullYul,
        Program.initialStaticContext, BodyLocalFrame1.fuel] using
        BodyLocalFrame1.toFullYul_staticChecked
          (BodyLocalFrame1.updateValue init assigned)
  | localPairAddValue lhs rhs =>
      simpa [Body.fuel, Body.toFullYul, Body.localPairAddValueFullYul,
        Program.initialStaticContext, BodyLocalFrame2.fuel] using
        BodyLocalFrame2.toFullYul_staticChecked
          (BodyLocalFrame2.addReturn lhs rhs)
  | localPairUpdateAddValue initLhs initRhs assignedLhs assignedRhs =>
      simpa [Body.fuel, Body.toFullYul, Body.localPairUpdateAddValueFullYul,
        Program.initialStaticContext, BodyLocalFrame2.fuel] using
        BodyLocalFrame2.toFullYul_staticChecked
          (BodyLocalFrame2.assignAddReturn initLhs initRhs
            assignedLhs assignedRhs)
  | forNeverReturn afterExpr loopExpr =>
      simp [Body.fuel, Body.toFullYul, Body.forNeverReturnFullYul,
        Program.initialStaticContext, returnName,
        SolidCoreYulCore.FullYul.checkStmtFuel,
        SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?,
        SolidCoreYulCore.FullYul.stmtHasNoFunDefs,
        SolidCoreYulCore.FullYul.containsName,
        SolidCoreYulCore.FullYul.checkExpr,
        Expr.toFullYul_staticChecked]
  | forBreakReturn afterExpr =>
      simp [Body.fuel, Body.toFullYul, Body.forBreakReturnFullYul,
        Program.initialStaticContext, returnName,
        SolidCoreYulCore.FullYul.checkStmtFuel,
        SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?,
        SolidCoreYulCore.FullYul.stmtHasNoFunDefs,
        SolidCoreYulCore.FullYul.containsName,
        SolidCoreYulCore.FullYul.checkExpr,
        Expr.toFullYul_staticChecked]
  | forContinueReturn afterExpr =>
      simp [Body.fuel, Body.toFullYul, Body.forContinueReturnFullYul,
        Program.initialStaticContext, returnName,
        SolidCoreYulCore.FullYul.checkStmtFuel,
        SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?,
        SolidCoreYulCore.FullYul.stmtHasNoFunDefs,
        SolidCoreYulCore.FullYul.containsName,
        SolidCoreYulCore.FullYul.checkExpr,
        Expr.toFullYul_staticChecked]
  | internalCallReturn =>
      simp [Body.noFun] at hNoFun
  | ifReturn cond thenExpr elseExpr =>
      simp [Body.fuel, Body.toFullYul, Body.ifReturnFullYul,
        Program.initialStaticContext, returnName,
        SolidCoreYulCore.FullYul.checkStmtFuel,
        SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?,
        SolidCoreYulCore.FullYul.containsName,
        SolidCoreYulCore.FullYul.checkExpr,
        Expr.toFullYul_staticChecked]
  | ifThenBodyElseReturn cond thenBody elseExpr ih =>
      simp [Body.noFun] at hNoFun
      have hThen := ih hNoFun
      have hThen' :
          SolidCoreYulCore.FullYul.checkStmtFuel
              (thenBody.fuel + 1)
              Program.initialStaticContext false false
              thenBody.toFullYul =
            some Program.initialStaticContext := by
        simpa using hThen
      have hThen'' :
          SolidCoreYulCore.FullYul.checkStmtFuel
              (thenBody.fuel + 1)
              { vars := [0], funcs := [] } false false
              thenBody.toFullYul =
            some { vars := [0], funcs := [] } := by
        simpa [Program.initialStaticContext, returnName] using hThen'
      simp [Body.fuel, Body.toFullYul,
        Program.initialStaticContext, returnName,
        SolidCoreYulCore.FullYul.checkStmtFuel,
        SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?,
        SolidCoreYulCore.FullYul.containsName,
        SolidCoreYulCore.FullYul.checkExpr,
        Expr.toFullYul_staticChecked, hThen'']
  | ifThenReturnElseBody cond thenExpr elseBody ih =>
      simp [Body.noFun] at hNoFun
      have hPre :
          SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?
              Program.initialStaticContext elseBody.toFullYul =
            some Program.initialStaticContext :=
        Body.predeclare_toFullYul_of_noFun
          Program.initialStaticContext hNoFun
      have hPre' :
          SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?
              { vars := [0], funcs := [] } elseBody.toFullYul =
            some { vars := [0], funcs := [] } := by
        simpa [Program.initialStaticContext, returnName] using hPre
      have hElse := ih hNoFun
      have hElse' :
          SolidCoreYulCore.FullYul.checkStmtFuel
              (elseBody.fuel + 1)
              Program.initialStaticContext false false
              elseBody.toFullYul =
            some Program.initialStaticContext := by
        simpa using hElse
      have hFuel : ∃ fuel, elseBody.fuel = fuel + 1 := by
        cases hFuelEq : elseBody.fuel with
        | zero =>
            have hAtLeast := Body.fuel_atLeastTwo elseBody
            omega
        | succ fuel =>
            exact ⟨fuel, by omega⟩
      rcases hFuel with ⟨fuel, hFuel⟩
      rw [hFuel] at hElse'
      have hElse'' :
          SolidCoreYulCore.FullYul.checkStmtFuel
              (fuel + 2)
              { vars := [0], funcs := [] } false false
              elseBody.toFullYul =
            some { vars := [0], funcs := [] } := by
        simpa [Program.initialStaticContext, Nat.add_assoc, Nat.add_comm,
          Nat.add_left_comm, returnName] using hElse'
      simp [Body.fuel, Body.toFullYul,
        Program.initialStaticContext, returnName,
        SolidCoreYulCore.FullYul.checkStmtFuel,
        SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?,
        SolidCoreYulCore.FullYul.containsName,
        SolidCoreYulCore.FullYul.checkExpr,
        Expr.toFullYul_staticChecked,
        hPre', hElse'', hFuel]
theorem Program.toFullYul_correct (program : Program) :
    SolidCoreYulCore.SymYul.evalExpr SolidCoreYulCore.SymYul.Config.empty
        program.toFullYul =
      some (SolidCoreYulCore.FullYul.Value.word program.eval,
        SolidCoreYulCore.SymYul.Config.empty) := by
  cases program with
  | returnExpr expr => exact Expr.toFullYul_correct expr
  | functionBody body => rfl
  | internalCallArgReturn => rfl
  | internalCallMultiReturn => rfl
  | storageWriteRead => rfl
  | storageOverwriteRead => rfl
