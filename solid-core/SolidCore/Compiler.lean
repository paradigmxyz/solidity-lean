theorem StaticFullYulStmtArtifact.coreToFullYul_sound
    (artifact : StaticFullYulStmtArtifact) :
    artifact.coreToFullYul.source = artifact.sourceToCore.source ∧
    artifact.coreToFullYul.core = artifact.sourceToCore.core ∧
    artifact.coreToFullYul.stmt = artifact.stmt ∧
    compileToCore? artifact.coreToFullYul.source =
      some artifact.coreToFullYul.core ∧
    compileCoreToFullYulStmt artifact.coreToFullYul.core =
      artifact.coreToFullYul.stmt ∧
    compileToFullYulStmtViaCore artifact.coreToFullYul.source =
      some artifact.coreToFullYul.stmt := by
  exact ⟨artifact.coreToFullYul_source,
    artifact.coreToFullYul_core,
    artifact.coreToFullYul_stmt,
    artifact.coreToFullYul.core_compiled,
    artifact.coreToFullYul.emitted,
    artifact.coreToFullYul.compiled_via_core⟩

