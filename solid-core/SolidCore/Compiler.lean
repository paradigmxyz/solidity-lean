theorem parse_toFullYulStmt_correct
    {source : String} {program : Solidity.Program}
    (_hParse : parse source = some program) :
    SolidCoreYulCore.SymYul.evalStmtFuel program.stmtFuel
        Solidity.Body.initialSymYulConfig program.toFullYulStmt =
      [SolidCoreYulCore.SymYul.normalResult
        program.finalSymYulConfig] := by
  exact Solidity.Program.toFullYulStmt_correct program

theorem compileToFullYulStmt_sound
    {source : String} {stmt : SolidCoreYulCore.FullYul.Stmt}
    (hCompile : compileToFullYulStmt source = some stmt) :
    ∃ program,
      parse source = some program ∧
      stmt = program.toFullYulStmt ∧
      SolidCoreYulCore.SymYul.evalStmtFuel program.stmtFuel
          Solidity.Body.initialSymYulConfig stmt =
        [SolidCoreYulCore.SymYul.normalResult
          program.finalSymYulConfig] := by
  rcases compileToFullYulStmt_some_core hCompile with
    ⟨program, core, hParse, hCore, hStmt⟩
  refine ⟨program, hParse, ?_, ?_⟩
  · calc
      stmt = core.toFullYul := hStmt
      _ = program.toFullYulStmt :=
        (Solidity.Program.toFullYulStmt_eq_core_of_some hCore).symm
  · rw [hStmt]
    exact Solidity.Program.core_toFullYul_correct_of_some hCore

theorem parse_toFullYulStmt_correct_of_toCore?_isSome
    {source : String} {program : Solidity.Program}
    (_hParse : parse source = some program)
    (hCore : program.toCore?.isSome = true) :
    SolidCoreYulCore.SymYul.evalStmtFuel program.stmtFuel
        Solidity.Body.initialSymYulConfig program.toFullYulStmt =
      [SolidCoreYulCore.SymYul.normalResult
        program.finalSymYulConfig] := by
  exact Solidity.Program.toFullYulStmt_correct_of_toCore?_isSome
    program hCore

