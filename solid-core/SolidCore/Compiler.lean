      rcases parsed with ⟨lhsLiteral, rhsLiteral⟩
      cases hLhs :
          parseGeneratedReturnExpr? (returnLiteralSource lhsLiteral) with
      | none =>
          simp [hStrip, hLhs] at h
      | some lhsExpr =>
          cases hRhs :
              parseGeneratedReturnExpr? (returnLiteralSource rhsLiteral) with
          | none =>
              simp [hStrip, hLhs, hRhs] at h
          | some rhsExpr =>
              simp [hStrip, hLhs, hRhs] at h
              cases h
              exact ⟨lhsExpr, rhsExpr, rfl⟩

theorem parseGeneratedLocalPairAddReturn?_accepted_currentSolidCore
    {source : String} {program : Solidity.Program}
    (h : parseGeneratedLocalPairAddReturn? source = some program) :
    ∃ core,
