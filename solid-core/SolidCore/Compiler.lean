inductive TypedStmt where
  | skip : TypedStmt
  | expr : {ty : Ty} -> TypedExpr ty -> TypedStmt
  | returnExpr : {ty : Ty} -> TypedExpr ty -> TypedStmt
  | localValue : TypedExpr Ty.uint256 -> TypedStmt
  | localUpdateValue : TypedExpr Ty.uint256 -> TypedExpr Ty.uint256 ->
      TypedStmt
  | localPairAddValue : TypedExpr Ty.uint256 -> TypedExpr Ty.uint256 ->
      TypedStmt
  | localPairUpdateAddValue :
      TypedExpr Ty.uint256 -> TypedExpr Ty.uint256 ->
      TypedExpr Ty.uint256 -> TypedExpr Ty.uint256 -> TypedStmt
  | forNeverReturn : TypedExpr Ty.uint256 -> TypedExpr Ty.uint256 ->
      TypedStmt
  | forBreakReturn : TypedExpr Ty.uint256 -> TypedStmt
  | forContinueReturn : TypedExpr Ty.uint256 -> TypedStmt
  | ifReturn : TypedExpr Ty.bool -> TypedExpr Ty.uint256 ->
      TypedExpr Ty.uint256 -> TypedStmt
  | ifThenStmtElseReturn : TypedExpr Ty.bool -> TypedStmt ->
      TypedExpr Ty.uint256 -> TypedStmt
  | ifThenReturnElseStmt : TypedExpr Ty.bool -> TypedExpr Ty.uint256 ->
      TypedStmt -> TypedStmt
  | seq : TypedStmt -> TypedStmt -> TypedStmt
  | block : TypedStmt -> TypedStmt
  | ifThen : TypedExpr Ty.bool -> TypedStmt -> TypedStmt
  | ifElse : TypedExpr Ty.bool -> TypedStmt -> TypedStmt -> TypedStmt
  | forFalse : TypedStmt -> TypedStmt
  | forOnce : TypedStmt -> TypedStmt
  | forIf : TypedExpr Ty.bool -> TypedStmt -> TypedStmt

def TypedStmt.erase : TypedStmt -> Stmt
  | TypedStmt.skip => Stmt.skip
  | TypedStmt.expr e => Stmt.expr e.erase
  | TypedStmt.returnExpr e => Stmt.returnExpr e.erase
  | TypedStmt.localValue e => Stmt.localValue e.erase
  | TypedStmt.localUpdateValue init assigned =>
      Stmt.localUpdateValue init.erase assigned.erase
  | TypedStmt.localPairAddValue lhs rhs =>
      Stmt.localPairAddValue lhs.erase rhs.erase
  | TypedStmt.localPairUpdateAddValue initLhs initRhs assignedLhs assignedRhs =>
      Stmt.localPairUpdateAddValue initLhs.erase initRhs.erase
        assignedLhs.erase assignedRhs.erase
  | TypedStmt.forNeverReturn afterExpr loopExpr =>
      Stmt.forNeverReturn afterExpr.erase loopExpr.erase
  | TypedStmt.forBreakReturn afterExpr =>
      Stmt.forBreakReturn afterExpr.erase
  | TypedStmt.forContinueReturn afterExpr =>
      Stmt.forContinueReturn afterExpr.erase
  | TypedStmt.ifReturn cond thenExpr elseExpr =>
      Stmt.ifReturn cond.erase thenExpr.erase elseExpr.erase
  | TypedStmt.ifThenStmtElseReturn cond thenBody elseExpr =>
      Stmt.ifThenStmtElseReturn cond.erase thenBody.erase elseExpr.erase
  | TypedStmt.ifThenReturnElseStmt cond thenExpr elseBody =>
      Stmt.ifThenReturnElseStmt cond.erase thenExpr.erase elseBody.erase
  | TypedStmt.seq first second => Stmt.seq first.erase second.erase
  | TypedStmt.block body => Stmt.block body.erase
  | TypedStmt.ifThen cond body => Stmt.ifThen cond.erase body.erase
  | TypedStmt.ifElse cond thenBody elseBody =>
      Stmt.ifElse cond.erase thenBody.erase elseBody.erase
  | TypedStmt.forFalse body => Stmt.forFalse body.erase
  | TypedStmt.forOnce body => Stmt.forOnce body.erase
  | TypedStmt.forIf cond body => Stmt.forIf cond.erase body.erase

def TypedStmt.eval (state : State) (stmt : TypedStmt) : Result :=
  stmt.erase.eval state

theorem TypedStmt.toFullYul_correct_from
    (extraFuel : Nat) (state : State) (stmt : TypedStmt) :
    SolidCoreYulCore.SymYul.evalStmtFuel
        (stmt.erase.fuel + extraFuel + 1)
        state.toConfig stmt.erase.toFullYul =
      (stmt.eval state).toStructuredResult.toSymYulResults := by
  simpa [TypedStmt.eval] using
    Stmt.toFullYul_correct_from extraFuel state stmt.erase

theorem TypedStmt.toFullYul_correct (stmt : TypedStmt) :
    SolidCoreYulCore.SymYul.evalStmtFuel
        (stmt.erase.fuel + 1)
        (State.toConfig { returnValue := 0 })
        stmt.erase.toFullYul =
      (stmt.eval { returnValue := 0 }).toStructuredResult.toSymYulResults := by
  simpa using TypedStmt.toFullYul_correct_from 0 { returnValue := 0 } stmt

theorem TypedStmt.toFullYul_staticChecked (stmt : TypedStmt) :
    SolidCoreYulCore.FullYul.checkStmtFuel (stmt.erase.fuel + 2)
        Program.initialStaticContext false true stmt.erase.toFullYul =
      some Program.initialStaticContext := by
  exact Stmt.toFullYul_staticChecked stmt.erase

theorem TypedStmt.toFullYul_compilerEmittable (stmt : TypedStmt) :
    SolidCoreYulCore.FullYul.CompilerEmittableStmt
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      stmt.erase.toFullYul :=
  Stmt.toFullYul_compilerEmittable stmt.erase

theorem TypedStmt.toFullYul_accepted_currentSolidCore (stmt : TypedStmt) :
    SolidCoreYulCore.FullYul.CompilerAcceptedStmt
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      (stmt.erase.fuel + 2) Program.initialStaticContext false true
      stmt.erase.toFullYul Program.initialStaticContext := by
  exact
