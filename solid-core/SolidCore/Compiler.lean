  exact cert.artifact.static_checked_flat

theorem SolidityToFullYulStmtCertificate.accepted_currentSolidCore_flat
    (cert : SolidityToFullYulStmtCertificate) :
    SolidCoreYulCore.FullYul.CompilerAcceptedStmt
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      cert.artifact.fuel.succ Solidity.Program.initialStaticContext
      false cert.artifact.inFun cert.stmt
      Solidity.Program.initialStaticContext := by
  rw [← cert.emitted]
  exact cert.artifact.accepted_currentSolidCore_flat

theorem SolidityToFullYulStmtCertificate.pass_boundary_sound
    (cert : SolidityToFullYulStmtCertificate) :
    cert.artifact.stmt = cert.stmt ∧
    AnyStaticFullYulStmtArtifact.PassBoundarySound cert.artifact := by
  exact ⟨cert.emitted,
    AnyStaticFullYulStmtArtifact.passBoundarySound cert.artifact⟩

theorem SolidityToFullYulStmtCertificate.artifact_source
    (cert : SolidityToFullYulStmtCertificate) :
    cert.artifact.source = cert.source := by
  exact compileAnyStaticStmtArtifact_source cert.artifact_compiled

def SolidityToFullYulStmtCertificate.Verified
    (cert : SolidityToFullYulStmtCertificate) : Prop :=
  compileSolidityToFullYulStmt cert.source = some cert.stmt ∧
  SolidCoreYulCore.SymYul.evalStmtFuel cert.artifact.fuel
      cert.artifact.initialConfig cert.stmt =
    cert.artifact.expectedResults ∧
  SolidCoreYulCore.FullYul.checkStmtFuel cert.artifact.fuel.succ
      Solidity.Program.initialStaticContext false cert.artifact.inFun
      cert.stmt =
    some Solidity.Program.initialStaticContext ∧
  SolidCoreYulCore.FullYul.CompilerAcceptedStmt
    SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
    cert.artifact.fuel.succ Solidity.Program.initialStaticContext
    false cert.artifact.inFun cert.stmt
    Solidity.Program.initialStaticContext ∧
  compileAnyStaticStmtArtifact cert.source = some cert.artifact ∧
  cert.artifact.source = cert.source ∧
  cert.artifact.stmt = cert.stmt ∧
  AnyStaticFullYulStmtArtifact.PassBoundarySound cert.artifact

def SolidityToFullYulStmtCertificate.VerifiedForSource
    (source : String) (cert : SolidityToFullYulStmtCertificate) : Prop :=
  cert.source = source ∧
  cert.artifact.source = source ∧
  compileSolidityToFullYulStmt source = some cert.stmt ∧
  SolidityToFullYulStmtCertificate.Verified cert

theorem SolidityToFullYulStmtCertificate.verified
    (cert : SolidityToFullYulStmtCertificate) :
    SolidityToFullYulStmtCertificate.Verified cert := by
  exact ⟨cert.compiled, cert.eval_sound_flat, cert.static_checked_flat,
    cert.accepted_currentSolidCore_flat, cert.artifact_compiled,
    cert.artifact_source, cert.pass_boundary_sound.1,
    cert.pass_boundary_sound.2⟩

theorem SolidityToFullYulStmtCertificate.verifiedForSource
    (cert : SolidityToFullYulStmtCertificate) :
    SolidityToFullYulStmtCertificate.VerifiedForSource cert.source cert := by
  exact ⟨rfl, cert.artifact_source, cert.compiled, cert.verified⟩

