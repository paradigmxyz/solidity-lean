def TypedExpr.erase : {ty : Ty} -> TypedExpr ty -> PureExpr
  | Ty.uint256, TypedExpr.lit value => PureExpr.lit value
  | Ty.bool, TypedExpr.boolLit value =>
      PureExpr.lit (if value then 1 else 0)
  | Ty.uint256, TypedExpr.neg expr => PureExpr.neg expr.erase
  | Ty.uint256, TypedExpr.add lhs rhs =>
      PureExpr.add lhs.erase rhs.erase
  | Ty.uint256, TypedExpr.sub lhs rhs =>
      PureExpr.sub lhs.erase rhs.erase
  | Ty.uint256, TypedExpr.mul lhs rhs =>
      PureExpr.mul lhs.erase rhs.erase
  | Ty.uint256, TypedExpr.exp lhs rhs =>
      PureExpr.exp lhs.erase rhs.erase
  | Ty.uint256, TypedExpr.div lhs rhs =>
      PureExpr.div lhs.erase rhs.erase
  | Ty.uint256, TypedExpr.mod lhs rhs =>
      PureExpr.mod lhs.erase rhs.erase
  | Ty.uint256, TypedExpr.signedDiv lhs rhs =>
      PureExpr.signedDiv lhs.erase rhs.erase
  | Ty.uint256, TypedExpr.signedMod lhs rhs =>
      PureExpr.signedMod lhs.erase rhs.erase
  | Ty.bool, TypedExpr.eq lhs rhs =>
      PureExpr.eq lhs.erase rhs.erase
  | Ty.bool, TypedExpr.ne lhs rhs =>
      PureExpr.ne lhs.erase rhs.erase
  | Ty.bool, TypedExpr.lt lhs rhs =>
      PureExpr.lt lhs.erase rhs.erase
  | Ty.bool, TypedExpr.gt lhs rhs =>
      PureExpr.gt lhs.erase rhs.erase
  | Ty.bool, TypedExpr.le lhs rhs =>
      PureExpr.le lhs.erase rhs.erase
  | Ty.bool, TypedExpr.ge lhs rhs =>
      PureExpr.ge lhs.erase rhs.erase
  | Ty.bool, TypedExpr.signedLt lhs rhs =>
      PureExpr.signedLt lhs.erase rhs.erase
  | Ty.bool, TypedExpr.signedGt lhs rhs =>
      PureExpr.signedGt lhs.erase rhs.erase
  | Ty.bool, TypedExpr.signedLe lhs rhs =>
      PureExpr.signedLe lhs.erase rhs.erase
  | Ty.bool, TypedExpr.signedGe lhs rhs =>
      PureExpr.signedGe lhs.erase rhs.erase
  | Ty.bool, TypedExpr.boolNot expr =>
      PureExpr.iszero expr.erase
  | Ty.bool, TypedExpr.boolAnd lhs rhs =>
      PureExpr.boolAnd lhs.erase rhs.erase
  | Ty.bool, TypedExpr.boolOr lhs rhs =>
      PureExpr.boolOr lhs.erase rhs.erase
  | Ty.uint256, TypedExpr.bitAnd lhs rhs =>
      PureExpr.bitAnd lhs.erase rhs.erase
  | Ty.uint256, TypedExpr.bitOr lhs rhs =>
      PureExpr.bitOr lhs.erase rhs.erase
  | Ty.uint256, TypedExpr.bitXor lhs rhs =>
      PureExpr.bitXor lhs.erase rhs.erase
  | Ty.uint256, TypedExpr.bitNot expr =>
      PureExpr.bitNot expr.erase
  | Ty.uint256, TypedExpr.shl value shift =>
      PureExpr.shl value.erase shift.erase
  | Ty.uint256, TypedExpr.shr value shift =>
      PureExpr.shr value.erase shift.erase
  | Ty.uint256, TypedExpr.sar value shift =>
      PureExpr.sar value.erase shift.erase
  | Ty.uint256, TypedExpr.byteAt index value =>
      PureExpr.byteAt index.erase value.erase
  | Ty.uint256, TypedExpr.addmod lhs rhs modulus =>
      PureExpr.addmod lhs.erase rhs.erase modulus.erase
  | Ty.uint256, TypedExpr.mulmod lhs rhs modulus =>
      PureExpr.mulmod lhs.erase rhs.erase modulus.erase

def TypedExpr.eval : {ty : Ty} -> TypedExpr ty -> Word
  | Ty.uint256, TypedExpr.lit value => SolidCoreYulCore.norm value
  | Ty.bool, TypedExpr.boolLit value =>
      SolidCoreYulCore.norm (if value then 1 else 0)
  | Ty.uint256, TypedExpr.neg expr =>
      SolidCoreYulCore.subWord 0 expr.eval
  | Ty.uint256, TypedExpr.add lhs rhs =>
      SolidCoreYulCore.addWord lhs.eval rhs.eval
  | Ty.uint256, TypedExpr.sub lhs rhs =>
      SolidCoreYulCore.subWord lhs.eval rhs.eval
  | Ty.uint256, TypedExpr.mul lhs rhs =>
      SolidCoreYulCore.mulWord lhs.eval rhs.eval
  | Ty.uint256, TypedExpr.exp lhs rhs =>
      SolidCoreYulCore.expWord lhs.eval rhs.eval
  | Ty.uint256, TypedExpr.div lhs rhs =>
      SolidCoreYulCore.divWord lhs.eval rhs.eval
  | Ty.uint256, TypedExpr.mod lhs rhs =>
      SolidCoreYulCore.modWord lhs.eval rhs.eval
  | Ty.uint256, TypedExpr.signedDiv lhs rhs =>
      SolidCoreYulCore.sdivWord lhs.eval rhs.eval
  | Ty.uint256, TypedExpr.signedMod lhs rhs =>
      SolidCoreYulCore.smodWord lhs.eval rhs.eval
  | Ty.bool, TypedExpr.eq lhs rhs =>
      SolidCoreYulCore.eqWord lhs.eval rhs.eval
  | Ty.bool, TypedExpr.ne lhs rhs =>
      SolidCoreYulCore.iszeroWord (SolidCoreYulCore.eqWord lhs.eval rhs.eval)
  | Ty.bool, TypedExpr.lt lhs rhs =>
      SolidCoreYulCore.ltWord lhs.eval rhs.eval
  | Ty.bool, TypedExpr.gt lhs rhs =>
      SolidCoreYulCore.gtWord lhs.eval rhs.eval
  | Ty.bool, TypedExpr.le lhs rhs =>
      SolidCoreYulCore.iszeroWord (SolidCoreYulCore.gtWord lhs.eval rhs.eval)
  | Ty.bool, TypedExpr.ge lhs rhs =>
      SolidCoreYulCore.iszeroWord (SolidCoreYulCore.ltWord lhs.eval rhs.eval)
  | Ty.bool, TypedExpr.signedLt lhs rhs =>
      SolidCoreYulCore.sltWord lhs.eval rhs.eval
  | Ty.bool, TypedExpr.signedGt lhs rhs =>
      SolidCoreYulCore.sgtWord lhs.eval rhs.eval
  | Ty.bool, TypedExpr.signedLe lhs rhs =>
      SolidCoreYulCore.iszeroWord (SolidCoreYulCore.sgtWord lhs.eval rhs.eval)
  | Ty.bool, TypedExpr.signedGe lhs rhs =>
      SolidCoreYulCore.iszeroWord (SolidCoreYulCore.sltWord lhs.eval rhs.eval)
  | Ty.bool, TypedExpr.boolNot expr =>
      SolidCoreYulCore.iszeroWord expr.eval
  | Ty.bool, TypedExpr.boolAnd lhs rhs =>
      SolidCoreYulCore.iszeroWord
        (SolidCoreYulCore.orWord
          (SolidCoreYulCore.iszeroWord lhs.eval)
          (SolidCoreYulCore.iszeroWord rhs.eval))
  | Ty.bool, TypedExpr.boolOr lhs rhs =>
      SolidCoreYulCore.iszeroWord
        (SolidCoreYulCore.andWord
          (SolidCoreYulCore.iszeroWord lhs.eval)
          (SolidCoreYulCore.iszeroWord rhs.eval))
  | Ty.uint256, TypedExpr.bitAnd lhs rhs =>
      SolidCoreYulCore.andWord lhs.eval rhs.eval
  | Ty.uint256, TypedExpr.bitOr lhs rhs =>
      SolidCoreYulCore.orWord lhs.eval rhs.eval
  | Ty.uint256, TypedExpr.bitXor lhs rhs =>
      SolidCoreYulCore.xorWord lhs.eval rhs.eval
  | Ty.uint256, TypedExpr.bitNot expr =>
      SolidCoreYulCore.notWord expr.eval
  | Ty.uint256, TypedExpr.shl value shift =>
      SolidCoreYulCore.shlWord shift.eval value.eval
  | Ty.uint256, TypedExpr.shr value shift =>
      SolidCoreYulCore.shrWord shift.eval value.eval
  | Ty.uint256, TypedExpr.sar value shift =>
      SolidCoreYulCore.sarWord shift.eval value.eval
  | Ty.uint256, TypedExpr.byteAt index value =>
      SolidCoreYulCore.byteWord index.eval value.eval
  | Ty.uint256, TypedExpr.addmod lhs rhs modulus =>
      SolidCoreYulCore.addmodWord lhs.eval rhs.eval modulus.eval
  | Ty.uint256, TypedExpr.mulmod lhs rhs modulus =>
      SolidCoreYulCore.mulmodWord lhs.eval rhs.eval modulus.eval

theorem TypedExpr.erase_eval {ty : Ty} (expr : TypedExpr ty) :
    expr.erase.eval = expr.eval := by
  cases expr with
  | lit _ => rfl
  | boolLit value =>
      cases value <;> rfl
  | neg expr =>
      simp [TypedExpr.erase, TypedExpr.eval, PureExpr.eval,
        TypedExpr.erase_eval expr]
  | add lhs rhs =>
      simp [TypedExpr.erase, TypedExpr.eval, PureExpr.eval,
        TypedExpr.erase_eval lhs, TypedExpr.erase_eval rhs]
  | sub lhs rhs =>
      simp [TypedExpr.erase, TypedExpr.eval, PureExpr.eval,
        TypedExpr.erase_eval lhs, TypedExpr.erase_eval rhs]
  | mul lhs rhs =>
      simp [TypedExpr.erase, TypedExpr.eval, PureExpr.eval,
        TypedExpr.erase_eval lhs, TypedExpr.erase_eval rhs]
  | exp lhs rhs =>
      simp [TypedExpr.erase, TypedExpr.eval, PureExpr.eval,
        TypedExpr.erase_eval lhs, TypedExpr.erase_eval rhs]
  | div lhs rhs =>
      simp [TypedExpr.erase, TypedExpr.eval, PureExpr.eval,
        TypedExpr.erase_eval lhs, TypedExpr.erase_eval rhs]
  | mod lhs rhs =>
      simp [TypedExpr.erase, TypedExpr.eval, PureExpr.eval,
        TypedExpr.erase_eval lhs, TypedExpr.erase_eval rhs]
  | signedDiv lhs rhs =>
      simp [TypedExpr.erase, TypedExpr.eval, PureExpr.eval,
        TypedExpr.erase_eval lhs, TypedExpr.erase_eval rhs]
  | signedMod lhs rhs =>
      simp [TypedExpr.erase, TypedExpr.eval, PureExpr.eval,
        TypedExpr.erase_eval lhs, TypedExpr.erase_eval rhs]
  | eq lhs rhs =>
      simp [TypedExpr.erase, TypedExpr.eval, PureExpr.eval,
        TypedExpr.erase_eval lhs, TypedExpr.erase_eval rhs]
  | ne lhs rhs =>
      simp [TypedExpr.erase, TypedExpr.eval, PureExpr.eval,
        TypedExpr.erase_eval lhs, TypedExpr.erase_eval rhs]
  | lt lhs rhs =>
      simp [TypedExpr.erase, TypedExpr.eval, PureExpr.eval,
        TypedExpr.erase_eval lhs, TypedExpr.erase_eval rhs]
  | gt lhs rhs =>
      simp [TypedExpr.erase, TypedExpr.eval, PureExpr.eval,
        TypedExpr.erase_eval lhs, TypedExpr.erase_eval rhs]
  | le lhs rhs =>
      simp [TypedExpr.erase, TypedExpr.eval, PureExpr.eval,
        TypedExpr.erase_eval lhs, TypedExpr.erase_eval rhs]
  | ge lhs rhs =>
      simp [TypedExpr.erase, TypedExpr.eval, PureExpr.eval,
        TypedExpr.erase_eval lhs, TypedExpr.erase_eval rhs]
  | signedLt lhs rhs =>
      simp [TypedExpr.erase, TypedExpr.eval, PureExpr.eval,
        TypedExpr.erase_eval lhs, TypedExpr.erase_eval rhs]
  | signedGt lhs rhs =>
      simp [TypedExpr.erase, TypedExpr.eval, PureExpr.eval,
        TypedExpr.erase_eval lhs, TypedExpr.erase_eval rhs]
  | signedLe lhs rhs =>
      simp [TypedExpr.erase, TypedExpr.eval, PureExpr.eval,
        TypedExpr.erase_eval lhs, TypedExpr.erase_eval rhs]
  | signedGe lhs rhs =>
      simp [TypedExpr.erase, TypedExpr.eval, PureExpr.eval,
        TypedExpr.erase_eval lhs, TypedExpr.erase_eval rhs]
  | boolNot expr =>
      simp [TypedExpr.erase, TypedExpr.eval, PureExpr.eval,
        TypedExpr.erase_eval expr]
  | boolAnd lhs rhs =>
      simp [TypedExpr.erase, TypedExpr.eval, PureExpr.eval,
        TypedExpr.erase_eval lhs, TypedExpr.erase_eval rhs]
  | boolOr lhs rhs =>
      simp [TypedExpr.erase, TypedExpr.eval, PureExpr.eval,
        TypedExpr.erase_eval lhs, TypedExpr.erase_eval rhs]
  | bitAnd lhs rhs =>
      simp [TypedExpr.erase, TypedExpr.eval, PureExpr.eval,
        TypedExpr.erase_eval lhs, TypedExpr.erase_eval rhs]
  | bitOr lhs rhs =>
      simp [TypedExpr.erase, TypedExpr.eval, PureExpr.eval,
        TypedExpr.erase_eval lhs, TypedExpr.erase_eval rhs]
  | bitXor lhs rhs =>
      simp [TypedExpr.erase, TypedExpr.eval, PureExpr.eval,
        TypedExpr.erase_eval lhs, TypedExpr.erase_eval rhs]
  | bitNot expr =>
      simp [TypedExpr.erase, TypedExpr.eval, PureExpr.eval,
        TypedExpr.erase_eval expr]
  | shl value shift =>
      simp [TypedExpr.erase, TypedExpr.eval, PureExpr.eval,
        TypedExpr.erase_eval value, TypedExpr.erase_eval shift]
  | shr value shift =>
      simp [TypedExpr.erase, TypedExpr.eval, PureExpr.eval,
        TypedExpr.erase_eval value, TypedExpr.erase_eval shift]
  | sar value shift =>
      simp [TypedExpr.erase, TypedExpr.eval, PureExpr.eval,
        TypedExpr.erase_eval value, TypedExpr.erase_eval shift]
  | byteAt index value =>
      simp [TypedExpr.erase, TypedExpr.eval, PureExpr.eval,
        TypedExpr.erase_eval index, TypedExpr.erase_eval value]
  | addmod lhs rhs modulus =>
      simp [TypedExpr.erase, TypedExpr.eval, PureExpr.eval,
        TypedExpr.erase_eval lhs, TypedExpr.erase_eval rhs,
        TypedExpr.erase_eval modulus]
  | mulmod lhs rhs modulus =>
      simp [TypedExpr.erase, TypedExpr.eval, PureExpr.eval,
        TypedExpr.erase_eval lhs, TypedExpr.erase_eval rhs,
        TypedExpr.erase_eval modulus]

def TypedExpr.toExpr {ty : Ty} (expr : TypedExpr ty) : Expr :=
  expr.erase.toExpr

theorem TypedExpr.toExpr_eval {ty : Ty} (expr : TypedExpr ty) :
    expr.toExpr.eval = expr.eval := by
  simpa [TypedExpr.toExpr, TypedExpr.erase_eval] using
    PureExpr.toExpr_eval expr.erase

def TypedExpr.toFullYul {ty : Ty} (expr : TypedExpr ty) :
    SolidCoreYulCore.FullYul.Expr :=
  expr.toExpr.toFullYul

theorem TypedExpr.toFullYul_correct_env {ty : Ty}
    (config : SolidCoreYulCore.SymYul.Config) (expr : TypedExpr ty) :
    SolidCoreYulCore.SymYul.evalExpr config expr.toFullYul =
      some (SolidCoreYulCore.FullYul.Value.word expr.eval, config) := by
  simpa [TypedExpr.toFullYul, TypedExpr.toExpr_eval] using
    Expr.toFullYul_correct_env config expr.toExpr

theorem TypedExpr.toFullYul_staticChecked {ty : Ty}
    (ctx : SolidCoreYulCore.FullYul.StaticContext)
    (expr : TypedExpr ty) :
    SolidCoreYulCore.FullYul.checkExpr ctx expr.toFullYul = true := by
  simpa [TypedExpr.toFullYul] using
    Expr.toFullYul_staticChecked ctx expr.toExpr

theorem TypedExpr.toFullYul_compilerEmittable {ty : Ty}
    (expr : TypedExpr ty) :
    SolidCoreYulCore.FullYul.CompilerEmittableExpr
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      expr.toFullYul := by
  simpa [TypedExpr.toFullYul] using
    Expr.toFullYul_compilerEmittable expr.toExpr

structure State where
  returnValue : Word
  deriving DecidableEq, Repr

inductive Result where
  | normal : State -> Result
  | returned : State -> Result
  deriving DecidableEq, Repr

inductive Stmt where
  | skip : Stmt
  | expr : PureExpr -> Stmt
  | returnExpr : PureExpr -> Stmt
  | localValue : PureExpr -> Stmt
  | localUpdateValue : PureExpr -> PureExpr -> Stmt
  | localPairAddValue : PureExpr -> PureExpr -> Stmt
  | localPairUpdateAddValue :
      PureExpr -> PureExpr -> PureExpr -> PureExpr -> Stmt
  | forNeverReturn : PureExpr -> PureExpr -> Stmt
  | forBreakReturn : PureExpr -> Stmt
  | forContinueReturn : PureExpr -> Stmt
  | ifReturn : PureExpr -> PureExpr -> PureExpr -> Stmt
  | ifThenStmtElseReturn : PureExpr -> Stmt -> PureExpr -> Stmt
  | ifThenReturnElseStmt : PureExpr -> PureExpr -> Stmt -> Stmt
  | seq : Stmt -> Stmt -> Stmt
  | block : Stmt -> Stmt
  | ifThen : PureExpr -> Stmt -> Stmt
  | ifElse : PureExpr -> Stmt -> Stmt -> Stmt
  | forFalse : Stmt -> Stmt
  | forOnce : Stmt -> Stmt
  | forIf : PureExpr -> Stmt -> Stmt
  deriving DecidableEq, Repr

def State.toStructured (state : State) : Structured.State :=
  { returnValue := state.returnValue }

def State.toConfig (state : State) : SolidCoreYulCore.SymYul.Config :=
  state.toStructured.toConfig

def Result.toStructuredResult : Result -> Structured.Result
  | Result.normal state => Structured.Result.normal state.toStructured
  | Result.returned state => Structured.Result.returned state.toStructured

inductive LocalFrame1 where
  | returnInit : PureExpr -> LocalFrame1
  | updateValue : PureExpr -> PureExpr -> LocalFrame1
  deriving DecidableEq, Repr

def LocalFrame1.eval (state : State) : LocalFrame1 -> Result
  | LocalFrame1.returnInit init =>
      Result.returned { state with returnValue := init.eval }
  | LocalFrame1.updateValue _ assigned =>
      Result.returned { state with returnValue := assigned.eval }

def LocalFrame1.fuel : LocalFrame1 -> Nat
  | LocalFrame1.returnInit _ => 6
  | LocalFrame1.updateValue _ _ => 7

def LocalFrame1.toFullYul : LocalFrame1 -> SolidCoreYulCore.FullYul.Stmt
  | LocalFrame1.returnInit init =>
      SolidCoreYulCore.FullYul.Stmt.block
        [SolidCoreYulCore.FullYul.Stmt.seq
          (SolidCoreYulCore.FullYul.Stmt.let1 localName
            (some init.toExpr.toFullYul))
          (SolidCoreYulCore.FullYul.Stmt.seq
            (SolidCoreYulCore.FullYul.Stmt.assign returnName
              (SolidCoreYulCore.FullYul.Expr.var localName))
            SolidCoreYulCore.FullYul.Stmt.leave)]
  | LocalFrame1.updateValue init assigned =>
      SolidCoreYulCore.FullYul.Stmt.block
        [SolidCoreYulCore.FullYul.Stmt.seq
          (SolidCoreYulCore.FullYul.Stmt.let1 localName
            (some init.toExpr.toFullYul))
          (SolidCoreYulCore.FullYul.Stmt.seq
            (SolidCoreYulCore.FullYul.Stmt.assign localName
              assigned.toExpr.toFullYul)
            (SolidCoreYulCore.FullYul.Stmt.seq
              (SolidCoreYulCore.FullYul.Stmt.assign returnName
                (SolidCoreYulCore.FullYul.Expr.var localName))
              SolidCoreYulCore.FullYul.Stmt.leave))]

theorem LocalFrame1.toFullYul_correct_from
    (extraFuel : Nat) (state : State) (frame : LocalFrame1) :
    SolidCoreYulCore.SymYul.evalStmtFuel
        (frame.fuel + extraFuel + 1)
        state.toConfig frame.toFullYul =
      (frame.eval state).toStructuredResult.toSymYulResults := by
  cases frame <;> cases extraFuel <;>
    simp [LocalFrame1.fuel, LocalFrame1.toFullYul, LocalFrame1.eval,
      State.toConfig, State.toStructured, Result.toStructuredResult,
      Structured.Result.toSymYulResults, Structured.State.toConfig,
      Body.returnConfig, Body.returnEnv, returnName, localName,
      SolidCoreYulCore.SymYul.evalStmtFuel,
      SolidCoreYulCore.SymYul.evalBlockFuel,
      SolidCoreYulCore.SymYul.collectBlockFunctionDefs,
      SolidCoreYulCore.SymYul.collectStmtFunctionDefs,
      SolidCoreYulCore.SymYul.evalExpr,
      SolidCoreYulCore.SymYul.evalExprs,
      SolidCoreYulCore.SymYul.evalExprsAsYulValues,
      SolidCoreYulCore.SymYul.bindNormal,
      SolidCoreYulCore.SymYul.withRestoredConfig,
      SolidCoreYulCore.SymYul.restoreBlockConfig,
      SolidCoreYulCore.SymYul.normalResult,
      SolidCoreYulCore.SymYul.resultAfterExpr,
      SolidCoreYulCore.FullYul.declare?,
      SolidCoreYulCore.FullYul.assign?,
      SolidCoreYulCore.FullYul.lookup?,
      SolidCoreYulCore.FullYul.restoreOuter,
      PureExpr.toExpr_eval, Expr.toFullYul_correct_env,
      Nat.add_assoc, Nat.add_comm, Nat.add_left_comm]

theorem LocalFrame1.toFullYul_staticChecked (frame : LocalFrame1) :
    SolidCoreYulCore.FullYul.checkStmtFuel (frame.fuel + 2)
        Program.initialStaticContext false true frame.toFullYul =
      some Program.initialStaticContext := by
  cases frame <;>
    simp [LocalFrame1.fuel, LocalFrame1.toFullYul,
      Program.initialStaticContext, returnName, localName,
      SolidCoreYulCore.FullYul.checkStmtFuel,
      SolidCoreYulCore.FullYul.checkBlockFuel,
      SolidCoreYulCore.FullYul.predeclareBlockFunctionSigs?,
      SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?,
      SolidCoreYulCore.FullYul.addVarName?,
      SolidCoreYulCore.FullYul.addScopedName?,
      SolidCoreYulCore.FullYul.containsName,
      SolidCoreYulCore.FullYul.containsFunctionName,
      SolidCoreYulCore.FullYul.checkExpr,
      Expr.toFullYul_staticChecked]

theorem LocalFrame1.toFullYul_compilerEmittable (frame : LocalFrame1) :
    SolidCoreYulCore.FullYul.CompilerEmittableStmt
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      frame.toFullYul := by
  cases frame with
  | returnInit init =>
      have hInit := PureExpr.toFullYul_compilerEmittable init
      have hLet :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.let1Some
          (name := localName) hInit
      have hAssign :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.assign
          (name := returnName)
          (currentSolidCore_var_compilerEmittable localName)
      simpa [LocalFrame1.toFullYul] using
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.block
          (SolidCoreYulCore.FullYul.CompilerEmittableBlock.cons
            (SolidCoreYulCore.FullYul.CompilerEmittableStmt.seq hLet
              (SolidCoreYulCore.FullYul.CompilerEmittableStmt.seq hAssign
                SolidCoreYulCore.FullYul.CompilerEmittableStmt.leave))
            SolidCoreYulCore.FullYul.CompilerEmittableBlock.nil)
  | updateValue init assigned =>
      have hInit := PureExpr.toFullYul_compilerEmittable init
      have hAssigned := PureExpr.toFullYul_compilerEmittable assigned
      have hLet :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.let1Some
          (name := localName) hInit
      have hAssignLocal :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.assign
          (name := localName) hAssigned
      have hUpdateValue :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.assign
          (name := returnName)
          (currentSolidCore_var_compilerEmittable localName)
      simpa [LocalFrame1.toFullYul] using
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.block
          (SolidCoreYulCore.FullYul.CompilerEmittableBlock.cons
            (SolidCoreYulCore.FullYul.CompilerEmittableStmt.seq hLet
              (SolidCoreYulCore.FullYul.CompilerEmittableStmt.seq
                hAssignLocal
                (SolidCoreYulCore.FullYul.CompilerEmittableStmt.seq
                  hUpdateValue
                  SolidCoreYulCore.FullYul.CompilerEmittableStmt.leave)))
            SolidCoreYulCore.FullYul.CompilerEmittableBlock.nil)

inductive LocalFrame2 where
  | addReturn : PureExpr -> PureExpr -> LocalFrame2
  | assignAddReturn :
      PureExpr -> PureExpr -> PureExpr -> PureExpr -> LocalFrame2
  deriving DecidableEq, Repr

def LocalFrame2.eval (state : State) : LocalFrame2 -> Result
  | LocalFrame2.addReturn lhs rhs =>
      Result.returned
        { state with returnValue := SolidCoreYulCore.addWord lhs.eval rhs.eval }
  | LocalFrame2.assignAddReturn _ _ assignedLhs assignedRhs =>
      Result.returned
        { state with
          returnValue := SolidCoreYulCore.addWord assignedLhs.eval assignedRhs.eval }

def LocalFrame2.fuel : LocalFrame2 -> Nat
  | LocalFrame2.addReturn _ _ => 6
  | LocalFrame2.assignAddReturn _ _ _ _ => 7

def LocalFrame2.toFullYul : LocalFrame2 -> SolidCoreYulCore.FullYul.Stmt
  | LocalFrame2.addReturn lhs rhs =>
      SolidCoreYulCore.FullYul.Stmt.block
        [SolidCoreYulCore.FullYul.Stmt.seq
          (SolidCoreYulCore.FullYul.Stmt.letMany [localName, secondLocalName]
            (some [lhs.toExpr.toFullYul, rhs.toExpr.toFullYul]))
          (SolidCoreYulCore.FullYul.Stmt.seq
            (SolidCoreYulCore.FullYul.Stmt.assign returnName
              (SolidCoreYulCore.FullYul.Expr.builtin
                SolidCoreYulCore.Evm.Builtin.add
                [ SolidCoreYulCore.FullYul.Expr.var localName
                , SolidCoreYulCore.FullYul.Expr.var secondLocalName ]))
            SolidCoreYulCore.FullYul.Stmt.leave)]
  | LocalFrame2.assignAddReturn initLhs initRhs assignedLhs assignedRhs =>
      SolidCoreYulCore.FullYul.Stmt.block
        [SolidCoreYulCore.FullYul.Stmt.seq
          (SolidCoreYulCore.FullYul.Stmt.letMany [localName, secondLocalName]
            (some [initLhs.toExpr.toFullYul, initRhs.toExpr.toFullYul]))
          (SolidCoreYulCore.FullYul.Stmt.seq
            (SolidCoreYulCore.FullYul.Stmt.assignMany
              [localName, secondLocalName]
              [assignedLhs.toExpr.toFullYul, assignedRhs.toExpr.toFullYul])
            (SolidCoreYulCore.FullYul.Stmt.seq
              (SolidCoreYulCore.FullYul.Stmt.assign returnName
                (SolidCoreYulCore.FullYul.Expr.builtin
                  SolidCoreYulCore.Evm.Builtin.add
                  [ SolidCoreYulCore.FullYul.Expr.var localName
                  , SolidCoreYulCore.FullYul.Expr.var secondLocalName ]))
              SolidCoreYulCore.FullYul.Stmt.leave))]

theorem LocalFrame2.toFullYul_correct_from
    (extraFuel : Nat) (state : State) (frame : LocalFrame2) :
    SolidCoreYulCore.SymYul.evalStmtFuel
        (frame.fuel + extraFuel + 1)
        state.toConfig frame.toFullYul =
      (frame.eval state).toStructuredResult.toSymYulResults := by
  cases frame <;> cases extraFuel <;>
    simp [LocalFrame2.fuel, LocalFrame2.toFullYul, LocalFrame2.eval,
      State.toConfig, State.toStructured, Result.toStructuredResult,
      Structured.Result.toSymYulResults, Structured.State.toConfig,
      Body.returnConfig, Body.returnEnv, returnName, localName,
      secondLocalName,
      SolidCoreYulCore.SymYul.evalStmtFuel,
      SolidCoreYulCore.SymYul.evalBlockFuel,
      SolidCoreYulCore.SymYul.collectBlockFunctionDefs,
      SolidCoreYulCore.SymYul.collectStmtFunctionDefs,
