theorem Stmt.toFullYul_compilerEmittable (stmt : Stmt) :
    SolidCoreYulCore.FullYul.CompilerEmittableStmt
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      stmt.toFullYul := by
  by_cases hRoute : stmt.usesStructuredRoute = true
  · exact Stmt.toFullYul_compilerEmittable_structuredRoute stmt hRoute
  · match stmt with
    | Stmt.localValue init =>
      simpa [Stmt.toFullYul, Stmt.localValueFullYul] using
        LocalFrame1.toFullYul_compilerEmittable
          (LocalFrame1.returnInit init)
    | Stmt.localUpdateValue init assigned =>
      simpa [Stmt.toFullYul, Stmt.localUpdateValueFullYul] using
        LocalFrame1.toFullYul_compilerEmittable
          (LocalFrame1.updateValue init assigned)
    | Stmt.localPairAddValue lhs rhs =>
      simpa [Stmt.toFullYul, Stmt.localPairAddValueFullYul] using
        LocalFrame2.toFullYul_compilerEmittable
          (LocalFrame2.addReturn lhs rhs)
    | Stmt.localPairUpdateAddValue initLhs initRhs assignedLhs assignedRhs =>
      simpa [Stmt.toFullYul, Stmt.localPairUpdateAddValueFullYul] using
        LocalFrame2.toFullYul_compilerEmittable
          (LocalFrame2.assignAddReturn initLhs initRhs
            assignedLhs assignedRhs)
    | Stmt.forNeverReturn afterExpr loopExpr =>
      have hAfter := PureExpr.toFullYul_compilerEmittable afterExpr
      have hLoop := PureExpr.toFullYul_compilerEmittable loopExpr
      have hAssignAfter :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.assign
          (name := returnName) hAfter
      have hAssignLoop :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.assign
          (name := returnName) hLoop
      have hFor :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.forLoop
          SolidCoreYulCore.FullYul.CompilerEmittableStmt.skip
          (currentSolidCore_value_word_compilerEmittable 0)
          SolidCoreYulCore.FullYul.CompilerEmittableStmt.skip
          hAssignLoop
      simpa [Stmt.toFullYul, Stmt.forNeverReturnFullYul] using
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.seq hAssignAfter
          (SolidCoreYulCore.FullYul.CompilerEmittableStmt.seq hFor
            SolidCoreYulCore.FullYul.CompilerEmittableStmt.leave)
    | Stmt.forBreakReturn afterExpr =>
      have hAfter := PureExpr.toFullYul_compilerEmittable afterExpr
      have hFor :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.forLoop
          SolidCoreYulCore.FullYul.CompilerEmittableStmt.skip
          (currentSolidCore_value_word_compilerEmittable 1)
          SolidCoreYulCore.FullYul.CompilerEmittableStmt.skip
          SolidCoreYulCore.FullYul.CompilerEmittableStmt.break
      have hAssignAfter :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.assign
          (name := returnName) hAfter
      simpa [Stmt.toFullYul, Stmt.forBreakReturnFullYul] using
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.seq hFor
          (SolidCoreYulCore.FullYul.CompilerEmittableStmt.seq hAssignAfter
            SolidCoreYulCore.FullYul.CompilerEmittableStmt.leave)
    | Stmt.forContinueReturn afterExpr =>
      have hAfter := PureExpr.toFullYul_compilerEmittable afterExpr
      have hAssignOne :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.assign
          (name := returnName)
          (currentSolidCore_value_word_compilerEmittable 1)
      have hAssignZero :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.assign
          (name := returnName)
          (currentSolidCore_value_word_compilerEmittable 0)
      have hFor :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.forLoop
          SolidCoreYulCore.FullYul.CompilerEmittableStmt.skip
          (currentSolidCore_var_compilerEmittable returnName)
          hAssignZero
          SolidCoreYulCore.FullYul.CompilerEmittableStmt.continue
      have hAssignAfter :=
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.assign
          (name := returnName) hAfter
      simpa [Stmt.toFullYul, Stmt.forContinueReturnFullYul] using
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.seq hAssignOne
          (SolidCoreYulCore.FullYul.CompilerEmittableStmt.seq hFor
            (SolidCoreYulCore.FullYul.CompilerEmittableStmt.seq hAssignAfter
              SolidCoreYulCore.FullYul.CompilerEmittableStmt.leave))
    | Stmt.ifReturn _ _ _ =>
        simp [Stmt.usesStructuredRoute] at hRoute
    | Stmt.ifThenStmtElseReturn _ _ _ =>
        simp [Stmt.usesStructuredRoute] at hRoute
    | Stmt.ifThenReturnElseStmt _ _ _ =>
        simp [Stmt.usesStructuredRoute] at hRoute
    | Stmt.skip =>
        simp [Stmt.usesStructuredRoute] at hRoute
    | Stmt.expr _ =>
        simp [Stmt.usesStructuredRoute] at hRoute
    | Stmt.returnExpr _ =>
        simp [Stmt.usesStructuredRoute] at hRoute
    | Stmt.seq _ _ =>
        simp [Stmt.usesStructuredRoute] at hRoute
    | Stmt.block _ =>
        simp [Stmt.usesStructuredRoute] at hRoute
    | Stmt.ifThen _ _ =>
        simp [Stmt.usesStructuredRoute] at hRoute
    | Stmt.ifElse _ _ _ =>
        simp [Stmt.usesStructuredRoute] at hRoute
    | Stmt.forFalse _ =>
        simp [Stmt.usesStructuredRoute] at hRoute
    | Stmt.forOnce _ =>
        simp [Stmt.usesStructuredRoute] at hRoute
    | Stmt.forIf _ _ =>
        simp [Stmt.usesStructuredRoute] at hRoute

