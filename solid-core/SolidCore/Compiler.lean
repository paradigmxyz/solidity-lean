    artifact.source = source := by
  unfold compileAnyStaticStmtArtifact at hCompile
  cases hChecked : compileCheckedStaticStmtArtifact source with
  | some checkedArtifact =>
      simp [hChecked] at hCompile
      cases hCompile
      exact compileCheckedStaticStmtArtifact_source hChecked
  | none =>
      cases hUnchecked : compileStaticStmtArtifact source with
      | some uncheckedArtifact =>
          simp [hChecked, hUnchecked] at hCompile
          cases hCompile
          exact compileStaticStmtArtifact_source hUnchecked
      | none =>
          simp [hChecked, hUnchecked] at hCompile

