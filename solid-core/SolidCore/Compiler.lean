def ArithOp.assignThenLeaveFuel (op : ArithOp) : Nat := op.assignFuel + 1

theorem ArithOp.addAssignToFullYul_correct_from_fuel6
    (state : Core.State)
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) :
    SolidCoreYulCore.SymYul.evalStmtFuel
        ArithOp.sub.assignThenLeaveFuel
        state.toConfig
        (ArithOp.add.assignToFullYul lhs rhs) =
      (ArithOp.add.evalAssignFrom state lhs rhs).toSymYulResults := by
  simpa [ArithOp.assignThenLeaveFuel, ArithOp.assignFuel,
    ArithOp.assignToFullYul, ArithOp.evalAssignFrom] using
    checkedAddAssignFullYul_correct_from_fuel6 state lhs rhs

theorem ArithOp.assignThenLeaveToFullYul_correct (op : ArithOp)
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) :
    SolidCoreYulCore.SymYul.evalStmtFuel op.assignThenLeaveFuel
        (Core.State.toConfig { returnValue := 0 })
        (op.assignThenLeaveToFullYul lhs rhs) =
      (op.evalAssignThenLeave lhs rhs).toSymYulResults := by
  have hAssign := ArithOp.assignToFullYul_correct op lhs rhs
  simp [ArithOp.assignThenLeaveFuel, ArithOp.assignFuel,
    ArithOp.assignThenLeaveToFullYul, ArithOp.evalAssignThenLeave,
    SolidCoreYulCore.SymYul.evalStmtFuel,
    SolidCoreYulCore.SymYul.collectStmtFunctionDefs,
    ArithOp.collectStmtFunctionDefs_assignToFullYul,
    SolidCoreYulCore.SymYul.bindNormal] at hAssign ⊢
  simpa [StepResult.bindLeave_toSymYulResults] using
    congrArg
      (fun results =>
        SolidCoreYulCore.SymYul.bindNormal results
          (fun config =>
            SolidCoreYulCore.SymYul.evalStmtFuel 5 config
              SolidCoreYulCore.FullYul.Stmt.leave))
      hAssign

theorem ArithOp.assignThenLeaveToFullYul_correct_from (op : ArithOp)
    (state : Core.State)
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) :
    SolidCoreYulCore.SymYul.evalStmtFuel op.assignThenLeaveFuel
        state.toConfig
        (op.assignThenLeaveToFullYul lhs rhs) =
      (op.evalAssignThenLeaveFrom state lhs rhs).toSymYulResults := by
  have hAssign := ArithOp.assignToFullYul_correct_from op state lhs rhs
  simp [ArithOp.assignThenLeaveFuel, ArithOp.assignFuel,
    ArithOp.assignThenLeaveToFullYul, ArithOp.evalAssignThenLeaveFrom,
    SolidCoreYulCore.SymYul.evalStmtFuel,
    SolidCoreYulCore.SymYul.collectStmtFunctionDefs,
    ArithOp.collectStmtFunctionDefs_assignToFullYul,
    SolidCoreYulCore.SymYul.bindNormal] at hAssign ⊢
  simpa [StepResult.bindLeave_toSymYulResults] using
    congrArg
      (fun results =>
        SolidCoreYulCore.SymYul.bindNormal results
          (fun config =>
            SolidCoreYulCore.SymYul.evalStmtFuel 5 config
              SolidCoreYulCore.FullYul.Stmt.leave))
      hAssign

theorem ArithOp.assignSeqThenLeaveToFullYul_correct_from_of_first
    (firstOp : ArithOp) (state : Core.State)
    (firstLhs firstRhs : Core.TypedExpr Core.Ty.uint256)
    (secondOp : ArithOp)
    (secondLhs secondRhs : Core.TypedExpr Core.Ty.uint256)
    (hFirst :
      SolidCoreYulCore.SymYul.evalStmtFuel secondOp.assignThenLeaveFuel
          state.toConfig
          (firstOp.assignToFullYul firstLhs firstRhs) =
        (firstOp.evalAssignFrom state firstLhs firstRhs).toSymYulResults) :
    SolidCoreYulCore.SymYul.evalStmtFuel (secondOp.assignThenLeaveFuel + 1)
        state.toConfig
        (ArithOp.assignSeqThenLeaveToFullYul
          firstOp firstLhs firstRhs secondOp secondLhs secondRhs) =
      (ArithOp.evalAssignSeqThenLeaveFrom firstOp state firstLhs firstRhs
        secondOp secondLhs secondRhs).toSymYulResults := by
  have hSecond :
      ∀ state',
        SolidCoreYulCore.SymYul.evalStmtFuel secondOp.assignThenLeaveFuel
            state'.toConfig
            (secondOp.assignThenLeaveToFullYul secondLhs secondRhs) =
          (secondOp.evalAssignThenLeaveFrom state'
            secondLhs secondRhs).toSymYulResults := by
    intro state'
    exact ArithOp.assignThenLeaveToFullYul_correct_from
      secondOp state' secondLhs secondRhs
  simp [ArithOp.assignSeqThenLeaveToFullYul,
    SolidCoreYulCore.SymYul.evalStmtFuel,
    SolidCoreYulCore.SymYul.collectStmtFunctionDefs,
    ArithOp.collectStmtFunctionDefs_assignToFullYul,
    ArithOp.collectStmtFunctionDefs_assignThenLeaveToFullYul,
    SolidCoreYulCore.SymYul.bindNormal]
  rw [hFirst]
  have hBind :=
    StepResult.bindNormal_toReturnSymYulResults
      (firstOp.evalAssignFrom state firstLhs firstRhs)
      (fun config =>
        SolidCoreYulCore.SymYul.evalStmtFuel secondOp.assignThenLeaveFuel
          config (secondOp.assignThenLeaveToFullYul secondLhs secondRhs))
      (fun state' =>
        secondOp.evalAssignThenLeaveFrom state' secondLhs secondRhs)
      hSecond
  simpa [ArithOp.evalAssignSeqThenLeaveFrom, ArithOp.evalAssignSeqFrom,
    StepResult.bind_toReturnResult] using hBind

theorem ArithOp.addAssignSeqThenLeaveToFullYul_correct_from
    (state : Core.State)
    (firstLhs firstRhs : Core.TypedExpr Core.Ty.uint256)
    (secondOp : ArithOp)
    (secondLhs secondRhs : Core.TypedExpr Core.Ty.uint256) :
    SolidCoreYulCore.SymYul.evalStmtFuel (secondOp.assignThenLeaveFuel + 1)
        state.toConfig
