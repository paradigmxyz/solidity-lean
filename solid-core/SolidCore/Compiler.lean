  | storageIfFalseWriteRead => rfl
  | internalStorageCall => rfl
  | internalStorageArgCall => rfl
  | internalStorageArgReturnCall => rfl
  | internalStoragePairArgReturnCall => rfl
  | internalStorageReadUpdateCall => rfl
  | internalStorageConditionalCall => rfl
  | internalStorageConditionalFalseCall => rfl
  | nestedInternalStorageCall => rfl

