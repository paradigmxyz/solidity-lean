    (SolidCoreYulCore.FullYul.CompilerEmittableExprs.cons hLhs
      (SolidCoreYulCore.FullYul.CompilerEmittableExprs.cons hRhs
        SolidCoreYulCore.FullYul.CompilerEmittableExprs.nil))

