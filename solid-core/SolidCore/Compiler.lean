theorem TypedStmt.toFullYul_staticChecked (stmt : TypedStmt) :
    SolidCoreYulCore.FullYul.checkStmtFuel stmt.fuel.succ
        Program.initialStaticContext false true stmt.toFullYul =
      some Program.initialStaticContext := by
  cases stmt with
  | checkedArithReturn op lhs rhs =>
      cases op <;>
        simp [TypedStmt.fuel, TypedStmt.toFullYul, ArithOp.fuel,
          ArithOp.toFullYul, checkedAddReturnFullYul,
          checkedSubReturnFullYul, checkedMulReturnFullYul,
          checkedDivReturnFullYul, checkedModReturnFullYul, revertZero,
          Program.initialStaticContext, returnName,
          SolidCoreYulCore.FullYul.checkStmtFuel,
          SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?,
          SolidCoreYulCore.FullYul.checkStmtExpr,
          SolidCoreYulCore.FullYul.checkExpr,
          SolidCoreYulCore.FullYul.checkExprs,
          SolidCoreYulCore.FullYul.containsName,
          SolidCoreYulCore.Evm.Builtin.signature?,
          Core.TypedExpr.toFullYul_staticChecked]
  | checkedArithAssignThenLeave op lhs rhs =>
      cases op <;>
        simp [TypedStmt.fuel, TypedStmt.toFullYul,
          ArithOp.assignThenLeaveFuel, ArithOp.assignFuel,
          ArithOp.assignThenLeaveToFullYul, ArithOp.assignToFullYul,
          checkedAddAssignFullYul, checkedSubAssignFullYul,
          checkedMulAssignFullYul, checkedDivAssignFullYul,
          checkedModAssignFullYul, revertZero, Program.initialStaticContext,
          returnName, SolidCoreYulCore.FullYul.checkStmtFuel,
          SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?,
          SolidCoreYulCore.FullYul.checkStmtExpr,
          SolidCoreYulCore.FullYul.checkExpr,
          SolidCoreYulCore.FullYul.checkExprs,
          SolidCoreYulCore.FullYul.containsName,
          SolidCoreYulCore.Evm.Builtin.signature?,
          Core.TypedExpr.toFullYul_staticChecked]
  | checkedArithAssignSeqThenLeave firstOp firstLhs firstRhs secondOp
      secondLhs secondRhs =>
      cases firstOp <;> cases secondOp <;>
        simp [TypedStmt.fuel, TypedStmt.toFullYul,
          ArithOp.assignThenLeaveFuel, ArithOp.assignFuel,
          ArithOp.assignSeqThenLeaveToFullYul,
          ArithOp.assignThenLeaveToFullYul, ArithOp.assignToFullYul,
          checkedAddAssignFullYul, checkedSubAssignFullYul,
          checkedMulAssignFullYul, checkedDivAssignFullYul,
          checkedModAssignFullYul, revertZero, Program.initialStaticContext,
          returnName, SolidCoreYulCore.FullYul.checkStmtFuel,
          SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?,
          SolidCoreYulCore.FullYul.checkStmtExpr,
          SolidCoreYulCore.FullYul.checkExpr,
          SolidCoreYulCore.FullYul.checkExprs,
          SolidCoreYulCore.FullYul.containsName,
          SolidCoreYulCore.Evm.Builtin.signature?,
          Core.TypedExpr.toFullYul_staticChecked]
  | ifTrueCheckedArithReturn op lhs rhs =>
      cases op <;>
        simp [TypedStmt.fuel, TypedStmt.toFullYul, ArithOp.ifTrueFuel,
          ArithOp.ifTrueToFullYul, ArithOp.fuel, ArithOp.toFullYul,
          checkedAddReturnFullYul, checkedSubReturnFullYul,
          checkedMulReturnFullYul, checkedDivReturnFullYul,
          checkedModReturnFullYul, revertZero, Program.initialStaticContext,
          returnName, SolidCoreYulCore.FullYul.checkStmtFuel,
          SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?,
          SolidCoreYulCore.FullYul.checkStmtExpr,
          SolidCoreYulCore.FullYul.checkExpr,
          SolidCoreYulCore.FullYul.checkExprs,
          SolidCoreYulCore.FullYul.containsName,
          SolidCoreYulCore.Evm.Builtin.signature?,
          Core.TypedExpr.toFullYul_staticChecked]
  | ifBoolCheckedArithReturn cond thenOp thenLhs thenRhs elseOp
      elseLhs elseRhs =>
      cases cond <;> cases thenOp <;> cases elseOp <;>
        simp [TypedStmt.fuel, TypedStmt.toFullYul,
          ArithOp.ifBoolThenElseFuel, ArithOp.ifBoolThenElseToFullYul,
          ArithOp.ifTrueToFullYul, ArithOp.fuel, ArithOp.toFullYul,
          checkedAddReturnFullYul, checkedSubReturnFullYul,
          checkedMulReturnFullYul, checkedDivReturnFullYul,
          checkedModReturnFullYul, revertZero, Program.initialStaticContext,
          returnName, SolidCoreYulCore.FullYul.checkStmtFuel,
          SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?,
          SolidCoreYulCore.FullYul.checkStmtExpr,
          SolidCoreYulCore.FullYul.checkExpr,
          SolidCoreYulCore.FullYul.checkExprs,
          SolidCoreYulCore.FullYul.containsName,
          SolidCoreYulCore.Evm.Builtin.signature?,
          Core.TypedExpr.toFullYul_staticChecked]
  | ifCheckedArithReturn cond thenOp thenLhs thenRhs elseOp elseLhs elseRhs =>
      by_cases hCond : SolidCoreYulCore.norm cond.eval = 0
      · cases thenOp <;> cases elseOp <;>
          simp [TypedStmt.fuel, TypedStmt.toFullYul,
            ArithOp.ifExprThenElseFuel, ArithOp.ifExprThenElseToFullYul,
            ArithOp.fuel, ArithOp.toFullYul, checkedAddReturnFullYul,
            checkedSubReturnFullYul, checkedMulReturnFullYul,
            checkedDivReturnFullYul, checkedModReturnFullYul, revertZero,
            Program.initialStaticContext, returnName,
            SolidCoreYulCore.FullYul.checkStmtFuel,
            SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?,
            SolidCoreYulCore.FullYul.checkStmtExpr,
            SolidCoreYulCore.FullYul.checkExpr,
            SolidCoreYulCore.FullYul.checkExprs,
            SolidCoreYulCore.FullYul.containsName,
            SolidCoreYulCore.Evm.Builtin.signature?,
            Core.TypedExpr.toFullYul_staticChecked, hCond]
      · cases thenOp <;> cases elseOp <;>
          simp [TypedStmt.fuel, TypedStmt.toFullYul,
            ArithOp.ifExprThenElseFuel, ArithOp.ifExprThenElseToFullYul,
            ArithOp.fuel, ArithOp.toFullYul, checkedAddReturnFullYul,
            checkedSubReturnFullYul, checkedMulReturnFullYul,
            checkedDivReturnFullYul, checkedModReturnFullYul, revertZero,
            Program.initialStaticContext, returnName,
            SolidCoreYulCore.FullYul.checkStmtFuel,
            SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?,
            SolidCoreYulCore.FullYul.checkStmtExpr,
            SolidCoreYulCore.FullYul.checkExpr,
            SolidCoreYulCore.FullYul.checkExprs,
            SolidCoreYulCore.FullYul.containsName,
            SolidCoreYulCore.Evm.Builtin.signature?,
            Core.TypedExpr.toFullYul_staticChecked, hCond]
  | checkedAddReturn lhs rhs =>
      simp [TypedStmt.fuel, TypedStmt.toFullYul, checkedAddReturnFullYul,
        revertZero, Program.initialStaticContext, returnName,
        SolidCoreYulCore.FullYul.checkStmtFuel,
        SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?,
        SolidCoreYulCore.FullYul.checkStmtExpr,
        SolidCoreYulCore.FullYul.checkExpr,
        SolidCoreYulCore.FullYul.checkExprs,
        SolidCoreYulCore.FullYul.containsName,
        SolidCoreYulCore.Evm.Builtin.signature?,
        Core.TypedExpr.toFullYul_staticChecked]
  | checkedSubReturn lhs rhs =>
      simp [TypedStmt.fuel, TypedStmt.toFullYul, checkedSubReturnFullYul,
        revertZero, Program.initialStaticContext, returnName,
        SolidCoreYulCore.FullYul.checkStmtFuel,
        SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?,
        SolidCoreYulCore.FullYul.checkStmtExpr,
        SolidCoreYulCore.FullYul.checkExpr,
        SolidCoreYulCore.FullYul.checkExprs,
        SolidCoreYulCore.FullYul.containsName,
        SolidCoreYulCore.Evm.Builtin.signature?,
        Core.TypedExpr.toFullYul_staticChecked]
  | checkedMulReturn lhs rhs =>
      simp [TypedStmt.fuel, TypedStmt.toFullYul, checkedMulReturnFullYul,
        revertZero, Program.initialStaticContext, returnName,
        SolidCoreYulCore.FullYul.checkStmtFuel,
        SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?,
        SolidCoreYulCore.FullYul.checkStmtExpr,
        SolidCoreYulCore.FullYul.checkExpr,
        SolidCoreYulCore.FullYul.checkExprs,
        SolidCoreYulCore.FullYul.containsName,
        SolidCoreYulCore.Evm.Builtin.signature?,
        Core.TypedExpr.toFullYul_staticChecked]
  | checkedDivReturn lhs rhs =>
      simp [TypedStmt.fuel, TypedStmt.toFullYul, checkedDivReturnFullYul,
        revertZero, Program.initialStaticContext, returnName,
        SolidCoreYulCore.FullYul.checkStmtFuel,
        SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?,
        SolidCoreYulCore.FullYul.checkStmtExpr,
        SolidCoreYulCore.FullYul.checkExpr,
        SolidCoreYulCore.FullYul.checkExprs,
        SolidCoreYulCore.FullYul.containsName,
        SolidCoreYulCore.Evm.Builtin.signature?,
        Core.TypedExpr.toFullYul_staticChecked]
  | checkedModReturn lhs rhs =>
      simp [TypedStmt.fuel, TypedStmt.toFullYul, checkedModReturnFullYul,
        revertZero, Program.initialStaticContext, returnName,
        SolidCoreYulCore.FullYul.checkStmtFuel,
        SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?,
        SolidCoreYulCore.FullYul.checkStmtExpr,
        SolidCoreYulCore.FullYul.checkExpr,
        SolidCoreYulCore.FullYul.checkExprs,
        SolidCoreYulCore.FullYul.containsName,
        SolidCoreYulCore.Evm.Builtin.signature?,
        Core.TypedExpr.toFullYul_staticChecked]

def Program.toTypedStmt : Program -> TypedStmt
  | Program.checkedArithReturn op lhs rhs =>
      TypedStmt.checkedArithReturn op lhs rhs
  | Program.checkedArithAssignThenLeave op lhs rhs =>
      TypedStmt.checkedArithAssignThenLeave op lhs rhs
  | Program.checkedArithAssignSeqThenLeave firstOp firstLhs firstRhs
      secondOp secondLhs secondRhs =>
      TypedStmt.checkedArithAssignSeqThenLeave
        firstOp firstLhs firstRhs secondOp secondLhs secondRhs
  | Program.ifTrueCheckedArithReturn op lhs rhs =>
      TypedStmt.ifTrueCheckedArithReturn op lhs rhs
  | Program.ifBoolCheckedArithReturn cond
      thenOp thenLhs thenRhs elseOp elseLhs elseRhs =>
      TypedStmt.ifBoolCheckedArithReturn cond
        thenOp thenLhs thenRhs elseOp elseLhs elseRhs
  | Program.ifCheckedArithReturn cond
      thenOp thenLhs thenRhs elseOp elseLhs elseRhs =>
      TypedStmt.ifCheckedArithReturn cond
        thenOp thenLhs thenRhs elseOp elseLhs elseRhs

theorem Program.toTypedStmt_eval (program : Program) :
    program.toTypedStmt.eval = program.eval := by
  cases program <;> rfl

theorem Program.toTypedStmt_toFullYul (program : Program) :
    program.toTypedStmt.toFullYul = program.toFullYul := by
  cases program <;> rfl

theorem Program.toTypedStmt_fuel (program : Program) :
    program.toTypedStmt.fuel = program.fuel := by
  cases program <;> rfl

theorem Program.toFullYul_correct_viaTypedStmt (program : Program) :
    SolidCoreYulCore.SymYul.evalStmtFuel program.toTypedStmt.fuel
        (Core.State.toConfig { returnValue := 0 })
        program.toTypedStmt.toFullYul =
      program.toTypedStmt.eval.toSymYulResults := by
  exact TypedStmt.toFullYul_correct program.toTypedStmt

theorem Program.toFullYul_staticChecked_viaTypedStmt (program : Program) :
    SolidCoreYulCore.FullYul.checkStmtFuel program.fuel.succ
        Program.initialStaticContext false true program.toFullYul =
      some Program.initialStaticContext := by
  simpa [Program.toTypedStmt_fuel, Program.toTypedStmt_toFullYul] using
    TypedStmt.toFullYul_staticChecked program.toTypedStmt

end Checked

