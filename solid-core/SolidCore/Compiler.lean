theorem parseReturnLiteralExpr?_some
    {source : String} {expr : Solidity.Expr}
    (h : parseReturnLiteralExpr? source = some expr) :
    ∃ value, expr = Solidity.Expr.lit value := by
  unfold parseReturnLiteralExpr? at h
  cases hStrip : stripReturnLiteral? source with
  | none =>
      simp [hStrip] at h
  | some literal =>
      cases hNat : literal.trimAscii.toNat? with
      | none =>
          simp [hStrip, hNat] at h
      | some value =>
          simp [hStrip, hNat] at h
          exact ⟨value, h.symm⟩

theorem parseReturnLiteral?_some
    {source : String} {program : Solidity.Program}
    (h : parseReturnLiteral? source = some program) :
    ∃ value, program = Solidity.Program.returnExpr (Solidity.Expr.lit value) := by
  unfold parseReturnLiteral? at h
  cases hExpr : parseReturnLiteralExpr? source with
  | none =>
      simp [hExpr] at h
  | some expr =>
      simp [hExpr] at h
      rcases parseReturnLiteralExpr?_some hExpr with ⟨value, hExprEq⟩
      subst expr
      cases h
      exact ⟨value, rfl⟩

theorem parseReturnAddLiteralExpr?_some
    {literal : String} {expr : Solidity.Expr}
    (h : parseReturnAddLiteralExpr? literal = some expr) :
    ∃ lhs rhs,
      expr =
        Solidity.Expr.add
          (Solidity.Expr.lit lhs) (Solidity.Expr.lit rhs) := by
  unfold parseReturnAddLiteralExpr? parseBinaryLiteralExpr? at h
  cases hParts : literal.splitOn "+" with
  | nil =>
      simp [hParts] at h
  | cons lhs rest =>
      cases rest with
      | nil =>
          simp [hParts] at h
      | cons rhs rest =>
          cases rest with
          | nil =>
              cases hLhs : lhs.trimAscii.toNat? with
              | none =>
                  simp [hParts, hLhs] at h
              | some lhsValue =>
                  cases hRhs : rhs.trimAscii.toNat? with
                  | none =>
                      simp [hParts, hLhs, hRhs] at h
                  | some rhsValue =>
                      simp [hParts, hLhs, hRhs] at h
                      exact ⟨lhsValue, rhsValue, h.symm⟩
          | cons _ _ =>
              simp [hParts] at h

theorem parseReturnAddLiteral?_some
    {literal : String} {program : Solidity.Program}
    (h : parseReturnAddLiteral? literal = some program) :
    ∃ lhs rhs,
      program =
        Solidity.Program.returnExpr
          (Solidity.Expr.add
            (Solidity.Expr.lit lhs) (Solidity.Expr.lit rhs)) := by
  unfold parseReturnAddLiteral? at h
  cases hExpr : parseReturnAddLiteralExpr? literal with
  | none =>
      simp [hExpr] at h
  | some expr =>
      simp [hExpr] at h
      rcases parseReturnAddLiteralExpr?_some hExpr with
        ⟨lhs, rhs, hExprEq⟩
      subst expr
      cases h
      exact ⟨lhs, rhs, rfl⟩

theorem parseReturnAddExpr?_some
    {source : String} {expr : Solidity.Expr}
    (h : parseReturnAddExpr? source = some expr) :
    ∃ lhs rhs,
      expr =
        Solidity.Expr.add
          (Solidity.Expr.lit lhs) (Solidity.Expr.lit rhs) := by
  unfold parseReturnAddExpr? parseReturnBinaryExpr? at h
  cases hStrip : stripReturnLiteral? source with
  | none =>
      simp [hStrip] at h
  | some literal =>
      exact parseReturnAddLiteralExpr?_some (by simpa [hStrip] using h)

theorem parseReturnAdd?_some
    {source : String} {program : Solidity.Program}
    (h : parseReturnAdd? source = some program) :
    ∃ lhs rhs,
