theorem ArithOp.assignToFullYul_correct (op : ArithOp)
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) :
    SolidCoreYulCore.SymYul.evalStmtFuel op.assignFuel
        (Core.State.toConfig { returnValue := 0 })
        (op.assignToFullYul lhs rhs) =
      (op.evalAssign lhs rhs).toSymYulResults := by
  cases op <;>
    simp [ArithOp.assignFuel, ArithOp.assignToFullYul, ArithOp.evalAssign,
      ArithOp.evalAssignFrom, checkedAddAssignFullYul_correct,
      checkedSubAssignFullYul_correct, checkedMulAssignFullYul_correct,
      checkedDivAssignFullYul_correct, checkedModAssignFullYul_correct]

theorem ArithOp.assignToFullYul_correct_from (op : ArithOp)
