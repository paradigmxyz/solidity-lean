inductive ArithOp where
  | add
  | sub
  | mul
  | div
  | mod
  deriving DecidableEq, Repr

def ArithOp.evalReturn (op : ArithOp)
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) : Result :=
  match op with
  | ArithOp.add => checkedAddReturnEval { returnValue := 0 } lhs rhs
  | ArithOp.sub => checkedSubReturnEval { returnValue := 0 } lhs rhs
  | ArithOp.mul => checkedMulReturnEval { returnValue := 0 } lhs rhs
  | ArithOp.div => checkedDivReturnEval { returnValue := 0 } lhs rhs
  | ArithOp.mod => checkedModReturnEval { returnValue := 0 } lhs rhs

def ArithOp.toFullYul (op : ArithOp)
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) :
    SolidCoreYulCore.FullYul.Stmt :=
  match op with
  | ArithOp.add => checkedAddReturnFullYul lhs rhs
  | ArithOp.sub => checkedSubReturnFullYul lhs rhs
  | ArithOp.mul => checkedMulReturnFullYul lhs rhs
  | ArithOp.div => checkedDivReturnFullYul lhs rhs
  | ArithOp.mod => checkedModReturnFullYul lhs rhs

def ArithOp.evalAssignFrom (op : ArithOp) (state : Core.State)
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) : StepResult :=
  match op with
  | ArithOp.add => checkedAddAssignEval state lhs rhs
  | ArithOp.sub => checkedSubAssignEval state lhs rhs
  | ArithOp.mul => checkedMulAssignEval state lhs rhs
  | ArithOp.div => checkedDivAssignEval state lhs rhs
  | ArithOp.mod => checkedModAssignEval state lhs rhs

def ArithOp.evalAssign (op : ArithOp)
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) : StepResult :=
  op.evalAssignFrom { returnValue := 0 } lhs rhs

def ArithOp.assignToFullYul (op : ArithOp)
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) :
    SolidCoreYulCore.FullYul.Stmt :=
  match op with
  | ArithOp.add => checkedAddAssignFullYul lhs rhs
  | ArithOp.sub => checkedSubAssignFullYul lhs rhs
  | ArithOp.mul => checkedMulAssignFullYul lhs rhs
  | ArithOp.div => checkedDivAssignFullYul lhs rhs
  | ArithOp.mod => checkedModAssignFullYul lhs rhs

def ArithOp.evalAssignThenLeaveFrom (op : ArithOp) (state : Core.State)
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) : Result :=
  (op.evalAssignFrom state lhs rhs).toReturnResult

def ArithOp.evalAssignThenLeave (op : ArithOp)
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) : Result :=
  op.evalAssignThenLeaveFrom { returnValue := 0 } lhs rhs

def ArithOp.assignThenLeaveToFullYul (op : ArithOp)
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) :
    SolidCoreYulCore.FullYul.Stmt :=
  SolidCoreYulCore.FullYul.Stmt.seq
    (op.assignToFullYul lhs rhs)
    SolidCoreYulCore.FullYul.Stmt.leave

def ArithOp.evalAssignSeqFrom
    (firstOp : ArithOp) (state : Core.State)
    (firstLhs firstRhs : Core.TypedExpr Core.Ty.uint256)
    (secondOp : ArithOp)
    (secondLhs secondRhs : Core.TypedExpr Core.Ty.uint256) :
    StepResult :=
  (firstOp.evalAssignFrom state firstLhs firstRhs).bind
    (fun state' => secondOp.evalAssignFrom state' secondLhs secondRhs)

def ArithOp.evalAssignSeqThenLeaveFrom
    (firstOp : ArithOp) (state : Core.State)
    (firstLhs firstRhs : Core.TypedExpr Core.Ty.uint256)
    (secondOp : ArithOp)
    (secondLhs secondRhs : Core.TypedExpr Core.Ty.uint256) :
    Result :=
  (ArithOp.evalAssignSeqFrom firstOp state firstLhs firstRhs
    secondOp secondLhs secondRhs).toReturnResult

def ArithOp.assignSeqThenLeaveToFullYul
    (firstOp : ArithOp)
    (firstLhs firstRhs : Core.TypedExpr Core.Ty.uint256)
    (secondOp : ArithOp)
    (secondLhs secondRhs : Core.TypedExpr Core.Ty.uint256) :
    SolidCoreYulCore.FullYul.Stmt :=
  SolidCoreYulCore.FullYul.Stmt.seq
    (firstOp.assignToFullYul firstLhs firstRhs)
    (secondOp.assignThenLeaveToFullYul secondLhs secondRhs)

def ArithOp.ifTrueToFullYul (op : ArithOp)
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) :
    SolidCoreYulCore.FullYul.Stmt :=
  SolidCoreYulCore.FullYul.Stmt.ifThen
    (Core.TypedExpr.boolLit true).toFullYul
    (op.toFullYul lhs rhs)

def ArithOp.ifBoolThenElseEval (cond : Bool)
    (thenOp : ArithOp) (thenLhs thenRhs : Core.TypedExpr Core.Ty.uint256)
    (elseOp : ArithOp) (elseLhs elseRhs : Core.TypedExpr Core.Ty.uint256) :
    Result :=
  if cond then
    thenOp.evalReturn thenLhs thenRhs
  else
    elseOp.evalReturn elseLhs elseRhs

def ArithOp.ifBoolThenElseToFullYul (cond : Bool)
    (thenOp : ArithOp) (thenLhs thenRhs : Core.TypedExpr Core.Ty.uint256)
    (elseOp : ArithOp) (elseLhs elseRhs : Core.TypedExpr Core.Ty.uint256) :
    SolidCoreYulCore.FullYul.Stmt :=
  if cond then
    thenOp.ifTrueToFullYul thenLhs thenRhs
  else
    SolidCoreYulCore.FullYul.Stmt.seq
      (SolidCoreYulCore.FullYul.Stmt.ifThen
        (Core.TypedExpr.boolLit false).toFullYul
        (thenOp.toFullYul thenLhs thenRhs))
      (elseOp.toFullYul elseLhs elseRhs)

def ArithOp.ifExprThenElseEval (cond : Core.TypedExpr Core.Ty.bool)
    (thenOp : ArithOp) (thenLhs thenRhs : Core.TypedExpr Core.Ty.uint256)
    (elseOp : ArithOp) (elseLhs elseRhs : Core.TypedExpr Core.Ty.uint256) :
    Result :=
  if SolidCoreYulCore.norm cond.eval = 0 then
    elseOp.evalReturn elseLhs elseRhs
  else
    thenOp.evalReturn thenLhs thenRhs

def ArithOp.ifExprThenElseToFullYul (cond : Core.TypedExpr Core.Ty.bool)
    (thenOp : ArithOp) (thenLhs thenRhs : Core.TypedExpr Core.Ty.uint256)
    (elseOp : ArithOp) (elseLhs elseRhs : Core.TypedExpr Core.Ty.uint256) :
    SolidCoreYulCore.FullYul.Stmt :=
  SolidCoreYulCore.FullYul.Stmt.seq
    (SolidCoreYulCore.FullYul.Stmt.ifThen cond.toFullYul
      (thenOp.toFullYul thenLhs thenRhs))
    (elseOp.toFullYul elseLhs elseRhs)

theorem ArithOp.toFullYul_compilerEmittable (op : ArithOp)
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) :
    SolidCoreYulCore.FullYul.CompilerEmittableStmt
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      (op.toFullYul lhs rhs) := by
  cases op with
  | add =>
      simpa [ArithOp.toFullYul] using
        checkedAddReturnFullYul_compilerEmittable lhs rhs
  | sub =>
      simpa [ArithOp.toFullYul] using
        checkedSubReturnFullYul_compilerEmittable lhs rhs
  | mul =>
      simpa [ArithOp.toFullYul] using
        checkedMulReturnFullYul_compilerEmittable lhs rhs
  | div =>
      simpa [ArithOp.toFullYul] using
        checkedDivReturnFullYul_compilerEmittable lhs rhs
  | mod =>
      simpa [ArithOp.toFullYul] using
        checkedModReturnFullYul_compilerEmittable lhs rhs

theorem ArithOp.assignToFullYul_compilerEmittable (op : ArithOp)
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) :
    SolidCoreYulCore.FullYul.CompilerEmittableStmt
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      (op.assignToFullYul lhs rhs) := by
  cases op with
  | add =>
      simpa [ArithOp.assignToFullYul] using
        checkedAddAssignFullYul_compilerEmittable lhs rhs
  | sub =>
      simpa [ArithOp.assignToFullYul] using
        checkedSubAssignFullYul_compilerEmittable lhs rhs
  | mul =>
      simpa [ArithOp.assignToFullYul] using
        checkedMulAssignFullYul_compilerEmittable lhs rhs
  | div =>
      simpa [ArithOp.assignToFullYul] using
        checkedDivAssignFullYul_compilerEmittable lhs rhs
  | mod =>
      simpa [ArithOp.assignToFullYul] using
        checkedModAssignFullYul_compilerEmittable lhs rhs

theorem ArithOp.assignThenLeaveToFullYul_compilerEmittable
    (op : ArithOp) (lhs rhs : Core.TypedExpr Core.Ty.uint256) :
    SolidCoreYulCore.FullYul.CompilerEmittableStmt
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      (op.assignThenLeaveToFullYul lhs rhs) := by
  simpa [ArithOp.assignThenLeaveToFullYul] using
    SolidCoreYulCore.FullYul.CompilerEmittableStmt.seq
      (ArithOp.assignToFullYul_compilerEmittable op lhs rhs)
      SolidCoreYulCore.FullYul.CompilerEmittableStmt.leave

theorem ArithOp.assignSeqThenLeaveToFullYul_compilerEmittable
    (firstOp : ArithOp)
    (firstLhs firstRhs : Core.TypedExpr Core.Ty.uint256)
    (secondOp : ArithOp)
    (secondLhs secondRhs : Core.TypedExpr Core.Ty.uint256) :
    SolidCoreYulCore.FullYul.CompilerEmittableStmt
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      (ArithOp.assignSeqThenLeaveToFullYul
        firstOp firstLhs firstRhs secondOp secondLhs secondRhs) := by
  simpa [ArithOp.assignSeqThenLeaveToFullYul] using
    SolidCoreYulCore.FullYul.CompilerEmittableStmt.seq
      (ArithOp.assignToFullYul_compilerEmittable
        firstOp firstLhs firstRhs)
      (ArithOp.assignThenLeaveToFullYul_compilerEmittable
        secondOp secondLhs secondRhs)

theorem ArithOp.ifTrueToFullYul_compilerEmittable (op : ArithOp)
    (lhs rhs : Core.TypedExpr Core.Ty.uint256) :
    SolidCoreYulCore.FullYul.CompilerEmittableStmt
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      (op.ifTrueToFullYul lhs rhs) := by
  simpa [ArithOp.ifTrueToFullYul] using
    SolidCoreYulCore.FullYul.CompilerEmittableStmt.ifThen
      (Core.TypedExpr.toFullYul_compilerEmittable
        (Core.TypedExpr.boolLit true))
      (ArithOp.toFullYul_compilerEmittable op lhs rhs)

theorem ArithOp.ifBoolThenElseToFullYul_compilerEmittable
    (cond : Bool)
    (thenOp : ArithOp) (thenLhs thenRhs : Core.TypedExpr Core.Ty.uint256)
    (elseOp : ArithOp) (elseLhs elseRhs : Core.TypedExpr Core.Ty.uint256) :
    SolidCoreYulCore.FullYul.CompilerEmittableStmt
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      (ArithOp.ifBoolThenElseToFullYul cond
        thenOp thenLhs thenRhs elseOp elseLhs elseRhs) := by
  cases cond with
  | false =>
      simpa [ArithOp.ifBoolThenElseToFullYul] using
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.seq
          (SolidCoreYulCore.FullYul.CompilerEmittableStmt.ifThen
            (Core.TypedExpr.toFullYul_compilerEmittable
              (Core.TypedExpr.boolLit false))
            (ArithOp.toFullYul_compilerEmittable
              thenOp thenLhs thenRhs))
          (ArithOp.toFullYul_compilerEmittable elseOp elseLhs elseRhs)
  | true =>
      simpa [ArithOp.ifBoolThenElseToFullYul] using
        ArithOp.ifTrueToFullYul_compilerEmittable thenOp thenLhs thenRhs

theorem ArithOp.ifExprThenElseToFullYul_compilerEmittable
    (cond : Core.TypedExpr Core.Ty.bool)
    (thenOp : ArithOp) (thenLhs thenRhs : Core.TypedExpr Core.Ty.uint256)
    (elseOp : ArithOp) (elseLhs elseRhs : Core.TypedExpr Core.Ty.uint256) :
    SolidCoreYulCore.FullYul.CompilerEmittableStmt
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      (ArithOp.ifExprThenElseToFullYul cond
        thenOp thenLhs thenRhs elseOp elseLhs elseRhs) := by
  simpa [ArithOp.ifExprThenElseToFullYul] using
    SolidCoreYulCore.FullYul.CompilerEmittableStmt.seq
      (SolidCoreYulCore.FullYul.CompilerEmittableStmt.ifThen
        (Core.TypedExpr.toFullYul_compilerEmittable cond)
        (ArithOp.toFullYul_compilerEmittable
          thenOp thenLhs thenRhs))
      (ArithOp.toFullYul_compilerEmittable elseOp elseLhs elseRhs)

