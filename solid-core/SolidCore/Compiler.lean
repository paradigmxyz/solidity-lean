structure SolidityToFullYulStmtCertificate where
  source : String
  stmt : SolidCoreYulCore.FullYul.Stmt
  artifact : AnyStaticFullYulStmtArtifact
  compiled : compileSolidityToFullYulStmt source = some stmt
  artifact_compiled : compileAnyStaticStmtArtifact source = some artifact
  emitted : artifact.stmt = stmt

def compileSolidityToFullYulStmtCertificate (source : String) :
    Option SolidityToFullYulStmtCertificate :=
  match hArtifact : compileAnyStaticStmtArtifact source with
  | some artifact =>
      some
        { source := source
          stmt := artifact.stmt
          artifact := artifact
          compiled := by
            simp [compileSolidityToFullYulStmt, hArtifact]
          artifact_compiled := hArtifact
          emitted := rfl }
  | none => none

theorem compileSolidityToFullYulStmtCertificate_source
    {source : String} {cert : SolidityToFullYulStmtCertificate}
    (hCompile :
      compileSolidityToFullYulStmtCertificate source = some cert) :
    cert.source = source := by
  unfold compileSolidityToFullYulStmtCertificate at hCompile
  split at hCompile
  · cases hCompile
    rfl
  · cases hCompile

theorem compileSolidityToFullYulStmtCertificate_map_stmt
    (source : String) :
    (compileSolidityToFullYulStmtCertificate source).map
        (fun cert => cert.stmt) =
      compileSolidityToFullYulStmt source := by
  unfold compileSolidityToFullYulStmtCertificate
  unfold compileSolidityToFullYulStmt
  split <;> simp_all

theorem compileSolidityToFullYulStmtCertificate_isSome
    (source : String) :
    (compileSolidityToFullYulStmtCertificate source).isSome =
      (compileSolidityToFullYulStmt source).isSome := by
  rw [← compileSolidityToFullYulStmtCertificate_map_stmt source]
  cases compileSolidityToFullYulStmtCertificate source <;> rfl

theorem compileSolidityToFullYulStmtCertificate_none_iff
    (source : String) :
    compileSolidityToFullYulStmtCertificate source = none ↔
      compileSolidityToFullYulStmt source = none := by
  constructor
  · intro hCert
    have hMap := compileSolidityToFullYulStmtCertificate_map_stmt source
    simpa [hCert] using hMap.symm
  · intro hStmt
    cases hCert : compileSolidityToFullYulStmtCertificate source with
    | none => rfl
    | some cert =>
        have hMap :=
          compileSolidityToFullYulStmtCertificate_map_stmt source
        rw [hCert, hStmt] at hMap
        cases hMap

theorem compileSolidityToFullYulStmtCertificate_some_stmt_iff
    {source : String} {stmt : SolidCoreYulCore.FullYul.Stmt} :
    (∃ cert,
      compileSolidityToFullYulStmtCertificate source = some cert ∧
      cert.stmt = stmt) ↔
      compileSolidityToFullYulStmt source = some stmt := by
  constructor
  · intro hCert
    rcases hCert with ⟨cert, hCert, hStmt⟩
    have hMap := compileSolidityToFullYulStmtCertificate_map_stmt source
    rw [hCert] at hMap
    simpa [hStmt] using hMap.symm
  · intro hCompile
    cases hCert : compileSolidityToFullYulStmtCertificate source with
    | some cert =>
        have hMap :=
          compileSolidityToFullYulStmtCertificate_map_stmt source
        rw [hCert, hCompile] at hMap
        cases hMap
        exact ⟨cert, rfl, rfl⟩
    | none =>
        have hMap :=
          compileSolidityToFullYulStmtCertificate_map_stmt source
        rw [hCert, hCompile] at hMap
        cases hMap

theorem SolidityToFullYulStmtCertificate.eval_sound_flat
    (cert : SolidityToFullYulStmtCertificate) :
    SolidCoreYulCore.SymYul.evalStmtFuel cert.artifact.fuel
        cert.artifact.initialConfig cert.stmt =
      cert.artifact.expectedResults := by
  rw [← cert.emitted]
  exact cert.artifact.eval_sound_flat

theorem SolidityToFullYulStmtCertificate.static_checked_flat
    (cert : SolidityToFullYulStmtCertificate) :
    SolidCoreYulCore.FullYul.checkStmtFuel cert.artifact.fuel.succ
        Solidity.Program.initialStaticContext false cert.artifact.inFun
        cert.stmt =
      some Solidity.Program.initialStaticContext := by
