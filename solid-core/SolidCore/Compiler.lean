  sourceToCore_program : sourceToCore.program = program
  sourceToCore_emitted : sourceToCore.core.toFullYul = stmt
  coreToFullYul : CoreFullYulStmtArtifact
  coreToFullYul_source : coreToFullYul.source = sourceToCore.source
  coreToFullYul_core : coreToFullYul.core = sourceToCore.core
  coreToFullYul_stmt : coreToFullYul.stmt = stmt
  parsed : parse source = some program
  compiled : compileToFullYulStmt source = some stmt
  eval_sound :
    SolidCoreYulCore.SymYul.evalStmtFuel program.stmtFuel
        Solidity.Body.initialSymYulConfig stmt =
