def AcceptedProgram.initialConfig :
    AcceptedProgram -> SolidCoreYulCore.SymYul.Config
  | AcceptedProgram.body _ => Body.initialSymYulConfig
  | AcceptedProgram.storage _ => Program.storageCoreInitialState.toConfig
  | AcceptedProgram.internalCall _ => Body.initialSymYulConfig
  | AcceptedProgram.internalStorage _ => Body.initialSymYulConfig
  | AcceptedProgram.typedStmt _ => (State.toConfig { returnValue := 0 })

def AcceptedProgram.finalResults :
    AcceptedProgram -> List SolidCoreYulCore.SymYul.Result
  | AcceptedProgram.body stmt =>
      [SolidCoreYulCore.SymYul.normalResult
        (Body.returnConfig stmt.eval)]
  | AcceptedProgram.storage stmt =>
      [SolidCoreYulCore.SymYul.normalResult
        ((stmt.eval Program.storageCoreInitialState).toConfig)]
  | AcceptedProgram.internalCall stmt =>
      [SolidCoreYulCore.SymYul.normalResult
        stmt.toProgram.finalSymYulConfig]
  | AcceptedProgram.internalStorage stmt =>
      [SolidCoreYulCore.SymYul.normalResult
        stmt.toProgram.finalSymYulConfig]
  | AcceptedProgram.typedStmt stmt =>
      (stmt.eval { returnValue := 0 }).toStructuredResult.toSymYulResults

theorem AcceptedProgram.toFullYul_correct
    (program : AcceptedProgram) :
    SolidCoreYulCore.SymYul.evalStmtFuel
        program.fuel program.initialConfig program.toFullYul =
      program.finalResults := by
  cases program with
  | body stmt =>
      simpa [AcceptedProgram.initialConfig, AcceptedProgram.finalResults]
        using AcceptedProgram.body_toFullYul_correct stmt
  | storage stmt =>
      simpa [AcceptedProgram.initialConfig, AcceptedProgram.finalResults]
        using
          AcceptedProgram.storage_toFullYul_correct_from
            Program.storageCoreInitialState stmt
  | internalCall stmt =>
      simpa [AcceptedProgram.initialConfig, AcceptedProgram.finalResults,
        AcceptedProgram.fuel, AcceptedProgram.toFullYul] using
          InternalCall.Stmt.toFullYul_correct stmt
  | internalStorage stmt =>
      simpa [AcceptedProgram.initialConfig, AcceptedProgram.finalResults,
        AcceptedProgram.fuel, AcceptedProgram.toFullYul] using
          Storage.InternalCall.Stmt.toFullYul_correct stmt
  | typedStmt stmt =>
      simpa [AcceptedProgram.initialConfig, AcceptedProgram.finalResults]
        using AcceptedProgram.typedStmt_toFullYul_correct stmt

end Core

def Program.toBodyCore? : Program -> Option Core.BodyStmt
  | Program.returnExpr expr =>
      some (Core.BodyStmt.ofBody (Body.returnExpr expr))
  | Program.functionBody body => Core.BodyStmt.ofBodyNoFun? body
  | _ => none

def Program.toCore? : Program -> Option Core.AcceptedProgram
  | Program.returnExpr expr =>
      some (Core.AcceptedProgram.body
        (Core.BodyStmt.ofBody (Body.returnExpr expr)))
  | Program.functionBody body =>
      match body with
      | Body.internalCallReturn =>
          some (Core.AcceptedProgram.internalCall
            Core.InternalCall.Stmt.noArgReturn)
      | _ =>
          (Core.BodyStmt.ofBodyNoFun? body).map Core.AcceptedProgram.body
  | Program.internalCallArgReturn =>
      some (Core.AcceptedProgram.internalCall
        Core.InternalCall.Stmt.argReturn)
  | Program.internalCallMultiReturn =>
      some (Core.AcceptedProgram.internalCall
        Core.InternalCall.Stmt.multiReturn)
  | Program.storageWriteRead =>
      some (Core.AcceptedProgram.storage Program.storageWriteReadCore)
  | Program.storageOverwriteRead =>
      some (Core.AcceptedProgram.storage Program.storageOverwriteReadCore)
  | Program.storagePairReadAdd =>
      some (Core.AcceptedProgram.storage Program.storagePairReadAddCore)
  | Program.storageIfWriteRead =>
      some (Core.AcceptedProgram.storage Program.storageIfWriteReadCore)
  | Program.storageIfFalseWriteRead =>
      some (Core.AcceptedProgram.storage Program.storageIfFalseWriteReadCore)
  | Program.internalStorageCall =>
      some (Core.AcceptedProgram.internalStorage
        Core.Storage.InternalCall.Stmt.noArgWriteRead)
  | Program.internalStorageArgCall =>
      some (Core.AcceptedProgram.internalStorage
        Core.Storage.InternalCall.Stmt.argWriteRead)
  | Program.internalStorageArgReturnCall =>
      some (Core.AcceptedProgram.internalStorage
        Core.Storage.InternalCall.Stmt.argReturnWriteRead)
  | Program.internalStoragePairArgReturnCall =>
      some (Core.AcceptedProgram.internalStorage
        Core.Storage.InternalCall.Stmt.pairArgReturnWriteReadAdd)
  | Program.internalStorageReadUpdateCall =>
      some (Core.AcceptedProgram.internalStorage
        Core.Storage.InternalCall.Stmt.readUpdateReturn)
  | Program.internalStorageConditionalCall =>
      some (Core.AcceptedProgram.internalStorage
        Core.Storage.InternalCall.Stmt.conditionalReturn)
  | Program.internalStorageConditionalFalseCall =>
      some (Core.AcceptedProgram.internalStorage
        Core.Storage.InternalCall.Stmt.conditionalFalseReturn)
  | Program.nestedInternalStorageCall =>
      some (Core.AcceptedProgram.internalStorage
        Core.Storage.InternalCall.Stmt.nestedWriteRead)

theorem Program.toCore?_storage_some_toStorageCore?
    {program : Program} {stmt : Core.Storage.Stmt}
    (h : program.toCore? = some (Core.AcceptedProgram.storage stmt)) :
    program.toStorageCore? = some stmt := by
  cases program <;>
    simp [Program.toCore?, Program.toStorageCore?] at h ⊢
  · rename_i body
    cases body <;> simp [Program.toCore?, Core.BodyStmt.ofBodyNoFun?] at h
  all_goals
    cases h
    rfl

theorem Program.toCore?_internalCall_some_toInternalCallCore?
    {program : Program} {stmt : Core.InternalCall.Stmt}
    (h :
      program.toCore? =
        some (Core.AcceptedProgram.internalCall stmt)) :
    program.toInternalCallCore? = some stmt := by
  cases program <;>
    simp [Program.toCore?, Program.toInternalCallCore?] at h ⊢
  · rename_i body
    cases body <;> simp [Program.toCore?, Program.toInternalCallCore?,
      Core.BodyStmt.ofBodyNoFun?] at h ⊢
    exact h
  · exact h
  · exact h

theorem Program.toCore?_internalStorage_some_toInternalStorageCore?
    {program : Program} {stmt : Core.Storage.InternalCall.Stmt}
    (h :
      program.toCore? =
        some (Core.AcceptedProgram.internalStorage stmt)) :
    program.toInternalStorageCore? = some stmt := by
  cases program <;>
    simp [Program.toCore?, Program.toInternalStorageCore?] at h ⊢
  · rename_i body
    cases body <;> simp [Program.toCore?, Core.BodyStmt.ofBodyNoFun?] at h
  all_goals
    cases h
    rfl

