      | some initLhsExpr =>
          cases hInitRhs :
              parseGeneratedReturnExpr? (returnLiteralSource initRhsLiteral) with
          | none =>
              simp [hStrip, hInitLhs, hInitRhs] at h
          | some initRhsExpr =>
              cases hAssignedLhs :
