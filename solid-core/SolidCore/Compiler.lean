theorem Stmt.evalBlockFuel_single_from
    (extraFuel : Nat) (state : State) (stmt : Stmt) :
    SolidCoreYulCore.SymYul.evalBlockFuel (stmt.fuel + extraFuel + 2)
        state.toConfig [stmt.toFullYul] =
      (stmt.eval state).toSymYulResults := by
  have hStmt := Stmt.toFullYul_correct_from extraFuel state stmt
  cases hEval : Stmt.eval state stmt with
  | normal state' =>
      have hStmt' :
          SolidCoreYulCore.SymYul.evalStmtFuel
              (extraFuel + (1 + stmt.fuel))
              state.toConfig stmt.toFullYul =
            [SolidCoreYulCore.SymYul.normalResult state'.toConfig] := by
        simpa [hEval, Result.toSymYulResults,
          Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hStmt
      simp [SolidCoreYulCore.SymYul.evalBlockFuel,
        SolidCoreYulCore.SymYul.bindNormal,
        SolidCoreYulCore.SymYul.normalResult,
        hStmt', Result.toSymYulResults,
        Nat.add_assoc, Nat.add_comm, Nat.add_left_comm]
  | returned state' =>
      have hStmt' :
          SolidCoreYulCore.SymYul.evalStmtFuel
              (extraFuel + (1 + stmt.fuel))
              state.toConfig stmt.toFullYul =
            [state'.leftResult] := by
        simpa [hEval, Result.toSymYulResults, State.leftResult,
          Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hStmt
      simp [SolidCoreYulCore.SymYul.evalBlockFuel,
        SolidCoreYulCore.SymYul.bindNormal,
        SolidCoreYulCore.SymYul.normalResult,
        hStmt', Result.toSymYulResults, State.leftResult,
        Nat.add_assoc, Nat.add_comm, Nat.add_left_comm]

theorem Stmt.evalStmtFuel_block_single_from
    (extraFuel : Nat) (state : State) (stmt : Stmt) :
    SolidCoreYulCore.SymYul.evalStmtFuel (stmt.fuel + extraFuel + 3)
        state.toConfig
        (SolidCoreYulCore.FullYul.Stmt.block [stmt.toFullYul]) =
      (stmt.eval state).toSymYulResults := by
  have hBlock := Stmt.evalBlockFuel_single_from extraFuel state stmt
  cases hEval : Stmt.eval state stmt with
  | normal state' =>
      have hBlock' :
          SolidCoreYulCore.SymYul.evalBlockFuel (extraFuel + (2 + stmt.fuel))
              ({ state.toConfig with funcs := state.toConfig.funcs })
              [stmt.toFullYul] =
            [SolidCoreYulCore.SymYul.normalResult state'.toConfig] := by
        simpa [hEval, Result.toSymYulResults,
          Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hBlock
      simp [SolidCoreYulCore.SymYul.evalStmtFuel,
        SolidCoreYulCore.SymYul.collectBlockFunctionDefs,
        Stmt.collect_toFullYul, hBlock',
        State.withRestoredConfig_normal, Result.toSymYulResults,
        Nat.add_comm, Nat.add_left_comm]
  | returned state' =>
      have hBlock' :
          SolidCoreYulCore.SymYul.evalBlockFuel (extraFuel + (2 + stmt.fuel))
              ({ state.toConfig with funcs := state.toConfig.funcs })
              [stmt.toFullYul] =
            [state'.leftResult] := by
        simpa [hEval, Result.toSymYulResults, State.leftResult,
          Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hBlock
      have hRestore :
          SolidCoreYulCore.SymYul.withRestoredConfig state.toConfig
              { flow := SolidCoreYulCore.FullYul.Flow.left,
                config := state'.toConfig } =
            some { flow := SolidCoreYulCore.FullYul.Flow.left,
                   config := state'.toConfig } := by
        simpa [State.leftResult] using
          State.withRestoredConfig_left state state'
      simp [SolidCoreYulCore.SymYul.evalStmtFuel,
        SolidCoreYulCore.SymYul.collectBlockFunctionDefs,
        Stmt.collect_toFullYul, hBlock', hRestore,
        Result.toSymYulResults, State.leftResult,
        Nat.add_comm, Nat.add_left_comm]

end Structured

