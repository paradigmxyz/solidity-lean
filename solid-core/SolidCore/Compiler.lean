set_option maxHeartbeats 1000000
set_option maxRecDepth 2048
set_option linter.unusedSimpArgs false

namespace SolidCore

abbrev Word := SolidCoreYulCore.Word

namespace Solidity

inductive Expr where
  | lit : Nat -> Expr
  | neg : Expr -> Expr
  | add : Expr -> Expr -> Expr
  | sub : Expr -> Expr -> Expr
  | mul : Expr -> Expr -> Expr
  | exp : Expr -> Expr -> Expr
  | div : Expr -> Expr -> Expr
  | mod : Expr -> Expr -> Expr
  | signedDiv : Expr -> Expr -> Expr
  | signedMod : Expr -> Expr -> Expr
  | addmod : Expr -> Expr -> Expr -> Expr
  | mulmod : Expr -> Expr -> Expr -> Expr
  | bitAnd : Expr -> Expr -> Expr
  | bitOr : Expr -> Expr -> Expr
  | bitXor : Expr -> Expr -> Expr
  | bitNot : Expr -> Expr
  | shl : Expr -> Expr -> Expr
  | shr : Expr -> Expr -> Expr
  | sar : Expr -> Expr -> Expr
  | byteAt : Expr -> Expr -> Expr
  | iszero : Expr -> Expr
  | boolAnd : Expr -> Expr -> Expr
  | boolOr : Expr -> Expr -> Expr
  | eq : Expr -> Expr -> Expr
  | ne : Expr -> Expr -> Expr
  | lt : Expr -> Expr -> Expr
  | gt : Expr -> Expr -> Expr
  | le : Expr -> Expr -> Expr
  | ge : Expr -> Expr -> Expr
  | signedLt : Expr -> Expr -> Expr
  | signedGt : Expr -> Expr -> Expr
  | signedLe : Expr -> Expr -> Expr
  | signedGe : Expr -> Expr -> Expr
  deriving DecidableEq, Repr

def Expr.eval : Expr -> Word
  | Expr.lit value => SolidCoreYulCore.norm value
  | Expr.neg expr => SolidCoreYulCore.subWord 0 expr.eval
  | Expr.add lhs rhs => SolidCoreYulCore.addWord lhs.eval rhs.eval
  | Expr.sub lhs rhs => SolidCoreYulCore.subWord lhs.eval rhs.eval
  | Expr.mul lhs rhs => SolidCoreYulCore.mulWord lhs.eval rhs.eval
  | Expr.exp lhs rhs => SolidCoreYulCore.expWord lhs.eval rhs.eval
  | Expr.div lhs rhs => SolidCoreYulCore.divWord lhs.eval rhs.eval
  | Expr.mod lhs rhs => SolidCoreYulCore.modWord lhs.eval rhs.eval
  | Expr.signedDiv lhs rhs => SolidCoreYulCore.sdivWord lhs.eval rhs.eval
  | Expr.signedMod lhs rhs => SolidCoreYulCore.smodWord lhs.eval rhs.eval
  | Expr.addmod lhs rhs modulus =>
      SolidCoreYulCore.addmodWord lhs.eval rhs.eval modulus.eval
  | Expr.mulmod lhs rhs modulus =>
      SolidCoreYulCore.mulmodWord lhs.eval rhs.eval modulus.eval
  | Expr.bitAnd lhs rhs => SolidCoreYulCore.andWord lhs.eval rhs.eval
  | Expr.bitOr lhs rhs => SolidCoreYulCore.orWord lhs.eval rhs.eval
  | Expr.bitXor lhs rhs => SolidCoreYulCore.xorWord lhs.eval rhs.eval
  | Expr.bitNot expr => SolidCoreYulCore.notWord expr.eval
  | Expr.shl value shift => SolidCoreYulCore.shlWord shift.eval value.eval
  | Expr.shr value shift => SolidCoreYulCore.shrWord shift.eval value.eval
  | Expr.sar value shift => SolidCoreYulCore.sarWord shift.eval value.eval
  | Expr.byteAt index value => SolidCoreYulCore.byteWord index.eval value.eval
  | Expr.iszero expr => SolidCoreYulCore.iszeroWord expr.eval
  | Expr.boolAnd lhs rhs =>
      SolidCoreYulCore.iszeroWord
        (SolidCoreYulCore.orWord
          (SolidCoreYulCore.iszeroWord lhs.eval)
          (SolidCoreYulCore.iszeroWord rhs.eval))
  | Expr.boolOr lhs rhs =>
      SolidCoreYulCore.iszeroWord
        (SolidCoreYulCore.andWord
          (SolidCoreYulCore.iszeroWord lhs.eval)
          (SolidCoreYulCore.iszeroWord rhs.eval))
  | Expr.eq lhs rhs => SolidCoreYulCore.eqWord lhs.eval rhs.eval
  | Expr.ne lhs rhs =>
      SolidCoreYulCore.iszeroWord (SolidCoreYulCore.eqWord lhs.eval rhs.eval)
  | Expr.lt lhs rhs => SolidCoreYulCore.ltWord lhs.eval rhs.eval
  | Expr.gt lhs rhs => SolidCoreYulCore.gtWord lhs.eval rhs.eval
  | Expr.le lhs rhs =>
      SolidCoreYulCore.iszeroWord (SolidCoreYulCore.gtWord lhs.eval rhs.eval)
  | Expr.ge lhs rhs =>
      SolidCoreYulCore.iszeroWord (SolidCoreYulCore.ltWord lhs.eval rhs.eval)
  | Expr.signedLt lhs rhs => SolidCoreYulCore.sltWord lhs.eval rhs.eval
  | Expr.signedGt lhs rhs => SolidCoreYulCore.sgtWord lhs.eval rhs.eval
  | Expr.signedLe lhs rhs =>
      SolidCoreYulCore.iszeroWord (SolidCoreYulCore.sgtWord lhs.eval rhs.eval)
  | Expr.signedGe lhs rhs =>
      SolidCoreYulCore.iszeroWord (SolidCoreYulCore.sltWord lhs.eval rhs.eval)

theorem evalEvmBuiltin_add_word (state : SolidCoreYulCore.FullYul.EvmState)
    (lhs rhs : Word) :
    SolidCoreYulCore.FullYul.evalEvmBuiltin SolidCoreYulCore.Evm.Builtin.add
        [SolidCoreYulCore.FullYul.Value.word lhs,
          SolidCoreYulCore.FullYul.Value.word rhs] state =
      some (SolidCoreYulCore.FullYul.Value.word
        (SolidCoreYulCore.addWord lhs rhs), state) := by
  rfl

