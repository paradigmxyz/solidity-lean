    SolidCoreYulCore.FullYul.checkStmtFuel cert.artifact.fuel.succ
        Solidity.Program.initialStaticContext false cert.artifact.inFun
        cert.stmt =
      some Solidity.Program.initialStaticContext ∧
    SolidCoreYulCore.FullYul.CompilerAcceptedStmt
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      cert.artifact.fuel.succ Solidity.Program.initialStaticContext
      false cert.artifact.inFun cert.stmt
