theorem Stmt.toFullYul_staticChecked (stmt : Stmt) :
    SolidCoreYulCore.FullYul.checkStmtFuel (stmt.fuel + 2)
        Program.initialStaticContext false true stmt.toFullYul =
      some Program.initialStaticContext := by
  by_cases hRoute : stmt.usesStructuredRoute = true
  · exact Stmt.toFullYul_staticChecked_structuredRoute stmt hRoute
  · match stmt with
    | Stmt.localValue init =>
      simpa [Stmt.fuel, Stmt.toFullYul, Stmt.localValueFullYul,
        LocalFrame1.fuel] using
        LocalFrame1.toFullYul_staticChecked (LocalFrame1.returnInit init)
    | Stmt.localUpdateValue init assigned =>
      simpa [Stmt.fuel, Stmt.toFullYul, Stmt.localUpdateValueFullYul,
        LocalFrame1.fuel] using
