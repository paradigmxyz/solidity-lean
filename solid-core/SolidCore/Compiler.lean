        compileToCore? uncheckedArtifact.source =
          some uncheckedArtifact.sourceToCore.core ∧
        uncheckedArtifact.sourceToCore.core.toFullYul =
          uncheckedArtifact.stmt ∧
        SolidCoreYulCore.SymYul.evalStmtFuel
            uncheckedArtifact.sourceToCore.core.fuel
            Solidity.Body.initialSymYulConfig uncheckedArtifact.stmt =
          [SolidCoreYulCore.SymYul.normalResult
            uncheckedArtifact.program.finalSymYulConfig] ∧
        SolidCoreYulCore.FullYul.checkStmtFuel
            uncheckedArtifact.sourceToCore.core.fuel.succ
            Solidity.Program.initialStaticContext false false
            uncheckedArtifact.stmt =
          some Solidity.Program.initialStaticContext ∧
        SolidCoreYulCore.FullYul.CompilerAcceptedStmt
          SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
          uncheckedArtifact.sourceToCore.core.fuel.succ
          Solidity.Program.initialStaticContext false false
          uncheckedArtifact.stmt Solidity.Program.initialStaticContext
    | AnyStaticFullYulStmtArtifact.checked checkedArtifact =>
        parseChecked checkedArtifact.source = some checkedArtifact.program ∧
        checkedArtifact.typedStmt = checkedArtifact.program.toTypedStmt ∧
        compileCheckedToTypedStmt? checkedArtifact.source =
          some checkedArtifact.typedStmt ∧
        checkedArtifact.typedStmt.toFullYul = checkedArtifact.stmt ∧
        SolidCoreYulCore.SymYul.evalStmtFuel checkedArtifact.typedStmt.fuel
            (Solidity.Core.State.toConfig { returnValue := 0 })
            checkedArtifact.stmt =
          checkedArtifact.typedStmt.eval.toSymYulResults ∧
        SolidCoreYulCore.FullYul.checkStmtFuel
            checkedArtifact.typedStmt.fuel.succ
            Solidity.Program.initialStaticContext false true
            checkedArtifact.stmt =
          some Solidity.Program.initialStaticContext ∧
        SolidCoreYulCore.FullYul.CompilerAcceptedStmt
          SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
          checkedArtifact.typedStmt.fuel.succ
          Solidity.Program.initialStaticContext false true
          checkedArtifact.stmt Solidity.Program.initialStaticContext := by
  cases artifact with
  | unchecked uncheckedArtifact =>
      rcases uncheckedArtifact.sourceToCore_sound with
        ⟨hParse, hElab, hCompiled, hEmit⟩
      exact ⟨hParse, hElab, hCompiled, hEmit,
        uncheckedArtifact.eval_sound_with_coreFuel,
        uncheckedArtifact.static_checked_with_coreFuel,
        uncheckedArtifact.accepted_currentSolidCore_with_coreFuel⟩
  | checked checkedArtifact =>
      rcases checkedArtifact.sourceToTyped_sound with
        ⟨hParse, hElab, hCompiled, hEmit⟩
      exact ⟨hParse, hElab, hCompiled, hEmit,
        by
          simpa [checkedArtifact.sourceToTyped_typedStmt, hEmit] using
            checkedArtifact.sourceToTyped.fullYul_eval_sound,
        by
          simpa [checkedArtifact.sourceToTyped_typedStmt, hEmit] using
            checkedArtifact.sourceToTyped.fullYul_static_checked,
        by
          simpa [checkedArtifact.sourceToTyped_typedStmt, hEmit] using
            checkedArtifact.sourceToTyped.fullYul_accepted_currentSolidCore⟩

theorem compileSolidityToFullYulStmt_artifact
    {source : String} {stmt : SolidCoreYulCore.FullYul.Stmt}
    (hCompile : compileSolidityToFullYulStmt source = some stmt) :
    ∃ artifact,
      compileAnyStaticStmtArtifact source = some artifact ∧
      AnyStaticFullYulStmtArtifact.stmt artifact = stmt := by
  unfold compileSolidityToFullYulStmt at hCompile
  cases hArtifact : compileAnyStaticStmtArtifact source with
  | none =>
      simp [hArtifact] at hCompile
  | some artifact =>
      simp [hArtifact] at hCompile
      exact ⟨artifact, by simp [hArtifact], hCompile⟩

theorem compileSolidityToFullYulStmt_sound
    {source : String} {stmt : SolidCoreYulCore.FullYul.Stmt}
    (hCompile : compileSolidityToFullYulStmt source = some stmt) :
    ∃ artifact,
      compileAnyStaticStmtArtifact source = some artifact ∧
      AnyStaticFullYulStmtArtifact.stmt artifact = stmt ∧
      match artifact with
      | AnyStaticFullYulStmtArtifact.unchecked uncheckedArtifact =>
          compileToFullYulStmt uncheckedArtifact.source =
            some uncheckedArtifact.stmt ∧
          SolidCoreYulCore.SymYul.evalStmtFuel
              uncheckedArtifact.program.stmtFuel
              Solidity.Body.initialSymYulConfig uncheckedArtifact.stmt =
            [SolidCoreYulCore.SymYul.normalResult
              uncheckedArtifact.program.finalSymYulConfig] ∧
          SolidCoreYulCore.FullYul.checkStmtFuel
              uncheckedArtifact.program.stmtFuel.succ
              Solidity.Program.initialStaticContext false false
              uncheckedArtifact.stmt =
            some Solidity.Program.initialStaticContext
      | AnyStaticFullYulStmtArtifact.checked checkedArtifact =>
          compileCheckedToFullYul checkedArtifact.source =
            some checkedArtifact.stmt ∧
          SolidCoreYulCore.SymYul.evalStmtFuel checkedArtifact.program.fuel
              (Solidity.Core.State.toConfig { returnValue := 0 })
              checkedArtifact.stmt =
            checkedArtifact.program.eval.toSymYulResults ∧
          SolidCoreYulCore.FullYul.checkStmtFuel
              checkedArtifact.program.fuel.succ
              Solidity.Program.initialStaticContext false true
              checkedArtifact.stmt =
            some Solidity.Program.initialStaticContext := by
  rcases compileSolidityToFullYulStmt_artifact hCompile with
    ⟨artifact, hArtifact, hStmt⟩
  exact ⟨artifact, hArtifact, hStmt, artifact.sound⟩

theorem compileSolidityToFullYulStmt_sound_flat
    {source : String} {stmt : SolidCoreYulCore.FullYul.Stmt}
    (hCompile : compileSolidityToFullYulStmt source = some stmt) :
    ∃ artifact,
      compileAnyStaticStmtArtifact source = some artifact ∧
      AnyStaticFullYulStmtArtifact.stmt artifact = stmt ∧
      SolidCoreYulCore.SymYul.evalStmtFuel artifact.fuel
          artifact.initialConfig artifact.stmt =
        artifact.expectedResults ∧
      SolidCoreYulCore.FullYul.checkStmtFuel artifact.fuel.succ
          Solidity.Program.initialStaticContext false artifact.inFun
          artifact.stmt =
        some Solidity.Program.initialStaticContext := by
  rcases compileSolidityToFullYulStmt_artifact hCompile with
    ⟨artifact, hArtifact, hStmt⟩
  exact ⟨artifact, hArtifact, hStmt,
    artifact.eval_sound_flat, artifact.static_checked_flat⟩

theorem compileSolidityToFullYulStmt_accepted_currentSolidCore
    {source : String} {stmt : SolidCoreYulCore.FullYul.Stmt}
    (hCompile : compileSolidityToFullYulStmt source = some stmt) :
