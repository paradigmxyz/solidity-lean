  static_checked :
    SolidCoreYulCore.FullYul.checkStmtFuel program.stmtFuel.succ
        Solidity.Program.initialStaticContext false false stmt =
      some Solidity.Program.initialStaticContext
  accepted_currentSolidCore :
    SolidCoreYulCore.FullYul.CompilerAcceptedStmt
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      program.stmtFuel.succ Solidity.Program.initialStaticContext
      false false stmt Solidity.Program.initialStaticContext
  eval_sound_with_coreFuel :
    SolidCoreYulCore.SymYul.evalStmtFuel sourceToCore.core.fuel
        Solidity.Body.initialSymYulConfig stmt =
      [SolidCoreYulCore.SymYul.normalResult program.finalSymYulConfig]
  static_checked_with_coreFuel :
    SolidCoreYulCore.FullYul.checkStmtFuel sourceToCore.core.fuel.succ
