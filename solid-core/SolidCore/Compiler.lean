    · cases hCompile
      rfl
    · cases hCompile
  · cases hCompile

theorem compileSourceToCoreArtifact_map_core
    (source : String) :
    (compileSourceToCoreArtifact source).map
        (fun artifact => artifact.core) =
      compileToCore? source := by
  unfold compileSourceToCoreArtifact
  unfold compileToCore?
  split
  · split <;> simp_all
  · simp_all

def sourceToCoreArtifactView :
    ArtifactView String Solidity.Core.AcceptedProgram
      SourceToCoreArtifact where
  build := compileSourceToCoreArtifact
