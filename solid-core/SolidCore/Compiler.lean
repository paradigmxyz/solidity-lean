  cases op <;>
    simp [ArithOp.toFullYul, checkedAddReturnFullYul,
      checkedSubReturnFullYul, checkedMulReturnFullYul,
      checkedDivReturnFullYul, checkedModReturnFullYul,
      SolidCoreYulCore.SymYul.collectStmtFunctionDefs]

