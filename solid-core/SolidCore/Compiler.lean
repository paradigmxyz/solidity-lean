          ArithOp.add firstLhs firstRhs secondOp secondLhs secondRhs) =
      (ArithOp.evalAssignSeqThenLeaveFrom ArithOp.add state firstLhs firstRhs
        secondOp secondLhs secondRhs).toSymYulResults := by
  apply ArithOp.assignSeqThenLeaveToFullYul_correct_from_of_first
  simpa [ArithOp.assignThenLeaveFuel, ArithOp.assignFuel,
    ArithOp.assignToFullYul, ArithOp.evalAssignFrom] using
    checkedAddAssignFullYul_correct_from_fuel6 state firstLhs firstRhs

