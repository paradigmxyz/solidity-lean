      (op.evalAssignFrom state lhs rhs).toSymYulResults := by
  cases op <;>
    simp [ArithOp.assignFuel, ArithOp.assignToFullYul,
      ArithOp.evalAssignFrom, checkedAddAssignFullYul_correct_from,
      checkedSubAssignFullYul_correct_from,
