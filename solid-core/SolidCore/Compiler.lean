      compileSolidityToFullYulStmt source = none := by
  constructor
  · intro hArtifact
    have hMap := compileAnyStaticStmtArtifact_map_stmt source
    simpa [hArtifact] using hMap.symm
  · intro hStmt
    cases hArtifact : compileAnyStaticStmtArtifact source with
    | none => rfl
    | some artifact =>
        have hMap := compileAnyStaticStmtArtifact_map_stmt source
        rw [hArtifact, hStmt] at hMap
        cases hMap

theorem compileAnyStaticStmtArtifact_some_stmt_iff
    {source : String} {stmt : SolidCoreYulCore.FullYul.Stmt} :
    (∃ artifact,
      compileAnyStaticStmtArtifact source = some artifact ∧
      AnyStaticFullYulStmtArtifact.stmt artifact = stmt) ↔
      compileSolidityToFullYulStmt source = some stmt := by
  constructor
  · intro hArtifact
    rcases hArtifact with ⟨artifact, hArtifact, hStmt⟩
    have hMap := compileAnyStaticStmtArtifact_map_stmt source
    rw [hArtifact] at hMap
    simpa [hStmt] using hMap.symm
  · intro hCompile
    cases hArtifact : compileAnyStaticStmtArtifact source with
    | some artifact =>
        have hMap := compileAnyStaticStmtArtifact_map_stmt source
        rw [hArtifact, hCompile] at hMap
        cases hMap
        exact ⟨artifact, rfl, rfl⟩
    | none =>
        have hMap := compileAnyStaticStmtArtifact_map_stmt source
        rw [hArtifact, hCompile] at hMap
        cases hMap

