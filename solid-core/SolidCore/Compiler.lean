      program.eval.toSymYulResults
  static_checked :
    SolidCoreYulCore.FullYul.checkStmtFuel program.fuel.succ
        Solidity.Program.initialStaticContext false true stmt =
      some Solidity.Program.initialStaticContext
  compiler_emittable :
    SolidCoreYulCore.FullYul.CompilerEmittableStmt
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      stmt

def compileCheckedStaticStmtArtifact (source : String) :
    Option CheckedStaticFullYulStmtArtifact :=
  match compileCheckedSourceToTypedStmtArtifact source with
  | some sourceToTyped =>
      let typedToFullYul : CheckedTypedStmtFullYulArtifact :=
        { source := sourceToTyped.source
          typedStmt := sourceToTyped.typedStmt
          stmt := compileCheckedTypedStmtToFullYul sourceToTyped.typedStmt
          typed_compiled := sourceToTyped.compiled
          emitted := rfl
          compiled_via_typed := by
            simp [compileCheckedToFullYulViaTypedStmt,
              sourceToTyped.compiled, compileCheckedTypedStmtToFullYul] }
      some
        { source := sourceToTyped.source
          program := sourceToTyped.program
          typedStmt := sourceToTyped.typedStmt
          stmt := typedToFullYul.stmt
          sourceToTyped := sourceToTyped
          sourceToTyped_source := rfl
          sourceToTyped_program := rfl
          sourceToTyped_typedStmt := rfl
          sourceToTyped_emitted := by
            simp [typedToFullYul, compileCheckedTypedStmtToFullYul]
          typedToFullYul := typedToFullYul
          typedToFullYul_source := rfl
          typedToFullYul_typedStmt := rfl
          typedToFullYul_stmt := rfl
          parsed := sourceToTyped.parsed
          typed_compiled := sourceToTyped.compiled
          emitted_via_typed := typedToFullYul.emitted
          compiled_via_typed := typedToFullYul.compiled_via_typed
          compiled := by
            simp [compileCheckedToFullYul, compileCheckedToFullYulViaTypedStmt,
              sourceToTyped.compiled, typedToFullYul,
              compileCheckedTypedStmtToFullYul]
          eval_sound := by
            have hEval := sourceToTyped.fullYul_eval_sound
            simpa [sourceToTyped.elaborated, typedToFullYul,
              compileCheckedTypedStmtToFullYul,
              Solidity.Checked.Program.toTypedStmt_fuel,
              Solidity.Checked.Program.toTypedStmt_eval] using hEval
          static_checked := by
            have hStatic := sourceToTyped.fullYul_static_checked
            simpa [sourceToTyped.elaborated, typedToFullYul,
              compileCheckedTypedStmtToFullYul,
              Solidity.Checked.Program.toTypedStmt_fuel,
              Solidity.Checked.Program.toTypedStmt_toFullYul] using hStatic
          compiler_emittable := by
            simpa [typedToFullYul, compileCheckedTypedStmtToFullYul] using
              sourceToTyped.fullYul_compilerEmittable }
  | none => none

theorem compileCheckedStaticStmtArtifact_source
    {source : String} {artifact : CheckedStaticFullYulStmtArtifact}
    (hCompile :
      compileCheckedStaticStmtArtifact source = some artifact) :
    artifact.source = source := by
  unfold compileCheckedStaticStmtArtifact at hCompile
  cases hSourceToTyped :
      compileCheckedSourceToTypedStmtArtifact source with
  | some sourceToTyped =>
      simp [hSourceToTyped] at hCompile
      cases hCompile
      exact compileCheckedSourceToTypedStmtArtifact_source hSourceToTyped
  | none =>
      simp [hSourceToTyped] at hCompile

theorem compileCheckedStaticStmtArtifact_map_stmt
    (source : String) :
    (compileCheckedStaticStmtArtifact source).map
        (fun artifact => artifact.stmt) =
      compileCheckedToFullYul source := by
  unfold compileCheckedStaticStmtArtifact
  cases hSourceToTyped :
      compileCheckedSourceToTypedStmtArtifact source with
  | some sourceToTyped =>
      have hSource :=
        compileCheckedSourceToTypedStmtArtifact_source hSourceToTyped
      have hCompiled :
          compileCheckedToTypedStmt? source =
            some sourceToTyped.typedStmt := by
        simpa [hSource] using sourceToTyped.compiled
      simp [hSourceToTyped, compileCheckedToFullYul,
        compileCheckedToFullYulViaTypedStmt, hCompiled,
        compileCheckedTypedStmtToFullYul]
  | none =>
      have hMap :=
        compileCheckedSourceToTypedStmtArtifact_map_typedStmt source
      rw [hSourceToTyped] at hMap
      unfold compileCheckedToFullYul
      unfold compileCheckedToFullYulViaTypedStmt
      rw [← hMap]
      simp

theorem compileCheckedStaticStmtArtifact_isSome
    (source : String) :
    (compileCheckedStaticStmtArtifact source).isSome =
      (compileCheckedToFullYul source).isSome := by
  rw [← compileCheckedStaticStmtArtifact_map_stmt source]
  cases compileCheckedStaticStmtArtifact source <;> rfl

theorem compileCheckedStaticStmtArtifact_none_iff
    (source : String) :
    compileCheckedStaticStmtArtifact source = none ↔
      compileCheckedToFullYul source = none := by
  constructor
  · intro hArtifact
    have hMap := compileCheckedStaticStmtArtifact_map_stmt source
    simpa [hArtifact] using hMap.symm
  · intro hStmt
    cases hArtifact : compileCheckedStaticStmtArtifact source with
    | none => rfl
    | some artifact =>
        have hMap := compileCheckedStaticStmtArtifact_map_stmt source
        rw [hArtifact, hStmt] at hMap
        cases hMap

theorem compileCheckedStaticStmtArtifact_some_stmt_iff
    {source : String} {stmt : SolidCoreYulCore.FullYul.Stmt} :
    (∃ artifact,
      compileCheckedStaticStmtArtifact source = some artifact ∧
      artifact.stmt = stmt) ↔
      compileCheckedToFullYul source = some stmt := by
  constructor
  · intro hArtifact
    rcases hArtifact with ⟨artifact, hArtifact, hStmt⟩
    have hMap := compileCheckedStaticStmtArtifact_map_stmt source
    rw [hArtifact] at hMap
    simpa [hStmt] using hMap.symm
  · intro hCompile
    cases hArtifact : compileCheckedStaticStmtArtifact source with
    | some artifact =>
        have hMap := compileCheckedStaticStmtArtifact_map_stmt source
        rw [hArtifact, hCompile] at hMap
        cases hMap
        exact ⟨artifact, rfl, rfl⟩
    | none =>
        have hMap := compileCheckedStaticStmtArtifact_map_stmt source
        rw [hArtifact, hCompile] at hMap
        cases hMap

theorem CheckedStaticFullYulStmtArtifact.sourceToTyped_sound
    (artifact : CheckedStaticFullYulStmtArtifact) :
    parseChecked artifact.source = some artifact.program ∧
    artifact.typedStmt = artifact.program.toTypedStmt ∧
    compileCheckedToTypedStmt? artifact.source =
      some artifact.typedStmt ∧
    artifact.typedStmt.toFullYul = artifact.stmt := by
  exact ⟨artifact.parsed,
    by
      simpa [artifact.sourceToTyped_program,
        artifact.sourceToTyped_typedStmt] using
          artifact.sourceToTyped.elaborated,
    by
      simpa [artifact.sourceToTyped_source,
        artifact.sourceToTyped_typedStmt] using
          artifact.sourceToTyped.compiled,
    by simpa [artifact.sourceToTyped_typedStmt] using
      artifact.sourceToTyped_emitted⟩

theorem CheckedStaticFullYulStmtArtifact.typedToFullYul_sound
    (artifact : CheckedStaticFullYulStmtArtifact) :
    artifact.typedToFullYul.source = artifact.sourceToTyped.source ∧
    artifact.typedToFullYul.typedStmt = artifact.typedStmt ∧
    artifact.typedToFullYul.stmt = artifact.stmt ∧
    compileCheckedToTypedStmt? artifact.typedToFullYul.source =
      some artifact.typedToFullYul.typedStmt ∧
    compileCheckedTypedStmtToFullYul artifact.typedToFullYul.typedStmt =
      artifact.typedToFullYul.stmt ∧
    compileCheckedToFullYulViaTypedStmt artifact.typedToFullYul.source =
      some artifact.typedToFullYul.stmt := by
  exact ⟨artifact.typedToFullYul_source,
    artifact.typedToFullYul_typedStmt,
    artifact.typedToFullYul_stmt,
    artifact.typedToFullYul.typed_compiled,
    artifact.typedToFullYul.emitted,
    artifact.typedToFullYul.compiled_via_typed⟩

theorem CheckedStaticFullYulStmtArtifact.sound_viaTypedStmt
    (artifact : CheckedStaticFullYulStmtArtifact) :
    compileCheckedToTypedStmt? artifact.source = some artifact.typedStmt ∧
    compileCheckedTypedStmtToFullYul artifact.typedStmt = artifact.stmt ∧
    compileCheckedToFullYulViaTypedStmt artifact.source =
      some artifact.stmt ∧
    compileCheckedToFullYul artifact.source = some artifact.stmt ∧
    SolidCoreYulCore.SymYul.evalStmtFuel artifact.program.fuel
        (Solidity.Core.State.toConfig { returnValue := 0 }) artifact.stmt =
      artifact.program.eval.toSymYulResults ∧
    SolidCoreYulCore.FullYul.checkStmtFuel artifact.program.fuel.succ
        Solidity.Program.initialStaticContext false true artifact.stmt =
      some Solidity.Program.initialStaticContext ∧
    SolidCoreYulCore.FullYul.CompilerEmittableStmt
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      artifact.stmt := by
  exact ⟨artifact.typed_compiled, artifact.emitted_via_typed,
    artifact.compiled_via_typed, artifact.compiled, artifact.eval_sound,
    artifact.static_checked, artifact.compiler_emittable⟩

theorem CheckedStaticFullYulStmtArtifact.accepted_currentSolidCore
    (artifact : CheckedStaticFullYulStmtArtifact) :
    SolidCoreYulCore.FullYul.CompilerAcceptedStmt
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      artifact.program.fuel.succ Solidity.Program.initialStaticContext
      false true artifact.stmt Solidity.Program.initialStaticContext := by
  exact
    { emittable := artifact.compiler_emittable
      checked := artifact.static_checked }

theorem compileCheckedStaticStmtArtifact_sound
    {source : String} {artifact : CheckedStaticFullYulStmtArtifact}
    (_hCompile : compileCheckedStaticStmtArtifact source = some artifact) :
    compileCheckedToFullYul artifact.source = some artifact.stmt ∧
    SolidCoreYulCore.SymYul.evalStmtFuel artifact.program.fuel
        (Solidity.Core.State.toConfig { returnValue := 0 }) artifact.stmt =
      artifact.program.eval.toSymYulResults ∧
    SolidCoreYulCore.FullYul.checkStmtFuel artifact.program.fuel.succ
        Solidity.Program.initialStaticContext false true artifact.stmt =
      some Solidity.Program.initialStaticContext ∧
    SolidCoreYulCore.FullYul.CompilerEmittableStmt
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      artifact.stmt := by
  exact ⟨artifact.compiled, artifact.eval_sound, artifact.static_checked,
    artifact.compiler_emittable⟩

theorem compileCheckedStaticStmtArtifact_sourceToTyped_sound
    {source : String} {artifact : CheckedStaticFullYulStmtArtifact}
    (_hCompile : compileCheckedStaticStmtArtifact source = some artifact) :
    parseChecked artifact.source = some artifact.program ∧
    artifact.typedStmt = artifact.program.toTypedStmt ∧
    compileCheckedToTypedStmt? artifact.source =
      some artifact.typedStmt ∧
    artifact.typedStmt.toFullYul = artifact.stmt ∧
    SolidCoreYulCore.SymYul.evalStmtFuel artifact.typedStmt.fuel
        (Solidity.Core.State.toConfig { returnValue := 0 }) artifact.stmt =
      artifact.typedStmt.eval.toSymYulResults ∧
    SolidCoreYulCore.FullYul.checkStmtFuel artifact.typedStmt.fuel.succ
        Solidity.Program.initialStaticContext false true artifact.stmt =
      some Solidity.Program.initialStaticContext ∧
    SolidCoreYulCore.FullYul.CompilerAcceptedStmt
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      artifact.typedStmt.fuel.succ Solidity.Program.initialStaticContext
      false true artifact.stmt Solidity.Program.initialStaticContext := by
  rcases artifact.sourceToTyped_sound with
    ⟨hParse, hElab, hCompiled, hEmit⟩
  exact ⟨hParse, hElab, hCompiled, hEmit,
    by
      simpa [artifact.sourceToTyped_typedStmt, hEmit] using
        artifact.sourceToTyped.fullYul_eval_sound,
    by
      simpa [artifact.sourceToTyped_typedStmt, hEmit] using
        artifact.sourceToTyped.fullYul_static_checked,
    by
      simpa [artifact.sourceToTyped_typedStmt, hEmit] using
      artifact.sourceToTyped.fullYul_accepted_currentSolidCore⟩

theorem compileCheckedStaticStmtArtifact_typedToFullYul_sound
    {source : String} {artifact : CheckedStaticFullYulStmtArtifact}
    (_hCompile : compileCheckedStaticStmtArtifact source = some artifact) :
    artifact.typedToFullYul.source = artifact.sourceToTyped.source ∧
    artifact.typedToFullYul.typedStmt = artifact.typedStmt ∧
    artifact.typedToFullYul.stmt = artifact.stmt ∧
    compileCheckedToTypedStmt? artifact.typedToFullYul.source =
      some artifact.typedToFullYul.typedStmt ∧
    compileCheckedTypedStmtToFullYul artifact.typedToFullYul.typedStmt =
      artifact.typedToFullYul.stmt ∧
    compileCheckedToFullYulViaTypedStmt artifact.typedToFullYul.source =
      some artifact.typedToFullYul.stmt := by
  exact artifact.typedToFullYul_sound

theorem compileCheckedStaticStmtArtifact_typedToFullYul_api
    {source : String} {artifact : CheckedStaticFullYulStmtArtifact}
    (_hCompile : compileCheckedStaticStmtArtifact source = some artifact) :
    ∃ typedArtifact,
      compileCheckedTypedStmtFullYulArtifact artifact.sourceToTyped.source =
        some typedArtifact ∧
      typedArtifact.typedStmt = artifact.typedStmt ∧
      typedArtifact.stmt = artifact.stmt := by
  have hViaTyped :
      compileCheckedToFullYulViaTypedStmt artifact.sourceToTyped.source =
        some artifact.stmt := by
    simpa [artifact.typedToFullYul_source, artifact.typedToFullYul_stmt] using
      artifact.typedToFullYul.compiled_via_typed
  rcases
    (compileCheckedTypedStmtFullYulArtifact_some_stmt_iff
      (source := artifact.sourceToTyped.source)
      (stmt := artifact.stmt)).mpr hViaTyped with
    ⟨typedArtifact, hTypedArtifact, hStmt⟩
  have hCompiled :
      compileCheckedToTypedStmt? artifact.sourceToTyped.source =
        some artifact.typedStmt := by
    simpa [artifact.sourceToTyped_typedStmt] using
      artifact.sourceToTyped.compiled
  have hMap :=
    compileCheckedTypedStmtFullYulArtifact_map_typedStmt
      artifact.sourceToTyped.source
  rw [hTypedArtifact, hCompiled] at hMap
  exact ⟨typedArtifact, hTypedArtifact, Option.some.inj hMap, hStmt⟩

