  | Program.internalStoragePairArgReturnCall => SolidCoreYulCore.addWord 4 6
  | Program.internalStorageReadUpdateCall => SolidCoreYulCore.addWord 4 6
  | Program.internalStorageConditionalCall => SolidCoreYulCore.norm 8
  | Program.internalStorageConditionalFalseCall => SolidCoreYulCore.norm 3
  | Program.nestedInternalStorageCall => SolidCoreYulCore.norm 7

