def parse (source : String) : Option Solidity.Program :=
  if source = returnFortyTwoSource then
    some returnFortyTwo
  else if source = returnSevenSource then
    some returnSeven
  else if source = returnComparisonSource then
    some returnComparison
  else if source = sequencedReturnSource then
    some sequencedReturn
  else if source = conditionalReturnSource then
    some conditionalReturn
  else if source = negatedConditionalReturnSource then
    some negatedConditionalReturn
  else if source = boundaryComparisonSource then
    some boundaryComparison
  else if source = bitwiseSource then
    some bitwise
  else if source = shiftsSource then
    some shifts
  else if source = signedComparisonSource then
    some signedComparison
  else if source = signedShiftSource then
    some signedShift
  else if source = exponentSource then
    some exponent
  else if source = modularArithmeticSource then
    some modularArithmetic
  else if source = byteExtractionSource then
    some byteExtraction
  else if source = notEqualSource then
    some notEqual
  else if source = booleanConnectiveSource then
    some booleanConnective
  else if source = signedDivModSource then
    some signedDivMod
  else if source = signedBoundaryComparisonSource then
    some signedBoundaryComparison
  else if source = unaryNegationSource then
    some unaryNegation
  else if source = blockReturnSource then
    some blockReturn
  else if source = nestedThenBranchSource then
    some nestedThenBranch
  else if source = localValueSource then
    some localValue
  else if source = localUpdateValueSource then
    some localUpdateValue
  else if source = localPairAddReturnSource then
    some localPairAddReturn
  else if source = localPairUpdateAddValueSource then
    some localPairUpdateAddValue
  else if source = nestedElseBranchSource then
    some nestedElseBranch
  else if source = forNeverReturnSource then
    some forNeverReturn
  else if source = forBreakReturnSource then
    some forBreakReturn
  else if source = forContinueReturnSource then
    some forContinueReturn
  else if source = internalCallReturnSource then
    some internalCallReturn
  else if source = internalCallArgReturnSource then
    some internalCallArgReturn
  else if source = internalCallMultiReturnSource then
    some internalCallMultiReturn
  else if source = storageWriteReadSource then
    some storageWriteRead
  else if source = storageOverwriteReadSource then
    some storageOverwriteRead
  else if source = storagePairReadAddSource then
    some storagePairReadAdd
  else if source = storageIfWriteReadSource then
    some storageIfWriteRead
  else if source = storageIfFalseWriteReadSource then
    some storageIfFalseWriteRead
  else if source = internalStorageCallSource then
    some internalStorageCall
  else if source = internalStorageArgCallSource then
    some internalStorageArgCall
  else if source = internalStorageArgReturnCallSource then
    some internalStorageArgReturnCall
  else if source = internalStoragePairArgReturnCallSource then
    some internalStoragePairArgReturnCall
  else if source = internalStorageReadUpdateCallSource then
    some internalStorageReadUpdateCall
  else if source = internalStorageConditionalCallSource then
    some internalStorageConditionalCall
  else if source = internalStorageConditionalFalseCallSource then
    some internalStorageConditionalFalseCall
  else if source = nestedInternalStorageCallSource then
    some nestedInternalStorageCall
  else if source = parsedReturnLiteralSource then
    some parsedReturnLiteral
  else
    match parseGeneratedIfElseReturn? source with
    | some program => some program
    | none =>
        match parseGeneratedLocalUpdateValue? source with
        | some program => some program
        | none =>
            match parseGeneratedLocalPairUpdateAddValue? source with
            | some program => some program
            | none =>
                match parseGeneratedLocalPairAddReturn? source with
                | some program => some program
                | none =>
                    match parseGeneratedLocalValue? source with
                    | some program => some program
                    | none => parseGeneratedReturn? source

def compileToCore? (source : String) :
    Option Solidity.Core.AcceptedProgram :=
  match parse source with
  | some program => program.toCore?
  | none => none

def compileCoreToFullYulStmt
    (core : Solidity.Core.AcceptedProgram) :
    SolidCoreYulCore.FullYul.Stmt :=
  core.toFullYul

def compileToFullYulStmtViaCore (source : String) :
    Option SolidCoreYulCore.FullYul.Stmt :=
  (compileToCore? source).map compileCoreToFullYulStmt

def compileToFullYulStmt (source : String) :
    Option SolidCoreYulCore.FullYul.Stmt :=
  compileToFullYulStmtViaCore source

theorem compileToFullYulStmt_eq_viaCore (source : String) :
    compileToFullYulStmt source = compileToFullYulStmtViaCore source := by
  rfl

theorem compileToFullYulStmt_some_core
    {source : String} {stmt : SolidCoreYulCore.FullYul.Stmt}
    (hCompile : compileToFullYulStmt source = some stmt) :
    ∃ program core,
      parse source = some program ∧
      program.toCore? = some core ∧
      stmt = core.toFullYul := by
  unfold compileToFullYulStmt at hCompile
  unfold compileToFullYulStmtViaCore at hCompile
  unfold compileToCore? at hCompile
  cases hParse : parse source with
  | none =>
      simp [hParse] at hCompile
  | some program =>
      cases hCore : program.toCore? with
      | none =>
          simp [hParse, hCore] at hCompile
      | some core =>
          simp [hParse, hCore, compileCoreToFullYulStmt] at hCompile
          cases hCompile
          exact ⟨program, core, rfl, hCore, rfl⟩

