theorem Stmt.predeclare_toFullYul
    (ctx : SolidCoreYulCore.FullYul.StaticContext) (stmt : Stmt) :
    SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?
        ctx stmt.toFullYul =
      some ctx := by
  induction stmt generalizing ctx with
  | skip => rfl
  | expr _ => rfl
  | returnExpr _ => rfl
  | seq first second first_ih second_ih =>
      simp [Stmt.toFullYul,
        SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?,
        first_ih, second_ih]
  | block body _ =>
      simp [Stmt.toFullYul,
        SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?]
  | ifThen _ _ _ =>
      simp [Stmt.toFullYul,
        SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?]
  | forFalse _ _ =>
      simp [Stmt.toFullYul,
        SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?]
  | forOnce body body_ih =>
      simp [Stmt.toFullYul,
        SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?,
        body_ih]
  | forIf _ body body_ih =>
      simp [Stmt.toFullYul,
        SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?,
        body_ih]

theorem Stmt.bodyThenBreakFullYul_staticChecked_from
    (extraFuel : Nat) (body : Stmt)
    (hBody :
      SolidCoreYulCore.FullYul.checkStmtFuel
          (body.fuel + (extraFuel + 1) + 1)
          Program.initialStaticContext true true body.toFullYul =
        some Program.initialStaticContext) :
    SolidCoreYulCore.FullYul.checkStmtFuel
        (body.fuel + (extraFuel + 2) + 1)
        Program.initialStaticContext true true
        (Stmt.bodyThenBreakFullYul body.toFullYul) =
      some Program.initialStaticContext := by
  have hBody' :
      SolidCoreYulCore.FullYul.checkStmtFuel
          (body.fuel + (extraFuel + 2))
          Program.initialStaticContext true true body.toFullYul =
        some Program.initialStaticContext := by
    rw [show body.fuel + (extraFuel + 2) =
        body.fuel + (extraFuel + 1) + 1 by omega]
    exact hBody
  have hBreak :
      SolidCoreYulCore.FullYul.checkStmtFuel
          (body.fuel + (extraFuel + 1) + 1)
          Program.initialStaticContext true true
          SolidCoreYulCore.FullYul.Stmt.break =
        some Program.initialStaticContext := by
    rw [show body.fuel + (extraFuel + 1) + 1 =
        (body.fuel + extraFuel + 1) + 1 by omega]
    cases body.fuel + extraFuel + 1 <;> rfl
  have hBreak' :
      SolidCoreYulCore.FullYul.checkStmtFuel
          (body.fuel + (extraFuel + 2))
          Program.initialStaticContext true true
          SolidCoreYulCore.FullYul.Stmt.break =
        some Program.initialStaticContext := by
    rw [show body.fuel + (extraFuel + 2) =
        body.fuel + (extraFuel + 1) + 1 by omega]
    exact hBreak
  simp [Stmt.bodyThenBreakFullYul,
    SolidCoreYulCore.FullYul.checkStmtFuel,
    SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?,
    Stmt.predeclare_toFullYul, hBody', hBreak']

theorem Stmt.singleIterationLoopFullYul_staticChecked_from
    (extraFuel : Nat) (cond : SolidCoreYulCore.FullYul.Expr) (body : Stmt)
    (hCond :
      SolidCoreYulCore.FullYul.checkExpr Program.initialStaticContext cond =
        true)
    (hBody :
      SolidCoreYulCore.FullYul.checkStmtFuel
          (body.fuel + (extraFuel + 1) + 1)
          Program.initialStaticContext true true body.toFullYul =
        some Program.initialStaticContext) :
    SolidCoreYulCore.FullYul.checkStmtFuel
        (body.fuel + 3 + extraFuel + 1)
        Program.initialStaticContext false true
        (Stmt.singleIterationLoopFullYul cond body.toFullYul) =
      some Program.initialStaticContext := by
  rw [show body.fuel + 3 + extraFuel + 1 =
      body.fuel + (extraFuel + 2) + 1 + 1 by omega]
  have hSkip :
      SolidCoreYulCore.FullYul.checkStmtFuel
          (body.fuel + (extraFuel + 2) + 1)
          Program.initialStaticContext false true
          SolidCoreYulCore.FullYul.Stmt.skip =
        some Program.initialStaticContext := by
    rw [show body.fuel + (extraFuel + 2) + 1 =
        (body.fuel + extraFuel + 2) + 1 by omega]
    cases body.fuel + extraFuel + 2 <;> rfl
  have hBodyBreak :
      SolidCoreYulCore.FullYul.checkStmtFuel
          (body.fuel + (extraFuel + 2) + 1)
          Program.initialStaticContext true true
          (Stmt.bodyThenBreakFullYul body.toFullYul) =
        some Program.initialStaticContext :=
    Stmt.bodyThenBreakFullYul_staticChecked_from extraFuel body hBody
  simp [Stmt.bodyThenBreakFullYul,
    SolidCoreYulCore.FullYul.checkStmtFuel,
    SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?,
    Stmt.predeclare_toFullYul] at hBodyBreak
  simp [Stmt.singleIterationLoopFullYul,
    SolidCoreYulCore.FullYul.checkStmtFuel,
    SolidCoreYulCore.FullYul.stmtHasNoFunDefs,
    SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?,
    Stmt.predeclare_toFullYul, hSkip, hCond, hBodyBreak]

theorem Stmt.toFullYul_staticChecked_from_inLoop
    (extraFuel : Nat) (inLoop : Bool) (stmt : Stmt) :
    SolidCoreYulCore.FullYul.checkStmtFuel
        (stmt.fuel + extraFuel + 1)
        Program.initialStaticContext inLoop true
        stmt.toFullYul =
      some Program.initialStaticContext := by
  induction stmt generalizing extraFuel inLoop with
  | skip =>
      cases extraFuel <;> rfl
  | expr _ =>
      cases extraFuel <;> rfl
  | returnExpr expr =>
      cases extraFuel <;>
        simp [Stmt.fuel, Stmt.toFullYul, Program.initialStaticContext,
          returnName, SolidCoreYulCore.FullYul.checkStmtFuel,
          SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?,
          SolidCoreYulCore.FullYul.containsName,
          Expr.toFullYul_staticChecked]
  | seq first second first_ih second_ih =>
      simp only [Stmt.fuel, Stmt.toFullYul]
      rw [show first.fuel + second.fuel + 1 + extraFuel =
          first.fuel + second.fuel + extraFuel + 1 by omega]
      simp [SolidCoreYulCore.FullYul.checkStmtFuel,
        SolidCoreYulCore.FullYul.checkStmtFuel,
        SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?,
        Stmt.predeclare_toFullYul]
      rw [show first.fuel + second.fuel + extraFuel + 1 =
          first.fuel + (second.fuel + extraFuel) + 1 by omega]
      rw [first_ih (second.fuel + extraFuel) inLoop]
      simp
      rw [show first.fuel + (second.fuel + extraFuel) + 1 =
          second.fuel + (first.fuel + extraFuel) + 1 by omega]
      exact second_ih (first.fuel + extraFuel) inLoop
  | block body body_ih =>
      simp [Stmt.fuel, Stmt.toFullYul,
        SolidCoreYulCore.FullYul.checkStmtFuel,
        SolidCoreYulCore.FullYul.predeclareBlockFunctionSigs?,
        Stmt.predeclare_toFullYul]
      rw [show body.fuel + 2 + extraFuel =
          (body.fuel + 1 + extraFuel) + 1 by omega]
      simp [SolidCoreYulCore.FullYul.checkBlockFuel]
      rw [show body.fuel + 1 + extraFuel =
          body.fuel + extraFuel + 1 by omega]
      rw [body_ih extraFuel inLoop]
      simp
      rw [show body.fuel + extraFuel + 1 =
          (body.fuel + extraFuel) + 1 by omega]
      rfl
  | ifThen _ body body_ih =>
      simp [Stmt.fuel, Stmt.toFullYul,
        SolidCoreYulCore.FullYul.checkStmtFuel,
        Expr.toFullYul_staticChecked]
      rw [show body.fuel + 1 + extraFuel =
          body.fuel + extraFuel + 1 by omega]
      rw [body_ih extraFuel inLoop]
  | forFalse body body_ih =>
      simp only [Stmt.fuel, Stmt.toFullYul]
      rw [show body.fuel + 1 + extraFuel + 1 =
          body.fuel + extraFuel + 1 + 1 by omega]
      have hSkip :
          SolidCoreYulCore.FullYul.checkStmtFuel
              (body.fuel + extraFuel + 1)
              Program.initialStaticContext false true
              SolidCoreYulCore.FullYul.Stmt.skip =
            some Program.initialStaticContext := by
        rw [show body.fuel + extraFuel + 1 =
            (body.fuel + extraFuel) + 1 by omega]
        cases body.fuel + extraFuel <;> rfl
      have hBody := body_ih extraFuel true
      simp [SolidCoreYulCore.FullYul.checkStmtFuel,
        SolidCoreYulCore.FullYul.stmtHasNoFunDefs,
        SolidCoreYulCore.FullYul.checkExpr, hSkip, hBody]
  | forOnce body body_ih =>
      have hBody := body_ih (extraFuel + 1) true
      have hLoop :=
        Stmt.singleIterationLoopFullYul_staticChecked_from
          extraFuel
          (SolidCoreYulCore.FullYul.Expr.value
            (SolidCoreYulCore.FullYul.Value.word 1))
          body (by rfl) hBody
      simpa [Stmt.fuel, Stmt.toFullYul] using hLoop
  | forIf cond body body_ih =>
      have hBody := body_ih (extraFuel + 1) true
      have hLoop :=
        Stmt.singleIterationLoopFullYul_staticChecked_from
          extraFuel cond.toFullYul body
          (Expr.toFullYul_staticChecked Program.initialStaticContext cond)
          hBody
      simpa [Stmt.fuel, Stmt.toFullYul] using hLoop

