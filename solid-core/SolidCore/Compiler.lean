        LocalFrame2.fuel] using
        LocalFrame2.toFullYul_staticChecked
          (LocalFrame2.addReturn lhs rhs)
    | Stmt.localPairUpdateAddValue initLhs initRhs assignedLhs assignedRhs =>
      simpa [Stmt.fuel, Stmt.toFullYul, Stmt.localPairUpdateAddValueFullYul,
