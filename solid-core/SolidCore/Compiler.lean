def PureExpr.eval : PureExpr -> Word
  | PureExpr.lit value => SolidCoreYulCore.norm value
  | PureExpr.neg expr => SolidCoreYulCore.subWord 0 expr.eval
  | PureExpr.add lhs rhs => SolidCoreYulCore.addWord lhs.eval rhs.eval
  | PureExpr.sub lhs rhs => SolidCoreYulCore.subWord lhs.eval rhs.eval
  | PureExpr.mul lhs rhs => SolidCoreYulCore.mulWord lhs.eval rhs.eval
  | PureExpr.exp lhs rhs => SolidCoreYulCore.expWord lhs.eval rhs.eval
  | PureExpr.div lhs rhs => SolidCoreYulCore.divWord lhs.eval rhs.eval
  | PureExpr.mod lhs rhs => SolidCoreYulCore.modWord lhs.eval rhs.eval
  | PureExpr.signedDiv lhs rhs => SolidCoreYulCore.sdivWord lhs.eval rhs.eval
  | PureExpr.signedMod lhs rhs => SolidCoreYulCore.smodWord lhs.eval rhs.eval
  | PureExpr.eq lhs rhs => SolidCoreYulCore.eqWord lhs.eval rhs.eval
  | PureExpr.ne lhs rhs =>
      SolidCoreYulCore.iszeroWord (SolidCoreYulCore.eqWord lhs.eval rhs.eval)
  | PureExpr.lt lhs rhs => SolidCoreYulCore.ltWord lhs.eval rhs.eval
  | PureExpr.gt lhs rhs => SolidCoreYulCore.gtWord lhs.eval rhs.eval
  | PureExpr.le lhs rhs =>
      SolidCoreYulCore.iszeroWord (SolidCoreYulCore.gtWord lhs.eval rhs.eval)
  | PureExpr.ge lhs rhs =>
      SolidCoreYulCore.iszeroWord (SolidCoreYulCore.ltWord lhs.eval rhs.eval)
  | PureExpr.signedLt lhs rhs => SolidCoreYulCore.sltWord lhs.eval rhs.eval
  | PureExpr.signedGt lhs rhs => SolidCoreYulCore.sgtWord lhs.eval rhs.eval
  | PureExpr.signedLe lhs rhs =>
      SolidCoreYulCore.iszeroWord (SolidCoreYulCore.sgtWord lhs.eval rhs.eval)
  | PureExpr.signedGe lhs rhs =>
      SolidCoreYulCore.iszeroWord (SolidCoreYulCore.sltWord lhs.eval rhs.eval)
  | PureExpr.iszero expr => SolidCoreYulCore.iszeroWord expr.eval
  | PureExpr.boolAnd lhs rhs =>
      SolidCoreYulCore.iszeroWord
        (SolidCoreYulCore.orWord
          (SolidCoreYulCore.iszeroWord lhs.eval)
          (SolidCoreYulCore.iszeroWord rhs.eval))
  | PureExpr.boolOr lhs rhs =>
      SolidCoreYulCore.iszeroWord
        (SolidCoreYulCore.andWord
          (SolidCoreYulCore.iszeroWord lhs.eval)
          (SolidCoreYulCore.iszeroWord rhs.eval))
  | PureExpr.bitAnd lhs rhs => SolidCoreYulCore.andWord lhs.eval rhs.eval
  | PureExpr.bitOr lhs rhs => SolidCoreYulCore.orWord lhs.eval rhs.eval
  | PureExpr.bitXor lhs rhs => SolidCoreYulCore.xorWord lhs.eval rhs.eval
  | PureExpr.bitNot expr => SolidCoreYulCore.notWord expr.eval
  | PureExpr.shl value shift => SolidCoreYulCore.shlWord shift.eval value.eval
  | PureExpr.shr value shift => SolidCoreYulCore.shrWord shift.eval value.eval
  | PureExpr.sar value shift => SolidCoreYulCore.sarWord shift.eval value.eval
  | PureExpr.byteAt index value => SolidCoreYulCore.byteWord index.eval value.eval
  | PureExpr.addmod lhs rhs modulus =>
      SolidCoreYulCore.addmodWord lhs.eval rhs.eval modulus.eval
  | PureExpr.mulmod lhs rhs modulus =>
      SolidCoreYulCore.mulmodWord lhs.eval rhs.eval modulus.eval

def PureExpr.toExpr : PureExpr -> Expr
  | PureExpr.lit value => Expr.lit value
  | PureExpr.neg expr => Expr.neg expr.toExpr
  | PureExpr.add lhs rhs => Expr.add lhs.toExpr rhs.toExpr
  | PureExpr.sub lhs rhs => Expr.sub lhs.toExpr rhs.toExpr
  | PureExpr.mul lhs rhs => Expr.mul lhs.toExpr rhs.toExpr
  | PureExpr.exp lhs rhs => Expr.exp lhs.toExpr rhs.toExpr
  | PureExpr.div lhs rhs => Expr.div lhs.toExpr rhs.toExpr
  | PureExpr.mod lhs rhs => Expr.mod lhs.toExpr rhs.toExpr
  | PureExpr.signedDiv lhs rhs => Expr.signedDiv lhs.toExpr rhs.toExpr
  | PureExpr.signedMod lhs rhs => Expr.signedMod lhs.toExpr rhs.toExpr
  | PureExpr.eq lhs rhs => Expr.eq lhs.toExpr rhs.toExpr
  | PureExpr.ne lhs rhs => Expr.ne lhs.toExpr rhs.toExpr
  | PureExpr.lt lhs rhs => Expr.lt lhs.toExpr rhs.toExpr
  | PureExpr.gt lhs rhs => Expr.gt lhs.toExpr rhs.toExpr
  | PureExpr.le lhs rhs => Expr.le lhs.toExpr rhs.toExpr
  | PureExpr.ge lhs rhs => Expr.ge lhs.toExpr rhs.toExpr
  | PureExpr.signedLt lhs rhs => Expr.signedLt lhs.toExpr rhs.toExpr
  | PureExpr.signedGt lhs rhs => Expr.signedGt lhs.toExpr rhs.toExpr
  | PureExpr.signedLe lhs rhs => Expr.signedLe lhs.toExpr rhs.toExpr
  | PureExpr.signedGe lhs rhs => Expr.signedGe lhs.toExpr rhs.toExpr
  | PureExpr.iszero expr => Expr.iszero expr.toExpr
  | PureExpr.boolAnd lhs rhs => Expr.boolAnd lhs.toExpr rhs.toExpr
  | PureExpr.boolOr lhs rhs => Expr.boolOr lhs.toExpr rhs.toExpr
  | PureExpr.bitAnd lhs rhs => Expr.bitAnd lhs.toExpr rhs.toExpr
  | PureExpr.bitOr lhs rhs => Expr.bitOr lhs.toExpr rhs.toExpr
  | PureExpr.bitXor lhs rhs => Expr.bitXor lhs.toExpr rhs.toExpr
  | PureExpr.bitNot expr => Expr.bitNot expr.toExpr
  | PureExpr.shl value shift => Expr.shl value.toExpr shift.toExpr
  | PureExpr.shr value shift => Expr.shr value.toExpr shift.toExpr
  | PureExpr.sar value shift => Expr.sar value.toExpr shift.toExpr
  | PureExpr.byteAt index value => Expr.byteAt index.toExpr value.toExpr
  | PureExpr.addmod lhs rhs modulus =>
      Expr.addmod lhs.toExpr rhs.toExpr modulus.toExpr
  | PureExpr.mulmod lhs rhs modulus =>
      Expr.mulmod lhs.toExpr rhs.toExpr modulus.toExpr

theorem PureExpr.toExpr_eval (expr : PureExpr) :
    expr.toExpr.eval = expr.eval := by
  induction expr with
  | lit _ => rfl
  | neg expr expr_ih =>
      simp [PureExpr.toExpr, PureExpr.eval, Expr.eval, expr_ih]
  | add lhs rhs lhs_ih rhs_ih =>
      simp [PureExpr.toExpr, PureExpr.eval, Expr.eval, lhs_ih, rhs_ih]
  | sub lhs rhs lhs_ih rhs_ih =>
      simp [PureExpr.toExpr, PureExpr.eval, Expr.eval, lhs_ih, rhs_ih]
  | mul lhs rhs lhs_ih rhs_ih =>
      simp [PureExpr.toExpr, PureExpr.eval, Expr.eval, lhs_ih, rhs_ih]
  | exp lhs rhs lhs_ih rhs_ih =>
      simp [PureExpr.toExpr, PureExpr.eval, Expr.eval, lhs_ih, rhs_ih]
  | div lhs rhs lhs_ih rhs_ih =>
      simp [PureExpr.toExpr, PureExpr.eval, Expr.eval, lhs_ih, rhs_ih]
  | mod lhs rhs lhs_ih rhs_ih =>
      simp [PureExpr.toExpr, PureExpr.eval, Expr.eval, lhs_ih, rhs_ih]
  | signedDiv lhs rhs lhs_ih rhs_ih =>
      simp [PureExpr.toExpr, PureExpr.eval, Expr.eval, lhs_ih, rhs_ih]
  | signedMod lhs rhs lhs_ih rhs_ih =>
      simp [PureExpr.toExpr, PureExpr.eval, Expr.eval, lhs_ih, rhs_ih]
  | eq lhs rhs lhs_ih rhs_ih =>
      simp [PureExpr.toExpr, PureExpr.eval, Expr.eval, lhs_ih, rhs_ih]
  | ne lhs rhs lhs_ih rhs_ih =>
      simp [PureExpr.toExpr, PureExpr.eval, Expr.eval, lhs_ih, rhs_ih]
  | lt lhs rhs lhs_ih rhs_ih =>
      simp [PureExpr.toExpr, PureExpr.eval, Expr.eval, lhs_ih, rhs_ih]
  | gt lhs rhs lhs_ih rhs_ih =>
      simp [PureExpr.toExpr, PureExpr.eval, Expr.eval, lhs_ih, rhs_ih]
  | le lhs rhs lhs_ih rhs_ih =>
      simp [PureExpr.toExpr, PureExpr.eval, Expr.eval, lhs_ih, rhs_ih]
  | ge lhs rhs lhs_ih rhs_ih =>
      simp [PureExpr.toExpr, PureExpr.eval, Expr.eval, lhs_ih, rhs_ih]
  | signedLt lhs rhs lhs_ih rhs_ih =>
      simp [PureExpr.toExpr, PureExpr.eval, Expr.eval, lhs_ih, rhs_ih]
  | signedGt lhs rhs lhs_ih rhs_ih =>
      simp [PureExpr.toExpr, PureExpr.eval, Expr.eval, lhs_ih, rhs_ih]
  | signedLe lhs rhs lhs_ih rhs_ih =>
      simp [PureExpr.toExpr, PureExpr.eval, Expr.eval, lhs_ih, rhs_ih]
  | signedGe lhs rhs lhs_ih rhs_ih =>
      simp [PureExpr.toExpr, PureExpr.eval, Expr.eval, lhs_ih, rhs_ih]
  | iszero expr expr_ih =>
      simp [PureExpr.toExpr, PureExpr.eval, Expr.eval, expr_ih]
  | boolAnd lhs rhs lhs_ih rhs_ih =>
      simp [PureExpr.toExpr, PureExpr.eval, Expr.eval, lhs_ih, rhs_ih]
  | boolOr lhs rhs lhs_ih rhs_ih =>
      simp [PureExpr.toExpr, PureExpr.eval, Expr.eval, lhs_ih, rhs_ih]
  | bitAnd lhs rhs lhs_ih rhs_ih =>
      simp [PureExpr.toExpr, PureExpr.eval, Expr.eval, lhs_ih, rhs_ih]
  | bitOr lhs rhs lhs_ih rhs_ih =>
      simp [PureExpr.toExpr, PureExpr.eval, Expr.eval, lhs_ih, rhs_ih]
  | bitXor lhs rhs lhs_ih rhs_ih =>
      simp [PureExpr.toExpr, PureExpr.eval, Expr.eval, lhs_ih, rhs_ih]
  | bitNot expr expr_ih =>
      simp [PureExpr.toExpr, PureExpr.eval, Expr.eval, expr_ih]
  | shl value shift value_ih shift_ih =>
      simp [PureExpr.toExpr, PureExpr.eval, Expr.eval, value_ih, shift_ih]
  | shr value shift value_ih shift_ih =>
      simp [PureExpr.toExpr, PureExpr.eval, Expr.eval, value_ih, shift_ih]
  | sar value shift value_ih shift_ih =>
      simp [PureExpr.toExpr, PureExpr.eval, Expr.eval, value_ih, shift_ih]
  | byteAt index value index_ih value_ih =>
      simp [PureExpr.toExpr, PureExpr.eval, Expr.eval, index_ih, value_ih]
  | addmod lhs rhs modulus lhs_ih rhs_ih modulus_ih =>
      simp [PureExpr.toExpr, PureExpr.eval, Expr.eval,
        lhs_ih, rhs_ih, modulus_ih]
  | mulmod lhs rhs modulus lhs_ih rhs_ih modulus_ih =>
      simp [PureExpr.toExpr, PureExpr.eval, Expr.eval,
        lhs_ih, rhs_ih, modulus_ih]

def PureExpr.ofExpr : Expr -> PureExpr
  | Expr.lit value => PureExpr.lit value
  | Expr.neg expr => PureExpr.neg (PureExpr.ofExpr expr)
  | Expr.add lhs rhs => PureExpr.add (PureExpr.ofExpr lhs) (PureExpr.ofExpr rhs)
  | Expr.sub lhs rhs => PureExpr.sub (PureExpr.ofExpr lhs) (PureExpr.ofExpr rhs)
  | Expr.mul lhs rhs => PureExpr.mul (PureExpr.ofExpr lhs) (PureExpr.ofExpr rhs)
  | Expr.exp lhs rhs => PureExpr.exp (PureExpr.ofExpr lhs) (PureExpr.ofExpr rhs)
  | Expr.div lhs rhs => PureExpr.div (PureExpr.ofExpr lhs) (PureExpr.ofExpr rhs)
  | Expr.mod lhs rhs => PureExpr.mod (PureExpr.ofExpr lhs) (PureExpr.ofExpr rhs)
  | Expr.signedDiv lhs rhs =>
      PureExpr.signedDiv (PureExpr.ofExpr lhs) (PureExpr.ofExpr rhs)
  | Expr.signedMod lhs rhs =>
      PureExpr.signedMod (PureExpr.ofExpr lhs) (PureExpr.ofExpr rhs)
  | Expr.addmod lhs rhs modulus =>
      PureExpr.addmod (PureExpr.ofExpr lhs) (PureExpr.ofExpr rhs)
        (PureExpr.ofExpr modulus)
  | Expr.mulmod lhs rhs modulus =>
      PureExpr.mulmod (PureExpr.ofExpr lhs) (PureExpr.ofExpr rhs)
        (PureExpr.ofExpr modulus)
  | Expr.bitAnd lhs rhs =>
      PureExpr.bitAnd (PureExpr.ofExpr lhs) (PureExpr.ofExpr rhs)
  | Expr.bitOr lhs rhs =>
      PureExpr.bitOr (PureExpr.ofExpr lhs) (PureExpr.ofExpr rhs)
  | Expr.bitXor lhs rhs =>
      PureExpr.bitXor (PureExpr.ofExpr lhs) (PureExpr.ofExpr rhs)
  | Expr.bitNot expr => PureExpr.bitNot (PureExpr.ofExpr expr)
  | Expr.shl value shift =>
      PureExpr.shl (PureExpr.ofExpr value) (PureExpr.ofExpr shift)
  | Expr.shr value shift =>
      PureExpr.shr (PureExpr.ofExpr value) (PureExpr.ofExpr shift)
  | Expr.sar value shift =>
      PureExpr.sar (PureExpr.ofExpr value) (PureExpr.ofExpr shift)
  | Expr.byteAt index value =>
      PureExpr.byteAt (PureExpr.ofExpr index) (PureExpr.ofExpr value)
  | Expr.iszero expr => PureExpr.iszero (PureExpr.ofExpr expr)
  | Expr.boolAnd lhs rhs =>
      PureExpr.boolAnd (PureExpr.ofExpr lhs) (PureExpr.ofExpr rhs)
  | Expr.boolOr lhs rhs =>
      PureExpr.boolOr (PureExpr.ofExpr lhs) (PureExpr.ofExpr rhs)
  | Expr.eq lhs rhs => PureExpr.eq (PureExpr.ofExpr lhs) (PureExpr.ofExpr rhs)
  | Expr.ne lhs rhs => PureExpr.ne (PureExpr.ofExpr lhs) (PureExpr.ofExpr rhs)
  | Expr.lt lhs rhs => PureExpr.lt (PureExpr.ofExpr lhs) (PureExpr.ofExpr rhs)
  | Expr.gt lhs rhs => PureExpr.gt (PureExpr.ofExpr lhs) (PureExpr.ofExpr rhs)
  | Expr.le lhs rhs => PureExpr.le (PureExpr.ofExpr lhs) (PureExpr.ofExpr rhs)
  | Expr.ge lhs rhs => PureExpr.ge (PureExpr.ofExpr lhs) (PureExpr.ofExpr rhs)
  | Expr.signedLt lhs rhs =>
      PureExpr.signedLt (PureExpr.ofExpr lhs) (PureExpr.ofExpr rhs)
  | Expr.signedGt lhs rhs =>
      PureExpr.signedGt (PureExpr.ofExpr lhs) (PureExpr.ofExpr rhs)
  | Expr.signedLe lhs rhs =>
      PureExpr.signedLe (PureExpr.ofExpr lhs) (PureExpr.ofExpr rhs)
  | Expr.signedGe lhs rhs =>
      PureExpr.signedGe (PureExpr.ofExpr lhs) (PureExpr.ofExpr rhs)

@[simp] theorem PureExpr.toExpr_ofExpr (expr : Expr) :
    (PureExpr.ofExpr expr).toExpr = expr := by
  induction expr <;> simp [PureExpr.ofExpr, PureExpr.toExpr, *]

theorem PureExpr.toFullYul_staticChecked
    (ctx : SolidCoreYulCore.FullYul.StaticContext) (expr : PureExpr) :
    SolidCoreYulCore.FullYul.checkExpr ctx expr.toExpr.toFullYul = true :=
  Expr.toFullYul_staticChecked ctx expr.toExpr

theorem PureExpr.toFullYul_compilerEmittable (expr : PureExpr) :
    SolidCoreYulCore.FullYul.CompilerEmittableExpr
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      expr.toExpr.toFullYul :=
  Expr.toFullYul_compilerEmittable expr.toExpr

