def Program.toStorageCore? : Program -> Option Core.Storage.Stmt
  | Program.storageWriteRead => some Program.storageWriteReadCore
  | Program.storageOverwriteRead => some Program.storageOverwriteReadCore
  | Program.storagePairReadAdd => some Program.storagePairReadAddCore
  | Program.storageIfWriteRead => some Program.storageIfWriteReadCore
  | Program.storageIfFalseWriteRead => some Program.storageIfFalseWriteReadCore
  | _ => none

