    {source : String} {stmt : SolidCoreYulCore.FullYul.Stmt}
    (hCompile : compileCheckedToFullYul source = some stmt) :
    ∃ program,
      parseChecked source = some program ∧
      stmt = program.toFullYul ∧
      SolidCoreYulCore.SymYul.evalStmtFuel program.fuel
          (Solidity.Core.State.toConfig { returnValue := 0 }) stmt =
        program.eval.toSymYulResults := by
  unfold compileCheckedToFullYul at hCompile
  unfold compileCheckedToFullYulViaTypedStmt at hCompile
  unfold compileCheckedToTypedStmt? at hCompile
  cases hParse : parseChecked source with
  | none =>
      simp [hParse] at hCompile
  | some program =>
      simp [hParse, compileCheckedTypedStmtToFullYul] at hCompile
      cases hCompile
      exact ⟨program, rfl,
        Solidity.Checked.Program.toTypedStmt_toFullYul program, by
          simpa [Solidity.Checked.Program.toTypedStmt_fuel,
            Solidity.Checked.Program.toTypedStmt_eval] using
