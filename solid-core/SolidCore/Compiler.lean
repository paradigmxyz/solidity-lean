def stripReturnWithPrefix? (returnPrefix source : String) : Option String :=
  if source.startsWith returnPrefix &&
      source.endsWith returnLiteralSuffix then
    some
      (((source.drop returnPrefix.length).dropEnd
        returnLiteralSuffix.length).toString)
  else
    none

def stripReturnLiteral? (source : String) : Option String :=
  stripReturnWithPrefix? returnLiteralPrefix source

def stripReturnBoolLiteral? (source : String) : Option String :=
  stripReturnWithPrefix? returnBoolLiteralPrefix source

def parseReturnLiteralExpr? (source : String) : Option Solidity.Expr :=
  match stripReturnLiteral? source with
  | some literal =>
      match literal.trimAscii.toNat? with
      | some value => some (Solidity.Expr.lit value)
      | none => none
  | none => none

def parseReturnLiteral? (source : String) : Option Solidity.Program :=
  (parseReturnLiteralExpr? source).map Solidity.Program.returnExpr

def parseBinaryLiteralExpr? (separator : String)
    (mk : Solidity.Expr -> Solidity.Expr -> Solidity.Expr)
    (literal : String) : Option Solidity.Expr :=
  match literal.splitOn separator with
  | [lhs, rhs] =>
      match lhs.trimAscii.toNat?, rhs.trimAscii.toNat? with
      | some lhsValue, some rhsValue =>
          some (mk (Solidity.Expr.lit lhsValue)
            (Solidity.Expr.lit rhsValue))
      | _, _ => none
  | _ => none

def parseNonzeroRhsBinaryLiteralExpr? (separator : String)
    (mk : Solidity.Expr -> Solidity.Expr -> Solidity.Expr)
    (literal : String) : Option Solidity.Expr :=
  match literal.splitOn separator with
  | [lhs, rhs] =>
      match lhs.trimAscii.toNat?, rhs.trimAscii.toNat? with
      | some lhsValue, some rhsValue =>
          if rhsValue = 0 then
            none
          else
            some (mk (Solidity.Expr.lit lhsValue)
              (Solidity.Expr.lit rhsValue))
      | _, _ => none
  | _ => none

def stripOptionalOuterParens (literal : String) : String :=
  let trimmed := literal.trimAscii
  if trimmed.startsWith "(" && trimmed.endsWith ")" then
    (((trimmed.drop 1).dropEnd 1).trimAscii.toString)
  else
    trimmed.toString

def parseNatLiteralExpr? (literal : String) : Option Solidity.Expr :=
  match (stripOptionalOuterParens literal).trimAscii.toNat? with
  | some value => some (Solidity.Expr.lit value)
  | none => none

def parseNegNatLiteralExpr? (literal : String) : Option Solidity.Expr :=
  let stripped := (stripOptionalOuterParens literal).trimAscii
  if stripped.startsWith "-" then
    match (stripped.drop 1).trimAscii.toNat? with
    | some value => some (Solidity.Expr.neg (Solidity.Expr.lit value))
    | none => none
  else
    none

def parseProductAtomLiteralExpr? (literal : String) : Option Solidity.Expr :=
  match parseNegNatLiteralExpr? literal with
  | some expr => some expr
  | none => parseNatLiteralExpr? literal

inductive ProductOp where
  | mul
  | div
  | mod
  deriving DecidableEq, Repr

def productTokenString (charsRev : List Char) : String :=
  String.ofList charsRev.reverse

def productTokenBlank (charsRev : List Char) : Bool :=
  ((productTokenString charsRev).trimAscii.toString).isEmpty

def splitProductLiteralAux :
    List Char -> List Char -> List ProductOp -> List String ->
      Option (List String × List ProductOp)
  | [], currentRev, opsRev, tokensRev =>
      if productTokenBlank currentRev then
        none
      else
        some ((productTokenString currentRev :: tokensRev).reverse,
          opsRev.reverse)
  | '*' :: '*' :: rest, currentRev, opsRev, tokensRev =>
      splitProductLiteralAux rest ('*' :: '*' :: currentRev) opsRev tokensRev
  | ch :: rest, currentRev, opsRev, tokensRev =>
      if ch = '*' then
        if productTokenBlank currentRev then
          splitProductLiteralAux rest (ch :: currentRev) opsRev tokensRev
        else
          splitProductLiteralAux rest [] (ProductOp.mul :: opsRev)
            (productTokenString currentRev :: tokensRev)
      else if ch = '/' then
        if productTokenBlank currentRev then
          splitProductLiteralAux rest (ch :: currentRev) opsRev tokensRev
        else
          splitProductLiteralAux rest [] (ProductOp.div :: opsRev)
            (productTokenString currentRev :: tokensRev)
      else if ch = '%' then
        if productTokenBlank currentRev then
          splitProductLiteralAux rest (ch :: currentRev) opsRev tokensRev
        else
          splitProductLiteralAux rest [] (ProductOp.mod :: opsRev)
            (productTokenString currentRev :: tokensRev)
      else
        splitProductLiteralAux rest (ch :: currentRev) opsRev tokensRev

def splitProductLiteral? (literal : String) :
    Option (List String × List ProductOp) :=
  splitProductLiteralAux (stripOptionalOuterParens literal).toList [] [] []

def parseProductAtomParts? :
    List String -> Option (List (String × Solidity.Expr))
  | [] => some []
  | token :: rest =>
      match parseProductAtomLiteralExpr? token, parseProductAtomParts? rest with
      | some expr, some exprs => some ((token, expr) :: exprs)
      | _, _ => none

def productTokenZero? (token : String) : Bool :=
  match parseProductAtomLiteralExpr? token with
  | some (Solidity.Expr.lit 0) => true
  | some (Solidity.Expr.neg (Solidity.Expr.lit 0)) => true
  | _ => false

def applyProductOp? (op : ProductOp) (rhsToken : String)
    (lhs rhs : Solidity.Expr) : Option Solidity.Expr :=
  match op with
  | ProductOp.mul => some (Solidity.Expr.mul lhs rhs)
  | ProductOp.div =>
      if productTokenZero? rhsToken then
        none
      else
        some (Solidity.Expr.div lhs rhs)
  | ProductOp.mod =>
      if productTokenZero? rhsToken then
        none
      else
        some (Solidity.Expr.mod lhs rhs)

def foldProductExprs? (acc : Solidity.Expr) :
    List ProductOp -> List (String × Solidity.Expr) -> Option Solidity.Expr
  | [], [] => some acc
  | op :: ops, (token, expr) :: exprs =>
      match applyProductOp? op token acc expr with
      | some next => foldProductExprs? next ops exprs
      | none => none
  | _, _ => none

def parseMixedProductLiteralExpr? (literal : String) :
    Option Solidity.Expr :=
  match splitProductLiteral? literal with
  | some (firstToken :: restTokens, op :: ops) =>
      match parseProductAtomLiteralExpr? firstToken,
          parseProductAtomParts? restTokens with
      | some firstExpr, some exprs =>
          foldProductExprs? firstExpr (op :: ops) exprs
      | _, _ => none
  | _ => none

def parseProductLiteralExpr? (literal : String) : Option Solidity.Expr :=
  let stripped := stripOptionalOuterParens literal
  match parseMixedProductLiteralExpr? stripped with
  | some expr => some expr
  | none =>
      match parseBinaryLiteralExpr? "*" Solidity.Expr.mul stripped with
      | some expr => some expr
      | none =>
          match parseNonzeroRhsBinaryLiteralExpr? "/"
              Solidity.Expr.div stripped with
          | some expr => some expr
          | none =>
              match parseNonzeroRhsBinaryLiteralExpr? "%"
                  Solidity.Expr.mod stripped with
              | some expr => some expr
              | none => parseProductAtomLiteralExpr? stripped

def foldLeftExpr (mk : Solidity.Expr -> Solidity.Expr -> Solidity.Expr)
    (acc : Solidity.Expr) : List Solidity.Expr -> Solidity.Expr
  | [] => acc
  | expr :: rest => foldLeftExpr mk (mk acc expr) rest

def parseLiteralExprParts?
    (parsePart : String -> Option Solidity.Expr) :
    List String -> Option (List Solidity.Expr)
  | [] => some []
  | part :: rest =>
      match parsePart part, parseLiteralExprParts? parsePart rest with
      | some expr, some exprs => some (expr :: exprs)
      | _, _ => none

def parseLeftAssocLiteralExpr? (separator : String)
    (mk : Solidity.Expr -> Solidity.Expr -> Solidity.Expr)
    (parsePart : String -> Option Solidity.Expr)
    (literal : String) : Option Solidity.Expr :=
  match (stripOptionalOuterParens literal).splitOn separator with
  | first :: second :: rest =>
      match parsePart first,
          parseLiteralExprParts? parsePart (second :: rest) with
      | some firstExpr, some exprs => some (foldLeftExpr mk firstExpr exprs)
      | _, _ => none
  | _ => none

def parseAdditiveProductLiteralExpr? (separator : String)
    (mk : Solidity.Expr -> Solidity.Expr -> Solidity.Expr)
    (literal : String) : Option Solidity.Expr :=
  parseLeftAssocLiteralExpr? separator mk parseProductLiteralExpr? literal

inductive AdditiveOp where
  | plus
  | minus
  deriving DecidableEq, Repr

def AdditiveOp.apply : AdditiveOp -> Solidity.Expr -> Solidity.Expr ->
    Solidity.Expr
  | AdditiveOp.plus => Solidity.Expr.add
  | AdditiveOp.minus => Solidity.Expr.sub

def additiveTokenString (charsRev : List Char) : String :=
  String.ofList charsRev.reverse

def additiveTokenBlank (charsRev : List Char) : Bool :=
  ((additiveTokenString charsRev).trimAscii.toString).isEmpty

def splitAdditiveLiteralAux :
    List Char -> List Char -> List AdditiveOp -> List String ->
      Option (List String × List AdditiveOp)
  | [], currentRev, opsRev, tokensRev =>
      if additiveTokenBlank currentRev then
        none
      else
        some ((additiveTokenString currentRev :: tokensRev).reverse,
          opsRev.reverse)
  | ch :: rest, currentRev, opsRev, tokensRev =>
      if ch = '+' then
        if additiveTokenBlank currentRev then
          splitAdditiveLiteralAux rest (ch :: currentRev) opsRev tokensRev
        else
          splitAdditiveLiteralAux rest [] (AdditiveOp.plus :: opsRev)
            (additiveTokenString currentRev :: tokensRev)
      else if ch = '-' then
        if additiveTokenBlank currentRev then
          splitAdditiveLiteralAux rest (ch :: currentRev) opsRev tokensRev
        else
          splitAdditiveLiteralAux rest [] (AdditiveOp.minus :: opsRev)
            (additiveTokenString currentRev :: tokensRev)
      else
        splitAdditiveLiteralAux rest (ch :: currentRev) opsRev tokensRev

def splitAdditiveLiteral? (literal : String) :
    Option (List String × List AdditiveOp) :=
  splitAdditiveLiteralAux (stripOptionalOuterParens literal).toList [] [] []

def foldAdditiveExprs? (acc : Solidity.Expr) :
    List AdditiveOp -> List Solidity.Expr -> Option Solidity.Expr
  | [], [] => some acc
  | op :: ops, expr :: exprs =>
      foldAdditiveExprs? (op.apply acc expr) ops exprs
  | _, _ => none

def parseMixedAdditiveProductLiteralExpr? (literal : String) :
    Option Solidity.Expr :=
  match splitAdditiveLiteral? literal with
  | some (firstToken :: restTokens, op :: ops) =>
      match parseProductLiteralExpr? firstToken,
          parseLiteralExprParts? parseProductLiteralExpr? restTokens with
      | some firstExpr, some exprs =>
          foldAdditiveExprs? firstExpr (op :: ops) exprs
      | _, _ => none
  | _ => none

def parseArithmeticTermLiteralExpr? (literal : String) : Option Solidity.Expr :=
  match parseMixedAdditiveProductLiteralExpr? literal with
  | some expr => some expr
  | none =>
      match parseAdditiveProductLiteralExpr? "+" Solidity.Expr.add literal with
      | some expr => some expr
      | none =>
          match parseAdditiveProductLiteralExpr? "-" Solidity.Expr.sub literal with
          | some expr => some expr
          | none => parseProductLiteralExpr? literal

def parseComparisonArithmeticLiteralExpr? (separator : String)
    (mk : Solidity.Expr -> Solidity.Expr -> Solidity.Expr)
    (literal : String) : Option Solidity.Expr :=
  match (stripOptionalOuterParens literal).splitOn separator with
  | [lhs, rhs] =>
      match parseArithmeticTermLiteralExpr? lhs,
          parseArithmeticTermLiteralExpr? rhs with
      | some lhsExpr, some rhsExpr => some (mk lhsExpr rhsExpr)
      | _, _ => none
  | _ => none

def parseReturnAddLiteralExpr? (literal : String) : Option Solidity.Expr :=
  parseBinaryLiteralExpr? "+" Solidity.Expr.add literal

def parseReturnAddLiteral? (literal : String) : Option Solidity.Program :=
  (parseReturnAddLiteralExpr? literal).map Solidity.Program.returnExpr

def parseReturnBinaryExpr? (separator : String)
    (mk : Solidity.Expr -> Solidity.Expr -> Solidity.Expr)
    (source : String) : Option Solidity.Expr :=
  match stripReturnLiteral? source with
  | some literal => parseBinaryLiteralExpr? separator mk literal
  | none => none

def parseReturnNonzeroRhsBinaryExpr? (separator : String)
    (mk : Solidity.Expr -> Solidity.Expr -> Solidity.Expr)
    (source : String) : Option Solidity.Expr :=
  match stripReturnLiteral? source with
  | some literal => parseNonzeroRhsBinaryLiteralExpr? separator mk literal
  | none => none

def parseReturnAdditiveProductExpr? (separator : String)
    (mk : Solidity.Expr -> Solidity.Expr -> Solidity.Expr)
    (source : String) : Option Solidity.Expr :=
  match stripReturnLiteral? source with
  | some literal => parseAdditiveProductLiteralExpr? separator mk literal
  | none => none

def parseReturnArithmeticTermExpr? (source : String) : Option Solidity.Expr :=
  match stripReturnLiteral? source with
  | some literal => parseArithmeticTermLiteralExpr? literal
  | none => none

def parseReturnBoolBinaryExpr? (separator : String)
    (mk : Solidity.Expr -> Solidity.Expr -> Solidity.Expr)
    (source : String) : Option Solidity.Expr :=
  match stripReturnBoolLiteral? source with
  | some literal => parseBinaryLiteralExpr? separator mk literal
  | none => none

def parseReturnAddExpr? (source : String) : Option Solidity.Expr :=
  parseReturnBinaryExpr? "+" Solidity.Expr.add source

def parseReturnAddProductExpr? (source : String) : Option Solidity.Expr :=
  parseReturnAdditiveProductExpr? "+" Solidity.Expr.add source

def parseReturnAdd? (source : String) : Option Solidity.Program :=
  (parseReturnAddExpr? source).map Solidity.Program.returnExpr

def parseReturnSubLiteralExpr? (literal : String) : Option Solidity.Expr :=
  parseBinaryLiteralExpr? "-" Solidity.Expr.sub literal

def parseReturnSubExpr? (source : String) : Option Solidity.Expr :=
  parseReturnBinaryExpr? "-" Solidity.Expr.sub source

def parseReturnSubProductExpr? (source : String) : Option Solidity.Expr :=
  parseReturnAdditiveProductExpr? "-" Solidity.Expr.sub source

def parseReturnMulLiteralExpr? (literal : String) : Option Solidity.Expr :=
  parseBinaryLiteralExpr? "*" Solidity.Expr.mul literal

def parseReturnMulExpr? (source : String) : Option Solidity.Expr :=
  parseReturnBinaryExpr? "*" Solidity.Expr.mul source

def parseReturnExpLiteralExpr? (literal : String) : Option Solidity.Expr :=
  parseBinaryLiteralExpr? "**" Solidity.Expr.exp literal

def parseReturnExpExpr? (source : String) : Option Solidity.Expr :=
  parseReturnBinaryExpr? "**" Solidity.Expr.exp source

def parseReturnDivLiteralExpr? (literal : String) : Option Solidity.Expr :=
  parseNonzeroRhsBinaryLiteralExpr? "/" Solidity.Expr.div literal

def parseReturnDivExpr? (source : String) : Option Solidity.Expr :=
  parseReturnNonzeroRhsBinaryExpr? "/" Solidity.Expr.div source

def parseReturnModLiteralExpr? (literal : String) : Option Solidity.Expr :=
  parseNonzeroRhsBinaryLiteralExpr? "%" Solidity.Expr.mod literal

def parseReturnModExpr? (source : String) : Option Solidity.Expr :=
  parseReturnNonzeroRhsBinaryExpr? "%" Solidity.Expr.mod source

def parseReturnEqLiteralExpr? (literal : String) : Option Solidity.Expr :=
  parseBinaryLiteralExpr? "==" Solidity.Expr.eq literal

def parseReturnEqExpr? (source : String) : Option Solidity.Expr :=
  parseReturnBinaryExpr? "==" Solidity.Expr.eq source

def parseReturnNeLiteralExpr? (literal : String) : Option Solidity.Expr :=
  parseBinaryLiteralExpr? "!=" Solidity.Expr.ne literal

def parseReturnNeExpr? (source : String) : Option Solidity.Expr :=
  parseReturnBinaryExpr? "!=" Solidity.Expr.ne source

def parseReturnLtLiteralExpr? (literal : String) : Option Solidity.Expr :=
  parseBinaryLiteralExpr? "<" Solidity.Expr.lt literal

def parseReturnLtExpr? (source : String) : Option Solidity.Expr :=
  parseReturnBinaryExpr? "<" Solidity.Expr.lt source

def parseReturnGtLiteralExpr? (literal : String) : Option Solidity.Expr :=
  parseBinaryLiteralExpr? ">" Solidity.Expr.gt literal

def parseReturnGtExpr? (source : String) : Option Solidity.Expr :=
  parseReturnBinaryExpr? ">" Solidity.Expr.gt source

def parseReturnLeLiteralExpr? (literal : String) : Option Solidity.Expr :=
  parseBinaryLiteralExpr? "<=" Solidity.Expr.le literal

def parseReturnLeExpr? (source : String) : Option Solidity.Expr :=
  parseReturnBinaryExpr? "<=" Solidity.Expr.le source

def parseReturnGeLiteralExpr? (literal : String) : Option Solidity.Expr :=
  parseBinaryLiteralExpr? ">=" Solidity.Expr.ge literal

def parseReturnGeExpr? (source : String) : Option Solidity.Expr :=
  parseReturnBinaryExpr? ">=" Solidity.Expr.ge source

def parseReturnBitAndLiteralExpr? (literal : String) : Option Solidity.Expr :=
  parseBinaryLiteralExpr? "&" Solidity.Expr.bitAnd literal

def parseReturnBitAndExpr? (source : String) : Option Solidity.Expr :=
  parseReturnBinaryExpr? "&" Solidity.Expr.bitAnd source

def parseReturnBitOrLiteralExpr? (literal : String) : Option Solidity.Expr :=
  parseBinaryLiteralExpr? "|" Solidity.Expr.bitOr literal

def parseReturnBitOrExpr? (source : String) : Option Solidity.Expr :=
  parseReturnBinaryExpr? "|" Solidity.Expr.bitOr source

def parseReturnBitXorLiteralExpr? (literal : String) : Option Solidity.Expr :=
  parseBinaryLiteralExpr? "^" Solidity.Expr.bitXor literal

def parseReturnBitXorExpr? (source : String) : Option Solidity.Expr :=
  parseReturnBinaryExpr? "^" Solidity.Expr.bitXor source

def parseReturnShlLiteralExpr? (literal : String) : Option Solidity.Expr :=
  parseBinaryLiteralExpr? "<<" Solidity.Expr.shl literal

def parseReturnShlExpr? (source : String) : Option Solidity.Expr :=
  parseReturnBinaryExpr? "<<" Solidity.Expr.shl source

def parseReturnShrLiteralExpr? (literal : String) : Option Solidity.Expr :=
  parseBinaryLiteralExpr? ">>" Solidity.Expr.shr literal

def parseReturnShrExpr? (source : String) : Option Solidity.Expr :=
  parseReturnBinaryExpr? ">>" Solidity.Expr.shr source

def stripCallArgs? (fnName literal : String) : Option String :=
  let trimmed := literal.trimAscii
  let callPrefix := fnName ++ "("
  let callSuffix := ")"
  if trimmed.startsWith callPrefix && trimmed.endsWith callSuffix then
    some
      (((trimmed.drop callPrefix.length).dropEnd
        callSuffix.length).toString)
  else
    none

def parseTwoNatArgs? (args : String) : Option (Nat × Nat) :=
  match args.splitOn "," with
  | [lhs, rhs] =>
      match lhs.trimAscii.toNat?, rhs.trimAscii.toNat? with
      | some lhsValue, some rhsValue => some (lhsValue, rhsValue)
      | _, _ => none
  | _ => none

def parseThreeNatArgs? (args : String) : Option (Nat × Nat × Nat) :=
  match args.splitOn "," with
  | [lhs, rhs, third] =>
      match lhs.trimAscii.toNat?, rhs.trimAscii.toNat?,
          third.trimAscii.toNat? with
      | some lhsValue, some rhsValue, some thirdValue =>
          some (lhsValue, rhsValue, thirdValue)
      | _, _, _ => none
  | _ => none

def parseTwoExprArgs? (args : String) :
    Option (Solidity.Expr × Solidity.Expr) :=
  match args.splitOn "," with
  | [lhs, rhs] =>
      match parseArithmeticTermLiteralExpr? lhs,
          parseArithmeticTermLiteralExpr? rhs with
      | some lhsExpr, some rhsExpr => some (lhsExpr, rhsExpr)
      | _, _ => none
  | _ => none

def parseThreeExprArgs? (args : String) :
    Option (Solidity.Expr × Solidity.Expr × Solidity.Expr) :=
  match args.splitOn "," with
  | [lhs, rhs, third] =>
      match parseArithmeticTermLiteralExpr? lhs,
          parseArithmeticTermLiteralExpr? rhs,
          parseArithmeticTermLiteralExpr? third with
      | some lhsExpr, some rhsExpr, some thirdExpr =>
          some (lhsExpr, rhsExpr, thirdExpr)
      | _, _, _ => none
  | _ => none

def parseBinaryCallLiteralExpr? (fnName : String)
    (mk : Solidity.Expr -> Solidity.Expr -> Solidity.Expr)
    (literal : String) : Option Solidity.Expr :=
  match stripCallArgs? fnName literal with
  | some args =>
      match parseTwoExprArgs? args with
      | some (lhs, rhs) => some (mk lhs rhs)
      | none => none
  | none => none

def parseTernaryCallLiteralExpr? (fnName : String)
    (mk : Solidity.Expr -> Solidity.Expr -> Solidity.Expr -> Solidity.Expr)
    (literal : String) : Option Solidity.Expr :=
  match stripCallArgs? fnName literal with
  | some args =>
      match parseThreeExprArgs? args with
      | some (lhs, rhs, third) => some (mk lhs rhs third)
      | none => none
  | none => none

def parseReturnCallExpr? (parseLiteral : String -> Option Solidity.Expr)
    (source : String) : Option Solidity.Expr :=
  match stripReturnLiteral? source with
  | some literal => parseLiteral literal
  | none => none

def parseReturnAddmodLiteralExpr? (literal : String) :
    Option Solidity.Expr :=
  parseTernaryCallLiteralExpr? "addmod" Solidity.Expr.addmod literal

def parseReturnAddmodExpr? (source : String) : Option Solidity.Expr :=
  parseReturnCallExpr? parseReturnAddmodLiteralExpr? source

def parseReturnMulmodLiteralExpr? (literal : String) :
    Option Solidity.Expr :=
  parseTernaryCallLiteralExpr? "mulmod" Solidity.Expr.mulmod literal

def parseReturnMulmodExpr? (source : String) : Option Solidity.Expr :=
  parseReturnCallExpr? parseReturnMulmodLiteralExpr? source

def parseReturnByteLiteralExpr? (literal : String) : Option Solidity.Expr :=
  parseBinaryCallLiteralExpr? "byte" Solidity.Expr.byteAt literal

def parseReturnByteExpr? (source : String) : Option Solidity.Expr :=
  parseReturnCallExpr? parseReturnByteLiteralExpr? source

def parsePrefixedNatLiteralExpr? (marker : String)
    (mk : Solidity.Expr -> Solidity.Expr)
    (literal : String) : Option Solidity.Expr :=
  let trimmed := literal.trimAscii
  if trimmed.startsWith marker then
    match (trimmed.drop marker.length).trimAscii.toNat? with
    | some value => some (mk (Solidity.Expr.lit value))
    | none => none
  else
    none

def parseReturnUnaryExpr? (parseLiteral : String -> Option Solidity.Expr)
    (source : String) : Option Solidity.Expr :=
  match stripReturnLiteral? source with
  | some literal => parseLiteral literal
  | none => none

def parseReturnBitNotLiteralExpr? (literal : String) :
    Option Solidity.Expr :=
  parsePrefixedNatLiteralExpr? "~" Solidity.Expr.bitNot literal

def parseReturnBitNotExpr? (source : String) : Option Solidity.Expr :=
  parseReturnUnaryExpr? parseReturnBitNotLiteralExpr? source

def firstSomeExpr? : List (Option Solidity.Expr) -> Option Solidity.Expr
  | [] => none
  | some expr :: _ => some expr
  | none :: rest => firstSomeExpr? rest

def parseBoolLiteralExpr? (literal : String) : Option Solidity.Expr :=
  let trimmed := literal.trimAscii.toString
  if trimmed = "true" then
    some (Solidity.Expr.lit 1)
  else if trimmed = "false" then
    some (Solidity.Expr.lit 0)
  else
    none

def parseNumericBoolLiteralExpr? (literal : String) :
    Option Solidity.Expr :=
  let stripped := stripOptionalOuterParens literal
  firstSomeExpr?
    [ parseComparisonArithmeticLiteralExpr? "==" Solidity.Expr.eq stripped
    , parseComparisonArithmeticLiteralExpr? "!=" Solidity.Expr.ne stripped
    , parseComparisonArithmeticLiteralExpr? "<=" Solidity.Expr.le stripped
    , parseComparisonArithmeticLiteralExpr? ">=" Solidity.Expr.ge stripped
    , parseComparisonArithmeticLiteralExpr? "<" Solidity.Expr.lt stripped
    , parseComparisonArithmeticLiteralExpr? ">" Solidity.Expr.gt stripped
    ]

def parseBoolBaseAtomExpr? (literal : String) : Option Solidity.Expr :=
  firstSomeExpr?
    [ parseBoolLiteralExpr? literal
    , parseNumericBoolLiteralExpr? literal
    ]

def parseBoolNotLiteralExpr? (literal : String) : Option Solidity.Expr :=
  let trimmed := literal.trimAscii.toString
  if trimmed.startsWith "!" then
    match parseBoolBaseAtomExpr? ((trimmed.drop 1).toString) with
    | some expr => some (Solidity.Expr.iszero expr)
    | none => none
  else
    none

def parseBoolAtomExpr? (literal : String) : Option Solidity.Expr :=
  firstSomeExpr?
    [ parseBoolBaseAtomExpr? literal
    , parseBoolNotLiteralExpr? literal
    ]

def parseBoolAtomParts? : List String -> Option (List Solidity.Expr)
  | [] => some []
  | part :: rest =>
      match parseBoolAtomExpr? part, parseBoolAtomParts? rest with
      | some expr, some exprs => some (expr :: exprs)
      | _, _ => none

def parseBoolConnectiveChainLiteralExpr? (separator : String)
    (mk : Solidity.Expr -> Solidity.Expr -> Solidity.Expr)
    (literal : String) : Option Solidity.Expr :=
  match literal.splitOn separator with
  | first :: second :: rest =>
      match parseBoolAtomExpr? first,
          parseBoolAtomParts? (second :: rest) with
      | some firstExpr, some exprs => some (foldLeftExpr mk firstExpr exprs)
      | _, _ => none
  | _ => none

def parseBoolBinaryLiteralExpr? (separator : String)
    (mk : Solidity.Expr -> Solidity.Expr -> Solidity.Expr)
    (literal : String) : Option Solidity.Expr :=
  parseBoolConnectiveChainLiteralExpr? separator mk literal

def parseBoolAndTermExpr? (literal : String) : Option Solidity.Expr :=
  firstSomeExpr?
    [ parseBoolConnectiveChainLiteralExpr? "&&" Solidity.Expr.boolAnd literal
    , parseBoolAtomExpr? literal
    ]

def parseBoolAndTermParts? : List String -> Option (List Solidity.Expr)
  | [] => some []
  | part :: rest =>
      match parseBoolAndTermExpr? part, parseBoolAndTermParts? rest with
      | some expr, some exprs => some (expr :: exprs)
      | _, _ => none

def parseBoolConnectivePrecedenceLiteralExpr? (literal : String) :
    Option Solidity.Expr :=
  match literal.splitOn "||" with
  | first :: second :: rest =>
      match parseBoolAndTermExpr? first,
          parseBoolAndTermParts? (second :: rest) with
      | some firstExpr, some exprs =>
          some (foldLeftExpr Solidity.Expr.boolOr firstExpr exprs)
      | _, _ => none
  | _ => none

def parseReturnBoolLiteralExpr? (source : String) : Option Solidity.Expr :=
  match stripReturnBoolLiteral? source with
  | some literal => parseBoolLiteralExpr? literal
  | none => none

def parseReturnBoolNotExpr? (source : String) : Option Solidity.Expr :=
  match stripReturnBoolLiteral? source with
  | some literal => parseBoolNotLiteralExpr? literal
  | none => none

def parseReturnBoolConnectiveExpr? (separator : String)
    (mk : Solidity.Expr -> Solidity.Expr -> Solidity.Expr)
    (source : String) : Option Solidity.Expr :=
  match stripReturnBoolLiteral? source with
  | some literal => parseBoolBinaryLiteralExpr? separator mk literal
  | none => none

def parseReturnBoolConnectivePrecedenceExpr? (source : String) :
    Option Solidity.Expr :=
  match stripReturnBoolLiteral? source with
  | some literal => parseBoolConnectivePrecedenceLiteralExpr? literal
  | none => none

def parseReturnBoolArithmeticComparisonExpr? (separator : String)
    (mk : Solidity.Expr -> Solidity.Expr -> Solidity.Expr)
    (source : String) : Option Solidity.Expr :=
  match stripReturnBoolLiteral? source with
  | some literal => parseComparisonArithmeticLiteralExpr? separator mk literal
  | none => none

def parseGeneratedBoolReturnExpr? (source : String) : Option Solidity.Expr :=
  firstSomeExpr?
    [ parseReturnBoolLiteralExpr? source
    , parseReturnBoolNotExpr? source
    , parseReturnBoolConnectivePrecedenceExpr? source
    , parseReturnBoolConnectiveExpr? "&&" Solidity.Expr.boolAnd source
    , parseReturnBoolConnectiveExpr? "||" Solidity.Expr.boolOr source
    , parseReturnBoolArithmeticComparisonExpr? "==" Solidity.Expr.eq source
    , parseReturnBoolArithmeticComparisonExpr? "!=" Solidity.Expr.ne source
    , parseReturnBoolArithmeticComparisonExpr? "<=" Solidity.Expr.le source
    , parseReturnBoolArithmeticComparisonExpr? ">=" Solidity.Expr.ge source
    , parseReturnBoolArithmeticComparisonExpr? "<" Solidity.Expr.lt source
    , parseReturnBoolArithmeticComparisonExpr? ">" Solidity.Expr.gt source
    , parseReturnBoolConnectiveExpr? "==" Solidity.Expr.eq source
    , parseReturnBoolConnectiveExpr? "!=" Solidity.Expr.ne source
    , parseReturnBoolBinaryExpr? "==" Solidity.Expr.eq source
    , parseReturnBoolBinaryExpr? "!=" Solidity.Expr.ne source
    , parseReturnBoolBinaryExpr? "<=" Solidity.Expr.le source
    , parseReturnBoolBinaryExpr? ">=" Solidity.Expr.ge source
    , parseReturnBoolBinaryExpr? "<" Solidity.Expr.lt source
    , parseReturnBoolBinaryExpr? ">" Solidity.Expr.gt source
    ]

def parseGeneratedReturnExpr? (source : String) : Option Solidity.Expr :=
  firstSomeExpr?
    [ parseReturnArithmeticTermExpr? source
    , parseReturnAddProductExpr? source
    , parseReturnSubProductExpr? source
    , parseReturnAddExpr? source
    , parseReturnSubExpr? source
    , parseReturnMulExpr? source
    , parseReturnExpExpr? source
    , parseReturnDivExpr? source
    , parseReturnModExpr? source
    , parseReturnEqExpr? source
    , parseReturnNeExpr? source
    , parseReturnLeExpr? source
    , parseReturnGeExpr? source
    , parseReturnLtExpr? source
    , parseReturnGtExpr? source
    , parseReturnBitAndExpr? source
    , parseReturnBitOrExpr? source
    , parseReturnBitXorExpr? source
    , parseReturnShlExpr? source
    , parseReturnShrExpr? source
    , parseReturnAddmodExpr? source
    , parseReturnMulmodExpr? source
    , parseReturnByteExpr? source
    , parseReturnBitNotExpr? source
    , parseGeneratedBoolReturnExpr? source
    , parseReturnLiteralExpr? source
    ]

def parseGeneratedReturn? (source : String) : Option Solidity.Program :=
  (parseGeneratedReturnExpr? source).map Solidity.Program.returnExpr

def stripGeneratedIfElseReturn? (source : String) :
    Option (String × String × String) :=
  if source.startsWith ifElseReturnPrefix &&
      source.endsWith ifElseReturnSuffix then
    let body :=
      (((source.drop ifElseReturnPrefix.length).dropEnd
        ifElseReturnSuffix.length).toString)
