namespace RealEVM

namespace Opcode

def push1 : Nat := 0x60
def mstore : Nat := 0x52
def returnOp : Nat := 0xf3

end Opcode

def validByte (byte : Nat) : Bool :=
  decide (byte < 256)

def validBytecode (bytes : List Nat) : Bool :=
  bytes.all validByte

def returnRuntimeBytes : List Nat :=
  [Opcode.push1, 0, Opcode.mstore, Opcode.push1, 32, Opcode.push1, 0,
    Opcode.returnOp]

def compileWordReturnBytes (value : Word) : Option (List Nat) :=
  if value < 256 then
    some ([Opcode.push1, value] ++ returnRuntimeBytes)
  else
    none

def runReturnBytes : List Nat -> Option Word
  | push :: value :: offsetPush :: offset :: store ::
      sizePush :: size :: returnOffsetPush :: returnOffset :: finish :: [] =>
      if push = Opcode.push1 ∧ offsetPush = Opcode.push1 ∧ offset = 0 ∧
          store = Opcode.mstore ∧ sizePush = Opcode.push1 ∧ size = 32 ∧
          returnOffsetPush = Opcode.push1 ∧ returnOffset = 0 ∧
          finish = Opcode.returnOp ∧ value < 256 then
        some value
      else
        none
  | _ => none

theorem compileWordReturnBytes_correct {value : Word} {bytes : List Nat}
    (hCompile : compileWordReturnBytes value = some bytes) :
    runReturnBytes bytes = some value := by
  unfold compileWordReturnBytes at hCompile
  by_cases hValue : value < 256
  · simp [hValue] at hCompile
    cases hCompile
    simp [runReturnBytes, returnRuntimeBytes, Opcode.push1,
      Opcode.mstore, Opcode.returnOp, hValue]
  · simp [hValue] at hCompile

theorem compileWordReturnBytes_valid {value : Word} {bytes : List Nat}
    (hCompile : compileWordReturnBytes value = some bytes) :
    validBytecode bytes = true := by
  unfold compileWordReturnBytes at hCompile
  by_cases hValue : value < 256
  · simp [hValue] at hCompile
    cases hCompile
    simp [validBytecode, validByte, returnRuntimeBytes, Opcode.push1,
      Opcode.mstore, Opcode.returnOp, hValue]
  · simp [hValue] at hCompile

def compileFullYulReturnBytes :
    SolidCoreYulCore.FullYul.Expr -> Option (List Nat)
  | SolidCoreYulCore.FullYul.Expr.value
      (SolidCoreYulCore.FullYul.Value.word value) =>
      compileWordReturnBytes value
  | _ => none

theorem compileFullYulReturnBytes_correct
    {expr : SolidCoreYulCore.FullYul.Expr} {bytes : List Nat} {value : Word}
    (hCompile : compileFullYulReturnBytes expr = some bytes)
    (hEval :
      SolidCoreYulCore.FullYul.evalExpr [] expr =
        some (SolidCoreYulCore.FullYul.Value.word value)) :
    runReturnBytes bytes = some value := by
  cases expr <;> simp [compileFullYulReturnBytes,
    SolidCoreYulCore.FullYul.evalExpr] at hCompile hEval
  case value yulValue =>
    cases yulValue <;> simp at hCompile hEval
    case word wordValue =>
      cases hEval
      exact compileWordReturnBytes_correct hCompile

theorem compileFullYulReturnBytes_valid
    {expr : SolidCoreYulCore.FullYul.Expr} {bytes : List Nat}
    (hCompile : compileFullYulReturnBytes expr = some bytes) :
    validBytecode bytes = true := by
  cases expr <;> simp [compileFullYulReturnBytes] at hCompile
  case value yulValue =>
    cases yulValue <;> simp at hCompile
    case word _ =>
      exact compileWordReturnBytes_valid hCompile

end RealEVM

namespace ProofCarrying

structure ReturnBytecodeArtifact (source : Solidity.Program) where
  fullYul : SolidCoreYulCore.FullYul.Expr
  bytes : List Nat
  compiled : RealEVM.compileFullYulReturnBytes fullYul = some bytes
  bytecode_valid : RealEVM.validBytecode bytes = true
  source_to_fullYul_sound :
    SolidCoreYulCore.FullYul.evalExpr [] fullYul =
      some (SolidCoreYulCore.FullYul.Value.word source.eval)
  fullYul_to_evm_sound :
    RealEVM.runReturnBytes bytes = some source.eval
  end_to_end_sound :
    RealEVM.runReturnBytes bytes = some source.eval

def compileReturnBytecode (source : Solidity.Program) :
    Option (ReturnBytecodeArtifact source) :=
  let fullYul := source.toFoldedFullYul
  match hBytes : RealEVM.compileFullYulReturnBytes fullYul with
  | some bytes =>
      let sourceSound := Solidity.Program.toFoldedFullYul_correct source
      let targetSound :=
        RealEVM.compileFullYulReturnBytes_correct hBytes sourceSound
      some
        { fullYul := fullYul
          bytes := bytes
          compiled := hBytes
          bytecode_valid := RealEVM.compileFullYulReturnBytes_valid hBytes
          source_to_fullYul_sound := sourceSound
          fullYul_to_evm_sound := targetSound
          end_to_end_sound := targetSound }
  | none => none

theorem compileReturnBytecode_sound
    (source : Solidity.Program) (artifact : ReturnBytecodeArtifact source)
    (_hCompile : compileReturnBytecode source = some artifact) :
    SolidCoreYulCore.FullYul.evalExpr [] artifact.fullYul =
      some (SolidCoreYulCore.FullYul.Value.word source.eval) ∧
    RealEVM.validBytecode artifact.bytes = true ∧
    RealEVM.runReturnBytes artifact.bytes = some source.eval := by
  exact ⟨artifact.source_to_fullYul_sound, artifact.bytecode_valid,
    artifact.end_to_end_sound⟩

end ProofCarrying

