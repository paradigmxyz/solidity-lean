  exact ⟨core, hCore, core_toFullYul_accepted_currentSolidCore_of_some hCore⟩

theorem parseGeneratedLocalPairUpdateAddValue?_localPairUpdateAddValue_some
    {source : String} {program : Solidity.Program}
    (h : parseGeneratedLocalPairUpdateAddValue? source = some program) :
    ∃ initLhsExpr initRhsExpr assignedLhsExpr assignedRhsExpr,
      program =
        Solidity.Program.functionBody
          (Solidity.Body.localPairUpdateAddValue initLhsExpr initRhsExpr
            assignedLhsExpr assignedRhsExpr) := by
  unfold parseGeneratedLocalPairUpdateAddValue? at h
  cases hStrip : stripGeneratedLocalPairUpdateAddValue? source with
  | none =>
      simp [hStrip] at h
  | some parsed =>
      rcases parsed with
        ⟨initLhsLiteral, initRhsLiteral, assignedLhsLiteral,
          assignedRhsLiteral⟩
      cases hInitLhs :
          parseGeneratedReturnExpr? (returnLiteralSource initLhsLiteral) with
      | none =>
