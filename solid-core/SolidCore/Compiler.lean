theorem Program.toFoldedFullYul_correct (program : Program) :
    SolidCoreYulCore.FullYul.evalExpr [] program.toFoldedFullYul =
      some (SolidCoreYulCore.FullYul.Value.word program.eval) := by
  cases program with
  | returnExpr expr => exact Expr.toFoldedFullYul_correct expr
  | functionBody body => rfl
  | internalCallArgReturn => rfl
  | internalCallMultiReturn => rfl
  | storageWriteRead => rfl
  | storageOverwriteRead => rfl
  | storagePairReadAdd => rfl
  | storageIfWriteRead => rfl
  | storageIfFalseWriteRead => rfl
  | internalStorageCall => rfl
  | internalStorageArgCall => rfl
  | internalStorageArgReturnCall => rfl
  | internalStoragePairArgReturnCall => rfl
  | internalStorageReadUpdateCall => rfl
  | internalStorageConditionalCall => rfl
  | internalStorageConditionalFalseCall => rfl
  | nestedInternalStorageCall => rfl

inductive InternalStorageCallFrame where
  | noArgWriteRead : InternalStorageCallFrame
  | argWriteRead : InternalStorageCallFrame
  | argReturnWriteRead : InternalStorageCallFrame
  | pairArgReturnWriteReadAdd : InternalStorageCallFrame
  | readUpdateReturn : InternalStorageCallFrame
  | conditionalReturn : InternalStorageCallFrame
  | conditionalFalseReturn : InternalStorageCallFrame
  | nestedWriteRead : InternalStorageCallFrame
  deriving DecidableEq, Repr

def InternalStorageCallFrame.toProgram :
    InternalStorageCallFrame -> Program
  | InternalStorageCallFrame.noArgWriteRead =>
      Program.internalStorageCall
  | InternalStorageCallFrame.argWriteRead =>
      Program.internalStorageArgCall
  | InternalStorageCallFrame.argReturnWriteRead =>
      Program.internalStorageArgReturnCall
  | InternalStorageCallFrame.pairArgReturnWriteReadAdd =>
      Program.internalStoragePairArgReturnCall
  | InternalStorageCallFrame.readUpdateReturn =>
      Program.internalStorageReadUpdateCall
  | InternalStorageCallFrame.conditionalReturn =>
      Program.internalStorageConditionalCall
  | InternalStorageCallFrame.conditionalFalseReturn =>
      Program.internalStorageConditionalFalseCall
  | InternalStorageCallFrame.nestedWriteRead =>
      Program.nestedInternalStorageCall

def InternalStorageCallFrame.fuel (frame : InternalStorageCallFrame) : Nat :=
  frame.toProgram.stmtFuel

def InternalStorageCallFrame.toFullYul
    (frame : InternalStorageCallFrame) :
    SolidCoreYulCore.FullYul.Stmt :=
  frame.toProgram.toFullYulStmt

theorem InternalStorageCallFrame.toFullYul_correct
    (frame : InternalStorageCallFrame) :
    SolidCoreYulCore.SymYul.evalStmtFuel frame.fuel
        Body.initialSymYulConfig frame.toFullYul =
      [SolidCoreYulCore.SymYul.normalResult
        frame.toProgram.finalSymYulConfig] := by
  simpa [InternalStorageCallFrame.fuel,
    InternalStorageCallFrame.toFullYul] using
      Program.toFullYulStmt_correct frame.toProgram

theorem InternalStorageCallFrame.toFullYul_staticChecked
    (frame : InternalStorageCallFrame) :
    SolidCoreYulCore.FullYul.checkStmtFuel (frame.fuel + 1)
        Program.initialStaticContext false false frame.toFullYul =
      some Program.initialStaticContext := by
  cases frame <;> rfl

theorem InternalStorageCallFrame.toFullYul_compilerEmittable
    (frame : InternalStorageCallFrame) :
    SolidCoreYulCore.FullYul.CompilerEmittableStmt
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      frame.toFullYul := by
  cases frame <;>
    simp [InternalStorageCallFrame.toFullYul,
      InternalStorageCallFrame.toProgram, Program.toFullYulStmt,
      Program.internalStorageCallFullYul,
      Program.internalStorageArgCallFullYul,
      Program.internalStorageArgReturnCallFullYul,
      Program.internalStoragePairArgReturnCallFullYul,
      Program.internalStorageReadUpdateCallFullYul,
      Program.internalStorageConditionalCallFullYul,
      Program.internalStorageConditionalFalseCallFullYul,
      Program.nestedInternalStorageCallFullYul,
      storageSlotZero, storageSlotOne, storageValueThree,
      storageValueFour, storageValueSix, storageValueSeven,
      storageValueEight, storageValueNine, storageValueTen]
  all_goals repeat first | constructor | trivial

namespace Structured

structure State where
  returnValue : Word
  deriving DecidableEq, Repr

inductive Result where
  | normal : State -> Result
  | returned : State -> Result
  deriving DecidableEq, Repr

inductive Stmt where
  | skip : Stmt
  | expr : Expr -> Stmt
  | returnExpr : Expr -> Stmt
  | seq : Stmt -> Stmt -> Stmt
  | block : Stmt -> Stmt
  | ifThen : Expr -> Stmt -> Stmt
  | forFalse : Stmt -> Stmt
  | forOnce : Stmt -> Stmt
  | forIf : Expr -> Stmt -> Stmt
  deriving DecidableEq, Repr

def State.toConfig (state : State) : SolidCoreYulCore.SymYul.Config :=
  Body.returnConfig state.returnValue

def Result.toSymYulResults : Result -> List SolidCoreYulCore.SymYul.Result
  | Result.normal state =>
      [SolidCoreYulCore.SymYul.normalResult state.toConfig]
  | Result.returned state =>
      [{ flow := SolidCoreYulCore.FullYul.Flow.left
         config := state.toConfig }]

def Result.toSymYulResult : Result -> SolidCoreYulCore.SymYul.Result
  | Result.normal state =>
      SolidCoreYulCore.SymYul.normalResult state.toConfig
  | Result.returned state =>
      { flow := SolidCoreYulCore.FullYul.Flow.left
        config := state.toConfig }

theorem Result.toSymYulResults_eq_single (result : Result) :
    result.toSymYulResults = [result.toSymYulResult] := by
  cases result <;> rfl

theorem State.restoreBlockConfig_toConfig (outer inner : State) :
    SolidCoreYulCore.SymYul.restoreBlockConfig outer.toConfig inner.toConfig =
      some inner.toConfig := by
  simp [State.toConfig, Body.returnConfig, Body.returnEnv,
    SolidCoreYulCore.SymYul.restoreBlockConfig,
    SolidCoreYulCore.FullYul.restoreOuter,
    SolidCoreYulCore.FullYul.lookup?]

theorem State.withRestoredConfig_normal (outer inner : State) :
    SolidCoreYulCore.SymYul.withRestoredConfig outer.toConfig
        (SolidCoreYulCore.SymYul.normalResult inner.toConfig) =
      some (SolidCoreYulCore.SymYul.normalResult inner.toConfig) := by
  simp [SolidCoreYulCore.SymYul.withRestoredConfig,
    State.restoreBlockConfig_toConfig,
    SolidCoreYulCore.SymYul.normalResult]

def State.leftResult (state : State) : SolidCoreYulCore.SymYul.Result :=
  { flow := SolidCoreYulCore.FullYul.Flow.left, config := state.toConfig }

theorem State.withRestoredConfig_left (outer inner : State) :
    SolidCoreYulCore.SymYul.withRestoredConfig outer.toConfig
        inner.leftResult =
      some inner.leftResult := by
  simp [SolidCoreYulCore.SymYul.withRestoredConfig,
    State.restoreBlockConfig_toConfig, State.leftResult]

theorem Result.withRestoredConfig_toSymYulResult
    (outer : State) (result : Result) :
    SolidCoreYulCore.SymYul.withRestoredConfig outer.toConfig
        result.toSymYulResult =
      some result.toSymYulResult := by
  cases result with
  | normal state =>
      exact State.withRestoredConfig_normal outer state
  | returned state =>
      simpa [Result.toSymYulResult, State.leftResult] using
        State.withRestoredConfig_left outer state

def Stmt.eval (state : State) : Stmt -> Result
  | Stmt.skip => Result.normal state
  | Stmt.expr _ => Result.normal state
  | Stmt.returnExpr e =>
      Result.returned { state with returnValue := e.eval }
  | Stmt.seq first second =>
      match first.eval state with
      | Result.normal state' => second.eval state'
      | Result.returned state' => Result.returned state'
  | Stmt.block body => body.eval state
  | Stmt.ifThen cond body =>
      if SolidCoreYulCore.norm cond.eval = 0 then
        Result.normal state
      else
        body.eval state
  | Stmt.forFalse _ => Result.normal state
  | Stmt.forOnce body => body.eval state
  | Stmt.forIf cond body =>
      if SolidCoreYulCore.norm cond.eval = 0 then
        Result.normal state
      else
        body.eval state

def Stmt.fuel : Stmt -> Nat
  | Stmt.skip => 1
  | Stmt.expr _ => 1
  | Stmt.returnExpr _ => 2
  | Stmt.seq first second => first.fuel + second.fuel + 1
  | Stmt.block body => body.fuel + 2
  | Stmt.ifThen _ body => body.fuel + 1
  | Stmt.forFalse body => body.fuel + 1
  | Stmt.forOnce body => body.fuel + 3
  | Stmt.forIf _ body => body.fuel + 3

abbrev Stmt.bodyThenBreakFullYul
    (body : SolidCoreYulCore.FullYul.Stmt) : SolidCoreYulCore.FullYul.Stmt :=
  SolidCoreYulCore.FullYul.Stmt.seq body SolidCoreYulCore.FullYul.Stmt.break

abbrev Stmt.singleIterationLoopFullYul
    (cond : SolidCoreYulCore.FullYul.Expr)
    (body : SolidCoreYulCore.FullYul.Stmt) : SolidCoreYulCore.FullYul.Stmt :=
  SolidCoreYulCore.FullYul.Stmt.forLoop
    SolidCoreYulCore.FullYul.Stmt.skip
    cond
    SolidCoreYulCore.FullYul.Stmt.skip
    (Stmt.bodyThenBreakFullYul body)

def Stmt.toFullYul : Stmt -> SolidCoreYulCore.FullYul.Stmt
  | Stmt.skip => SolidCoreYulCore.FullYul.Stmt.skip
  | Stmt.expr _ => SolidCoreYulCore.FullYul.Stmt.skip
  | Stmt.returnExpr e =>
      SolidCoreYulCore.FullYul.Stmt.seq
        (SolidCoreYulCore.FullYul.Stmt.assign returnName e.toFullYul)
        SolidCoreYulCore.FullYul.Stmt.leave
  | Stmt.seq first second =>
      SolidCoreYulCore.FullYul.Stmt.seq first.toFullYul second.toFullYul
  | Stmt.block body =>
      SolidCoreYulCore.FullYul.Stmt.block [body.toFullYul]
  | Stmt.ifThen cond body =>
      SolidCoreYulCore.FullYul.Stmt.ifThen cond.toFullYul body.toFullYul
  | Stmt.forFalse body =>
      SolidCoreYulCore.FullYul.Stmt.forLoop
        SolidCoreYulCore.FullYul.Stmt.skip
        (SolidCoreYulCore.FullYul.Expr.value
          (SolidCoreYulCore.FullYul.Value.word 0))
        SolidCoreYulCore.FullYul.Stmt.skip
        body.toFullYul
  | Stmt.forOnce body =>
      Stmt.singleIterationLoopFullYul
        (SolidCoreYulCore.FullYul.Expr.value
          (SolidCoreYulCore.FullYul.Value.word 1))
        body.toFullYul
  | Stmt.forIf cond body =>
      Stmt.singleIterationLoopFullYul cond.toFullYul body.toFullYul

def Stmt.ifElse (cond : Expr) (thenBody elseBody : Stmt) : Stmt :=
  Stmt.seq
    (Stmt.ifThen cond thenBody)
    (Stmt.ifThen (Expr.iszero cond) elseBody)

@[simp] theorem Stmt.ifElse_eq
    (cond : Expr) (thenBody elseBody : Stmt) :
    Stmt.ifElse cond thenBody elseBody =
      Stmt.seq
        (Stmt.ifThen cond thenBody)
        (Stmt.ifThen (Expr.iszero cond) elseBody) := by
  rfl

theorem Stmt.collect_toFullYul
    (stmt : Stmt) (funcs : SolidCoreYulCore.SymYul.FunctionEnv) :
    SolidCoreYulCore.SymYul.collectStmtFunctionDefs stmt.toFullYul funcs = funcs := by
  induction stmt generalizing funcs with
  | skip =>
      rfl
  | expr _ =>
      rfl
  | returnExpr _ =>
      rfl
  | seq first second first_ih second_ih =>
      simp [Stmt.toFullYul, SolidCoreYulCore.SymYul.collectStmtFunctionDefs,
        first_ih, second_ih]
  | block body body_ih =>
      simp [Stmt.toFullYul, SolidCoreYulCore.SymYul.collectStmtFunctionDefs,
        SolidCoreYulCore.SymYul.collectBlockFunctionDefs, body_ih]
  | ifThen _ body body_ih =>
      simp [Stmt.toFullYul, SolidCoreYulCore.SymYul.collectStmtFunctionDefs,
        body_ih]
  | forFalse body body_ih =>
      simp [Stmt.toFullYul, SolidCoreYulCore.SymYul.collectStmtFunctionDefs,
        body_ih]
  | forOnce body body_ih =>
      simp [Stmt.toFullYul, SolidCoreYulCore.SymYul.collectStmtFunctionDefs,
        body_ih]
  | forIf _ body body_ih =>
      simp [Stmt.toFullYul, SolidCoreYulCore.SymYul.collectStmtFunctionDefs,
        body_ih]

theorem Stmt.evalStmtFuel_forFalseFullYul_from
    (fuel : Nat) (state : State) (body : SolidCoreYulCore.FullYul.Stmt) :
    SolidCoreYulCore.SymYul.evalStmtFuel (fuel + 2) state.toConfig
        (SolidCoreYulCore.FullYul.Stmt.forLoop
          SolidCoreYulCore.FullYul.Stmt.skip
          (SolidCoreYulCore.FullYul.Expr.value
            (SolidCoreYulCore.FullYul.Value.word 0))
          SolidCoreYulCore.FullYul.Stmt.skip body) =
      [SolidCoreYulCore.SymYul.normalResult state.toConfig] := by
  cases fuel <;>
    simp [State.toConfig, Body.returnConfig, Body.returnEnv,
      SolidCoreYulCore.SymYul.evalStmtFuel,
      SolidCoreYulCore.SymYul.evalForFuel,
      SolidCoreYulCore.SymYul.evalExpr,
      SolidCoreYulCore.SymYul.evalExprs,
      SolidCoreYulCore.SymYul.branchOn,
      SolidCoreYulCore.SymYul.knownZero?,
      SolidCoreYulCore.SymYul.normalResult,
      SolidCoreYulCore.SymYul.withRestoredConfig,
      SolidCoreYulCore.SymYul.restoreBlockConfig,
      SolidCoreYulCore.FullYul.restoreOuter,
      SolidCoreYulCore.FullYul.lookup?,
      SolidCoreYulCore.norm, SolidCoreYulCore.wordModulus]

theorem Stmt.evalStmtFuel_loopBodyConfig_from
    (extraFuel : Nat) (state : State) (body : Stmt)
    {results : List SolidCoreYulCore.SymYul.Result}
    (hBody :
      SolidCoreYulCore.SymYul.evalStmtFuel
          (body.fuel + extraFuel + 1)
          state.toConfig body.toFullYul =
        results) :
    SolidCoreYulCore.SymYul.evalStmtFuel
        (extraFuel + (1 + body.fuel))
        { pc := SolidCoreYulCore.SymYul.Config.empty.pc,
          env :=
            [(returnName,
              SolidCoreYulCore.FullYul.Value.word state.returnValue)],
          evm := SolidCoreYulCore.SymYul.Config.empty.evm,
          funcs :=
            SolidCoreYulCore.SymYul.collectStmtFunctionDefs
              SolidCoreYulCore.FullYul.Stmt.break
              SolidCoreYulCore.SymYul.Config.empty.funcs,
          object? := SolidCoreYulCore.SymYul.Config.empty.object? }
        body.toFullYul =
      results := by
  simpa [State.toConfig, Body.returnConfig, Body.returnEnv,
    SolidCoreYulCore.SymYul.collectStmtFunctionDefs,
    Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hBody

theorem Stmt.evalStmtFuel_singleIterationLoopFullYul_zero_from
    (extraFuel : Nat) (state : State) (cond : Expr) (body : Stmt)
    (hCond : SolidCoreYulCore.norm cond.eval = 0) :
    SolidCoreYulCore.SymYul.evalStmtFuel
        (body.fuel + 3 + extraFuel + 1)
        state.toConfig
        (Stmt.singleIterationLoopFullYul cond.toFullYul body.toFullYul) =
      (Result.normal state).toSymYulResults := by
  have hZero : cond.eval % SolidCoreYulCore.wordModulus = 0 := by
    simpa [SolidCoreYulCore.norm] using hCond
  have hKnownZero :
      SolidCoreYulCore.SymYul.knownZero?
          (SolidCoreYulCore.FullYul.Value.word cond.eval) =
        some true := by
    simp [SolidCoreYulCore.SymYul.knownZero?,
      SolidCoreYulCore.norm, hZero]
  rw [show body.fuel + 3 + extraFuel + 1 =
      (body.fuel + extraFuel + 3) + 1 by omega]
  rw [show body.fuel + extraFuel + 3 =
      (body.fuel + extraFuel + 2) + 1 by omega]
  simp [State.toConfig, Body.returnConfig, Body.returnEnv,
    Stmt.singleIterationLoopFullYul, Stmt.bodyThenBreakFullYul,
    SolidCoreYulCore.SymYul.evalStmtFuel,
    SolidCoreYulCore.SymYul.evalForFuel,
    SolidCoreYulCore.SymYul.evalExpr,
    SolidCoreYulCore.SymYul.evalExprs,
    SolidCoreYulCore.SymYul.branchOn,
    SolidCoreYulCore.SymYul.normalResult,
    SolidCoreYulCore.SymYul.restoreBlockConfig,
    SolidCoreYulCore.FullYul.restoreOuter,
    SolidCoreYulCore.FullYul.lookup?,
    Result.toSymYulResults,
    SolidCoreYulCore.norm, SolidCoreYulCore.wordModulus,
    Expr.toFullYul_correct_env, hCond, hZero, hKnownZero,
    Nat.add_assoc, Nat.add_comm, Nat.add_left_comm]

theorem Stmt.evalStmtFuel_singleIterationLoopFullYul_nonzero_from
    (extraFuel : Nat) (state : State) (cond : Expr) (body : Stmt)
    (hCond : ¬ SolidCoreYulCore.norm cond.eval = 0)
    (hBody :
      SolidCoreYulCore.SymYul.evalStmtFuel
          (body.fuel + extraFuel + 1)
          state.toConfig body.toFullYul =
        (body.eval state).toSymYulResults) :
    SolidCoreYulCore.SymYul.evalStmtFuel
        (body.fuel + 3 + extraFuel + 1)
        state.toConfig
        (Stmt.singleIterationLoopFullYul cond.toFullYul body.toFullYul) =
      (body.eval state).toSymYulResults := by
  have hNonzero : cond.eval % SolidCoreYulCore.wordModulus ≠ 0 := by
    simpa [SolidCoreYulCore.norm] using hCond
  have hKnownNonzero :
      SolidCoreYulCore.SymYul.knownZero?
          (SolidCoreYulCore.FullYul.Value.word cond.eval) =
        some false := by
    simp [SolidCoreYulCore.SymYul.knownZero?,
      SolidCoreYulCore.norm, hNonzero]
  cases hEval : Stmt.eval state body with
  | normal state' =>
      have hBody' :
          SolidCoreYulCore.SymYul.evalStmtFuel
              (body.fuel + extraFuel + 1)
              state.toConfig body.toFullYul =
            [SolidCoreYulCore.SymYul.normalResult state'.toConfig] := by
        simpa [hEval, Result.toSymYulResults] using hBody
      have hBodySeqConfig :
          SolidCoreYulCore.SymYul.evalStmtFuel
              (extraFuel + (1 + body.fuel))
              { pc := SolidCoreYulCore.SymYul.Config.empty.pc,
                env :=
                  [(returnName,
                    SolidCoreYulCore.FullYul.Value.word state.returnValue)],
                evm := SolidCoreYulCore.SymYul.Config.empty.evm,
                funcs :=
                  SolidCoreYulCore.SymYul.collectStmtFunctionDefs
                    SolidCoreYulCore.FullYul.Stmt.break
                    SolidCoreYulCore.SymYul.Config.empty.funcs,
                object? := SolidCoreYulCore.SymYul.Config.empty.object? }
              body.toFullYul =
            [SolidCoreYulCore.SymYul.normalResult state'.toConfig] :=
        Stmt.evalStmtFuel_loopBodyConfig_from extraFuel state body hBody'
      simp only [hEval, Result.toSymYulResults]
      rw [show body.fuel + 3 + extraFuel + 1 =
          (body.fuel + extraFuel + 3) + 1 by omega]
      rw [show body.fuel + extraFuel + 3 =
          (body.fuel + extraFuel + 2) + 1 by omega]
      simp [State.toConfig, Body.returnConfig, Body.returnEnv,
        Stmt.singleIterationLoopFullYul, Stmt.bodyThenBreakFullYul,
        SolidCoreYulCore.SymYul.evalStmtFuel,
        SolidCoreYulCore.SymYul.evalForFuel,
        SolidCoreYulCore.SymYul.evalExpr,
        SolidCoreYulCore.SymYul.evalExprs,
        SolidCoreYulCore.SymYul.branchOn,
        SolidCoreYulCore.SymYul.bindNormal,
        SolidCoreYulCore.SymYul.normalResult,
        SolidCoreYulCore.SymYul.restoreBlockConfig,
        SolidCoreYulCore.FullYul.restoreOuter,
        SolidCoreYulCore.FullYul.lookup?,
        SolidCoreYulCore.norm, SolidCoreYulCore.wordModulus,
        Expr.toFullYul_correct_env, hCond, hNonzero, hKnownNonzero,
        Stmt.collect_toFullYul, hBody', hBodySeqConfig,
        Nat.add_assoc, Nat.add_comm, Nat.add_left_comm]
  | returned state' =>
      have hBody' :
          SolidCoreYulCore.SymYul.evalStmtFuel
              (body.fuel + extraFuel + 1)
              state.toConfig body.toFullYul =
            [{ flow := SolidCoreYulCore.FullYul.Flow.left,
               config := state'.toConfig }] := by
        simpa [hEval, Result.toSymYulResults] using hBody
      have hBodySeqConfig :
          SolidCoreYulCore.SymYul.evalStmtFuel
              (extraFuel + (1 + body.fuel))
              { pc := SolidCoreYulCore.SymYul.Config.empty.pc,
                env :=
                  [(returnName,
                    SolidCoreYulCore.FullYul.Value.word state.returnValue)],
                evm := SolidCoreYulCore.SymYul.Config.empty.evm,
                funcs :=
                  SolidCoreYulCore.SymYul.collectStmtFunctionDefs
                    SolidCoreYulCore.FullYul.Stmt.break
                    SolidCoreYulCore.SymYul.Config.empty.funcs,
                object? := SolidCoreYulCore.SymYul.Config.empty.object? }
              body.toFullYul =
            [{ flow := SolidCoreYulCore.FullYul.Flow.left,
               config := state'.toConfig }] :=
        Stmt.evalStmtFuel_loopBodyConfig_from extraFuel state body hBody'
      simp only [hEval, Result.toSymYulResults]
      rw [show body.fuel + 3 + extraFuel + 1 =
          (body.fuel + extraFuel + 3) + 1 by omega]
      rw [show body.fuel + extraFuel + 3 =
          (body.fuel + extraFuel + 2) + 1 by omega]
      simp [State.toConfig, Body.returnConfig, Body.returnEnv,
        Stmt.singleIterationLoopFullYul, Stmt.bodyThenBreakFullYul,
        SolidCoreYulCore.SymYul.evalStmtFuel,
        SolidCoreYulCore.SymYul.evalForFuel,
        SolidCoreYulCore.SymYul.evalExpr,
        SolidCoreYulCore.SymYul.evalExprs,
        SolidCoreYulCore.SymYul.branchOn,
        SolidCoreYulCore.SymYul.bindNormal,
        SolidCoreYulCore.SymYul.normalResult,
        SolidCoreYulCore.SymYul.restoreBlockConfig,
        SolidCoreYulCore.FullYul.restoreOuter,
        SolidCoreYulCore.FullYul.lookup?,
        SolidCoreYulCore.norm, SolidCoreYulCore.wordModulus,
        Expr.toFullYul_correct_env, hCond, hNonzero, hKnownNonzero,
        Stmt.collect_toFullYul, hBody', hBodySeqConfig,
        Nat.add_assoc, Nat.add_comm, Nat.add_left_comm]

theorem Stmt.evalStmtFuel_ifThen_zero_from
    (extraFuel : Nat) (state : State) (cond : Expr) (body : Stmt)
    (hCond : SolidCoreYulCore.norm cond.eval = 0) :
    SolidCoreYulCore.SymYul.evalStmtFuel
        (body.fuel + 1 + extraFuel + 1)
        state.toConfig
        (SolidCoreYulCore.FullYul.Stmt.ifThen cond.toFullYul
          body.toFullYul) =
      (Result.normal state).toSymYulResults := by
  have hZero : cond.eval % SolidCoreYulCore.wordModulus = 0 := by
    simpa [SolidCoreYulCore.norm] using hCond
  cases extraFuel <;>
    simp [SolidCoreYulCore.SymYul.evalStmtFuel,
      SolidCoreYulCore.SymYul.evalExpr,
      SolidCoreYulCore.SymYul.evalExprs,
      SolidCoreYulCore.SymYul.branchOn,
      SolidCoreYulCore.SymYul.knownZero?,
      SolidCoreYulCore.norm, hCond, hZero,
      Result.toSymYulResults, Expr.toFullYul_correct_env]

theorem Stmt.evalStmtFuel_ifThen_nonzero_from
    (extraFuel : Nat) (state : State) (cond : Expr) (body : Stmt)
    (hCond : ¬ SolidCoreYulCore.norm cond.eval = 0)
    (hBody :
      SolidCoreYulCore.SymYul.evalStmtFuel
          (body.fuel + extraFuel + 1)
          state.toConfig body.toFullYul =
        (body.eval state).toSymYulResults) :
    SolidCoreYulCore.SymYul.evalStmtFuel
        (body.fuel + 1 + extraFuel + 1)
        state.toConfig
        (SolidCoreYulCore.FullYul.Stmt.ifThen cond.toFullYul
          body.toFullYul) =
      (body.eval state).toSymYulResults := by
  have hBody' :
      SolidCoreYulCore.SymYul.evalStmtFuel
          (body.fuel + 1 + extraFuel)
          state.toConfig body.toFullYul =
        (body.eval state).toSymYulResults := by
    simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hBody
  have hNonzero : cond.eval % SolidCoreYulCore.wordModulus ≠ 0 := by
    simpa [SolidCoreYulCore.norm] using hCond
  cases extraFuel <;>
    simp [SolidCoreYulCore.SymYul.evalStmtFuel,
      SolidCoreYulCore.SymYul.evalExpr,
      SolidCoreYulCore.SymYul.evalExprs,
      SolidCoreYulCore.SymYul.branchOn,
      SolidCoreYulCore.SymYul.knownZero?,
      SolidCoreYulCore.norm, hCond, hNonzero,
      Expr.toFullYul_correct_env, hBody']

theorem Stmt.toFullYul_correct_from
    (extraFuel : Nat) (state : State) (stmt : Stmt) :
    SolidCoreYulCore.SymYul.evalStmtFuel (stmt.fuel + extraFuel + 1)
        state.toConfig stmt.toFullYul =
      (stmt.eval state).toSymYulResults := by
  induction stmt generalizing state extraFuel with
  | skip =>
      cases extraFuel <;>
        simp [Stmt.fuel, Stmt.toFullYul, Stmt.eval, Result.toSymYulResults,
          State.toConfig, SolidCoreYulCore.SymYul.evalStmtFuel]
  | expr e =>
      cases extraFuel <;>
        simp [Stmt.fuel, Stmt.toFullYul, Stmt.eval, Result.toSymYulResults,
          State.toConfig, Body.returnConfig,
          SolidCoreYulCore.SymYul.evalStmtFuel]
  | returnExpr e =>
      cases extraFuel <;>
        simp [Stmt.fuel, Stmt.toFullYul, Stmt.eval, Result.toSymYulResults,
          State.toConfig, Body.returnConfig, Body.returnEnv,
          SolidCoreYulCore.SymYul.evalStmtFuel,
          SolidCoreYulCore.SymYul.bindNormal,
          SolidCoreYulCore.SymYul.normalResult,
          SolidCoreYulCore.SymYul.collectStmtFunctionDefs,
          SolidCoreYulCore.FullYul.assign?,
          Expr.toFullYul_correct_env]
  | seq first second first_ih second_ih =>
      cases hFirst : Stmt.eval state first with
      | normal state' =>
          have hEvalFirst :
              SolidCoreYulCore.SymYul.evalStmtFuel
                  (first.fuel + (second.fuel + extraFuel) + 1)
                  state.toConfig first.toFullYul =
                [SolidCoreYulCore.SymYul.normalResult state'.toConfig] := by
            simpa [hFirst, Result.toSymYulResults] using
              first_ih (second.fuel + extraFuel) state
          have hEvalSecond :
              SolidCoreYulCore.SymYul.evalStmtFuel
                  (second.fuel + (first.fuel + extraFuel) + 1)
                  state'.toConfig second.toFullYul =
                (Stmt.eval state' second).toSymYulResults := by
            exact second_ih (first.fuel + extraFuel) state'
          simp only [Stmt.fuel, Stmt.toFullYul, Stmt.eval, hFirst]
          change
            SolidCoreYulCore.SymYul.evalStmtFuel
                (first.fuel + second.fuel + 1 + extraFuel + 1)
                state.toConfig
                (SolidCoreYulCore.FullYul.Stmt.seq first.toFullYul
                  second.toFullYul) =
              (Stmt.eval state' second).toSymYulResults
          have hEvalFirst' :
              SolidCoreYulCore.SymYul.evalStmtFuel
                  (first.fuel + second.fuel + 1 + extraFuel)
                  state.toConfig first.toFullYul =
                [SolidCoreYulCore.SymYul.normalResult state'.toConfig] := by
            simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
              hEvalFirst
          have hEvalSecond' :
              SolidCoreYulCore.SymYul.evalStmtFuel
                  (first.fuel + second.fuel + 1 + extraFuel)
                  state'.toConfig second.toFullYul =
                (Stmt.eval state' second).toSymYulResults := by
            simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
              hEvalSecond
          simp [SolidCoreYulCore.SymYul.evalStmtFuel,
            SolidCoreYulCore.SymYul.bindNormal,
            SolidCoreYulCore.SymYul.normalResult,
            SolidCoreYulCore.SymYul.collectStmtFunctionDefs,
            Stmt.collect_toFullYul, hEvalFirst', hEvalSecond']
      | returned state' =>
          have hEvalFirst :
              SolidCoreYulCore.SymYul.evalStmtFuel
                  (first.fuel + (second.fuel + extraFuel) + 1)
                  state.toConfig first.toFullYul =
                [{ flow := SolidCoreYulCore.FullYul.Flow.left,
                   config := state'.toConfig }] := by
            simpa [hFirst, Result.toSymYulResults] using
              first_ih (second.fuel + extraFuel) state
          simp only [Stmt.fuel, Stmt.toFullYul, Stmt.eval, hFirst]
          change
            SolidCoreYulCore.SymYul.evalStmtFuel
                (first.fuel + second.fuel + 1 + extraFuel + 1)
                state.toConfig
                (SolidCoreYulCore.FullYul.Stmt.seq first.toFullYul
                  second.toFullYul) =
              [{ flow := SolidCoreYulCore.FullYul.Flow.left,
                 config := state'.toConfig }]
          have hEvalFirst' :
              SolidCoreYulCore.SymYul.evalStmtFuel
                  (first.fuel + second.fuel + 1 + extraFuel)
                  state.toConfig first.toFullYul =
                [{ flow := SolidCoreYulCore.FullYul.Flow.left,
                   config := state'.toConfig }] := by
            simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
              hEvalFirst
          simp [SolidCoreYulCore.SymYul.evalStmtFuel,
            SolidCoreYulCore.SymYul.bindNormal,
            SolidCoreYulCore.SymYul.collectStmtFunctionDefs,
            Stmt.collect_toFullYul, hEvalFirst']
  | block body body_ih =>
      have hBody :
          SolidCoreYulCore.SymYul.evalBlockFuel (body.fuel + extraFuel + 2)
              state.toConfig [body.toFullYul] =
            (Stmt.eval state body).toSymYulResults := by
        have hStmt := body_ih extraFuel state
        cases hBodyEval : Stmt.eval state body with
        | normal bodyState =>
            have hStmt' :
                SolidCoreYulCore.SymYul.evalStmtFuel
                    (extraFuel + (1 + body.fuel))
                    state.toConfig body.toFullYul =
                  [SolidCoreYulCore.SymYul.normalResult bodyState.toConfig] := by
              simpa [hBodyEval, Result.toSymYulResults,
                Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hStmt
            simp [SolidCoreYulCore.SymYul.evalBlockFuel,
              SolidCoreYulCore.SymYul.bindNormal,
              SolidCoreYulCore.SymYul.normalResult,
              hStmt', Result.toSymYulResults,
              Nat.add_assoc, Nat.add_comm, Nat.add_left_comm]
        | returned bodyState =>
            have hStmt' :
                SolidCoreYulCore.SymYul.evalStmtFuel
                    (extraFuel + (1 + body.fuel))
                    state.toConfig body.toFullYul =
                  [bodyState.leftResult] := by
              simpa [hBodyEval, Result.toSymYulResults, State.leftResult,
                Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hStmt
            simp [SolidCoreYulCore.SymYul.evalBlockFuel,
              SolidCoreYulCore.SymYul.bindNormal,
              SolidCoreYulCore.SymYul.normalResult,
              hStmt', Result.toSymYulResults, State.leftResult,
              Nat.add_assoc, Nat.add_comm, Nat.add_left_comm]
      cases hEval : Stmt.eval state body with
      | normal state' =>
          have hBody' :
              SolidCoreYulCore.SymYul.evalBlockFuel (extraFuel + (2 + body.fuel))
                  ({ state.toConfig with funcs := state.toConfig.funcs })
                  [body.toFullYul] =
                [SolidCoreYulCore.SymYul.normalResult state'.toConfig] := by
            simpa [hEval, Result.toSymYulResults,
              Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hBody
          have hBody'' :
              SolidCoreYulCore.SymYul.evalBlockFuel (extraFuel + (2 + body.fuel))
                  { pc := state.toConfig.pc,
                    env := state.toConfig.env,
                    evm := state.toConfig.evm,
                    funcs := state.toConfig.funcs,
                    object? := state.toConfig.object? }
                  [body.toFullYul] =
                [SolidCoreYulCore.SymYul.normalResult state'.toConfig] := by
            simpa using hBody'
          simp only [Stmt.fuel, Stmt.toFullYul, Stmt.eval, hEval,
            Result.toSymYulResults]
          simp [Stmt.fuel, Stmt.toFullYul, Stmt.eval,
            SolidCoreYulCore.SymYul.evalStmtFuel,
            SolidCoreYulCore.SymYul.collectBlockFunctionDefs,
            Stmt.collect_toFullYul, hEval, hBody'',
            State.withRestoredConfig_normal, Result.toSymYulResults,
            Nat.add_assoc, Nat.add_comm, Nat.add_left_comm]
      | returned state' =>
          have hBody' :
              SolidCoreYulCore.SymYul.evalBlockFuel (extraFuel + (2 + body.fuel))
                  ({ state.toConfig with funcs := state.toConfig.funcs })
                  [body.toFullYul] =
                [state'.leftResult] := by
            simpa [hEval, Result.toSymYulResults, State.leftResult,
              Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hBody
          have hBody'' :
              SolidCoreYulCore.SymYul.evalBlockFuel (extraFuel + (2 + body.fuel))
                  { pc := state.toConfig.pc,
                    env := state.toConfig.env,
                    evm := state.toConfig.evm,
                    funcs := state.toConfig.funcs,
                    object? := state.toConfig.object? }
                  [body.toFullYul] =
                [state'.leftResult] := by
            simpa using hBody'
          have hRestore :
              SolidCoreYulCore.SymYul.withRestoredConfig state.toConfig
                  { flow := SolidCoreYulCore.FullYul.Flow.left,
                    config := state'.toConfig } =
                some { flow := SolidCoreYulCore.FullYul.Flow.left,
                       config := state'.toConfig } := by
            simpa [State.leftResult] using
              State.withRestoredConfig_left state state'
          simp only [Stmt.fuel, Stmt.toFullYul, Stmt.eval, hEval,
            Result.toSymYulResults]
          simp [Stmt.fuel, Stmt.toFullYul, Stmt.eval,
            SolidCoreYulCore.SymYul.evalStmtFuel,
            SolidCoreYulCore.SymYul.collectBlockFunctionDefs,
            Stmt.collect_toFullYul, hEval, hBody'', hRestore,
            Result.toSymYulResults, State.leftResult,
            Nat.add_assoc, Nat.add_comm, Nat.add_left_comm]
  | ifThen cond body body_ih =>
      by_cases hCond : SolidCoreYulCore.norm cond.eval = 0
      · have hIf :=
          Stmt.evalStmtFuel_ifThen_zero_from extraFuel state cond body hCond
        simpa [Stmt.fuel, Stmt.toFullYul, Stmt.eval, hCond, if_true]
          using hIf
      · have hBody :
            SolidCoreYulCore.SymYul.evalStmtFuel
                (body.fuel + extraFuel + 1)
                state.toConfig body.toFullYul =
              (Stmt.eval state body).toSymYulResults :=
          body_ih extraFuel state
        have hIf :=
          Stmt.evalStmtFuel_ifThen_nonzero_from
            extraFuel state cond body hCond hBody
        simpa [Stmt.fuel, Stmt.toFullYul, Stmt.eval, hCond, if_false]
          using hIf
  | forFalse body body_ih =>
      have h :=
        Stmt.evalStmtFuel_forFalseFullYul_from
          (body.fuel + extraFuel) state body.toFullYul
      rw [show (body.fuel + extraFuel) + 2 =
          body.fuel + 1 + extraFuel + 1 by omega] at h
      simpa [Stmt.fuel, Stmt.toFullYul, Stmt.eval,
        Result.toSymYulResults] using h
  | forOnce body body_ih =>
      have hCondOne : ¬ SolidCoreYulCore.norm (Expr.lit 1).eval = 0 := by
        decide
      have hLoop :=
        Stmt.evalStmtFuel_singleIterationLoopFullYul_nonzero_from
          extraFuel state (Expr.lit 1) body hCondOne
          (body_ih extraFuel state)
      simpa [Stmt.fuel, Stmt.toFullYul, Stmt.eval, Expr.toFullYul,
        Expr.eval, SolidCoreYulCore.norm, SolidCoreYulCore.wordModulus]
        using hLoop
  | forIf cond body body_ih =>
      by_cases hCond : SolidCoreYulCore.norm cond.eval = 0
      · have hLoop :=
          Stmt.evalStmtFuel_singleIterationLoopFullYul_zero_from
            extraFuel state cond body hCond
        simpa [Stmt.fuel, Stmt.toFullYul, Stmt.eval, hCond, if_true]
          using hLoop
      · have hLoop :=
          Stmt.evalStmtFuel_singleIterationLoopFullYul_nonzero_from
            extraFuel state cond body hCond (body_ih extraFuel state)
        simpa [Stmt.fuel, Stmt.toFullYul, Stmt.eval, hCond, if_false]
          using hLoop

