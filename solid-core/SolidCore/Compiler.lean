        Program.initialStaticContext false true stmt.toFullYul =
      some Program.initialStaticContext := by
  have hStructured :=
    Structured.Stmt.toFullYul_staticChecked_from 1 stmt.toStructured
  rw [hFuel, hFullYul]
  rw [show stmt.toStructured.fuel + 2 =
