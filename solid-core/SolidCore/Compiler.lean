    {builtin : SolidCoreYulCore.Evm.Builtin}
    (hBuiltin :
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore.builtinOK
        builtin)
    {first second third : SolidCoreYulCore.FullYul.Expr}
    (hFirst :
      SolidCoreYulCore.FullYul.CompilerEmittableExpr
        SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore first)
    (hSecond :
      SolidCoreYulCore.FullYul.CompilerEmittableExpr
        SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore second)
    (hThird :
      SolidCoreYulCore.FullYul.CompilerEmittableExpr
