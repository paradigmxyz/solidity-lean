      false false stmt Solidity.Program.initialStaticContext

def compileStaticStmtArtifact (source : String) :
    Option StaticFullYulStmtArtifact :=
  match compileSourceToCoreArtifact source with
  | some sourceToCore =>
      let coreToFullYul : CoreFullYulStmtArtifact :=
        { source := sourceToCore.source
          core := sourceToCore.core
          stmt := compileCoreToFullYulStmt sourceToCore.core
          core_compiled := sourceToCore.compiled
          emitted := rfl
          compiled_via_core := by
            simp [compileToFullYulStmtViaCore, sourceToCore.compiled,
              compileCoreToFullYulStmt] }
      some
        { source := sourceToCore.source
          program := sourceToCore.program
          stmt := coreToFullYul.stmt
          sourceToCore := sourceToCore
          sourceToCore_source := rfl
          sourceToCore_program := rfl
          sourceToCore_emitted := by
            simp [coreToFullYul, compileCoreToFullYulStmt]
          coreToFullYul := coreToFullYul
          coreToFullYul_source := rfl
          coreToFullYul_core := rfl
          coreToFullYul_stmt := rfl
          parsed := sourceToCore.parsed
          compiled := by
            simp [compileToFullYulStmt, compileToFullYulStmtViaCore,
              compileToCore?, sourceToCore.parsed, sourceToCore.elaborated,
              coreToFullYul, compileCoreToFullYulStmt]
          eval_sound :=
            by
              simpa [coreToFullYul, compileCoreToFullYulStmt] using
                Solidity.Program.core_toFullYul_correct_of_some
                  sourceToCore.elaborated
          static_checked :=
            by
              simpa [coreToFullYul, compileCoreToFullYulStmt] using
                core_toFullYul_staticChecked_of_some
                  sourceToCore.elaborated
          accepted_currentSolidCore :=
            by
              simpa [coreToFullYul, compileCoreToFullYulStmt] using
                core_toFullYul_accepted_currentSolidCore_of_some
                  sourceToCore.elaborated
          eval_sound_with_coreFuel := by
            simpa [coreToFullYul, compileCoreToFullYulStmt] using
              sourceToCore.fullYul_eval_sound
          static_checked_with_coreFuel := by
            simpa [coreToFullYul, compileCoreToFullYulStmt] using
              sourceToCore.fullYul_static_checked
          accepted_currentSolidCore_with_coreFuel := by
            simpa [coreToFullYul, compileCoreToFullYulStmt] using
              sourceToCore.fullYul_accepted_currentSolidCore_with_coreFuel }
  | none => none

theorem compileStaticStmtArtifact_source
    {source : String} {artifact : StaticFullYulStmtArtifact}
    (hCompile : compileStaticStmtArtifact source = some artifact) :
    artifact.source = source := by
  unfold compileStaticStmtArtifact at hCompile
  cases hSourceToCore : compileSourceToCoreArtifact source with
  | some sourceToCore =>
      simp [hSourceToCore] at hCompile
      cases hCompile
      exact compileSourceToCoreArtifact_source hSourceToCore
  | none =>
      simp [hSourceToCore] at hCompile

theorem compileStaticStmtArtifact_map_stmt
    (source : String) :
    (compileStaticStmtArtifact source).map
        (fun artifact => artifact.stmt) =
      compileToFullYulStmt source := by
  unfold compileStaticStmtArtifact
  cases hSourceToCore : compileSourceToCoreArtifact source with
  | some sourceToCore =>
      have hSource :=
        compileSourceToCoreArtifact_source hSourceToCore
      have hCompiled :
          compileToCore? source = some sourceToCore.core := by
        simpa [hSource] using sourceToCore.compiled
      simp [hSourceToCore, compileToFullYulStmt,
        compileToFullYulStmtViaCore, hCompiled,
        compileCoreToFullYulStmt]
  | none =>
      have hMap := compileSourceToCoreArtifact_map_core source
      rw [hSourceToCore] at hMap
      unfold compileToFullYulStmt
      unfold compileToFullYulStmtViaCore
      rw [← hMap]
      simp

theorem compileStaticStmtArtifact_isSome
    (source : String) :
    (compileStaticStmtArtifact source).isSome =
      (compileToFullYulStmt source).isSome := by
  rw [← compileStaticStmtArtifact_map_stmt source]
  cases compileStaticStmtArtifact source <;> rfl

theorem compileStaticStmtArtifact_none_iff
    (source : String) :
    compileStaticStmtArtifact source = none ↔
      compileToFullYulStmt source = none := by
  constructor
  · intro hArtifact
    have hMap := compileStaticStmtArtifact_map_stmt source
    simpa [hArtifact] using hMap.symm
  · intro hStmt
    cases hArtifact : compileStaticStmtArtifact source with
    | none => rfl
    | some artifact =>
        have hMap := compileStaticStmtArtifact_map_stmt source
        rw [hArtifact, hStmt] at hMap
        cases hMap

theorem compileStaticStmtArtifact_some_stmt_iff
    {source : String} {stmt : SolidCoreYulCore.FullYul.Stmt} :
    (∃ artifact,
      compileStaticStmtArtifact source = some artifact ∧
      artifact.stmt = stmt) ↔
      compileToFullYulStmt source = some stmt := by
  constructor
  · intro hArtifact
    rcases hArtifact with ⟨artifact, hArtifact, hStmt⟩
    have hMap := compileStaticStmtArtifact_map_stmt source
    rw [hArtifact] at hMap
    simpa [hStmt] using hMap.symm
  · intro hCompile
    cases hArtifact : compileStaticStmtArtifact source with
    | some artifact =>
        have hMap := compileStaticStmtArtifact_map_stmt source
        rw [hArtifact, hCompile] at hMap
        cases hMap
        exact ⟨artifact, rfl, rfl⟩
    | none =>
        have hMap := compileStaticStmtArtifact_map_stmt source
        rw [hArtifact, hCompile] at hMap
        cases hMap

theorem StaticFullYulStmtArtifact.sourceToCore_sound
    (artifact : StaticFullYulStmtArtifact) :
    parse artifact.source = some artifact.program ∧
    artifact.program.toCore? = some artifact.sourceToCore.core ∧
    compileToCore? artifact.source = some artifact.sourceToCore.core ∧
    artifact.sourceToCore.core.toFullYul = artifact.stmt := by
  exact ⟨artifact.parsed,
    by
      simpa [artifact.sourceToCore_program] using
        artifact.sourceToCore.elaborated,
