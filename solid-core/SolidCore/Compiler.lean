def compileAnyStaticStmtArtifact (source : String) :
    Option AnyStaticFullYulStmtArtifact :=
  match compileCheckedStaticStmtArtifact source with
  | some artifact => some (AnyStaticFullYulStmtArtifact.checked artifact)
  | none =>
      match compileStaticStmtArtifact source with
      | some artifact => some (AnyStaticFullYulStmtArtifact.unchecked artifact)
