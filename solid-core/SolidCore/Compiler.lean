def Program.storageOverwriteReadCore : Core.Storage.Stmt :=
  Core.Storage.Stmt.writeWriteRead
    (Core.TypedExpr.lit 0) (Core.TypedExpr.lit 3) (Core.TypedExpr.lit 9)

def Program.storagePairReadAddCore : Core.Storage.Stmt :=
