inductive BodyStmt where
  | returnExpr : PureExpr -> BodyStmt
  | seqExpr : PureExpr -> BodyStmt -> BodyStmt
  | block : BodyStmt -> BodyStmt
  | localValue : PureExpr -> BodyStmt
  | localUpdateValue : PureExpr -> PureExpr -> BodyStmt
  | localPairAddValue : PureExpr -> PureExpr -> BodyStmt
  | localPairUpdateAddValue :
      PureExpr -> PureExpr -> PureExpr -> PureExpr -> BodyStmt
  | forNeverReturn : PureExpr -> PureExpr -> BodyStmt
  | forBreakReturn : PureExpr -> BodyStmt
  | forContinueReturn : PureExpr -> BodyStmt
  | internalCallReturn : BodyStmt
  | ifReturn : PureExpr -> PureExpr -> PureExpr -> BodyStmt
  | ifThenBodyElseReturn : PureExpr -> BodyStmt -> PureExpr -> BodyStmt
  | ifThenReturnElseBody : PureExpr -> PureExpr -> BodyStmt -> BodyStmt
  deriving DecidableEq, Repr

def BodyStmt.toBody : BodyStmt -> Body
  | BodyStmt.returnExpr expr => Body.returnExpr expr.toExpr
  | BodyStmt.seqExpr expr rest => Body.seqExpr expr.toExpr rest.toBody
  | BodyStmt.block body => Body.block body.toBody
  | BodyStmt.localValue init => Body.localValue init.toExpr
  | BodyStmt.localUpdateValue init assigned =>
      Body.localUpdateValue init.toExpr assigned.toExpr
  | BodyStmt.localPairAddValue lhs rhs =>
      Body.localPairAddValue lhs.toExpr rhs.toExpr
  | BodyStmt.localPairUpdateAddValue initLhs initRhs assignedLhs assignedRhs =>
      Body.localPairUpdateAddValue initLhs.toExpr initRhs.toExpr
        assignedLhs.toExpr assignedRhs.toExpr
  | BodyStmt.forNeverReturn afterExpr loopExpr =>
      Body.forNeverReturn afterExpr.toExpr loopExpr.toExpr
  | BodyStmt.forBreakReturn afterExpr =>
      Body.forBreakReturn afterExpr.toExpr
  | BodyStmt.forContinueReturn afterExpr =>
      Body.forContinueReturn afterExpr.toExpr
  | BodyStmt.internalCallReturn => Body.internalCallReturn
  | BodyStmt.ifReturn cond thenExpr elseExpr =>
      Body.ifReturn cond.toExpr thenExpr.toExpr elseExpr.toExpr
  | BodyStmt.ifThenBodyElseReturn cond thenBody elseExpr =>
      Body.ifThenBodyElseReturn cond.toExpr thenBody.toBody elseExpr.toExpr
  | BodyStmt.ifThenReturnElseBody cond thenExpr elseBody =>
      Body.ifThenReturnElseBody cond.toExpr thenExpr.toExpr elseBody.toBody

def BodyStmt.ofBody : Body -> BodyStmt
  | Body.returnExpr expr => BodyStmt.returnExpr (PureExpr.ofExpr expr)
  | Body.seqExpr expr rest =>
      BodyStmt.seqExpr (PureExpr.ofExpr expr) (BodyStmt.ofBody rest)
  | Body.block body => BodyStmt.block (BodyStmt.ofBody body)
  | Body.localValue init => BodyStmt.localValue (PureExpr.ofExpr init)
  | Body.localUpdateValue init assigned =>
      BodyStmt.localUpdateValue (PureExpr.ofExpr init) (PureExpr.ofExpr assigned)
  | Body.localPairAddValue lhs rhs =>
      BodyStmt.localPairAddValue (PureExpr.ofExpr lhs) (PureExpr.ofExpr rhs)
  | Body.localPairUpdateAddValue initLhs initRhs assignedLhs assignedRhs =>
      BodyStmt.localPairUpdateAddValue (PureExpr.ofExpr initLhs)
        (PureExpr.ofExpr initRhs) (PureExpr.ofExpr assignedLhs)
        (PureExpr.ofExpr assignedRhs)
  | Body.forNeverReturn afterExpr loopExpr =>
      BodyStmt.forNeverReturn (PureExpr.ofExpr afterExpr)
        (PureExpr.ofExpr loopExpr)
  | Body.forBreakReturn afterExpr =>
      BodyStmt.forBreakReturn (PureExpr.ofExpr afterExpr)
  | Body.forContinueReturn afterExpr =>
      BodyStmt.forContinueReturn (PureExpr.ofExpr afterExpr)
  | Body.internalCallReturn => BodyStmt.internalCallReturn
  | Body.ifReturn cond thenExpr elseExpr =>
      BodyStmt.ifReturn (PureExpr.ofExpr cond) (PureExpr.ofExpr thenExpr)
        (PureExpr.ofExpr elseExpr)
  | Body.ifThenBodyElseReturn cond thenBody elseExpr =>
      BodyStmt.ifThenBodyElseReturn (PureExpr.ofExpr cond)
        (BodyStmt.ofBody thenBody) (PureExpr.ofExpr elseExpr)
  | Body.ifThenReturnElseBody cond thenExpr elseBody =>
      BodyStmt.ifThenReturnElseBody (PureExpr.ofExpr cond)
        (PureExpr.ofExpr thenExpr) (BodyStmt.ofBody elseBody)

def BodyStmt.noFun : BodyStmt -> Bool
  | BodyStmt.returnExpr _ => true
  | BodyStmt.seqExpr _ rest => rest.noFun
  | BodyStmt.block body => body.noFun
  | BodyStmt.localValue _ => true
  | BodyStmt.localUpdateValue _ _ => true
  | BodyStmt.localPairAddValue _ _ => true
  | BodyStmt.localPairUpdateAddValue _ _ _ _ => true
  | BodyStmt.forNeverReturn _ _ => true
  | BodyStmt.forBreakReturn _ => true
  | BodyStmt.forContinueReturn _ => true
  | BodyStmt.internalCallReturn => false
  | BodyStmt.ifReturn _ _ _ => true
  | BodyStmt.ifThenBodyElseReturn _ thenBody _ => thenBody.noFun
  | BodyStmt.ifThenReturnElseBody _ _ elseBody => elseBody.noFun

theorem BodyStmt.toBody_noFun (stmt : BodyStmt) :
    stmt.toBody.noFun = stmt.noFun := by
  induction stmt <;>
    simp [BodyStmt.toBody, BodyStmt.noFun, Body.noFun, *]

def BodyStmt.ofBodyNoFun? (body : Body) : Option BodyStmt :=
  if body.noFun then some (BodyStmt.ofBody body) else none

@[simp] theorem BodyStmt.toBody_ofBody (body : Body) :
    (BodyStmt.ofBody body).toBody = body := by
  induction body <;> simp [BodyStmt.ofBody, BodyStmt.toBody, *]

@[simp] theorem BodyStmt.ofBody_noFun (body : Body) :
    (BodyStmt.ofBody body).noFun = body.noFun := by
  induction body <;> simp [BodyStmt.ofBody, BodyStmt.noFun, Body.noFun, *]

theorem BodyStmt.ofBodyNoFun?_of_noFun
    {body : Body} (hNoFun : (BodyStmt.ofBody body).noFun = true) :
    BodyStmt.ofBodyNoFun? body = some (BodyStmt.ofBody body) := by
  simpa [BodyStmt.ofBodyNoFun?] using hNoFun

theorem BodyStmt.ofBodyNoFun?_of_body_noFun
    {body : Body} (hNoFun : body.noFun = true) :
    BodyStmt.ofBodyNoFun? body = some (BodyStmt.ofBody body) := by
  simp [BodyStmt.ofBodyNoFun?, hNoFun]

theorem BodyStmt.ofBodyNoFun?_some_noFun
    {body : Body} {stmt : BodyStmt}
    (h : BodyStmt.ofBodyNoFun? body = some stmt) :
    stmt.noFun = true := by
  by_cases hNoFun : body.noFun = true
  · simp [BodyStmt.ofBodyNoFun?, hNoFun] at h
    cases h
    simpa using hNoFun
  · simp [BodyStmt.ofBodyNoFun?, hNoFun] at h

theorem BodyStmt.ofBodyNoFun?_some_body_noFun
    {body : Body} {stmt : BodyStmt}
    (h : BodyStmt.ofBodyNoFun? body = some stmt) :
    body.noFun = true := by
  by_cases hNoFun : body.noFun = true
  · exact hNoFun
  · simp [BodyStmt.ofBodyNoFun?, hNoFun] at h

theorem BodyStmt.ofBodyNoFun?_some_toBody
    {body : Body} {stmt : BodyStmt}
    (h : BodyStmt.ofBodyNoFun? body = some stmt) :
    stmt.toBody = body := by
  by_cases hNoFun : body.noFun = true
  · simp [BodyStmt.ofBodyNoFun?, hNoFun] at h
    cases h
    exact BodyStmt.toBody_ofBody body
  · simp [BodyStmt.ofBodyNoFun?, hNoFun] at h

def BodyStmt.eval (stmt : BodyStmt) : Word :=
  stmt.toBody.eval

def BodyStmt.fuel (stmt : BodyStmt) : Nat :=
  stmt.toBody.fuel

def BodyStmt.toFullYul (stmt : BodyStmt) : SolidCoreYulCore.FullYul.Stmt :=
  stmt.toBody.toFullYul

theorem BodyStmt.toFullYul_correct (stmt : BodyStmt) :
    SolidCoreYulCore.SymYul.evalStmtFuel stmt.fuel
        Body.initialSymYulConfig stmt.toFullYul =
      [SolidCoreYulCore.SymYul.normalResult
        (Body.returnConfig stmt.eval)] := by
  simpa [BodyStmt.fuel, BodyStmt.toFullYul, BodyStmt.eval,
    Body.finalSymYulConfig] using
      Body.toFullYul_correct stmt.toBody

theorem BodyStmt.predeclare_toFullYul_of_noFun
    (ctx : SolidCoreYulCore.FullYul.StaticContext) {stmt : BodyStmt}
    (hNoFun : stmt.noFun = true) :
    SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?
        ctx stmt.toFullYul =
      some ctx := by
  have hBodyNoFun : stmt.toBody.noFun = true := by
    rw [BodyStmt.toBody_noFun]
    exact hNoFun
  simpa [BodyStmt.toFullYul] using
    Body.predeclare_toFullYul_of_noFun ctx hBodyNoFun

theorem BodyStmt.stmtHasNoFunDefs_toFullYul_of_noFun
    {stmt : BodyStmt} (hNoFun : stmt.noFun = true) :
    SolidCoreYulCore.FullYul.stmtHasNoFunDefs stmt.toFullYul = true := by
  have hBodyNoFun : stmt.toBody.noFun = true := by
    rw [BodyStmt.toBody_noFun]
    exact hNoFun
  simpa [BodyStmt.toFullYul] using
    Body.stmtHasNoFunDefs_toFullYul_of_noFun hBodyNoFun

theorem BodyStmt.toFullYul_staticChecked_of_noFun
    (stmt : BodyStmt) (hNoFun : stmt.noFun = true) :
    SolidCoreYulCore.FullYul.checkStmtFuel stmt.fuel.succ
        Program.initialStaticContext false false stmt.toFullYul =
      some Program.initialStaticContext := by
  have hBodyNoFun : stmt.toBody.noFun = true := by
    rw [BodyStmt.toBody_noFun]
    exact hNoFun
  simpa [BodyStmt.fuel, BodyStmt.toFullYul] using
    Body.toFullYul_staticChecked_of_noFun stmt.toBody hBodyNoFun

theorem BodyStmt.toFullYul_compilerEmittable (stmt : BodyStmt) :
    SolidCoreYulCore.FullYul.CompilerEmittableStmt
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      stmt.toFullYul := by
  simpa [BodyStmt.toFullYul] using
    Body.toFullYul_compilerEmittable stmt.toBody

theorem BodyStmt.toFullYul_accepted_currentSolidCore_of_noFun
    (stmt : BodyStmt) (hNoFun : stmt.noFun = true) :
    SolidCoreYulCore.FullYul.CompilerAcceptedStmt
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      stmt.fuel.succ Program.initialStaticContext false false
      stmt.toFullYul Program.initialStaticContext := by
  exact
    { emittable := BodyStmt.toFullYul_compilerEmittable stmt
      checked := BodyStmt.toFullYul_staticChecked_of_noFun stmt hNoFun }

theorem BodyStmt.returnExpr_toFullYul_staticChecked (expr : PureExpr) :
    SolidCoreYulCore.FullYul.checkStmtFuel
        (BodyStmt.returnExpr expr).fuel.succ
        Program.initialStaticContext false false
        (BodyStmt.returnExpr expr).toFullYul =
      some Program.initialStaticContext := by
  simp [BodyStmt.fuel, BodyStmt.toFullYul, BodyStmt.toBody,
    Body.toFullYul, Body.fuel, Program.initialStaticContext, returnName,
    SolidCoreYulCore.FullYul.checkStmtFuel,
    SolidCoreYulCore.FullYul.checkExpr,
    SolidCoreYulCore.FullYul.containsName,
    Expr.toFullYul_staticChecked]

namespace InternalCall

inductive Stmt where
  | noArgReturn : Stmt
  | argReturn : Stmt
  | multiReturn : Stmt
  deriving DecidableEq, Repr

def Stmt.toFrame :
    Stmt -> _root_.SolidCore.Solidity.InternalCallFrame
  | Stmt.noArgReturn =>
      _root_.SolidCore.Solidity.InternalCallFrame.noArgReturn
  | Stmt.argReturn =>
      _root_.SolidCore.Solidity.InternalCallFrame.argReturn
  | Stmt.multiReturn =>
      _root_.SolidCore.Solidity.InternalCallFrame.multiReturn

def Stmt.toProgram : Stmt -> Program
  | Stmt.noArgReturn => Program.functionBody Body.internalCallReturn
  | Stmt.argReturn => Program.internalCallArgReturn
  | Stmt.multiReturn => Program.internalCallMultiReturn

def Stmt.fuel (stmt : Stmt) : Nat :=
  stmt.toFrame.fuel

def Stmt.toFullYul (stmt : Stmt) : SolidCoreYulCore.FullYul.Stmt :=
  stmt.toFrame.toFullYul

theorem Stmt.toFullYul_correct (stmt : Stmt) :
    SolidCoreYulCore.SymYul.evalStmtFuel stmt.fuel
        Body.initialSymYulConfig stmt.toFullYul =
      [SolidCoreYulCore.SymYul.normalResult
        stmt.toProgram.finalSymYulConfig] := by
  cases stmt with
  | noArgReturn =>
      simpa [Stmt.fuel, Stmt.toFullYul, Stmt.toProgram,
        Stmt.toFrame, Program.finalSymYulConfig, Program.eval, Body.eval,
        InternalCallFrame.eval] using
          _root_.SolidCore.Solidity.InternalCallFrame.toFullYul_correct
            _root_.SolidCore.Solidity.InternalCallFrame.noArgReturn
  | argReturn =>
      simpa [Stmt.fuel, Stmt.toFullYul, Stmt.toProgram,
        Stmt.toFrame, Program.finalSymYulConfig, Program.eval,
        InternalCallFrame.eval] using
          _root_.SolidCore.Solidity.InternalCallFrame.toFullYul_correct
            _root_.SolidCore.Solidity.InternalCallFrame.argReturn
  | multiReturn =>
      simpa [Stmt.fuel, Stmt.toFullYul, Stmt.toProgram,
        Stmt.toFrame, Program.finalSymYulConfig, Program.eval,
        InternalCallFrame.eval] using
          _root_.SolidCore.Solidity.InternalCallFrame.toFullYul_correct
            _root_.SolidCore.Solidity.InternalCallFrame.multiReturn

theorem Stmt.toFullYul_staticChecked (stmt : Stmt) :
    SolidCoreYulCore.FullYul.checkStmtFuel
        (stmt.fuel + 1)
        Program.initialStaticContext false false
        stmt.toFullYul =
      some Program.initialStaticContext := by
  simpa [Stmt.fuel, Stmt.toFullYul, Program.initialStaticContext] using
    _root_.SolidCore.Solidity.InternalCallFrame.toFullYul_staticChecked
      stmt.toFrame

theorem Stmt.toFullYul_compilerEmittable (stmt : Stmt) :
    SolidCoreYulCore.FullYul.CompilerEmittableStmt
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      stmt.toFullYul := by
  simpa [Stmt.toFullYul] using
    _root_.SolidCore.Solidity.InternalCallFrame.toFullYul_compilerEmittable
      stmt.toFrame

end InternalCall

namespace Storage

structure State where
  returnValue : SolidCoreYulCore.FullYul.Value
  storage : SolidCoreYulCore.FullYul.AccountValueMap
  deriving DecidableEq, Repr

def State.toConfig (state : State) : SolidCoreYulCore.SymYul.Config :=
  { SolidCoreYulCore.SymYul.Config.empty with
    env := [(returnName,
      state.returnValue)]
    evm :=
      { SolidCoreYulCore.FullYul.EvmState.empty with
        storage := state.storage } }

def State.loadedValue (state : State) (slot : TypedExpr Ty.uint256) :
    SolidCoreYulCore.FullYul.Value :=
  match storageLookup? state.storage
      (SolidCoreYulCore.FullYul.Value.word slot.eval) with
  | some value => value
  | none =>
      SolidCoreYulCore.FullYul.Value.storageWord
        storageAccountZero
        (SolidCoreYulCore.FullYul.Value.word slot.eval)

def addValue
    (lhs rhs : SolidCoreYulCore.FullYul.Value) :
    SolidCoreYulCore.FullYul.Value :=
  match lhs, rhs with
  | SolidCoreYulCore.FullYul.Value.word lhs,
      SolidCoreYulCore.FullYul.Value.word rhs =>
      SolidCoreYulCore.FullYul.Value.word
        (SolidCoreYulCore.addWord lhs rhs)
  | lhs, rhs =>
      SolidCoreYulCore.FullYul.Value.binaryBuiltin
        SolidCoreYulCore.Evm.Builtin.add lhs rhs

theorem evalEvmBuiltin_add_values
    (state : SolidCoreYulCore.FullYul.EvmState)
    (lhs rhs : SolidCoreYulCore.FullYul.Value) :
    SolidCoreYulCore.FullYul.evalEvmBuiltin
        SolidCoreYulCore.Evm.Builtin.add [lhs, rhs] state =
      some (addValue lhs rhs, state) := by
  cases lhs <;> cases rhs <;> rfl

inductive Stmt where
  | write : TypedExpr Ty.uint256 -> TypedExpr Ty.uint256 -> Stmt
  | returnLoad : TypedExpr Ty.uint256 -> Stmt
  | returnLoadAdd : TypedExpr Ty.uint256 -> TypedExpr Ty.uint256 -> Stmt
  | seq : Stmt -> Stmt -> Stmt
  | ifThen : TypedExpr Ty.bool -> Stmt -> Stmt

def Stmt.eval (state : State) : Stmt -> State
  | Stmt.write slot value =>
      { state with
        storage :=
          storageWrite state.storage
            (SolidCoreYulCore.FullYul.Value.word slot.eval)
            (SolidCoreYulCore.FullYul.Value.word value.eval) }
  | Stmt.returnLoad slot =>
      { state with returnValue := state.loadedValue slot }
  | Stmt.returnLoadAdd lhsSlot rhsSlot =>
      { state with
        returnValue :=
          addValue (state.loadedValue lhsSlot) (state.loadedValue rhsSlot) }
  | Stmt.seq first second =>
      second.eval (first.eval state)
  | Stmt.ifThen cond body =>
      if SolidCoreYulCore.norm cond.eval = 0 then state else body.eval state

def Stmt.toFullYul : Stmt -> SolidCoreYulCore.FullYul.Stmt
  | Stmt.write slot value =>
      SolidCoreYulCore.FullYul.Stmt.expr
        (SolidCoreYulCore.FullYul.Expr.builtin
          SolidCoreYulCore.Evm.Builtin.sstore
          [slot.toFullYul, value.toFullYul])
  | Stmt.returnLoad slot =>
      SolidCoreYulCore.FullYul.Stmt.assign returnName
        (SolidCoreYulCore.FullYul.Expr.builtin
          SolidCoreYulCore.Evm.Builtin.sload
          [slot.toFullYul])
  | Stmt.returnLoadAdd lhsSlot rhsSlot =>
      SolidCoreYulCore.FullYul.Stmt.assign returnName
        (SolidCoreYulCore.FullYul.Expr.builtin
          SolidCoreYulCore.Evm.Builtin.add
          [ SolidCoreYulCore.FullYul.Expr.builtin
              SolidCoreYulCore.Evm.Builtin.sload [lhsSlot.toFullYul]
          , SolidCoreYulCore.FullYul.Expr.builtin
              SolidCoreYulCore.Evm.Builtin.sload [rhsSlot.toFullYul] ])
  | Stmt.seq first second =>
      SolidCoreYulCore.FullYul.Stmt.seq first.toFullYul second.toFullYul
  | Stmt.ifThen cond body =>
      SolidCoreYulCore.FullYul.Stmt.ifThen cond.toFullYul body.toFullYul

theorem Stmt.toFullYul_compilerEmittable (stmt : Stmt) :
    SolidCoreYulCore.FullYul.CompilerEmittableStmt
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      stmt.toFullYul := by
  induction stmt with
  | write slot value =>
      have hSlot := TypedExpr.toFullYul_compilerEmittable slot
      have hValue := TypedExpr.toFullYul_compilerEmittable value
      have hStore :=
        currentSolidCore_builtin2_compilerEmittable
          SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.sstore
          hSlot hValue
      simpa [Stmt.toFullYul] using
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.expr hStore
  | returnLoad slot =>
      have hSlot := TypedExpr.toFullYul_compilerEmittable slot
      have hLoad :=
        currentSolidCore_builtin1_compilerEmittable
          SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.sload
          hSlot
      simpa [Stmt.toFullYul] using
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.assign
          (name := returnName) hLoad
  | returnLoadAdd lhsSlot rhsSlot =>
      have hLhsSlot := TypedExpr.toFullYul_compilerEmittable lhsSlot
      have hRhsSlot := TypedExpr.toFullYul_compilerEmittable rhsSlot
      have hLhsLoad :=
        currentSolidCore_builtin1_compilerEmittable
          SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.sload
          hLhsSlot
      have hRhsLoad :=
        currentSolidCore_builtin1_compilerEmittable
          SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.sload
          hRhsSlot
      have hAdd :=
        currentSolidCore_builtin2_compilerEmittable
          SolidCoreYulCore.FullYul.CompilerProfile.CurrentSolidCoreBuiltin.add
          hLhsLoad hRhsLoad
      simpa [Stmt.toFullYul] using
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.assign
          (name := returnName) hAdd
  | seq first second first_ih second_ih =>
      simpa [Stmt.toFullYul] using
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.seq
          first_ih second_ih
  | ifThen cond body body_ih =>
      simpa [Stmt.toFullYul] using
        SolidCoreYulCore.FullYul.CompilerEmittableStmt.ifThen
          (TypedExpr.toFullYul_compilerEmittable cond)
          body_ih

def Stmt.fuel : Stmt -> Nat
  | Stmt.write _ _ => 2
  | Stmt.returnLoad _ => 2
  | Stmt.returnLoadAdd _ _ => 2
  | Stmt.seq first second => first.fuel + second.fuel + 1
  | Stmt.ifThen _ body => body.fuel + 1

theorem Stmt.collect_toFullYul
    (stmt : Stmt) (funcs : SolidCoreYulCore.SymYul.FunctionEnv) :
    SolidCoreYulCore.SymYul.collectStmtFunctionDefs stmt.toFullYul funcs =
      funcs := by
  induction stmt generalizing funcs with
  | write slot value =>
      simp [Stmt.toFullYul, SolidCoreYulCore.SymYul.collectStmtFunctionDefs]
  | returnLoad slot =>
      simp [Stmt.toFullYul, SolidCoreYulCore.SymYul.collectStmtFunctionDefs]
  | returnLoadAdd lhsSlot rhsSlot =>
      simp [Stmt.toFullYul, SolidCoreYulCore.SymYul.collectStmtFunctionDefs]
  | seq first second first_ih second_ih =>
      simp [Stmt.toFullYul, SolidCoreYulCore.SymYul.collectStmtFunctionDefs,
        first_ih, second_ih]
  | ifThen _ body body_ih =>
      simp [Stmt.toFullYul, SolidCoreYulCore.SymYul.collectStmtFunctionDefs,
        body_ih]

theorem Stmt.predeclare_toFullYul
    (ctx : SolidCoreYulCore.FullYul.StaticContext) (stmt : Stmt) :
    SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs? ctx stmt.toFullYul =
      some ctx := by
  induction stmt generalizing ctx with
  | write _ _ => rfl
  | returnLoad _ => rfl
  | returnLoadAdd _ _ => rfl
  | seq first second first_ih second_ih =>
      simp [Stmt.toFullYul,
        SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?,
        first_ih, second_ih]
  | ifThen _ body _ =>
      simp [Stmt.toFullYul,
        SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?]

theorem Stmt.toFullYul_staticChecked_from
    (extraFuel : Nat) (stmt : Stmt) :
    SolidCoreYulCore.FullYul.checkStmtFuel
        (stmt.fuel + extraFuel)
        Program.initialStaticContext false false stmt.toFullYul =
      some Program.initialStaticContext := by
  induction stmt generalizing extraFuel with
  | write slot value =>
      cases extraFuel <;>
        simp [Stmt.fuel, Stmt.toFullYul, Program.initialStaticContext,
          returnName, SolidCoreYulCore.FullYul.checkStmtFuel,
          SolidCoreYulCore.FullYul.checkStmtExpr,
          SolidCoreYulCore.FullYul.checkExprs,
          SolidCoreYulCore.Evm.Builtin.signature?,
          TypedExpr.toFullYul_staticChecked]
  | returnLoad slot =>
      cases extraFuel <;>
        simp [Stmt.fuel, Stmt.toFullYul, Program.initialStaticContext,
          returnName, SolidCoreYulCore.FullYul.checkStmtFuel,
          SolidCoreYulCore.FullYul.containsName,
          SolidCoreYulCore.FullYul.checkExpr,
          SolidCoreYulCore.FullYul.checkExprs,
          SolidCoreYulCore.Evm.Builtin.signature?,
          TypedExpr.toFullYul_staticChecked]
  | returnLoadAdd lhsSlot rhsSlot =>
      cases extraFuel <;>
        simp [Stmt.fuel, Stmt.toFullYul, Program.initialStaticContext,
          returnName, SolidCoreYulCore.FullYul.checkStmtFuel,
          SolidCoreYulCore.FullYul.containsName,
          SolidCoreYulCore.FullYul.checkExpr,
          SolidCoreYulCore.FullYul.checkExprs,
          SolidCoreYulCore.Evm.Builtin.signature?,
          TypedExpr.toFullYul_staticChecked]
  | seq first second first_ih second_ih =>
      simp only [Stmt.fuel, Stmt.toFullYul]
      rw [show first.fuel + second.fuel + 1 + extraFuel =
          first.fuel + second.fuel + extraFuel + 1 by omega]
      simp [SolidCoreYulCore.FullYul.checkStmtFuel,
        SolidCoreYulCore.FullYul.predeclareStmtFunctionSigs?,
        Stmt.predeclare_toFullYul]
      rw [show first.fuel + second.fuel + extraFuel =
          first.fuel + (second.fuel + extraFuel) by omega]
      rw [first_ih (second.fuel + extraFuel)]
      simp
      rw [show first.fuel + (second.fuel + extraFuel) =
          second.fuel + (first.fuel + extraFuel) by omega]
      exact second_ih (first.fuel + extraFuel)
  | ifThen cond body body_ih =>
      simp only [Stmt.fuel, Stmt.toFullYul]
      rw [show body.fuel + 1 + extraFuel =
          body.fuel + extraFuel + 1 by omega]
      simp [SolidCoreYulCore.FullYul.checkStmtFuel,
        TypedExpr.toFullYul_staticChecked]
      rw [body_ih extraFuel]

theorem Stmt.toFullYul_staticChecked (stmt : Stmt) :
    SolidCoreYulCore.FullYul.checkStmtFuel stmt.fuel
        Program.initialStaticContext false false stmt.toFullYul =
      some Program.initialStaticContext := by
  simpa using Stmt.toFullYul_staticChecked_from 0 stmt

theorem Stmt.toFullYul_accepted_currentSolidCore (stmt : Stmt) :
    SolidCoreYulCore.FullYul.CompilerAcceptedStmt
      SolidCoreYulCore.FullYul.CompilerProfile.currentSolidCore
      stmt.fuel Program.initialStaticContext false false
      stmt.toFullYul Program.initialStaticContext := by
  exact
    { emittable := Stmt.toFullYul_compilerEmittable stmt
      checked := Stmt.toFullYul_staticChecked stmt }

theorem Stmt.toFullYul_correct_from
    (extraFuel : Nat)
    (state : State)
    (stmt : Stmt) :
    SolidCoreYulCore.SymYul.evalStmtFuel
        (stmt.fuel + extraFuel)
        state.toConfig
        stmt.toFullYul =
      [SolidCoreYulCore.SymYul.normalResult
        (stmt.eval state).toConfig] := by
  induction stmt generalizing state extraFuel with
  | write slot value =>
      cases extraFuel <;>
      simp [Stmt.fuel, Stmt.toFullYul, Stmt.eval, State.toConfig,
        SolidCoreYulCore.SymYul.evalStmtFuel,
        SolidCoreYulCore.SymYul.evalExpr,
        SolidCoreYulCore.SymYul.evalExprs,
        SolidCoreYulCore.SymYul.resultAfterExpr,
        SolidCoreYulCore.SymYul.normalResult,
        SolidCoreYulCore.SymYul.bindNormal,
        SolidCoreYulCore.FullYul.evalEvmBuiltin_sstore_values,
        SolidCoreYulCore.FullYul.EvmState.empty,
        SolidCoreYulCore.FullYul.returnUnit,
        SolidCoreYulCore.FullYul.returnWord,
        storageLookup?, storageWrite, storageAccountZero,
        SolidCoreYulCore.FullYul.lookupAccountValueMap?,
        SolidCoreYulCore.FullYul.lookupAccountValueEntries?,
        SolidCoreYulCore.FullYul.writeAccountValueMap,
        SolidCoreYulCore.FullYul.lookupValueMap?,
        SolidCoreYulCore.FullYul.writeValueMap,
        SolidCoreYulCore.FullYul.assign?,
        SolidCoreYulCore.FullYul.lookup?,
        TypedExpr.toFullYul_correct_env]
  | returnLoad slot =>
      cases hLookup :
          SolidCoreYulCore.FullYul.lookupAccountValueMap?
            state.storage storageAccountZero
            (SolidCoreYulCore.FullYul.Value.word slot.eval) with
      | none =>
          have hLoaded :
              state.loadedValue slot =
                SolidCoreYulCore.FullYul.Value.storageWord
                  storageAccountZero
                  (SolidCoreYulCore.FullYul.Value.word slot.eval) := by
            simp [State.loadedValue, storageLookup?, hLookup]
          have hEval :
              SolidCoreYulCore.FullYul.evalEvmBuiltin
                  SolidCoreYulCore.Evm.Builtin.sload
                  [SolidCoreYulCore.FullYul.Value.word slot.eval]
                  ({ storage := state.storage } :
                    SolidCoreYulCore.FullYul.EvmState) =
                some
                  ( SolidCoreYulCore.FullYul.Value.storageWord
                      storageAccountZero
                      (SolidCoreYulCore.FullYul.Value.word slot.eval)
                  , ({ storage := state.storage } :
                      SolidCoreYulCore.FullYul.EvmState) ) := by
            simpa [SolidCoreYulCore.FullYul.EvmState.empty] using
              evalEvmBuiltin_sload_accountZero_missing
                state.storage
                (SolidCoreYulCore.FullYul.Value.word slot.eval)
                hLookup
          cases extraFuel <;>
          simp [Stmt.fuel, Stmt.toFullYul, Stmt.eval, State.toConfig,
            hLoaded, hLookup, hEval,
            SolidCoreYulCore.SymYul.evalStmtFuel,
            SolidCoreYulCore.SymYul.evalExpr,
            SolidCoreYulCore.SymYul.evalExprs,
            SolidCoreYulCore.SymYul.resultAfterExpr,
            SolidCoreYulCore.SymYul.normalResult,
            SolidCoreYulCore.SymYul.bindNormal,
            SolidCoreYulCore.FullYul.evalEvmBuiltin_sload_missing,
        evalEvmBuiltin_sload_accountZero_missing,
            SolidCoreYulCore.FullYul.EvmState.empty,
            SolidCoreYulCore.FullYul.returnWord,
            storageLookup?, storageAccountZero,
            SolidCoreYulCore.FullYul.lookupAccountValueMap?,
            SolidCoreYulCore.FullYul.lookupAccountValueEntries?,
            SolidCoreYulCore.FullYul.assign?,
            SolidCoreYulCore.FullYul.lookup?,
            TypedExpr.toFullYul_correct_env]
      | some value =>
          have hLoaded : state.loadedValue slot = value := by
            simp [State.loadedValue, storageLookup?, hLookup]
          have hEval :
              SolidCoreYulCore.FullYul.evalEvmBuiltin
                  SolidCoreYulCore.Evm.Builtin.sload
                  [SolidCoreYulCore.FullYul.Value.word slot.eval]
                  ({ storage := state.storage } :
                    SolidCoreYulCore.FullYul.EvmState) =
                some
                  ( value
                  , ({ storage := state.storage } :
                      SolidCoreYulCore.FullYul.EvmState) ) := by
            simpa [SolidCoreYulCore.FullYul.EvmState.empty] using
              evalEvmBuiltin_sload_accountZero_present
                state.storage
                (SolidCoreYulCore.FullYul.Value.word slot.eval)
                value hLookup
          cases extraFuel <;>
          simp [Stmt.fuel, Stmt.toFullYul, Stmt.eval, State.toConfig,
            hLoaded, hLookup, hEval,
            SolidCoreYulCore.SymYul.evalStmtFuel,
            SolidCoreYulCore.SymYul.evalExpr,
            SolidCoreYulCore.SymYul.evalExprs,
            SolidCoreYulCore.SymYul.resultAfterExpr,
            SolidCoreYulCore.SymYul.normalResult,
            SolidCoreYulCore.SymYul.bindNormal,
            SolidCoreYulCore.FullYul.evalEvmBuiltin_sload_present,
        evalEvmBuiltin_sload_accountZero_present,
            SolidCoreYulCore.FullYul.EvmState.empty,
            SolidCoreYulCore.FullYul.returnWord,
            storageLookup?, storageAccountZero,
            SolidCoreYulCore.FullYul.lookupAccountValueMap?,
            SolidCoreYulCore.FullYul.lookupAccountValueEntries?,
            SolidCoreYulCore.FullYul.assign?,
            SolidCoreYulCore.FullYul.lookup?,
        TypedExpr.toFullYul_correct_env]
  | returnLoadAdd lhsSlot rhsSlot =>
      cases hRhs :
          SolidCoreYulCore.FullYul.lookupAccountValueMap?
            state.storage storageAccountZero
            (SolidCoreYulCore.FullYul.Value.word rhsSlot.eval) with
      | none =>
          cases hLhs :
              SolidCoreYulCore.FullYul.lookupAccountValueMap?
                state.storage storageAccountZero
                (SolidCoreYulCore.FullYul.Value.word lhsSlot.eval) with
          | none =>
              have hRhsLoaded :
                  state.loadedValue rhsSlot =
                    SolidCoreYulCore.FullYul.Value.storageWord
                      storageAccountZero
                      (SolidCoreYulCore.FullYul.Value.word rhsSlot.eval) := by
                simp [State.loadedValue, storageLookup?, hRhs]
              have hLhsLoaded :
                  state.loadedValue lhsSlot =
                    SolidCoreYulCore.FullYul.Value.storageWord
                      storageAccountZero
                      (SolidCoreYulCore.FullYul.Value.word lhsSlot.eval) := by
                simp [State.loadedValue, storageLookup?, hLhs]
              have hRhsEval :
                  SolidCoreYulCore.FullYul.evalEvmBuiltin
                      SolidCoreYulCore.Evm.Builtin.sload
                      [SolidCoreYulCore.FullYul.Value.word rhsSlot.eval]
                      ({ storage := state.storage } :
                        SolidCoreYulCore.FullYul.EvmState) =
                    some
                      ( SolidCoreYulCore.FullYul.Value.storageWord
                          storageAccountZero
                          (SolidCoreYulCore.FullYul.Value.word rhsSlot.eval)
                      , ({ storage := state.storage } :
                          SolidCoreYulCore.FullYul.EvmState) ) := by
                simpa [SolidCoreYulCore.FullYul.EvmState.empty] using
                  evalEvmBuiltin_sload_accountZero_missing
                    state.storage
                    (SolidCoreYulCore.FullYul.Value.word rhsSlot.eval)
                    hRhs
              have hLhsEval :
                  SolidCoreYulCore.FullYul.evalEvmBuiltin
                      SolidCoreYulCore.Evm.Builtin.sload
                      [SolidCoreYulCore.FullYul.Value.word lhsSlot.eval]
                      ({ storage := state.storage } :
                        SolidCoreYulCore.FullYul.EvmState) =
                    some
                      ( SolidCoreYulCore.FullYul.Value.storageWord
                          storageAccountZero
                          (SolidCoreYulCore.FullYul.Value.word lhsSlot.eval)
                      , ({ storage := state.storage } :
                          SolidCoreYulCore.FullYul.EvmState) ) := by
                simpa [SolidCoreYulCore.FullYul.EvmState.empty] using
                  evalEvmBuiltin_sload_accountZero_missing
                    state.storage
                    (SolidCoreYulCore.FullYul.Value.word lhsSlot.eval)
                    hLhs
              cases extraFuel <;>
              simp [Stmt.fuel, Stmt.toFullYul, Stmt.eval, State.toConfig,
                addValue, hLhsLoaded, hRhsLoaded, hLhs, hRhs,
                hLhsEval, hRhsEval,
                SolidCoreYulCore.SymYul.evalStmtFuel,
                SolidCoreYulCore.SymYul.evalExpr,
                SolidCoreYulCore.SymYul.evalExprs,
                SolidCoreYulCore.SymYul.normalResult,
                SolidCoreYulCore.FullYul.evalEvmBuiltin_sload_missing,
        evalEvmBuiltin_sload_accountZero_missing,
                evalEvmBuiltin_add_values,
                SolidCoreYulCore.FullYul.EvmState.empty,
                SolidCoreYulCore.FullYul.returnWord,
                storageLookup?, storageAccountZero,
                SolidCoreYulCore.FullYul.lookupAccountValueMap?,
                SolidCoreYulCore.FullYul.lookupAccountValueEntries?,
                SolidCoreYulCore.FullYul.assign?,
                SolidCoreYulCore.FullYul.lookup?,
                TypedExpr.toFullYul_correct_env]
          | some lhs =>
              have hRhsLoaded :
                  state.loadedValue rhsSlot =
                    SolidCoreYulCore.FullYul.Value.storageWord
                      storageAccountZero
                      (SolidCoreYulCore.FullYul.Value.word rhsSlot.eval) := by
                simp [State.loadedValue, storageLookup?, hRhs]
              have hLhsLoaded : state.loadedValue lhsSlot = lhs := by
                simp [State.loadedValue, storageLookup?, hLhs]
              have hRhsEval :
                  SolidCoreYulCore.FullYul.evalEvmBuiltin
                      SolidCoreYulCore.Evm.Builtin.sload
                      [SolidCoreYulCore.FullYul.Value.word rhsSlot.eval]
                      ({ storage := state.storage } :
                        SolidCoreYulCore.FullYul.EvmState) =
                    some
                      ( SolidCoreYulCore.FullYul.Value.storageWord
                          storageAccountZero
                          (SolidCoreYulCore.FullYul.Value.word rhsSlot.eval)
                      , ({ storage := state.storage } :
                          SolidCoreYulCore.FullYul.EvmState) ) := by
                simpa [SolidCoreYulCore.FullYul.EvmState.empty] using
                  evalEvmBuiltin_sload_accountZero_missing
                    state.storage
                    (SolidCoreYulCore.FullYul.Value.word rhsSlot.eval)
                    hRhs
              have hLhsEval :
                  SolidCoreYulCore.FullYul.evalEvmBuiltin
                      SolidCoreYulCore.Evm.Builtin.sload
                      [SolidCoreYulCore.FullYul.Value.word lhsSlot.eval]
                      ({ storage := state.storage } :
                        SolidCoreYulCore.FullYul.EvmState) =
                    some
                      ( lhs
                      , ({ storage := state.storage } :
                          SolidCoreYulCore.FullYul.EvmState) ) := by
                simpa [SolidCoreYulCore.FullYul.EvmState.empty] using
                  evalEvmBuiltin_sload_accountZero_present
                    state.storage
                    (SolidCoreYulCore.FullYul.Value.word lhsSlot.eval)
                    lhs hLhs
              cases extraFuel <;>
              simp [Stmt.fuel, Stmt.toFullYul, Stmt.eval, State.toConfig,
                addValue, hLhsLoaded, hRhsLoaded, hLhs, hRhs,
                hLhsEval, hRhsEval,
                SolidCoreYulCore.SymYul.evalStmtFuel,
                SolidCoreYulCore.SymYul.evalExpr,
                SolidCoreYulCore.SymYul.evalExprs,
                SolidCoreYulCore.SymYul.normalResult,
                SolidCoreYulCore.FullYul.evalEvmBuiltin_sload_present,
        evalEvmBuiltin_sload_accountZero_present,
                SolidCoreYulCore.FullYul.evalEvmBuiltin_sload_missing,
        evalEvmBuiltin_sload_accountZero_missing,
                evalEvmBuiltin_add_values,
                SolidCoreYulCore.FullYul.EvmState.empty,
                SolidCoreYulCore.FullYul.returnWord,
                storageLookup?, storageAccountZero,
                SolidCoreYulCore.FullYul.lookupAccountValueMap?,
                SolidCoreYulCore.FullYul.lookupAccountValueEntries?,
                SolidCoreYulCore.FullYul.assign?,
                SolidCoreYulCore.FullYul.lookup?,
                TypedExpr.toFullYul_correct_env]
      | some rhs =>
          cases hLhs :
              SolidCoreYulCore.FullYul.lookupAccountValueMap?
                state.storage storageAccountZero
                (SolidCoreYulCore.FullYul.Value.word lhsSlot.eval) with
          | none =>
              have hRhsLoaded : state.loadedValue rhsSlot = rhs := by
                simp [State.loadedValue, storageLookup?, hRhs]
              have hLhsLoaded :
                  state.loadedValue lhsSlot =
                    SolidCoreYulCore.FullYul.Value.storageWord
                      storageAccountZero
                      (SolidCoreYulCore.FullYul.Value.word lhsSlot.eval) := by
                simp [State.loadedValue, storageLookup?, hLhs]
              have hRhsEval :
                  SolidCoreYulCore.FullYul.evalEvmBuiltin
                      SolidCoreYulCore.Evm.Builtin.sload
                      [SolidCoreYulCore.FullYul.Value.word rhsSlot.eval]
                      ({ storage := state.storage } :
                        SolidCoreYulCore.FullYul.EvmState) =
                    some
                      ( rhs
                      , ({ storage := state.storage } :
                          SolidCoreYulCore.FullYul.EvmState) ) := by
                simpa [SolidCoreYulCore.FullYul.EvmState.empty] using
                  evalEvmBuiltin_sload_accountZero_present
                    state.storage
                    (SolidCoreYulCore.FullYul.Value.word rhsSlot.eval)
                    rhs hRhs
              have hLhsEval :
                  SolidCoreYulCore.FullYul.evalEvmBuiltin
                      SolidCoreYulCore.Evm.Builtin.sload
                      [SolidCoreYulCore.FullYul.Value.word lhsSlot.eval]
                      ({ storage := state.storage } :
                        SolidCoreYulCore.FullYul.EvmState) =
                    some
                      ( SolidCoreYulCore.FullYul.Value.storageWord
                          storageAccountZero
                          (SolidCoreYulCore.FullYul.Value.word lhsSlot.eval)
                      , ({ storage := state.storage } :
                          SolidCoreYulCore.FullYul.EvmState) ) := by
                simpa [SolidCoreYulCore.FullYul.EvmState.empty] using
                  evalEvmBuiltin_sload_accountZero_missing
                    state.storage
                    (SolidCoreYulCore.FullYul.Value.word lhsSlot.eval)
                    hLhs
              cases extraFuel <;>
              simp [Stmt.fuel, Stmt.toFullYul, Stmt.eval, State.toConfig,
                addValue, hLhsLoaded, hRhsLoaded, hLhs, hRhs,
                hLhsEval, hRhsEval,
                SolidCoreYulCore.SymYul.evalStmtFuel,
                SolidCoreYulCore.SymYul.evalExpr,
                SolidCoreYulCore.SymYul.evalExprs,
                SolidCoreYulCore.SymYul.normalResult,
                SolidCoreYulCore.FullYul.evalEvmBuiltin_sload_present,
        evalEvmBuiltin_sload_accountZero_present,
                SolidCoreYulCore.FullYul.evalEvmBuiltin_sload_missing,
        evalEvmBuiltin_sload_accountZero_missing,
                evalEvmBuiltin_add_values,
                SolidCoreYulCore.FullYul.EvmState.empty,
                SolidCoreYulCore.FullYul.returnWord,
                storageLookup?, storageAccountZero,
                SolidCoreYulCore.FullYul.lookupAccountValueMap?,
                SolidCoreYulCore.FullYul.lookupAccountValueEntries?,
                SolidCoreYulCore.FullYul.assign?,
                SolidCoreYulCore.FullYul.lookup?,
                TypedExpr.toFullYul_correct_env]
          | some lhs =>
              have hRhsLoaded : state.loadedValue rhsSlot = rhs := by
                simp [State.loadedValue, storageLookup?, hRhs]
              have hLhsLoaded : state.loadedValue lhsSlot = lhs := by
                simp [State.loadedValue, storageLookup?, hLhs]
              have hRhsEval :
                  SolidCoreYulCore.FullYul.evalEvmBuiltin
                      SolidCoreYulCore.Evm.Builtin.sload
                      [SolidCoreYulCore.FullYul.Value.word rhsSlot.eval]
                      ({ storage := state.storage } :
                        SolidCoreYulCore.FullYul.EvmState) =
                    some
                      ( rhs
                      , ({ storage := state.storage } :
                          SolidCoreYulCore.FullYul.EvmState) ) := by
                simpa [SolidCoreYulCore.FullYul.EvmState.empty] using
                  evalEvmBuiltin_sload_accountZero_present
                    state.storage
                    (SolidCoreYulCore.FullYul.Value.word rhsSlot.eval)
                    rhs hRhs
              have hLhsEval :
                  SolidCoreYulCore.FullYul.evalEvmBuiltin
                      SolidCoreYulCore.Evm.Builtin.sload
                      [SolidCoreYulCore.FullYul.Value.word lhsSlot.eval]
                      ({ storage := state.storage } :
                        SolidCoreYulCore.FullYul.EvmState) =
                    some
                      ( lhs
                      , ({ storage := state.storage } :
                          SolidCoreYulCore.FullYul.EvmState) ) := by
                simpa [SolidCoreYulCore.FullYul.EvmState.empty] using
                  evalEvmBuiltin_sload_accountZero_present
                    state.storage
                    (SolidCoreYulCore.FullYul.Value.word lhsSlot.eval)
                    lhs hLhs
              cases extraFuel <;>
              simp [Stmt.fuel, Stmt.toFullYul, Stmt.eval, State.toConfig,
                addValue, hLhsLoaded, hRhsLoaded, hLhs, hRhs,
                hLhsEval, hRhsEval,
                SolidCoreYulCore.SymYul.evalStmtFuel,
                SolidCoreYulCore.SymYul.evalExpr,
                SolidCoreYulCore.SymYul.evalExprs,
                SolidCoreYulCore.SymYul.normalResult,
                SolidCoreYulCore.FullYul.evalEvmBuiltin_sload_present,
        evalEvmBuiltin_sload_accountZero_present,
                evalEvmBuiltin_add_values,
                SolidCoreYulCore.FullYul.EvmState.empty,
                SolidCoreYulCore.FullYul.returnWord,
                storageLookup?, storageAccountZero,
                SolidCoreYulCore.FullYul.lookupAccountValueMap?,
                SolidCoreYulCore.FullYul.lookupAccountValueEntries?,
                SolidCoreYulCore.FullYul.assign?,
                SolidCoreYulCore.FullYul.lookup?,
                TypedExpr.toFullYul_correct_env]
  | seq first second first_ih second_ih =>
      simp only [Stmt.fuel, Stmt.toFullYul, Stmt.eval]
      rw [show first.fuel + second.fuel + 1 + extraFuel =
          first.fuel + second.fuel + extraFuel + 1 by
        ac_rfl]
      simp [SolidCoreYulCore.SymYul.evalStmtFuel,
        SolidCoreYulCore.SymYul.bindNormal,
        Stmt.collect_toFullYul]
      rw [show first.fuel + second.fuel + extraFuel =
          first.fuel + (second.fuel + extraFuel) by
        ac_rfl]
      rw [first_ih (second.fuel + extraFuel) state]
      simp [SolidCoreYulCore.SymYul.bindNormal,
        SolidCoreYulCore.SymYul.normalResult]
      simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using
        second_ih (first.fuel + extraFuel) (first.eval state)
  | ifThen cond body body_ih =>
      by_cases hCond : SolidCoreYulCore.norm cond.eval = 0
      · simp only [Stmt.fuel, Stmt.toFullYul, Stmt.eval, hCond, if_true]
        have hZero : cond.eval % SolidCoreYulCore.wordModulus = 0 := by
          simpa [SolidCoreYulCore.norm] using hCond
        change
          SolidCoreYulCore.SymYul.evalStmtFuel
              (body.fuel + 1 + extraFuel)
              state.toConfig
              (SolidCoreYulCore.FullYul.Stmt.ifThen cond.toFullYul
                body.toFullYul) =
            [SolidCoreYulCore.SymYul.normalResult state.toConfig]
        rw [show body.fuel + 1 + extraFuel =
            body.fuel + extraFuel + 1 by
          ac_rfl]
        simp [SolidCoreYulCore.SymYul.evalStmtFuel,
          SolidCoreYulCore.SymYul.evalExpr,
          SolidCoreYulCore.SymYul.evalExprs,
          SolidCoreYulCore.SymYul.branchOn,
          SolidCoreYulCore.SymYul.knownZero?,
          SolidCoreYulCore.norm, hCond, hZero,
          TypedExpr.toFullYul_correct_env]
      · have hBody :
            SolidCoreYulCore.SymYul.evalStmtFuel
                (body.fuel + extraFuel)
                state.toConfig body.toFullYul =
              [SolidCoreYulCore.SymYul.normalResult (body.eval state).toConfig] :=
          body_ih extraFuel state
        have hNonzero : cond.eval % SolidCoreYulCore.wordModulus ≠ 0 := by
          simpa [SolidCoreYulCore.norm] using hCond
        simp only [Stmt.fuel, Stmt.toFullYul, Stmt.eval, hCond, if_false]
        change
          SolidCoreYulCore.SymYul.evalStmtFuel
              (body.fuel + 1 + extraFuel)
              state.toConfig
              (SolidCoreYulCore.FullYul.Stmt.ifThen cond.toFullYul
                body.toFullYul) =
            [SolidCoreYulCore.SymYul.normalResult (body.eval state).toConfig]
        rw [show body.fuel + 1 + extraFuel =
            body.fuel + extraFuel + 1 by
          ac_rfl]
        simp [SolidCoreYulCore.SymYul.evalStmtFuel,
          SolidCoreYulCore.SymYul.evalExpr,
          SolidCoreYulCore.SymYul.evalExprs,
          SolidCoreYulCore.SymYul.branchOn,
          SolidCoreYulCore.SymYul.knownZero?,
          SolidCoreYulCore.norm, hCond, hNonzero,
          TypedExpr.toFullYul_correct_env, hBody]

theorem Stmt.toFullYul_correct
    (state : State)
    (stmt : Stmt) :
    SolidCoreYulCore.SymYul.evalStmtFuel
        stmt.fuel
        state.toConfig
        stmt.toFullYul =
      [SolidCoreYulCore.SymYul.normalResult
        (stmt.eval state).toConfig] := by
  simpa using Stmt.toFullYul_correct_from 0 state stmt

def Stmt.writeRead (slot value : TypedExpr Ty.uint256) : Stmt :=
  Stmt.seq (Stmt.write slot value) (Stmt.returnLoad slot)

def Stmt.writeWriteRead
    (slot firstValue secondValue : TypedExpr Ty.uint256) : Stmt :=
  Stmt.seq (Stmt.write slot firstValue)
    (Stmt.seq (Stmt.write slot secondValue) (Stmt.returnLoad slot))

def Stmt.writePairReadAdd
    (lhsSlot lhsValue rhsSlot rhsValue : TypedExpr Ty.uint256) : Stmt :=
  Stmt.seq (Stmt.write lhsSlot lhsValue)
    (Stmt.seq (Stmt.write rhsSlot rhsValue)
      (Stmt.returnLoadAdd lhsSlot rhsSlot))

def Stmt.conditionalWriteRead
    (cond : TypedExpr Ty.bool)
    (slot initialValue branchValue : TypedExpr Ty.uint256) : Stmt :=
  Stmt.seq (Stmt.write slot initialValue)
    (Stmt.seq (Stmt.ifThen cond (Stmt.write slot branchValue))
      (Stmt.returnLoad slot))

def Stmt.ifElse
    (cond : TypedExpr Ty.bool) (thenBody elseBody : Stmt) : Stmt :=
  Stmt.seq (Stmt.ifThen cond thenBody)
    (Stmt.ifThen (TypedExpr.boolNot cond) elseBody)

def Stmt.ifElseWriteRead
    (cond : TypedExpr Ty.bool)
    (slot thenValue elseValue : TypedExpr Ty.uint256) : Stmt :=
  Stmt.seq
    (Stmt.ifElse cond (Stmt.write slot thenValue) (Stmt.write slot elseValue))
    (Stmt.returnLoad slot)

theorem Stmt.writeRead_toFullYul_correct
    (state : State)
    (slot value : TypedExpr Ty.uint256) :
    SolidCoreYulCore.SymYul.evalStmtFuel
        (Stmt.writeRead slot value).fuel
        state.toConfig
        (Stmt.writeRead slot value).toFullYul =
      [SolidCoreYulCore.SymYul.normalResult
        ((Stmt.writeRead slot value).eval state).toConfig] := by
  exact Stmt.toFullYul_correct state (Stmt.writeRead slot value)

