import Verify.Generic.AnyCaller
import flag_4ce5cf9a.Final

/-!
# Flag from any caller

The accepted held-out positive `Flag` (Certified/flag_4ce5cf9a, generated by the driver, unedited)
certified by `Generic.Expected` in **every real context** (`Context.Ok`: every caller below
`2 ^ 160` other than the contract) instead of the default one, over the same fresh runtime bytes
(`Certified.flag_4ce5cf9a.Final.runtimeBytes`, bound by the driver's `Final.bound`) and the same
solc-AST source (`Certified.flag_4ce5cf9a.Final.src`).

Valid calls: every function of the contract on any argument words below `2 ^ 256`, with no value,
from any storage that writes the constructor's slots (`genericValid0`). Calls with a nonzero value
from other callers are not in this statement (docs/GENERIC_INTERFACE.md, "Any caller").
Allowed statuses, postcondition and gas bound (3,580,203): the driver's, unchanged.

The proof reuses the generated modules (the generic check, solar-tv's backend stages, the EVM IR's
fuel, the loop checker's acceptance of the exact bytecode, the exported spec's proof) and adds one
kernel check, `callerFree`: no function's erased tree reads `msg.sender`.
-/

namespace SolidCore.Verify.Generic.Instances.FlagAnyCaller

open SolarTV SolidCore.Refinement SolidCore.Refinement.Shapes SolidCore.Refinement.Solar

abbrev src : Source := Certified.flag_4ce5cf9a.Final.src
abbrev bytes : List Nat := Certified.flag_4ce5cf9a.Final.runtimeBytes
abbrev fns : List SolidCore.Refinement.Abi.Fn := Certified.flag_4ce5cf9a.Lowering.fns
abbrev storage : List (Nat × Nat) := Certified.flag_4ce5cf9a.Lowering.storageLit

/-- The specification in every real context. -/
def spec : Spec where
  Contexts ctx := ctx.Ok
  entries :=
    [("lower()", fun _ => genericValid0 [Certified.flag_4ce5cf9a.Lowering.fn0] storage),
     ("raise(uint256)", fun _ => genericValid0 [Certified.flag_4ce5cf9a.Lowering.fn1] storage),
     ("raised()", fun _ => genericValid0 [Certified.flag_4ce5cf9a.Lowering.fn2] storage),
     ("value()", fun _ => genericValid0 [Certified.flag_4ce5cf9a.Lowering.fn3] storage)]
  Valid _ := genericValid0 fns storage
  Allowed _ := bundleAllowed Certified.flag_4ce5cf9a.gen.Flag.Spec.Flag ctxOfCall
  Post _ := bundlePost Certified.flag_4ce5cf9a.gen.Flag.Spec.Flag ctxOfCall idStep
  gas _ _ := 3580203
  assumptions := []

/-- The postcondition and allowed statuses reject a revert of `lower()` on the no-value calls. -/
theorem nonvacuous0 :
    (∃ (call : Call) (obs : Observable), genericValid0 fns storage call ∧
      ¬ bundlePost Certified.flag_4ce5cf9a.gen.Flag.Spec.Flag ctxOfCall idStep call obs) ∧
    (∃ (call : Call) (obs : Observable), genericValid0 fns storage call ∧ obs.success = false ∧
      ¬ bundleAllowed Certified.flag_4ce5cf9a.gen.Flag.Spec.Flag ctxOfCall call obs) := by
  refine nonvacuous_of_succeeds (valid0_of_find (sel := 3109111917) (n := 0) (covers_zeros _) (by decide))
    (List.getElem_mem _) Certified.flag_4ce5cf9a.Shape.pre_sat_lower
    (by simp [Certified.flag_4ce5cf9a.gen.Flag.Spec.Flag]) ?_
  simp [SolidCore.Spec.Bundle.satAll, SolidCore.Spec.Bundle.sat, Certified.flag_4ce5cf9a.gen.Flag.Spec.Flag,
    SolidCore.Spec.eval, SolidCore.Spec.BinOp.apply, SolidCore.Spec.mkEnv, SolidCore.Spec.Env.cur,
    SolidCore.Spec.ofProp, SolidCore.Spec.slotOf, SolidCore.Spec.Ty.ofBits, SolidCore.Spec.toWord, ctxOfCall]

theorem covered : spec.Covered := by
  refine ⟨⟨_, Context.default_ok⟩, fun _ h => h, ?_, ?_, ?_⟩
  · rintro _ - e he
    simp only [spec, List.mem_cons, List.not_mem_nil, or_false] at he
    rcases he with rfl | rfl | rfl | rfl
    · exact ⟨_, valid0_of_find (sel := 3109111917) (n := 0) (covers_zeros _) (by decide),
        valid0_of_find (sel := 3109111917) (n := 0) (covers_zeros _) (by decide)⟩
    · exact ⟨_, valid0_of_find (sel := 5195779) (n := 1) (covers_zeros _) (by decide),
        valid0_of_find (sel := 5195779) (n := 1) (covers_zeros _) (by decide)⟩
    · exact ⟨_, valid0_of_find (sel := 4041886716) (n := 0) (covers_zeros _) (by decide),
        valid0_of_find (sel := 4041886716) (n := 0) (covers_zeros _) (by decide)⟩
    · exact ⟨_, valid0_of_find (sel := 1067774533) (n := 0) (covers_zeros _) (by decide),
        valid0_of_find (sel := 1067774533) (n := 0) (covers_zeros _) (by decide)⟩
  · obtain ⟨⟨call, obs, hv, hn⟩, -⟩ := nonvacuous0
    exact ⟨_, call, obs, Context.default_ok, hv, hn⟩
  · obtain ⟨-, ⟨call, obs, hv, hs, hn⟩⟩ := nonvacuous0
    exact ⟨_, call, obs, Context.default_ok, hv, hs, hn⟩

set_option maxRecDepth 100000 in
/-- **The caller check**: no function of Flag reads `msg.sender`. -/
theorem caller_free :
    callerFree Certified.flag_4ce5cf9a.Lowering.fuel Certified.flag_4ce5cf9a.Lowering.coreLit fns = true := by
  decide +kernel

/-- **Flag's certificate in every real context.** -/
def certificate : Certificate src spec bytes where
  code := Certified.flag_4ce5cf9a.Final.code
  bound := Certified.flag_4ce5cf9a.Final.bound
  checked := Certified.flag_4ce5cf9a.Shape.contract_ok
  translation := by
    rintro - ctx hctx c hc
    obtain ⟨hk, d, hd⟩ := Certified.flag_4ce5cf9a.Lowering.deployed_of hc
    have hchk := Certified.flag_4ce5cf9a.Lowering.check_stage0
    rw [← hk] at hchk
    have hval := Certified.flag_4ce5cf9a.Lowering.checkValue_stage0
    rw [← hk] at hval
    have hfree := caller_free
    rw [← hk] at hfree
    exact (translationAt_callerFree hd hchk hval hfree
      (Milestone.Flag4ce5cf9a.flag_4ce5cf9a_mir_to_evmir oracle) (fun _ _ => trivial)
      Certified.flag_4ce5cf9a.Shape.ends Certified.flag_4ce5cf9a.Shape.check_ok
      Certified.flag_4ce5cf9a.Shape.gas_lt rfl rfl (genericValid0_inhabited _ _ _) hctx).mono_gas
      (fun _ => Certified.flag_4ce5cf9a.Shape.gas_le) (fun _ => show (3580203 : Nat) < 2 ^ 64 by decide)
  specProof := by
    rintro - ctx hctx c hc
    obtain ⟨hk, d, hd⟩ := Certified.flag_4ce5cf9a.Lowering.deployed_of hc
    have hfree := caller_free
    rw [← hk] at hfree
    obtain ⟨c', hc', h⟩ := Certified.flag_4ce5cf9a.Shape.published
    obtain rfl : c' = c := Except.ok.inj (hc'.symm.trans hc)
    exact specProof_callerFree hd hfree (certifiedAt_default h).spec hctx
  covered := covered

/-- **Flag meets the generic expected theorem from every caller.** -/
theorem expected : Expected src spec bytes := certificate.expected

/-- What it says of the exact bytes, for any caller `a` but the contract: from 3,580,203 gas on, every
no-value call of a function of Flag ends as SolidCore's run sent by `a`, allowed and meeting the
exported specification. -/
theorem bytecode_total_any (a : Nat) (ha : a < 2 ^ 160) (hne : a ≠ selfAddress) (call : Call)
    (hc : genericValid0 fns storage call) :
    ∀ gas, 3580203 ≤ gas → gas < 2 ^ 256 → ∃ obs,
      Final.Target.runWithFrom a gas (runtimeCode bytes) call = some obs ∧
        spec.Allowed ⟨a⟩ call obs ∧ spec.Post ⟨a⟩ call obs :=
  (expected.bytecode_total (fun _ h => by cases h) (ctx := ⟨a⟩) ⟨ha, hne⟩ call hc).2

