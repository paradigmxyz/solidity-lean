import Verify.Spec.MulFacts

/-!
Regression checks for `mul_close`: solc's checked multiplication of three words, from a
succeeds-if that bounds their product, with and without a zero factor's test.
-/

namespace SolidCore.Spec.MulFactsCheck

open SolidCore.Spec

/-- The product of the first two words divides back once the product of all three is below
`2 ^ 256` and the third is not zero. -/
example (a0 a1 a2 : Nat) (hsi : True ∧ (a0 : Int) * a1 * a2 < 115792089237316195423570985008687907853269984665640564039457584007913129639936)
    (h2 : ¬a2 = 0)
    (h1 : ¬a0 * a1 % 115792089237316195423570985008687907853269984665640564039457584007913129639936 % 115792089237316195423570985008687907853269984665640564039457584007913129639936 * a2 % 115792089237316195423570985008687907853269984665640564039457584007913129639936 % 115792089237316195423570985008687907853269984665640564039457584007913129639936 / a2 % 115792089237316195423570985008687907853269984665640564039457584007913129639936 = a0 * a1 % 115792089237316195423570985008687907853269984665640564039457584007913129639936 % 115792089237316195423570985008687907853269984665640564039457584007913129639936) : False := by
  mul_close

/-- With no test of the third word: the factors' widths bound the first product. -/
example (a0 a1 : Nat) (h0 : a0 < 256) (h1 : a1 < 65536) (h : ¬a1 = 0)
    (hd : ¬a0 * a1 % 115792089237316195423570985008687907853269984665640564039457584007913129639936 % 115792089237316195423570985008687907853269984665640564039457584007913129639936 / a1 % 115792089237316195423570985008687907853269984665640564039457584007913129639936 = a0) : False := by
  mul_close

end SolidCore.Spec.MulFactsCheck
