import Verify.LoopSource.Equiv.Inv

/-!
# Emitting a loop's obligations as a module (untrusted)

`emitObl` writes a Lean module that states a loop's leaves, inferred invariant and measure as data,
checks in the kernel that they are what `Cut.check` and the source's tree give, and checks each task
of `Inv.checkWith` in its own theorem (`checkWith_of_each`), so no single kernel check holds every
refutation. Everything it writes is checked; a wrong emission fails the build.
-/

namespace Verify.LoopSource.Equiv.Inv
open SolidCore.Refinement.Generic Verify.LoopSource.Equiv

/-- Equality of leaves as a \`Bool\`, by structural recursion, through \`Tree.beq\`. -/
def outBeq : Out → Out → Bool
  | .exit a, .exit b => Tree.beq a b
  | .back h, .back h' => decide (h = h')
  | _, _ => false

theorem outBeq_eq : ∀ {a b : Out}, outBeq a b = true → a = b
  | .exit _, .exit _, h => by rw [Tree.eq_of_beq h]
  | .back _, .back _, h => by simp only [outBeq, decide_eq_true_eq] at h; rw [h]
  | .exit _, .back _, h => by simp [outBeq] at h
  | .back _, .exit _, h => by simp [outBeq] at h

def leavesBeq : List (Facts × Out) → List (Facts × Out) → Bool
  | [], [] => true
  | p :: ps, q :: qs => decide (p.1 = q.1) && outBeq p.2 q.2 && leavesBeq ps qs
  | _, _ => false

theorem leavesBeq_eq : ∀ {a b : List (Facts × Out)}, leavesBeq a b = true → a = b
  | [], [], _ => rfl
  | p :: ps, q :: qs, h => by
    simp only [leavesBeq, Bool.and_eq_true, decide_eq_true_eq] at h
    obtain ⟨⟨h1, h2⟩, h3⟩ := h
    rw [leavesBeq_eq h3, Prod.ext h1 (outBeq_eq h2)]
  | [], _ :: _, h => by simp [leavesBeq] at h
  | _ :: _, [], h => by simp [leavesBeq] at h

/-- A check's result is the given leaves. -/
def resBeq (r : Option (List (Facts × Out) × List (Facts × Out))) (le li : List (Facts × Out)) : Bool :=
  match r with
  | some (a, b) => leavesBeq a le && leavesBeq b li
  | none => false

theorem resBeq_eq {r : Option (List (Facts × Out) × List (Facts × Out))} {le li : List (Facts × Out)}
    (h : resBeq r le li = true) : r = some (le, li) := by
  cases r with
  | none => simp [resBeq] at h
  | some p =>
    obtain ⟨a, b⟩ := p
    simp only [resBeq, Bool.and_eq_true] at h
    rw [leavesBeq_eq h.1, leavesBeq_eq h.2]

/-- A tree is the given one. -/
def treeBeq (r : Option Tree) (T : Tree) : Bool :=
  match r with
  | some a => Tree.beq a T
  | none => false

theorem treeBeq_eq {r : Option Tree} {T : Tree} (h : treeBeq r T = true) : r = some T := by
  cases r with
  | none => simp [treeBeq] at h
  | some a => simp only [treeBeq] at h; rw [Tree.eq_of_beq h]

/-- The module text. `chk` is the term `Cut.check …` and `tree` the term `brTree …`, as Lean
source. -/
def emitObl (imports : List String) (ns opens : String) (chk tree : String) (n : Nat) (cases : String)
    (le li : List (Facts × Out)) (T : Tree) (I : List F) (μ : WExpr) : String :=
  let k := (tasks le li I).length
  let hdr := String.intercalate "\n" (imports.map ("import " ++ ·)) ++ "\n\n" ++
    "/-! Generated by `Inv.emitObl`; every fact below is checked by the kernel. -/\n\n" ++
    s!"namespace {ns}\n{opens}\nopen Verify.LoopSource.Equiv Verify.LoopSource.Equiv.Inv\n\n"
  let defs := s!"def le : List (Facts × Out) := {reprStr le}\n\ndef li : List (Facts × Out) := {reprStr li}\n\n" ++
    s!"def T : Tree := {reprStr T}\n\ndef I : List F := {reprStr I}\n\ndef μ : WExpr := {reprStr μ}\n\n" ++
    s!"theorem leaves : {chk} = some (le, li) := resBeq_eq (by decide +kernel)\n\n" ++
    s!"theorem tree : {tree} = some T := treeBeq_eq (by decide +kernel)\n\n" ++
    s!"theorem ntasks : (tasks le li I).length = {k} := by decide +kernel\n\n"
  let ts := (List.range k).map fun i =>
    s!"theorem task{i} : ((tasks le li I)[{i}]'(by rw [ntasks]; decide)).ok {n} {cases} T I μ = true := by\n  decide +kernel\n"
  let arms := String.intercalate "\n" ((List.range k).map fun i => s!"    | {i}, _ => task{i}")
  let fin := s!"\n/-- **The loop's obligations hold.** -/\ntheorem check : checkWith {n} {cases} T le li I μ = true :=\n" ++
    s!"  checkWith_of_each fun i hi => by\n    rw [ntasks] at hi\n    match i, hi with\n{arms}\n\nend {ns}\n"
  hdr ++ defs ++ String.intercalate "\n" ts ++ fin

end Verify.LoopSource.Equiv.Inv
