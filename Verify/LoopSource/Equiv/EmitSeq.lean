import Verify.LoopSource.Equiv.Seq

/-!
# Inferring a loop's invariant from traces, and emitting its sequents (untrusted)

Nothing here is trusted: what it emits is a module of sequents whose validity the kernel checks
(`wordnorm` proofs) and whose relation to the leaves the kernel computes (`allSeqs … = some ss`).

`traceVals` runs the leaves of a cut-point check on concrete calls: from the entry run's leaf whose
facts hold, then the iteration runs' leaves, collecting every header valuation reached. `inferT`
keeps the candidates (`cands`) that hold at all of them, and `measureT` the first candidate measure
that falls on every step. `emitSeqs` writes the modules.
-/

namespace Verify.LoopSource.Equiv.Inv
open SolidCore.Refinement.Generic Verify.LoopSource.Equiv

/-- A path's facts hold at a valuation. -/
def factsHoldB (σ : Val) (K : Facts) : Bool := K.all fun p => (p.1.eval σ == 0) == !p.2

/-- The leaf whose facts hold. -/
def leafAt (σ : Val) (ls : List (Facts × Out)) : Option Out := (ls.find? (factsHoldB σ ·.1)).map (·.2)

/-- The header valuations a call reaches, at most `fuel` iterations. -/
def traceFrom (n : Nat) (li : List (Facts × Out)) : Nat → Val → List Val
  | 0, _ => []
  | k + 1, σ => σ :: match leafAt σ li with
    | some (.back hs) => traceFrom n li k (nextVal n σ hs)
    | _ => []

def traceVals (n : Nat) (le li : List (Facts × Out)) (calls : List Val) (fuel : Nat) : List Val :=
  calls.flatMap fun ρ => match leafAt ρ le with
    | some (.back hs) => traceFrom n li fuel (nextVal n ρ hs)
    | _ => []

/-- The calls to trace: small and boundary argument and storage words. -/
def callsOf (n : Nat) (slots : Nat) : List Val :=
  let ws : List Nat := [0, 1, 2, 3, 7, wordSize - 2, wordSize - 1]
  let argss := (List.range n).foldr (fun _ acc => ws.flatMap fun w => acc.map (w :: ·)) [[]]
  let stores := (List.range slots).foldr (fun _ acc => [0, 5, 9, wordSize - 2].flatMap fun w => acc.map (w :: ·)) [[]]
  argss.flatMap fun as => stores.map fun st =>
    { args := as, store := fun k => st.getD k 0, hash := fun _ _ => 0, caller := 0 }

def holdsB (σ : Val) (f : F) : Bool := decide (f.Holds σ)

/-- The candidates that hold at every traced header valuation. -/
def inferT (n nhw : Nat) (le li : List (Facts × Out)) (vals : List Val) : List F :=
  (cands n nhw le li).filter fun f => vals.all (holdsB · f)

/-- The first candidate measure that falls on every traced step. -/
def measureT (n : Nat) (li : List (Facts × Out)) (vals : List Val) : Option WExpr :=
  (measures n li).find? fun μ => vals.all fun σ => match leafAt σ li with
    | some (.back hs) => decide ((Inv.sub n hs μ).eval σ < μ.eval σ)
    | _ => true

/-! ## Emission -/

def chunks {α : Type} (k : Nat) (l : List α) : List (List α) :=
  let m := (l.length + k - 1) / k
  (List.range k).map (fun i => (l.drop (i * m)).take m) |>.filter (· ≠ [])

/-- The modules: `<pre>Data` (the leaves, invariant, measure and unique sequents `q_i`), `<pre>V<j>`
(each sequent's `wordnorm` proof) and `<pre>Obl` (the obligations). Returns (file stem, text). -/
def emitSeqs (dataImports oblImports : List String) (pre ns opens chk tree : String) (n : Nat) (cases : String)
    (le li : List (Facts × Out)) (T : Tree) (I : List F) (μ : WExpr) (ss : List Seq) (files : Nat) (ext? : Option String := none) :
    List (String × String) :=
  let uniq := ss.eraseDups
  let idx (s : Seq) : Nat := uniq.idxOf s
  let hdr (imps : List String) (sub opens : String) :=
    String.intercalate "\n" (imps.map ("import " ++ ·)) ++ "\n\n" ++
    "/-! Generated by `Inv.emitSeqs`; every fact below is checked by the kernel. -/\n\n" ++
    s!"namespace {ns}{sub}\n{opens}\nopen Verify.LoopSource.Equiv Verify.LoopSource.Equiv.Inv\n\n"
  let data := hdr dataImports "" "" ++
    s!"def le : List (SolidCore.Refinement.Generic.Facts × Verify.LoopSource.Equiv.Out) := {reprStr le}\n\ndef li : List (SolidCore.Refinement.Generic.Facts × Verify.LoopSource.Equiv.Out) := {reprStr li}\n\n" ++
    s!"def T : SolidCore.Refinement.Generic.Tree := {reprStr T}\n\ndef I : List Verify.LoopSource.Equiv.Inv.F := {reprStr I}\n\ndef μ : SolidCore.Refinement.Generic.WExpr := {reprStr μ}\n\n" ++
    String.intercalate "\n" ((uniq.zipIdx).map fun (s, i) => s!"def q{i} : Seq := {reprStr s}\n") ++
    s!"\ndef ss : List Seq := [{String.intercalate ", " (ss.map fun s => s!"q{idx s}")}]\n\nend {ns}\n"
  let groups := chunks files (uniq.zipIdx)
  let vfiles := (groups.zipIdx).map fun (g, j) =>
    (s!"{pre}V{j}", hdr [s!"{pre.replace "/" "."}Data"] "" "" ++
      String.intercalate "\n" (g.map fun (_, i) =>
        s!"theorem v{i} : Seq.Valid q{i} := by\n  simp only [q{i}, Seq.Valid]\n  wordnorm\n") ++ s!"\nend {ns}\n")
  let vimps := (groups.zipIdx).map fun (_, j) => s!"{pre.replace "/" "."}V{j}"
  let conj := ss.foldr (fun s acc => s!"List.forall_mem_cons.mpr ⟨v{idx s}, {acc}⟩") "fun _ h => absurd h List.not_mem_nil"
  let lit := "[" ++ String.intercalate ", " (ss.map fun s => s!"q{idx s}") ++ "]"
  let obl := hdr (["Verify.LoopSource.Equiv.Emit", "SolidCore.Refinement.KernelRfl"] ++ oblImports ++ vimps) "" opens ++
    s!"theorem leaves : {chk} = some (le, li) := resBeq_eq (by decide +kernel)\n\n" ++
    (match ext? with
      | some ext => ext ++ s!"theorem tree : {tree} = some T := by\n  rw [Verify.LoopSource.Equiv.GenObl.treeOf_of_shape _ shape_eq]\n  exact treeBeq_eq (by decide +kernel)\n\n"
      | none => s!"/-- The source tree, as the kernel computes it by conversion (`kernel_rfl`). -/\ndef treeV : Option SolidCore.Refinement.Generic.Tree := {tree}\n\nkernel_rfl tree_eq treeV (some T)\n\ntheorem tree : {tree} = some T := tree_eq\n\n") ++
    s!"theorem seqs : allSeqs {n} {cases} T le li I μ = some ss := by decide +kernel\n\n" ++
    s!"theorem valid : ∀ s ∈ ss, s.Valid :=\n  show ∀ s ∈ {lit}, Seq.Valid s from\n  {conj}\n\n" ++
    s!"/-- **The loop's obligations hold.** -/\ntheorem obl : Obl (fun _ => recOf I μ) id (fun _ => True) (fun _ => True) {n} {cases} T le li :=\n  obl_of_seqs seqs valid\n\nend {ns}\n"
  [(s!"{pre}Data", data)] ++ vfiles ++ [(s!"{pre}Obl", obl)]

end Verify.LoopSource.Equiv.Inv
