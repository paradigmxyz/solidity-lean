+/// Inlines the definitions of the script's constants in `t` until only `keep` atoms (and
+/// symbols that are not constants) remain; None when a constant without definition remains.
+fn inline(s: &Script, t: &Sexp, keep: &FxHashMap<String, String>, depth: usize) -> Option<Sexp> {
+    if depth > 64 {
+        return None;
+    }
+    match t {
+        Sexp::Atom(a) => {
+            if let Some(p) = keep.get(a) {
+                return Some(Sexp::Atom(p.clone()));
+            }
+            if !s.consts.contains_key(a) {
+                return Some(t.clone());
+            }
+            let d = s.defs.get(a)?;
+            let rhs = d.as_list()?.get(2)?;
+            inline(s, rhs, keep, depth + 1)
+        }
+        Sexp::List(xs) => Some(Sexp::List(
+            xs.iter().map(|x| inline(s, x, keep, depth)).collect::<Option<Vec<_>>>()?,
+        )),
+    }
+}
+
+impl<'p, 'a> Vc<'p, 'a> {
+    /// STUB of the loop-VC export, for the consumer in solidity-lean until the frozen exporter
+    /// lands: per loop of the function's real run, its Horn view (one cutpoint predicate `Inv`
+    /// over the head's value-type variables and the pre-state values, and one clause per edge:
+    /// entry, back, each reverting path of the body, and each obligation after the loop) and
+    /// metadata naming each edge, the annotated invariants and decreases over the parameters.
+    pub(super) fn loopvc_stub(
+        &self,
+        transcript: &str,
+    ) -> Vec<(String, serde_json::Value, Vec<(String, Span)>)> {
+        let mut out = vec![];
+        let Some(script) = Script::parse(transcript) else { return out };
+        for (k, l) in self.loop_recs.iter().enumerate() {
+            let mut params: Vec<(String, String, String)> = l.vars.clone();
+            let mut entry = l.entry_terms.clone();
+            let mut back = l.back_terms.clone();
+            for (n, t, s) in &l.old {
+                params.push((format!("old.{n}"), t.clone(), s.clone()));
+                entry.push(t.clone());
+                back.push(t.clone());
+            }
+            let head: Vec<String> = params.iter().map(|p| p.1.clone()).collect();
+            let app = |ts: &[String]| format!("(|Inv| {})", ts.join(" "));
+            let mut macros = BTreeSet::new();
+            let mut clauses = String::new();
+            let mut edges = vec![];
+            let mut spans = vec![];
+            let mut add = |id: String,
+                           kind: &str,
+                           outcome: &str,
+                           c: Option<String>,
+                           extra: serde_json::Value,
+                           span: Span,
+                           edges: &mut Vec<serde_json::Value>| {
+                let i = edges.len();
+                let mut e = serde_json::json!({
+                    "id": id, "kind": kind, "outcome": outcome,
+                    "from": if kind == "entry" { serde_json::Value::Null } else { "Inv".into() },
+                    "to": if kind == "entry" || kind == "back" { "Inv".into() } else { serde_json::Value::Null },
+                    "span": null, "supported": c.is_some(),
+                });
+                if let (Some(o), Some(x)) = (e.as_object_mut(), extra.as_object()) {
+                    for (a, b) in x {
+                        o.insert(a.clone(), b.clone());
+                    }
+                }
+                spans.push((format!("/edges/{i}/span"), span));
+                match c {
+                    Some(c) => clauses.push_str(&format!("; edge {id}\n{c}")),
+                    None => clauses.push_str(&format!("; edge {id}: outside the Horn fragment\n")),
+                }
+                edges.push(e);
+            };
+            let c = clause(&script, std::slice::from_ref(&l.entry_guard), &app(&entry), &mut macros);
+            add("entry".into(), "entry", "normal", c, serde_json::json!({}), l.span, &mut edges);
+            let c = clause(&script, &[app(&head), l.back_guard.clone()], &app(&back), &mut macros);
+            add("back.0".into(), "back", "normal", c, serde_json::json!({}), l.span, &mut edges);
+            for (j, g) in l.reverts.iter().enumerate() {
+                // A site is '(and GUARD COND)' (reverts_if), the guard a named Boolean: the edge
+                // reaches the site under GUARD, and reverts when COND holds there.
+                let (g, goal) = match term(g).as_ref().and_then(Sexp::as_list) {
+                    Some([h, g, c]) if h.as_atom() == Some("and") && g.as_atom().is_some() => {
+                        (g.to_string(), format!("(not {c})"))
+                    }
+                    _ => (g.clone(), "false".to_string()),
+                };
+                let c = clause(&script, &[app(&head), g], &goal, &mut macros);
+                add(format!("revert.{j}"), "revert", "revert", c, serde_json::json!({}), l.span, &mut edges);
+            }
+            let from = l.exit_from.min(self.stub_checks.len());
+            for (j, (g, phi, kind, sp)) in self.stub_checks[from..].iter().enumerate() {
+                let c = clause(&script, &[app(&head), g.clone()], phi, &mut macros);
+                add(format!("exit.{j}"), "exit", "normal", c, serde_json::json!({ "check": kind }), *sp, &mut edges);
+            }
+            let mut text = String::from("(set-logic HORN)\n");
+            for (n, m) in &script.macros {
+                if macros.contains(n) {
+                    text.push_str(&format!("{m}\n"));
+                }
+            }
+            let sorts: Vec<&str> = params.iter().map(|v| v.2.as_str()).collect();
+            text.push_str(&format!("(declare-fun |Inv| ({}) Bool)\n", sorts.join(" ")));
+            text.push_str(&clauses);
+            text.push_str("(check-sat)\n");
+            let keep: FxHashMap<String, String> =
+                params.iter().map(|p| (p.1.clone(), format!("|{}|", p.0))).collect();
+            let over = |t: &str| term(t).and_then(|t| inline(&script, &t, &keep, 0)).map(|t| t.to_string());
+            let mut invs = vec![];
+            for (i, (t, txt, sp)) in l.invs.iter().enumerate() {
+                invs.push(serde_json::json!({ "text": txt, "smt": over(t), "span": null }));
+                spans.push((format!("/candidates/0/clauses/{i}/span"), *sp));
+            }
+            let mut decs = vec![];
+            for (i, (t, txt, sp)) in l.decs.iter().enumerate() {
+                decs.push(serde_json::json!({ "cutpoint": "Inv", "text": txt, "smt": over(t), "span": null }));
+                spans.push((format!("/rankings/{i}/span"), *sp));
+            }
+            spans.push(("/cutpoints/0/span".into(), l.span));
+            let meta = serde_json::json!({
+                "format": "solar-verify-loopvc-stub",
+                "version": 0,
+                "loop": k,
+                "cutpoints": [{
+                    "id": "Inv", "predicate": "Inv", "span": null,
+                    "params": params.iter().map(|p| serde_json::json!({ "name": p.0, "sort": p.2, "head": p.1 })).collect::<Vec<_>>(),
+                }],
+                "edges": edges,
+                "candidates": [{ "id": "annotated", "origin": "annotated", "cutpoint": "Inv", "clauses": invs }],
+                "rankings": decs,
+            });
+            out.push((text, meta, spans));
+        }
+        out
+    }
+}
