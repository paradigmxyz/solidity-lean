import Verify.LoopSource.Equiv.EraseLoopCounterJoin
import Verify.Gas.FixedFuel.Gen.Counter

/-!
# Counter.bump through the erasure join, on the generated fixed-fuel premises

`counter_join_generated` has `EraseLoopJoin.Counter.counter_join`'s statement: the same contract,
bytes, valid calls `bump(a)` with `a ≤ K`, postcondition and gas bound `K * 1414400 + 3536012`, for
every `K ≤ Kmax`. Its fixed-fuel premises of `GeneratedTarget` (`checkL`, `Loops` and the 64-bit
fit) are the ones solar's tools/certify/loop_resources.py generated from Counter's export
(`Gen.Counter.premises`), with the generated record, certificate and bytes, in place of the
hand-written bridge `EraseLoopJoin.Counter.loops`. The generated bytes and certificate are, by
evaluation, the ones the hand-written statement names.
-/

namespace Verify.Gas.FixedFuel.Gen.CounterJoin
open SolarTV SolarTV.Machine SolarTV.MIR.Lowered SolidCore.Refinement SolidCore.Refinement.Generic
open SolidCore.Solidity.Source Verify.LoopSource.Interface Verify.LoopSource.Generic
open SolidCore.Refinement.Generic.Loop SolidCore.Refinement.Solar
open Contracts.VerifyCounter.Source Verify.LoopSource.MirLink
open Verify.LoopSource.Equiv.EraseLoopJoin Verify.LoopSource.Equiv.EraseLoopJoin.Counter
open SolarTV.Export.Counter Verify.LoopSource.Equiv.CounterResources Verify.Gas.FixedFuel
open Verify.LoopSource Verify.LoopSource.Equiv

/-- A bounded call of `bump` is a valid call of the generated module. -/
theorem valid_of {K : Nat} {call : Call}
    (hv : Verify.LoopSource.Equiv.CounterGas.BumpCallBounded K call) : Gen.Counter.Valid K call := by
  obtain ⟨σ, a, haK, ha, rfl⟩ := hv
  exact ⟨σ, a, ha, haK, rfl⟩

/-- The generated certificate's bound is the hand-written one's. -/
theorem gas_eq (K : Nat) :
    AssembleLoop.gasBoundL Gen.Counter.cert (fixedFuel 2 2 3 K) = K * 1414400 + 3536012 :=
  G_eq K

/-- **Counter.bump, certified through the erasure join on the generated premises.** -/
theorem counter_join_generated {K : Nat} (hK : K ≤ Kmax) :
    ∃ c, contract? = .ok c ∧
      Shapes.Certified stmtSem c SolarTV.Milestone.X.code
        (Verify.LoopSource.Equiv.CounterGas.BumpCallBounded K) (fun _ _ => True) BumpPost
        (fun _ => K * 1414400 + 3536012) := by
  obtain ⟨hchk, hloops, hfit⟩ := Gen.Counter.premises (K := K)
    (by unfold Gen.Counter.Kmax; unfold Kmax at hK; omega)
  obtain ⟨c, hc⟩ := contract_ok
  obtain ⟨TL, hTL⟩ := loop_tree
  have hsame : ∀ ρ : Val, ρ.Ok → (TL.eval ρ).obs = (CounterObl.T.eval ρ).obs :=
    fun ρ _ => congrArg Res.obs (tree_same hTL CounterObl.tree ρ)
  have h := eraseLoop_certified_generated Contracts.VerifyCounter.Source.fuel c bumpSel bumpFn [256]
    EraseLoopCounter.bumpLoopBr TL (by decide) (shape_of hc).2.2 rfl rfl (erased hc) hTL
    Generated.Counter.cut .off stage0 CounterObl.le CounterObl.li CounterObl.leaves CounterObl.T
    CounterObl.I CounterObl.μ CounterObl.ss CounterObl.seqs CounterObl.valid hsame evm7
    Gen.Counter.code _ Gen.Counter.cert Gen.Counter.maxs
    (SolarTV.Milestone.X.counterLoop_mir_to_evmir Shapes.oracle) (fun _ _ => trivial)
    hchk (Verify.LoopSource.Equiv.CounterGas.BumpCallBounded K)
    (fun _ _ => True) BumpPost
    (fun call hv => by
      obtain ⟨σ, a, -, ha, rfl⟩ := hv
      exact ⟨σ, [a], args_one ha, rfl⟩)
    (Verify.LoopSource.Equiv.CounterGas.bounded_inhabited K) (fun _ _ _ => trivial)
    (onTree_of tree_post CounterObl.tree) Gen.Counter.record 2 2 3 K
    (fun call hv => hloops call (valid_of hv)) hfit
  refine ⟨c, hc, ?_⟩
  have hG : (fun _ : Call => AssembleLoop.gasBoundL Gen.Counter.cert (fixedFuel 2 2 3 K)) =
      fun _ => K * 1414400 + 3536012 := funext fun _ => gas_eq K
  rw [← hG]
  exact h

end Verify.Gas.FixedFuel.Gen.CounterJoin

/-- info: 'Verify.Gas.FixedFuel.Gen.CounterJoin.counter_join_generated' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms Verify.Gas.FixedFuel.Gen.CounterJoin.counter_join_generated
