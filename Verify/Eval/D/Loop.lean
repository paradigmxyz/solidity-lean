import Verify.Eval.D.Bridge
import Verify.Eval.D.SpacerInv
import Verify.Eval.Common.Measure
import Verify.CounterBump

/-!
# Lane D, target 2: Counter.bump's loop with invariants supplied from outside

The statement is `Verify.CounterBump.bump_spec`'s, unchanged (`BumpStmt`).

* `bump_old`: the repository's proof (Loom's loop rule `triple_whileM` by hand, with
  `body_step`), copied verbatim so it is elaborated and measured in this file.
* `bump_new_annot`: `vcgen` with `whileM_spec` given the annotated invariant (`i <= n`,
  `count == old(count) + i`, and the frame and pre-loop fact a loop invariant carries) and the
  annotated variant `n - i`; residual VCs closed by `grind` (`with finish`).
* `bump_new_spacer`: the same with z3 Spacer's invariant (`SpacerInv.lean`, generated by
  `Verify/Infer/smt2lean_inv.py` from `Verify/Infer/chc/counter_u256.spacer.out`, unedited) in
  place of the annotation, conjoined with the frame (the slots the loop does not write) and the
  pre-loop path fact `count + n < 2 ^ 256`, which the Horn problem keeps as a guard and so does
  not put in the invariant.

Nothing unrolls the loop: establishment, preservation with the decreasing variant, exit and the
fuel bound are the VCs of `whileM_spec`.
-/

namespace SolidCore.Verify.Eval.D.Loop

open SolidCore.Verify SolidCore.Refinement SolidCore.Verify.CounterBump
open scoped Std.WP

set_option experimental.vcgen true
set_option grind.warning false
set_option Elab.async false

attribute [local grind] Spacer.Inv_counter_u256

/-- `bump_spec`'s statement. -/
abbrev BumpStmt : Prop :=
  ∀ (n : Nat) (s : Storage) (herr : Revert → Prop),
    (s 0 + n < 2 ^ 256 → ¬ s 0 + n ≤ s 1 → herr (errorString "over")) →
    (¬ s 0 + n < 2 ^ 256 → herr (panic 0x11)) →
    wp (model n)
      (fun _ _ s' => s' 0 = s 0 + n ∧ ∀ k, k % 2 ^ 256 ≠ 0 → s' k = s k)
      herr s

example : BumpStmt = (∀ (n : Nat) (s : Storage) (herr : Revert → Prop)
    (hover : s 0 + n < 2 ^ 256 → ¬ s 0 + n ≤ s 1 → herr (errorString "over"))
    (hpanic : ¬ s 0 + n < 2 ^ 256 → herr (panic 0x11)),
    wp (model n) (fun _ _ s' => s' 0 = s 0 + n ∧ ∀ k, k % 2 ^ 256 ≠ 0 → s' k = s k) herr s) := rfl

/-- `bump_spec` itself typechecks at `BumpStmt`. -/
example : BumpStmt := bump_spec

/-! ## Baseline: the repository's proof -/

#timed theorem body_step_old (n : Nat) (s : Storage) (i : Nat) (hi : decide (i < n) = true) :
    triple (inv n s i) (body i) (fun i' => inv n s i' ⊓ ⌜variant n i' < variant n i⌝) := by
  have hlt : i < n := by simpa using hi
  intro herr s' ⟨hle, hc, hframe, hbound⟩
  simp only [body, wp_bind, wp_sload, wp_ite, wp_pure, wp_revert, wp_sstore]
  have h1 : s' 0 + 1 < 2 ^ 256 := by omega
  simp only [h1, ite_true]
  refine ⟨⟨by omega, ?_, ?_, hbound⟩, ?_⟩
  · simp only [ite_true]
    rw [Nat.mod_eq_of_lt h1]; omega
  · intro k hk
    simp only [Nat.zero_mod, hk, ite_false]
    exact hframe k hk
  · show (⌜variant n (i + 1) < variant n i⌝ : Assn) herr _
    have hv : variant n (i + 1) < variant n i := by simp only [variant]; omega
    simp only [LE.pure, hv]; trivial

#timed theorem bump_old : BumpStmt := by
  intro n s herr hover hpanic
  simp only [model, wp_bind, wp_sload, wp_ite, wp_pure, wp_revert]
  by_cases hb : s 0 + n < 2 ^ 256
  · simp only [hb, ite_true]
    by_cases hl : s 0 + n ≤ s 1
    · simp only [hl, ite_true]
      have hloop := triple_whileM (fun i => decide (i < n)) body (inv n s) (variant n)
        (body_step_old n s) (n + 1) 0 (by simp [variant])
      have h0 : inv n s 0 herr s := ⟨Nat.zero_le _, by simp, fun _ _ => rfl, hb⟩
      have := wp_cons _ _ (fun (_ : Nat) => fun (_ : Revert → Prop) s' =>
          s' 0 = s 0 + n ∧ ∀ k, k % 2 ^ 256 ≠ 0 → s' k = s k) ?_ herr s (hloop herr s h0)
      · simpa [wp_pure] using this
      · intro i herr' s' ⟨⟨hle, hc, hframe, _⟩, hdone⟩
        have hni : n ≤ i := by
          by_contra hne
          have : decide (i < n) = true := by simp; omega
          simp [LE.pure, this] at hdone
        exact ⟨by rw [hc]; congr 1; omega, hframe⟩
    · simp only [hl, ite_false]; exact hover hb hl
  · simp only [hb, ite_false]; exact hpanic hb

/-! ## `vcgen` with the annotated invariant -/

/-- The annotation `i <= n`, `count == old(count) + i`, with the frame and the pre-loop fact. -/
abbrev annotInv (n : Nat) (s : Storage) (i : Nat) (s' : Storage) : Prop :=
  i ≤ n ∧ s' 0 = s 0 + i ∧ (∀ k, k % 2 ^ 256 ≠ 0 → s' k = s k) ∧ s 0 + n < 2 ^ 256

#timed theorem bump_new_annot : BumpStmt := by
  intro n s herr hover hpanic
  refine loom_wp_of_triple_pt ?_
  vcgen [model, body, whileM_spec (inv := annotInv n s) (measure := fun i => n - i), annotInv]
    with finish

/-! ## `vcgen` with Spacer's invariant -/

/-- Spacer's invariant on (old count, n, limit, i, count), with the frame and the pre-loop fact. -/
abbrev spacerInv (n : Nat) (s : Storage) (i : Nat) (s' : Storage) : Prop :=
  Spacer.Inv_counter_u256 (s 0) n (s 1) i (s' 0) ∧ (∀ k, k % 2 ^ 256 ≠ 0 → s' k = s k) ∧
    s 0 + n < 2 ^ 256

#timed theorem bump_new_spacer : BumpStmt := by
  intro n s herr hover hpanic
  refine loom_wp_of_triple_pt ?_
  vcgen [model, body, whileM_spec (inv := spacerInv n s) (measure := fun i => n - i), spacerInv,
    Spacer.Inv_counter_u256] with finish

#print axioms bump_old
#print axioms bump_new_annot
#print axioms bump_new_spacer
#proof_stats bump_old
#proof_stats body_step_old
#proof_stats bump_new_annot
#proof_stats bump_new_spacer
#kernel_recheck bump_old
#kernel_recheck body_step_old
#kernel_recheck bump_new_annot
#kernel_recheck bump_new_spacer

end SolidCore.Verify.Eval.D.Loop
