import Verify.Eval.C.Stepper
import Verify.Eval.Common.Measure
import SolidCore.Refinement.Corpus.C1.Defs
import SolidCore.Refinement.Dirty.Source

/-!
# Lane C pilot on a generated end-to-end VC: c1's dirty-argument theorem

`SolidCore/Refinement/Corpus/C1/Dirty.lean` is generated by `scripts/refinement/gen.sh` from
`scripts/refinement/corpus/c1.sol` (solar's runtime bytecode of `f(uint8)`, 83 bytes): every dirty
call reverts in EthLib, by one `dirty_symex` run under `dirty_of_frame`. The statement
`Dirty.TargetDirty code fns` is copied verbatim; `target_dirty_base` is the generated proof verbatim,
`target_dirty_sym` the same reduction with the frame obligation proved by `evm_sym`.
-/

namespace Verify.Eval.C.GenC1

open SolidCore.Refinement SolidCore.Refinement.Abi SolidCore.Refinement.Evm.Symex
open SolidCore.Refinement.Corpus.C1
open EthLib.Base EthLib.Execution EthLib.Execution.Evm
open SolidCore.Refinement.Evm

/-- The selector of the call data, as the stepper's normalized SHR leaves it. -/
theorem shr224_cdOf (s : Nat) (args : List U256) (hs : s < 2 ^ 32) :
    loadWord (cdOf (selectorOf s) args) 0 32 >>> 224 = BitVec.ofNat 256 s := by
  have := shr_cdOf_selectorOf s args hs
  simpa [bitwiseShr] using this

set_option maxHeartbeats 4000000 in
set_option maxRecDepth 8192 in
/-- EthLib rejects every dirty call of every function of `Main` (generated proof, verbatim). -/
theorem target_dirty_base : Dirty.TargetDirty code fns := by
  intro fn hfn
  simp only [fns, List.mem_cons, List.not_mem_nil, or_false] at hfn
  rcases hfn with rfl
  · exact dirty_of_frame code Bytecode.C1.Main.fSelector [(.uint 8)]
      (by dirty_symex [code, Bytecode.C1.Main.runtimeNat, Bytecode.C1.Main.runtimeSize, Bytecode.C1.Main.fSelector])

set_option maxHeartbeats 4000000 in
set_option maxRecDepth 8192 in
/-- The same theorem, the frame obligation by the lane C stepper. -/
theorem target_dirty_sym : Dirty.TargetDirty code fns := by
  intro fn hfn
  simp only [fns, List.mem_cons, List.not_mem_nil, or_false] at hfn
  rcases hfn with rfl
  · refine dirty_of_frame code Bytecode.C1.Main.fSelector [(.uint 8)] ?_
    intro ws hl hdirty msg hv hd st ss
    simp only [Bytecode.C1.Main.fSelector] at hd
    rcases ws with _ | ⟨a1, _ | ⟨a2, _⟩⟩ <;> try (simp at hl; done)
    simp only [cleanAllBv, cleanBv, and_true, Nat.reduceLT, Nat.reducePow, ite_true,
      BitVec.ofNat_eq_ofNat] at hdirty
    evm_sym [code, Bytecode.C1.Main.runtimeNat, Bytecode.C1.Main.runtimeSize] using
      [hd, hv, loadWord_cdOf_getD, shr224_cdOf, size_cdOf, size_selectorOf, List.getD_cons_zero]

#proof_stats target_dirty_base
#proof_stats target_dirty_sym
#kernel_recheck target_dirty_base
#kernel_recheck target_dirty_sym
#print axioms target_dirty_sym

end Verify.Eval.C.GenC1
