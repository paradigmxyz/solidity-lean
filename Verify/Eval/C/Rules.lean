theorem step_jump {d : U256} {rest : List U256} (hlt : pc < size)
    (hb : n >>> (8 * (size - 1 - pc)) % 256 = 0x56) (hgas : 8 ≤ gas)
    (hw : walk n size size 0 d.toNat = true) (hd : d.toNat < size)
    (hjd : n >>> (8 * (size - 1 - d.toNat)) % 256 = 0x5b)
    (next : Hoare .fusaka (At (ofNat n size) msg d.toNat rest mem (gas - 8) st ss rd) R) :
    Hoare .fusaka (At (ofNat n size) msg pc (d :: rest) mem gas st ss rd) R :=
  step_of (fun h hc => jump h hc hgas (valid_dest hw hd hjd)) hlt hb next

/-- JUMPI whose condition a premise shows zero: the fall-through only. -/
theorem step_jumpi_zero {d c : U256} {rest : List U256} (hlt : pc < size)
    (hb : n >>> (8 * (size - 1 - pc)) % 256 = 0x57) (hgas : 10 ≤ gas) (hz : c = 0)
    (next : Hoare .fusaka (At (ofNat n size) msg (pc + 1) rest mem (gas - 10) st ss rd) R) :
    Hoare .fusaka (At (ofNat n size) msg pc (d :: c :: rest) mem gas st ss rd) R :=
  step_of (fun h hc => jumpi_of_eq_zero h hc hgas hz) hlt hb next

/-- JUMPI whose condition a premise shows nonzero: the jump only. -/
theorem step_jumpi_taken {d c : U256} {rest : List U256} (hlt : pc < size)
    (hb : n >>> (8 * (size - 1 - pc)) % 256 = 0x57) (hgas : 10 ≤ gas) (hnz : c ≠ 0)
    (hw : walk n size size 0 d.toNat = true) (hd : d.toNat < size)
    (hjd : n >>> (8 * (size - 1 - d.toNat)) % 256 = 0x5b)
    (next : Hoare .fusaka (At (ofNat n size) msg d.toNat rest mem (gas - 10) st ss rd) R) :
    Hoare .fusaka (At (ofNat n size) msg pc (d :: c :: rest) mem gas st ss rd) R :=
  step_of (fun h hc => jumpi_taken h hc hgas hnz (valid_dest hw hd hjd)) hlt hb next

/-- JUMPI on any condition keeps both continuations, each under its path condition
(Symex's `jumpi_split` over a NatCode). -/
theorem step_jumpi_split {d c : U256} {rest : List U256} (hlt : pc < size)
    (hb : n >>> (8 * (size - 1 - pc)) % 256 = 0x57) (hgas : 10 ≤ gas)
    (hw : walk n size size 0 d.toNat = true) (hd : d.toNat < size)
    (hjd : n >>> (8 * (size - 1 - d.toNat)) % 256 = 0x5b)
    (zero : c = 0 →
      Hoare .fusaka (At (ofNat n size) msg (pc + 1) rest mem (gas - 10) st ss rd) R)
    (taken : c ≠ 0 →
      Hoare .fusaka (At (ofNat n size) msg d.toNat rest mem (gas - 10) st ss rd) R) :
    Hoare .fusaka (At (ofNat n size) msg pc (d :: c :: rest) mem gas st ss rd) R := by
  by_cases h : c = 0
  · exact step_jumpi_zero hlt hb hgas h (zero h)
  · exact step_jumpi_taken hlt hb hgas h hw hd hjd (taken h)

theorem binary_of {byte : Nat} {op : Op} {f : U256 → U256 → U256} {x y : U256} {rest : List U256}
    (hdec : Op.decode (UInt8.ofNat byte) = some op) (hsince : op.since ≤ .fusaka)
    (hrun : stackOnlyStep (Meter := Nat) .fusaka op = some (binaryOp 3 f))
    (hlt : pc < size) (hb : n >>> (8 * (size - 1 - pc)) % 256 = byte) (hgas : 3 ≤ gas)
    (next : Hoare .fusaka (At (ofNat n size) msg (pc + 1) (f x y :: rest) mem (gas - 3) st ss rd)
      R) :
    Hoare .fusaka (At (ofNat n size) msg pc (x :: y :: rest) mem gas st ss rd) R :=
  step_of (fun h hc => binary h hc (ofByte_of_decode hdec hsince)
    (instruction_of_stackOnlyStep hrun) hgas) hlt hb next

theorem unary_of {byte : Nat} {op : Op} {f : U256 → U256} {x : U256} {rest : List U256}
    (hdec : Op.decode (UInt8.ofNat byte) = some op) (hsince : op.since ≤ .fusaka)
    (hrun : stackOnlyStep (Meter := Nat) .fusaka op = some (unaryOp 3 f))
    (hlt : pc < size) (hb : n >>> (8 * (size - 1 - pc)) % 256 = byte) (hgas : 3 ≤ gas)
    (next : Hoare .fusaka (At (ofNat n size) msg (pc + 1) (f x :: rest) mem (gas - 3) st ss rd) R) :
    Hoare .fusaka (At (ofNat n size) msg pc (x :: rest) mem gas st ss rd) R :=
