    (instruction_of_stackOnlyStep hrun) hgas) hlt hb next

/-! ## Terminal rules -/

/-- REVERT of 0 bytes ends the run with `Reverted`. -/
theorem step_revert_reverted {start sz : U256} {rest : List U256} (hlt : pc < size)
    (hb : n >>> (8 * (size - 1 - pc)) % 256 = 0xfd) (hz : sz = 0) :
    Hoare .fusaka (At (ofNat n size) msg pc (start :: sz :: rest) mem gas st ss rd)
      (fun evm => evm.running = false ∧ Reverted evm) := by
  subst hz
  exact revert_empty (by decide) (code_lt hlt) (code_byte hlt hb)

/-- REVERT of 0 bytes ends the run with `Done`. -/
theorem step_revert_done {start sz : U256} {rest : List U256} (hlt : pc < size)
    (hb : n >>> (8 * (size - 1 - pc)) % 256 = 0xfd) (hz : sz = 0) :
    Hoare .fusaka (At (ofNat n size) msg pc (start :: sz :: rest) mem gas st ss rd)
      (fun evm => evm.running = false ∧ Done evm) :=
  Triple.consequence (step_revert_reverted hlt hb hz) (fun _ h => h)
    (fun _ ⟨h1, h2⟩ => ⟨h1, Or.inr h2⟩)

/-- STOP ends the run with `Done`. -/
theorem step_stop_done (hlt : pc < size) (hb : n >>> (8 * (size - 1 - pc)) % 256 = 0x00) :
    Hoare .fusaka (At (ofNat n size) msg pc stack mem gas st ss rd)
      (fun evm => evm.running = false ∧ Done evm) :=
  Triple.consequence (stop (code_lt hlt) (code_byte hlt hb)) (fun _ h => h)
    (fun _ ⟨h1, _, h2, _⟩ => ⟨h1, Or.inl (by simpa using h2)⟩)

/-- A run reaches the frame it is at, named with an equal stack and gas. -/
theorem at_close {code : ByteArray} {s s' : List U256} {g g' : Nat} (hs : s = s') (hg : g = g') :
    Hoare .fusaka (At code msg pc s mem g st ss rd) (At code msg pc s' mem g' st ss rd) := by
  subst hs hg
  exact Triple.of_imp fun _ h => h

