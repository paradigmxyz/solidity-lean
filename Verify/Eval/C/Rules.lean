import SolidCore.Refinement.Evm.Symex

/-!
# Lane C: fused one-opcode rules over a code stored as one number

Generated by `gen_rules.py`; do not edit by hand.

Every rule here concludes `Hoare .fusaka (At (NatCode.ofNat n size) msg pc stack mem gas st ss rd) R`
for an arbitrary postcondition `R`, from the premises of one opcode's EthLib rule and the triple from
the next frame. So one `Sym.BackwardRule` application performs one step and composes it, and the
premises are facts on natural numbers (`pc + k < size`, the byte `n >>> (8 * (size - 1 - pc)) % 256`)
or on the frame's words that ground evaluation, an assumption or `grind` closes.

Stacks are matched by explicit cons cells (DUPk and SWAPk name the words they read), so no premise
indexes a list and the next frame needs no `List.set` normalization.
-/

open EthLib.Base EthLib.Execution EthLib.Execution.Evm EthLib.Execution.Evm.Logic GasCosts
open SolidCore.Refinement.Evm.Logic SolidCore.Refinement.Evm.Symex

namespace Verify.Eval.C

open EthLib.Execution.Evm.Logic.NatCode (ofNat natByte walk)

/-- A halted frame with no error, or one that reverted with empty output. -/
def Done (evm : Evm .fusaka Nat) : Prop := evm.error = none ∨ Reverted evm

variable {n size pc : Nat} {msg : Message .fusaka} {stack : List U256} {mem : ByteArray}
  {gas : Nat} {st : State.TransactionState} {ss : Substate} {rd : ByteArray}
  {R : Evm .fusaka Nat → Prop}

theorem code_lt (h : pc < size) : pc < (ofNat n size).size := by
  rw [NatCode.size_ofNat]; exact h

theorem code_byte {b : Nat} (h : pc < size) (hb : n >>> (8 * (size - 1 - pc)) % 256 = b) :
    (ofNat n size)[pc]'(code_lt h) = UInt8.ofNat b := by
  rw [NatCode.getElem_ofNat, NatCode.natByte, if_pos h, ← hb]
  apply UInt8.toNat_inj.mp
  simp [UInt8.toNat_ofNat']

theorem natByte_eq {b : Nat} (h : pc < size) (hb : n >>> (8 * (size - 1 - pc)) % 256 = b) :
    natByte n size pc = UInt8.ofNat b := by
  rw [NatCode.natByte, if_pos h, ← hb]
  apply UInt8.toNat_inj.mp
  simp [UInt8.toNat_ofNat']

theorem valid_dest {d : Nat} (hw : walk n size size 0 d = true) (hd : d < size)
    (hb : n >>> (8 * (size - 1 - d)) % 256 = 0x5b) :
    isValidJumpDest (validJumpDestinations (ofNat n size)) d = true :=
  NatCode.valid_of_walk hw (by rw [natByte_eq hd hb]; rfl)

theorem step_pushN (k : Fin 33) (hk : k.val ≠ 0)
    (hdec : Op.decode (UInt8.ofNat (0x5f + k.val)) = some (.push k))
    (hlt : pc + k.val < size) (hb : n >>> (8 * (size - 1 - pc)) % 256 = 0x5f + k.val)
    (hgas : 3 ≤ gas) (hroom : stack.length < 1024)
    (next : Hoare .fusaka (At (ofNat n size) msg (pc + 1 + k.val)
      (BitVec.ofNat 256 (n >>> (8 * (size - 1 - (pc + k.val))) % 256 ^ k.val) :: stack) mem
      (gas - 3) st ss rd) R) :
    Hoare .fusaka (At (ofNat n size) msg pc stack mem gas st ss rd) R := by
  refine Triple.seq (push_of_decode (code_lt (by omega)) (code_byte (by omega) hb) hdec hk
    (NatCode.pushData_ofNat n size pc k hlt) hgas hroom) ?_
  rwa [show pc + (1 + k.val) = pc + 1 + k.val by omega]

/-- A one-step rule of an opcode at a NatCode program counter, composed with the next triple. -/
theorem step_of {byte : Nat} {P' : Evm .fusaka Nat → Prop}
    (h : ∀ (hlt : pc < (ofNat n size).size), (ofNat n size)[pc] = UInt8.ofNat byte →
      Hoare .fusaka (At (ofNat n size) msg pc stack mem gas st ss rd) P')
    (hlt : pc < size) (hb : n >>> (8 * (size - 1 - pc)) % 256 = byte) (next : Hoare .fusaka P' R) :
    Hoare .fusaka (At (ofNat n size) msg pc stack mem gas st ss rd) R :=
  Triple.seq (h (code_lt hlt) (code_byte hlt hb)) next

theorem step_push0 (hlt : pc < size) (hb : n >>> (8 * (size - 1 - pc)) % 256 = 0x5f)
    (hgas : 2 ≤ gas) (hroom : stack.length < 1024)
    (next : Hoare .fusaka (At (ofNat n size) msg (pc + 1) (0 :: stack) mem (gas - 2) st ss rd) R) :
    Hoare .fusaka (At (ofNat n size) msg pc stack mem gas st ss rd) R :=
  step_of (fun h hc => push0 (by decide) h hc hgas hroom) hlt hb next

