import Verify.Basic
import Verify.Tactic
import Verify.Eval.Common.Measure

/-!
# Lane A fixture: Branch family, n = 32 ops

Generated by scripts/eval/fixtures/gen_solm.py; do not edit by hand.

10 sequential `require(slot i < 2^255)` guards, each followed by a store of the doubled value (a load, a guarded revert and a store: 3 ops). Paths: 11. Any revert is allowed (`∀ e, herr e`); on success each doubled slot holds `2 * s i` exactly (no wrap, by the guard).

`stmt` is the statement every lane proves; `baseline` is today's engine (the `sc_vcgen`
cascade: `simp only [wp_bind, wp_pure, wp_sload, wp_sstore, wp_revert, wp_ite]`, then
`sc_close`).
-/

set_option maxHeartbeats 0
set_option maxRecDepth 100000
set_option linter.unusedSimpArgs false

namespace Verify.Eval.A.Branch32

open SolidCore.Verify

def model : SolM Unit := do
  let v0 ← sload 0
  if v0 < 2 ^ 255 then pure () else revert [0]
  sstore 1000 (v0 + v0)
  let v1 ← sload 1
  if v1 < 2 ^ 255 then pure () else revert [1]
  sstore 1001 (v1 + v1)
  let v2 ← sload 2
  if v2 < 2 ^ 255 then pure () else revert [2]
  sstore 1002 (v2 + v2)
  let v3 ← sload 3
  if v3 < 2 ^ 255 then pure () else revert [3]
  sstore 1003 (v3 + v3)
  let v4 ← sload 4
  if v4 < 2 ^ 255 then pure () else revert [4]
  sstore 1004 (v4 + v4)
  let v5 ← sload 5
  if v5 < 2 ^ 255 then pure () else revert [5]
  sstore 1005 (v5 + v5)
  let v6 ← sload 6
  if v6 < 2 ^ 255 then pure () else revert [6]
  sstore 1006 (v6 + v6)
  let v7 ← sload 7
  if v7 < 2 ^ 255 then pure () else revert [7]
  sstore 1007 (v7 + v7)
  let v8 ← sload 8
  if v8 < 2 ^ 255 then pure () else revert [8]
  sstore 1008 (v8 + v8)
  let v9 ← sload 9
  if v9 < 2 ^ 255 then pure () else revert [9]
  sstore 1009 (v9 + v9)

def stmt : Prop :=
  ∀ (s : Storage) (herr : Revert → Prop), (∀ e, herr e) →
    wp model (fun _ _ s' =>
      s' 1000 = 2 * s 0 ∧
      s' 1001 = 2 * s 1 ∧
      s' 1002 = 2 * s 2 ∧
      s' 1003 = 2 * s 3 ∧
      s' 1004 = 2 * s 4 ∧
      s' 1005 = 2 * s 5 ∧
      s' 1006 = 2 * s 6 ∧
      s' 1007 = 2 * s 7 ∧
      s' 1008 = 2 * s 8 ∧
      s' 1009 = 2 * s 9) herr s

theorem baseline : stmt := by
  intro s herr hrev
  simp only [model, wp_bind, wp_pure, wp_sload, wp_sstore, wp_revert, wp_ite, ite_apply, dite_apply]
  sc_close

end Verify.Eval.A.Branch32

#proof_stats Verify.Eval.A.Branch32.baseline
#kernel_recheck Verify.Eval.A.Branch32.baseline
