  let c7 ← sload 7
  sstore 7 (c7 + 1)
  let c8 ← sload 8
  sstore 8 (c8 + 1)
  let c9 ← sload 9
  sstore 9 (c9 + 1)
  let c10 ← sload 10
  sstore 10 (c10 + 1)
  let c11 ← sload 11
  sstore 11 (c11 + 1)
  let c12 ← sload 12
  sstore 12 (c12 + 1)
  let c13 ← sload 13
  sstore 13 (c13 + 1)
  let c14 ← sload 14
  sstore 14 (c14 + 1)
  let c15 ← sload 15
  sstore 15 (c15 + 1)
  pure (i + 1)

/-- The supplied invariant: `i ≤ N`, every counter advanced by `i`, and the bound the
caller established. -/
def inv (N : Nat) (s : Storage) (i : Nat) : Assn := fun _ s' =>
      i ≤ N ∧
      s' 0 = s 0 + i ∧
      s' 1 = s 1 + i ∧
      s' 2 = s 2 + i ∧
      s' 3 = s 3 + i ∧
      s' 4 = s 4 + i ∧
      s' 5 = s 5 + i ∧
      s' 6 = s 6 + i ∧
      s' 7 = s 7 + i ∧
      s' 8 = s 8 + i ∧
      s' 9 = s 9 + i ∧
      s' 10 = s 10 + i ∧
      s' 11 = s 11 + i ∧
      s' 12 = s 12 + i ∧
      s' 13 = s 13 + i ∧
      s' 14 = s 14 + i ∧
      s' 15 = s 15 + i ∧
      s 0 + N < 2 ^ 256 ∧
      s 1 + N < 2 ^ 256 ∧
      s 2 + N < 2 ^ 256 ∧
      s 3 + N < 2 ^ 256 ∧
      s 4 + N < 2 ^ 256 ∧
      s 5 + N < 2 ^ 256 ∧
      s 6 + N < 2 ^ 256 ∧
      s 7 + N < 2 ^ 256 ∧
      s 8 + N < 2 ^ 256 ∧
      s 9 + N < 2 ^ 256 ∧
      s 10 + N < 2 ^ 256 ∧
      s 11 + N < 2 ^ 256 ∧
      s 12 + N < 2 ^ 256 ∧
      s 13 + N < 2 ^ 256 ∧
      s 14 + N < 2 ^ 256 ∧
      s 15 + N < 2 ^ 256

/-- The supplied variant. -/
def variant (N i : Nat) : Nat := N - i

def stmt : Prop :=
  ∀ (N : Nat) (s : Storage) (i : Nat), decide (i < N) = true →
    triple (inv N s i) (body i) (fun i' => inv N s i' ⊓ ⌜variant N i' < variant N i⌝)

theorem baseline : stmt := by
  intro N s i hi herr s' hinv
  simp only [decide_eq_true_eq] at hi
  simp only [inv] at hinv
  obtain ⟨hle, h0, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14, h15, b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15⟩ := hinv
  have hv : N - (i + 1) < N - i := by omega
  simp only [body, inv, variant, wp_bind, wp_pure, wp_sload, wp_sstore, wp_revert, wp_ite, ite_apply, dite_apply, LE.pure, hv, ↓reduceIte,
    Pi.inf_apply, inf_Prop_eq, Pi.top_apply, Pi.bot_apply, Prop.top_eq_true, Prop.bot_eq_false]
  sc_close

end Verify.Eval.A.LoopBody32

