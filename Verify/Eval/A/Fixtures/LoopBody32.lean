set_option maxHeartbeats 0
set_option maxRecDepth 100000
set_option linter.unusedSimpArgs false

namespace Verify.Eval.A.LoopBody32

open SolidCore.Verify

def body (i : Nat) : SolM Nat := do
  let c0 ← sload 0
  sstore 0 (c0 + 1)
  let c1 ← sload 1
  sstore 1 (c1 + 1)
  let c2 ← sload 2
  sstore 2 (c2 + 1)
  let c3 ← sload 3
  sstore 3 (c3 + 1)
  let c4 ← sload 4
  sstore 4 (c4 + 1)
  let c5 ← sload 5
