import Verify.Basic
import Verify.Tactic
import Verify.Eval.Common.Measure

/-!
# Lane A fixture: Straight family, n = 16 ops

Generated by scripts/eval/fixtures/gen_solm.py; do not edit by hand.

8 load/store pairs: `slot i+1 := slot i + 1` for i < 8; from `s 0 < 2^128`, slot 8 ends as `s 0 + 8` (each store wraps modulo 2^256, so `omega` sees 8 nested `%`).

`stmt` is the statement every lane proves; `baseline` is today's engine (the `sc_vcgen`
cascade: `simp only [wp_bind, wp_pure, wp_sload, wp_sstore, wp_revert, wp_ite]`, then
`sc_close`).
-/

set_option maxHeartbeats 0
set_option maxRecDepth 100000
set_option linter.unusedSimpArgs false

namespace Verify.Eval.A.Straight16

open SolidCore.Verify

def model : SolM Unit := do
  let v0 ← sload 0
  sstore 1 (v0 + 1)
  let v1 ← sload 1
  sstore 2 (v1 + 1)
  let v2 ← sload 2
  sstore 3 (v2 + 1)
  let v3 ← sload 3
  sstore 4 (v3 + 1)
  let v4 ← sload 4
  sstore 5 (v4 + 1)
  let v5 ← sload 5
  sstore 6 (v5 + 1)
  let v6 ← sload 6
  sstore 7 (v6 + 1)
  let v7 ← sload 7
  sstore 8 (v7 + 1)

def stmt : Prop :=
  ∀ (s : Storage) (herr : Revert → Prop), s 0 < 2 ^ 128 →
    wp model (fun _ _ s' => s' 8 = s 0 + 8) herr s

theorem baseline : stmt := by
  intro s herr h
  simp only [model, wp_bind, wp_pure, wp_sload, wp_sstore, wp_revert, wp_ite, ite_apply, dite_apply]
  sc_close

end Verify.Eval.A.Straight16

#proof_stats Verify.Eval.A.Straight16.baseline
#kernel_recheck Verify.Eval.A.Straight16.baseline
