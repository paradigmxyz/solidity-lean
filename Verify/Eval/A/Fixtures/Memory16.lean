import Verify.Basic
import Verify.Tactic
import Verify.Eval.Common.Measure

/-!
# Lane A fixture: Memory family, n = 16 ops

Generated by scripts/eval/fixtures/gen_solm.py; do not edit by hand.

Load slot 0, write 7 distinct slots 100.. with `x + i`, read all 7 back through the 7 writes and return them (15 ops).

`stmt` is the statement every lane proves; `baseline` is today's engine (the `sc_vcgen`
cascade: `simp only [wp_bind, wp_pure, wp_sload, wp_sstore, wp_revert, wp_ite]`, then
`sc_close`).
-/

set_option maxHeartbeats 0
set_option maxRecDepth 100000
set_option linter.unusedSimpArgs false

namespace Verify.Eval.A.Memory16

open SolidCore.Verify

def model : SolM (List Nat) := do
  let x ← sload 0
  sstore 100 (x + 0)
  sstore 101 (x + 1)
  sstore 102 (x + 2)
  sstore 103 (x + 3)
  sstore 104 (x + 4)
  sstore 105 (x + 5)
  sstore 106 (x + 6)
  let r0 ← sload 100
  let r1 ← sload 101
  let r2 ← sload 102
  let r3 ← sload 103
  let r4 ← sload 104
  let r5 ← sload 105
  let r6 ← sload 106
  pure [r0, r1, r2, r3, r4, r5, r6]

def stmt : Prop :=
  ∀ (s : Storage) (herr : Revert → Prop),
    wp model (fun out _ _ => out = [(s 0 + 0) % 2 ^ 256, (s 0 + 1) % 2 ^ 256, (s 0 + 2) % 2 ^ 256, (s 0 + 3) % 2 ^ 256, (s 0 + 4) % 2 ^ 256, (s 0 + 5) % 2 ^ 256, (s 0 + 6) % 2 ^ 256]) herr s

theorem baseline : stmt := by
  intro s herr
  simp only [model, wp_bind, wp_pure, wp_sload, wp_sstore, wp_revert, wp_ite, ite_apply, dite_apply]
  sc_close

end Verify.Eval.A.Memory16

#proof_stats Verify.Eval.A.Memory16.baseline
#kernel_recheck Verify.Eval.A.Memory16.baseline
