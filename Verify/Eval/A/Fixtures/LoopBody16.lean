import Verify.Basic
import Verify.Tactic
import Verify.Eval.Common.Measure

/-!
# Lane A fixture: LoopBody family, n = 16 ops

Generated by scripts/eval/fixtures/gen_solm.py; do not edit by hand.

The body of `while i < N` with 8 counters (slots 0..7), each incremented by a load and a store (16 ops), proved against the supplied invariant and variant in the `triple` form `triple_whileM` asks of a body (as `CounterBump.body_step`).

`stmt` is the statement every lane proves; `baseline` is today's engine (the `sc_vcgen`
cascade: `simp only [wp_bind, wp_pure, wp_sload, wp_sstore, wp_revert, wp_ite]`, then
`sc_close`).
-/

set_option maxHeartbeats 0
set_option maxRecDepth 100000
set_option linter.unusedSimpArgs false

namespace Verify.Eval.A.LoopBody16

open SolidCore.Verify

def body (i : Nat) : SolM Nat := do
  let c0 ← sload 0
  sstore 0 (c0 + 1)
  let c1 ← sload 1
  sstore 1 (c1 + 1)
  let c2 ← sload 2
  sstore 2 (c2 + 1)
  let c3 ← sload 3
  sstore 3 (c3 + 1)
  let c4 ← sload 4
  sstore 4 (c4 + 1)
  let c5 ← sload 5
  sstore 5 (c5 + 1)
  let c6 ← sload 6
  sstore 6 (c6 + 1)
  let c7 ← sload 7
  sstore 7 (c7 + 1)
  pure (i + 1)

/-- The supplied invariant: `i ≤ N`, every counter advanced by `i`, and the bound the
caller established. -/
def inv (N : Nat) (s : Storage) (i : Nat) : Assn := fun _ s' =>
      i ≤ N ∧
      s' 0 = s 0 + i ∧
      s' 1 = s 1 + i ∧
      s' 2 = s 2 + i ∧
      s' 3 = s 3 + i ∧
      s' 4 = s 4 + i ∧
      s' 5 = s 5 + i ∧
      s' 6 = s 6 + i ∧
      s' 7 = s 7 + i ∧
      s 0 + N < 2 ^ 256 ∧
      s 1 + N < 2 ^ 256 ∧
      s 2 + N < 2 ^ 256 ∧
      s 3 + N < 2 ^ 256 ∧
      s 4 + N < 2 ^ 256 ∧
      s 5 + N < 2 ^ 256 ∧
      s 6 + N < 2 ^ 256 ∧
      s 7 + N < 2 ^ 256

/-- The supplied variant. -/
def variant (N i : Nat) : Nat := N - i

def stmt : Prop :=
  ∀ (N : Nat) (s : Storage) (i : Nat), decide (i < N) = true →
    triple (inv N s i) (body i) (fun i' => inv N s i' ⊓ ⌜variant N i' < variant N i⌝)

theorem baseline : stmt := by
  intro N s i hi herr s' hinv
  simp only [decide_eq_true_eq] at hi
  simp only [inv] at hinv
  obtain ⟨hle, h0, h1, h2, h3, h4, h5, h6, h7, b0, b1, b2, b3, b4, b5, b6, b7⟩ := hinv
  have hv : N - (i + 1) < N - i := by omega
  simp only [body, inv, variant, wp_bind, wp_pure, wp_sload, wp_sstore, wp_revert, wp_ite, ite_apply, dite_apply, LE.pure, hv, ↓reduceIte,
    Pi.inf_apply, inf_Prop_eq, Pi.top_apply, Pi.bot_apply, Prop.top_eq_true, Prop.bot_eq_false]
  sc_close

end Verify.Eval.A.LoopBody16

#proof_stats Verify.Eval.A.LoopBody16.baseline
