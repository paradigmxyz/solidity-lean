import Verify.Basic
import Verify.Tactic
import Verify.Eval.Common.Measure

/-!
# Lane A fixture: Memory family, n = 32 ops

Generated by scripts/eval/fixtures/gen_solm.py; do not edit by hand.

Load slot 0, write 15 distinct slots 100.. with `x + i`, read all 15 back through the 15 writes and return them (31 ops).

`stmt` is the statement every lane proves; `baseline` is today's engine (the `sc_vcgen`
cascade: `simp only [wp_bind, wp_pure, wp_sload, wp_sstore, wp_revert, wp_ite]`, then
`sc_close`).
-/

set_option maxHeartbeats 0
set_option maxRecDepth 100000
set_option linter.unusedSimpArgs false

namespace Verify.Eval.A.Memory32

open SolidCore.Verify

def model : SolM (List Nat) := do
  let x ← sload 0
  sstore 100 (x + 0)
  sstore 101 (x + 1)
  sstore 102 (x + 2)
  sstore 103 (x + 3)
  sstore 104 (x + 4)
  sstore 105 (x + 5)
  sstore 106 (x + 6)
  sstore 107 (x + 7)
  sstore 108 (x + 8)
  sstore 109 (x + 9)
  sstore 110 (x + 10)
  sstore 111 (x + 11)
  sstore 112 (x + 12)
  sstore 113 (x + 13)
  sstore 114 (x + 14)
  let r0 ← sload 100
  let r1 ← sload 101
  let r2 ← sload 102
  let r3 ← sload 103
  let r4 ← sload 104
  let r5 ← sload 105
  let r6 ← sload 106
  let r7 ← sload 107
  let r8 ← sload 108
  let r9 ← sload 109
  let r10 ← sload 110
  let r11 ← sload 111
  let r12 ← sload 112
  let r13 ← sload 113
  let r14 ← sload 114
  pure [r0, r1, r2, r3, r4, r5, r6, r7, r8, r9, r10, r11, r12, r13, r14]

def stmt : Prop :=
  ∀ (s : Storage) (herr : Revert → Prop),
    wp model (fun out _ _ => out = [(s 0 + 0) % 2 ^ 256, (s 0 + 1) % 2 ^ 256, (s 0 + 2) % 2 ^ 256, (s 0 + 3) % 2 ^ 256, (s 0 + 4) % 2 ^ 256, (s 0 + 5) % 2 ^ 256, (s 0 + 6) % 2 ^ 256, (s 0 + 7) % 2 ^ 256, (s 0 + 8) % 2 ^ 256, (s 0 + 9) % 2 ^ 256, (s 0 + 10) % 2 ^ 256, (s 0 + 11) % 2 ^ 256, (s 0 + 12) % 2 ^ 256, (s 0 + 13) % 2 ^ 256, (s 0 + 14) % 2 ^ 256]) herr s

theorem baseline : stmt := by
  intro s herr
  simp only [model, wp_bind, wp_pure, wp_sload, wp_sstore, wp_revert, wp_ite, ite_apply, dite_apply]
  sc_close

end Verify.Eval.A.Memory32

#proof_stats Verify.Eval.A.Memory32.baseline
#kernel_recheck Verify.Eval.A.Memory32.baseline
