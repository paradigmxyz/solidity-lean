/-- `stage0` and `mir1` simulated through their cut points on every call. -/
def mir1_sim (o : Oracle) :
    CutPoint.LayerSim MIR.Lowered.moduleLayer MIR.Lowered.moduleLayer o stage0 mir1 anyCall where
  σ := MIR.Lowered.Frame
  τ := MIR.Lowered.Frame
  step call := MIR.Lowered.moduleBlock o call stage0
  step' call := MIR.Lowered.moduleBlock o call mir1
  init call := ([], .enter stage0.entry 0 0, fun _ => 0, MIR.Lowered.Module.startState stage0 (State.initial call))
  init' call := ([], .enter mir1.entry 0 0, fun _ => 0, MIR.Lowered.Module.startState mir1 (State.initial call))
  runs _ _ := rfl
  runs' _ _ := rfl
  cut := mir1_cutA
  cut' := mir1_cutB
  Rel call := fun x x' => ∃ P ∈ mir1_rels call, P x x'
  start _ _ := ⟨_, List.Mem.head _, rfl, rfl⟩
  sim call _ := CutPoint.Sim.of_each (mir1_segments o call)

/-- Every end of `stage0` on a call is matched by an agreeing end of `mir1`. -/
theorem mir1_certified (o : Oracle) :
    Certified MIR.Lowered.moduleLayer MIR.Lowered.moduleLayer o stage0 mir1 anyCall :=
  (mir1_sim o).certified

/-- Every end of `mir1` on a call is matched by an agreeing end of `stage0`. -/
theorem mir1_certified_back (o : Oracle) :
    Certified MIR.Lowered.moduleLayer MIR.Lowered.moduleLayer o mir1 stage0 anyCall :=
  (mir1_sim o).certified_back

