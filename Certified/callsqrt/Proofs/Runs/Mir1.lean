  simp only [mir1_rels, List.mem_cons, List.not_mem_nil, or_false] at mem
  rcases mem with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · obtain ⟨rfl, rfl⟩ := holds
    exact mir1_seg0 o call
  · obtain ⟨env, c0, s, env', c0', rfl, rfl, h0, h1, h2⟩ := holds
    exact mir1_seg1 o call env c0 s env' c0' h0 h1 h2
  · obtain ⟨env, c0, s, env', c0', rfl, rfl, h0, h1, h2⟩ := holds
    exact mir1_seg2 o call env c0 s env' c0' h0 h1 h2
