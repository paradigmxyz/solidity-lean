    exact mir1_seg6 o call env c0 s env' c0' h0 h1 h2
  · obtain ⟨env, c0, s, env', c0', rfl, rfl, h0, h1, h2⟩ := holds
    exact mir1_seg7 o call env c0 s env' c0' h0 h1 h2
  · obtain ⟨env, c0, s, env', c0', rfl, rfl, h0, h1, h2⟩ := holds
