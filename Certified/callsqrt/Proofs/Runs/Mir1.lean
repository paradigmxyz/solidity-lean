theorem mir1_segments (o : Oracle) (call : Call) :
    ∀ P ∈ mir1_rels call, ∀ x x', P x x' → ∃ k k', SegRel Agree (fun y y' => ∃ Q ∈ mir1_rels call, Q y y')
